#use io
#use sort
xs = sort::Ints()
16000 @ i =>
   xs += ((16000 - i) % 31)
ordered = sort::ints(xs)
bad' = 0
15999 @ i =>
   ordered(i)!! > ordered(i + 1)!! | bad' = bad' + 1
io::out(bad')
io::out(xs(0)!!)
io::out(ordered(0)!!)
io::out(?ordered)
ss = sort::Strings()
64 @ i =>
   ss += (i % 2 == 0 | "z" | "a")
sorted = sort::strings(ss)
io::out(sorted(0)!!)
io::out(sorted(63)!!)
io::out(ss(0)!!)
