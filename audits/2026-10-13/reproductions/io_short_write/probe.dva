#use io
#use net
#use libc
fds = (0i32, 0i32)
io::out $ libc::pipe(&fds)
readfd = Int(fds.0)
writefd = Int(fds.1)
io::out $ net::set_nonblocking(writefd, 1)
b = {100000}
100000 @
   b += 'x'
io::write(writefd, +b)
libc::close(writefd)
buf = {100000}
n = libc::read(readfd, &buf, 100000)
io::out(n)
libc::close(readfd)
