// Test leading-apostrophe character literals ('a, '0, '-, '\n, '\0, '\s, '')

#use io

a = '0
io::out $ Int(a)

b = '-
io::out $ Int(b)

c = '\n
io::out $ ( c == 10 | "Positive" | "Negative")

d = '\0
io::out $ ( d == 0 | "Positive" | "Negative")

sp = '\s
io::out $ Int(sp)

ap = ''
io::out $ Int(ap)
