#use "../../src/ast"
#use "../../src/dep_graph"
#use io

binding: String, ast::Expr => ast::Expr
binding = name, rhs =>
   ast::Expr(Assign, (name, <->, <->, <->, <->, rhs,
      ast::Expr(Var, name), "",
      ast::TypeInfo(Prim, ast::ValueType(Unknown))))

stmts = ast::Exprs()
stmts += binding("leaf", ast::Expr(Int, 1))
stmts += binding("a", ast::Expr(Var, "b"))
stmts += binding("b", ast::Expr(Var, "a"))
stmts += binding("mod::#secret", ast::Expr(Var, "leaf"))
stmts += binding("mod::f", ast::Expr(Var, "secret"))
stmts += binding("outside", ast::Expr(Var, "secret"))
stmts += binding("leaf", ast::Expr(Int, 2))
stmts += binding("forward", ast::Expr(Var, "<fwd>"))
graph = dep_graph::build_dep_graph(stmts)
io::out $ ?graph.nodes
io::out $ dep_graph::find_node_idx(graph, "leaf")
io::out $ dep_graph::find_node_idx(graph, "missing")
io::out $ dep_graph::find_node_idx(graph, "forward")
private_node = graph.nodes(4) | _ | _
io::out $ (private_node.deps(0) | _ | _)
external_node = graph.nodes(5) | _ | _
io::out $ ?external_node.deps
sccs = dep_graph::tarjan_scc(graph)
recursive' = 0
sccs @ scc => scc.is_recursive | recursive' = recursive' + 1
io::out $ recursive'
