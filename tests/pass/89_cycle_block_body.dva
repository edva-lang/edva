// An indented block as a cycle body is the implicit form: the block runs with
// "_" bound to the current value and "_i" to its 0-based index.
5 @
	print_int $ _

arr = (10, 20, 30)
arr @
	print_int $ _i
	print_int $ _

2..6 @
	print_int $ _
	print_int $ _i

total' = 0
4 @
	total' = total' + _i
print_int $ total'
