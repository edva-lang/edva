// Regression test: top-level string retention must exceed the old
// single 1 MiB bump buffer (previously aborted E4001). The chunked
// arena grows on demand; each concat below stays retained at top level.
// ?s_k = 40000*k + 1, so the largest buffer is s25 = 1000001+1 bytes
// (< 1 MiB per single allocation) while total retention is ~13 MB.
b = ""
s1 = b + "x"
s2 = b + s1
s3 = b + s2
s4 = b + s3
s5 = b + s4
s6 = b + s5
s7 = b + s6
s8 = b + s7
s9 = b + s8
s10 = b + s9
s11 = b + s10
s12 = b + s11
s13 = b + s12
s14 = b + s13
s15 = b + s14
s16 = b + s15
s17 = b + s16
s18 = b + s17
s19 = b + s18
s20 = b + s19
s21 = b + s20
s22 = b + s21
s23 = b + s22
s24 = b + s23
s25 = b + s24
print_int $ ?s1
print_int $ ?s2
print_int $ ?s3
print_int $ ?s4
print_int $ ?s5
print_int $ ?s6
print_int $ ?s7
print_int $ ?s8
print_int $ ?s9
print_int $ ?s10
print_int $ ?s11
print_int $ ?s12
print_int $ ?s13
print_int $ ?s14
print_int $ ?s15
print_int $ ?s16
print_int $ ?s17
print_int $ ?s18
print_int $ ?s19
print_int $ ?s20
print_int $ ?s21
print_int $ ?s22
print_int $ ?s23
print_int $ ?s24
print_int $ ?s25
