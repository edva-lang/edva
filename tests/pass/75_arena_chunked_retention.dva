// Regression test: top-level string retention must exceed the old
// single 1 MiB bump buffer (previously aborted E4001). The chunked
// arena grows on demand; each concat below stays retained at top level.
// ?s_k = 40000*k + 1, so the largest buffer is s25 = 1000001+1 bytes
// (< 1 MiB per single allocation) while total retention is ~13 MB.
#use io

b = ""
s1 = b + "x"
s2 = b + s1
s3 = b + s2
s4 = b + s3
s5 = b + s4
s6 = b + s5
s7 = b + s6
s8 = b + s7
s9 = b + s8
s10 = b + s9
s11 = b + s10
s12 = b + s11
s13 = b + s12
s14 = b + s13
s15 = b + s14
s16 = b + s15
s17 = b + s16
s18 = b + s17
s19 = b + s18
s20 = b + s19
s21 = b + s20
s22 = b + s21
s23 = b + s22
s24 = b + s23
s25 = b + s24
io::out $ ?s1
io::out $ ?s2
io::out $ ?s3
io::out $ ?s4
io::out $ ?s5
io::out $ ?s6
io::out $ ?s7
io::out $ ?s8
io::out $ ?s9
io::out $ ?s10
io::out $ ?s11
io::out $ ?s12
io::out $ ?s13
io::out $ ?s14
io::out $ ?s15
io::out $ ?s16
io::out $ ?s17
io::out $ ?s18
io::out $ ?s19
io::out $ ?s20
io::out $ ?s21
io::out $ ?s22
io::out $ ?s23
io::out $ ?s24
io::out $ ?s25
