// task::spawn with a FUNCTION VALUE argument: the worker takes a closure and calls
// it. The argument's { fn_ptr, env_ptr } is deep-copied into the child arena
// (codegen_deep_copy_closure), so the captured env (base) is child-owned. The
// worker-env-captures-a-function-value case still needs runtime function
// metadata (no RTTI) and remains E3145.

#use str
#use io
#use task

base = 10
g: Int => Int
g = a => a + base

w: (Int => Int) => Int
w = f => f(5)
w2: (Int => Int) => Int
w2 = f => f(7)

h = task::spawn(w(g))
r = task::join(h)
io::out $ str::from_int(r | v => v | -1)
h2 = task::spawn(w2(g))
r2 = task::join(h2)
io::out $ str::from_int(r2 | v => v | -1)
