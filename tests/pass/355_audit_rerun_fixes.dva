#use io
#use in
#use net/http
#use json

// --- Finding 1: HTTP query lookup ---
q1 = http::query_param("x=1&y=2", "y")
io::outf(q1 | _ | "none", "F1 y={}")

q2 = http::query_param("role=user&name=admin", "name")
io::outf(q2 | _ | "none", "F1 name={}")

q3 = http::query_param("x=1", "z")
io::outf(<>(q3), "F1 z present={}")

q4 = http::query_param("x=", "x")
io::outf((<>(q4), q4 | v => ?v | -1), "F1 x empty present={} len={}")

// --- Finding 2: HTTP Content-Length ---
cl1 = http::content_length("Content-Length: 12\r\n")
io::outf(cl1 | _ | -1, "F2 cl1={}")

cl2 = http::content_length("Content-Length:12\r\n")
io::outf(cl2 | _ | -1, "F2 cl2={}")

cl3 = http::content_length("content-length: 12\r\n")
io::outf(cl3 | _ | -1, "F2 cl3={}")

cl4 = http::content_length("X-Content-Length: 12\r\n")
io::outf(<>(cl4), "F2 x-cl present={}")

cl5 = http::content_length("Content-Length: invalid\r\n")
io::outf(<>(cl5), "F2 invalid present={}")

cl6 = http::content_length("Content-Length: 999999999999999999999\r\n")
io::outf(<>(cl6), "F2 overflow present={}")

cl7 = http::content_length("Content-Length: 10\r\nContent-Length: 20\r\n")
io::outf(<>(cl7), "F2 conflicting present={}")

// --- Finding 4: io console output wrappers and write ---
io::outs("F4 outs test")
w1 = io::write(1, "F4 write test\n")
io::outf(w1 > 0, "F4 write ret={}")

// --- Finding 5: in status inspection ---
io::outf((in::err(), <>(in::eof()), <>(in::would_block()), <>(in::has_err())), "F5 in status err={} eof={} wb={} has_err={}")
in::clear()
io::out("F5 in::clear called")

// --- Finding 6: json compensated decimal numbers ---
large = {340}
large += '1'
309 @
   large += '0'
large += "e-309"
a = json::parse(+large)!!
a [Number n] io::outf(n == 1.0, "F6 large n==1.0: {}")

small = {430}
small += "0."
399 @
   small += '0'
small += "1e400"
b = json::parse(+small)!!
b [Number n] io::outf(n == 1.0, "F6 small n==1.0: {}")

// --- Finding 7: json raw UTF-8 validation ---
bad_utf8 = {3}
bad_utf8 += '"'
bad_utf8 += 255
bad_utf8 += '"'
io::outf(<>(json::parse(+bad_utf8)), "F7 bad byte 255 present={}")

overlong_utf8 = {4}
overlong_utf8 += '"'
overlong_utf8 += 0xC0
overlong_utf8 += 0xAF
overlong_utf8 += '"'
io::outf(<>(json::parse(+overlong_utf8)), "F7 overlong present={}")

surrogate_utf8 = {5}
surrogate_utf8 += '"'
surrogate_utf8 += 0xED
surrogate_utf8 += 0xA0
surrogate_utf8 += 0x80
surrogate_utf8 += '"'
io::outf(<>(json::parse(+surrogate_utf8)), "F7 surrogate present={}")

good_utf8 = "\"hello \xE2\x9C\x93\""
io::outf(<>(json::parse(good_utf8)), "F7 valid utf8 present={}")
