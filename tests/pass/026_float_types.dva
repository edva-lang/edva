// 64-bit Float (default)
#use io

pi = 3.141593
io::out $ pi

// 32-bit Float (f32 suffix)
half_pi = 1.570796f32
io::out $ half_pi

// Float arithmetic (+, -, *, /)
sum = pi + 2.0
io::out $ sum

product = pi * 2.0
io::out $ product

// Mixed Int and Float coercion (Int + Float)
coerced = 10 + 0.5
io::out $ coerced

// Direct Flag Choice on Float comparison (with leading pipe)
temp = 38.2
status1 = temp > 37.5 | "Fever" | "Normal"
io::out $ status1

// Value-centric Multi-Predicate Matching
status2 = temp
    [(_ > 39.0)] "Critical Fever"
    [(_ > 37.5)] "Fever"
    | "Normal"
io::out $ status2
