// std/http module: reason phrases, header lines, response building, and the
// request-line path extractor. Header/response strings carry \r\n, so this
// checks their lengths and CR-free substrings rather than printing the whole
// byte sequence.

#use "net/http"
#use libc
#use io

// Reason phrases for status codes ("" for unknown).
io::out $ http::reason_of(200)
io::out $ http::reason_of(404)
io::out $ http::reason_of(999)

// header("Content-Type", "text/plain") = "Content-Type: text/plain\r\n".
h = http::header("Content-Type", "text/plain")
io::out $ ?h
io::out $ h(0..12)

// response(200, "Content-Length: 5\r\n", "hello") =
//   "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"  (43 bytes)
r = http::response(200, http::header("Content-Length", "5"), "hello")
io::out $ ?r
io::out $ r(0..15)
io::out $ r(38..43)

// path_of reads the request path out of a request-line buffer.
req = {64}
req += "GET /path HTTP/1.1\r\n"
io::out $ http::path_of(+req)
