// Enum labels are values: a bare variant name evaluates to its enum's tagged
// value (structurally the tag Int), so a choice can produce variants with no
// constructor call and no tag indices.

#use io

#type Flag <>
#type TokType <Id, Int, Str, Rune, Op, Other, Eof>

// Labels in choice branches directly.
classify: Int => TokType
classify = c =>
   <+>
      [c == 34] Str
      [c == 43] Int
      [c == 63] Other
      | Id

name: TokType => String
name = t =>
   t [Id] "id" [Int] "int" [Str] "str" [Rune] "rune" [Op] "op" [Other] "other" [Eof] "eof"

io::out $ name(classify(34))
io::out $ name(classify(43))
io::out $ name(classify(63))
io::out $ name(classify(99))

// Labels bind into an annotated variable, then pass through a coercion.
token: TokType
token = classify(34)
io::out $ name(TokType(token))

// Labels in any value context.
direct = classify(43)
io::out $ name(direct)
