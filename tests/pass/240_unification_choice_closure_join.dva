// Choice joins between closure values: unifying closure types across branches.
#use io

make_op = flag, a, b =>
   flag > 0
      | (x => x + a)
      | (x => x * b)

f1 = make_op(1, 10, 20)
f2 = make_op(0, 10, 20)
io::out $ f1(5)
io::out $ f2(5)

select_calc = mode, base =>
   mode
      [1] (v => v + base)
      [2] (v => v - base)
      | (v => v * base)

c1 = select_calc(1, 100)
c2 = select_calc(2, 50)
c3 = select_calc(3, 4)
io::out $ c1(20)
io::out $ c2(70)
io::out $ c3(25)

choose_formatter: Int, String => (String => String)
choose_formatter = flag, prefix =>
   flag > 0
      | (s => prefix + ": " + s)
      | (s => "[" + prefix + "] " + s)

fmt1 = choose_formatter(1, "INFO")
fmt2 = choose_formatter(0, "WARN")
io::out $ fmt1("starting")
io::out $ fmt2("low disk")
