// fmt: integer formatting helpers (int_to_str / hex_to_str). The module had
// no test coverage (codebase_review L8).

#use str
#use io

io::out $ str::from_int(0)
io::out $ str::from_int(-42)
io::out $ str::from_int(255)
io::out $ str::hex_to_str(0)
