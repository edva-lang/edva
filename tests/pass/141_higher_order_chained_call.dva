// Higher-order functions as first-class values: a function VALUE (not a call)
// can be stored, passed, and — when a call's result is itself a function —
// applied with a second postfix argument list: "f(x)(y)". A function used as a
// value needs a declared signature (its param types are otherwise unknowable);
// the full signature (params + return) then threads through variables, params,
// and chains statically.

#use io

add: Int, Int => Int
add = a, b => a + b

inc: Int => Int
inc = a => a + 1

// Function values: store and call.
g = add
io::out $ g(3, 4)

// A function taking a function parameter, applied via the param. The
// function-typed param is written flat inside the parens: "(Int, Int => Int)".
call3: (Int, Int => Int), Int, Int => Int
call3 = f, x, y => f(x, y)
io::out $ call3(add, 10, 20)

// Chained application: pick(1) returns the function value inc; (7) applies it.
pick: Int => (Int => Int)
pick = x => inc
io::out $ pick(1)(7)

// Three-level chain: one(x) returns pick; (1) returns inc; (7) applies.
one: Int => (Int => (Int => Int))
one = x => pick
io::out $ one(0)(1)(7)

// A function value produced by a choice, then applied.
res = 1 > 0 | pick(2) | pick(3)
io::out $ res(10)

// The postfix equivalent of applying a value to a returned function (the
// infix-apply now APPENDS an argument to the call itself: "pick(1) $ 5" would
// be pick(1, 5), so use the postfix form for the returned function).
io::out $ pick(1)(5)
