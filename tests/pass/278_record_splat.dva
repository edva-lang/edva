#use io

b = (20, 30)
r = (10, ..b, 40)
io::out $ r.0
io::out $ r.1
io::out $ r.2
io::out $ r.3

named_b = (x = 100, y = 200)
named_r = (a = 50, ..named_b, z = 300)
io::out $ named_r.a
io::out $ named_r.x
io::out $ named_r.y
io::out $ named_r.z

r2 = (..(1, 2), 3)
io::out $ r2.0
io::out $ r2.1
io::out $ r2.2
