root = .
instances =
  root =
    src = src
    aliases =
      json = json@1
      json_old = json@2
      math = math@1
  json@1 =
    src = packages/json_v1/src
    name = json
    aliases =
      utf8 = utf8@1
  json@2 =
    src = packages/json_v2/src
    name = json
  math@1 =
    src = packages/math/src
    name = math
  utf8@1 =
    src = packages/utf8/src
    name = utf8
