// Forward annotations and field-init tracking.
//
// A bare "name: Type" (no initializer) binds the name + type but allocates
// NO storage and zero-fills nothing. A record's fields are tracked at compile
// time: a field write ("t.a = v") marks it written, and a read of an unwritten
// field is a compile error. A homogeneous record (array) requires a
// whole-value assignment before its elements can be read or written.

#use io

#type T (a: Int, b: Int)

// Record forward annotation: each field is written before it is read.
t: T
t.a = 42
t.b = 0
io::out $ t.a
io::out $ t.b

// Scalar forward annotation: "counter = 7" allocates the slot on first write.
counter: Int
counter = 7
io::out $ counter

// Array forward annotation: a whole-value assignment initializes the elements.
arr: (Int * 3)
arr = (9, 0, 0)
io::out $ arr(0)
io::out $ arr(1)
io::out $ arr(2)

// Whole-value assignment to a forward-annotated scalar.
flag: Int
flag = 5
flag = flag + 1
io::out $ flag

// Whole-value assignment then element mutation.
w: (Int * 2)
w = (5, 7)
w(1) = 8
io::out $ w(0)
io::out $ w(1)

// Scalar write after a record's writes (separate variables are unaffected).
v: Int
v = 1
io::out $ v
