// A choice in a discard context (a statement — its value is .Unassignable)
// need not be exhaustive: a guard-only enum choice with no trailing fallback
// is legal as a statement, and the matched branch still runs for its side
// effect. Only a choice whose VALUE is consumed (e.g. a function's return)
// must cover every enum variant.

#use io

#type TokKind < Op, Id, RBracket >
#type Tok (kind: TokKind, text: String)

f: Tok => Int
f = p =>
   p.kind
      [Id] io::out $ "id"
   p.kind
      [RBracket] io::out $ "rb"
   0

io::out $ f(Tok((TokKind(Id), "n")))
io::out $ f(Tok((TokKind(RBracket), "x")))
io::out $ f(Tok((TokKind(Op), "+")))