// std/prelude.dva auto-loads into every program — these combinators are
// global with no "**prelude" import, and they are generic (a compile-time
// type parameter inferred from the arguments). The helpers need declared
// signatures so they can be read as function values.

#use(import) fp
#use io

inc: Int => Int
inc = x => x + 1
dbl: Int => Int
dbl = x => x * 2
add: Int, Int => Int
add = a, b => a + b
sub3: Int, Int, Int => Int
sub3 = a, b, c => a - b - c
show: Int => ()
show = x => io::out $ x

io::out $ apply(dbl, 21)
io::out $ apply2(add, 40, 2)
io::out $ apply3(sub3, 10, 3, 2)
io::out $ twice(dbl, 21)
io::out $ thrice(inc, 0)
io::out $ flip(add, 2, 40)
io::out $ on(add, dbl, 3, 4)
io::out $ ident(7)
io::out $ tap(9, show)

// A String => String function flows through the same generic combinators.
greet: String => String
greet = s => "hi " + s
io::out $ twice(greet, "x")
io::out $ apply(greet, "bob")
