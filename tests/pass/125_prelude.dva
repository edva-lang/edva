// std/prelude.dva auto-loads into every program — these combinators are
// global with no "**prelude" import, and they are generic (a compile-time
// type parameter inferred from the arguments). The helpers need declared
// signatures so they can be read as function values.

#use(import) fp

inc: Int => Int
inc = x => x + 1
dbl: Int => Int
dbl = x => x * 2
add: Int, Int => Int
add = a, b => a + b
sub3: Int, Int, Int => Int
sub3 = a, b, c => a - b - c
show: Int => ()
show = x => print_int $ x

print_int $ apply(dbl, 21)
print_int $ apply2(add, 40, 2)
print_int $ apply3(sub3, 10, 3, 2)
print_int $ twice(dbl, 21)
print_int $ thrice(inc, 0)
print_int $ flip(add, 2, 40)
print_int $ on(add, dbl, 3, 4)
print_int $ ident(7)
print_int $ tap(9, show)

// A String => String function flows through the same generic combinators.
greet: String => String
greet = s => "hi " + s
print $ twice(greet, "x")
print $ apply(greet, "bob")
