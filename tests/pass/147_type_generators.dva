// Type generators: a compile-time function ("#! T: Type => <type>") yields a
// type, and "IntPair: Pair(Int)" instantiates it into a declared type whose
// fields are substituted with the bound type.

#use io

Pair: #! T: Type => (a: T, b: Int)

#type IntPair Pair(Int)
p: IntPair
p.a = 42
p.b = 7
io::out $ p.a
io::out $ p.b

#type StrPair Pair(String)
q: StrPair
q.a = "hi"
q.b = 1
io::out $ q.a
io::out $ q.b
