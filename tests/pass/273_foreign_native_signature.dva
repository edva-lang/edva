#use "str"

#foreign "c"
   write: (fd: Int, buf: String, count: Int) => Int
   my_free = free: (ptr: Addr) => ()
   malloc: (size: Int) => Addr
   __errno_location: () => Addr

msg = "native foreign signature ok\n"
write(1, msg, ?msg)
err_ptr = __errno_location()
print $ err_ptr != Addr(0) | "has_errno" | "no_errno"

p = malloc(64)
print $ p != Addr(0) | "malloc_ok" | "malloc_fail"
my_free(p)
print $ "free_ok"
