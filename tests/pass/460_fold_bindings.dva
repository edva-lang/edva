#use io
#use str

::shared = 90
#type Totals (sum: Int, tag: Int)

folded: Int => Int
folded = acc =>
   res = (0, 4) @> (acc, x => acc + x)
   acc * 100 + res

#export fold_shadow_fusion: Int => Int
fold_shadow_fusion = acc =>
   res = (0, (acc @> (x => x + 1))) @> (acc, x => acc + x)
   acc * 100 + res

local_fold: Int => Int
local_fold = base =>
   acc = base + 10
   res = (0, Int{}(2, 4, 6)) @> (acc, x, i => acc + x + i)
   acc * 100 + res

map_fold: Int => Int
map_fold = n =>
   values = (2 ^= 3, 5 ^= 7)
   res = (n, values) @> (shared, x, k => shared + x + k)
   shared * 100 + res

nested_fold: Int => Int
nested_fold = acc =>
   res = (1, 3) @> acc, x =>
      inner = (acc, 2) @> (acc, y => acc + y)
      acc * 2 + inner + x
   acc * 1000 + res

record_fold: Totals => Int
record_fold = acc =>
   res = (Totals(0, 7), 4) @> (acc, x => acc(sum = acc.sum + x))
   acc.sum * 1000 + acc.tag * 100 + res.sum * 10 + res.tag

unrolled_fold: Int => Int
unrolled_fold = acc =>
   fields = Totals(2, 3)
   res = (0, 0..2) @> (acc, i => acc + (#member fields, i))
   acc * 100 + res

builder_fold: () => String
builder_fold = !=>
   acc = {16}
   acc += "outer"
   res = ({16}, 3) @> acc, x =>
      acc += str::from_int(x)
   "${+acc}:${+res}"

generic_fold: #param T: Type, T, T => (T, T)
generic_fold = acc, seed =>
   res = (seed, 3) @> (acc, x => acc)
   (acc, res)

io::out $ folded(9)
io::out $ fold_shadow_fusion(4)
io::out $ local_fold(2)
io::out $ map_fold(1)
io::out $ nested_fold(9)
io::out $ record_fold(Totals(8, 9))
io::out $ unrolled_fold(7)
io::out $ builder_fold!
pair = generic_fold("outer", "seed")
io::out $ "${pair.0}:${pair.1}"
