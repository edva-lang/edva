#use fmt
#use io
io::out $ fmt::tprintf_s1("var.%s", "alpha")
io::out $ fmt::tprintf_s2("%s::%s", "net", "get")
io::out $ fmt::tprintf_s3("%s.%s.%s", "a", "b", "c")
io::out $ fmt::tprintf_i1("loop.header.%d", 7)
io::out $ fmt::tprintf_i2("choice.case%d.%d", 3, 5)
io::out $ fmt::tprintf_s2("var.%s", "only", "x")
io::out $ fmt::tprintf_s2("flat", "a", "b")
