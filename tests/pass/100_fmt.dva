#use fmt
print $ fmt::tprintf_s1("var.%s", "alpha")
print $ fmt::tprintf_s2("%s::%s", "net", "get")
print $ fmt::tprintf_s3("%s.%s.%s", "a", "b", "c")
print $ fmt::tprintf_i1("loop.header.%d", 7)
print $ fmt::tprintf_i2("choice.case%d.%d", 3, 5)
print $ fmt::tprintf_s2("var.%s", "only", "x")
print $ fmt::tprintf_s2("flat", "a", "b")
