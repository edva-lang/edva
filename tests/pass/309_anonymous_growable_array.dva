#use io

xs: (Int){}
xs += 10
xs += 20
xs += 30
io::out $ ?xs
io::out $ (xs(0) | _ | _)
io::out $ (xs(1) | _ | _)
io::out $ (xs(2) | _ | _)

sum: (Int){} => Int
sum = a =>
   tot' = 0
   ?a @ i =>
      tot' = tot' + (a(i) | v => v | 0)
   tot'

s = sum(xs)
io::out $ s

names: (String){3}
names += "hello"
names += "world"
io::out $ ?names
io::out $ (names(0) | _ | _)
io::out $ (names(1) | _ | _)

#type Container (
   id: Int,
   tags: (String){}
)

c: Container
c.id = 7
io::out $ c.id

make_ints: Int => (Int){}
make_ints = n =>
   arr: (Int){}
   n @ i => arr += (i + 1) * 10
   arr

res = make_ints(4)
io::out $ ?res
io::out $ (res(0) | _ | _)
io::out $ (res(3) | _ | _)

make_strs: String => (String){}
make_strs = s =>
   arr: (String){}
   arr += s
   arr

c.tags = make_strs("first_tag")
c.tags += "second_tag"
io::out $ ?c.tags
io::out $ (c.tags(0) | _ | _)
io::out $ (c.tags(1) | _ | _)

io::out $ "iter:"
xs @ elem => io::out $ elem

xs(1) = 99 !| _
io::out $ (xs(1) | _ | _)

c_arr = ++xs
io::out $ ?c_arr
io::out $ (c_arr(1) | _ | _)

unparen_arr: Int{}
unparen_arr += 500
io::out $ (unparen_arr(0) | _ | _)

flags: <>{}
flags += <+>
io::out $ (flags(0) | _ => 1 | 0)

matrix: Int{}{}
row: Int{}
row += 999
matrix += row
r = matrix(0) | v => v | row
io::out $ (r(0) | _ | _)

// Expression constructors
lit_arr = Int{}
lit_arr += 111
io::out $ ?lit_arr
io::out $ (lit_arr(0) | _ | _)

lit_arr32 = Int{32}
lit_arr32 += 222
io::out $ (lit_arr32(0) | _ | _)

lit_parr = (Int){}
lit_parr += 333
io::out $ (lit_parr(0) | _ | _)

lit_strs = String{}
lit_strs += "anon"
io::out $ (lit_strs(0) | _ | _)

lit_mat = Int{}{}
lit_row = Int{}
lit_row += 777
lit_mat += lit_row
mr = lit_mat(0) | v => v | lit_row
io::out $ (mr(0) | _ | _)

io::out $ "OK"

