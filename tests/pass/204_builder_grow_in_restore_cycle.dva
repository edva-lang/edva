// A Builder and a growable array accumulated across a cycle whose body ALSO
// allocates (a string concat → per-iteration arena restore scope). The growth
// buffers used to be reaped by the restore and overwritten, corrupting the
// accumulation (prints "ab" instead of the accumulated content). Growth in a
// restore scope now malloc's the new buffer.
#use io

f = bs =>
   out = {2}
   ?bs @ i =>
      out += 'x'
      g = "a" + "b"
   io::out $ +out
   0
m = (1, 2, 3, 4, 5)
f(m)

#type Ints (Int){}
g2 = bs =>
   a = Ints()
   ?bs @ i =>
      a += i
      h = "c" + "d"
   io::out $ ?a
   0
g2((1, 2, 3, 4, 5, 6, 7, 8))