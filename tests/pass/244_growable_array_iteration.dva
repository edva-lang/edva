#use io

#type Ints (Int){}
#type Names (String){}
#type Rect (w: Int, h: Int)
#type Grid (Rect){}

// 1. Int growable array iteration
xs: Ints
xs += 10
xs += 20
xs += 30

// 1-param iteration
xs @ x =>
   io::out $ x

// 2-param iteration with index
xs @ x, i =>
   io::out $ i
   io::out $ x

// Block iteration with _ and _i
xs @
   io::out $ _
   io::out $ _i

// 2. String growable array iteration
names: Names
names += "hello"
names += "world"

names @ s =>
   io::out $ s

names @ s, i =>
   io::out $ i
   io::out $ s

// 3. Record growable array iteration
grid: Grid
grid += (w = 3, h = 4)
grid += (w = 5, h = 6)

grid @ g =>
   io::out $ g.w
   io::out $ g.h

grid @ g, i =>
   io::out $ i
   io::out $ g.w
   io::out $ g.h

// 4. Empty array (zero iterations)
empty = Ints()
empty @ x =>
   io::out $ 999

empty_fwd: Ints
empty_fwd @ x =>
   io::out $ 999

io::out $ "done empty"

// 5. Break and escape
r = xs @ x =>
   x == 20 | -->
>--
   777

io::out $ (r | _ | 0)

// 6. Continue
xs @ x, i =>
   x == 20 | --^
   io::out $ x
