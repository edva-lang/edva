#use sort
#use io
xs = sort::Strings()
xs += "pear"
xs += "apple"
xs += "orange"
xs += "banana"
ys = sort::strings(xs)
ys @ y => io::out $ y
nums = sort::Ints()
nums += 42
nums += 7
nums += 100
nums += 3
sorted = sort::ints(nums)
sorted @ n => io::out $ n
empty = sort::Strings()
none = sort::strings(empty)
io::out $ "done"
