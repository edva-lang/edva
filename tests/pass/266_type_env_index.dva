#use "../../src/ast"
#use "../../src/type_env"
#use "../../src/unify"
#use "str"
#use io

ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))

show_binding: type_env::TypeEnv, unify::Ctx, String => String
show_binding = env, ctx, name =>
   type_env::lookup_binding(env, name)
      | b => unify::show_utype(ctx, b.ut)
      | "missing"

env = type_env::new_env!
ctx = unify::new_ctx!
type_env::bind_local(env, "x", unify::prim_int!, ti_unk, <->)
1000 @ i => type_env::bind_local(env, str::from_int(i),
   unify::prim_int!, ti_unk, <->)
io::out $ show_binding(env, ctx, "x")
io::out $ show_binding(env, ctx, "999")
type_env::bind_local(env, "x", unify::prim_float!, ti_unk, <+>)
io::out $ show_binding(env, ctx, "x")
binding = type_env::lookup_local(env, "x")
mutable = binding | b => b.is_mut | <->
io::out $ (mutable | 1 | 0)
type_env::enter_scope(env)
local = type_env::lookup_local(env, "x")
io::out $ (local | b => b.name | "local missing")
io::out $ show_binding(env, ctx, "x")
type_env::bind_local(env, "x", unify::prim_str!, ti_unk, <->)
io::out $ show_binding(env, ctx, "x")
type_env::leave_scope(env)
io::out $ show_binding(env, ctx, "x")
io::out $ show_binding(env, ctx, "absent")
type_env::bind_local(env, "mod::public", unify::prim_int!, ti_unk, <->)
type_env::bind_local(env, "mod::#secret", unify::prim_str!, ti_unk, <->)
type_env::set_current_module(env, "mod")
io::out $ show_binding(env, ctx, "public")
io::out $ show_binding(env, ctx, "secret")
type_env::set_current_module(env, "elsewhere")
io::out $ show_binding(env, ctx, "secret")
