// Explicit expectations retain postfix chaining.

#use io

#type User (name: String, age: Int)

add_ten = x => x + 10

#type IntArr Int{}
#type UserArr User{}
#type Matrix IntArr{}

// 1. Basic array element unwrap
a = IntArr()
a += 10
a += 20
a += 30
x = a(0).expect("missing a")
y = a(1).expect("missing a")
z = a(2).expect("missing a")
io::out $ str::from_int(x)
io::out $ str::from_int(y)
io::out $ str::from_int(z)

// 2. Member chaining: users(i).expect("existing user").name
users = UserArr()
users += User("Alice", 30)
users += User("Bob", 25)
io::out $ users(0).expect("missing users").name
io::out $ str::from_int(users(1).expect("missing users").age)

// 3. Nested unwrap
row0 = IntArr()
row0 += 1
row0 += 2
row1 = IntArr()
row1 += 3
row1 += 4
m = Matrix()
m += row0
m += row1
v1 = m(0).expect("missing m")(1).expect("required payload")
v2 = m(1).expect("missing m")(0).expect("required payload")
io::out $ str::from_int(v1)
io::out $ str::from_int(v2)

// 4. Pipeline flow
res = a(0).expect("missing a") $> add_ten
io::out $ str::from_int(res)

// 5. RamPN unwrap
r_pn = <+ 42 ->
io::out $ str::from_int(r_pn.expect("missing r pn"))

// 6. RamPP unwrap
r_pp = <+ "unwrapped string" ->
io::out $ r_pp.expect("missing r pp")
