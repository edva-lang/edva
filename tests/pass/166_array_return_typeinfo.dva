// A composite (growable-array / slice) returned from a function keeps its
// TypeInfo through the return → variable channel, so the caller can index
// (`out(0)`) or view (`sl(0..2)`) the result without a forward annotation.

#use io

#type Ints (Int){}

mk: Int => Ints
mk = n =>
   ys: Ints
   ys += n
   ys += n + 1
   ys

out = mk(10)
io::out $ (out(0) | _ | _)
io::out $ (out(1) | _ | _)
io::out $ ?out

// A slice returned from a function, then indexed.
src: Ints
src += 5
src += 6
src += 7

head2: Ints => (Int[])
head2 = xs =>
   xs(0..2)

sl = head2(src)
io::out $ sl(0)
io::out $ sl(1)
