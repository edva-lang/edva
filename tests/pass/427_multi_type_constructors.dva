#use io
Result: #param T: Type, #param E: Type => < T | E >
Pair: #param A: Type, #param B: Type => (a: A, b: B)
#type R1 Result(Int, String)
div: Int, Int => R1
div = a, b => b [0] <- "div0" +> | <+ a / b ->
div(7, 2) | v => io::out(v) | e => io::out(e)
div(7, 0) | v => io::out(v) | e => io::out(e)
#type PP Pair(Pair(Int, String), Float)
pp: PP
pp = (a = (a = 1, b = "in"), b = 2.5)
io::out(pp.a.b)
io::out(pp.b)
swap: #param A: Type, #param B: Type, Pair(A, B) => Pair(B, A)
swap = p => (a = p.b, b = p.a)
s = swap(pp.a)
io::out(s.a)
io::out(s.b)
