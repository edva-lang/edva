// Cross-module composite types: a module's enum, recursive enum, growable
// array, and map referenced from the importer. Exercises the deferred
// ValueType propagation (enum/array/map resolve to their real ValueType, not
// the parse-time .Record placeholder).

#use "m"
#use io

f: m::Color => Int
f = c => c [Red] 1 | 2

io::out $ f(m::Color(Red))
io::out $ f(m::Color(Green))

cs = m::Colors()
cs += m::Color(Green)
io::out $ ?cs

e = m::Env()
e ^ "a" = 10
io::out $ (e ^ "a" | _ | _)

count: m::Tree => Int
count = t => t [Leaf n] n | 0

t = m::Tree(Leaf, 5)
io::out $ count(t)
