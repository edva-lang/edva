// Compile-time iteration over enum variants (completes the reflection slice):
// "#arity T" on a bound enum type is the VARIANT COUNT, and "#member T, i" is the i-th
// variant's label as a compile-time String. A cycle over "0..(#arity T)" is unrolled,
// so "join_labels"/"labels_arr" work for any enum type with # member reflection.

#use str
#use io

#type Color < Red, Green, Blue >
#type Shape < Circle, Square, Triangle, Hexagon >
#type Names String{}

nvariants: #param T: Type, T => Int
nvariants = x => #arity T

label0: #param T: Type, T => String
label0 = x => #member T, 0

label2: #param T: Type, T => String
label2 = x => #member T, 2

join_labels: #param T: Type, T => String
join_labels = x =>
   out = {16}
   0..(#arity T) @ i =>
      i > 0 | out += ","
      out += #member T, i
   +out

labels_arr: #param T: Type, #param Out: Type, T, Out => Out
labels_arr = x, out =>
   0..(#arity T) @ i =>
      out += #member T, i
   out

c: Color
c = Red
io::out $ str::from_int(nvariants(c))
io::out $ label0(c)
io::out $ label2(c)
io::out $ join_labels(c)

s: Shape
s = Circle
io::out $ str::from_int(nvariants(s))
io::out $ join_labels(s)

o0 = Names()
n = labels_arr(c, o0)
io::out $ str::from_int(?n)
io::out $ n(0) | _ | "?"
io::out $ n(2) | _ | "?"