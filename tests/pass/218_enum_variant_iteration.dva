// Compile-time iteration over enum variants (completes the reflection slice):
// "?T" on a bound enum type is the VARIANT COUNT, and "T.(i)" is the i-th
// variant's label as a compile-time String. A cycle over "0..?T" is unrolled,
// so "join_labels"/"labels_arr" work for any enum type with no new syntax.

#use "str"
#use io

#type Color < Red, Green, Blue >
#type Shape < Circle, Square, Triangle, Hexagon >
#type Names (String){}

nvariants: #! T: Type, T => Int
nvariants = _ => ?T

label0: #! T: Type, T => String
label0 = _ => T.(0)

label2: #! T: Type, T => String
label2 = _ => T.(2)

join_labels: #! T: Type, T => String
join_labels = _ =>
   out = {16}
   0..?T @ i =>
      i > 0 | out += ","
      out += T.(i)
   +out

labels_arr: #! T: Type, #! Out: Type, T, Out => Out
labels_arr = _, out =>
   0..?T @ i =>
      out += T.(i)
   out

c: Color
c = Red
io::out $ str::from_int(nvariants(c))
io::out $ label0(c)
io::out $ label2(c)
io::out $ join_labels(c)

s: Shape
s = Circle
io::out $ str::from_int(nvariants(s))
io::out $ join_labels(s)

o0 = Names()
n = labels_arr(c, o0)
io::out $ str::from_int(?n)
io::out $ n(0) | _ | "?"
io::out $ n(2) | _ | "?"