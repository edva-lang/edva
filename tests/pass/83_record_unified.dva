// Record unification: parentheses-based records replace arrays and tuples.

// Homogeneous positional record (the old array): dynamic index, length, slice.
#use io

r = (10, 20, 30)
io::out $ r(0)
io::out $ r(1)
io::out $ r(2)
io::out $ ?r

// Static member access on a homogeneous record.
io::out $ r.0
io::out $ r.1
io::out $ r.2

// Named homogeneous record: dynamic indexing and iteration both work.
n = (x = 1, y = 2)
io::out $ n(0)
io::out $ n(1)
n @ e => io::out $ e

// Heterogeneous record: static member access only.
h = (name = "dva", age = 30)
io::out $ h.name
io::out $ h.age
io::out $ h.0
io::out $ h.1

// One-element records: "(5,)" is a record, "(5)" is a grouped expression.
one = (5,)
io::out $ one(0)
io::out $ ?one

// Record length on a named record.
io::out $ ?n

// Records as function parameters: a homogeneous record is passed by value
// (flat register), so indexing/length/iteration work on the parameter.
len: (Int, Int, Int) => Int
len = x => ?x
first: (Int, Int, Int) => Int
first = x => x(0)
rsum: (Int, Int, Int) => Int
rsum = x =>
    acc' = 0
    x @ e => acc' = acc' + e
    acc'
io::out $ len $ r
io::out $ first $ r
io::out $ rsum $ r
