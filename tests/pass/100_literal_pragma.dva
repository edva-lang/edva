// Typed integer literals, #pragma number, and postfix {N} repetition.
#use io

a = 5i16
io::out $ a
b = 0xFFu8
io::out $ b
c = 0b101u16
io::out $ c

// Repetition: 0 {5} = five zeros; splices flat in a record.
r = (0 {5})
io::out $ r(0)
io::out $ r(4)
s = (1, 2 {3}, 9)
io::out $ s(0)
io::out $ s(3)
io::out $ s(4)
