// C2: integer '*'/'/'/'%' now reject non-integer operands, widen mismatched
// integer widths to i64 before the LLVM op (previously 'sdiv i16, i64'
// produced invalid IR that clang rejected), and pick unsigned vs signed
// division by the operand types.

#use io

a = 5i16
c = a / 2
io::out $ c

d = a * 2
io::out $ d

e = 7i16 % 2
io::out $ e

f = 2 * a
io::out $ f

// Unsigned semantics: 0xFF is 255, so 255 / 2 = 127 (a signed i8 -1 / 2
// would wrongly give 0).
u = 0xFFu8
io::out $ u / 2
io::out $ u % 16
