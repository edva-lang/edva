// Test string vs string tuple comparison (== and !=)

#use io

s = "hello::world"
t1 = ("hello", "::", "world")
t2 = ("hello", "::", "other")
t3 = ("hel", "lo::", "world")
t4 = ("hello", "::")

io::out $ s == t1 | "T" | "F"
io::out $ s != t1 | "T" | "F"

io::out $ s == t2 | "T" | "F"
io::out $ s != t2 | "T" | "F"

io::out $ s == t3 | "T" | "F"
io::out $ s == t4 | "T" | "F"

// Reverse order: tuple == string
io::out $ t1 == s | "T" | "F"
io::out $ t2 == s | "T" | "F"

// Substrings and variables
mod = "foo"
bare = "bar"
qual = "foo::bar"
io::out $ qual == (mod, "::", bare) | "T" | "F"
io::out $ qual != (mod, "::", bare) | "T" | "F"
io::out $ qual == (mod, "::#", bare) | "T" | "F"
io::out $ (mod, "::", bare) == qual | "T" | "F"

// Dynamic record variable
rec = (mod, "::", bare)
io::out $ qual == rec | "T" | "F"
io::out $ rec == qual | "T" | "F"
