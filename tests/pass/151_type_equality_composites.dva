// Structural compile-time type equality over generated composite types: two
// distinct instantiations of a generator compare equal by structure (not by
// pointer identity), and a type variable bound to a ram argument dispatches on
// the generated ramification type.

#use io

Opt: #! T: Type => < T | >
#type IntOpt Opt(Int)
#type IntOpt2 Opt(Int)
#type StrOpt Opt(String)

io::out $ (IntOpt == IntOpt2 | 1 | 0)
io::out $ (IntOpt == StrOpt | 1 | 0)

classify: #! T: Type, T => Int
classify = #! T, x =>
   T == IntOpt | 1 | 0

io::out $ classify(<+ 42 ->)
io::out $ classify(<+ "x" ->)

// Array types compare by element type.
#type Ints (Int){}
#type Ints2 (Int){}
#type Strs (String){}

io::out $ (Ints == Ints2 | 1 | 0)
io::out $ (Ints == Strs | 1 | 0)
