// Comprehensive test for std/fp predicates & pipelining (Issue #119)
#use(import) fp
#use io
#use str

is_even: Int => <>
is_even = n => n % 2 == 0

is_pos: Int => <>
is_pos = n => n > 0

dbl: Int => Int
dbl = n => n * 2

inc: Int => Int
inc = n => n + 1

to_msg: Int => String
to_msg = n => "item=" + str::from_int(n)

// 1. complement
is_odd = complement(is_even)
io::out $ (is_odd(3) | "3 is odd" | "3 not odd")
io::out $ (is_odd(4) | "4 is odd" | "4 not odd")

nums = Int{}
nums += -2
nums += -1
nums += 0
nums += 1
nums += 2
nums += 3
nums += 4

odds_by_filter = filter(complement(is_even), nums)
odds_by_reject = reject(is_even, nums)
io::out $ "eq_lens=" + str::from_int(?odds_by_filter == ?odds_by_reject | 1 | 0)

// 2. both
pos_even = both(is_pos, is_even)
io::out $ (pos_even(4) | "4 pos_even" | "4 not pos_even")
io::out $ (pos_even(-2) | "-2 pos_even" | "-2 not pos_even")
io::out $ (pos_even(3) | "3 pos_even" | "3 not pos_even")

// 3. either_pred
pos_or_even = either_pred(is_pos, is_even)
io::out $ (pos_or_even(3) | "3 pos_or_even" | "3 not pos_or_even")
io::out $ (pos_or_even(-2) | "-2 pos_or_even" | "-2 not pos_or_even")
io::out $ (pos_or_even(-3) | "-3 pos_or_even" | "-3 not pos_or_even")

// 4. pipe
p1 = pipe(dbl, inc)
io::out $ "pipe(5)=" + str::from_int(p1(5))

p2 = pipe(p1, to_msg)
io::out $ p2(5)

// 5. pipe inside map
mapped = map(pipe(dbl, inc), nums)
io::out $ "mapped_0=" + str::from_int(mapped(0) | _ | 0)
io::out $ "mapped_4=" + str::from_int(mapped(4) | _ | 0)
io::out $ "mapped_6=" + str::from_int(mapped(6) | _ | 0)
