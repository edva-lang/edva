#param App: Module
#public
read_count = m =>
   #has_member App::Model, count | m.count | App::count(m)
read_label = m =>
   #has_member App::Model, label | m.label | App::label(m)
run: App::Model => Int
run = m =>
   #has_member App, key_escape | App::key_escape(m)
   read_count(m)
present = #has_member App, label
private_member = #has_member App, hidden
loop: () => Int
loop = !=>
   total' = 0
   App::NUM @ i => total' = total' + 1
   total'

probe_statement: () => ()
probe_statement = !=> #has_member App, label | App::count(App::init!)
