// str::from_float — decimal Float formatting, %g-style (6 significant digits,
// fixed notation for mid-range magnitudes, scientific otherwise, trailing
// zeros trimmed).

#use str
#use io

io::out $ str::from_float(0.0)
io::out $ str::from_float(1.5)
io::out $ str::from_float(-2.75)
io::out $ str::from_float(3.0)
io::out $ str::from_float(100.0)
io::out $ str::from_float(0.5)
io::out $ str::from_float(3.14159)
io::out $ str::from_float(0.00123)
io::out $ str::from_float(1000000.0)
io::out $ str::from_float(0.00001)
io::out $ str::from_float(1234567.0)
io::out $ str::from_float(3.14159265)
