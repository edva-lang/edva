// Cycle-escape "CYCLE >-- BRANCH" regression tests.
//
// Semantics (CycleExpr ::= Iterable "@" FnExpr [ ">--" BranchBody ]):
//   - "-->" (break) that resolves to the wrapped cycle diverts control to
//     BRANCH, producing <+ BRANCH +> (positive payload of < T | >).
//   - If the cycle completes without such a break, BRANCH is skipped and the
//     result is <--> (negative unit / absence of < T | >).
//   - "--^" (continue) never triggers BRANCH; it only skips to the next
//     iteration.

print_int $ 1000

// No break: cycle runs to completion, branch is skipped, result is <-->
// (absence). Body prints 0..4.
r1 = 5 @ i =>
        print_int $ i
>--
   99
print_int $ (r1 | _ | 0)

print_int $ 2000

// Break: "-->" at i==3 diverts to branch 99. Body prints 0,1,2,3.
r2 = 5 @ i =>
        print_int $ i
        i [3] -->
>--
   99
print_int $ (r2 | _ | 0)

print_int $ 3000

// Continue: "--^" at i==2 skips that iteration; cycle completes normally,
// so the branch never fires and the result is <-->. Body prints 0,1,3,4.
r3 = 5 @ i =>
        print_int $ i
        i [2] --^
>--
   99
print_int $ (r3 | _ | 0)

print_int $ 4000

// Branch fires with a non-trivial value: escape returns <+ 42 +> when i==2.
r4 = 3 @ i =>
        i [2] -->
>--
   42
print_int $ (r4 | _ | 0)

print_int $ 5000

// Inline branch form (same line).
r5 = 5 @ i => i [3] --> >-- 77
print_int $ (r5 | _ | 0)

print_int $ 6000
