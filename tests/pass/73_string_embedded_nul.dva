// Embedded-NUL string literals: escapes decode to real NUL bytes, and the
// fat String keeps the full length (no C-string truncation). Equality is
// content-based over the full length.
#use io

s = "a\0b"
io::out $ ?s

c = s == "a\0b"
io::out $ (c | "Positive" | "Negative")

d = s == "axb"
io::out $ (d | "Positive" | "Negative")

e = ?s == 2
io::out $ (e | "Positive" | "Negative")
