// The '!=' operator — the comparison-tier complement of '=='.
// Same tier as '<' / '>' / '==', so chains are left-associative on one line.
//
// Semantics per operand type:
//   integerish  — value inequality (unsigned operands use unsigned NE)
//   Float/Float32 — FCmp UNE (C-style: NaN != anything is true)
//   String,String  — content inequality (the complement of content equality)
//   Builder/Record/Addr — pointer/reference identity inequality
//   ramification  — compile error (E3027/E3127), covered in tests/fail

// integerish
print $ ( 1 != 2 | "Positive" | "Negative")
print $ ( 2 != 2 | "Positive" | "Negative")
print $ ( -1 != 1 | "Positive" | "Negative")
// unsigned comparison: 0xFF u8 != 0xFE u8 is true at the value level
print $ ( 0xFFu8 != 0xFEu8 | "Positive" | "Negative")
print $ ( 0xFFu8 != 0xFFu8 | "Positive" | "Negative")
// mixed width
print $ ( 70000i16 != 69999 | "Positive" | "Negative")
print $ ( 5 != 5i8 | "Positive" | "Negative")

// floats (exact values; no NaN in the arithmetic below)
print $ ( 1.5 != 2.5 | "Positive" | "Negative")
print $ ( 1.5 != 1.5 | "Positive" | "Negative")

// strings — content inequality, not pointer inequality
print $ ( "abc" != "abd" | "Positive" | "Negative")
print $ ( "abc" != "abc" | "Positive" | "Negative")

// pointer identity: two separately-created builders are different buffers
b1 = {8}
b2 = {8}
print $ ( b1 != b2 | "Positive" | "Negative")

// as a value-guard in a choice (works like any comparison flag)
x = 42
y = x [1] "one" [2] "two" | "other"
print $ y
z = x != 1 | "not one" | "is one"
print $ z
