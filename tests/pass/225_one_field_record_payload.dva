// Record holding an enum (forward-referenced), used as an enum payload,
// and a record whose field is a nested RECORD constructed from that record
// value.
#use io

#type Inner (x: Int, y: Int)
#type Payload (e: Inner, tag: Int)
#type Holder (e: Expr, tag: Int)
#type Expr <
   Num(Int)
   Holds(Holder)
>

r = Inner(9, 1)
io::out $ r.x

p = Payload(Inner(42, 2), 0)
io::out $ p.e.x

e = Expr(Holds, Holder(Expr(Num, 5), 0))
e
   [Num n] io::out $ n
   [Holds h]
      h.e [Num m] io::out $ m | io::out $ -1
   | io::out $ -2