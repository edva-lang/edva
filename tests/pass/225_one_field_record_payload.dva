// A 1-field record constructed from a single non-record argument must store
// a record POINTER, not the raw field value (a later field read used to
// dereference the value as an address and SEGV). Also covers a 1-field
// record holding an enum (forward-referenced), used as an enum payload — the
// exact shape behind the selfhost's CompileTimeExpr/JoinExpr — and a 1-field
// record whose sole field is a nested RECORD, constructed from that record
// value ("Payload(Inner(42))" wraps it inline rather than coercing its
// scalar field into the nested-record slot).
#type Inner (x: Int)
#type Payload (e: Inner)
#type Holder (e: Expr)
#type Expr <
   Num(Int)
   Holds(Holder)
>

r = Inner(9)
print_int $ r.x

p = Payload(Inner(42))
print_int $ p.e.x

e = Expr(Holds, Holder(Expr(Num, 5)))
e
   [Num n] print_int $ n
   [Holds h]
      h.e [Num m] print_int $ m | print_int $ -1
   | print_int $ -2