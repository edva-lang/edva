#use io

arr = (10, 20, 30, 40, 50)

sl1 = arr(1..4)
io::out $ ?sl1
io::out $ sl1(0)
io::out $ sl1(1)
io::out $ sl1(2)

sl2 = arr(2..)
io::out $ ?sl2
io::out $ sl2(0)
io::out $ sl2(1)
io::out $ sl2(2)

sl3 = arr(..3)
io::out $ ?sl3
io::out $ sl3(0)
io::out $ sl3(1)
io::out $ sl3(2)

sl4 = sl1(1..3)
io::out $ ?sl4
io::out $ sl4(0)
io::out $ sl4(1)
