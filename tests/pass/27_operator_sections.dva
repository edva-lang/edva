// Operator Section Assignments with infix application ($)
#use io

double = * 2
io::out $ double $ 15

add_ten = + 10
io::out $ add_ten $ 32

sub_five = - 5
io::out $ sub_five $ 50

is_fever = > 37.5
io::out $ ((is_fever $ 38.2) | "Positive" | "Negative")

// Operator Sections in Choice Predicate Brackets
temp = 38.2
status = temp
    [> 39.0] "Critical Fever"
    [> 37.5] "Fever"
    [< 35.0] "Hypothermia"
    | "Normal"
io::out $ status
