// std/net/http URL + query utilities and HTTP request-line parsing (pure
// string functions — no sockets).

#use "net/http"
#use str
#use io

// method_of reads the method out of a request line.
io::out $ http::method_of("GET /path HTTP/1.1")
io::out $ http::method_of("POST /x HTTP/1.1")
io::out $ http::method_of("")

// query_of / strip_query split the query string off a path.
io::out $ http::query_of("/search?q=hello&page=2")
io::out $ http::strip_query("/search?q=hello&page=2")
io::out $ http::query_of("/plain")

// percent_decode turns %XX escapes back into bytes.
io::out $ http::percent_decode("a%20b%2Fc")
io::out $ http::percent_decode("hello")

// query_param looks a key up in a query string.
p = http::query_param("q=hello&page=2", "page")
io::out $ (p | v => "page=" + v | "no page")
p2 = http::query_param("q=hello&page=2", "missing")
io::out $ (p2 | v => v | "missing")

// parse_url splits scheme://host[:port][/path][?query].
u = http::parse_url("http://example.com:8080/a/b?x=1")
io::out $ (u | url => url.host | err => err)
io::out $ (u | url => str::from_int(url.port) | err => err)
io::out $ (u | url => url.path | err => err)
io::out $ (u | url => url.query | err => err)
u2 = http::parse_url("https://x.y/z")
io::out $ (u2 | url => url.scheme | err => err)
io::out $ (u2 | url => url.host | err => err)
u3 = http::parse_url("nope")
io::out $ (u3 | url => "ok" | err => err)

// line_req parses a request line into a Request record.
r = http::line_req("GET /p?a=1 HTTP/1.1")
io::out $ (r | req => req.method | err => err)
io::out $ (r | req => req.path | err => err)
