// Negative offsets and clamping in slices (String and Array/Slice views)
#use io

s = "abcdef"

// String negative offsets
s1 = s(-3..)
io::out $ s1
io::out $ ?s1

s2 = s(..-2)
io::out $ s2
io::out $ ?s2

s3 = s(-4..-1)
io::out $ s3
io::out $ ?s3

s4 = s(1..-2)
io::out $ s4
io::out $ ?s4

// Clamping: out-of-bounds does not panic, clamps to [0, len]
s5 = s(-100..)
io::out $ s5
io::out $ ?s5

s6 = s(..100)
io::out $ s6
io::out $ ?s6

s7 = s(-50..50)
io::out $ s7
io::out $ ?s7

// Inverted ranges yield empty string
s8 = s(4..2)
io::out $ s8
io::out $ ?s8

s9 = s(-1..-3)
io::out $ s9
io::out $ ?s9

s10 = s(10..20)
io::out $ s10
io::out $ ?s10

// Array slice clamping and negative offsets
arr = (10, 20, 30, 40, 50)

a1 = arr(-2..)
io::out $ ?a1
io::out $ a1(0)
io::out $ a1(1)

a2 = arr(..-2)
io::out $ ?a2
io::out $ a2(0)
io::out $ a2(1)
io::out $ a2(2)

a3 = arr(-4..-1)
io::out $ ?a3
io::out $ a3(0)
io::out $ a3(1)
io::out $ a3(2)

a4 = arr(-10..10)
io::out $ ?a4

a5 = arr(4..2)
io::out $ ?a5

// Slice of slice clamping and negative offsets
sl = arr(1..4)
sl1 = sl(-2..)
io::out $ ?sl1
io::out $ sl1(0)
io::out $ sl1(1)

sl2 = sl(..-1)
io::out $ ?sl2
io::out $ sl2(0)
io::out $ sl2(1)

sl3 = sl(10..2)
io::out $ ?sl3
