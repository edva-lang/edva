// Negative offsets and clamping in slices (String and Array/Slice views)
s = "abcdef"

// String negative offsets
s1 = s(-3..)
print $ s1
print_int $ ?s1

s2 = s(..-2)
print $ s2
print_int $ ?s2

s3 = s(-4..-1)
print $ s3
print_int $ ?s3

s4 = s(1..-2)
print $ s4
print_int $ ?s4

// Clamping: out-of-bounds does not panic, clamps to [0, len]
s5 = s(-100..)
print $ s5
print_int $ ?s5

s6 = s(..100)
print $ s6
print_int $ ?s6

s7 = s(-50..50)
print $ s7
print_int $ ?s7

// Inverted ranges yield empty string
s8 = s(4..2)
print $ s8
print_int $ ?s8

s9 = s(-1..-3)
print $ s9
print_int $ ?s9

s10 = s(10..20)
print $ s10
print_int $ ?s10

// Array slice clamping and negative offsets
arr = (10, 20, 30, 40, 50)

a1 = arr(-2..)
print_int $ ?a1
print_int $ a1(0)
print_int $ a1(1)

a2 = arr(..-2)
print_int $ ?a2
print_int $ a2(0)
print_int $ a2(1)
print_int $ a2(2)

a3 = arr(-4..-1)
print_int $ ?a3
print_int $ a3(0)
print_int $ a3(1)
print_int $ a3(2)

a4 = arr(-10..10)
print_int $ ?a4

a5 = arr(4..2)
print_int $ ?a5

// Slice of slice clamping and negative offsets
sl = arr(1..4)
sl1 = sl(-2..)
print_int $ ?sl1
print_int $ sl1(0)
print_int $ sl1(1)

sl2 = sl(..-1)
print_int $ ?sl2
print_int $ sl2(0)
print_int $ sl2(1)

sl3 = sl(10..2)
print_int $ ?sl3
