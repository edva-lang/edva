// Issue #38: Generalized binary operator lifting & reductions
// (all_bit, any_bit)

// 1. Vector comparisons producing boolean mask tuples
#use(import) fp
#use io

v1 = (1, 2)
v2 = (2, 1)

lt = v1 < v2
io::out $ "lt: " + (lt.0 | "T" | "F") + " " + (lt.1 | "T" | "F")

gt = v1 > v2
io::out $ "gt: " + (gt.0 | "T" | "F") + " " + (gt.1 | "T" | "F")

eq = v1 == (1, 3)
io::out $ "eq: " + (eq.0 | "T" | "F") + " " + (eq.1 | "T" | "F")

neq = v1 != (1, 3)
io::out $ "neq: " + (neq.0 | "T" | "F") + " " + (neq.1 | "T" | "F")

nlt = v1 !< (2, 2)
io::out $ "nlt: " + (nlt.0 | "T" | "F") + " " + (nlt.1 | "T" | "F")

ngt = v1 !> (1, 1)
io::out $ "ngt: " + (ngt.0 | "T" | "F") + " " + (ngt.1 | "T" | "F")

// 2. Scalar broadcasting (Vector x Scalar and Scalar x Vector)
bcast_r = (10, 20) < 15
io::out $ "bcast_r: " + (bcast_r.0 | "T" | "F") + " " + (bcast_r.1 | "T" | "F")

bcast_l = 15 < (10, 20)
io::out $ "bcast_l: " + (bcast_l.0 | "T" | "F") + " " + (bcast_l.1 | "T" | "F")

// 3. Vector logical operators (&&, ||)
m_true = (<+>, <+>)
m_false = (<->, <->)
m_mix = (<+>, <->)

and_res = m_mix && m_true
io::out $ "and_res: " + (and_res.0 | "T" | "F") + " " + (and_res.1 | "T" | "F")

or_res = m_mix || m_false
io::out $ "or_res: " + (or_res.0 | "T" | "F") + " " + (or_res.1 | "T" | "F")

// 4. Boolean reductions (all_bit, any_bit)
io::out $ "all_bit m_true: " + (all_bit(m_true) | "TRUE" | "FALSE")
io::out $ "all_bit m_mix: " + (all_bit(m_mix) | "TRUE" | "FALSE")
io::out $ "all_bit m_false: " + (all_bit(m_false) | "TRUE" | "FALSE")

io::out $ "any_bit m_true: " + (any_bit(m_true) | "TRUE" | "FALSE")
io::out $ "any_bit m_mix: " + (any_bit(m_mix) | "TRUE" | "FALSE")
io::out $ "any_bit m_false: " + (any_bit(m_false) | "TRUE" | "FALSE")

// 5. Higher-dimensional vectors (3D, 4D)
m3 = (<+>, <+>, <+>)
m3_one_false = (<+>, <->, <+>)
io::out $ "3D all: " + (all_bit(m3) | "TRUE" | "FALSE")
io::out $ "3D mix all: " + (all_bit(m3_one_false) | "TRUE" | "FALSE")
io::out $ "3D mix any: " + (any_bit(m3_one_false) | "TRUE" | "FALSE")

m4_none = (<->, <->, <->, <->)
m4_one = (<->, <->, <+>, <->)
io::out $ "4D none any: " + (any_bit(m4_none) | "TRUE" | "FALSE")
io::out $ "4D one any: " + (any_bit(m4_one) | "TRUE" | "FALSE")

// 6. Scalar Flag identity with reductions
io::out $ "scalar all: " + (all_bit(<+>) | "TRUE" | "FALSE")
io::out $ "scalar any: " + (any_bit(<->) | "TRUE" | "FALSE")

// 7. UI Hit-testing (Bounding box point-in-rect)
rect_min = (10, 20)
rect_max = (100, 200)

cursor_in = (50, 50)
cursor_out = (5, 50)

hit_in = all_bit(cursor_in !< rect_min && cursor_in !> rect_max)
hit_out = all_bit(cursor_out !< rect_min && cursor_out !> rect_max)
io::out $ "hit_in: " + (hit_in | "INSIDE" | "OUTSIDE")
io::out $ "hit_out: " + (hit_out | "INSIDE" | "OUTSIDE")

oob_in = any_bit(cursor_in < rect_min || cursor_in > rect_max)
oob_out = any_bit(cursor_out < rect_min || cursor_out > rect_max)
io::out $ "oob_in: " + (oob_in | "YES" | "NO")
io::out $ "oob_out: " + (oob_out | "YES" | "NO")

// 8. Whole-record equality via all_bit
rec_a = (1, 2, 3)
rec_b = (1, 2, 3)
rec_c = (1, 2, 4)
io::out $ "rec_a == rec_b: " + (all_bit(rec_a == rec_b) | "EQUAL" | "NOT_EQUAL")
io::out $ "rec_a == rec_c: " + (all_bit(rec_a == rec_c) | "EQUAL" | "NOT_EQUAL")
