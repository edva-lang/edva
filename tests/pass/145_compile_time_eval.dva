// Compile-time execution ("#!"): a compile-time-evaluable expression folds
// to a constant at codegen. The subset is literals, + - * / % arithmetic,
// string '+', and the '?s' length query.

print_int $ #! 2 + 2
print_int $ #! 3 * 5
print_int $ #! 10 - 7
print_int $ #! 20 / 4
print_int $ #! 17 % 5
print_float $ #! 1.5 + 2.5
print $ #! "a" + "b"
print_int $ #! ?"hello"
x = #! 2 * 3 + 1
print_int $ x
