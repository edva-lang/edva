// Higher-order CTFE: a function VALUE is a CT value (CtKind.Fn), so a '#const'
// expression can pass a declared function to a generic combinator and apply it
// inside the body (a parameter bound to a CtFn is resolved as the callee).
// No new syntax; bodies stay in the scalar subset.

#use str
#use io

dbl: Int => Int
dbl = n => n * 2
inc: Int => Int
inc = n => n + 1

twice_g: #param T: Type, (T => T), T => T
twice_g = f, x => f(f(x))

apply_f: #param T: Type, #param U: Type, (T => U), T => U
apply_f = f, x => f(x)

compose2: #param T: Type, (T => T), (T => T), T => T
compose2 = f, g, x => f(g(x))

pick: #param T: Type, (T => T), (T => T), T => T
pick = f, g, x => x > 0 | f(x) | g(x)

io::out $ str::from_int(#const twice_g(dbl, 10))
io::out $ str::from_int(#const twice_g(inc, 10))
io::out $ str::from_int(#const apply_f(dbl, 21))
io::out $ str::from_int(#const compose2(dbl, inc, 10))
io::out $ str::from_int(#const pick(dbl, inc, 5))
io::out $ str::from_int(#const pick(dbl, inc, -5))