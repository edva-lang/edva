#use io
#use task

#type Ints Int{}

grow = xs =>
   xs += 99
   ?xs

xs: Ints
xs += 1
xs += 2
xs += 3

h = task::spawn(grow(xs))
r = task::join(h)
io::out $ (r | _ | _)
io::out $ ?xs

sl = xs(0..3)
get = s => s(1)
h2 = task::spawn(get(sl))
r2 = task::join(h2)
io::out $ Int(r2 | _ | _)

// A growable array returned from the worker and unwrapped with '| _ | _'.
mk: Int => Ints
mk = n =>
   ys: Ints
   ys += n
   ys

h3 = task::spawn(mk(42))
r3 = task::join(h3)
ys = r3 | _ | _
io::out $ (ys(0) | _ | _)
io::out $ ?ys
