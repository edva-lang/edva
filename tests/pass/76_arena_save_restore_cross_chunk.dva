// Regression test: per-iteration cycle arena save/restore must stay
// correct when an iteration's allocations cross a chunk boundary.
// Each iteration allocates sum_{k=1..15}(?s_k + struct) ~ 1.2 MiB,
// spilling past the 1 MiB chunk-0 boundary into a new chunk that the
// restore must free before the next iteration. 'big' lives in chunk 0
// before the cycle and must survive all three iterations untouched.
b = ""
big = b + "z"

..3 @ i =>
    s1 = b + "a"
    s2 = b + s1
    s3 = b + s2
    s4 = b + s3
    s5 = b + s4
    s6 = b + s5
    s7 = b + s6
    s8 = b + s7
    s9 = b + s8
    s10 = b + s9
    s11 = b + s10
    s12 = b + s11
    s13 = b + s12
    s14 = b + s13
    s15 = b + s14
    print_int $ ?s15
    print_int $ s15(0)
    print_int $ s15(?s15 - 1)

print_int $ ?big
print_int $ big(?big - 1)
