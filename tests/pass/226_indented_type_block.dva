// The indented record-type declaration block: "#type Name" followed by an
// indented "field: Type" block (no parens/commas). User-type field references
// (forward references) and nested inline records (a deeper indent) work.
#type Point
   x: Int
   y: Int

#type Rect
   origin: Point
   w: Int

#type Person
   name: String
   addr:
      street: String
      city: String

p = Point((3, 4))
print_int $ p.x
print_int $ p.y

r = Rect((Point((1, 2)), 5))
print_int $ r.origin.x
print_int $ r.w

pe = Person(("Ann", ("Main St", "Springfield")))
print $ pe.name
print $ pe.addr.street
print $ pe.addr.city