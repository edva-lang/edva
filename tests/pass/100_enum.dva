#use io

#type Token <Id, Num, Str, Eof>

t1 = Token(Id)
t2 = Token(Num)

classify: Token => String
classify = t =>
   t [Id] "id" [Num] "num" [Str] "str" [Eof] "eof"

io::out $ classify(t1)
io::out $ classify(t2)
io::out $ classify(Token(Str))
io::out $ classify(Token(Eof))

#type Maybe <Some(String), Noth>

show: Maybe => String
show = m =>
   m
      [Some s]
         "got " + s
      [Noth]
         "nothing"

io::out $ show(Maybe(Some, "hello"))
io::out $ show(Maybe(Noth))

#type Color <
   Red
   Green
   Blue
>

next: Color => Color
next = c =>
   c
      [Red] Color(Green)
      [Green] Color(Blue)
      [Blue] Color(Red)

name: Color => String
name = c =>
   c
      [Red] "red"
      [Green] "green"
      [Blue] "blue"

io::out $ name(next(Color(Red)))
io::out $ name(next(next(Color(Green))))
