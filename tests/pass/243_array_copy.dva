#use io

#type Ints (Int){}

orig: Ints
orig += 10
orig += 20
orig += 30

copy = ++orig

copy += 40
copy(0) = 99 !| _

io::out $ ?orig
io::out $ (orig(0) | _ | _)
io::out $ (orig(1) | _ | _)
io::out $ (orig(2) | _ | _)

io::out $ ?copy
io::out $ (copy(0) | _ | _)
io::out $ (copy(1) | _ | _)
io::out $ (copy(2) | _ | _)
io::out $ (copy(3) | _ | _)
