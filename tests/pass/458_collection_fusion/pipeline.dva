#public
   // Each filter-map survivor receives a dense index in the next stage.
   sum_chain: Int => Int
   sum_chain = n =>
      (7, (2..(n + 2) @> (x, i => x * 3 + i)) @> (v => v % 3 != 0 | <+ v +>)) @> a, v, i =>
         (a * 31 + v + i) % 100003

   array_chain: Int => Int
   array_chain = n =>
      ys = (n @> (x => x + 5)) @> (v, i => v % 2 == 0 | <+ v * 2 + i +>)
      total = (0, ys) @> (a, v => a + v)
      ?ys * 10000 + total

   sum_array: Int{} => Int
   sum_array = xs =>
      total = (0, (xs @> (_ * 2 + _i))) @> (a, v, i => a + v + i)
      total + xs(1).expect("missing xs")

#export fusion_probe: Int => Int
fusion_probe = n => sum_chain(n)
