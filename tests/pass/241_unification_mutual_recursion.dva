// Unannotated mutually recursive functions: Tarjan SCCs and type unification.
my_even = n =>
   n == 0
      | 1
      | my_odd(n - 1)

my_odd = n =>
   n == 0
      | 0
      | my_even(n - 1)

print_int $ my_even(10)
print_int $ my_odd(10)
print_int $ my_even(7)
print_int $ my_odd(7)

step_a = n =>
   n !> 0
      | 0
      | step_b(n - 1) + 1

step_b = n =>
   n !> 0
      | 0
      | step_c(n - 1) + 2

step_c = n =>
   n !> 0
      | 0
      | step_a(n - 1) + 3

print_int $ step_a(6)
print_int $ step_b(6)
print_int $ step_c(6)

tree_left = depth, val =>
   depth !> 0
      | val
      | tree_right(depth - 1, val * 2) + 1

tree_right = depth, val =>
   depth !> 0
      | val
      | tree_left(depth - 1, val + 3) + 2

print_int $ tree_left(3, 5)
print_int $ tree_right(3, 5)
