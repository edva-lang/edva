// Tests for compiler intrinsics (#77)
// Part 1: Bounding & Math
print_int $ %min(10, 20)
print_int $ %max(10, 20)
print_float $ %min(3.5, 1.5)
print_float $ %max(3.5, 1.5)

v_min = %min((10, 50, 30), 25)
print_int $ v_min(0)
print_int $ v_min(1)
print_int $ v_min(2)

v_max = %max(25, (10, 50, 30))
print_int $ v_max(0)
print_int $ v_max(1)
print_int $ v_max(2)

print_int $ %clamp(15, 10, 20)
print_int $ %clamp(5, 10, 20)
print_int $ %clamp(25, 10, 20)

v_clamp = %clamp((5, 15, 25), 10, 20)
print_int $ v_clamp(0)
print_int $ v_clamp(1)
print_int $ v_clamp(2)

print_int $ %abs(-42)
print_float $ %abs(-3.5)
v_abs = %abs((-1, 2, -3))
print_int $ v_abs(0)
print_int $ v_abs(1)
print_int $ v_abs(2)

// Shuffle
v = (10, 20, 30, 40)
shuf1 = %shuffle(v, (3, 2, 1, 0))
print_int $ shuf1(0)
print_int $ shuf1(1)
print_int $ shuf1(2)
print_int $ shuf1(3)

va = (1, 2)
vb = (3, 4)
shuf2 = %shuffle(va, vb, (0, 2, 1, 3))
print_int $ shuf2(0)
print_int $ shuf2(1)
print_int $ shuf2(2)
print_int $ shuf2(3)

// Part 2: Vector Reductions
print_int $ %all((<+>, <+>, <+>)) | 1 | 0
print_int $ %all((<+>, <->, <+>)) | 1 | 0
print_int $ %any((<->, <->, <->)) | 1 | 0
print_int $ %any((<->, <+>, <->)) | 1 | 0

print_int $ %sum((1, 2, 3, 4))
print_float $ %sum((1.5, 2.5, 3.0))
print_int $ %prod((2, 3, 4))
print_float $ %prod((2.0, 3.0, 4.0))
print_int $ %dot((1, 2, 3), (4, 5, 6))
print_float $ %dot((1.0, 2.0), (3.0, 4.0))

// Part 3: Floating-point math
print_float $ %sqrt(16.0)
v_sqrt = %sqrt((4.0, 9.0, 25.0))
print_float $ v_sqrt(0)
print_float $ v_sqrt(1)
print_float $ v_sqrt(2)

print_float $ %fma(2.0, 3.0, 4.0)
v_fma = %fma((2.0, 3.0), (4.0, 5.0), (1.0, 2.0))
print_float $ v_fma(0)
print_float $ v_fma(1)

print_float $ %floor(3.7)
print_float $ %ceil(3.2)
print_float $ %trunc(3.9)
print_float $ %trunc(-3.9)
print_float $ %round(3.5)
print_float $ %copysign(5.0, -1.0)
print_float $ %copysign(-5.0, 1.0)

// Part 4: Bit manipulation
print_int $ %popcount(7)
print_int $ %popcount(0)
v_pop = %popcount((1, 3, 7, 15))
print_int $ v_pop(0)
print_int $ v_pop(1)
print_int $ v_pop(2)
print_int $ v_pop(3)

print_int $ %clz(1)
print_int $ %ctz(8)

x_bswap = %bswap(0x0102030405060708)
print_int $ %bswap(x_bswap) == 0x0102030405060708 | 1 | 0

x_brev = %bitreverse(1)
print_int $ %bitreverse(x_brev) == 1 | 1 | 0

print_int $ %rotl(1, 1)
print_int $ %rotr(2, 1)
