// Tests for compiler intrinsics (#77)
// Part 1: Bounding & Math
#use io

io::out $ %min(10, 20)
io::out $ %max(10, 20)
io::out $ %min(3.5, 1.5)
io::out $ %max(3.5, 1.5)

v_min = %min((10, 50, 30), 25)
io::out $ v_min(0)
io::out $ v_min(1)
io::out $ v_min(2)

v_max = %max(25, (10, 50, 30))
io::out $ v_max(0)
io::out $ v_max(1)
io::out $ v_max(2)

io::out $ %clamp(15, 10, 20)
io::out $ %clamp(5, 10, 20)
io::out $ %clamp(25, 10, 20)

v_clamp = %clamp((5, 15, 25), 10, 20)
io::out $ v_clamp(0)
io::out $ v_clamp(1)
io::out $ v_clamp(2)

io::out $ %abs(-42)
io::out $ %abs(-3.5)
v_abs = %abs((-1, 2, -3))
io::out $ v_abs(0)
io::out $ v_abs(1)
io::out $ v_abs(2)

// Shuffle
v = (10, 20, 30, 40)
shuf1 = %shuffle(v, (3, 2, 1, 0))
io::out $ shuf1(0)
io::out $ shuf1(1)
io::out $ shuf1(2)
io::out $ shuf1(3)

va = (1, 2)
vb = (3, 4)
shuf2 = %shuffle(va, vb, (0, 2, 1, 3))
io::out $ shuf2(0)
io::out $ shuf2(1)
io::out $ shuf2(2)
io::out $ shuf2(3)

// Part 2: Vector Reductions
io::out $ %all((<+>, <+>, <+>)) | 1 | 0
io::out $ %all((<+>, <->, <+>)) | 1 | 0
io::out $ %any((<->, <->, <->)) | 1 | 0
io::out $ %any((<->, <+>, <->)) | 1 | 0

io::out $ %sum((1, 2, 3, 4))
io::out $ %sum((1.5, 2.5, 3.0))
io::out $ %prod((2, 3, 4))
io::out $ %prod((2.0, 3.0, 4.0))
io::out $ %dot((1, 2, 3), (4, 5, 6))
io::out $ %dot((1.0, 2.0), (3.0, 4.0))

// Part 3: Floating-point math
io::out $ %sqrt(16.0)
v_sqrt = %sqrt((4.0, 9.0, 25.0))
io::out $ v_sqrt(0)
io::out $ v_sqrt(1)
io::out $ v_sqrt(2)

io::out $ %fma(2.0, 3.0, 4.0)
v_fma = %fma((2.0, 3.0), (4.0, 5.0), (1.0, 2.0))
io::out $ v_fma(0)
io::out $ v_fma(1)

io::out $ %floor(3.7)
io::out $ %ceil(3.2)
io::out $ %trunc(3.9)
io::out $ %trunc(-3.9)
io::out $ %round(3.5)
io::out $ %copysign(5.0, -1.0)
io::out $ %copysign(-5.0, 1.0)

// Part 4: Bit manipulation
io::out $ %popcount(7)
io::out $ %popcount(0)
v_pop = %popcount((1, 3, 7, 15))
io::out $ v_pop(0)
io::out $ v_pop(1)
io::out $ v_pop(2)
io::out $ v_pop(3)

io::out $ %clz(1)
io::out $ %ctz(8)

x_bswap = %bswap(0x0102030405060708)
io::out $ %bswap(x_bswap) == 0x0102030405060708 | 1 | 0

x_brev = %bitreverse(1)
io::out $ %bitreverse(x_brev) == 1 | 1 | 0

io::out $ %rotl(1, 1)
io::out $ %rotr(2, 1)
