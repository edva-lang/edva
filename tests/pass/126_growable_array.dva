#use io

#type Ints (Int){}
#type Names (String){3}

xs: Ints
xs += 42
xs += 7
xs += 100
io::out $ ?xs
io::out $ (xs(0) | _ | _)
io::out $ (xs(2) | _ | _)
xs(1) = 99 !| _
io::out $ (xs(1) | _ | _)

name: Names
name += "dva"
name += "lang"
n = ?name
view = name(0..n)
io::out $ view(1)

#type Rect (w: Int, h: Int)
#type Grid (Rect){}
grid: Grid
grid += (w = 3, h = 4)
grid += (w = 5, h = 6)
io::out $ (grid(1) | g => g.w | _)
io::out $ (grid(1) | g => g.h | _)

grow: Ints => Int
grow = a =>
    a += 1
    a += 2
    ?a

xs2 = Ints()
grow(xs2)
io::out $ (xs2(0) | _ | _)
io::out $ (xs2(1) | _ | _)
