// A bare Flag condition is matched by its branches, never by an integer
// value guard — a ram never coerces to another type. `done | 111 | 222`
// picks 111 when `done` is positive and 222 otherwise.

#use io

pk: Int, Int => Int
pk = base, off =>
   i = base + off
   i !> 3
      | 7
      | 8

probe: Int => Int
probe = n =>
   is_sp = pk(n, 0) [7]
   done = !is_sp
   done | 111 | 222

io::out $ probe(0)
io::out $ probe(7)
