// Regression test for the P0.1 fix: !< and !> (NotLess/NotGreater) must
// codegen correctly when a function that uses them is actually *called* --
// std/sys.dva's argv n => (n !< 0) && (n < argc) | <+ ... +> | <-->
// was previously broken (crashed with "Unsupported or unhandled binary
// operator") but this was masked because nothing in the test suite ever
// called sys::argv, only defined it.
#use sys

in_range   = sys::argv(0) | "yes" | "no"
out_of_range = sys::argv(999) | "yes" | "no"
negative   = sys::argv(-1) | "yes" | "no"

print $ in_range
print $ out_of_range
print $ negative
