#use io

s1 = "hello"
io::out $ ??s1

s2 = "hello 🤔 world"
io::out $ ??s2

r1 = 'a'
r2 = 'д'
r3 = '中'
r4 = '🤔'
io::out $ ?r1
io::out $ ?r2
io::out $ ?r3
io::out $ ?r4

s3 = "antigravity: " + r4
io::out $ s3

b = {32}
b += r1
b += r2
b += r3
b += r4
io::out $ +b

"a🤔b" @@ c =>
   io::out $ "" + c

'w'..'z' @ r =>
   io::out $ "" + r
