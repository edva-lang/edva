// %memcpy, %memmove, %memset compiler intrinsics

// 1. %memset
#use io
#use mem

b1' = mem::zero_buf(5)
%memset(&b1', 65, 5)
io::out $ +b1'

// 2. %memcpy
src' = {32}
src' += "Hello, World!"
dst' = mem::zero_buf(5)
%memcpy(&dst', &src', 5)
io::out $ +dst'

// 3. %memmove (overlapping copy)
b2' = {32}
b2' += "0123456789"
%memmove(&b2', &b2' + 2, 4)
io::out $ +b2'

// 4. Return value of %memset / %memcpy is destination Addr
b3' = mem::zero_buf(4)
ret_p = %memset(&b3', 88, 4)
is_same = ret_p == &b3' | 1 | 0
io::out $ +b3'
io::out $ is_same
