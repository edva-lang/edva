#use "io"
#use "str"

// Test map string key equality with:
// 1. Shorter stored key and much longer query (adversarial probe)
// 2. Embedded NUL bytes with identical prefix
// 3. Keys colliding or sharing prefixes

m = ("" ^= 0)
m ^- ""

// 1. Insert a very short key
m ^ "x" = 100

// Look up keys that start with "x" but have much longer lengths
q1 = "x" + "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
io::out $ (m ^? q1) | "found" | "not found"
io::out $ str::from_int(m ^ q1 | _ | -1)

// Look up key that has same prefix up to length, but different
q2 = "xyz"
io::out $ (m ^? q2) | "found" | "not found"
io::out $ str::from_int(m ^ q2 | _ | -1)

// Retrieve the short key
io::out $ str::from_int(m ^ "x" | _ | -1)

// 2. Keys with embedded NUL bytes
b1 = {16}
b1 += "ab"
b1 += 0
b1 += "cd"
s1 = +b1

b2 = {16}
b2 += "ab"
b2 += 0
b2 += "cd"
s2 = +b2

b3 = {16}
b3 += "ab"
b3 += 0
b3 += "ef"
s3 = +b3

b4 = {16}
b4 += "ab"
s4 = +b4

m ^ (s1) = 999

io::out $ str::from_int(?s1)
io::out $ (m ^? s2) | "s2 found" | "s2 not found"
io::out $ str::from_int(m ^ s2 | _ | -1)
io::out $ (m ^? s3) | "s3 found" | "s3 not found"
io::out $ str::from_int(m ^ s3 | _ | -1)
io::out $ (m ^? s4) | "s4 found" | "s4 not found"
io::out $ str::from_int(m ^ s4 | _ | -1)

// 3. Overwrite with longer key, then delete
m ^ "x" = 200
io::out $ str::from_int(m ^ "x" | _ | -1)
del_res = m ^- "x"
io::out $ del_res | "del ok" | "del fail"
io::out $ (m ^? "x") | "still there" | "deleted"
