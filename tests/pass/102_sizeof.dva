// Compile-time unary operator "#size T": the byte size of a type in bytes.
// Scalars use their LLVM ABI size; composite record types use the arena
// size (min 16) the language allocates and strides by.

// Scalars: Int/Rune/i64/u64/Float/f64/pointer-sized are 8 bytes.
io::out $ #size(Int)
io::out $ #size(Rune)
io::out $ #size(Float)
io::out $ #size(Addr)
io::out $ #size(String)

// Narrow scalars.
io::out $ #size(i8)
io::out $ #size(i16)
io::out $ #size(i32)
io::out $ #size(i1)

// Bare form without parentheses.
io::out $ #size Int

// A value context: feeds a malloc of exactly one element.
#use libc
#use io
#type Pt (x: Int, y: Int)
buf = libc::malloc $ #size(Pt)
io::out $ ( buf !< 1 | "Positive" | "Negative")

// Sizes are compile-time constants: they fold into arithmetic.
total = #size(i8) + #size(i32) + #size(i64)
io::out $ total

// Composite records floor to the 16-byte arena chunk.
io::out $ #size(Pt)
io::out $ #size(Int * 2)
