// '::=' — global mutation from inside a function. '=' and ':=' always bind a
// fresh function-local (shadowing an inherited name); '::=' writes the
// module/global binding, bypassing any local shadow.

#use io

#type Ints (Int){}

counter: Int
vals: Ints

bump: Int => Int
bump = n =>
   counter ::= counter + n
   counter

push: Int => Int
push = v =>
   vals += v
   ?vals

counter = 10
io::out $ bump(5)
io::out $ counter

vals = Ints()
push(7)
push(8)
io::out $ ?vals
io::out $ (vals(0) | _ | _)
io::out $ (vals(1) | _ | _)
