// Compile-time record field reflection:
// 1. #arity T on a Record type gives field count.
// 2. #member T, i gives the i-th field's name as a compile-time String constant.
// 3. #member T, i in type position resolves to the field's static TypeInfo.
// 4. Concrete type #member Pt, i works directly.
// 5. Unrolled loops 0..(#arity T) @ i allow generic record inspection/serialization.

#use str
#use io

#type Pt (x: Int, y: Int)
#type Person (name: String, age: Int, active: <>)
#type Pair (Int, String)

// Field count reflection:
nfields: #param T: Type, T => Int
nfields = x => #arity T

// Static field name access:
field0_name: #param T: Type, T => String
field0_name = x => #member T, 0

field1_name: #param T: Type, T => String
field1_name = x => #member T, 1

// Join field names of any record:
join_field_names: #param T: Type, T => String
join_field_names = x =>
   out = {32}
   0..(#arity T) @ i =>
      i > 0 | out += ","
      out += #member T, i
   +out

// Compile-time type check on fields:
is_field0_int: #param T: Type, T => <>
is_field0_int = x => (#member T, 0) == Int

is_field0_str: #param T: Type, T => <>
is_field0_str = x => (#member T, 0) == String

// Generic inspect function using compile-time type dispatch:
inspect: #param T: Type, T => ()
inspect = val =>
   0..(#arity T) @ i =>
      name = #member T, i
      #member T, i
         [Int]
            io::out $ name + ":int=" + str::from_int((#member val, i))
         [String]
            io::out $ name + ":str=" + (#member val, i)
         |
            io::out $ name + ":other"

p: Pt
p.x = 10
p.y = 20

io::out $ str::from_int(nfields(p))
io::out $ field0_name(p)
io::out $ field1_name(p)
io::out $ join_field_names(p)

// Direct reflection on concrete type:
io::outs $ #member Pt, 0
io::outs $ #member Pt, 1

per: Person
per.name = "Alice"
per.age = 30
per.active = <+>

io::out $ str::from_int(nfields(per))
io::out $ join_field_names(per)
io::outs $ #member Person, 0
io::outs $ #member Person, 1
io::outs $ #member Person, 2

io::out $ is_field0_int(p) | "pt.0 is int" | "pt.0 is not int"
io::out $ is_field0_str(p) | "pt.0 is str" | "pt.0 is not str"
io::out $ is_field0_str(per) | "per.0 is str" | "per.0 is not str"

// Type equality check:
io::out $ (#member Pt, 0) == Int | "Pt.0==Int" | "Pt.0!=Int"
io::out $ (#member Pt, 1) == Int | "Pt.1==Int" | "Pt.1!=Int"
io::out $ (#member Person, 0) == String | "Person.0==Str" | "Person.0!=Str"

// Positional tuple field names:
pair = Pair(42, "hello")
io::out $ join_field_names(pair)

// Full generic serializer/inspector:
inspect(p)
inspect(per)
