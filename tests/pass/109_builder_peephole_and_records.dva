// Builder '+'/'+=' 3-part: (1) peephole — "b += x + y" with a String-concat
// RHS appends each operand directly, never materializing the intermediate
// concatenated String; (2) "b = (13, 10)" — a homogeneous record of
// integerish values on a Builder ':=' appends each element as a byte;
// (3) "Builder" is a recognized type name: "b: Builder" annotations and
// "f = b: Builder => ..." parameters pass the caller's Builder by its
// { len, data, cap } pointer, so the callee's '+=' mutates it in place.

// 1. Peephole: b += s + t (+ u) flattens to direct appends.
#use io

b1 = {16}
s1 = "abc"
s2 = "def"
b1 += s1 + s2 + "ghi"
io::out $ +b1

// A mixed String + byte RHS appends the String then the byte.
b2 = {16}
b2 += "xy" + 90
io::out $ +b2

// 2. Record-of-bytes: literal and variable forms.
b3 = {16}
b3 = (13, 10)
b3 += 66
io::out $ +b3

bytes = (72, 105, 33)
b4 = {16}
b4 = bytes
io::out $ +b4

// 3. Builder as a type name.
out: Builder
out = {32}
fill: Builder, Int => String
fill = b, n =>
   n @
      b += 65 + _
   +b
res = fill(out, 3)
io::out $ res
io::out $ ?res
