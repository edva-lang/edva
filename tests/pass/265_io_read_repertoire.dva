// std/io fd-read repertoire: read, read_all, read_byte, read_until, read_line.

#use io
#use libc
#use str

path = "/tmp/test_io_read_rep.txt"

// Setup test file with multiple line styles and content:
// Line 1: CRLF terminated ("alpha\r\n")
// Line 2: LF terminated ("beta,gamma|delta\n")
// Line 3: empty CRLF line ("\r\n")
// Line 4: empty LF line ("\n")
// Line 5: no trailing newline ("final EOF chunk")
fd_w = libc::creat(path, 438)
content = "alpha\r\nbeta,gamma|delta\n\r\n\nfinal EOF chunk"
libc::write(fd_w, content, ?content)
libc::close(fd_w)

// 1. io::read from reader
fd1 = libc::open(path, 0)
r1 = io::reader(fd1)
res1 = io::read(r1, 5)
s1 = res1 | s => s | ""
io::out $ "read: n=" + str::from_int(?s1) + " buf=[" + s1 + "]"
libc::close(fd1)

// 2. io::read_all draining full file or capped
fd2 = libc::open(path, 0)
r2 = io::reader(fd2)
all_res = io::read_all(r2, 1000)
libc::close(fd2)
all_str = all_res | s => s | "FAIL"
io::out $ "read_all len=" + str::from_int(?all_str)

// read_all with cap
fd2_cap = libc::open(path, 0)
r2_cap = io::reader(fd2_cap)
cap_res = io::read_all(r2_cap, 8)
libc::close(fd2_cap)
cap_str = cap_res | s => s | "FAIL"
io::out $ "read_all cap8=[" + cap_str + "]"

// read_all on empty file returns <-->
empty_path = "/tmp/test_io_empty.txt"
fd_empty_w = libc::creat(empty_path, 438)
libc::close(fd_empty_w)
fd_empty = libc::open(empty_path, 0)
r_empty = io::reader(fd_empty)
empty_res = io::read_all(r_empty, 100)
libc::close(fd_empty)
libc::unlink(empty_path)
empty_tag = empty_res | s => "POS" | "NEG_EOF"
io::out $ "read_all empty=" + empty_tag

// 3. io::read_byte (buffered)
fd3 = libc::open(path, 0)
r3 = io::reader_with_cap(fd3, 8)
byte1 = io::read_byte(r3)
byte2 = io::read_byte(r3)
libc::close(fd3)
b1_str = byte1 | b => str::from_int(b) | "EOF"
b2_str = byte2 | b => str::from_int(b) | "EOF"
io::out $ "read_byte: " + b1_str + " " + b2_str

// 4. io::read_until with custom delimiter ',' then '|'
fd4 = libc::open(path, 0)
r4 = io::reader_with_cap(fd4, 32)
// Skip past "alpha\r\n"
skip1 = io::read_line(r4, 100)
part1 = io::read_until(r4, 44, 100) // 44 is ','
p1_str = part1 | s => s | "EOF"
part2 = io::read_until(r4, 124, 100) // 124 is '|'
p2_str = part2 | s => s | "EOF"
libc::close(fd4)
io::out $ "read_until: [" + p1_str + "] [" + p2_str + "]"

// 5. io::read_line over all lines until EOF
fd5 = libc::open(path, 0)
r5 = io::reader(fd5)
0.. @
   line_res = io::read_line(r5, 100)
   line_res
      | l => io::out $ "line: [" + l + "]"
      | -->
libc::close(fd5)

// Clean up
libc::unlink(path)
io::out $ "DONE"
