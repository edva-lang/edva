#use io
#use mem

#foreign("c")
   strlen : (s: Addr) -> Int

res =
   b = mem::zero_buf(5)
   p = &b
   @[p] = 72i8
   @[p + 1] = 101i8
   @[p + 2] = 108i8
   @[p + 3] = 108i8
   @[p + 4] = 111i8
   @[p + 5] = 0i8
   io::out $ @[p i8]
   io::out $ @[p + 1 i8]
   s = +b
   ++s

io::out $ res
io::out $ strlen(&res)
