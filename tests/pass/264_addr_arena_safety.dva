#use io

#foreign "c"
   strlen : (s: Addr) -> Int

res =
   b = {16}
   p = &b
   @[p] = 72i8
   @[p + 1] = 101i8
   @[p + 2] = 108i8
   @[p + 3] = 108i8
   @[p + 4] = 111i8
   @[p + 5] = 0i8
   ?b = 5
   io::out $ @[p i8]
   io::out $ @[p + 1 i8]
   s = +b
   ++s

io::out $ res
io::out $ strlen(&res)
