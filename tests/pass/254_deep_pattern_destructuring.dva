// Tests deep pattern destructuring in match choices (Issue #45)

#use io

#type Expr < Lit(Int), Add((Expr, Expr)), Neg(Expr), Mul((Expr, Expr)) >

eval: Expr => Int
eval = e =>
   e
      [Lit n] n
      [Add (Lit a, Lit b)] a + b
      [Add (x, y)] eval(x) + eval(y)
      [Mul (_, Lit 0)] 0
      [Mul (Lit 0, _)] 0
      [Mul (Add (Lit a, Lit b), Lit c)] (a + b) * c
      [Mul (Lit a, Lit b)] a * b
      [Mul (x, y)] eval(x) * eval(y)
      [Neg (Lit n)] 0 - n
      [Neg e1] 0 - eval(e1)
      | 0

#type Point (x: Int, y: Int)

classify: Point => Int
classify = pt =>
   pt
      [(x = 0, y = 0)] 1
      [(x = 0, y = _)] 2
      [(x = _, y = 0)] 3
      [(x = a, y = b)] a + b

// 1. Basic variant and nested evaluation
e1 = Expr(Add, (Expr(Lit, 10), Expr(Lit, 20)))
io::out $ eval(e1)

e2 = Expr(Neg, Expr(Lit, 42))
io::out $ eval(e2)

// 2. Wildcards in subpatterns
e3 = Expr(Mul, (Expr(Lit, 999), Expr(Lit, 0)))
io::out $ eval(e3)

e4 = Expr(Mul, (Expr(Lit, 0), Expr(Lit, 888)))
io::out $ eval(e4)

// 3. Multi-level nested patterns
e5 = Expr(Mul, (Expr(Add, (Expr(Lit, 2), Expr(Lit, 3))), Expr(Lit, 4)))
io::out $ eval(e5)

// 4. Fallback in variant choices
e6 = Expr(Mul, (Expr(Lit, 6), Expr(Lit, 7)))
io::out $ eval(e6)

// 5. Record pattern destructuring with field names and wildcards
pt1 = Point(0, 0)
io::out $ classify(pt1)

pt2 = Point(0, 50)
io::out $ classify(pt2)

pt3 = Point(70, 0)
io::out $ classify(pt3)

pt4 = Point(3, 4)
io::out $ classify(pt4)
