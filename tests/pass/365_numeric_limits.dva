#use io
#use const

// Integer limit constants
io::out $ const::max_i64
io::out $ const::min_i64
io::out $ const::max_u64
io::out $ const::max_u32
io::out $ const::max_u16
io::out $ const::max_u8
io::out $ const::max_i32
io::out $ const::min_i32
io::out $ const::max_i16
io::out $ const::min_i16
io::out $ const::max_i8
io::out $ const::min_i8

// Arithmetic wraps
io::out $ (const::max_i64 + 1 == const::min_i64)
io::out $ (const::max_u64 + 1u64 == 0u64)
io::out $ (const::max_i32 + 1i32 == const::min_i32)

// Floating point constants
io::out $ const::inf_f64
io::out $ -const::inf_f64
io::out $ const::max_f64
io::out $ -const::max_f64
io::out $ const::min_f64
io::out $ -0.0

// Negative zero properties
io::out $ (1.0 / -0.0)
io::out $ (-0.0 == 0.0)
io::out $ (1.0 / -0.0 == -const::inf_f64)

// Inf, subnormal, and epsilon properties
io::out $ (const::inf_f64 > const::max_f64)
io::out $ (-const::inf_f64 < -const::max_f64)
io::out $ (const::sub_f64 > 0.0)
io::out $ (const::sub_f64 / 2.0 == 0.0)
io::out $ (const::min_f64 > const::sub_f64)
io::out $ (1.0 + const::eps_f64 > 1.0)
io::out $ (1.0 + const::eps_f64 / 2.0 == 1.0)

// F32 constants and properties
io::out $ const::inf_f32
io::out $ -const::inf_f32
io::out $ const::max_f32
io::out $ -const::max_f32
io::out $ const::min_f32
io::out $ -0.0f32
io::out $ (1.0f32 / -0.0f32 == -const::inf_f32)
io::out $ (const::inf_f32 > const::max_f32)
io::out $ (-const::inf_f32 < -const::max_f32)
io::out $ (const::sub_f32 > 0.0f32)
io::out $ (const::sub_f32 / 2.0f32 == 0.0f32)
io::out $ (const::min_f32 > const::sub_f32)
io::out $ (1.0f32 + const::eps_f32 > 1.0f32)
io::out $ (1.0f32 + const::eps_f32 / 2.0f32 == 1.0f32)

// Record field and tuple indexing coexistence
rec = (max = 10, min = 5, inf = 1, sub = 2)
io::out $ rec.max
io::out $ rec.min
io::out $ rec.inf
io::out $ rec.sub

t = (100, 200)
io::out $ t.0
io::out $ t.1
