// Implicit single parameter via a parenthesized expression with '_'
// (desugars to "_ =>"), and the explicit "_ =>" form. Bare "=>" (omitted
// parameters) is a parse error.
#use io

double = (_ * 2)
add_ten = _ => _ + 10

io::out $ double $ 21
io::out $ add_ten $ 32

triple = (_ * 3)
io::out $ triple $ 5
