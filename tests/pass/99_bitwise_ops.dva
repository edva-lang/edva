// Bitwise operators: .&. .|. .!. .<. .>.
// .>. is a zero-fill (logical) right shift; shift amounts are masked.
#use io

a = 0b1100 .&. 0b1010
io::out $ a      // 8
b = 0b1100 .|. 0b1010
io::out $ b      // 14
c = .!. 5
io::out $ c      // -6
d = 1 .<. 4
io::out $ d      // 16
e = 0xF0 .>. 4
io::out $ e      // 15
// masked shift via runtime path
x = 1
s = 64
io::out $ x .<. s     // 1 (64 & 63 = 0)
// precedence: .&. tighter than .|. ; shifts tighter than comparison
p = 2 .|. 2 .&. 4
io::out $ p      // 2
t = 8 .>. 2 > 1
io::out $ (t | "Positive" | "Negative")      // (8 >> 2) > 1 = Positive
u = 3 .&. 1 == 1
io::out $ u      // 3 & (1==1) = 1
