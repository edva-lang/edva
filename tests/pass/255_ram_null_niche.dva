// Tests null-pointer niche representation for single-payload ramifications
// (RamPN <String|>, RamPN <(x: Int, y: Int)|>, RamNP <|String>)

#use io

find_str: Int => < String | >
find_str = x =>
   x > 0 | <+ "hello niche" ->

find_pt: Int => < (x: Int, y: Int) | >
find_pt = x =>
   x > 0 | <+ (x = 10, y = 20) ->

validate: Int => < | String >
validate = x =>
   x !< 0
      | <++>
      | <- "invalid negative" +>

// Test RamPN <String|>
s1 = find_str(5)
s1
   | s => io::out $ s
   | io::out $ "none"

s2 = find_str(-1)
s2
   | s => io::out $ s
   | io::out $ "none"

// Test unwrap on niche RamPN <String|>
io::out $ s1!!

// Test RamPN <(x: Int, y: Int)|>
p1 = find_pt(1)
p1
   | pt =>
      io::out $ pt.x
      io::out $ pt.y
   | io::out $ "no point"

p2 = find_pt(0)
p2
   | pt =>
      io::out $ pt.x
      io::out $ pt.y
   | io::out $ "no point"

// Test unwrap on niche RamPN <Record|>
pt_val = p1!!
io::out $ pt_val.x + pt_val.y

// Test RamNP <|String>
v1 = validate(10)
v1
   | io::out $ "ok"
   | err => io::out $ err

v2 = validate(-5)
v2
   | io::out $ "ok"
   | err => io::out $ err
