// Zero-argument functions: "!=>" defines, "() =>" declares, "!" calls.

#use io

fun = !=> 42
io::out $ fun!

greet: () => String
greet = !=> "hi"
io::out $ greet!

add: () => Int
add = !=> 1 + 2
io::out $ add!

// A zero-arg function passed to $> / $ (first-class value).
dbl: () => Int
dbl = !=> 21
r = dbl! + dbl!
io::out $ r

b = {16}
b += 65
io::out $ +b
