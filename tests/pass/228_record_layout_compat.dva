// Record layout compatibility: a record with IDENTICAL field layouts is
// accepted wherever a declared record is expected, even with different field
// names; pointer-shaped fields (a growable-array list where a heap enum is
// declared, a String where a Builder...) are ABI-identical pointer slots.
#use io

#type A (a: Int)
#type B (b: Int)
f: A => Int
f = r =>
   r.a
io::out(f((5,)))
io::out(f(B((7,))))

// A bare unit flag field takes an integerish truthiness; a heap enum field
// takes an enum value.
#type K < P, N >
#type R (flag: <>, kind: K)
x: R
x.flag = 1
x.kind = K(N)
io::out $ "ok"
