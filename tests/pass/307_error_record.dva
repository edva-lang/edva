// tests/pass/307_error_record.dva
// Verifies Error is an ordinary inspectable record with non-poisonous choices
// and that unit-success ramifications (< | E >) support --! propagation.

#use io

fail_err: () => < | Error >
fail_err = !=>
   <- Error(42, "operation failed", "worker.dva", 15, 8, (101, 202)) ->

ok_unit: () => < | Error >
ok_unit = !=>
   <++>

step_unit: () => < | Error >
step_unit = !=>
   res1 = ok_unit!
   res1--!
   io::out("unit step ok")
   res2 = fail_err!
   res2--!
   io::out("should not reach here")
   <++>

fail_str: () => < | String >
fail_str = !=>
   <- "string failure" ->

ok_str_unit: () => < | String >
ok_str_unit = !=>
   <++>

step_str_unit: () => < | String >
step_str_unit = !=>
   s1 = ok_str_unit!
   s1--!
   io::out("str unit step ok")
   s2 = fail_str!
   s2--!
   io::out("should not reach here")
   <++>

main: () => ()
main = !=>
   r = step_unit!
   r
      | io::out("unexpected ok")
      | e =>
         io::out("caught error:")
         io::out(e.msg)
         io::out(e.code)
         io::out(e.file)
         io::out(e.line)
         io::out(e.col)
         io::out(e.context.0)
         io::out(e.context.1)

   rs = step_str_unit!
   rs
      | io::out("unexpected str ok")
      | s =>
         io::out("caught str:")
         io::out(s)

main!
