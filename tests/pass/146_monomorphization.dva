// Monomorphization with type inference: a generic function ("#! T: Type") is
// instantiated once per inferred type — the type parameter is inferred from the
// runtime argument's type, no explicit type argument is written. Each binding
// compiles a distinct LLVM function, so the body is type-correct: String '+'
// concatenates, Int '+' adds, Float '+' adds.

id: #! T: Type, T => T
id = x => x

print_int $ id(42) + 10
print $ id("hi ") + "there"
print_float $ id(1.5) + 1.0

add: #! T: Type, T, T => T
add = a, b => a + b
print_int $ add(3, 4)
print $ add("a", "b")
print_float $ add(1.5, 2.5)
