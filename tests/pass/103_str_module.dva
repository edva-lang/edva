// std/str module: is_* predicates, to_* / from_* conversions.

#use str
#use io

// Predicates return ramifications: <+> / <-> (printed as Positive/Negative).
io::out $ ( str::is_digit(Int('5')) | "Positive" | "Negative")
io::out $ ( str::is_digit(Int('x')) | "Positive" | "Negative")
io::out $ ( str::is_alpha(Int('a')) | "Positive" | "Negative")
io::out $ ( str::is_alpha(Int('9')) | "Positive" | "Negative")
io::out $ ( str::is_alnum(Int('z')) | "Positive" | "Negative")
io::out $ ( str::is_alnum(Int('!')) | "Positive" | "Negative")
io::out $ ( str::is_ws(Int(' ')) | "Positive" | "Negative")
io::out $ ( str::is_hex(Int('f')) | "Positive" | "Negative")
io::out $ ( str::is_hex(Int('g')) | "Positive" | "Negative")

// from_byte: one byte as a 1-byte string.
io::out $ str::from_byte(65)

// from_int: proper fat String for 0, positive, negative.
io::out $ str::from_int(0)
io::out $ str::from_int(1234)
io::out $ str::from_int(-7)

// to_int / to_hex: RamPN Some((value, rest)) | None (no digits).
r = str::to_int("123abc")
io::out $ (r | (_.0) | -1)
io::out $ (r | (_.1) | "none")
rr = str::to_int("abc")
io::out $ (rr | (_.0) | -1)
h = str::to_hex("2fZ")
io::out $ (h | (_.0) | -1)
hx = str::to_hex("Zz")
io::out $ (hx | (_.0) | -1)

// "string @ ..." iterates through the bytes: 1 param = byte, 2 params =
// (byte, index); the index persists after a break as the bytes consumed.
sum' = 0
"hi!" @ b => sum' = sum' + b
io::out $ sum'
s = "123abc"
s @ b, i =>
   !str::is_digit(b) | -->
io::out $ i
s @ b => io::out $ b
s @
   io::out $ _
   io::out $ _i
