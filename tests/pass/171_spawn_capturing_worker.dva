// M3: task::spawn accepts a capturing closure — its environment is deep-copied into
// the child arena, so the worker reads its captures from child-owned memory.

// An Int capture, returned from a factory.
#use io
#use task

add_n = n =>
   m => n + m
adder = add_n(10)
h = task::spawn(adder(5))
r = task::join(h)
io::out $ (r | _ | _)

// A String capture with a declared signature.
mk_greet = name =>
   greet: String => String
   greet = s => "hi " + s + " from " + name
   greet
g = mk_greet("bob")
h2 = task::spawn(g("eve"))
r2 = task::join(h2)
io::out $ (r2 | _ | _)
