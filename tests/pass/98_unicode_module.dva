#use unicode
#use io

// Stage-2 page-table Unicode classification (std/unicode.dva).
io::out $ ((unicode::is_alpha $ 'A') | "alpha" | "not")
io::out $ ((unicode::is_alpha $ '1') | "alpha" | "not")
io::out $ ((unicode::is_alpha $ 'λ') | "alpha" | "not")
io::out $ ((unicode::is_digit $ '7') | "digit" | "not")
io::out $ ((unicode::is_digit $ '９') | "digit" | "not")
io::out $ ((unicode::is_upper $ 'Z') | "upper" | "not")
io::out $ ((unicode::is_upper $ 'a') | "upper" | "not")
io::out $ ((unicode::is_lower $ 'q') | "lower" | "not")
io::out $ ((unicode::is_lower $ 'Z') | "lower" | "not")
io::out $ ((unicode::is_space $ ' ') | "space" | "not")
io::out $ ((unicode::is_space $ '\t') | "space" | "not")
io::out $ ((unicode::is_space $ '\n') | "space" | "not")
io::out $ ((unicode::is_space $ '\0') | "space" | "not")
io::out $ ((unicode::is_space $ Rune(0xA0)) | "space" | "not")
io::out $ ((unicode::is_upper $ 'Ω') | "upper" | "not")
io::out $ ((unicode::is_lower $ 'é') | "lower" | "not")
io::out $ ((unicode::is_alpha $ Rune(0x10FFFF)) | "alpha" | "not")

// Unified category classification
io::out $ ((unicode::is_punctuation $ '.') | "punct" | "not")
io::out $ ((unicode::is_punctuation $ '!') | "punct" | "not")
io::out $ ((unicode::is_punctuation $ '—') | "punct" | "not")
io::out $ ((unicode::is_punctuation $ 'a') | "punct" | "not")
io::out $ ((unicode::is_symbol $ '+') | "symbol" | "not")
io::out $ ((unicode::is_symbol $ '$') | "symbol" | "not")
io::out $ ((unicode::is_symbol $ '€') | "symbol" | "not")
io::out $ ((unicode::is_mark $ Rune(0x0300)) | "mark" | "not")
io::out $ ((unicode::is_control $ '\0') | "control" | "not")
io::out $ ((unicode::is_number $ '½') | "number" | "not")
io::out $ ((unicode::is_number $ 'Ⅳ') | "number" | "not")
io::out $ unicode::category_description(unicode::category('A'))
io::out $ unicode::category_description(unicode::category('€'))
io::out $ unicode::category_description(unicode::category('!'))
