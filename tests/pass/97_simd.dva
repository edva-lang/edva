// Element-wise fixed-array arithmetic (process/simd.md): a 4-element i64
// array (32 bytes < 129) lowers to an LLVM vector; a 40-element i64 array
// (320 bytes) to a counted loop. Scalar operands broadcast.
#use io

a = (1, 2, 3, 4)
b = (5, 6, 7, 8)
c = a + b
io::out $ c(0)
io::out $ c(3)
d = a * 2
io::out $ d(0)
io::out $ d(3)
f = a - b
io::out $ f(1)
g = (1.5, 2.5)
h = (0.5, 1.5)
i = g + h
io::out $ i(0)
big = (1 {40})
big2 = (2 {40})
sum = big + big2
io::out $ sum(0)
io::out $ sum(39)
diff = (3 {40}) - big2
io::out $ diff(5)
div = a / b
io::out $ div(0)
