// Comma OR-list guards: `x [a, b, c] body` matches when x equals ANY of the
// listed values (equivalent to a chain of [a] [b] [c] guards).

// Statement form, no else: the guard's branch runs on a match, otherwise the
// following statement runs.
#use io

a = 2
a [1, 2, 3] io::out $ "a in 1,2,3"
a [7, 8] io::out $ "a in 7,8"

io::out $ 1000

// Value form with fallback: the matching branch value, else the fallback.
b = 5
r1 = b [1, 2, 5] 100 | 0
io::out $ r1

c = 9
r2 = c [1, 2, 5] 100 | 0
io::out $ r2

io::out $ 2000

// In a cycle: break when the counter hits any of the listed values.
sum' = 0
10 @ i =>
   i [2, 4, 6] -->
   sum' = sum' + i
io::out $ sum'

io::out $ 3000

// Mixed with a predicate guard (conditional-chain path).
v = 2
v
   [< 0] io::out $ "negative"
   [2, 4] io::out $ "two or four"
w = 9
w
   [< 0] io::out $ "negative"
   [2, 4] io::out $ "two or four"
io::out $ 4000

// String value-guards compare CONTENT, not pointers — a dynamically-built
// String matches a literal guard.
sb = {8}
sb += '/'
sp = +sb
sp ["/"] io::out $ "slash"
sp ["x"] io::out $ "x-guard"
io::out $ 5000
