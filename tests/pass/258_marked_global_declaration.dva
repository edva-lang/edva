#use io

::g_counter = 0
::g_val = 10
::g_ann: Int
g_ann = 42
regular_var = 100

inc_counter: () => ()
inc_counter = !=>
   g_counter = g_counter + 1

set_val: Int => ()
set_val = v =>
   ::g_val = v

test_shadow: () => ()
test_shadow = !=>
   regular_var = 999
   io::out $ regular_var

inc_counter!
inc_counter!
inc_counter!
io::out $ g_counter
io::out $ ::g_counter

set_val(55)
io::out $ g_val
io::out $ ::g_val

io::out $ g_ann
io::out $ ::g_ann

test_shadow!
io::out $ regular_var
