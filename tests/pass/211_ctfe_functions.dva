// CTFE now calls pure user functions: a '#!' expression can invoke any
// declared function whose body stays in the CTFE subset (no new syntax). The
// tree-walking interpreter binds params and recurses; the JIT remains the
// fallback for the non-interpretable tail.

#use "str"
#use io

double = n => n * 2
square = n => n * n
sum3 = a, b, c => a + b + c
is_even = n => n % 2 == 0
max2 = a, b => a > b | a | b
describe = n => n > 0 | "pos" | "non"
greet = name => "hi " + name

io::out $ str::from_int(#! double(21))
io::out $ str::from_int(#! square(9))
io::out $ str::from_int(#! sum3(1, 2, 3))
io::out $ str::from_int(#! double(square(3)))
io::out $ str::from_int(#! is_even(8))
io::out $ str::from_int(#! max2(3, 7))
io::out $ str::from_int(#! max2(9, 2))
io::out $ #! describe(5)
io::out $ #! describe(-1)
io::out $ #! greet("dva")
io::out $ str::from_int(#! (3 > 7 | 100 | 0))
io::out $ #! (2 < 3 | "yes" | "no")
