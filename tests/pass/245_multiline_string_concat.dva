// Tests multiline string literal concatenation (issue #20)

s1 = "hello "
   "world"
print $ s1

s2 = "one "
   "two "
   "three"
print $ s2

s3 = "with " // trailing comment on line 1
   "comment"
print $ s3

s4 = (=raw =)// comment
   (=string=)
print $ s4

s5 = "mix "
   (=raw=)
print $ s5

f = s => print $ s
f("call "
   "arg")
