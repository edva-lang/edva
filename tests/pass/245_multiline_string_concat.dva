// Tests multiline string literal concatenation (issue #20)

#use io

s1 = "hello "
   "world"
io::out $ s1

s2 = "one "
   "two "
   "three"
io::out $ s2

s3 = "with " // trailing comment on line 1
   "comment"
io::out $ s3

s4 = (=raw =)// comment
   (=string=)
io::out $ s4

s5 = "mix "
   (=raw=)
io::out $ s5

f: String => ()
f = s => io::out $ s
f("call "
   "arg")
