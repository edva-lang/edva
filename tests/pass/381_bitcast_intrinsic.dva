#use(import) io
#use "str"

#type Vec4i (x: i32, y: i32, z: i32, w: i32)

// 1. Scalar 32-bit: f32 <-> u32 / i32
bits_one = %bitcast(u32, 1.0f32)
out $ str::from_int(Int(bits_one))

flt_three = %bitcast(f32, 0x40400000u32)
out $ str::from_float(Float(flt_three))

bits_neg2 = %bitcast(i32, -2.0f32)
out $ str::from_int(Int(bits_neg2))

// 2. Scalar 64-bit: Float <-> Int / u64
bits_d1 = %bitcast(Int, 1.0)
out $ str::from_int(bits_d1)

flt_d2 = %bitcast(Float, 0x4000000000000000)
out $ str::from_float(flt_d2)

// 3. SIMD vector 128-bit: (f32 * 4) <-> (i32 * 4) and named Vec4i
vf = (1.0f32, 2.0f32, 4.0f32, -1.0f32)
vi = %bitcast((i32 * 4), vf)
out $ str::from_int(Int(vi.0)) + " " + str::from_int(Int(vi.1)) + " " + str::from_int(Int(vi.2)) + " " + str::from_int(Int(vi.3))

vf_back = %bitcast((f32 * 4), vi)
out $ str::from_float(Float(vf_back.0 + vf_back.1 + vf_back.2 + vf_back.3))

vn = %bitcast(Vec4i, vf)
out $ str::from_int(Int(vn.x)) + " " + str::from_int(Int(vn.y))

// 4. SIMD vector <-> 64-bit scalar: (f32 * 2) <-> u64
v2 = (1.0f32, 2.0f32)
packed64 = %bitcast(u64, v2)
v2_back = %bitcast((f32 * 2), packed64)
out $ str::from_float(Float(v2_back.0)) + " " + str::from_float(Float(v2_back.1))
