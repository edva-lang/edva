// Three-level nested record type declarations with deep member writes.
#use io

#type C (z: Int, label: String)
#type B (y: Int, c: C)
#type A (x: Int, b: B)

a: A
a.x = 1
a.b.y = 2
a.b.c.z = 3
a.b.c.label = "deep"
io::out $ a.x
io::out $ a.b.y
io::out $ a.b.c.z
io::out $ a.b.c.label

// Deep whole-field writes at each level.
a.b = (20, (30, "mid"))
io::out $ a.b.y
io::out $ a.b.c.z
io::out $ a.b.c.label
