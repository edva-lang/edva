// std/unicode module: decode_rune + utf8_width + classification.

#use unicode
#use io

// utf8_width: byte width of a rune's encoding (1/2/3/4).
io::out $ unicode::utf8_width(Rune(65))
io::out $ unicode::utf8_width(Rune(0x3B1))
io::out $ unicode::utf8_width(Rune(0x4E2D))
io::out $ unicode::utf8_width(Rune(0x1F600))

// decode_rune: codepoint at a byte offset (ASCII, 2/3/4-byte sequences).
io::out $ Int(unicode::decode_rune("a", 0))
io::out $ Int(unicode::decode_rune("é", 0))
io::out $ Int(unicode::decode_rune("中", 0))
io::out $ Int(unicode::decode_rune("😀", 0))

// Walk a mixed string decoding rune by rune, advancing by utf8_width — a
// round-trip proving width and decode agree.
s = "aé中😀"
total = ?s
i' = 0
0.. @
   i' !< total | -->
   io::out $ Int(unicode::decode_rune(s, i'))
   i' = i' + unicode::utf8_width(unicode::decode_rune(s, i'))
