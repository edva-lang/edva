// JSON number strictness (L10): a bare '-', "1.", "1e", "1e+", and ".5"
// must be rejected as malformed, not silently parsed as -0.0 / 1.0 / 1.0.

#use json
#use io

check: String => String
check = s => json::parse(s) | v => "ok" | e => "error"

io::out $ check $ (=1.5=)
io::out $ check $ (=-3=)
io::out $ check $ (=2.5e-2=)
io::out $ check $ (=-=)
io::out $ check $ (=1.=)
io::out $ check $ (=1e=)
io::out $ check $ (=1e+=)
io::out $ check $ (=.5=)