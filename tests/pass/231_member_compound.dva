// A compound MEMBER write "r.m += v" appends to the field's Builder (String
// or byte RHS) or growable array in place. The field must be initialized
// first (field-init tracking).
#use io

#type Ints (Int){}
#type R (m: Builder, a: Ints)
r: R
r.m = {4}
r.a = Ints()
r.m += "hi"
r.m += 10
r.a += 7
r.a += 8
io::out $ +r.m
io::out $ (r.a(0) | _ | _)
io::out $ (r.a(1) | _ | _)
io::out $ ?r.a
