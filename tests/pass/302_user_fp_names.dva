// Verify that FP function names (map, filter, find, any, apply, const, sort)
// can be freely used as local variables and parameters now that they are
// no longer in the prelude.

#use io

apply = 100
io::out $ apply

f = map => map * 2
io::out $ f(5)

g = x =>
   filter = x + 10
   filter
io::out $ g(20)

5 @ find =>
   find == 3 | io::out $ find

sort = 42
io::out $ sort
