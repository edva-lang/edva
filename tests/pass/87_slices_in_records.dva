// Slices as record fields (by-reference) and record-of-slices.
#use io

#type S (name: String, items: (Int[]))
s: S
src = (1, 2, 3)
s.name = "dva"
s.items = src(0..3)
io::out $ s.name
io::out $ ?s.items
io::out $ s.items(1)

// A record whose elements are slices: extraction keeps the slice's element type.
a = (10, 20)
b = (30, 40)
both = (a(0..2), b(0..2))
io::out $ ?both
first = both(0)
io::out $ ?first
second = both(1)
io::out $ second(0)
io::out $ second(1)
