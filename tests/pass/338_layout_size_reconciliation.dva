// tests/pass/338_layout_size_reconciliation.dva
// Verifies semantic layout metadata agrees with runtime ABI and target lowering:
// Rune is 4 bytes, Error is 56 bytes (64-bit), Addr is 8 bytes, String is 16 bytes,
// Builder is 24 bytes, and record field alignment is properly computed.

#use io

PackedRecord: #packed (a: i8, b: i32, c: i16)
#type AlignedRecord (a: i8, b: i32, c: i16)
#type ThreeFields (a: Int, b: Int, c: Int)
#type RecordWithPointer (p: Addr, x: Int)

main: () => ()
main = !=>
   io::out $ #size Rune
   io::out $ #size Error
   io::out $ #size Addr
   io::out $ #size String
   io::out $ #size Builder
   io::out $ #size PackedRecord
   io::out $ #size AlignedRecord
   io::out $ #size ThreeFields
   io::out $ #size RecordWithPointer

   err = Error(404, "item not found", "test.dva", 42, 12, (10, 20))
   io::out(err.code)
   io::out(err.msg)
   io::out(err.file)
   io::out(err.line)
   io::out(err.col)
   io::out(err.context.0)
   io::out(err.context.1)

main!
