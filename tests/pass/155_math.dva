#use const
#use math
#use io

// powers / roots (intrinsics + libm)
io::out $ %sqrt(16.0)
io::out $ %pow(2.0, 10.0)

// trig
io::out $ %sin(0.0)
io::out $ %cos(0.0)

// exp / log
io::out $ math::log(1.0)
io::out $ math::exp(0.0)

// rounding / abs
io::out $ %floor(3.7)
io::out $ %ceil(3.2)
io::out $ %abs(-2.5)

// constants
io::out $ const::pi
