#use math
#use io

// powers / roots
io::out $ math::sqrt(16.0)
io::out $ math::pow(2.0, 10.0)

// trig
io::out $ math::sin(0.0)
io::out $ math::cos(0.0)

// exp / log
io::out $ math::log(1.0)
io::out $ math::exp(0.0)

// rounding
io::out $ math::floor(3.7)
io::out $ math::ceil(3.2)
io::out $ math::fabs(-2.5)

// constants
io::out $ math::pi
