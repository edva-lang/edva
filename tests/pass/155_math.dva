#use math

// powers / roots
print_float $ math::sqrt(16.0)
print_float $ math::pow(2.0, 10.0)

// trig
print_float $ math::sin(0.0)
print_float $ math::cos(0.0)

// exp / log
print_float $ math::log(1.0)
print_float $ math::exp(0.0)

// rounding
print_float $ math::floor(3.7)
print_float $ math::ceil(3.2)
print_float $ math::fabs(-2.5)

// constants
print_float $ math::pi
