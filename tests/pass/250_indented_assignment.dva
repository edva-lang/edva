#use io

x =
   10
io::out $ str::from_int(x)

y =
   20
io::out $ str::from_int(y)

z =
   a = 5
   b = 15
   a + b
io::out $ str::from_int(z)

c =
   1 < 2
      | "yes"
      | "no"
io::out $ c

f =
   n => n * 3
io::out $ str::from_int(f(7))

r = (a = 1, b = 2)
r.a =
   99
io::out $ str::from_int(r.a)
