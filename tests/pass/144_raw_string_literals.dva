// Raw string literals "(= ... =)": the content is literal bytes — quotes,
// braces, backslashes, and newlines need no escaping — with a single escape
// "=\)" producing a literal "=)". A raw string is a normal String value.

#use io

io::out $ (=hello=)
io::out $ (=hello world=)
io::out $ (="quoted"=)
io::out $ (={ "a": 1, "b": [2, 3] }=)
io::out $ (=a==b=)
io::out $ (=C:\path\to\file=)
io::out $ (=multi
line=)
io::out $ (=a=\)b=)
io::out $ (=x=\)=)

// A raw string flows into a call (extra parens: "(=...=)" is the argument)
// and through the '$' apply operator.
f: String => String
f = s => s
io::out $ f((=via call=))
io::out $ f $ (=via dollar=)
