// The widened #! CTFE subset: comparisons, !, && / ||, bitwise, compile-time
// choices (scalar and String), ?s, arithmetic — all JIT-evaluated through the
// same codegen pipeline and embedded as constants.

#use "str"

print $ str::from_int(#!(2 < 3))
print $ str::from_int(#!!(5 > 3))
print $ str::from_int(#!(2 < 3 && 5 > 4))
print $ str::from_int(#!(2 > 3 || 5 > 4))
print $ str::from_int(#! (2 < 3 | 100 | 0))
print $ str::from_int(#! (2 > 3 | 100 | 0))
print $ #! (2 < 3 | "yes" | "no")
print $ #! (2 > 3 | "yes" | "no")
print $ str::from_int(#!(6 % 4))
print $ str::from_int(#!(5 .&. 3))
print $ str::from_int(#!(?("hello")))
print $ str::from_int(#!(2 + 3 * 4))