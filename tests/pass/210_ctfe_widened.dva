// The widened #! CTFE subset: comparisons, !, && / ||, bitwise, compile-time
// choices (scalar and String), ?s, arithmetic — all JIT-evaluated through the
// same codegen pipeline and embedded as constants.

#use "str"
#use io

io::out $ str::from_int(#!(2 < 3))
io::out $ str::from_int(#!!(5 > 3))
io::out $ str::from_int(#!(2 < 3 && 5 > 4))
io::out $ str::from_int(#!(2 > 3 || 5 > 4))
io::out $ str::from_int(#! (2 < 3 | 100 | 0))
io::out $ str::from_int(#! (2 > 3 | 100 | 0))
io::out $ #! (2 < 3 | "yes" | "no")
io::out $ #! (2 > 3 | "yes" | "no")
io::out $ str::from_int(#!(6 % 4))
io::out $ str::from_int(#!(5 .&. 3))
io::out $ str::from_int(#!(?("hello")))
io::out $ str::from_int(#!(2 + 3 * 4))