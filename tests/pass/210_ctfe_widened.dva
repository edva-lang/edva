// The widened #const CTFE subset: comparisons, !, && / ||, bitwise, compile-time
// choices (scalar and String), ?s, arithmetic — all JIT-evaluated through the
// same codegen pipeline and embedded as constants.

#use str
#use io

io::out $ #const(2 < 3)
io::out $ #const!(5 > 3)
io::out $ #const(2 < 3 && 5 > 4)
io::out $ #const(2 > 3 || 5 > 4)
io::out $ str::from_int(#const (2 < 3 | 100 | 0))
io::out $ str::from_int(#const (2 > 3 | 100 | 0))
io::out $ #const (2 < 3 | "yes" | "no")
io::out $ #const (2 > 3 | "yes" | "no")
io::out $ str::from_int(#const(6 % 4))
io::out $ str::from_int(#const(5 .&. 3))
io::out $ str::from_int(#const(?"hello"))
io::out $ str::from_int(#const(2 + 3 * 4))