#use "str"
#use io

make_buffer: #! N: Int => Builder
make_buffer = !=> {N}

repeat_str: #! N: Int, String => String
repeat_str = s =>
   b = {N * ?s}
   N @ _ => b += s
   +b

tag_msg: #! Prefix: String, String => String
tag_msg = msg => Prefix + ": " + msg

format_pair: #! S: String, #! N: Int, String => String
format_pair = val => S + " (" + str::from_int(N) + "): " + val

sum_to: #! N: Int => Int
sum_to = !=>
   total' = 0
   N @ i => total' = total' + i
   total'

b1 = make_buffer(32)
io::out $ str::from_int(?b1)

b2 = make_buffer(128)
io::out $ str::from_int(?b2)

io::out $ repeat_str(3, "abc")
io::out $ repeat_str(2 * 2, "hi")

io::out $ tag_msg("[INFO]", "system ready")
io::out $ tag_msg("[WARN]", "low memory")

io::out $ format_pair("Item", 42, "widget")

io::out $ str::from_int(sum_to(5))
io::out $ str::from_int(sum_to(10))
