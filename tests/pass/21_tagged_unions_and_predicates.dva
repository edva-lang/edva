#use io

add = a, b => a + b
io::out $ add(10, 20)

double = (_ * 2)
io::out $ double $ 15

opt = <+ "hello payload" +>
msg = opt
    | ("Found: " + _)
    | "Missing"
io::out $ msg

flag = 15 > 10
status = flag | "greater" | "smaller"
io::out $ status

foo = 24
res = foo
    [(_ > 30)] "more than 30"
    [(_ % 2 == 0)] "even"
    | "else"
io::out $ res

res_val = <+ "data loaded" ->
res_msg = res_val
    | ("Loaded: " + _)
    | ("Error: " + _)
io::out $ res_msg
