// M3: heap ram/enum payloads across the task::spawn/task::join boundary.
// The child arena is destroyed at task::join, so a shallow (non-deep) copy of the
// { tag, payload } union would leave the payload dangling into freed memory.

// A ram with a boxed-scalar (Int) payload on its positive slot, returned from
// the worker.
#use io
#use task

#type Option < Int | >

make_some: Int => Option
make_some = n =>
   Option(<+ n + 1 ->)

h = task::spawn(make_some(41))
r = task::join(h)
o = r | _ | _
io::out $ (o | _ | -1)

// An Option passed as a spawn argument.
val: Option => Int
val = o =>
   o | _ | -1

h2 = task::spawn(val(Option(<+ 7 +>)))
r2 = task::join(h2)
io::out $ (r2 | _ | _)

// An enum with a String payload, as argument and as return value.
#type Maybe <Some(String), Noth>

tag: Maybe => String
tag = m =>
   m [Some x] "got " + x [Noth] "none"

h3 = task::spawn(tag(Maybe(Some, "hey")))
r3 = task::join(h3)
io::out $ (r3 | _ | _)

make: String => Maybe
make = s =>
   Maybe(Some, s + "!")

h4 = task::spawn(make("hi"))
r4 = task::join(h4)
m = r4 | _ | _
io::out $ tag(m)

// A scalar-payload enum.
#type Num <N(Int), Zero>

show: Num => Int
show = n =>
   n [N x] x [Zero] 0

h5 = task::spawn(show(Num(N, 99)))
r5 = task::join(h5)
io::out $ (r5 | _ | _)

// An enum with a nested record payload, both directions.
#type Pkg <Ok(w: Int, h: Int), Bad>

area: Pkg => Int
area = p =>
   p [Ok t] t.w * t.h [Bad] -1

h6 = task::spawn(area(Pkg(Ok, (w = 3, h = 4))))
r6 = task::join(h6)
io::out $ (r6 | _ | _)

build: Int => Pkg
build = n =>
   Pkg(Ok, (w = n, h = n))

h7 = task::spawn(build(5))
r7 = task::join(h7)
p = r7 | _ | _
io::out $ area(p)

// The negative slot (tag 0) of a RamPP, whose payload is on the right.
#type Either < Int | String >

describe: Either => String
describe = e =>
   e | "pos" | _

h8 = task::spawn(describe(Either(<- "negative!" +>)))
r8 = task::join(h8)
io::out $ (r8 | _ | _)
