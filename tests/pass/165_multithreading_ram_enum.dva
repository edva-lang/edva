// M3: heap ram/enum payloads across the #spawn/#join boundary.
// The child arena is destroyed at #join, so a shallow (non-deep) copy of the
// { tag, payload } union would leave the payload dangling into freed memory.

// A ram with a boxed-scalar (Int) payload on its positive slot, returned from
// the worker.
#use io

#type Option < Int | >

make_some: Int => Option
make_some = n =>
   Option(<+ n + 1 +>)

h = #spawn make_some(41)
r = #join h
o = r | _ | _
io::out $ (o | _ | -1)

// An Option passed as a spawn argument.
val: Option => Int
val = o =>
   o | _ | -1

h2 = #spawn val(Option(<+ 7 ->))
r2 = #join h2
io::out $ (r2 | _ | _)

// An enum with a String payload, as argument and as return value.
#type Maybe <Some(String), Noth>

tag: Maybe => String
tag = m =>
   m [Some x] "got " + x [Noth] "none"

h3 = #spawn tag(Maybe(Some, "hey"))
r3 = #join h3
io::out $ (r3 | _ | _)

make: String => Maybe
make = s =>
   Maybe(Some, s + "!")

h4 = #spawn make("hi")
r4 = #join h4
m = r4 | _ | _
io::out $ tag(m)

// A scalar-payload enum.
#type Num <N(Int), Zero>

show: Num => Int
show = n =>
   n [N x] x [Zero] 0

h5 = #spawn show(Num(N, 99))
r5 = #join h5
io::out $ (r5 | _ | _)

// An enum with a nested record payload, both directions.
#type Pkg <Ok((w: Int, h: Int)), Bad>

area: Pkg => Int
area = p =>
   p [Ok t] t.w * t.h [Bad] -1

h6 = #spawn area(Pkg(Ok, (w = 3, h = 4)))
r6 = #join h6
io::out $ (r6 | _ | _)

build: Int => Pkg
build = n =>
   Pkg(Ok, (w = n, h = n))

h7 = #spawn build(5)
r7 = #join h7
p = r7 | _ | _
io::out $ area(p)

// The negative slot (tag 0) of a RamPP, whose payload is on the right.
#type Either < Int | String >

describe: Either => String
describe = e =>
   e | "pos" | _

h8 = #spawn describe(Either(<- "negative!" ->))
r8 = #join h8
io::out $ (r8 | _ | _)
