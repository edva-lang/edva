// Aligned '|' must pertain to the same choice: a branch containing an inline
// ';' sequence must not absorb a subsequent aligned '|' into an inner choice.
#use io

f = b =>
   b
      | x = 1; x + 1
      | 42

io::out $ f(<+>)
io::out $ f(<->)

g: <> => <Int|>
g = b =>
   b
      | x = 10; <+ x ->
      | <-->

io::out $ (g(<+>) | v => v | 0)
io::out $ (g(<->) | v => v | 0)
