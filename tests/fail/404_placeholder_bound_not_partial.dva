// DVA-50: a `_` bound by an enclosing payload branch is the payload value, not a
// partial-application placeholder, so `sub3(_, 1)` is an Int here, not `Int => Int`.

#use io
#use str

sub3: Int, Int => Int
sub3 = a, b => a - b

apply: (Int => Int), Int => Int
apply = f, x => f(x)

half: Int => < Int | >
half = x => x % 2 == 0 | <+ x / 2 +> | <-->

half(8)
   | io::out $ str::from_int(apply(sub3(_, 1), 3))
   | io::out $ "none"
