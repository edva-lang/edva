// tools/gen_unicode.dva - Generates std/unicode.dva from UnicodeData.txt
// Uses a unified 2-stage category page table.

#use libc
#use io
#use str

#foreign "c"
   memcmp: (s1: Addr, s2: Addr, n: Int) => Int
   memcpy: (dest: Addr, src: Addr, n: Int) => Addr

#type Ints (Int){}

read_fd_bytes_loop: Int, Builder, Int, Int => < Int | >
read_fd_bytes_loop = fd, b, offset, remaining =>
   remaining !> 0
      | <+ offset +>
      |
         chunk = remaining < 65536 | remaining | 65536
         n = libc::read(fd, &b + offset, chunk)
         n < 0
            | <-->
            | n == 0
               | <+ offset +>
               | read_fd_bytes_loop(fd, b, offset + n, remaining - n)

read_file_text: String => < String | >
read_file_text = path =>
   fd = libc::open(path, 0)
   fd < 0
      | <-->
      |
         sz = libc::lseek(fd, 0, 2)
         sz < 0
            |
               libc::close(fd)
               <-->
            |
               sz == 0
                  |
                     libc::close(fd)
                     <+ "" +>
                  |
                     libc::lseek(fd, 0, 0)
                     b = {sz}
                     read_res = read_fd_bytes_loop(fd, b, 0, sz)
                     libc::close(fd)
                     read_res
                        | total =>
                           ?b = total
                           <+ +b +>
                        | <-->

write_bytes_loop: Int, String, Int, Int => <>
write_bytes_loop = fd, content, offset, remaining =>
   remaining !> 0
      | <+>
      |
         w = libc::write_ptr(fd, &content + offset, remaining)
         w < 0
            | <->
            | w == 0
               | <->
               | write_bytes_loop(fd, content, offset + w, remaining - w)

write_file_text: String, String => <>
write_file_text = path, content =>
   fd = libc::creat(path, 420)
   fd < 0
      | <->
      |
         n = ?content
         ok = n == 0 | <+> | write_bytes_loop(fd, content, 0, n)
         libc::close(fd)
         ok

hex_val: Int => Int
hex_val = c =>
   c
      [< '0'] 0
      [< ':'] c - '0'
      [< 'A'] 0
      [< 'G'] c - 'A' + 10
      [< 'a'] 0
      [< 'g'] c - 'a' + 10
      | 0

parse_hex: String, Int, Int => Int
parse_hex = src, start, len =>
   val' = 0
   0..len @ i =>
      c = src(start + i)
      val' = (val' .<. 4) + hex_val(c)
   val'

cat_id_from_chars: Int, Int => Int
cat_id_from_chars = c0, c1 =>
   c0
      ['L']
         c1 ['u'] 0 ['l'] 1 ['t'] 2 ['m'] 3 | 4
      ['M']
         c1 ['n'] 5 ['c'] 6 | 7
      ['N']
         c1 ['d'] 8 ['l'] 9 | 10
      ['P']
         c1 ['c'] 11 ['d'] 12 ['s'] 13 ['e'] 14 ['i'] 15 ['f'] 16 | 17
      ['S']
         c1 ['m'] 18 ['c'] 19 ['k'] 20 | 21
      ['Z']
         c1 ['s'] 22 ['l'] 23 | 24
      ['C']
         c1 ['c'] 25 ['f'] 26 ['s'] 27 ['o'] 28 | 29
      | 29

has_suffix: String, Int, Int, String => <>
has_suffix = src, start, end_pos, suffix =>
   slen = ?suffix
   wlen = end_pos - start
   wlen < slen
      | <->
      |
         diff' = <->
         0..slen @ i =>
            src(end_pos - slen + i) != suffix(i) | (diff' = <+>; -->)
         !diff'

format_hex64: Int => String
format_hex64 = v =>
   v == 0
      | "0"
      |
         digits = "0123456789abcdef"
         b = {18}
         b += "0x"
         n' = v
         rev = {16}
         0.. @
            n' == 0 | -->
            d = n' .&. 15
            rev += digits(d)
            n' = n' .>. 4
         srev = +rev
         rlen = ?srev
         rlen @ i =>
            b += srev(rlen - 1 - i)
         +b

main: Int => Int
main = _ =>
   src_opt = read_file_text("tools/UnicodeData.txt")
   src0 = src_opt | s => s | ""
   src = ?src0 > 0 | src0 | (read_file_text("/tmp/UnicodeData.txt") | s => s | "")
   ?src == 0
      |
         io::out $ "Cannot read tools/UnicodeData.txt or /tmp/UnicodeData.txt"
         #exit 1
         0
      |
         io::out $ "Parsing UnicodeData.txt in Dva..."
         raw_buf = {0x110000}
         raw = &raw_buf
         libc::memset(raw, 29, 0x110000)

         len = ?src
         pos' = 0
         in_range' = <->
         range_start' = 0
         range_cat' = 29

         0.. @
            pos' !< len | -->
            line_start = pos'
            0.. @
               pos' !< len || src(pos') == '\n' | -->
               pos' = pos' + 1
            line_end = pos'
            pos' < len && src(pos') == '\n' | pos' = pos' + 1

            s1' = -1
            s2' = -1
            s3' = -1
            i' = line_start
            0.. @
               i' !< line_end | -->
               src(i') == ';'
                  |
                     s1' < 0
                        | s1' = i'
                        | s2' < 0
                           | s2' = i'
                           | s3' < 0
                              | s3' = i'
               i' = i' + 1

            s1' > 0 && s2' > 0 && s3' > 0
               |
                  cp = parse_hex(src, line_start, s1' - line_start)
                  c0 = src(s2' + 1)
                  c1 = src(s2' + 2)
                  cat_id = cat_id_from_chars(c0, c1)

                  is_first = has_suffix(src, s1' + 1, s2', ", First>")
                  is_last = has_suffix(src, s1' + 1, s2', ", Last>")

                  is_first
                     |
                        in_range' = <+>
                        range_start' = cp
                        range_cat' = cat_id
                     | is_last
                        |
                           in_range' = <->
                           count = cp - range_start' + 1
                           count @ k =>
                              curr = range_start' + k
                              curr < 0x110000 | @[raw + curr] = u8(range_cat')
                        |
                           cp < 0x110000 | @[raw + cp] = u8(cat_id)

         io::out $ "Building and deduplicating pages..."
         stage1 = Ints()
         pages_buf = {300 * 256}
         unique_pages_mem = &pages_buf
         num_unique' = 0

         4352 @ p =>
            page_ptr = raw + p * 256
            found' = -1
            num_unique' @ u =>
               u_ptr = unique_pages_mem + u * 256
               memcmp(page_ptr, u_ptr, 256) == 0
                  |
                     found' = u
                     -->

            found' !< 0
               | stage1 += found'
               |
                  found' = num_unique'
                  num_unique' = num_unique' + 1
                  memcpy(unique_pages_mem + found' * 256, page_ptr, 256)
                  stage1 += found'

         io::out $ "Unique pages: " + str::from_int(num_unique')
         io::out $ "Emitting std/unicode.dva..."
         out = {500000}
         out += """
            // std/unicode.dva - Unicode: rune classification via unified 2-stage
            // category page table, plus UTF-8 encode/decode helpers.
            // Generated from UnicodeData.txt.

            // Unicode general category classifications:
            //   Letters:      Lu (Uppercase), Ll (Lowercase), Lt (Titlecase),
            //                 Lm (Modifier), Lo (Other)
            //   Marks:        Mn (Nonspacing), Mc (Spacing), Me (Enclosing)
            //   Numbers:      Nd (Decimal), Nl (Letter), No (Other)
            //   Punctuation:  Pc (Connector), Pd (Dash), Ps (Open), Pe (Close),
            //                 Pi (Initial), Pf (Final), Po (Other)
            //   Symbols:      Sm (Math), Sc (Currency), Sk (Modifier), So (Other)
            //   Separators:   Zs (Space), Zl (Line), Zp (Paragraph)
            //   Other:        Cc (Control), Cf (Format), Cs (Surrogate),
            //                 Co (Private Use), Cn (Unassigned)

            #public
            #type Category < Lu, Ll, Lt, Lm, Lo, Mn, Mc, Me, Nd, Nl, No, Pc,
               Pd, Ps, Pe, Pi, Pf, Po, Sm, Sc, Sk, So, Zs, Zl, Zp,
               Cc, Cf, Cs, Co, Cn >

            #pragma number i16
            #private cat_s1 = (
            """
         out += "   "

         idx' = 0
         col' = 3
         first' = <+>
         0.. @
            idx' !< 4352 | -->
            v = stage1(idx') | _ | 0
            count' = 1
            0.. @
               idx' + count' !< 4352 | -->
               nxt = stage1(idx' + count') | _ | -1
               nxt == v | count' = count' + 1 | -->

            tok = count' > 2
               | str::from_int(v) + " {" + str::from_int(count') + "}"
               | str::from_int(v)
            idx' = count' > 2 | idx' + count' | idx' + 1

            !first'
               |
                  col' + ?tok + 2 > 78
                     |
                        out += ",\n   "
                        col' = 3
                     |
                        out += ", "
                        col' = col' + 2
            first' = <->
            out += tok
            col' = col' + ?tok

         out += "\n)\n\n"

         out += "#pragma number i64\n"
         out += "#private cat_s2 = (\n   "

         total_words = num_unique' * 32
         widx' = 0
         wcol' = 3
         first_w' = <+>
         0.. @
            widx' !< total_words | -->
            vw = @[unique_pages_mem + widx' * 8 i64]
            wcount' = 1
            0.. @
               widx' + wcount' !< total_words | -->
               nxtw = @[unique_pages_mem + (widx' + wcount') * 8 i64]
               nxtw == vw | wcount' = wcount' + 1 | -->

            wtok = wcount' > 2
               | format_hex64(vw) + " {" + str::from_int(wcount') + "}"
               | format_hex64(vw)
            widx' = wcount' > 2 | widx' + wcount' | widx' + 1

            !first_w'
               |
                  wcol' + ?wtok + 2 > 78
                     |
                        out += ",\n   "
                        wcol' = 3
                     |
                        out += ", "
                        wcol' = wcol' + 2
            first_w' = <->
            out += wtok
            wcol' = wcol' + ?wtok

         out += "\n)\n\n"
         out += "#pragma number default\n\n"

         out += """
            #public
               category_id: Rune => Int
               category_id = cp =>
                  cp [> 0x10FFFF] 29 |
                     page = Int(cat_s1(cp .>. 8))
                     (cat_s2(page * 32 + ((cp .&. 255) .>. 3)) .>. ((cp .&. 7) .<. 3)) .&. 255

               category: Rune => Category
               category = cp =>
                  id = category_id(cp)
                  id
                     [0] Lu [1] Ll [2] Lt [3] Lm [4] Lo
                     [5] Mn [6] Mc [7] Me
                     [8] Nd [9] Nl [10] No
                     [11] Pc [12] Pd [13] Ps [14] Pe [15] Pi [16] Pf [17] Po
                     [18] Sm [19] Sc [20] Sk [21] So
                     [22] Zs [23] Zl [24] Zp
                     [25] Cc [26] Cf [27] Cs [28] Co
                     | Cn

               // Human-readable description of a Unicode general category.
               category_description: Category => String
               category_description = c =>
                  c
                     [Lu] "Uppercase Letter"
                     [Ll] "Lowercase Letter"
                     [Lt] "Titlecase Letter"
                     [Lm] "Modifier Letter"
                     [Lo] "Other Letter"
                     [Mn] "Nonspacing Mark"
                     [Mc] "Spacing Mark"
                     [Me] "Enclosing Mark"
                     [Nd] "Decimal Number"
                     [Nl] "Letter Number"
                     [No] "Other Number"
                     [Pc] "Connector Punctuation"
                     [Pd] "Dash Punctuation"
                     [Ps] "Open Punctuation"
                     [Pe] "Close Punctuation"
                     [Pi] "Initial Punctuation"
                     [Pf] "Final Punctuation"
                     [Po] "Other Punctuation"
                     [Sm] "Math Symbol"
                     [Sc] "Currency Symbol"
                     [Sk] "Modifier Symbol"
                     [So] "Other Symbol"
                     [Zs] "Space Separator"
                     [Zl] "Line Separator"
                     [Zp] "Paragraph Separator"
                     [Cc] "Control"
                     [Cf] "Format"
                     [Cs] "Surrogate"
                     [Co] "Private Use"
                     [Cn] "Unassigned"
                     | "Unknown"

               // Alphabetic letters (Lu, Ll, Lt, Lm, Lo)
               is_alpha: Rune => <>
               is_alpha = cp =>
                  cat = category_id(cp)
                  cat !> 4

               // Decimal digits (Nd)
               is_digit: Rune => <>
               is_digit = cp =>
                  category_id(cp) == 8

               // Uppercase letters (Lu)
               is_upper: Rune => <>
               is_upper = cp =>
                  category_id(cp) == 0

               // Lowercase letters (Ll)
               is_lower: Rune => <>
               is_lower = cp =>
                  category_id(cp) == 1

               // Titlecase letters (Lt)
               is_title: Rune => <>
               is_title = cp =>
                  category_id(cp) == 2

               // Whitespace: space separators (Zs, Zl, Zp) plus ASCII whitespace
               // (\\t, \\n, \\v, \\f, \\r)
               is_space: Rune => <>
               is_space = cp =>
                  cat = category_id(cp)
                  (cat !< 22 && cat !> 24) || (cp == 0x20 || (cp !< 0x09 && cp !> 0x0D))

               // Punctuation (Pc, Pd, Ps, Pe, Pi, Pf, Po)
               is_punctuation: Rune => <>
               is_punctuation = cp =>
                  cat = category_id(cp)
                  cat !< 11 && cat !> 17

               // Symbols: math, currency, modifiers, others (Sm, Sc, Sk, So)
               is_symbol: Rune => <>
               is_symbol = cp =>
                  cat = category_id(cp)
                  cat !< 18 && cat !> 21

               // Combining marks: nonspacing, spacing, enclosing (Mn, Mc, Me)
               is_mark: Rune => <>
               is_mark = cp =>
                  cat = category_id(cp)
                  cat !< 5 && cat !> 7

               // Numbers: decimal digits, letter numbers, other numbers (Nd, Nl, No)
               is_number: Rune => <>
               is_number = cp =>
                  cat = category_id(cp)
                  cat !< 8 && cat !> 10

               // Control characters (Cc)
               is_control: Rune => <>
               is_control = cp =>
                  category_id(cp) == 25

               // Graphic characters (letters, marks, numbers, punctuation, symbols)
               is_graphic: Rune => <>
               is_graphic = cp =>
                  cat = category_id(cp)
                  cat !> 22

               // Decode the UTF-8 rune at src[i] into its codepoint.
               decode_rune: String, Int => Rune
               decode_rune = src, i =>
                  b0 = src(i)
                  Rune(b0
                     [< 0x80] b0
                     [< 0xE0] (b0 - 0xC0) * 0x40 + (src(i + 1) - 0x80)
                     [< 0xF0]
                        (b0 - 0xE0) * 0x1000 + (src(i + 1) - 0x80) * 0x40 +
                           (src(i + 2) - 0x80)
                     |
                        (b0 - 0xF0) * 0x40000 + (src(i + 1) - 0x80) * 0x1000 +
                           (src(i + 2) - 0x80) * 0x40 + (src(i + 3) - 0x80)
                  )

               // Byte width of a rune's UTF-8 encoding.
               utf8_width: Rune => Int
               utf8_width = r =>
                  r [< 0x80] 1 [< 0x800] 2 [< 0x10000] 3 | 4

               // UAX #31: XID_Start characters (Lu, Ll, Lt, Lm, Lo, Nl)
               is_xid_start: Rune => <>
               is_xid_start = cp =>
                  cat = category_id(cp)
                  cat !> 4 || cat == 9

               // UAX #31: XID_Continue characters (Lu..Lo, Mn, Mc, Nd, Nl, Pc)
               is_xid_continue: Rune => <>
               is_xid_continue = cp =>
                  cat = category_id(cp)
                  cat !> 6 || cat == 8 || cat == 9 || cat == 11

               // Identifier start: XID_Start or '_'
               is_id_start: Rune => <>
               is_id_start = cp =>
                  cp == '_' || is_xid_start(cp)

               // Identifier continuation: XID_Continue
               is_id_continue: Rune => <>
               is_id_continue = cp =>
                  is_xid_continue(cp)

               // Decode the UTF-8 rune at Addr + i into its codepoint.
               decode_rune_addr: Addr, Int => Rune
               decode_rune_addr = p, i =>
                  b0 = Int(@[p + i u8])
                  Rune(b0
                     [< 0x80] b0
                     [< 0xE0] (b0 - 0xC0) * 0x40 + (Int(@[p + i + 1 u8]) - 0x80)
                     [< 0xF0]
                        (b0 - 0xE0) * 0x1000 + (Int(@[p + i + 1 u8]) - 0x80) * 0x40 +
                           (Int(@[p + i + 2 u8]) - 0x80)
                     |
                        (b0 - 0xF0) * 0x40000 + (Int(@[p + i + 1 u8]) - 0x80) * 0x1000 +
                           (Int(@[p + i + 2 u8]) - 0x80) * 0x40 + (Int(@[p + i + 3 u8]) - 0x80)
                  )

               // Decode the UTF-8 rune at Builder buffer + i into its codepoint.
               decode_rune_builder: Builder, Int => Rune
               decode_rune_builder = b, i =>
                  decode_rune_addr(&b, i)

               // Polymorphic UAX #31 identifier check for String, Builder, etc.
               is_uax31: #! T: Type, T => <>
               is_uax31 = #! T, target =>
                  n = ?target
                  n == 0 |->
                  p = &target
                  r0 = unicode::decode_rune_addr(p, 0)
                  !unicode::is_id_start(r0) |->
                  i' = ?r0
                  0.. @
                     i' !< n | -->
                     r = unicode::decode_rune_addr(p, i')
                     !unicode::is_id_continue(r) |->
                     i' = i' + ?r
                  <+>

               // Concrete monomorphic aliases
               is_uax31_str: String => <>
               is_uax31_str = s => unicode::is_uax31(s)

               is_uax31_builder: Builder => <>
               is_uax31_builder = b => unicode::is_uax31(b)
            """

         write_file_text("std/unicode.dva", +out)
         io::out $ "Successfully generated std/unicode.dva in Dva!"
         0

main(0)
