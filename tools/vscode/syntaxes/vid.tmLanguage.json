{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vid",
  "scopeName": "source.vid",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#control"
    },
    {
      "include": "#expr_lines"
    },
    {
      "include": "#bindings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#partials"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#reactive_ids"
    },
    {
      "include": "#static_ids"
    },
    {
      "include": "#classes"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#interpolations"
    },
    {
      "include": "#tag_suffix"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vid",
          "match": "//.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.import.vid",
          "match": "^\\s*(#(?:use(?:\\([^)]*\\))?|include))\\s+(\"(?:\\\\.|[^\"])*\"|(?:[^/;\\r\\n]|/(?![/*]))+?)(?=\\s*(?://|;|$))",
          "captures": {
            "1": {
              "name": "keyword.control.directive.vid"
            },
            "2": {
              "name": "string.quoted.other.import.vid"
            }
          }
        },
        {
          "name": "meta.doctype.vid",
          "match": "^\\s*(#?doctype)\\s+(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.vid"
            },
            "2": {
              "name": "constant.language.doctype.vid"
            }
          }
        },
        {
          "name": "meta.directive.vid",
          "begin": "^\\s*(#(?:param|query|route|def|slot))\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.vid"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "source.dva"
            }
          ]
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "meta.cycle.vid",
          "match": "^\\s*(.+?)\\s+(@)(?:\\s+(.+?)\\s+(=>))?\\s*$",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "source.dva"
                }
              ]
            },
            "2": {
              "name": "keyword.control.repeat.vid"
            },
            "3": {
              "patterns": [
                {
                  "include": "source.dva"
                }
              ]
            },
            "4": {
              "name": "keyword.operator.function.vid"
            }
          }
        },
        {
          "name": "meta.choice.vid",
          "match": "^\\s*(?:(.+?)\\s+)?(\\|)\\s*$",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "source.dva"
                }
              ]
            },
            "2": {
              "name": "keyword.control.conditional.vid"
            }
          }
        },
        {
          "name": "meta.guard.vid",
          "match": "^\\s*(\\[)([^\\]\\n]+)(\\])\\s*$",
          "captures": {
            "1": {
              "name": "punctuation.bracket.vid"
            },
            "2": {
              "patterns": [
                {
                  "include": "source.dva"
                }
              ]
            },
            "3": {
              "name": "punctuation.bracket.vid"
            }
          }
        }
      ]
    },
    "expr_lines": {
      "patterns": [
        {
          "name": "meta.expression.line.vid",
          "begin": "^\\s*(!?=)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.assignment.vid"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "source.dva"
            }
          ]
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "name": "meta.binding.vid",
          "begin": "^\\s*([a-zA-Z_][a-zA-Z0-9_']*)\\s+(=)(?!=|>)",
          "beginCaptures": {
            "1": {
              "name": "variable.other.vid"
            },
            "2": {
              "name": "keyword.operator.assignment.vid"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "source.dva"
            }
          ]
        }
      ]
    },
    "partials": {
      "patterns": [
        {
          "name": "entity.name.function.partial.vid",
          "match": "(?:^|(?<=[\\s:]))(\\+[a-zA-Z][a-zA-Z0-9_-]*)"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "entity.name.tag.vid",
          "match": "(?:(?<=^\\s)|^|(?<=:\\s)|(?<=:))([a-zA-Z][a-zA-Z0-9_-]*)(?=$|[\\s\\$\\#\\.\\(\\/:=!])"
        }
      ]
    },
    "reactive_ids": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.id.reactive.vid",
          "match": "\\$[a-zA-Z0-9_-]+"
        }
      ]
    },
    "static_ids": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.id.static.vid",
          "match": "#[a-zA-Z0-9_-]+"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.class.vid",
          "match": "\\.[a-zA-Z0-9_-]+"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute-list.vid",
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.parens.begin.vid"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.vid"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "meta.attribute.id.reactive.vid",
              "begin": "\\b(id)\\s*(=)\\s*(?=\"\\$[^{])",
              "beginCaptures": {
                "1": {
                  "name": "entity.other.attribute-name.vid"
                },
                "2": {
                  "name": "keyword.operator.assignment.vid"
                }
              },
              "end": "(?<=\")",
              "patterns": [
                {
                  "name": "entity.other.attribute-name.id.reactive.vid",
                  "begin": "\"",
                  "end": "\"",
                  "patterns": [
                    {
                      "name": "constant.character.escape.vid",
                      "match": "\\\\."
                    },
                    {
                      "include": "#interpolations"
                    }
                  ]
                }
              ]
            },
            {
              "name": "support.function.event.vid",
              "match": "@[a-zA-Z0-9_:-]+"
            },
            {
              "name": "entity.other.attribute-name.vid",
              "match": "[a-zA-Z_][a-zA-Z0-9_:-]*(?=\\s*[=,\\s\\)]|$)"
            },
            {
              "name": "keyword.operator.assignment.vid",
              "match": "="
            },
            {
              "include": "#strings"
            },
            {
              "name": "meta.attribute.expr.nested.vid",
              "begin": "\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "source.dva"
                }
              ]
            },
            {
              "include": "source.dva"
            }
          ]
        }
      ]
    },
    "tag_suffix": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.vid",
          "match": "!=|="
        },
        {
          "name": "punctuation.separator.vid",
          "match": "[:/\\.]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vid",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vid",
              "match": "\\\\."
            },
            {
              "include": "#interpolations"
            }
          ]
        },
        {
          "name": "string.quoted.single.vid",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vid",
              "match": "\\\\."
            },
            {
              "include": "#interpolations"
            }
          ]
        }
      ]
    },
    "interpolations": {
      "patterns": [
        {
          "name": "meta.interpolation.vid",
          "begin": "[$!#]\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.vid"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.vid"
            }
          },
          "patterns": [
            {
              "include": "source.dva"
            }
          ]
        }
      ]
    }
  }
}