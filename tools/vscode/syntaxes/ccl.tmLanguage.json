{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CCL",
  "scopeName": "source.ccl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#entries"
    },
    {
      "include": "#continuation_values"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.ccl",
          "match": "^\\s*(?:/=|#).*$"
        }
      ]
    },
    "entries": {
      "patterns": [
        {
          "name": "meta.entry.anonymous.ccl",
          "match": "^\\s*(=)(?:\\s+(.*))?$",
          "captures": {
            "1": {
              "name": "keyword.operator.assignment.ccl"
            },
            "2": {
              "name": "string.unquoted.value.ccl"
            }
          }
        },
        {
          "name": "meta.entry.level0.ccl",
          "match": "^(?!\\s*(?:/=|#))([^=\\s\\r\\n][^=\\r\\n]*?)\\s*(=)(?:\\s+(.*))?$",
          "captures": {
            "1": {
              "name": "entity.name.section.key.level0.ccl"
            },
            "2": {
              "name": "keyword.operator.assignment.ccl"
            },
            "3": {
              "name": "string.unquoted.value.ccl"
            }
          }
        },
        {
          "name": "meta.entry.level1.ccl",
          "match": "^[ \\t]{1,3}([^=\\s\\r\\n][^=\\r\\n]*?)\\s*(=)(?:\\s+(.*))?$",
          "captures": {
            "1": {
              "name": "variable.other.property.key.level1.ccl"
            },
            "2": {
              "name": "keyword.operator.assignment.ccl"
            },
            "3": {
              "name": "string.unquoted.value.ccl"
            }
          }
        },
        {
          "name": "meta.entry.level2.ccl",
          "match": "^[ \\t]{4,5}([^=\\s\\r\\n][^=\\r\\n]*?)\\s*(=)(?:\\s+(.*))?$",
          "captures": {
            "1": {
              "name": "support.type.property-name.key.level2.ccl"
            },
            "2": {
              "name": "keyword.operator.assignment.ccl"
            },
            "3": {
              "name": "string.unquoted.value.ccl"
            }
          }
        },
        {
          "name": "meta.entry.level3.ccl",
          "match": "^[ \\t]{6,}([^=\\s\\r\\n][^=\\r\\n]*?)\\s*(=)(?:\\s+(.*))?$",
          "captures": {
            "1": {
              "name": "constant.other.key.level3.ccl"
            },
            "2": {
              "name": "keyword.operator.assignment.ccl"
            },
            "3": {
              "name": "string.unquoted.value.ccl"
            }
          }
        }
      ]
    },
    "continuation_values": {
      "patterns": [
        {
          "name": "string.unquoted.value.ccl",
          "match": "^\\s*\\S.*$"
        }
      ]
    }
  }
}