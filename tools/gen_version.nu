#!/usr/bin/env nu
# tools/gen_version.nu — generates src/version.dva from VERSION and git commit hash

def root [] {
    $env.FILE_PWD | path dirname
}

def main [] {
    let repo_root = (root)
    let version_file = ($repo_root | path join "VERSION")
    let base_version = if ($version_file | path exists) {
        open --raw $version_file | str trim
    } else {
        "1.0.0"
    }

    let commit = try {
        cd $repo_root
        git rev-parse --short HEAD | str trim
    } catch {
        "unknown"
    }

    let is_dirty = try {
        cd $repo_root
        let s = (do { git status --porcelain -uno -- ':!src/version.dva' ':!seed/' } | complete)
        if $s.exit_code == 0 {
            ($s.stdout | str trim) != ""
        } else {
            false
        }
    } catch {
        false
    }

    let commit_str = if $is_dirty and $commit != "unknown" {
        $"($commit)-dirty"
    } else {
        $commit
    }

    let version = if $commit_str != "" and $commit_str != "unknown" {
        $"($base_version)+($commit_str)"
    } else {
        $base_version
    }

    let target = ($repo_root | path join "src/version.dva")
    let content = $"// src/version.dva — generated by tools/gen_version.nu \(do not edit manually\)\n#public\n   VERSION = \"($version)\"\n   COMMIT_HASH = \"($commit_str)\"\n"

    let existing = if ($target | path exists) {
        open --raw $target
    } else {
        ""
    }

    if $existing != $content {
        $content | save --raw -f $target
        print $"Generated ($target): version=($version), commit=($commit_str)"
    }
}
