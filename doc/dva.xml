<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<language name="Dva" version="1" kateversion="5.0" section="Sources" extensions="*.dva" mimetype="text/x-dva" author="baldgeorge" license="BSD-2-Clause">
  <highlighting>
    <list name="directives">
      <item>#use</item>
      <item>#type</item>
      <item>#foreign</item>
      <item>#pragma</item>
      <item>#public</item>
      <item>#pub</item>
      <item>#private</item>
      <item>#export</item>
      <item>#spawn</item>
      <item>#join</item>
      <item>#!</item>
      <item>#size</item>
    </list>
    <list name="types">
      <item>Int</item>
      <item>Float</item>
      <item>String</item>
      <item>Address</item>
      <item>Rune</item>
      <item>Builder</item>
      <item>Error</item>
      <item>Type</item>
      <item>i1</item>
      <item>i8</item>
      <item>i16</item>
      <item>i32</item>
      <item>i64</item>
      <item>u8</item>
      <item>u16</item>
      <item>u32</item>
      <item>u64</item>
      <item>f32</item>
      <item>f64</item>
      <item>float</item>
      <item>double</item>
      <item>void</item>
      <item>ptr</item>
    </list>
    <list name="constants">
      <item>&lt;+&gt;</item>
      <item>&lt;-&gt;</item>
      <item>&lt;++&gt;</item>
      <item>&lt;--&gt;</item>
      <item>&lt;&gt;</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="LineComment" char="/" char1="/" />
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="*" beginRegion="BlockComment" />
        <StringDetect attribute="String" context="TripleString" String="&quot;&quot;&quot;" />
        <DetectChar attribute="String" context="String" char="&quot;" />
        <!-- Mutables: foo', x', total'' (highlighted in reddish) -->
        <RegExpr attribute="Mutable" context="#stay" String="\b[a-zA-Z_][a-zA-Z0-9_]*'+" />
        <!-- Runes: 'a', '\n', '\'', '\x1b', 'λ' -->
        <RegExpr attribute="Char" context="#stay" String="'(\\([xX][0-9a-fA-F]+|[uU][0-9a-fA-F]+|.)|[^'\\\n])'" />
        <keyword attribute="Directive" context="#stay" String="directives" />
        <keyword attribute="Type" context="#stay" String="types" />

        <!-- Ramification sugared returns: |->, |+>, |==>, |++> (matched before choice | and ||) -->
        <StringDetect attribute="Constant" context="#stay" String="|++&gt;" />
        <StringDetect attribute="Constant" context="#stay" String="|--&gt;" />
        <StringDetect attribute="Constant" context="#stay" String="|+&gt;" />
        <StringDetect attribute="Constant" context="#stay" String="|-&gt;" />

        <!-- Ramification unit constants: <+>, <->, <++>, <--> -->
        <StringDetect attribute="Constant" context="#stay" String="&lt;++&gt;" />
        <StringDetect attribute="Constant" context="#stay" String="&lt;--&gt;" />
        <StringDetect attribute="Constant" context="#stay" String="&lt;+&gt;" />
        <StringDetect attribute="Constant" context="#stay" String="&lt;-&gt;" />

        <!-- Built-in Flag / Unit ramification type: <> -->
        <StringDetect attribute="Type" context="#stay" String="&lt;&gt;" />

        <!-- Branching and jumps: cycle breaks, continues, escapes, returns (matched before arrow delimiter) -->
        <RegExpr attribute="Control" context="#stay" String="--[&gt;^][0-9]*" />
        <StringDetect attribute="Control" context="#stay" String="&gt;--" />
        <StringDetect attribute="Control" context="#stay" String="--:" />
        <StringDetect attribute="Control" context="#stay" String="--|" />
        <StringDetect attribute="Control" context="#stay" String="@@" />
        <DetectChar attribute="Control" context="#stay" char="@" />

        <!-- Ramification payload delimiters: <+, +>, <-, -> -->
        <StringDetect attribute="Constant" context="#stay" String="&lt;+" />
        <StringDetect attribute="Constant" context="#stay" String="+&gt;" />
        <StringDetect attribute="Constant" context="#stay" String="&lt;-" />
        <StringDetect attribute="Constant" context="#stay" String="-&gt;" />

        <!-- Branching: logical OR || before choice branch |, choice abort !|, and brackets [ ] -->
        <StringDetect attribute="Operator" context="#stay" String="||" />
        <StringDetect attribute="Control" context="#stay" String="!|" />
        <DetectChar attribute="Control" context="#stay" char="|" />
        <DetectChar attribute="Control" context="#stay" char="[" />
        <DetectChar attribute="Control" context="#stay" char="]" />
        <StringDetect attribute="Operator" context="#stay" String="!!" />
        <StringDetect attribute="Operator" context="#stay" String="--!" />
        <StringDetect attribute="Operator" context="#stay" String="=&gt;" />
        <StringDetect attribute="Operator" context="#stay" String="::=" />
        <StringDetect attribute="Operator" context="#stay" String=":=" />
        <StringDetect attribute="Operator" context="#stay" String="+=" />
        <StringDetect attribute="Operator" context="#stay" String="::" />
        <StringDetect attribute="Operator" context="#stay" String=".." />
        <StringDetect attribute="Operator" context="#stay" String="$&gt;&gt;" />
        <StringDetect attribute="Operator" context="#stay" String="$&gt;" />
        <DetectChar attribute="Operator" context="#stay" char="$" />
        <StringDetect attribute="Operator" context="#stay" String="&amp;&amp;" />
        <StringDetect attribute="Operator" context="#stay" String="||" />
        <StringDetect attribute="Operator" context="#stay" String="==" />
        <StringDetect attribute="Operator" context="#stay" String="!=" />
        <StringDetect attribute="Operator" context="#stay" String="!&lt;" />
        <StringDetect attribute="Operator" context="#stay" String="!&gt;" />
        <StringDetect attribute="Operator" context="#stay" String=".&lt;." />
        <StringDetect attribute="Operator" context="#stay" String=".&gt;." />
        <StringDetect attribute="Operator" context="#stay" String=".|." />
        <StringDetect attribute="Operator" context="#stay" String=".^." />
        <StringDetect attribute="Operator" context="#stay" String=".&amp;." />
        <StringDetect attribute="Operator" context="#stay" String=".!." />
        <StringDetect attribute="Operator" context="#stay" String="++" />
        <StringDetect attribute="Operator" context="#stay" String="~~" />
        <StringDetect attribute="Operator" context="#stay" String="??" />
        <DetectChar attribute="Operator" context="#stay" char="?" />
        <DetectChar attribute="Operator" context="#stay" char="&amp;" />
        <DetectChar attribute="Operator" context="#stay" char="+" />
        <DetectChar attribute="Operator" context="#stay" char="-" />
        <DetectChar attribute="Operator" context="#stay" char="*" />
        <DetectChar attribute="Operator" context="#stay" char="/" />
        <DetectChar attribute="Operator" context="#stay" char="%" />
        <DetectChar attribute="Operator" context="#stay" char="=" />
        <DetectChar attribute="Operator" context="#stay" char="!" />
        <DetectChar attribute="Operator" context="#stay" char="&lt;" />
        <DetectChar attribute="Operator" context="#stay" char="&gt;" />
        <DetectChar attribute="Operator" context="#stay" char="^" />
        <RegExpr attribute="Float" context="#stay" String="-?[0-9]+\.[0-9]+([eE][-+]?[0-9]+)?(f32|f|F)?" />
        <RegExpr attribute="Hex" context="#stay" String="0x[0-9a-fA-F]+(i8|i16|i32|i64|u8|u16|u32|u64)?" />
        <RegExpr attribute="Octal" context="#stay" String="0o[0-7]+(i8|i16|i32|i64|u8|u16|u32|u64)?" />
        <RegExpr attribute="Binary" context="#stay" String="0b[01]+(i8|i16|i32|i64|u8|u16|u32|u64)?" />
        <RegExpr attribute="Decimal" context="#stay" String="-?[0-9]+(i8|i16|i32|i64|u8|u16|u32|u64)?" />
      </context>
      <context name="LineComment" attribute="Comment" lineEndContext="#pop" />
      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/" endRegion="BlockComment" />
      </context>
      <context name="TripleString" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="Special" context="#stay" char="\" />
        <Detect2Chars attribute="Special" context="Interpolation" char="$" char1="{" />
        <StringDetect attribute="String" context="#pop" String="&quot;&quot;&quot;" />
      </context>
      <context name="String" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="Special" context="#stay" char="\" />
        <Detect2Chars attribute="Special" context="Interpolation" char="$" char1="{" />
        <DetectChar attribute="String" context="#pop" char="&quot;" />
      </context>
      <context name="Interpolation" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar attribute="Special" context="#pop" char="}" />
        <IncludeRules context="Normal" />
      </context>
      <context name="Char" attribute="Char" lineEndContext="#stay">
        <DetectChar attribute="Special" context="#stay" char="\" />
        <DetectChar attribute="Char" context="#pop" char="'" />
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal" />
      <itemData name="Directive" defStyleNum="dsKeyword" />
      <itemData name="Type" defStyleNum="dsDataType" />
      <itemData name="Mutable" defStyleNum="dsVariable" color="#c93b2b" selColor="#ffffff" bold="0" italic="0" />
      <itemData name="Constant" defStyleNum="dsConstant" color="#d97706" selColor="#ffffff" bold="1" italic="0" />
      <itemData name="Control" defStyleNum="dsControlFlow" />
      <itemData name="Operator" defStyleNum="dsOperator" />
      <itemData name="Special" defStyleNum="dsSpecialChar" />
      <itemData name="Comment" defStyleNum="dsComment" />
      <itemData name="String" defStyleNum="dsString" />
      <itemData name="Char" defStyleNum="dsChar" />
      <itemData name="Decimal" defStyleNum="dsDecVal" />
      <itemData name="Hex" defStyleNum="dsBaseN" />
      <itemData name="Octal" defStyleNum="dsBaseN" />
      <itemData name="Binary" defStyleNum="dsBaseN" />
      <itemData name="Float" defStyleNum="dsFloat" />
    </itemDatas>
  </highlighting>
</language>
