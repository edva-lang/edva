choice.then:                                      ; preds = %entry
  %ram.pay = extractvalue { i1, i64 } %var.load2, 1
  %pay.ptr = inttoptr i64 %ram.pay to ptr
  store ptr %pay.ptr, ptr %var._, align 8
  store ptr %pay.ptr, ptr %var.re, align 8
  %var.load3 = load ptr, ptr %var.p, align 8
  %var.load4 = load ptr, ptr %var.re, align 8
  %call.res5 = call { i1, i64 } @"parser::choice_cont"(ptr %var.load3, ptr %var.load4)
  br label %choice.exit

choice.else:                                      ; preds = %entry
  br label %choice.exit

choice.exit:                                      ; preds = %choice.else, %choice.then
  %choice.res = phi { i1, i64 } [ %call.res5, %choice.then ], [ zeroinitializer, %choice.else ]
  ret { i1, i64 } %choice.res
}

