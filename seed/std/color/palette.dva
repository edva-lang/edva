// std/color/palette.dva — Standard cohesive color palette presets for UI and syntax
//
// A Palette provides 5 neutrals (background to foreground hierarchy) and 7 accents
// (the standard spectrum: red, orange, yellow, green, cyan, blue, purple).
// Every popular theme maps naturally to these 12 foundation slots.

#public
   #type Palette (
      // Neutrals (UI surfaces & text hierarchy)
      bg: Int,
      surface: Int,
      border: Int,
      muted: Int,
      fg: Int,

      // Accents (Syntax tokens, status badges & indicators)
      red: Int,
      orange: Int,
      yellow: Int,
      green: Int,
      cyan: Int,
      blue: Int,
      purple: Int
   )

   // --- Popular Presets ---

   // Catppuccin (Mocha)
   CATPPUCCIN = Palette(
      0x1e1e2e, 0x313244, 0x45475a, 0x6c7086, 0xcdd6f4,
      0xf38ba8, 0xfab387, 0xf9e2af, 0xa6e3a1, 0x94e2d5, 0x89b4fa, 0xcba6f7
   )

   // Monokai
   MONOKAI = Palette(
