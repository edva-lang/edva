// Standard CLI Argument Parsing Module (std/cli.dva)
// Declarative command-line specification for flags/options (cli::opt),
// positional arguments (cli::pos), and recursive subcommands (cli::cmd),
// with automatic -h/--help and --no-<flag> handling, custom validator lambdas,
// and typed value extraction.

#use sys
#use str
#use io

#public

#type Args String{}
#type ArgsList Args{}
#type OptKind < KFlag, KInt, KFloat, KStr, KStrList >
#type OptRole < ROpt, RPos, RCmd >
#type FlagValidator (<> => < | String >)
#type IntValidator (Int => < | String >)
#type FloatValidator (Float => < | String >)
#type StrValidator (String => < | String >)

#type Opts Opt{}
#type SubOpts < SubNone, SubCmd(Opts) >

#type Opt (
   short: String,
   long: String,
   kind: OptKind,
   role: OptRole,
   required: <>,
   def_flag: <>,
   def_int: Int,
   def_float: Float,
   def_str: String,
   desc: String,
   val_flag: FlagValidator,
   val_int: IntValidator,
   val_float: FloatValidator,
   val_str: StrValidator,
   aliases: Args,
   sub_opts: SubOpts
)

#type BoolList <>{}
#type IntList Int{}
#type FloatList Float{}
#type SubParsed < NoSub, HasSub(Parsed) >

#type Parsed (
   opts: Opts,
   seen: BoolList,
   flags: BoolList,
   ints: IntList,
   floats: FloatList,
   strs: Args,
   str_lists: ArgsList,
   args: Args,
   passthrough: Args,
   subcmd: String,
   sub: SubParsed,
   help: <>,
   version: <>
)

ok_flag: <> => < | String >
ok_flag = v => <++>

ok_int: Int => < | String >
ok_int = v => <++>

ok_float: Float => < | String >
ok_float = v => <++>

ok_str: String => < | String >
ok_str = v => <++>

#private

prog_basename: String => String
prog_basename = p =>
   str::split_once(p, " ")
      | sp =>
         base = str::rfind(sp.0, "/")
            | idx => sp.0(idx + 1..?sp.0)
            | sp.0
         base + " " + sp.1
      |
         str::rfind(p, "/")
            | idx => p(idx + 1..?p)
            | p

split_spec: String => (String, String)
split_spec = spec =>
   str::split_once(spec, ":")
      | pair => (pair.0, pair.1)
      | ("", spec)

split_cmd_spec: String => (String, Args)
split_cmd_spec = spec =>
   parts = str::split(spec, "|")
   ?parts == 0
      | ("", Args())
      |
         primary = parts(0)!!
         aliases = Args()
         1..?parts @ i =>
            a = parts(i)!!
            a != "" | aliases += a
         (primary, aliases)

#public

make_flag_opt: String, <>, String, FlagValidator => Opt
make_flag_opt = spec, def_v, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KFlag), OptRole(ROpt), <->, def_v, 0, 0.0, "", desc, vf, ok_int, ok_float, ok_str, Args(), SubOpts(SubNone))

make_flag_opt_def: String, <>, String => Opt
make_flag_opt_def = spec, def_v, desc =>
   make_flag_opt(spec, def_v, desc, ok_flag)

make_int_opt: String, Int, String, IntValidator => Opt
make_int_opt = spec, def_v, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KInt), OptRole(ROpt), <->, <->, def_v, 0.0, "", desc, ok_flag, vf, ok_float, ok_str, Args(), SubOpts(SubNone))

make_int_opt_def: String, Int, String => Opt
make_int_opt_def = spec, def_v, desc =>
   make_int_opt(spec, def_v, desc, ok_int)

make_float_opt: String, Float, String, FloatValidator => Opt
make_float_opt = spec, def_v, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KFloat), OptRole(ROpt), <->, <->, 0, def_v, "", desc, ok_flag, ok_int, vf, ok_str, Args(), SubOpts(SubNone))

make_float_opt_def: String, Float, String => Opt
make_float_opt_def = spec, def_v, desc =>
   make_float_opt(spec, def_v, desc, ok_float)

make_str_opt: String, String, String, StrValidator => Opt
make_str_opt = spec, def_v, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KStr), OptRole(ROpt), <->, <->, 0, 0.0, def_v, desc, ok_flag, ok_int, ok_float, vf, Args(), SubOpts(SubNone))

make_str_opt_def: String, String, String => Opt
make_str_opt_def = spec, def_v, desc =>
   make_str_opt(spec, def_v, desc, ok_str)

make_str_list_opt: String, String, StrValidator => Opt
make_str_list_opt = spec, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KStrList), OptRole(ROpt), <->, <->, 0, 0.0, "", desc, ok_flag, ok_int, ok_float, vf, Args(), SubOpts(SubNone))

make_str_list_opt_def: String, String => Opt
make_str_list_opt_def = spec, desc =>
   make_str_list_opt(spec, desc, ok_str)

make_req_opt: String, Type, String => Opt
make_req_opt = spec, ty, desc =>
   sp = split_spec(spec)
   kind = ty == Int
      | OptKind(KInt)
      | (ty == Float | OptKind(KFloat) | (ty == String | OptKind(KStr) | OptKind(KFlag)))
   req = kind ![KFlag]
   Opt(sp.0, sp.1, kind, OptRole(ROpt), req, <->, 0, 0.0, "", desc, ok_flag, ok_int, ok_float, ok_str, Args(), SubOpts(SubNone))

make_req_int_opt: String, String, IntValidator => Opt
make_req_int_opt = spec, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KInt), OptRole(ROpt), <+>, <->, 0, 0.0, "", desc, ok_flag, vf, ok_float, ok_str, Args(), SubOpts(SubNone))

make_req_float_opt: String, String, FloatValidator => Opt
make_req_float_opt = spec, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KFloat), OptRole(ROpt), <+>, <->, 0, 0.0, "", desc, ok_flag, ok_int, vf, ok_str, Args(), SubOpts(SubNone))

make_req_str_opt: String, String, StrValidator => Opt
make_req_str_opt = spec, desc, vf =>
   sp = split_spec(spec)
   Opt(sp.0, sp.1, OptKind(KStr), OptRole(ROpt), <+>, <->, 0, 0.0, "", desc, ok_flag, ok_int, ok_float, vf, Args(), SubOpts(SubNone))

as_pos_opt: Opt => Opt
as_pos_opt = o =>
   has_dots = str::ends_with(o.long, "...") && ?o.long > 3
   clean_name = has_dots | o.long(0..?o.long - 3) | o.long
   eff_kind = has_dots | OptKind(KStrList) | o.kind
   Opt("", clean_name, eff_kind, OptRole(RPos), o.required, o.def_flag, o.def_int, o.def_float, o.def_str, o.desc, o.val_flag, o.val_int, o.val_float, o.val_str, Args(), SubOpts(SubNone))

make_cmd_opt: String, String, Opts => Opt
make_cmd_opt = spec, desc, sub_opts =>
   sp = split_cmd_spec(spec)
   Opt("", sp.0, OptKind(KFlag), OptRole(RCmd), <->, <->, 0, 0.0, "", desc, ok_flag, ok_int, ok_float, ok_str, sp.1, SubOpts(SubCmd, sub_opts))

#private

has_required_opt: Opts => <>
has_required_opt = opts =>
   req' = <->
   ?opts @ i =>
      o = opts(i)!!
      (o.role [ROpt, RPos]) && o.required
         |
            req' = <+>
            -->
   req'

find_opt_idx: Opts, String => Int
find_opt_idx = opts, key =>
   res' = -1
   ?opts @ i =>
      o = opts(i)!!
      (o.role [ROpt, RPos]) && ((o.long != "" && o.long == key) || (o.short != "" && o.short == key))
         |
            res' = i
            -->
   res'

find_long_idx: Opts, String => Int
find_long_idx = opts, name =>
   res' = -1
   ?opts @ i =>
      o = opts(i)!!
      (o.role [ROpt]) && o.long != "" && o.long == name
         |
            res' = i
            -->
   res'

find_short_idx: Opts, String => Int
find_short_idx = opts, sname =>
   res' = -1
   ?opts @ i =>
      o = opts(i)!!
      (o.role [ROpt]) && o.short != "" && o.short == sname
         |
            res' = i
            -->
   res'

find_cmd_idx: Opts, String => Int
find_cmd_idx = opts, name =>
   res' = -1
   ?opts @ i =>
      o = opts(i)!!
      o.role [RCmd]
         |
            o.long == name
               |
                  res' = i
                  -->
               |
                  matched' = <->
                  ?o.aliases @ k =>
                     o.aliases(k)!! == name
                        |
                           matched' = <+>
                           -->
                  matched'
                     |
                        res' = i
                        -->
   res'

has_opt_named: Opts, String, String => <>
has_opt_named = opts, long_name, short_name =>
   find_long_idx(opts, long_name) !< 0 || find_short_idx(opts, short_name) !< 0

pos_token: Opt => String
pos_token = o =>
   dots = o.kind [KStrList] "..." | ""
   o.required
      | "<" + o.long + dots + ">"
      | "[" + o.long + dots + "]"

cmd_left_col: Opt => String
cmd_left_col = o =>
   b = {64}
   b += "  " + o.long
   ?o.aliases @ k =>
      b += ", " + o.aliases(k)!!
   +b

opt_left_col: Opt => String
opt_left_col = o =>
   sp = o.short != "" | "-" + o.short + ", " | "    "
   lp = o.long != "" | "--" + o.long | ""
   tp = o.kind
      [KFlag] ""
      [KInt] " <int>"
      [KFloat] " <float>"
      [KStr, KStrList] " <str>"
   "  " + sp + lp + tp

opt_right_col: Opt => String
opt_right_col = o =>
   suffix = o.required
      | " (required)"
      |
         o.kind
            [KFlag]
               o.def_flag
                  | " (default: true; --no-" + o.long + " to disable)"
                  | ""
            [KInt] " (default: " + str::from_int(o.def_int) + ")"
            [KFloat] " (default: " + str::from_float(o.def_float) + ")"
            [KStr]
               o.def_str != ""
                  | " (default: " + o.def_str + ")"
                  | ""
            [KStrList]
               o.role [RPos] "" | " (repeatable)"
   o.desc + suffix

run_flag_val: FlagValidator, <> => String
run_flag_val = vf, v =>
   vf(v)
      | ""
      | err => err

run_int_val: IntValidator, Int => String
run_int_val = vf, v =>
   vf(v)
      | ""
      | err => err

run_float_val: FloatValidator, Float => String
run_float_val = vf, v =>
   vf(v)
      | ""
      | err => err

run_str_val: StrValidator, String => String
run_str_val = vf, v =>
   vf(v)
      | ""
      | err => err

opt_err_label: Opt => String
opt_err_label = o =>
   o.role [RPos]
      | "<" + o.long + ">"
      | (o.long != "" | "--" + o.long | "-" + o.short)

apply_opt_val: Opt, Int, String, BoolList, IntList, FloatList, Args, ArgsList => String
apply_opt_val = o, idx, val, flags, ints, floats, strs, str_lists =>
   lbl = opt_err_label(o)
   o.kind
      [KFlag]
         val == "true" || val == "1" || val == "yes"
            |
               v_err = run_flag_val(o.val_flag, <+>)
               v_err != ""
                  | v_err
                  |
                     flags(idx) = <+> !| _
                     ""
            |
               val == "false" || val == "0" || val == "no"
                  |
                     v_err = run_flag_val(o.val_flag, <->)
                     v_err != ""
                        | v_err
                        |
                           flags(idx) = <-> !| _
                           ""
                  | "invalid boolean value for " + lbl + ": " + val
      [KInt]
         str::parse_int(val)
            | v =>
               v_err = run_int_val(o.val_int, v)
               v_err != ""
                  | v_err
                  |
                     ints(idx) = v !| _
                     ""
            | "invalid integer for " + lbl + ": " + val
      [KFloat]
         str::parse_float(val)
            | v =>
               v_err = run_float_val(o.val_float, v)
               v_err != ""
                  | v_err
                  |
                     floats(idx) = v !| _
                     ""
            | "invalid float for " + lbl + ": " + val
      [KStr]
         v_err = run_str_val(o.val_str, val)
         v_err != ""
            | v_err
            |
               strs(idx) = val !| _
               ""
      [KStrList]
         v_err = run_str_val(o.val_str, val)
         v_err != ""
            | v_err
            |
               cur_list = str_lists(idx)!!
               cur_list += val
               str_lists(idx) = cur_list !| _
               strs(idx) = val !| _
               ""

parse_argv: Opts, Args, <> => < Parsed | String >
parse_argv = opts, argv, allow_auto_version =>
   n_opts = ?opts
   seen = BoolList()
   flags = BoolList()
   ints = IntList()
   floats = FloatList()
   strs = Args()
   str_lists = ArgsList()
   pos_indices = IntList()
   has_cmds' = <->
   n_opts @ k =>
      o = opts(k)!!
      seen += <->
      flags += o.def_flag
      ints += o.def_int
      floats += o.def_float
      strs += o.def_str
      str_lists += Args()
      o.role [RPos] | (pos_indices += k)
      o.role [RCmd] | (has_cmds' = <+>)

   pos_list = Args()
   pass_list = Args()
   subcmd_name' = ++""
   sub_val' = SubParsed(NoSub)
   pos_cursor' = 0
   help_req' = <->
   ver_req' = <->
   err' = ++""
   after_sep' = <->
   n = ?argv
   i' = 0
   i' < n @
      cur_arg = argv(i')!!
      after_sep'
         |
            pass_list += cur_arg
            (?pos_indices == 0 && !has_cmds') | (pos_list += cur_arg)
            i' = i' + 1
         |
            cur_arg == "--"
               |
                  after_sep' = <+>
                  i' = i' + 1
               |
                  str::starts_with(cur_arg, "--")
                     |
                        rem_str = cur_arg(2..?cur_arg)
                        eq_opt = str::split_once(rem_str, "=")
                        eq_opt
                           | pair =>
                              lname = pair.0
                              val = pair.1
                              idx = find_long_idx(opts, lname)
                              idx < 0
                                 |
                                    err' = "unknown option: --" + lname
                                    -->
                                 |
                                    o = opts(idx)!!
                                    e_msg = apply_opt_val(o, idx, val, flags, ints, floats, strs, str_lists)
                                    e_msg != ""
                                       |
                                          err' = e_msg
                                          -->
                                       |
                                          seen(idx) = <+> !| _
                                          i' = i' + 1
                           |
                              idx = find_long_idx(opts, rem_str)
                              idx !< 0
                                 |
                                    o = opts(idx)!!
                                    o.kind
                                       [KFlag]
                                          v_err = run_flag_val(o.val_flag, <+>)
                                          v_err != ""
                                             |
                                                err' = v_err
                                                -->
                                             |
                                                flags(idx) = <+> !| _
                                                seen(idx) = <+> !| _
                                                o.long == "help" | (help_req' = <+>)
                                                o.long == "version" | (ver_req' = <+>)
                                                i' = i' + 1
                                       |
                                          i' + 1 !< n
                                             |
                                                err' = "option requires an argument: --" + rem_str
                                                -->
                                             |
                                                val = argv(i' + 1)!!
                                                e_msg = apply_opt_val(o, idx, val, flags, ints, floats, strs, str_lists)
                                                e_msg != ""
                                                   |
                                                      err' = e_msg
                                                      -->
                                                   |
                                                      seen(idx) = <+> !| _
                                                      i' = i' + 2
                                 |
                                    str::starts_with(rem_str, "no-")
                                       |
                                          neg_name = rem_str(3..?rem_str)
                                          neg_idx = find_long_idx(opts, neg_name)
                                          neg_idx !< 0 && (opts(neg_idx)!!.kind [KFlag])
                                             |
                                                no_o = opts(neg_idx)!!
                                                v_err = run_flag_val(no_o.val_flag, <->)
                                                v_err != ""
                                                   |
                                                      err' = v_err
                                                      -->
                                                   |
                                                      flags(neg_idx) = <-> !| _
                                                      seen(neg_idx) = <+> !| _
                                                      i' = i' + 1
                                             |
                                                err' = "unknown option: " + cur_arg
                                                -->
                                       |
                                          rem_str == "help"
                                             |
                                                help_req' = <+>
                                                i' = i' + 1
                                             |
                                                rem_str == "version" && allow_auto_version
                                                   |
                                                      ver_req' = <+>
                                                      i' = i' + 1
                                                   |
                                                      err' = "unknown option: " + cur_arg
                                                      -->
                     |
                        ?cur_arg > 1 && cur_arg(0) == '-'
                           |
                              rem_str = cur_arg(1..?cur_arg)
                              has_eq = ?rem_str > 1 && rem_str(1) == '='
                              has_eq
                                 |
                                    sname = rem_str(0..1)
                                    val = rem_str(2..?rem_str)
                                    idx = find_short_idx(opts, sname)
                                    idx < 0
                                       |
                                          err' = "unknown option: -" + sname
                                          -->
                                       |
                                          o = opts(idx)!!
                                          e_msg = apply_opt_val(o, idx, val, flags, ints, floats, strs, str_lists)
                                          e_msg != ""
                                             |
                                                err' = e_msg
                                                -->
                                             |
                                                seen(idx) = <+> !| _
                                                i' = i' + 1
                                 |
                                    ?rem_str == 1
                                       |
                                          sname = rem_str
                                          idx = find_short_idx(opts, sname)
                                          idx !< 0
                                             |
                                                o = opts(idx)!!
                                                o.kind
                                                   [KFlag]
                                                      v_err = run_flag_val(o.val_flag, <+>)
                                                      v_err != ""
                                                         |
                                                            err' = v_err
                                                            -->
                                                         |
                                                            flags(idx) = <+> !| _
                                                            seen(idx) = <+> !| _
                                                            (o.short == "h" || o.long == "help") | (help_req' = <+>)
                                                            (o.short == "v" || o.long == "version") | (ver_req' = <+>)
                                                            i' = i' + 1
                                                   |
                                                      i' + 1 !< n
                                                         |
                                                            err' = "option requires an argument: -" + sname
                                                            -->
                                                         |
                                                            val = argv(i' + 1)!!
                                                            e_msg = apply_opt_val(o, idx, val, flags, ints, floats, strs, str_lists)
                                                            e_msg != ""
                                                               |
                                                                  err' = e_msg
                                                                  -->
                                                               |
                                                                  seen(idx) = <+> !| _
                                                                  i' = i' + 2
                                             |
                                                sname == "h"
                                                   |
                                                      help_req' = <+>
                                                      i' = i' + 1
                                                   |
                                                      sname == "v" && allow_auto_version
                                                         |
                                                            ver_req' = <+>
                                                            i' = i' + 1
                                                         |
                                                            err' = "unknown option: " + cur_arg
                                                            -->
                                       |
                                          l_idx = find_long_idx(opts, rem_str)
                                          l_idx !< 0
                                             |
                                                o = opts(l_idx)!!
                                                o.kind
                                                   [KFlag]
                                                      v_err = run_flag_val(o.val_flag, <+>)
                                                      v_err != ""
                                                         |
                                                            err' = v_err
                                                            -->
                                                         |
                                                            flags(l_idx) = <+> !| _
                                                            seen(l_idx) = <+> !| _
                                                            o.long == "help" | (help_req' = <+>)
                                                            o.long == "version" | (ver_req' = <+>)
                                                            i' = i' + 1
                                                   |
                                                      i' + 1 !< n
                                                         |
                                                            err' = "option requires an argument: -" + rem_str
                                                            -->
                                                         |
                                                            val = argv(i' + 1)!!
                                                            e_msg = apply_opt_val(o, l_idx, val, flags, ints, floats, strs, str_lists)
                                                            e_msg != ""
                                                               |
                                                                  err' = e_msg
                                                                  -->
                                                               |
                                                                  seen(l_idx) = <+> !| _
                                                                  i' = i' + 2
                                             |
                                                s_head = rem_str(0..1)
                                                s_val = rem_str(1..?rem_str)
                                                s_idx = find_short_idx(opts, s_head)
                                                s_idx !< 0 && !(opts(s_idx)!!.kind [KFlag])
                                                   |
                                                      o = opts(s_idx)!!
                                                      e_msg = apply_opt_val(o, s_idx, s_val, flags, ints, floats, strs, str_lists)
                                                      e_msg != ""
                                                         |
                                                            err' = e_msg
                                                            -->
                                                         |
                                                            seen(s_idx) = <+> !| _
                                                            i' = i' + 1
                                                   |
                                                      err' = "unknown option: " + cur_arg
                                                      -->
                           |
                              cmd_idx = (?pos_list == 0) | find_cmd_idx(opts, cur_arg) | -1
                              cmd_idx !< 0
                                 |
                                    cmd_o = opts(cmd_idx)!!
                                    subcmd_name' = cmd_o.long
                                    rem_argv = Args()
                                    (i' + 1)..n @ r_idx =>
                                       rem_argv += argv(r_idx)!!
                                    child_opts = cmd_o.sub_opts
                                       [SubCmd so] so
                                       | Opts()
                                    sub_res = parse_argv(child_opts, rem_argv, <->)
                                    sub_res
                                       | sub_p =>
                                          sub_val' = SubParsed(HasSub, sub_p)
                                          sub_p.help | (help_req' = <+>)
                                          i' = n
                                       | sub_err =>
                                          err' = sub_err
                                          -->
                                 |
                                    ?pos_indices > 0
                                       |
                                          pos_cursor' < ?pos_indices
                                             |
                                                p_idx = pos_indices(pos_cursor')!!
                                                p_o = opts(p_idx)!!
                                                e_msg = apply_opt_val(p_o, p_idx, cur_arg, flags, ints, floats, strs, str_lists)
                                                e_msg != ""
                                                   |
                                                      err' = e_msg
                                                      -->
                                                   |
                                                      seen(p_idx) = <+> !| _
                                                      pos_list += cur_arg
                                                      !(p_o.kind [KStrList]) | (pos_cursor' = pos_cursor' + 1)
                                                      i' = i' + 1
                                             |
                                                err' = "unexpected argument: " + cur_arg
                                                -->
                                       |
                                          has_cmds'
                                             |
                                                err' = "unknown command: " + cur_arg
                                                -->
                                             |
                                                pos_list += cur_arg
                                                i' = i' + 1

   help_req' || ver_req'
      | <+ Parsed(opts, seen, flags, ints, floats, strs, str_lists, pos_list, pass_list, subcmd_name', sub_val', help_req', ver_req') ->
      |
         err' != ""
            | <- err' +>
            |
               subcmd_name' != ""
                  | <+ Parsed(opts, seen, flags, ints, floats, strs, str_lists, pos_list, pass_list, subcmd_name', sub_val', help_req', ver_req') ->
                  |
                     req_err' = ++""
                     n_opts @ m =>
                        o = opts(m)!!
                        o.required && !(seen(m)!!)
                           |
                              is_p = o.role [RPos]
                              req_err' = is_p
                                 | "missing required argument: <" + o.long + ">"
                                 | "missing required option: --" + o.long
                              -->
                     req_err' != ""
                        | <- req_err' +>
                        | <+ Parsed(opts, seen, flags, ints, floats, strs, str_lists, pos_list, pass_list, subcmd_name', sub_val', help_req', ver_req') ->

format_active_help: Parsed, String, String, String => String
format_active_help = p, prog, desc, version =>
   p.sub
      [HasSub sub_p]
         c_idx = find_cmd_idx(p.opts, p.subcmd)
         c_desc = c_idx !< 0 | p.opts(c_idx)!!.desc | ""
         base_prog = prog_basename(prog)
         sub_prog = (base_prog != "" | base_prog | "program") + " " + p.subcmd
         format_active_help(sub_p, sub_prog, c_desc, "")
      | format_help(p.opts, prog, desc, version)

#public

parse_impl: Opts, String, String, <> => Parsed
parse_impl = opts, desc, version, help_on_empty =>
   av = args!
   ?av == 0 && (help_on_empty || has_required_opt(opts))
      |
         io::outs(format_help(opts, program!, desc, version))
         sys::exit(1)
   res = parse_argv(opts, av, version != "")
   res
      | p =>
         p.help
            |
               io::outs(format_active_help(p, program!, desc, version))
               sys::exit(0)
         p.version && version != ""
            |
               pname = prog_basename(program!)
               io::outs((pname != "" | pname + " " | "") + version)
               sys::exit(0)
         p
      | err =>
         pname = prog_basename(program!)
         prefix = pname != "" | pname + ": " | "error: "
         io::errs(prefix + err)
         sys::exit(1)
         Parsed(opts, <>{}, <>{}, Int{}, Float{}, String{}, ArgsList(), String{}, String{}, "", SubParsed(NoSub), <->, <->)

// Returns total argument count (including program name at index 0).
count: () => Int
count = !=> sys::argc

// Returns the program name (`argv[0]`), or `""` if unavailable.
program: () => String
program = !=>
   sys::argc > 0
      | sys::argv_string(0)
      | ""

// Returns argument at index `idx` (0-based) as `<+ str +>`, or `<-->` if out of bounds.
arg: Int => < String | >
arg = idx => sys::argv(idx)

// Returns argument at index `idx` (0-based), or `fallback` if out of bounds.
arg_or: Int, String => String
arg_or = idx, fallback =>
   idx [0..sys::argc]
      | sys::argv_string(idx)
      | fallback

// Returns all command-line arguments after the program name (`argv[1..argc]`).
args: () => Args
args = !=>
   out = String{}
   n = sys::argc
   1..n @ i =>
      out += sys::argv_string(i)
   out

// Returns all command-line arguments including the program name (`argv[0..argc]`).
all_args: () => Args
all_args = !=>
   out = String{}
   n = sys::argc
   0..n @ i =>
      out += sys::argv_string(i)
   out

// Declares a CLI option specification:
// - `"p:port"` splits on `":"` into short `'p'` and long `"port"`
// - `"bind"` (no `":"`) defines a long-only option `--bind`
// Next arguments: default value (or primitive type `Int`/`Float`/`String`/`Args` if mandatory),
// description string, and an optional validator lambda `T => < | String >`.
opt: #! T: Type, #! V: Type, String, T, String, V => Opt
opt = #! T, #! V, spec, def_or_ty, desc, vf =>
   T
      [<>]
         V
            [is_fn] make_flag_opt(spec, def_or_ty, desc, vf)
            | make_flag_opt_def(spec, def_or_ty, desc)
      [Int]
         V
            [is_fn] make_int_opt(spec, def_or_ty, desc, vf)
            | make_int_opt_def(spec, def_or_ty, desc)
      [Float]
         V
            [is_fn] make_float_opt(spec, def_or_ty, desc, vf)
            | make_float_opt_def(spec, def_or_ty, desc)
      [String]
         V
            [is_fn] make_str_opt(spec, def_or_ty, desc, vf)
            | make_str_opt_def(spec, def_or_ty, desc)
      [Args]
         V
            [is_fn] make_str_list_opt(spec, desc, vf)
            | make_str_list_opt_def(spec, desc)
      [Type]
         V
            [IntValidator] make_req_int_opt(spec, desc, vf)
            [FloatValidator] make_req_float_opt(spec, desc, vf)
            [StrValidator] make_req_str_opt(spec, desc, vf)
            | make_req_opt(spec, def_or_ty, desc)
      | make_str_opt_def(spec, "", desc)

// Declares a positional CLI argument specification:
// - `cli::pos("input", String, "Input file")` -> required `<input>`
// - `cli::pos("dir", ".", "Target directory")` -> optional `[dir]` with default `"."`
// - `cli::pos("files", cli::Args(), "Source files")` -> optional variadic `[files...]`
// - `cli::pos("files...", String, "Source files")` -> required variadic `<files...>`
pos: #! T: Type, #! D: Type, #! V: Type, String, T, D, V => Opt
pos = #! T, #! D, #! V, name, def_or_ty, desc_or_none, vf =>
   as_pos_opt(opt(name, def_or_ty, (D [String] desc_or_none | ""), vf))

// Declares a subcommand specification:
// - `cli::cmd("lsp", "Start the Language Server")`
// - `cli::cmd("rm|remove", "Remove a dependency", sub_opts)`
cmd: #! A: Type, String, String, A => Opt
cmd = #! A, spec, desc, sub_arg =>
   make_cmd_opt(spec, desc, (A [()] Opts() | sub_arg))

// Formats a help message for `opts` with program name, optional description, and optional version.
format_help: Opts, String, String, String => String
format_help = opts, prog, desc, version =>
   pname = prog_basename(prog)
   name_str = pname != "" | pname | "program"
   b = {512}
   title = version != "" | name_str + " " + version | name_str
   desc != ""
      | b += title + " - " + desc + "\n\n"
      | (version != "" | b += title + "\n\n")

   cmd_lefts = String{}
   cmd_rights = String{}
   pos_lefts = String{}
   pos_rights = String{}
   pos_tokens = String{}
   opt_lefts = String{}
   opt_rights = String{}
   max_w' = 18
   has_ropt' = <->

   ?opts @ i =>
      o = opts(i)!!
      o.role
         [RCmd]
            cl = cmd_left_col(o)
            cr = o.desc
            cmd_lefts += cl
            cmd_rights += cr
            ?cl > max_w' | (max_w' = ?cl)
         [RPos]
            pt = pos_token(o)
            pos_tokens += pt
            o.desc != ""
               |
                  pl = "  " + pt
                  pr = opt_right_col(o)
                  pos_lefts += pl
                  pos_rights += pr
                  ?pl > max_w' | (max_w' = ?pl)
         [ROpt]
            has_ropt' = <+>
            ol = opt_left_col(o)
            or_txt = opt_right_col(o)
            opt_lefts += ol
            opt_rights += or_txt
            ?ol > max_w' | (max_w' = ?ol)

   version != "" && !has_opt_named(opts, "version", "v")
      |
         lv = "  -v, --version"
         opt_lefts += lv
         opt_rights += "Display version and exit"
         ?lv > max_w' | (max_w' = ?lv)

   !has_opt_named(opts, "help", "h")
      |
         lh = "  -h, --help"
         opt_lefts += lh
         opt_rights += "Display this help and exit"
         ?lh > max_w' | (max_w' = ?lh)

   pos_usage' = ++""
   ?pos_tokens @ p_i =>
      pos_usage' = pos_usage' + " " + pos_tokens(p_i)!!

   b += "Usage:\n"
   (?cmd_lefts > 0 && (?pos_tokens > 0 || has_ropt'))
      |
         b += "  " + name_str + " [options]" + pos_usage' + "\n"
         b += "  " + name_str + " <command> [options] [args...]\n"
      |
         ?cmd_lefts > 0
            | b += "  " + name_str + " <command> [options]\n"
            | b += "  " + name_str + " [options]" + pos_usage' + "\n"

   col_w = max_w' + 2

   ?cmd_lefts > 0
      |
         b += "\nCommands:\n"
         ?cmd_lefts @ c_j =>
            l_col = str::pad_right(cmd_lefts(c_j)!!, col_w, ' ')
            r_col = cmd_rights(c_j)!!
            b += l_col + r_col + "\n"

   ?pos_lefts > 0
      |
         b += "\nArguments:\n"
         ?pos_lefts @ p_j =>
            l_col = str::pad_right(pos_lefts(p_j)!!, col_w, ' ')
            r_col = pos_rights(p_j)!!
            b += l_col + r_col + "\n"

   ?opt_lefts > 0
      |
         b += "\nOptions:\n"
         ?opt_lefts @ o_j =>
            l_col = str::pad_right(opt_lefts(o_j)!!, col_w, ' ')
            r_col = opt_rights(o_j)!!
            b += l_col + r_col + "\n"

   +b

// Parses an explicit `Args` array against `opts`, returning `<+ Parsed ->` or `<- err_msg +>`.
parse_args: Opts, Args => < Parsed | String >
parse_args = opts, argv =>
   parse_argv(opts, argv, <->)

// Parses `sys::argv` against `opts`:
// - `cli::parse(opts)`
// - `cli::parse(opts, "Program description")`
// - `cli::parse(opts, "Program description", "1.0.0")`
// - `cli::parse(opts, "Program description", "1.0.0", <+>)` (where `<+>` triggers help on empty args)
// Automatically handles `-h`/`--help` (and `-v`/`--version` when version is given) and exits 1 on error.
parse: #! A: Type, #! B: Type, #! C: Type, Opts, A, B, C => Parsed
parse = #! A, #! B, #! C, opts, a, b, c =>
   parse_impl(
      opts,
      (A [String] a | ""),
      (B [String] b | ""),
      (A [<>] a | (B [<>] b | (C [<>] c | <->)))
   )

// Returns the matched canonical subcommand name at level `p` (or `""` if none).
subcmd: Parsed => String
subcmd = p => p.subcmd

// Returns `<+ sub_parsed +>` for the matched subcommand at level `p`, or `<-->` if none.
sub: Parsed => < Parsed | >
sub = p =>
   p.sub
      [HasSub sub_p] <+ sub_p +>
      | <-->

// Returns `<+>` if option or positional `name` (long or short name) was explicitly provided on the command line.
has: Parsed, String => <>
has = p, name =>
   p.sub
      [HasSub sub_p]
         has(sub_p, name)
            | <+>
            |
               idx = find_opt_idx(p.opts, name)
               idx !< 0 | p.seen(idx)!! | <->
      |
         idx = find_opt_idx(p.opts, name)
         idx !< 0
            | p.seen(idx)!!
            | <->

#private

has_spec: Parsed, String => <>
has_spec = p, name =>
   p.sub
      [HasSub sub_p] has_spec(sub_p, name) || find_opt_idx(p.opts, name) !< 0
      | find_opt_idx(p.opts, name) !< 0

find_active_opt: Parsed, String => < Opt | >
find_active_opt = p, name =>
   p.sub
      [HasSub sub_p]
         find_active_opt(sub_p, name)
            | o => <+ o +>
            |
               idx = find_opt_idx(p.opts, name)
               idx !< 0 | <+ p.opts(idx)!! +> | <-->
      |
         idx = find_opt_idx(p.opts, name)
         idx !< 0 | <+ p.opts(idx)!! +> | <-->

#public

// Returns the boolean (`<>`) value of option `name`.
flag: Parsed, String => <>
flag = p, name =>
   p.sub
      [HasSub sub_p]
         has(sub_p, name)
            | flag(sub_p, name)
            |
               idx = find_opt_idx(p.opts, name)
               idx !< 0 && p.seen(idx)!!
                  | p.flags(idx)!!
                  | (has_spec(sub_p, name) | flag(sub_p, name) | (idx !< 0 | p.flags(idx)!! | <->))
      |
         idx = find_opt_idx(p.opts, name)
         idx !< 0
            | p.flags(idx)!!
            | <->

// Returns the `Int` value of option or positional `name`.
int: Parsed, String => Int
int = p, name =>
   p.sub
      [HasSub sub_p]
         has(sub_p, name)
            | int(sub_p, name)
            |
               idx = find_opt_idx(p.opts, name)
               idx !< 0 && p.seen(idx)!!
                  | p.ints(idx)!!
                  | (has_spec(sub_p, name) | int(sub_p, name) | (idx !< 0 | p.ints(idx)!! | 0))
      |
         idx = find_opt_idx(p.opts, name)
         idx !< 0
            | p.ints(idx)!!
            | 0

// Returns the `Float` value of option or positional `name`.
float: Parsed, String => Float
float = p, name =>
   p.sub
      [HasSub sub_p]
         has(sub_p, name)
            | float(sub_p, name)
            |
               idx = find_opt_idx(p.opts, name)
               idx !< 0 && p.seen(idx)!!
                  | p.floats(idx)!!
                  | (has_spec(sub_p, name) | float(sub_p, name) | (idx !< 0 | p.floats(idx)!! | 0.0))
      |
         idx = find_opt_idx(p.opts, name)
         idx !< 0
            | p.floats(idx)!!
            | 0.0

// Returns the `String` value of option or positional `name`.
str: Parsed, String => String
str = p, name =>
   p.sub
      [HasSub sub_p]
         has(sub_p, name)
            | str(sub_p, name)
            |
               idx = find_opt_idx(p.opts, name)
               idx !< 0 && p.seen(idx)!!
                  | p.strs(idx)!!
                  | (has_spec(sub_p, name) | str(sub_p, name) | (idx !< 0 | p.strs(idx)!! | ""))
      |
         idx = find_opt_idx(p.opts, name)
         idx !< 0
            | p.strs(idx)!!
            | ""

// Returns the `Args` (`String{}`) list of values for repeatable option or variadic positional `name`.
strs: Parsed, String => Args
strs = p, name =>
   p.sub
      [HasSub sub_p]
         has(sub_p, name)
            | strs(sub_p, name)
            |
               idx = find_opt_idx(p.opts, name)
               idx !< 0 && p.seen(idx)!!
                  | p.str_lists(idx)!!
                  | (has_spec(sub_p, name) | strs(sub_p, name) | (idx !< 0 | p.str_lists(idx)!! | Args()))
      |
         idx = find_opt_idx(p.opts, name)
         idx !< 0
            | p.str_lists(idx)!!
            | Args()

// Derives an `Opts` specification automatically from a record type `T` (`[(..)]`).
// Underscores `_` in field names are mapped to hyphens `-` for long option names.
opts_for: #! T: Type => Opts
opts_for = !=>
   out' = Opts()
   T
      [(..)]
         T @ f =>
            lname = str::replace(f.name, "_", "-")
            f_def = f.default
            f.type
               [<>]
                  dv = f_def | d => d | <->
                  out' += make_flag_opt_def(lname, dv, "")
               [Int]
                  f_def
                     | d => out' += make_int_opt_def(lname, d, "")
                     | out' += make_req_opt(lname, Int, "")
               [Float]
                  f_def
                     | d => out' += make_float_opt_def(lname, d, "")
                     | out' += make_req_opt(lname, Float, "")
               [String]
                  f_def
                     | d => out' += make_str_opt_def(lname, d, "")
                     | out' += make_req_opt(lname, String, "")
               [Args]
                  out' += make_str_list_opt_def(lname, "")
               [<P|>]
                  P
                     [Int] out' += make_int_opt_def(lname, 0, "")
                     [Float] out' += make_float_opt_def(lname, 0.0, "")
                     [String] out' += make_str_opt_def(lname, "", "")
                     [<>] out' += make_flag_opt_def(lname, <->, "")
   out'

// Populates a typed record `T` from a `Parsed` CLI result using compile-time field introspection.
// Field names map `_` to `-` (and also fall back to the exact field name), resolving both
// `--flag` options and named `cli::pos` positional arguments.
into: #! T: Type, Parsed => < T | String >
into = p =>
   rec' = T.zero
   has_err' = <->
   err_msg' = ++""
   T
      [(..)]
         T @ f =>
            !has_err' |
               opt_name = str::replace(f.name, "_", "-")
               key = has_spec(p, opt_name) | opt_name | f.name
               opt_spec = find_active_opt(p, key)
               has_key = opt_spec | o => <+> | <->
               is_req = opt_spec | o => o.required | <+>
               is_pos = opt_spec | o => (o.role [RPos]) | <->
               is_seen = has(p, key)
               is_seen
                  |
                     f.type
                        [<>] rec'.(f) = flag(p, key)
                        [Int] rec'.(f) = int(p, key)
                        [Float] rec'.(f) = float(p, key)
                        [String] rec'.(f) = str(p, key)
                        [Args] rec'.(f) = strs(p, key)
                        [<P|>]
                           P
                              [Int] rec'.(f) = <+ int(p, key) +>
                              [Float] rec'.(f) = <+ float(p, key) +>
                              [String] rec'.(f) = <+ str(p, key) +>
                              [<>] rec'.(f) = <+ flag(p, key) +>
                  |
                     f_def = f.default
                     f_def
                        | def => rec'.(f) = def
                        |
                           f.type
                              [<P|>] rec'.(f) = <-->
                              [Args] rec'.(f) = (has_key | strs(p, key) | Args())
                              [<>] rec'.(f) = (has_key | flag(p, key) | <->)
                              [Int]
                                 has_key && !is_req
                                    | rec'.(f) = int(p, key)
                                    |
                                       has_err' = <+>
                                       err_msg' = (is_pos | "missing required argument: <" + key + ">" | "missing required option: --" + opt_name)
                              [Float]
                                 has_key && !is_req
                                    | rec'.(f) = float(p, key)
                                    |
                                       has_err' = <+>
                                       err_msg' = (is_pos | "missing required argument: <" + key + ">" | "missing required option: --" + opt_name)
                              [String]
                                 has_key && !is_req
                                    | rec'.(f) = str(p, key)
                                    |
                                       has_err' = <+>
                                       err_msg' = (is_pos | "missing required argument: <" + key + ">" | "missing required option: --" + opt_name)
      |
         has_err' = <+>
         err_msg' = ++"cli::into target must be a record type"
   has_err'
      | <- err_msg' +>
      | <+ rec' ->

// Parses `argv` against `opts` (or derives `opts_for(T)` when `opts` is empty)
// and populates `T`.
parse_into: #! T: Type, Opts, Args => < T | String >
parse_into = opts, argv =>
   eff_opts = ?opts > 0 | opts | opts_for(T)
   parse_args(eff_opts, argv)
      | p => into(T, p)
      | err => <- err +>

// Returns positional arguments (`Args`) collected at the active command level.
rest: Parsed => Args
rest = p =>
   p.sub
      [HasSub sub_p] rest(sub_p)
      | p.args

// Returns pass-through arguments (`Args`) appearing after `--`.
passthrough: Parsed => Args
passthrough = p =>
   p.sub
      [HasSub sub_p]
         sp = passthrough(sub_p)
         ?sp > 0 | sp | p.passthrough
      | p.passthrough
