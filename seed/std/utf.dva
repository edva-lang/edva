// std/utf.dva — UTF-8 encoding and decoding utilities

#public
   // Append the UTF-8 encoding of a Rune to a Builder
   append_rune: Builder, Rune => ()
   append_rune = b, r =>
      cp = Int(r)
      cp [< 0x80] b += cp
         [< 0x800]
            b += 0xC0 .|. (cp .>. 6)
            b += 0x80 .|. (cp .&. 0x3F)
         [< 0x10000]
            b += 0xE0 .|. (cp .>. 12)
            b += 0x80 .|. ((cp .>. 6) .&. 0x3F)
            b += 0x80 .|. (cp .&. 0x3F)
         |
            b += 0xF0 .|. (cp .>. 18)
            b += 0x80 .|. ((cp .>. 12) .&. 0x3F)
            b += 0x80 .|. ((cp .>. 6) .&. 0x3F)
            b += 0x80 .|. (cp .&. 0x3F)

   // Append the UTF-8 encoding of an integer codepoint to a Builder
   append_codepoint: Builder, Int => ()
   append_codepoint = b, cp =>
      append_rune(b, Rune(cp))

   // Encode a Rune into a fresh UTF-8 String
   encode_rune: Rune => String
   encode_rune = r =>
      b = {4}
      append_rune(b, r)
      +b

   // Encode an integer codepoint into a fresh UTF-8 String
   encode_codepoint: Int => String
   encode_codepoint = cp =>
      encode_rune(Rune(cp))

   // Expected byte length (1..4) of a UTF-8 sequence starting with lead byte b0
   seq_len: Int => Int
   seq_len = b0 =>
      b0 [< 0x80] 1 [< 0xE0] 2 [< 0xF0] 3 | 4

   // Decode the UTF-8 rune at Addr + i into its codepoint (or U+FFFD on invalid sequence)
   decode_rune_addr: Addr, Int => Rune
   decode_rune_addr = p, i =>
      b0 = Int(@[p + i u8])
      b0 < 0x80 | --| Rune(b0)
      cp' = 0xFFFD
      b0 [0xC2...0xF4]
         b1 = Int(@[p + i + 1 u8])
         (b1 .&. 0xC0) == 0x80 |
            b0
               [< 0xE0]
                  cp' = ((b0 .&. 0x1F) .<. 6) .|. (b1 .&. 0x3F)
               [< 0xF0]
                  b2 = Int(@[p + i + 2 u8])
                  (b2 .&. 0xC0) == 0x80 |
                     c = ((b0 .&. 0x0F) .<. 12) .|. ((b1 .&. 0x3F) .<. 6) .|. (b2 .&. 0x3F)
                     c !< 0x800 && c ![0xD800...0xDFFF] | cp' = c
               |
                  b2 = Int(@[p + i + 2 u8])
                  (b2 .&. 0xC0) == 0x80 |
                     b3 = Int(@[p + i + 3 u8])
                     (b3 .&. 0xC0) == 0x80 |
                        c = ((b0 .&. 0x07) .<. 18) .|. ((b1 .&. 0x3F) .<. 12) .|.
                           ((b2 .&. 0x3F) .<. 6) .|. (b3 .&. 0x3F)
                        c [0x10000...0x10FFFF] | cp' = c
      Rune(cp')

   // Decode the UTF-8 rune at Builder buffer + i into its codepoint
   decode_rune_builder: Builder, Int => Rune
   decode_rune_builder = b, i =>
      n = ?b
      i ![0..n] | --| Rune(0xFFFD)
      need = seq_len(b(i))
      i + need > n | --| Rune(0xFFFD)
      decode_rune_addr(&b, i)

   // Decode the UTF-8 rune at String s + i, returning (codepoint, byte_len) or (-1, 1) if invalid
   decode_str_at: String, Int => (Int, Int)
   decode_str_at = s, i =>
      n = ?s
      i ![0..n] | --| (-1, 1)
      b0 = s(i)
      need = seq_len(b0)
      i + need > n | --| (-1, 1)
      cp = Int(decode_rune_addr(&s, i))
      cp == 0xFFFD && (need != 3 || b0 != 0xEF || s(i + 1) != 0xBF || s(i + 2) != 0xBD)
         | (-1, 1)
         | (cp, need)

   // Byte offset of the next rune boundary after pos (clamped to ?s; an
   // invalid byte counts as a one-byte rune)
   next_start: String, Int => Int
   next_start = s, pos =>
      n = ?s
      pos !< n | --| n
      pos + decode_str_at(s, %max(pos, 0)).1

   // Byte offset of the start of the rune that ends at pos (0 at the start;
   // skips at most three continuation bytes)
   prev_start: String, Int => Int
   prev_start = s, pos =>
      pos !> 0 | --| 0
      p' = %min(pos, ?s) - 1
      0..3 @
         p' !> 0 | -->
         (s(p') .&. 0xC0) == 0x80 | p' = p' - 1
         | -->
      %max(0, p')
