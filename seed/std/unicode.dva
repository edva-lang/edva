#pragma integer default

#public
   category_id: Rune => Int
   category_id = cp =>
      cp ![0...0x10FFFF]
         | 29
         |
            page = Int(cat_s1(cp .>. 8))
            (cat_s2(page * 32 + ((cp .&. 255) .>. 3)) .>. ((cp .&. 7) .<. 3)) .&. 255

   category: Rune => Category
   category = category_id .>
      [0] Category(Lu) [1] Category(Ll) [2] Category(Lt) [3] Category(Lm) [4] Category(Lo)
      [5] Category(Mn) [6] Category(Mc) [7] Category(Me)
      [8] Category(Nd) [9] Category(Nl) [10] Category(No)
      [11] Category(Pc) [12] Category(Pd) [13] Category(Ps) [14] Category(Pe) [15] Category(Pi) [16] Category(Pf) [17] Category(Po)
      [18] Category(Sm) [19] Category(Sc) [20] Category(Sk) [21] Category(So)
      [22] Category(Zs) [23] Category(Zl) [24] Category(Zp)
      [25] Category(Cc) [26] Category(Cf) [27] Category(Cs) [28] Category(Co)
      | Category(Cn)

   // Human-readable description of a Unicode general category.
   category_description: Category => String
   category_description =
      [Lu] "Uppercase Letter"
      [Ll] "Lowercase Letter"
      [Lt] "Titlecase Letter"
      [Lm] "Modifier Letter"
      [Lo] "Other Letter"
      [Mn] "Nonspacing Mark"
      [Mc] "Spacing Mark"
      [Me] "Enclosing Mark"
      [Nd] "Decimal Number"
      [Nl] "Letter Number"
      [No] "Other Number"
      [Pc] "Connector Punctuation"
      [Pd] "Dash Punctuation"
      [Ps] "Open Punctuation"
      [Pe] "Close Punctuation"
      [Pi] "Initial Punctuation"
      [Pf] "Final Punctuation"
      [Po] "Other Punctuation"
      [Sm] "Math Symbol"
      [Sc] "Currency Symbol"
      [Sk] "Modifier Symbol"
      [So] "Other Symbol"
      [Zs] "Space Separator"
      [Zl] "Line Separator"
      [Zp] "Paragraph Separator"
      [Cc] "Control"
      [Cf] "Format"
      [Cs] "Surrogate"
      [Co] "Private Use"
      [Cn] "Unassigned"
      | "Unknown"

   // Alphabetic letters (Lu, Ll, Lt, Lm, Lo)
   is_alpha: Rune => <>
   is_alpha = cp =>
      cat = category_id(cp)
      cat !> 4

   // Decimal digits (Nd)
   is_digit: Rune => <>
   is_digit = cp =>
      category_id(cp) == 8

   // Uppercase letters (Lu)
   is_upper: Rune => <>
   is_upper = cp =>
      category_id(cp) == 0

   // Lowercase letters (Ll)
   is_lower: Rune => <>
   is_lower = cp =>
      category_id(cp) == 1

   // Titlecase letters (Lt)
   is_title: Rune => <>
   is_title = cp =>
      category_id(cp) == 2

   // Simple 1-to-1 Unicode uppercase mapping for a Rune.
   to_upper: Rune => Rune
   to_upper = cp =>
      c = Int(cp)
      c < 0x80 | --| Rune(c ['a...'z] | c - 32 | c)
      lo' = 0
      hi' = 198
      res' = c
      0.. @
         lo' > hi' | -->
         mid = (lo' + hi') .>. 1
         w = case_up_runs(mid)
         start = w .&. 0xFFFFF
         span = (w .>. 20) .&. 0xFF
         c < start
            | hi' = mid - 1
            |
               c > start + span
                  | lo' = mid + 1
                  |
                     step2 = (w .>. 28) .&. 1
                     (step2 == 0 || ((c - start) .&. 1) == 0)
                        | res' = c + ((w .>. 29) - 0x10000)
                     -->
      Rune(res')

   // Simple 1-to-1 Unicode lowercase mapping for a Rune.
   to_lower: Rune => Rune
   to_lower = cp =>
      c = Int(cp)
      c < 0x80 | --| Rune(c ['A...'Z] | c + 32 | c)
      c == 0x0130 | --| Rune(0x0069)
      lo' = 0
      hi' = 185
      res' = c
      0.. @
         lo' > hi' | -->
         mid = (lo' + hi') .>. 1
         w = case_lo_runs(mid)
         start = w .&. 0xFFFFF
         span = (w .>. 20) .&. 0xFF
         c < start
            | hi' = mid - 1
            |
               c > start + span
                  | lo' = mid + 1
                  |
                     step2 = (w .>. 28) .&. 1
                     (step2 == 0 || ((c - start) .&. 1) == 0)
                        | res' = c + ((w .>. 29) - 0x10000)
                     -->
      Rune(res')

   // Whitespace: space separators (Zs, Zl, Zp) plus ASCII whitespace
   // (\t, \n, \v, \f, \r)
   is_space: Rune => <>
   is_space = cp =>
      cat = category_id(cp)
      cat [22...24] || cp [0x09...0x0D, 0x20]

   // Punctuation (Pc, Pd, Ps, Pe, Pi, Pf, Po)
   is_punctuation: Rune => <>
   is_punctuation = cp =>
      cat = category_id(cp)
      cat [11...17]

   // Symbols: math, currency, modifiers, others (Sm, Sc, Sk, So)
   is_symbol: Rune => <>
   is_symbol = cp =>
      cat = category_id(cp)
      cat [18...21]

   // Combining marks: nonspacing, spacing, enclosing (Mn, Mc, Me)
   is_mark: Rune => <>
   is_mark = cp =>
      cat = category_id(cp)
      cat [5...7]

   // Numbers: decimal digits, letter numbers, other numbers (Nd, Nl, No)
   is_number: Rune => <>
   is_number = cp =>
      cat = category_id(cp)
      cat [8...10]

   // Control characters (Cc)
   is_control: Rune => <>
   is_control = cp =>
      category_id(cp) == 25

   // Graphic characters (letters, marks, numbers, punctuation, symbols)
   is_graphic: Rune => <>
   is_graphic = cp =>
      cat = category_id(cp)
      cat !> 22

   // Decode the UTF-8 rune at src[i] into its codepoint.
   decode_rune: String, Int => Rune
   decode_rune = src, i =>
      n = ?src
      i ![0..n] | --| Rune(0xFFFD)
      i + utf::seq_len(src(i)) > n | --| Rune(0xFFFD)
      utf::decode_rune_addr(&src, i)

   // Byte width of a rune's UTF-8 encoding.
   utf8_width: Rune => Int
   utf8_width =
      [< 0x80] 1 [< 0x800] 2 [< 0x10000] 3 | 4

   // UAX #31: XID_Start characters (Lu, Ll, Lt, Lm, Lo, Nl)
   is_xid_start: Rune => <>
   is_xid_start = cp =>
      cat = category_id(cp)
      cat !> 4 || cat == 9

   // UAX #31: XID_Continue characters (Lu..Lo, Mn, Mc, Nd, Nl, Pc)
   is_xid_continue: Rune => <>
   is_xid_continue = cp =>
      cat = category_id(cp)
      cat !> 6 || cat == 8 || cat == 9 || cat == 11

   // Identifier start: XID_Start or '_'
   is_id_start: Rune => <>
   is_id_start = cp =>
      cp == '_ || is_xid_start(cp)

   // Identifier continuation: XID_Continue
   is_id_continue: Rune => <>
   is_id_continue = cp =>
      is_xid_continue(cp)

   // Decode the UTF-8 rune at Addr + i into its codepoint.
   decode_rune_addr: Addr, Int => Rune
   decode_rune_addr = p, i => utf::decode_rune_addr(p, i)

   // Decode the UTF-8 rune at Builder buffer + i into its codepoint.
   decode_rune_builder: Builder, Int => Rune
   decode_rune_builder = b, i => utf::decode_rune_builder(b, i)

   // Polymorphic UAX #31 identifier check for String, Builder, etc.
   is_uax31: #! T: Type, T => <>
   is_uax31 = #! T, target =>
      n = ?target
      n == 0 |->
      p = &target
      utf::seq_len(target(0)) > n |->
      r0 = utf::decode_rune_addr(p, 0)
      !unicode::is_id_start(r0) |->
      i' = ?r0
      0.. @
         i' !< n | -->
         i' + utf::seq_len(target(i')) > n |->
         r = utf::decode_rune_addr(p, i')
         !unicode::is_id_continue(r) |->
         i' = i' + ?r
      <+>

   // Concrete monomorphic aliases
   is_uax31_str: String => <>
   is_uax31_str = s => unicode::is_uax31(s)

   is_uax31_builder: Builder => <>
   is_uax31_builder = b => unicode::is_uax31(b)

