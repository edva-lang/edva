   0x404040404040404 {5}, 0x505050504040404, 0x808080808080808,
   0x131d1d1d1d1d0808, 0x1d1d1d1d1d1d1d1d {26}, 0x404040404040404 {3},
   0x505050503040404, 0x808080808080808, 0x1d1d1d1d1d1d0808,
   0x1d1d1d1d1d1d1d1d {26}, 0x404040404040404 {3}, 0x505040404040404,
   0x808080808080804, 0x111d1d1d1d080808, 0x1d1d1d1d1d1d1d1d {24},
