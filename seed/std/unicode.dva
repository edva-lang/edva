   0x505040404040404, 0x1d1d050404040404, 0x3041d1d1d1d1d1d,
   0x1d1d1d1d1d1d1d1d {28}, 0x1d04040404040404, 0x1d04041d04040404,
   0x404040404040404, 0x1d04040404040404, 0x404040404040404 {24},
   0xa1d1d0404040404, 0xa0a0a0a0a0a0a0a, 0x1d05050505050505,
   0x1d1d1d1d1d1d1d1d {5}, 0 {4}, 0x101010101010000, 0x101010101010101 {3},
   0x505050501010101, 0x1d1d1d1d03050505, 0x808080808080808,
   0x11111d1d1d1d0808, 0x1d1d1d1d1d1d1d1d {34}, 0xa0a0a0a0a0a0a1d,
   0xa0a0a0a0a0a0a0a {6}, 0xa0a0a150a0a0a0a, 0x1d1d1d0a0a0a0a13,
   0x1d1d1d1d1d1d1d1d {9}, 0xa0a0a0a0a0a0a1d, 0xa0a0a0a0a0a0a0a {4},
   0xa150a0a0a0a0a0a, 0xa0a0a0a0a0a0a0a, 0x1d1d0a0a0a0a0a0a,
   0x1d1d1d1d1d1d1d1d {24}, 0x404041d04040404, 0x404040404040404 {3},
   0x41d1d041d04041d, 0x40404040404041d, 0x40404041d040404, 0x1d1d1d1d041d041d,
   0x41d1d1d1d041d1d, 0x404041d041d041d, 0x41d1d041d04041d, 0x41d041d041d041d,
   0x41d1d041d04041d, 0x40404041d040404, 0x40404041d040404, 0x1d041d040404041d,
   0x404040404040404, 0x4040404041d0404, 0x404040404040404, 0x1d1d1d1d04040404,
   0x404041d0404041d, 0x4040404041d0404, 0x404040404040404, 0x1d1d1d1d04040404,
   0x1d1d1d1d1d1d1d1d {6}, 0x1d1d1d1d1d1d1212, 0x1d1d1d1d1d1d1d1d,
   0x1515151515151515 {5}, 0x1d1d1d1d15151515, 0x1515151515151515 {12},
   0x1d1d1d1d15151515, 0x1d1d1d1d1d1d1d1d, 0x1515151515151515,
   0x1d15151515151515, 0x151515151515151d, 0x1515151515151515,
   0x151515151515151d, 0x1515151515151515, 0x151515151515151d,
   0x1515151515151515 {3}, 0x1d1d151515151515, 0x1d1d1d1d1d1d1d1d,
   0xa0a0a0a0a0a0a0a, 0x1515150a0a0a0a0a, 0x1515151515151515 {19},
   0x1d15151515151515, 0x1d1d1d1d1d1d1d1d {6}, 0x15151d1d1d1d1d1d,
   0x1515151515151515 {3}, 0x1d1d1d1d1d151515, 0x1d1d1d1d1d1d1d1d,
   0x1515151515151515 {5}, 0x1d1d1d1d15151515, 0x1515151515151515,
   0x1d1d1d1d1d1d1d15, 0x1d1d1d1d1d1d1515, 0x1d1d1d1d1d1d1d1d,
   0x1d1d151515151515, 0x1d1d1d1d1d1d1d1d {19}, 0x1515151515151515 {31},
   0x1414141414151515, 0x1515151515151515 {27}, 0x151515151d1d1515,
   0x1515151515151515, 0x1d1d1d1515151515, 0x1515151515151515,
   0x1d1d1d1515151515, 0x1515151515151515 {27}, 0x1d1d1d1d15151515,
   0x1515151515151515, 0x1d1d1d1d15151515, 0x1515151515151515 {3},
   0x1d1d1d1d15151515, 0x1515151515151515 {7}, 0x1d1d1d1d1d1d1d1d,
   0x1515151515151515, 0x1d1d1d1d1d1d1515, 0x1515151515151515 {5},
   0x1d1d1d1d1d1d1d1d, 0x1515151515151515 {3}, 0x1d1d151515151515,
   0x1515151515151515, 0x1d1d1d1d15151515, 0x1d1d1d1d1d1d1515,
   0x1d1d1d1d1d1d1d1d, 0x1212121212121212, 0x1d1d1d1d1d1d1d12,
   0x1d1d1d1d1d1d1d1d {4}, 0x1515151515151515 {11}, 0x1d1d1d1d1d1d1d1d,
   0x1515151515151515, 0x1d1d151515151515, 0x1515151515151515,
   0x1d1d1d1515151515, 0x1515151515151515 {8}, 0x1d15151515151515,
   0x151515151d1d1d15, 0x1515151515151515, 0x151d151515151515,
   0x1515151515151515, 0x151d1d1d15151515, 0x1515151515151515,
   0x1d1d1d1d1d151515, 0x1515151515151515 {18}, 0x151515151d151515,
   0x1515151515151515 {11}, 0x808080808080808, 0x1d1d1d1d1d150808,
   0x404040404040404 {28}, 0x1d1d1d1d1d1d1d1d {4}, 0x404040404040404 {3},
   0x1d04040404040404, 0x404040404040404 {49}, 0x1d1d040404040404,
   0x404040404040404 {38}, 0x1d1d1d1d1d1d1d04, 0x1d1d1d1d1d1d1d1d,
   0x404040404040404 {13}, 0x1d1d040404040404, 0x1d1d1d1d1d1d1d1d {20},
   0x404040404040404 {3}, 0x1d1d040404040404, 0x1d1d1d1d1d1d1d1d {28},
   0x404040404040404 {9}, 0x1d1d1d1d1d040404, 0x404040404040404 {37},
   0x1d1d1d1d1d1d0404, 0x1d1d1d1d1d1d1d1d {16}, 0x404040404040404 {8},
   0x1d1d1d1d1d1d1d1d {24}, 0x1d1d1d1d1d1d1a1d, 0x1d1d1d1d1d1d1d1d {3},
   0x1a1a1a1a1a1a1a1a {12}, 0x1d1d1d1d1d1d1d1d {16}, 0x505050505050505 {30},
   0x1d1d1d1d1d1d1d1d, 0x1d1d1d1d1d1d1d1d, 0x1c1c1c1c1c1c1c1c {31},
   0x1d1d1c1c1c1c1c1c
)

#pragma number default

#public
   category_id: Rune => Int
   category_id = cp =>
      cp [> 0x10FFFF] 29 |
         page = Int(cat_s1(cp .>. 8))
         (cat_s2(page * 32 + ((cp .&. 255) .>. 3)) .>. ((cp .&. 7) .<. 3)) .&. 255

   category: Rune => Category
   category = cp =>
      id = category_id(cp)
      id
         [0] Lu [1] Ll [2] Lt [3] Lm [4] Lo
         [5] Mn [6] Mc [7] Me
         [8] Nd [9] Nl [10] No
         [11] Pc [12] Pd [13] Ps [14] Pe [15] Pi [16] Pf [17] Po
         [18] Sm [19] Sc [20] Sk [21] So
         [22] Zs [23] Zl [24] Zp
         [25] Cc [26] Cf [27] Cs [28] Co
         | Cn

   // Human-readable description of a Unicode general category.
   category_description: Category => String
   category_description = c =>
      c
         [Lu] "Uppercase Letter"
         [Ll] "Lowercase Letter"
         [Lt] "Titlecase Letter"
         [Lm] "Modifier Letter"
         [Lo] "Other Letter"
         [Mn] "Nonspacing Mark"
         [Mc] "Spacing Mark"
         [Me] "Enclosing Mark"
         [Nd] "Decimal Number"
         [Nl] "Letter Number"
         [No] "Other Number"
         [Pc] "Connector Punctuation"
         [Pd] "Dash Punctuation"
         [Ps] "Open Punctuation"
         [Pe] "Close Punctuation"
         [Pi] "Initial Punctuation"
         [Pf] "Final Punctuation"
         [Po] "Other Punctuation"
         [Sm] "Math Symbol"
         [Sc] "Currency Symbol"
         [Sk] "Modifier Symbol"
         [So] "Other Symbol"
         [Zs] "Space Separator"
         [Zl] "Line Separator"
         [Zp] "Paragraph Separator"
         [Cc] "Control"
         [Cf] "Format"
         [Cs] "Surrogate"
         [Co] "Private Use"
         [Cn] "Unassigned"
         | "Unknown"

   // Alphabetic letters (Lu, Ll, Lt, Lm, Lo)
   is_alpha: Rune => <>
   is_alpha = cp =>
      cat = category_id(cp)
      cat !> 4

   // Decimal digits (Nd)
   is_digit: Rune => <>
   is_digit = cp =>
      category_id(cp) == 8

   // Uppercase letters (Lu)
   is_upper: Rune => <>
   is_upper = cp =>
      category_id(cp) == 0

   // Lowercase letters (Ll)
   is_lower: Rune => <>
   is_lower = cp =>
      category_id(cp) == 1

   // Titlecase letters (Lt)
   is_title: Rune => <>
   is_title = cp =>
      category_id(cp) == 2

   // Whitespace: space separators (Zs, Zl, Zp) plus ASCII whitespace
   // (\t, \n, \v, \f, \r)
   is_space: Rune => <>
   is_space = cp =>
      cat = category_id(cp)
      (cat !< 22 && cat !> 24) || (cp == 0x20 || (cp !< 0x09 && cp !> 0x0D))

   // Punctuation (Pc, Pd, Ps, Pe, Pi, Pf, Po)
   is_punctuation: Rune => <>
   is_punctuation = cp =>
      cat = category_id(cp)
      cat !< 11 && cat !> 17

   // Symbols: math, currency, modifiers, others (Sm, Sc, Sk, So)
   is_symbol: Rune => <>
   is_symbol = cp =>
      cat = category_id(cp)
      cat !< 18 && cat !> 21

   // Combining marks: nonspacing, spacing, enclosing (Mn, Mc, Me)
   is_mark: Rune => <>
   is_mark = cp =>
      cat = category_id(cp)
      cat !< 5 && cat !> 7

   // Numbers: decimal digits, letter numbers, other numbers (Nd, Nl, No)
   is_number: Rune => <>
   is_number = cp =>
      cat = category_id(cp)
      cat !< 8 && cat !> 10

   // Control characters (Cc)
   is_control: Rune => <>
   is_control = cp =>
      category_id(cp) == 25

   // Graphic characters (letters, marks, numbers, punctuation, symbols)
   is_graphic: Rune => <>
   is_graphic = cp =>
      cat = category_id(cp)
      cat !> 22

   // Decode the UTF-8 rune at src[i] into its codepoint.
   decode_rune: String, Int => Rune
   decode_rune = src, i =>
      b0 = src(i)
      Rune(b0
         [< 0x80] b0
         [< 0xE0] (b0 - 0xC0) * 0x40 + (src(i + 1) - 0x80)
         [< 0xF0]
            (b0 - 0xE0) * 0x1000 + (src(i + 1) - 0x80) * 0x40 +
               (src(i + 2) - 0x80)
         |
            (b0 - 0xF0) * 0x40000 + (src(i + 1) - 0x80) * 0x1000 +
               (src(i + 2) - 0x80) * 0x40 + (src(i + 3) - 0x80)
      )

   // Byte width of a rune's UTF-8 encoding.
   utf8_width: Rune => Int
   utf8_width = r =>
      r [< 0x80] 1 [< 0x800] 2 [< 0x10000] 3 | 4

   // UAX #31: XID_Start characters (Lu, Ll, Lt, Lm, Lo, Nl)
   is_xid_start: Rune => <>
   is_xid_start = cp =>
      cat = category_id(cp)
      cat !> 4 || cat == 9

   // UAX #31: XID_Continue characters (Lu..Lo, Mn, Mc, Nd, Nl, Pc)
   is_xid_continue: Rune => <>
   is_xid_continue = cp =>
      cat = category_id(cp)
      cat !> 6 || cat == 8 || cat == 9 || cat == 11

   // Identifier start: XID_Start or '_'
   is_id_start: Rune => <>
   is_id_start = cp =>
      cp == '_' || is_xid_start(cp)

   // Identifier continuation: XID_Continue
   is_id_continue: Rune => <>
   is_id_continue = cp =>
      is_xid_continue(cp)

   // Decode the UTF-8 rune at Addr + i into its codepoint.
   decode_rune_addr: Addr, Int => Rune
   decode_rune_addr = p, i =>
      b0 = Int(@[p + i u8])
      Rune(b0
         [< 0x80] b0
         [< 0xE0] (b0 - 0xC0) * 0x40 + (Int(@[p + i + 1 u8]) - 0x80)
         [< 0xF0]
            (b0 - 0xE0) * 0x1000 + (Int(@[p + i + 1 u8]) - 0x80) * 0x40 +
               (Int(@[p + i + 2 u8]) - 0x80)
         |
            (b0 - 0xF0) * 0x40000 + (Int(@[p + i + 1 u8]) - 0x80) * 0x1000 +
               (Int(@[p + i + 2 u8]) - 0x80) * 0x40 + (Int(@[p + i + 3 u8]) - 0x80)
      )

   // Decode the UTF-8 rune at Builder buffer + i into its codepoint.
   decode_rune_builder: Builder, Int => Rune
   decode_rune_builder = b, i =>
      decode_rune_addr(&b, i)

   // Polymorphic UAX #31 identifier check for String, Builder, etc.
   is_uax31: #! T: Type, T => <>
   is_uax31 = #! T, target =>
      n = ?target
      n == 0 |->
      p = &target
      r0 = unicode::decode_rune_addr(p, 0)
      !unicode::is_id_start(r0) |->
      i' = ?r0
      0.. @
         i' !< n | -->
         r = unicode::decode_rune_addr(p, i')
         !unicode::is_id_continue(r) |->
         i' = i' + ?r
      <+>

   // Concrete monomorphic aliases
   is_uax31_str: String => <>
   is_uax31_str = s => unicode::is_uax31(s)

   is_uax31_builder: Builder => <>
   is_uax31_builder = b => unicode::is_uax31(b)

