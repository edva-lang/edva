// std/json.dva — JSON parser and value model.
//
// Error convention: every entry point returns `<Value | Error>` where the
// negative branch is the structural `Error` record (code, message, file,
// line, col, context) — *fatal* by design: unwrapping it (binding it in a
// choice) aborts the program and prints the diagnostic. Contrast with the
// recoverable `<T | String>` message regime in std/net (see M8 in
// process/codebase_review.md).
//
// A JSON document parses into a recursive `Value` enum: String(String),
// Number(Float), Boolean(<>), Null, Array(Value[]) and
// Object(pairs[]) where pairs are (key, value) records. Array/Object
// hold slice views over the parse arenas (`Values`/`Pairs` growable arrays),
// filled element-by-element. Parsing runs reentrantly over an instance-owned
// `Scanner` record `(src, pos)` allocated per parse invocation, with zero
// module-global mutable state. Errors use the core Error ram: `parse` returns
// `<Value | Error>`, and unwrapping the Error branch aborts with the diagnostic.

#use const
#use ascii
#use str
#use utf

#public
   #type Value <
      String(String)
      Number(Float)
      Boolean(<>)
      Null
      Array(Value[])
      Object((key: String, value: Value)[])
   >

   #type Values Value{}
   #type Pairs (key: String, value: Value){}
   #type Result <Value | Error>
   #type Cursor (src: String, pos: Int)

#type Scanner (src: String, pos: Int)

// --- scanning ------------------------------------------------

// True when sc.src[p] exists and is JSON whitespace.
is_ws_at: Scanner, Int => i1
is_ws_at = sc, p => p < ?sc.src && str::is_ws(sc.src(p))

// The first index at or after p that is not whitespace.
skip_ws: Scanner, Int => Int
skip_ws = sc, p =>
   is_ws_at(sc, p) | skip_ws(sc, p + 1) | p

// The value of a hex digit, or -1 when not a hex digit.
hexval: Int => Int
hexval = h =>
   ascii::hex_value(h) | _ | -1

// True when sc.src[p] exists and is a hex digit.
is_hex_at: Scanner, Int => <>
is_hex_at = sc, p => p < ?sc.src && ascii::is_hex(sc.src(p))

// The String spelling of a Flag boolean.
bool_str: i1 => String
bool_str = b => b | "true" | "false"

// --- string scanning ------------------------------------------------

// Validate and append a raw UTF-8 sequence starting at index k with lead byte c0.
scan_utf8_char: Scanner, Builder, Int, Int => <Int | Error>
scan_utf8_char = sc, b, k, _c0 =>
   dec = utf::decode_str_at(sc.src, k)
   dec.0 < 0
      | <- Error(400, "json: invalid UTF-8 in string", "std/json.dva", 0, 0, (k, 0)) +>
      |
         b += sc.src(k..k + dec.1)
         scan_string(sc, b, k + dec.1)

// Scan the body of a string literal starting at index k (after the
// opening quote), appending decoded bytes to b. Returns <Int | Error>:
// the positive slot is the index of the closing quote.
scan_string: Scanner, Builder, Int => <Int | Error>
scan_string = sc, b, k =>
   k !< ?sc.src | --| <- Error(400, "json: unterminated string", "std/json.dva", 0, 0, (k, 0)) +>
   c = sc.src(k)
   c
   ['"] <+ k ->
   ['\\] parse_escape(sc, b, k)
   [< 0x20] <- Error(400, "json: control character in string",
   "std/json.dva", 0, 0, (k, 0)) +>
   [< 0x80]
      b += c
      scan_string(sc, b, k + 1)
   |
      scan_utf8_char(sc, b, k, c)

// Handle a backslash escape at index k (k is the '\').
parse_escape: Scanner, Builder, Int => <Int | Error>
parse_escape = sc, b, k =>
   e = k + 1 [< ?sc.src] sc.src(k + 1) | -1
   e == 'u | --| parse_unicode(sc, b, k)
   b += (e
      ['", '\\, '/] e
      ['b] '\b
      ['f] '\f
      ['n] '\n
      ['r] '\r
      ['t] '\t
      | --| <- Error(400, "json: bad escape", "std/json.dva", 0, 0, (k, 0)) +>)
   scan_string(sc, b, k + 2)

// A \uXXXX escape at index k (k is the '\', k+1 is 'u'). Supports BMP
// and supplementary characters via UTF-16 surrogate pairs.
parse_unicode: Scanner, Builder, Int => <Int | Error>
parse_unicode = sc, b, k =>
   h2 = is_hex_at(sc, k + 2)
   h3 = is_hex_at(sc, k + 3)
   h4 = is_hex_at(sc, k + 4)
   h5 = is_hex_at(sc, k + 5)
   ok = h2 && h3 && h4 && h5
   ok |
      d2 = hexval(sc.src(k + 2))
      d3 = hexval(sc.src(k + 3))
      d4 = hexval(sc.src(k + 4))
      d5 = hexval(sc.src(k + 5))
      cp = d2 * 0x1000 + d3 * 0x100 + d4 * 0x10 + d5
      parse_unicode_cp(sc, b, k, cp)
   | <- Error(400, "json: bad \\u escape",
   "std/json.dva", 0, 0, (k, 0)) +>

parse_unicode_cp: Scanner, Builder, Int, Int => <Int | Error>
parse_unicode_cp = sc, b, k, cp =>
   cp
      [0xD800...0xDBFF] parse_surrogate_pair(sc, b, k, cp)
      [0xDC00...0xDFFF] <- Error(400, "json: unpaired low surrogate", "std/json.dva", 0, 0, (k, 0)) +>
      |
         utf::append_rune(b, Rune(cp))
         scan_string(sc, b, k + 6)

parse_surrogate_pair: Scanner, Builder, Int, Int => <Int | Error>
parse_surrogate_pair = sc, b, k, cp =>
   has_second = k + 11 < ?sc.src && sc.src(k + 6) == '\\ && sc.src(k + 7) == 'u && is_hex_at(sc, k + 8) && is_hex_at(sc, k + 9) && is_hex_at(sc, k + 10) && is_hex_at(sc, k + 11)
   has_second |
      l2 = hexval(sc.src(k + 8))
      l3 = hexval(sc.src(k + 9))
      l4 = hexval(sc.src(k + 10))
      l5 = hexval(sc.src(k + 11))
      locp = l2 * 0x1000 + l3 * 0x100 + l4 * 0x10 + l5
      locp [0xDC00...0xDFFF]
         full_cp = 0x10000 + (cp - 0xD800) * 0x400 + (locp - 0xDC00)
         utf::append_rune(b, Rune(full_cp))
         scan_string(sc, b, k + 12)
      | <- Error(400, "json: bad low surrogate", "std/json.dva", 0, 0, (k, 0)) +>
   | <- Error(400, "json: missing low surrogate", "std/json.dva", 0, 0, (k, 0)) +>

// --- number scanning ------------------------------------------------

// True when sc.src[p] exists and is a digit.
is_digit_at: Scanner, Int => i1
is_digit_at = sc, p => p < ?sc.src && str::is_digit(sc.src(p))

// --- value parsing ------------------------------------------------

scan_plain_ascii_end: String, Int => Int
scan_plain_ascii_end = src, start =>
   k' = start
   n = ?src
   #arch ["wasm32", "wasm64", "wasm"]
      0.. @
         k' !< n | -->
         c = src(k')
         c [0x20...0x7F] && c !['", '\\]
            | k' = k' + 1
            | -->
   |
      k' + 8 !> n
         |
            base = &src
            0.. @
               k' + 8 > n | -->
               w = @[base + k' u64]
               ctrl_or_hi = w .|. (w - 0x2020202020202020u64)
               x1 = w .^. 0x2222222222222222u64
               x2 = w .^. 0x5C5C5C5C5C5C5C5Cu64
               m1 = (x1 - 0x0101010101010101u64) .&. (.!. x1)
               m2 = (x2 - 0x0101010101010101u64) .&. (.!. x2)
               bad = (ctrl_or_hi .|. m1 .|. m2) .&. 0x8080808080808080u64
               bad != 0u64
                  |
                     // Subtraction can mark later lanes through borrow, but the
                     // first marked lane is exact in little-endian byte order.
                     #arch ["x86_64", "aarch64", "riscv64"]
                        --| k' + Int(%ctz(bad) .>. 3u64)
                     -->
               k' = k' + 8
      0.. @
         k' !< n | -->
         c = src(k')
         c [0x20...0x7F] && c !['", '\\]
            | k' = k' + 1
            | -->
   k'

parse_string_escaped: Scanner, Int, Int => <Value | Error>
parse_string_escaped = sc, start, plain_end =>
   sc.pos = start
   b = {64}
   plain_end > start | b += sc.src(start..plain_end)
   r = scan_string(sc, b, plain_end)
   r | end =>
      sc.pos = end + 1
      <+ Value(String, +b) ->
   | err =>
      <- err +>

parse_string: Scanner => <Value | Error>
parse_string = sc =>
   start = sc.pos + 1
   plain_end = scan_plain_ascii_end(sc.src, start)
   plain_end < ?sc.src && sc.src(plain_end) == '"
      |
         sc.pos = plain_end + 1
         <+ Value(String, sc.src(start..plain_end)) ->
      | parse_string_escaped(sc, start, plain_end)

parse_array: Scanner => <Value | Error>
parse_array = sc =>
   sc.pos = sc.pos + 1
   p = skip_ws(sc, sc.pos)
   sc.pos = p
   c = p [< ?sc.src] sc.src(p) | -1
   c [']]
      sc.pos = sc.pos + 1
      elems = Values()
      <+ Value(Array, elems(0..0)) ->
   |
      elems = Values()
      parse_array_loop(sc, elems)

parse_array_loop: Scanner, Values => <Value | Error>
parse_array_loop = sc, elems =>
   v = parse_value(sc)
   parse_array_after_value(sc, elems, v)

parse_array_after_value: Scanner, Values, <Value | Error> => <Value | Error>
parse_array_after_value = sc, elems, v =>
   v | val =>
      elems += val
      p = skip_ws(sc, sc.pos)
      sc.pos = p
      c = p [< ?sc.src] sc.src(p) | -1
      c [']]
         sc.pos = sc.pos + 1
         n = ?elems
         <+ Value(Array, elems(0..n)) ->
      [',]
         sc.pos = sc.pos + 1
         p2 = skip_ws(sc, sc.pos)
         c2 = p2 [< ?sc.src] sc.src(p2) | -1
         c2 [']]
            <- Error(400, "json: trailing comma in array", "std/json.dva", 0, 0, (p2, 0)) +>
         |
            parse_array_loop(sc, elems)
      |
         <- Error(400, "json: expected ',' or ']' in array", "std/json.dva", 0, 0, (p, 0)) +>
   | e => <- e +>

parse_object: Scanner => <Value | Error>
parse_object = sc =>
   sc.pos = sc.pos + 1
   p = skip_ws(sc, sc.pos)
   sc.pos = p
   c = p [< ?sc.src] sc.src(p) | -1
   c ['}]
      sc.pos = sc.pos + 1
      entries = Pairs()
      <+ Value(Object, entries(0..0)) ->
   |
      entries = Pairs()
      parse_object_loop(sc, entries)

parse_object_loop: Scanner, Pairs => <Value | Error>
parse_object_loop = sc, entries =>
   p = skip_ws(sc, sc.pos)
   sc.pos = p
   c = p [< ?sc.src] sc.src(p) | -1
   c ['"]
      k = parse_string(sc)
      parse_object_after_key(sc, entries, k)
   |
      <- Error(400, "json: expected string key in object", "std/json.dva", 0, 0, (p, 0)) +>

parse_object_after_key: Scanner, Pairs, <Value | Error> => <Value | Error>
parse_object_after_key = sc, entries, k =>
   k | key =>
      key [String s]
         p = skip_ws(sc, sc.pos)
         sc.pos = p
         ok_col = p < ?sc.src && sc.src(p) == ':
         ok_col |
            sc.pos = sc.pos + 1
            v = parse_value(sc)
            parse_object_after_val(sc, entries, s, v)
         | <- Error(400, "json: expected ':' after object key", "std/json.dva", 0, 0, (p, 0)) +>
      | <- Error(400, "json: object key is not a string", "std/json.dva", 0, 0, (0, 0)) +>
   | e => <- e +>

parse_object_after_val: Scanner, Pairs, String, <Value | Error> => <Value | Error>
parse_object_after_val = sc, entries, s, v =>
   v | val =>
      entries += (s, val)
      p = skip_ws(sc, sc.pos)
      sc.pos = p
      c = p [< ?sc.src] sc.src(p) | -1
      c ['}]
         sc.pos = sc.pos + 1
         m = ?entries
         <+ Value(Object, entries(0..m)) ->
      [',]
         sc.pos = sc.pos + 1
         p2 = skip_ws(sc, sc.pos)
         c2 = p2 [< ?sc.src] sc.src(p2) | -1
         c2 ['}]
            <- Error(400, "json: trailing comma in object", "std/json.dva", 0, 0, (p2, 0)) +>
         |
            parse_object_loop(sc, entries)
      |
         <- Error(400, "json: expected ',' or '}' in object", "std/json.dva", 0, 0, (p, 0)) +>
   | e2 => <- e2 +>

parse_lit: Scanner, <>, Int => <Value | Error>
parse_lit = sc, tag, len =>
   p = skip_ws(sc, sc.pos)
   sc.pos = p
   word = tag | "true" | "false"
   ok = p + len !> ?sc.src && sc.src(p..p + len) == word
   ok |
      sc.pos = p + len
      <+ Value(Boolean, tag) ->
   | <- Error(400, "json: bad literal", "std/json.dva", 0, 0, (p, 0)) +>

parse_null: Scanner => <Value | Error>
parse_null = sc =>
   p = skip_ws(sc, sc.pos)
   sc.pos = p
   ok = p + 4 !> ?sc.src && sc.src(p..p + 4) == "null"
   ok |
      sc.pos = p + 4
      <+ Value(Null) ->
   | <- Error(400, "json: bad null literal",
   "std/json.dva", 0, 0, (p, 0)) +>

parse_number: Scanner => <Value | Error>
parse_number = sc =>
   p' = skip_ws(sc, sc.pos)
   sc.pos = p'
   c0 = p' [< ?sc.src] sc.src(p') | -1
   is_num_start = c0 ['0...'9, '-]
   is_num_start |
      neg' = <->
      c0 ['-]
         neg' = <+>
         p' = p' + 1
      has_leading_zero = p' < ?sc.src && sc.src(p') == '0 && p' + 1 < ?sc.src && is_digit_at(sc, p' + 1)
      has_leading_zero |
         <- Error(400, "json: leading zero not allowed", "std/json.dva", 0, 0, (p', 0)) +>
      |
         p2' = p'
         had_int' = <->
         sig_digits' = 0
         fv' = 0.0
         exp10' = 0
         0.. @
            p2' !< ?sc.src | -->
            c = sc.src(p2')
            c ['0...'9]
               |
                  had_int' = <+>
                  d = c - '0
                  sig_digits' > 0 || d != 0
                     |
                        sig_digits' < 17
                           |
                              fv' = fv' * 10.0 + Float(d)
                              sig_digits' = sig_digits' + 1
                           |
                              exp10' = exp10' + 1
                  p2' = p2' + 1
               | -->
         has_dot = (p2' < ?sc.src && sc.src(p2') == '.)
         had_frac' = <->
         has_dot |
            p2' = p2' + 1
            0.. @
               p2' !< ?sc.src | -->
               c = sc.src(p2')
               c ['0...'9]
                  |
                     had_frac' = <+>
                     d = c - '0
                     (sig_digits' == 0 && d == 0)
                        |
                           exp10' = exp10' - 1
                        |
                           sig_digits' < 17 |
                              fv' = fv' * 10.0 + Float(d)
                              sig_digits' = sig_digits' + 1
                              exp10' = exp10' - 1
                     p2' = p2' + 1
                  | -->
         has_exp = (p2' < ?sc.src && (sc.src(p2') ['e, 'E]))
         had_exp' = <->
         has_exp |
            p3' = p2' + 1
            eneg' = <->
            e0 = p3' [< ?sc.src] sc.src(p3') | -1
            e0 ['-]
               eneg' = <+>
               p3' = p3' + 1
            plus = (e0 == '+)
            plus |
               p3' = p3' + 1
            ev' = 0
            over_exp' = <->
            had_exp_digits' = <->
            0.. @
               p3' !< ?sc.src | -->
               ec = sc.src(p3')
               ec ['0...'9]
                  |
                     had_exp_digits' = <+>
                     ed = ec - '0
                     ev' > 0xF4240
                        | (over_exp' = <+>)
                        | (ev' = ev' * 10 + ed)
                     p3' = p3' + 1
                  | -->
            had_exp' = had_exp_digits'
            p2' = p3'
            exp_val = over_exp' | 0xF4240 | ev'
            exp10' = eneg' | exp10' - exp_val | exp10' + exp_val
         fv' != 0.0 |
            eclamp = exp10' < -400 | -400 | (exp10' > 400 | 400 | exp10')
            abs_e = eclamp < 0 | 0 - eclamp | eclamp
            abs_e @
               fv' = eclamp < 0 | fv' / 10.0 | fv' * 10.0
         // JSON number grammar: -?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)? — digits
         // are required after '-', after '.', and after the exponent marker
         // (a bare '-', "1.", or "1e" must be rejected, not parsed as 0 / 1.0).
         valid = (had_int' && (!has_dot || had_frac') && (!has_exp || had_exp'))
         valid
            |
               f = (neg' | 0 - fv' | fv')
               sc.pos = p2'
               <+ Value(Number, f) ->
            |
               <- Error(400, "json: malformed number",
               "std/json.dva", 0, 0, (p', 0)) +>
   | <- Error(400, "json: expected a number",
   "std/json.dva", 0, 0, (p', 0)) +>

// --- entry point ------------------------------------------------

// Parse a JSON document into a Value. Errors (malformed input) land
// in the Error branch of the returned <Value | Error> ram.
#public
   parse: String => <Value | Error>
   parse = s =>
      sc = Scanner(s, 0)
      r = parse_value(sc)
      parse_finish(sc, r)

parse_finish: Scanner, <Value | Error> => <Value | Error>
parse_finish = sc, r =>
   r | val =>
      p = skip_ws(sc, sc.pos)
      p == ?sc.src |
         <+ val ->
      |
         <- Error(400, "json: trailing characters after value", "std/json.dva", 0, 0, (p, 0)) +>
   | err =>
      <- err +>

parse_value: Scanner => <Value | Error>
parse_value = sc =>
   p = skip_ws(sc, sc.pos)
   sc.pos = p
   c = p [< ?sc.src] sc.src(p) | -1
   c
   ['"] parse_string(sc)
   ['{] parse_object(sc)
   ['[] parse_array(sc)
   ['t] parse_lit(sc, <+>, 4)
   ['f] parse_lit(sc, <->, 5)
   ['n] parse_null(sc)
   | parse_number(sc)

// --- Value query and serialization helpers ----------------------------------

json_type_err: String => Error
json_type_err = msg =>
   Error(422, "json: " + msg, "std/json.dva", 0, 0, (0, 0))

hex_digit: Int => Int
hex_digit = n =>
   d = n .&. 0x0F
   d < 10 | '0 + d | 'a + (d - 10)

#public
   escape_string_into: Builder, String => ()
   escape_string_into = b, s =>
      b += '"
      s @ ch_ =>
         c = ch_ .&. 0xFF
         c
            ['"] b += "\\\""
            ['\\] b += "\\\\"
            ['\b] b += "\\b"
            ['\f] b += "\\f"
            ['\n] b += "\\n"
            ['\r] b += "\\r"
            ['\t] b += "\\t"
            [< 0x20]
               b += "\\u00"
               b += hex_digit(c .>. 4)
               b += hex_digit(c)
            | b += c
      b += '"

   escape_string: String => String
   escape_string = s =>
      b = {?s + 8}
      escape_string_into(b, s)
      +b

   format_number: Float => String
   format_number = f =>
      f != f | --| "null"
      f > const::max_f64 || f < -const::max_f64 | --| "null"
      iv = Int(f)
      Float(iv) == f && iv [-const::max_safe_int...const::max_safe_int]
         | str::from_int(iv)
         |
            s = str::from_float(f)
            s ["nan", "inf", "-inf"] "null" | s

stringify_into: Builder, Value => ()
stringify_into = b, val =>
   val
      [String s] escape_string_into(b, s)
      [Number n] b += format_number(n)
      [Boolean flag] b += (flag | "true" | "false")
      [Null] b += "null"
      [Array items]
         b += '[
         items @ item, i =>
            i > 0 | b += ',
            stringify_into(b, item)
         b += ']
      [Object pairs]
         b += '{
         pairs @ p, i =>
            i > 0 | b += ',
            escape_string_into(b, p.key)
            b += ':
            stringify_into(b, p.value)
         b += '}

append_indent: Builder, Int => ()
append_indent = b, spaces =>
   spaces @
      b += '\s

stringify_pretty_into: Builder, Value, Int, Int => ()
stringify_pretty_into = b, val, indent, depth =>
   val
      [String s] escape_string_into(b, s)
      [Number n] b += format_number(n)
      [Boolean flag] b += (flag | "true" | "false")
      [Null] b += "null"
      [Array items]
         ?items == 0
            | b += "[]"
            |
               b += "[\n"
               items @ item, i =>
                  i > 0 | b += ",\n"
                  append_indent(b, (depth + 1) * indent)
                  stringify_pretty_into(b, item, indent, depth + 1)
               b += '\n
               append_indent(b, depth * indent)
               b += ']
      [Object pairs]
         ?pairs == 0
            | b += "{}"
            |
               b += "{\n"
               pairs @ p, i =>
                  i > 0 | b += ",\n"
                  append_indent(b, (depth + 1) * indent)
                  escape_string_into(b, p.key)
                  b += ": "
                  stringify_pretty_into(b, p.value, indent, depth + 1)
               b += '\n
               append_indent(b, depth * indent)
               b += '}

#public
   stringify: Value => String
   stringify = val =>
      b = {128}
      stringify_into(b, val)
      +b

   stringify_pretty: Value, Int => String
   stringify_pretty = val, indent =>
      b = {256}
      stringify_pretty_into(b, val, indent, 0)
      +b

   get: Value, String => < Value | >
   get = val, key =>
      val
         [Object pairs]
            pairs @ p =>
               p.key == key | --| <+ p.value +>
            <-->
         | <-->

   has: Value, String => <>
   has = val, key =>
      <>(get(val, key))

   get_str: Value, String => < String | >
   get_str = val, key =>
      get(val, key)
         | fval =>
            fval [String s] <+ s +> | <-->
         | <-->

   get_int: Value, String => < Int | >
   get_int = val, key =>
      get(val, key)
         | fval =>
            fval
               [Number n]
                  iv = Int(n)
                  Float(iv) == n | <+ iv +> | <-->
               | <-->
         | <-->

   get_float: Value, String => < Float | >
   get_float = val, key =>
      get(val, key)
         | fval =>
            fval [Number n] <+ n +> | <-->
         | <-->

   get_bool: Value, String => < <> | >
   get_bool = val, key =>
      get(val, key)
         | fval =>
            fval [Boolean flag] <+ flag +> | <-->
         | <-->

   is_array: Value => <>
   is_array = val =>
      val [Array]

   array_len: Value => Int
   array_len = val =>
      val [Array items] ?items | 0

   array_at: Value, Int => Value
   array_at = val, idx =>
      val [Array items] items(idx) | Value(Null)

   is_object: Value => <>
   is_object = val =>
      val [Object]

   object_len: Value => Int
   object_len = val =>
      val [Object pairs] ?pairs | 0

   object_key_at: Value, Int => String
   object_key_at = val, idx =>
      val
         [Object pairs]
            p = pairs(idx)
            p.key
         | ""

   object_val_at: Value, Int => Value
   object_val_at = val, idx =>
      val
         [Object pairs]
            p = pairs(idx)
            p.value
         | Value(Null)

// --- Compile-time structural JSON codec (#param) ----------------------------

#public
   json_key_to_str: #param K: Type, K => String
   json_key_to_str = k =>
      K
         [String] k
         [Int, i8, i16, i32, i64, u8, u16, u32, u64] str::from_int(Int(k))
         [<>] (k | "true" | "false")
         [Rune] utf::encode_rune(k)
         | #name K

   to_value: #param T: Type, T => Value
   to_value = val =>
      T
         [Value] val
         [String] Value(String, val)
         [Int, i8, i16, i32, i64, u8, u16, u32, u64]
            Value(Number, Float(val))
         [Float, f32, f64]
            Value(Number, Float(val))
         [<>]
            Value(Boolean, val)
         [Rune]
            Value(String, utf::encode_rune(val))
         [()]
            Value(Null)
         [<P|>]
            (val | inner => to_value(P, inner) | Value(Null))
         [E{}]
            elems = Values()
            val @ item =>
               elems += to_value(E, item)
            n = ?elems
            Value(Array, elems(0..n))
         [E[]]
            elems = Values()
            val @ item =>
               elems += to_value(E, item)
            n = ?elems
            Value(Array, elems(0..n))
         [K ^ V]
            entries = Pairs()
            val @ v, k =>
               entries += (json_key_to_str(K, k), to_value(V, v))
            m = ?entries
            Value(Object, entries(0..m))
         [(..)]
            is_tuple' = <->
            #members T @ f =>
               f.idx == 0 && f.name == "" | is_tuple' = <+>
            is_tuple'
               |
                  elems = Values()
                  #members T @ f =>
                     f.type
                        [<P|>]
                           vf = #member val, f
                           ev = vf | inner => to_value(P, inner) | Value(Null)
                           elems += ev
                        |
                           elems += to_value(f.type, (#member val, f))
                  n = ?elems
                  Value(Array, elems(0..n))
               |
                  entries = Pairs()
                  #members T @ f =>
                     f.type
                        [<P|>]
                           vf = #member val, f
                           ev = vf | inner => to_value(P, inner) | Value(Null)
                           entries += (f.name, ev)
                        |
                           entries += (f.name, to_value(f.type, (#member val, f)))
                  m = ?entries
                  Value(Object, entries(0..m))
         [<..>]
            #members T @ v =>
               #member val, v
                  | pay =>
                     v.type
                        [()] --| Value(String, v.name)
                        |
                           entries = Pairs()
                           entries += (v.name, to_value(v.type, pay))
                           --| Value(Object, entries(0..1))
            Value(Null)
         | Value(Null)

   encode: #param T: Type, T => String
   encode = val =>
      stringify(to_value(T, val))

   encode_pretty: #param T: Type, T, Int => String
   encode_pretty = val, indent =>
      stringify_pretty(to_value(T, val), indent)

   is_valid_int_value: Value => <>
   is_valid_int_value = val =>
      val
         [Number n]
            iv = Int(n)
            Float(iv) == n
         | <->

   unwrap_int_or_zero: Value => Int
   unwrap_int_or_zero = val =>
      val
         [Number n] Int(n)
         | 0

   is_valid_float_value: Value => <>
   is_valid_float_value = val =>
      val [Number]

   unwrap_float_or_zero: Value => Float
   unwrap_float_or_zero = val =>
      val
         [Number n] n
         | 0.0

   decode_int_value: Value => < Int | Error >
   decode_int_value = val =>
      val
         [Number n]
            iv = Int(n)
            Float(iv) == n
               | <+ iv ->
               | <- json_type_err("expected integer") +>
         | <- json_type_err("expected integer") +>

   decode_float_value: Value => < Float | Error >
   decode_float_value = val =>
      val
         [Number n] <+ n ->
         | <- json_type_err("expected number") +>

   from_value: #param T: Type, Value => < T | Error >
   from_value = val =>
      T
         [Value]
            <+ val ->
         [String]
            val
               [String s] <+ s ->
               | <- json_type_err("expected string") +>
         [Int]
            decode_int_value(val)
         [Float]
            decode_float_value(val)
         [<>]
            val
               [Boolean flag] <+ flag ->
               | <- json_type_err("expected boolean") +>
         [<P|>]
            val
               [Null] <+ <--> ->
               |
                  P
                     [Int]
                        is_valid_int_value(val)
                           | <+ <+ unwrap_int_or_zero(val) +> ->
                           | <- json_type_err("expected integer") +>
                     [Float]
                        is_valid_float_value(val)
                           | <+ <+ unwrap_float_or_zero(val) +> ->
                           | <- json_type_err("expected number") +>
                     |
                        <+ <+ from_value(P, val)--! +> ->
         [E{}]
            !is_array(val)
               | <- json_type_err("expected array") +>
               |
                  arr' = #zero T
                  n_items = array_len(val)
                  0..n_items @ i =>
                     elem_val = array_at(val, i)
                     E
                        [Int]
                           is_valid_int_value(elem_val)
                              | arr' += unwrap_int_or_zero(elem_val)
                              | --| <- json_type_err("expected integer") +>
                        [Float]
                           is_valid_float_value(elem_val)
                              | arr' += unwrap_float_or_zero(elem_val)
                              | --| <- json_type_err("expected number") +>
                        |
                           arr' += from_value(E, elem_val)--!
                  <+ arr' ->
         [K ^ V]
            !is_object(val)
               | <- json_type_err("expected object") +>
               |
                  mp' = #zero T
                  n_pairs = object_len(val)
                  0..n_pairs @ i =>
                     pk = object_key_at(val, i)
                     pv = object_val_at(val, i)
                     k = from_value(K, Value(String, pk))--!
                     V
                        [Int]
                           is_valid_int_value(pv)
                              | mp' ^ k = unwrap_int_or_zero(pv)
                              | --| <- json_type_err("expected integer") +>
                        [Float]
                           is_valid_float_value(pv)
                              | mp' ^ k = unwrap_float_or_zero(pv)
                              | --| <- json_type_err("expected number") +>
                        |
                           mp' ^ k = from_value(V, pv)--!
                  <+ mp' ->
         [(..)]
            rec' = #zero T
            #members T @ f =>
               f.name == ""
                  |
                     !is_array(val) | --| <- json_type_err("expected array for tuple") +>
                     f.idx !< array_len(val) | --| <- json_type_err("tuple length mismatch") +>
                     pos_item = array_at(val, f.idx)
                     f.type
                        [Int]
                           is_valid_int_value(pos_item)
                              | #member rec', f = unwrap_int_or_zero(pos_item)
                              | --| <- json_type_err("expected integer") +>
                        [Float]
                           is_valid_float_value(pos_item)
                              | #member rec', f = unwrap_float_or_zero(pos_item)
                              | --| <- json_type_err("expected number") +>
                        |
                           #member rec', f = from_value(f.type, pos_item)--!
                  |
                     !is_object(val) | --| <- json_type_err("expected object for " + (#name T)) +>
                     get(val, f.name)
                        | fval =>
                           f.type
                              [Int]
                                 is_valid_int_value(fval)
                                    | #member rec', f = unwrap_int_or_zero(fval)
                                    | --| <- json_type_err("expected integer") +>
                              [Float]
                                 is_valid_float_value(fval)
                                    | #member rec', f = unwrap_float_or_zero(fval)
                                    | --| <- json_type_err("expected number") +>
                              |
                                 #member rec', f = from_value(f.type, fval)--!
                        |
                           f.default
                              | def => #member rec', f = def
                              |
                                 f.type
                                    [<P|>] #member rec', f = <-->
                                    [E{}] #member rec', f = #zero f.type
                                    [K ^ V] #member rec', f = #zero f.type
                                    | --| <- json_type_err("missing required key '" + f.name + "'") +>
            <+ rec' ->
         [<..>]
            val
               [String s]
                  #members T @ v =>
                     v.name == s |
                        v.type
                           [()] --| <+ (#member T, v) ->
                           | --| <- json_type_err("variant '" + s + "' of " + (#name T) + " requires a payload") +>
                  <- json_type_err("unknown variant '" + s + "' for " + (#name T)) +>
               |
                  !is_object(val)
                     | <- json_type_err("expected string or single-key object for " + (#name T)) +>
                     |
                        object_len(val) != 1
                           | <- json_type_err("expected single-key object for " + (#name T)) +>
                           |
                              p0_key = object_key_at(val, 0)
                              p0_val = object_val_at(val, 0)
                              #members T @ v =>
                                 v.name == p0_key |
                                    v.type
                                       [()] --| <+ (#member T, v) ->
                                       | --| <+ (#member T, v, from_value(v.type, p0_val)--!) ->
                              <- json_type_err("unknown variant '" + p0_key + "' for " + (#name T)) +>
         | <- json_type_err("unsupported target type " + (#name T) + " in json::decode") +>

   decode: #param T: Type, String => < T | Error >
   decode = s =>
      parse(s)
         | val => from_value(T, val)
         | err => <- err +>

// --- Streaming pull scanner / cursor API ------------------------------------

#private
   cursor_skip_str: String, Int => < Int | >
   cursor_skip_str = src, start =>
      n = ?src
      k' = scan_plain_ascii_end(src, start)
      0.. @
         k' !< n | --| <-->
         c = src(k')
         c
            ['"] --| <+ k' + 1 +>
            ['\\]
               k' + 1 !< n | --| <-->
               k' = k' + 2
            | k' = k' + 1
      <-->

   cursor_read_str_escaped: Cursor, Int, Int => < String | >
   cursor_read_str_escaped = cur, start, plain_end =>
      sc = Scanner(cur.src, start)
      b = {64}
      plain_end > start | b += cur.src(start..plain_end)
      scan_string(sc, b, plain_end)
         | end =>
            cur.pos = end + 1
            <+ +b +>
         | <-->

   cursor_skip_compound: Cursor, Int => <>
   cursor_skip_compound = cur, p =>
      src = cur.src
      n = ?src
      k' = p + 1
      depth' = 1
      0.. @
         k' !< n | --| <->
         ch = src(k')
         ch
            ['"]
               cursor_skip_str(src, k' + 1)
                  | end => k' = end
                  | --| <->
            ['{, '[]
               depth' = depth' + 1
               k' = k' + 1
            ['}, ']]
               depth' = depth' - 1
               k' = k' + 1
               depth' == 0 |
                  cur.pos = k'
                  --| <+>
            | k' = k' + 1
      <->

   cursor_skip_number: Cursor, Int, Int => <>
   cursor_skip_number = cur, p, c0 =>
      src = cur.src
      n = ?src
      has_digit = c0 ['0...'9] || (p + 1 < n && src(p + 1) ['0...'9])
      !has_digit | --| <->
      k' = p + 1
      0.. @
         k' !< n | -->
         src(k') ['0...'9, '+, '-, '., 'e, 'E]
            | k' = k' + 1
            | -->
      cur.pos = k'
      <+>

#public
   cursor: String => Cursor
   cursor = s => Cursor(s, 0)

   cursor_reset: Cursor, String => ()
   cursor_reset = cur, s =>
      cur.src = s
      cur.pos = 0

   cursor_skip_ws: Cursor => Int
   cursor_skip_ws = cur =>
      src = cur.src
      p' = cur.pos
      n = ?src
      0.. @
         p' !< n | -->
         str::is_ws(src(p')) | p' = p' + 1 | -->
      cur.pos = p'
      p'

   cursor_eof: Cursor => <>
   cursor_eof = cur =>
      cursor_skip_ws(cur) !< ?cur.src

   cursor_peek: Cursor => Int
   cursor_peek = cur =>
      src = cur.src
      p = cursor_skip_ws(cur)
      p < ?src | src(p) | -1

   cursor_expect_byte: Cursor, Int => <>
   cursor_expect_byte = cur, ch =>
      src = cur.src
      n = ?src
      at = cur.pos
      // Whitespace arguments must retain the skip-before-match behavior.
      p = at < n && src(at) == ch && !str::is_ws(ch)
         | at
         | cursor_skip_ws(cur)
      p < n && src(p) == ch
         |
            cur.pos = p + 1
            <+>
         | <->

   cursor_enter_object: Cursor => <>
   cursor_enter_object = cur => cursor_expect_byte(cur, '{)

   cursor_enter_array: Cursor => <>
   cursor_enter_array = cur => cursor_expect_byte(cur, '[)

   cursor_read_str: Cursor => < String | >
   cursor_read_str = cur =>
      src = cur.src
      n = ?src
      at = cur.pos
      p = at < n && src(at) == '\"
         | at
         | cursor_skip_ws(cur)
      p !< n || src(p) != '" | --| <-->
      start = p + 1
      plain_end = scan_plain_ascii_end(src, start)
      plain_end < n && src(plain_end) == '"
         |
            cur.pos = plain_end + 1
            --| <+ src(start..plain_end) +>
      cursor_read_str_escaped(cur, start, plain_end)

   cursor_next_field: Cursor => < String | >
   cursor_next_field = cur =>
      src = cur.src
      n = ?src
      at = cur.pos
      p = at < n && (src(at) ['\", ',, '}])
         | at
         | cursor_skip_ws(cur)
      p !< n | --| <-->
      c = src(p)
      c ['}]
         cur.pos = p + 1
         --| <-->
      c [',]
         cur.pos = p + 1
         at2 = cur.pos
         p2 = at2 < n && src(at2) == '\"
            | at2
            | cursor_skip_ws(cur)
         p2 !< n || src(p2) == '} | --| <-->
      cursor_read_str(cur)
         | k =>
            cursor_expect_byte(cur, ':)
               | <+ k +>
               | <-->
         | <-->

   cursor_read_int: Cursor => < Int | >
   cursor_read_int = cur =>
      src = cur.src
      p0 = cursor_skip_ws(cur)
      n = ?src
      p0 !< n | --| <-->
      p' = p0
      neg' = <->
      src(p') ['-]
         neg' = <+>
         p' = p' + 1
      p' !< n | --| <-->
      c0 = src(p')
      c0 !['0...'9] | --| <-->
      c0 ['0] && p' + 1 < n && ascii::is_digit(src(p' + 1)) | --| <-->
      v' = 0
      0.. @
         p' !< n | -->
         c = src(p')
         c ['0...'9]
            |
               v' = v' * 10 + (c - '0)
               p' = p' + 1
            | -->
      p' < n && src(p') ['., 'e, 'E] | --| <-->
      cur.pos = p'
      <+ (neg' | 0 - v' | v') +>

   cursor_read_bool: Cursor => < <> | >
   cursor_read_bool = cur =>
      src = cur.src
      p = cursor_skip_ws(cur)
      n = ?src
      p + 4 !> n && src(p..p + 4) == "true"
         |
            cur.pos = p + 4
            --| <+ <+> +>
      p + 5 !> n && src(p..p + 5) == "false"
         |
            cur.pos = p + 5
            --| <+ <-> +>
      <-->

   cursor_skip_value: Cursor => <>
   cursor_skip_value = cur =>
      src = cur.src
      p = cursor_skip_ws(cur)
      n = ?src
      p !< n | --| <->
      c0 = src(p)
      c0
         ['"]
            cursor_skip_str(src, p + 1)
               | end =>
                  cur.pos = end
                  <+>
               | <->
         ['{, '[] cursor_skip_compound(cur, p)
         ['t]
            p + 4 !> n && src(p..p + 4) == "true"
               |
                  cur.pos = p + 4
                  <+>
               | <->
         ['f]
            p + 5 !> n && src(p..p + 5) == "false"
               |
                  cur.pos = p + 5
                  <+>
               | <->
         ['n]
            p + 4 !> n && src(p..p + 4) == "null"
               |
                  cur.pos = p + 4
                  <+>
               | <->
         ['0...'9, '-] cursor_skip_number(cur, p, c0)
         | <->
