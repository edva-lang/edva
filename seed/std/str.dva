// Standard String Module (std/str.dva)
//
// Byte-oriented string helpers for writing a lexer in dva: predicates
// (is_*), single-byte/count conversions (from_*, to_*, from_int), and the
// Digit-scan primitives. Strings are fat { len, data } byte sequences; bytes
// are Int. Predicates return ramifications (<+> in / <-> out), never Int
// flags. "to_int"/"to_hex" return the declared RamPN ram "Digits":
// Some((value, rest-of-string view)) — the positive, payload-carrying branch —
// or None (the negative unit) when there are no digits to consume.

// --- is_* predicates (ASCII byte level) ---
// Comparisons and && / || already yield ramifications, so a predicate is just
// the boolean expression — no "| <+> | <->" identity scaffolding needed.

#use ascii
#use const
#use unicode
#use utf

#public
   is_digit: Int => <>
   is_digit = c => ascii::is_digit(c)

   is_alpha: Int => <>
   is_alpha = c => ascii::is_alpha(c)

   is_alnum: Int => <>
   is_alnum = c => ascii::is_alnum(c)

   is_ws: Int => <>
   is_ws    = ['\s, '\t, '\n, '\r]

   is_hex: Int => <>
   is_hex   = c => ascii::is_hex(c)

   // --- conversion ---

   // One byte as a 1-byte owned string.
   from_byte: Int => String
   from_byte = b =>
      out = {1}
      out += b
      +out

   // Int to ASCII decimal, as a proper fat String { len, data }. Digits are
   // pushed LSD-first into a Builder, the sign (if any) appended last, then the
   // reversed buffer is reversed into a fresh Builder — Strings and Builders
   // only write forward (B8), so MSD-first output is a two-pass reverse.
   from_int: Int => String
   from_int = v =>
      v [0] --| "0"
      v == const::min_i64 | --| "-9223372036854775808"
      b = {32}
      n' = v [< 0] 0 - v | v
      32 @
         n' [> 0]
            b += ('0 + (n' % 10))
            n' = n' / 10
         | -->
      v < 0 | b += '-
      s = +b
      out = {32}
      ?s @ i =>
         out += s((?s) - 1 - i)
      +out

   from_u64: u64 => String
   from_u64 = v =>
      v [0] --| "0"
      b = {32}
      n' = v
      32 @
         n' [> 0]
            b += ('0 + Int(n' % 10u64))
            n' = n' / 10u64
         | -->
      s = +b
      out = {32}
      ?s @ i =>
         out += s((?s) - 1 - i)
      +out

   // Float to decimal String, "%g"-style: 6 significant digits, fixed notation
   // for exponent in [-4, 5], scientific ("d.ddddd" e ±exp) otherwise; the
   // fractional part is trimmed of trailing zeros. Deterministic.
   // (For an EXACT, side-comparable spelling — e.g. the AST differential dump — serialize the
   // float's raw bits instead; this is the human-readable form.)
   from_float: Float => String
   from_float = v =>
      v != v | --| "nan"
      v > const::max_f64 | --| "inf"
      v < -const::max_f64 | --| "-inf"
      neg = v < 0.0
      a = neg | 0.0 - v | v
      a == 0.0 | --| (1.0 / v < 0.0 | "-0" | "0")
      x' = a
      e' = 0
      0.. @
         x' !< 10.0
            |
               x' = x' / 10.0
               e' = e' + 1
            | -->
      0.. @
         x' < 1.0
            |
               x' = x' * 10.0
               e' = e' - 1
            | -->
      ip = Int(x')
      f' = x' - Float(ip)
      ds = {16}
      ds += ('0 + ip)
      0..6 @ i =>
         f' = f' * 10.0
         d = Int(f')
         ds += ('0 + d)
         f' = f' - Float(d)
      s = +ds
      m' = 0
      0..6 @ i =>
         m' = m' * 10 + (s(i) - '0)
      s(6) !< 53
         |
            m' = m' + 1
      m' == 1000000
         |
            m' = 100000
            e' = e' + 1
      ms = str::from_int(m')
      b = {32}
      neg | b += '-
      e' < -4 || e' !< 6
         |
            b += ms(0)
            b += '.
            1..6 @ i =>
               b += ms(i)
         |
            e' !< 0
               |
                  en = e' + 1
                  0..en @ i =>
                     b += ms(i)
                  en < 6
                     |
                        b += '.
                        en..6 @ i =>
                           b += ms(i)
               |
                  b += "0."
                  (0 - e' - 1) @ i =>
                     b += '0
                  0..6 @ i =>
                     b += ms(i)
      full = +b
      dot_pos' = -1
      ?full @ i =>
         full(i) == '. | dot_pos' = i
      len = ?full
      end' = len
      dot_pos' !< 0
         |
            0.. @
               end' - 1 > dot_pos' && full(end' - 1) == '0
                  |
                     end' = end' - 1
                  |
                     -->
            end' - 1 == dot_pos'
               |
                  end' = dot_pos'
      mant = full(0..end')
      es = e' < 0 | "-" + str::from_int(0 - e') | str::from_int(e')
      e' < -4 || e' !< 6
         | mant + "e" + es
         | mant

   // --- ordering ---

   // Bytewise lexicographic three-way: -1 (a < b), 0 (a == b), 1 (a > b).
   // memcmp-style: the shared prefix is skipped, then the first differing byte decides;
   // otherwise the shorter string is the smaller.
   cmp: String, String => Int
   cmp = a, b =>
      la = ?a
      lb = ?b
      n = la < lb | la | lb
      r' = 0
      0..n @ i =>
         ca = a(i)
         cb = b(i)
         ca != cb
            |
               r' = ca < cb | -1 | 1
               -->
      r' != 0 | r' | (la == lb | 0 | (la < lb | -1 | 1))

   // "a < b" as a bare Flag — the less-than predicate a sort comparator wants.
   lt: String, String => <>
   lt = a, b => str::cmp(a, b) < 0

   // RamPN: Some((value, rest-of-string view)) | None (no digits).
   #type Digits < (Int, String) | >

   // Consume leading decimal digits; the payload is (value, unconsumed rest).
   to_int: String => Digits
   to_int = s =>
      val' = 0
      s @ b, i =>
         !str::is_digit(b) | -->
         val' = val' * 10 + (b - '0)
      i [0] --| Digits(<-->)
      Digits(<+ (val', s(i..)) +>)

   // Consume leading hex digits (0-9, a-f, A-F); the payload is (value, rest).
   to_hex: String => Digits
   to_hex = s =>
      val' = 0
      s @ b, i =>
         ascii::hex_value(b)
            | d => val' = val' * 16 + d
            | -->
      i [0] --| Digits(<-->)
      Digits(<+ (val', s(i..)) +>)

   // Int to base-16 hex ASCII string (uppercase, "0x" prefix). Digits are
   // pushed LSD-first into a Builder, the "x"/"0" prefix appended last, then
   // the reversed buffer is reversed into a fresh Builder.
   hex_to_str: Int => String
   hex_to_str = val =>
      val [0] --| "0x0"
      b = {32}
      neg = val < 0
      n' = neg | u64(0 - val) | u64(val)
      32 @
         n' [> 0u64]
            digit = Int(n' .&. 15u64)
            ch = ascii::hex_char_upper(digit)
            b += ch
            n' = n' .>. 4u64
         | -->
      b += 'x
      b += '0
      neg | b += '-
      s = +b
      out = {32}
      ?s @ i =>
         out += s((?s) - 1 - i)
      +out

   #type Strings String{}

   // --- searching & predicates ---

   is_empty: String => <>
   is_empty = s => ?s == 0

   is_blank: String => <>
   is_blank = s =>
      blank' = <+>
      ?s @ i =>
         !str::is_ws(s(i)) | (blank' = <->; -->)
      blank'

   starts_with: String, String => <>
   starts_with = s, prefix =>
      lp = ?prefix
      lp == 0
         | <+>
         | (?s !< lp && s(0..lp) == prefix)

   ends_with: String, String => <>
   ends_with = s, suffix =>
      ls = ?s
      lf = ?suffix
      lf == 0
         | <+>
         | (ls !< lf && s((ls - lf)..ls) == suffix)

   find_from: String, String, Int => < Int | >
   find_from = s, needle, start =>
      ls = ?s
      ln = ?needle
      st = start < 0 | 0 | start
      ln == 0
         | (st !> ls | <+ st +> | <-->)
         |
            st + ln > ls
               | <-->
               |
                  limit = ls - ln + 1
                  first_b = needle(0)
                  res' = <-->
                  st..limit @ i =>
                     s(i) == first_b && s(i..(i + ln)) == needle
                        |
                           res' = <+ i +>
                           -->
                  res'

   find: String, String => < Int | >
   find = s, needle => str::find_from(s, needle, 0)

   rfind: String, String => < Int | >
   rfind = s, needle =>
      ls = ?s
      ln = ?needle
      ln == 0
         | <+ ls +>
         |
            ln > ls
               | <-->
               |
                  span = ls - ln + 1
                  first_b = needle(0)
                  res' = <-->
                  span @ k =>
                     i = ls - ln - k
                     s(i) == first_b && s(i..(i + ln)) == needle
                        |
                           res' = <+ i +>
                           -->
                  res'

   contains: String, String => <>
   contains = s, needle => <>(str::find(s, needle))

   count: String, String => Int
   count = s, needle =>
      ln = ?needle
      ln == 0
         | 0
         |
            ls = ?s
            pos' = 0
            n' = 0
            0.. @
               pos' + ln > ls | -->
               str::find_from(s, needle, pos')
                  | idx =>
                     n' = n' + 1
                     pos' = idx + ln
                  | -->
            n'

   // --- trimming ---

   trim_start: String => String
   trim_start = s =>
      len = ?s
      i' = 0
      len @ k =>
         str::is_ws(s(k))
            | i' = k + 1
            | -->
      i' == 0 | s | s(i'..len)

   trim_end: String => String
   trim_end = s =>
      len = ?s
      end' = len
      len @ k =>
         idx = len - 1 - k
         str::is_ws(s(idx))
            | end' = idx
            | -->
      end' == len | s | s(0..end')

   trim: String => String
   trim = s => str::trim_end(str::trim_start(s))

   trim_prefix: String, String => String
   trim_prefix = s, prefix =>
      str::starts_with(s, prefix)
         | s(?prefix..?s)
         | s

   trim_suffix: String, String => String
   trim_suffix = s, suffix =>
      str::ends_with(s, suffix)
         | s(0..(?s - ?suffix))
         | s

   // --- splitting & joining ---

   split_once: String, String => < (String, String) | >
   split_once = s, sep =>
      str::find(s, sep) $+> idx => (s(0..idx), s((idx + ?sep)..?s))

   split: String, String => Strings
   split = s, sep =>
      out = Strings()
      ls = ?s
      lsep = ?sep
      lsep == 0
         |
            ls @ i =>
               out += s(i..(i + 1))
            out
         |
            pos' = 0
            0.. @
               str::find_from(s, sep, pos')
                  | idx =>
                     out += s(pos'..idx)
                     pos' = idx + lsep
                  |
                     out += s(pos'..ls)
                     -->
            out

   lines: String => Strings
   lines = s =>
      out = Strings()
      ls = ?s
      ls == 0 | --| out
      start' = 0
      ls @ i =>
         s(i) == '\n
            |
               end = (i > start' && s(i - 1) == '\r) | i - 1 | i
               out += s(start'..end)
               start' = i + 1
      start' < ls
         |
            end = (ls > start' && s(ls - 1) == '\r) | ls - 1 | ls
            out += s(start'..end)
      out

   words: String => Strings
   words = s =>
      out = Strings()
      ls = ?s
      i' = 0
      0.. @
         i' !< ls | -->
         0.. @
            (i' < ls && str::is_ws(s(i')))
               | i' = i' + 1
               | -->
         i' !< ls | -->
         start = i'
         0.. @
            (i' < ls && !str::is_ws(s(i')))
               | i' = i' + 1
               | -->
         out += s(start..i')
      out

   join: Strings, String => String
   join = parts, sep =>
      n = ?parts
      n == 0 | --| ""
      n == 1 | --| parts(0)!!
      lsep = ?sep
      total = ((n - 1) * lsep, parts) @> acc, p => acc + ?p
      b = {total + 1}
      parts @ p, i =>
         i > 0 && lsep > 0 | b += sep
         b += p
      +b

   // --- case, replacement, padding, repeating ---

   lower: String => String
   lower = s =>
      len = ?s
      len == 0 | --| ""
      b = {len + 8}
      i' = 0
      0.. @
         i' !< len | -->
         b0 = s(i')
         b0 < 0x80
            |
               b += ascii::to_lower(b0)
               i' = i' + 1
            |
               (cp, width) = utf::decode_str_at(s, i')
               cp < 0
                  |
                     b += b0
                     i' = i' + 1
                  |
                     utf::append_rune(b, unicode::to_lower(Rune(cp)))
                     i' = i' + width
      +b

   upper: String => String
   upper = s =>
      len = ?s
      len == 0 | --| ""
      b = {len + 8}
      i' = 0
      0.. @
         i' !< len | -->
         b0 = s(i')
         b0 < 0x80
            |
               b += ascii::to_upper(b0)
               i' = i' + 1
            |
               (cp, width) = utf::decode_str_at(s, i')
               cp < 0
                  |
                     b += b0
                     i' = i' + 1
                  |
                     cp == 0x00DF
                        | b += "SS"
                        | utf::append_rune(b, unicode::to_upper(Rune(cp)))
                     i' = i' + width
      +b

   repeat: String, Int => String
   repeat = s, n =>
      len = ?s
      (n !> 0 || len == 0) | --| ""
      n == 1 | --| s
      b = {len * n}
      n @
         b += s
      +b

   pad_left: String, Int, Int => String
   pad_left = s, width, pad_byte =>
      len = ?s
      len !< width | --| s
      pad_n = width - len
      b = {width}
      pad_n @
         b += pad_byte
      b += s
      +b

   pad_right: String, Int, Int => String
   pad_right = s, width, pad_byte =>
      len = ?s
      len !< width | --| s
      pad_n = width - len
      b = {width}
      b += s
      pad_n @
         b += pad_byte
      +b

   reverse: String => String
   reverse = s =>
      len = ?s
      len !> 1 | --| s
      b = {len}
      len @ i =>
         b += s(len - 1 - i)
      +b

   replace_first: String, String, String => String
   replace_first = s, old, new_s =>
      ?old == 0 | --| s
      str::find(s, old)
         | idx =>
            ls = ?s
            lo = ?old
            b = {ls - lo + ?new_s}
            idx > 0 | b += s(0..idx)
            b += new_s
            after = idx + lo
            after < ls | b += s(after..ls)
            +b
         | s

   replace: String, String, String => String
   replace = s, old, new_s =>
      lo = ?old
      lo == 0 | --| s
      ls = ?s
      str::find(s, old)
         | first_idx =>
            b = {ls + 16}
            first_idx > 0 | b += s(0..first_idx)
            b += new_s
            pos' = first_idx + lo
            0.. @
               pos' !< ls | -->
               str::find_from(s, old, pos')
                  | idx =>
                     idx > pos' | b += s(pos'..idx)
                     b += new_s
                     pos' = idx + lo
                  |
                     b += s(pos'..ls)
                     -->
            +b
         | s

   // --- full signed integer & float parsing ---

   parse_int: String => < Int | >
   parse_int = raw =>
      s = str::trim(raw)
      len = ?s
      len == 0 | --| <-->
      neg = s(0) == '-
      has_sign = neg || s(0) == '+
      start = has_sign | 1 | 0
      start !< len | --| <-->
      body = s(start..len)
      lbody = ?body
      is_hex_pfx = lbody > 2 && body(0) == '0 && (body(1) ['x, 'X])
      is_bin_pfx = lbody > 2 && body(0) == '0 && (body(1) ['b, 'B])
      is_hex_pfx
         |
            str::to_hex(body(2..lbody))
               | d =>
                  ?d.1 == 0
                     | <+ (neg | -d.0 | d.0) +>
                     | <-->
               | <-->
         |
            is_bin_pfx
               |
                  val' = 0
                  ok' = <+>
                  2..lbody @ i =>
                     ch = body(i)
                     (ch == '0 || ch == '1)
                        | val' = val' * 2 + (ch - '0)
                        | (ok' = <->; -->)
                  ok'
                     | <+ (neg | -val' | val') +>
                     | <-->
               |
                  str::to_int(body)
                     | d =>
                        ?d.1 == 0
                           | <+ (neg | -d.0 | d.0) +>
                           | <-->
                     | <-->

   parse_float: String => < Float | >
   parse_float = raw =>
      s = str::trim(raw)
      len = ?s
      len == 0 | --| <-->
      i' = 0
      neg = s(0) == '-
      (neg || s(0) == '+) | i' = 1
      i' !< len | --| <-->
      int_val' = 0.0
      digits' = 0
      0.. @
         (i' < len && str::is_digit(s(i')))
            |
               int_val' = int_val' * 10.0 + Float(s(i') - '0)
               digits' = digits' + 1
               i' = i' + 1
            | -->
      frac_val' = 0.0
      frac_scale' = 1.0
      (i' < len && s(i') == '.)
         |
            i' = i' + 1
            0.. @
               (i' < len && str::is_digit(s(i')))
                  |
                     frac_val' = frac_val' * 10.0 + Float(s(i') - '0)
                     frac_scale' = frac_scale' * 10.0
                     digits' = digits' + 1
                     i' = i' + 1
                  | -->
      digits' == 0 | --| <-->
      res' = int_val' + frac_val' / frac_scale'
      (i' < len && (s(i') ['e, 'E]))
         |
            i' = i' + 1
            i' !< len | --| <-->
            exp_neg = s(i') == '-
            (exp_neg || s(i') == '+) | i' = i' + 1
            i' !< len | --| <-->
            exp_val' = 0
            exp_digits' = 0
            0.. @
               (i' < len && str::is_digit(s(i')))
                  |
                     exp_val' = exp_val' * 10 + (s(i') - '0)
                     exp_digits' = exp_digits' + 1
                     i' = i' + 1
                  | -->
            exp_digits' == 0 |-->
            pow10 = %pow(10.0, Float(exp_neg | -exp_val' | exp_val'))
            res' = res' * pow10
      i' != len
         | <-->
         | <+ (neg | -res' | res') +>
