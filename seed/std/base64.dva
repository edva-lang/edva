// Standard RFC 4648 Base64 & Base64URL Module (std/base64.dva)
// Standard and URL-safe Base64 encoding and decoding parameterized by `Flavor`.

#public

#type Flavor < Std, Url >

// Maps a 6-bit value (`0..63`) to its RFC 4648 Base64 (`Std`: `+/`) or Base64URL (`Url`: `-_`) ASCII character.
char: Int, Flavor => Int
char = idx, flavor =>
   (idx .&. 63)
      [0...25]  'A + (idx .&. 63)
      [26...51] 'a + ((idx .&. 63) - 26)
      [52...61] '0 + ((idx .&. 63) - 52)
      [62]      (flavor [Url] '- | '+)
      |         (flavor [Url] '_ | '/)

// Decodes an RFC 4648 Base64 (`Std`: `+/`) or Base64URL (`Url`: `-_`) ASCII character into `0..63`, or `-1` if invalid.
val: Int, Flavor => Int
val = c, flavor =>
   c
      ['A...'Z] c - 'A
      ['a...'z] c - 'a + 26
      ['0...'9] c - '0 + 52
      ['+]       (flavor [Std] 62 | -1)
      ['/]       (flavor [Std] 63 | -1)
      ['-]       (flavor [Url] 62 | -1)
      ['_]       (flavor [Url] 63 | -1)
      |           -1

// Returns `<+>` if `s` is non-empty and consists strictly of unpadded Base64 characters for `flavor`.
is_valid: String, Flavor => <>
is_valid = s, flavor =>
   ?s == 0 |->
   s @ ch =>
      val(ch, flavor) < 0 |->
   <+>

// Encodes `number` as `desired_length` Base64 characters (6 bits per character, most-significant sextet first).
from_int: Int, Int, Flavor => String
from_int = number, desired_length, flavor =>
   desired_length !> 0 | --| ""
   b = {desired_length}
   desired_length @ i =>
      shift = (desired_length - 1 - i) * 6
      b += char((number .>. shift) .&. 63, flavor)
   +b

// Decodes a Base64 character sequence (6 bits per character, most-significant sextet first) into an `Int`.
to_int: String, Flavor => < Int | >
to_int = s, flavor =>
   ?s == 0 |-->
   acc' = 0
   s @ ch =>
      v = val(ch, flavor)
      v < 0 |-->
      acc' = (acc' .<. 6) .|. v
   <+ acc' +>

#private

b64_err: String, Int => Error
b64_err = msg, col =>
   Error(400, "base64: " + msg, "std/base64.dva", 1, col + 1, (col, 0))

#public

// Encodes `bytes` into Base64 for `flavor` (`Std` pads with `=`, `Url` is unpadded).
encode: String, Flavor => String
encode = bytes, flavor =>
   n = ?bytes
   n == 0 | --| ""
   pad = flavor [Std]
   full_groups = n / 3
   rem = n % 3
   out_cap = (full_groups + (rem > 0 | 1 | 0)) * 4
   b = {out_cap}
   full_groups @ g =>
      base = g * 3
      b0 = bytes(base) .&. 0xFF
      b1 = bytes(base + 1) .&. 0xFF
      b2 = bytes(base + 2) .&. 0xFF
      triple = (b0 .<. 16) .|. (b1 .<. 8) .|. b2
      c0 = (triple .>. 18) .&. 0x3F
      c1 = (triple .>. 12) .&. 0x3F
      c2 = (triple .>. 6) .&. 0x3F
      c3 = triple .&. 0x3F
      b += (char(c0, flavor), char(c1, flavor), char(c2, flavor), char(c3, flavor))
   rem == 1
      |
         b0 = bytes(full_groups * 3) .&. 0xFF
         c0 = (b0 .>. 2) .&. 0x3F
         c1 = (b0 .&. 0x03) .<. 4
         b += (char(c0, flavor), char(c1, flavor))
         pad | b += "=="
   rem == 2
      |
         base = full_groups * 3
         b0 = bytes(base) .&. 0xFF
         b1 = bytes(base + 1) .&. 0xFF
         c0 = (b0 .>. 2) .&. 0x3F
         c1 = ((b0 .&. 0x03) .<. 4) .|. ((b1 .>. 4) .&. 0x0F)
         c2 = (b1 .&. 0x0F) .<. 2
         b += (char(c0, flavor), char(c1, flavor), char(c2, flavor))
         pad | b += '=
   +b

// Decodes a Base64 string into raw bytes for `flavor` (`Std` requires `=` padding, `Url` accepts padded or unpadded).
decode: String, Flavor => < String | Error >
decode = s, flavor =>
   // Strip ASCII whitespace first
   clean_b = {?s}
   ?s @ i =>
      ch = s(i)
      !(ch ['\s, '\t, '\n, '\r]) | clean_b += ch
   clean = +clean_b
   n = ?clean
   n == 0 | --| <+ "" ->
   require_pad = flavor [Std]
   require_pad && (n % 4 != 0) | --| <- b64_err("invalid base64 length (must be a multiple of 4)", n) +>
   // Strip up to 2 trailing '=' padding chars
   eff_len' = n
   pad_cnt' = 0
   eff_len' > 0 && clean(eff_len' - 1) == '=
      |
         eff_len' = eff_len' - 1
         pad_cnt' = pad_cnt' + 1
   eff_len' > 0 && clean(eff_len' - 1) == '=
      |
         eff_len' = eff_len' - 1
         pad_cnt' = pad_cnt' + 1
   rem = eff_len' % 4
   rem == 1 | --| <- b64_err("invalid base64 group length", eff_len') +>
   full_quads = eff_len' / 4
   out = {(full_quads + 1) * 3}
   bad_idx' = -1
   full_quads @ q =>
      base = q * 4
      v0 = val(clean(base), flavor)
      v1 = val(clean(base + 1), flavor)
      v2 = val(clean(base + 2), flavor)
      v3 = val(clean(base + 3), flavor)
      (v0 < 0 || v1 < 0 || v2 < 0 || v3 < 0)
         |
            bad_idx' = base
            -->
         |
            triple = (v0 .<. 18) .|. (v1 .<. 12) .|. (v2 .<. 6) .|. v3
            out += (((triple .>. 16) .&. 0xFF), ((triple .>. 8) .&. 0xFF), (triple .&. 0xFF))
   bad_idx' < 0 && rem == 2
      |
         base = full_quads * 4
         v0 = val(clean(base), flavor)
         v1 = val(clean(base + 1), flavor)
         (v0 < 0 || v1 < 0)
            | bad_idx' = base
            | out += (((v0 .<. 2) .|. (v1 .>. 4)) .&. 0xFF)
   bad_idx' < 0 && rem == 3
      |
         base = full_quads * 4
         v0 = val(clean(base), flavor)
         v1 = val(clean(base + 1), flavor)
         v2 = val(clean(base + 2), flavor)
         (v0 < 0 || v1 < 0 || v2 < 0)
            | bad_idx' = base
            | out += ((((v0 .<. 2) .|. (v1 .>. 4)) .&. 0xFF), (((v1 .<. 4) .|. (v2 .>. 2)) .&. 0xFF))
   bad_idx' !< 0
      | <- b64_err("invalid base64 character", bad_idx') +>
      | <+ +out ->
