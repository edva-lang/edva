// Standard Input Module (std/in.dva)
// High-level safe abstractions for stdin using a singleton io::Reader.

#use io

#private
   ::stdin_r = io::reader(io::STDIN)

#public
   // Reads up to `max` bytes from stdin, stopping at the first newline ('\n').
   // Strips trailing '\r' if present. Returns <+ String +> or <--> on EOF.
   read_line: Int => < String | >
   read_line = max => io::read_line(stdin_r, max)

   // Reads up to `max` available bytes from stdin.
   // Returns <+ String +> or <--> on EOF.
   read_bytes: Int => < String | >
   read_bytes = max => io::read(stdin_r, max)

   // Reads a single byte from stdin. Returns <+ Int +> or <--> on EOF.
   read_byte: () => < Int | >
   read_byte = !=> io::read_byte(stdin_r)

   // Reads bytes from stdin until `delim` or `max` bytes.
   // Consumes delimiter. Returns <+ String +> or <--> on EOF.
   read_until: Int, Int => < String | >
   read_until = delim, max => io::read_until(stdin_r, delim, max)

   // Returns the last errno encountered by stdin reader (0 if none).
   err: () => Int
   err = !=> io::reader_err(stdin_r)

   // True (<+>) if clean EOF has been reached on stdin.
   eof: () => <>
   eof = !=> io::reader_eof(stdin_r)

   // True (<+>) if the last read on stdin would block (EAGAIN/EWOULDBLOCK).
   would_block: () => <>
   would_block = !=> io::reader_would_block(stdin_r)

   // True (<+>) if any unhandled I/O error occurred on stdin (err != 0).
   has_err: () => <>
   has_err = !=> io::reader_has_err(stdin_r)

   // Clears the error and EOF status on stdin.
   clear: () => ()
   clear = !=> io::reader_clear(stdin_r)