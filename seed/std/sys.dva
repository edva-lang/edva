// Standard System Module (std/sys.dva)
// Exposes compiler and runtime parameters (argv, exit, STDIN/STDOUT/STDERR)

#use libc

#public
   #foreign
      argc = sys_argc_global: Int
      argv_ptr = sys_argv_global: Addr

   STDIN  = 0
   STDOUT = 1
   STDERR = 2

   addr_null = Addr(0)

   addr_is_null: Addr => <>
   addr_is_null = a => a == addr_null

   raw_argv: Int => Addr
   raw_argv = n =>
      n !< 0 && n < argc
         | @[argv_ptr + n * 8 Addr]
         | addr_null

   argv_matches: Int, String => <>
   argv_matches = n, s =>
      raw = raw_argv(n)
      raw != addr_null && (libc::strcmp(raw, s) == 0)

   c_str: Addr => String
   c_str = raw =>
      raw == addr_null
         | ""
         |
            len = libc::strlen(raw)
            b = {len + 1}
            %memcpy(&b, raw, len + 1)
            ?b = len
            +b

   argv_string: Int => String
   argv_string = n =>
      c_str $ raw_argv(n)

   addr_opt: Addr => <Addr | >
   addr_opt = a => a != addr_null | <+ a +> | <-->

   argv: Int => <String | >
   argv = n =>
      sys::addr_opt(raw_argv(n))
         | raw => <+ c_str(raw) +>
         | <-->

   exit: Int => ()
   exit = code => libc::exit $ code
