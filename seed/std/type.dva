// Standard library compile-time type reflection predicates.
// Evaluated at compile time by the compiler; erased from runtime.


#public

is_record: Type => <>
is_record = t => <->

is_enum: Type => <>
is_enum = t => <->

is_ram: Type => <>
is_ram = t => <->

is_fn: Type => <>
is_fn = t => <->

is_unit: Type => <>
is_unit = t => <->

is_homogeneous: Type => <>
is_homogeneous = t => <->

is_indexable: Type => <>
is_indexable = t => <->

is_iterable: Type => <>
is_iterable = t => <->

is_array: Type => <>
is_array = t => <->

is_slice: Type => <>
is_slice = t => <->

is_map: Type => <>
is_map = t => <->

is_scalar: Type => <>
is_scalar = t => <->

is_int: Type => <>
is_int = t => <->

is_float: Type => <>
is_float = t => <->

is_numeric: Type => <>
is_numeric = t => <->

is_pointer: Type => <>
is_pointer = t => <->
