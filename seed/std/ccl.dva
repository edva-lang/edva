// std/ccl.dva — Categorical Configuration Language (CCL) parser, model,
// deterministic serializer, and structural #! encode/decode.
//
// Reference: https://github.com/chshersh/ccl

#use str
#use io
#use libc

#public

// --- Core CCL Data Model ----------------------------------------------------

#type Strings String{}

#type CclEntries CclEntry{}

#type CclDoc CclEntry{}

#type CclVal <
   Str(String),
   Block(CclDoc)
>

#type CclEntry (
   key: String,
   val: CclVal,
   line: Int,
   col: Int
)

// --- Constructors -----------------------------------------------------------

doc_new: () => CclDoc
doc_new = !=>
   CclDoc()

entry_new_str: String, String, Int, Int => CclEntry
entry_new_str = k, s, line, col =>
   CclEntry(k, CclVal(Str, s), line, col)

entry_new_block: String, CclDoc, Int, Int => CclEntry
entry_new_block = k, doc, line, col =>
   CclEntry(k, CclVal(Block, doc), line, col)

// --- String Utilities -------------------------------------------------------

is_space: Int => <>
is_space = ['\s, '\t]

trim_left_idx: String, Int => Int
trim_left_idx = s, i =>
   i < ?s && is_space(s(i)) | trim_left_idx(s, i + 1) | i

trim_right_idx: String, Int => Int
trim_right_idx = s, i =>
   i > 0 && s(i - 1) ['\s, '\t, '\r, '\n]
      | trim_right_idx(s, i - 1)
      | i

trim_str: String => String
trim_str = s =>
   len = ?s
   len == 0 | --| ""
   start = trim_left_idx(s, 0)
   start !< len | --| ""
   end = trim_right_idx(s, len)
   end !> start | "" | s(start..end)

find_char_idx: String, Int, Int => Int
find_char_idx = s, ch, i =>
   i !< ?s | --| -1
   s(i) == ch | i | find_char_idx(s, ch, i + 1)

find_first_eq: String => Int
find_first_eq = s => find_char_idx(s, '=, 0)

// --- String Sorting (Pure Insertion Sort) -----------------------------------

sort_strings: Strings => Strings
sort_strings = arr =>
   n = ?arr
   n < 2 | --| arr
   out = arr @> s => s
   1..n @ i =>
      key = out(i) | _ | ""
      j' = i
      0.. @
         j' !> 0 | -->
         prev = out(j' - 1) | _ | ""
         str::cmp(prev, key) !> 0 | -->
         out(j') = prev !| _
         j' = j' - 1
      out(j') = key !| _
   out

// --- Error Constructor ------------------------------------------------------

ccl_error: String, String, Int, Int => Error
ccl_error = file, msg, line, col =>
   Error(5050, msg, file, line, col, (0, 0))

// --- Document Query Functions -----------------------------------------------

has: CclDoc, String => <>
has = doc, key =>
   doc @ e =>
      e.key == key |+>
   <->

count: CclDoc, String => Int
count = doc, key =>
   (0, doc) @> acc, e =>
      e.key == key | <+ acc + 1 +>

get_entry: CclDoc, String => < CclEntry | >
get_entry = doc, key =>
   doc @ e =>
      e.key == key | --| <+ e +>
   <-->

get: CclDoc, String => < String | >
get = doc, key =>
   doc @ e =>
      e.key == key |
         e.val [Str s] --| <+ s +>
   <-->

get_section: CclDoc, String => < CclDoc | >
get_section = doc, key =>
   doc @ e =>
      e.key == key |
         e.val [Block b] --| <+ b +>
   <-->

get_list: CclDoc, String => < Strings | >
get_list = doc, key =>
   sec = get_section(doc, key)--!
   <+ (sec @> e => e.key == "" | (e.val [Str s] <+ s +>)) +>

entries_for: CclDoc, String => CclEntries
entries_for = doc, key =>
   doc @> e =>
      e.key == key | <+ e +>

// --- Parser -----------------------------------------------------------------

#type ParsedLine (
   line_no: Int,
   indent: Int,
   text: String
)

#type ParsedLines ParsedLine{}

split_raw_lines: String => ParsedLines
split_raw_lines = src =>
   lines: ParsedLines
   len = ?src
   len == 0 | --| lines
   cur_start' = 0
   line_no' = 1
   0..len @ i =>
      src(i) == '\n |
         line_end = i > cur_start' && src(i - 1) == '\r | i - 1 | i
         raw = src(cur_start'..line_end)
         ind = trim_left_idx(raw, 0)
         lines += ParsedLine(line_no', ind, raw(ind..))
         line_no' = line_no' + 1
         cur_start' = i + 1
   cur_start' < len |
      line_end = src(len - 1) == '\r | len - 1 | len
      raw = src(cur_start'..line_end)
      ind = trim_left_idx(raw, 0)
      lines += ParsedLine(line_no', ind, raw(ind..))
   lines

parse_block_from: ParsedLines, Int, Int, String => < (CclDoc, Int) | Error >
parse_block_from = lines, start_idx, min_indent, file =>
   doc = doc_new!
   idx' = start_idx
   total = ?lines
   base_indent' = -1

   0.. @
      idx' !< total | -->
      pl = lines(idx') | _ | ParsedLine(0, 0, "")
      pl.text == ""
         | idx' = idx' + 1
         |
            base_indent' < 0 | base_indent' = pl.indent
            pl.indent < min_indent || pl.indent < base_indent' | -->
            // Check comment: starts with "/="
            ?pl.text > 1 && pl.text(0..2) == "/="
               |
                  doc += entry_new_str("/", trim_str(pl.text(2..)), pl.line_no, pl.indent + 1)
                  idx' = idx' + 1
               |
                  eq_idx = find_first_eq(pl.text)
                  eq_idx < 0 |
                     --| <- ccl_error(file, "syntax error: line missing '=': " + pl.text, pl.line_no, pl.indent + 1) +>
                  k = trim_str(pl.text(0..eq_idx))
                  after_trim = trim_str(pl.text(eq_idx + 1..))
                  after_trim != ""
                     |
                        doc += entry_new_str(k, after_trim, pl.line_no, pl.indent + 1)
                        idx' = idx' + 1
                     |
                        // Indented value on following lines
                        next_idx' = idx' + 1
                        child_ind' = -1
                        0.. @
                           next_idx' !< total | -->
                           cand = lines(next_idx') | _ | ParsedLine(0, 0, "")
                           cand.text != ""
                              | child_ind' = cand.indent; -->
                              | next_idx' = next_idx' + 1

                        child_ind' !> pl.indent
                           |
                              // Empty value
                              doc += entry_new_str(k, "", pl.line_no, pl.indent + 1)
                              idx' = idx' + 1
                           |
                              // Test if child contains '='
                              cand_line = lines(next_idx') | _ | ParsedLine(0, 0, "")
                              find_first_eq(cand_line.text) !< 0
                                 |
                                    cres = parse_block_from(lines, next_idx', child_ind', file)--!
                                    doc += entry_new_block(k, cres.0, pl.line_no, pl.indent + 1)
                                    idx' = cres.1
                                 |
                                    // Multiline text block
                                    tb = {64}
                                    0.. @
                                       next_idx' !< total | -->
                                       cl = lines(next_idx') | _ | ParsedLine(0, 0, "")
                                       cl.text == ""
                                          |
                                             tb += 10
                                             next_idx' = next_idx' + 1
                                          |
                                             cl.indent < child_ind' | -->
                                             ?tb > 0 | tb += 10
                                             tb += cl.text
                                             next_idx' = next_idx' + 1
                                    doc += entry_new_str(k, +tb, pl.line_no, pl.indent + 1)
                                    idx' = next_idx'

   <+ (doc, idx') ->

parse: String, String => < CclDoc | Error >
parse = src, file =>
   lines = split_raw_lines(src)
   pair = parse_block_from(lines, 0, 0, file)--!
   pair.1 < ?lines |
      bad = lines(pair.1) | _ | ParsedLine(1, 0, "")
      --| <- ccl_error(file, "syntax error: unexpected dedent", bad.line_no, bad.indent + 1) +>
   <+ pair.0 ->

parse_file: String => < CclDoc | Error >
parse_file = path =>
   fd = libc::open(path, 0)
   fd < 0 | --| <- ccl_error(path, "cannot open file: " + path, 1, 1) +>
   r = io::reader(fd)
   txt = io::read_all(r, 1048576)
   libc::close(fd)
   txt
      | content => parse(content, path)
      | <- ccl_error(path, "cannot read file: " + path, 1, 1) +>

// --- Deterministic Serialization --------------------------------------------

has_newline: String => <>
has_newline = s =>
   s @ ch =>
      ch == 10 |+>
   <->

append_multiline_str: String, Int, Builder => ()
append_multiline_str = s, child_indent, b =>
   line_start' = 0
   n = ?s
   0..n @ i =>
      s(i) == 10 |
         part = s(line_start'..i)
         ?part > 0 |
            child_indent @ b += '\s
            b += part
         b += 10
         line_start' = i + 1
   last_part = s(line_start'..n)
   ?last_part > 0 || n == 0 |
      child_indent @ b += '\s
      b += (last_part, 10)

serialize_doc_indent: CclDoc, Int, Builder => ()
serialize_doc_indent = doc, indent, b =>
   doc @ e =>
      indent @ b += '\s
      e.key
         ["/"]
            e.val
               [Str s] b += ("/= ", s, 10)
               [Block] b += ("/= ", 10)
         [""]
            e.val
               [Str s]
                  has_newline(s)
                     |
                        b += ("=", 10)
                        append_multiline_str(s, indent + 2, b)
                     | b += ("= ", s, 10)
               [Block sub]
                  b += ("= ", 10)
                  serialize_doc_indent(sub, indent + 2, b)
         |
            b += e.key
            e.val
               [Str s]
                  has_newline(s)
                     |
                        b += (" =", 10)
                        append_multiline_str(s, indent + 2, b)
                     | b += (" = ", s, 10)
               [Block sub]
                  b += (" = ", 10)
                  serialize_doc_indent(sub, indent + 2, b)

to_ccl: CclDoc => String
to_ccl = doc =>
   b = {512}
   serialize_doc_indent(doc, 0, b)
   +b

// --- Structural #! Codec (encode / decode) ----------------------------------

ccl_key_to_str: #! K: Type, K => String
ccl_key_to_str = k =>
   K
      [String] k
      [Int, i8, i16, i32, i64, u8, u16, u32, u64] str::from_int(Int(k))
      [<>] (k | "true" | "false")
      [Rune]
         b = {4}
         b += k
         +b
      | K.name

to_ccl_val: #! T: Type, T => CclVal
to_ccl_val = val =>
   T
      [CclVal] val
      [CclDoc] CclVal(Block, val)
      [String] CclVal(Str, val)
      [Int, i8, i16, i32, i64, u8, u16, u32, u64] CclVal(Str, str::from_int(Int(val)))
      [Float, f32, f64] CclVal(Str, str::from_float(Float(val)))
      [<>] CclVal(Str, (val | "true" | "false"))
      [Rune]
         b = {4}
         b += val
         CclVal(Str, +b)
      [<P|>]
         (val | pv => to_ccl_val(pv) | CclVal(Str, ""))
      [E{}]
         sub = doc_new!
         val @ elem =>
            sub += CclEntry("", to_ccl_val(elem), 0, 0)
         CclVal(Block, sub)
      [E[]]
         sub = doc_new!
         val @ elem =>
            sub += CclEntry("", to_ccl_val(elem), 0, 0)
         CclVal(Block, sub)
      [K ^ V]
         sub = doc_new!
         val @ v, k =>
            sub += CclEntry(ccl_key_to_str(k), to_ccl_val(v), 0, 0)
         CclVal(Block, sub)
      [<..>]
         res' = CclVal(Str, "")
         T @ v =>
            val.(v)
               | pay =>
                  v.type
                     [()]
                        res' = CclVal(Str, v.name)
                     |
                        sub = doc_new!
                        sub += CclEntry(v.name, to_ccl_val(pay), 0, 0)
                        res' = CclVal(Block, sub)
         res'
      [(..)]
         sub = doc_new!
         T @ f =>
            f.type
               [<P|>]
                  vf = val.(f)
                  vf | inner => sub += CclEntry(f.name, to_ccl_val(inner), 0, 0)
               |
                  sub += CclEntry(f.name, to_ccl_val(val.(f)), 0, 0)
         CclVal(Block, sub)
      | CclVal(Str, "")

to_doc: #! T: Type, T => CclDoc
to_doc = val =>
   T
      [CclDoc] val
      |
         cv = to_ccl_val(val)
         cv
            [Block b] b
            [Str s]
               d = doc_new!
               d += CclEntry("", CclVal(Str, s), 0, 0)
               d

encode: #! T: Type, T => String
encode = val =>
   to_ccl(to_doc(val))

first_non_comment_entry: CclDoc => < CclEntry | >
first_non_comment_entry = doc =>
   doc @ e =>
      e.key != "/" | --| <+ e +>
   <-->

non_comment_entries: CclDoc => CclDoc
non_comment_entries = doc =>
   doc @> e =>
      e.key != "/" | <+ e +>

decode_val: #! T: Type, CclVal, String, Int, Int => < T | Error >
decode_val = cv, file, line, col =>
   T
      [CclVal] <+ cv ->
      [CclDoc]
         cv
            [Block b] <+ b ->
            [Str s]
               s == ""
                  | <+ doc_new! ->
                  | <- ccl_error(file, "expected CCL block", line, col) +>
      [String]
         cv
            [Str s] <+ s ->
            [Block] <- ccl_error(file, "expected string value, got block", line, col) +>
      [Int]
         cv
            [Str s]
               parsed_int = str::parse_int(s)
               parsed_int
                  | n => <+ n ->
                  | <- ccl_error(file, "invalid integer: '" + s + "'", line, col) +>
            [Block] <- ccl_error(file, "expected integer value, got block", line, col) +>
      [Float]
         cv
            [Str s]
               parsed_flt = str::parse_float(s)
               parsed_flt
                  | x => <+ x ->
                  | <- ccl_error(file, "invalid float: '" + s + "'", line, col) +>
            [Block] <- ccl_error(file, "expected float value, got block", line, col) +>
      // Boolean flags (`<>`) encode canonically as `"true"` (`<+>`) or `"false"` (`<->`),
      // and decode from `"true"`, `"1"`, or `"yes"` as `<+>` (true),
      // or `"false"`, `"0"`, or `"no"` as `<->` (false); any other string returns `Error`.
      [<>]
         cv
            [Str s]
               s
                  ["true", "1", "yes"]  <+ <+> ->
                  ["false", "0", "no"]  <+ <-> ->
                  | <- ccl_error(file, "invalid boolean: '" + s + "'", line, col) +>
            [Block] <- ccl_error(file, "expected boolean value, got block", line, col) +>
      [<P|>]
         cv
            [Str s]
               s == ""
                  | <+ <--> ->
                  |
                     dec_p = decode_val(P, cv, file, line, col)
                     dec_p
                        | pv => <+ <+ pv +> ->
                        | err => <- err +>
            [Block]
               dec_p = decode_val(P, cv, file, line, col)
               dec_p
                  | pv => <+ <+ pv +> ->
                  | err => <- err +>
      [E{}]
         cv
            [Block b]
               arr' = T.zero
               has_err' = <->
               err_val' = ccl_error(file, ++"", 0, 0)
               b @ e =>
                  !has_err' && e.key != "/" |
                     dec_e = decode_val(E, e.val, file, e.line, e.col)
                     dec_e
                        | elem => arr' += elem
                        | err =>
                           has_err' = <+>
                           err_val' = err
               has_err'
                  | <- err_val' +>
                  | <+ arr' ->
            [Str s]
               s == ""
                  | <+ T.zero ->
                  | <- ccl_error(file, "expected list block for " + T.name, line, col) +>
      [K ^ V]
         cv
            [Block b]
               m' = T.zero
               has_err' = <->
               err_val' = ccl_error(file, ++"", 0, 0)
               b @ e =>
                  !has_err' && e.key != "/" |
                     dec_k = decode_val(K, CclVal(Str, e.key), file, e.line, e.col)
                     dec_k
                        | k =>
                           dec_v = decode_val(V, e.val, file, e.line, e.col)
                           dec_v
                              | v => m' ^ k = v
                              | err =>
                                 has_err' = <+>
                                 err_val' = err
                        | err =>
                           has_err' = <+>
                           err_val' = err
               has_err'
                  | <- err_val' +>
                  | <+ m' ->
            [Str s]
               s == ""
                  | <+ T.zero ->
                  | <- ccl_error(file, "expected map block for " + T.name, line, col) +>
      [<..>]
         cv
            [Str s]
               out' = T.zero
               matched' = <->
               bad_payload' = <->
               T @ v =>
                  v.name == s |
                     v.type
                        [()]
                           out' = T(v)
                           matched' = <+>
                        |
                           bad_payload' = <+>
               matched'
                  | <+ out' ->
                  |
                     bad_payload'
                        | <- ccl_error(file, "variant '" + s + "' of " + T.name + " requires a payload", line, col) +>
                        | <- ccl_error(file, "unknown variant '" + s + "' for " + T.name, line, col) +>
            [Block b]
               first_ent = first_non_comment_entry(b)
               first_ent
                  | ent =>
                     out' = T.zero
                     matched' = <->
                     has_err' = <->
                     err_val' = ccl_error(file, ++"", 0, 0)
                     T @ v =>
                        v.name == ent.key |
                           matched' = <+>
                           v.type
                              [()]
                                 out' = T(v)
                              |
                                 dec_pv = decode_val(v.type, ent.val, file, ent.line, ent.col)
                                 dec_pv
                                    | pv => out' = T(v, pv)
                                    | err =>
                                       has_err' = <+>
                                       err_val' = err
                     has_err'
                        | <- err_val' +>
                        |
                           matched'
                              | <+ out' ->
                              | <- ccl_error(file, "unknown variant '" + ent.key + "' for " + T.name, ent.line, ent.col) +>
                  | <- ccl_error(file, "empty block for enum " + T.name, line, col) +>
      [(..)]
         b_doc = cv
            [Block b] b
            [Str] doc_new!
         is_non_empty_str = cv [Str s] s != "" | <->
         is_non_empty_str
            | <- ccl_error(file, "expected block for " + T.name + ", got string '" + (cv [Str s] s | "") + "'", line, col) +>
            |
               items = non_comment_entries(b_doc)
               rec' = T.zero
               has_err' = <->
               err_val' = ccl_error(file, ++"", 0, 0)
               T @ f =>
                  !has_err' |
                     f.name == ""
                        |
                           f.idx !< ?items
                              |
                                 has_err' = <+>
                                 err_val' = ccl_error(file, "tuple " + T.name + " expects " + str::from_int(?T) + " elements, got " + str::from_int(?items), line, col)
                              |
                                 pos_ent = items(f.idx) | _ | CclEntry("", CclVal(Str, ""), line, col)
                                 dec_fv = decode_val(f.type, pos_ent.val, file, pos_ent.line, pos_ent.col)
                                 dec_fv
                                    | fv => rec'.(f) = fv
                                    | err =>
                                       has_err' = <+>
                                       err_val' = err
                        |
                           ent_opt = get_entry(b_doc, f.name)
                           ent_opt
                              | ent =>
                                 dec_fv = decode_val(f.type, ent.val, file, ent.line, ent.col)
                                 dec_fv
                                    | fv => rec'.(f) = fv
                                    | err =>
                                       has_err' = <+>
                                       err_val' = err
                              |
                                 f_def = f.default
                                 f_def
                                    | def => rec'.(f) = def
                                    |
                                       f.type
                                          [<P|>] rec'.(f) = <-->
                                          [E{}] rec'.(f) = f.type.zero
                                          [K ^ V] rec'.(f) = f.type.zero
                                          |
                                             has_err' = <+>
                                             err_val' = ccl_error(file, "missing required key '" + f.name + "'", line, col)
               has_err'
                  | <- err_val' +>
                  | <+ rec' ->
      | <- ccl_error(file, "unsupported target type " + T.name + " in ccl::decode", line, col) +>

decode_doc: #! T: Type, CclDoc, String => < T | Error >
decode_doc = doc, file =>
   T
      [CclDoc] <+ doc ->
      | decode_val(T, CclVal(Block, doc), file, 1, 1)

decode: #! T: Type, String => < T | Error >
decode = src =>
   parse(src, "<ccl>")
      | doc => decode_doc(T, doc, "<ccl>")
      | err => <- err +>

decode_file: #! T: Type, String => < T | Error >
decode_file = path =>
   parse_file(path)
      | doc => decode_doc(T, doc, path)
      | err => <- err +>
