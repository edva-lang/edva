// Standard Input/Output Module (std/io.dva)
// Single fd-parameterized stdio module. The write surface is console.log-
// style: io::out(...), io::err(...), io::outf(...), io::errf(...) accept a
// single value OR a record of values, each formatted at compile time
// (the '#! T: Type' type dispatch), joined with a single space, and written
// + newline to the named descriptor. Reads provide buffered Reader operations
// (reader, reader_with_cap, read, read_all, read_byte, read_until, read_line).

#use libc
#use str

#public
   STDIN  = 0
   STDOUT = 1
   STDERR = 2

   EOF         = 0
   EINTR       = 4
   EBADF       = 9
   EAGAIN      = 11
   EWOULDBLOCK = 11

   #type Reader (
      fd: Int,
      buf: Builder,
      pos: Int,
      cap: Int,
      err: Int,
      eof: <>
   )

   reader: Int => Reader
   reader = fd => Reader((fd, {4096}, 0, 4096, 0, <->))

   reader_with_cap: Int, Int => Reader
   reader_with_cap = fd, cap =>
      c = cap > 0 | cap | 4096
      Reader((fd, {c}, 0, c, 0, <->))

   // Returns the last errno encountered by the reader (0 if none).
   reader_err: Reader => Int
   reader_err = r => r.err

   // True (<+>) if clean EOF has been reached on the descriptor.
   reader_eof: Reader => <>
   reader_eof = r => r.eof

   // True (<+>) if the last read on a nonblocking descriptor would block (EAGAIN/EWOULDBLOCK).
   reader_would_block: Reader => <>
   reader_would_block = r => r.err [11]

   // True (<+>) if any unhandled I/O error occurred on the descriptor (err != 0).
   reader_has_err: Reader => <>
   reader_has_err = r => r.err != 0

   // Clears the error and EOF status on the reader.
   reader_clear: Reader => ()
   reader_clear = r =>
      r.err = 0
      r.eof = <->

   // Raw length-aware write to fd. Handles partial writes and retries on EINTR.
   write: Int, String => Int
   write = fd, s =>
      total = ?s
      total [0] --| 0
      off' = 0
      0.. @
         off' !< total | -->
         rem = total - off'
         buf_addr = clean_addr(&s + off')
         w = libc::write_ptr(fd, buf_addr, rem)
         w
            [< 0]
               errno_val = @[libc::__errno_location! i32]
               errno_val == 4
                  | --^
                  |
                     off' == 0 | --| -1 | -->
            |
               w [0] -->
               off' = off' + w
      off'

// --- private machinery ------------------------------------------------------

#private
   // Generic value-to-text at compile time: the [] choice guard syntax
   // is resolved and pruned per call site (no runtime dispatch). A scalar
   // renders via str::*; a record renders its fields space-separated (the
   // 0..?T cycle is unrolled, so each field's type is known).
   show_rune: Rune => String
   show_rune = r =>
      r
         [< 0x80] str::from_byte(Int(r))
         [< 0x800]
            b = {2}
            b += 0xC0 + Int(r .>. 6)
            b += 0x80 + Int(r .&. 0x3F)
            +b
         [< 0x10000]
            b = {3}
            b += 0xE0 + Int(r .>. 12)
            b += 0x80 + Int((r .>. 6) .&. 0x3F)
            b += 0x80 + Int(r .&. 0x3F)
            +b
         |
            b = {4}
            b += 0xF0 + Int(r .>. 18)
            b += 0x80 + Int((r .>. 12) .&. 0x3F)
            b += 0x80 + Int((r .>. 6) .&. 0x3F)
            b += 0x80 + Int(r .&. 0x3F)
            +b

   show: #! T: Type, T => String
   show = #! T, x =>
      T
         [String] x
         [Rune] show_rune(x)
         [Int] str::from_int(x)
         [i8] str::from_int(Int(x))
         [i16] str::from_int(Int(x))
         [i32] str::from_int(Int(x))
         [i64] str::from_int(Int(x))
         [u8] str::from_int(Int(x))
         [u16] str::from_int(Int(x))
         [u32] str::from_int(Int(x))
         [u64] str::from_u64(x)
         [Float] str::from_float(x)
         [f32] str::from_float(Float(x))
         [Builder] +x
         [i1]
            x | "<+>" | "<->"
         | show_rec(x)

   // A record rendered space-separated (the unrolled per-field cycle; each
   // copy's field type is known, so show dispatches per field).
   show_rec: #! T: Type, T => String
   show_rec = x =>
      b = {64}
      0..?T @ i =>
         i > 0 | b += ' '
         b += show(x.(i))
      +b

   clean_addr: Addr => Addr
   clean_addr = a => %ptrmask(a, 0b1{48})

   // Writes s1 followed by s2 to fd, advancing across partial transfers and retrying on EINTR.
   // Returns the total bytes transferred, or -1 on error.
   writev_all: Int, String, String => Int
   writev_all = fd, s1, s2 =>
      len1 = ?s1
      len2 = ?s2
      total = len1 + len2
      total [0] --| 0
      off' = 0
      0.. @
         off' !< total | -->
         off' < len1
            |
               rem1 = len1 - off'
               p1 = clean_addr(&s1 + off')
               p2 = clean_addr(&s2)
               iov = (p1, rem1, p2, len2)
               w = libc::writev(fd, &iov, 2)
               w < 0
                  |
                     errno_val = @[libc::__errno_location! i32]
                     errno_val == 4 | --^
                     off' == 0 | --| -1 | -->
                  |
                     w [0] -->
                     off' = off' + w
            |
               off2 = off' - len1
               rem2 = len2 - off2
               p2 = clean_addr(&s2 + off2)
               w = libc::write_ptr(fd, p2, rem2)
               w < 0
                  |
                     errno_val = @[libc::__errno_location! i32]
                     errno_val == 4 | --^
                     off' == 0 | --| -1 | -->
                  |
                     w [0] -->
                     off' = off' + w
      off'

   // console.log-style to fd: the value's show text + a newline in a single atomic writev syscall.
   log: #! T: Type, Int, T => Int
   log = fd, x =>
      s = show(x)
      nl = "\n"
      writev_all(fd, s, nl)

   // Substitutes 'show(x)' for every '{}' in fmt (the scalar form of logf).
   logf_scalar: #! T: Type, Builder, T, String => ()
   logf_scalar = b, x, fmt =>
      i' = 0
      len = ?fmt
      len @
         i' < len
            |
               (i' + 1 < len && fmt(i') == '{' && fmt(i' + 1) == '}')
                  |
                     b += show(x)
                     i' = i' + 2
                  |
                     b += fmt(i')
                     i' = i' + 1

   // Formatted to fd: '{}' placeholders in fmt are replaced by each field
   // (or the single value) in order, then written + newline.
   logf: #! T: Type, Int, T, String => Int
   logf = fd, x, fmt =>
      b = {?fmt + 64}
      T
         [String] logf_scalar(b, x, fmt)
         [Rune] logf_scalar(b, x, fmt)
         [Int] logf_scalar(b, x, fmt)
         [i8] logf_scalar(b, x, fmt)
         [i16] logf_scalar(b, x, fmt)
         [i32] logf_scalar(b, x, fmt)
         [i64] logf_scalar(b, x, fmt)
         [u8] logf_scalar(b, x, fmt)
         [u16] logf_scalar(b, x, fmt)
         [u32] logf_scalar(b, x, fmt)
         [u64] logf_scalar(b, x, fmt)
         [Float] logf_scalar(b, x, fmt)
         [f32] logf_scalar(b, x, fmt)
         [Builder] logf_scalar(b, x, fmt)
         [i1] logf_scalar(b, x, fmt)
         | logf_rec(fd, b, x, fmt)
      b += "\n"
      write(fd, +b)

   // A record formatted: each '{}' in fmt is replaced by the next field's
   // show text, in order.
   logf_rec: #! T: Type, Int, Builder, T, String => ()
   logf_rec = fd, b, x, fmt =>
      j' = 0
      len = ?fmt
      0..?T @ i =>
         nxt' = -1
         j'..len @ k =>
            k + 1 < len && fmt(k) == '{' && fmt(k + 1) == '}'
               |
                  nxt' = k
                  -->
         nxt' !< 0
            |
               b += fmt(j'..nxt')
               b += show(x.(i))
               j' = nxt' + 2
      j' < len | b += fmt(j'..len)

   // Refills the reader's buffer from its fd. Compacts unconsumed bytes
   // to the front if necessary. Returns number of newly read bytes (<= 0 on EOF/error).
   refill: Reader => Int
   refill = r =>
      buf = r.buf
      r.pos > 0
         |
            rem = ?buf - r.pos
            rem > 0 | %memmove(&buf, &buf + r.pos, rem)
            ?buf = rem
            r.pos = 0
      read_cap = r.cap > 0 | r.cap | 4096
      space = read_cap - ?buf
      space !> 0
         | 0
         |
            n' = 0
            0.. @
               cur = ?buf
               n = libc::read(r.fd, &buf + cur, space)
               n < 0
                  |
                     errno_val = @[libc::__errno_location! i32]
                     errno_val == 4 | --^
                     r.err = Int(errno_val)
                     n' = n
                     -->
                  |
                     n == 0
                        |
                           r.eof = <+>
                           r.err = 0
                           n' = 0
                           -->
                        |
                           ?buf = cur + n
                           r.err = 0
                           n' = n
                           -->
            n'

// --- public ergonomic surface ----------------------------------------------

#public
   // console.log-style to stdout.
   out: #! T: Type, T => ()
   out = x =>
      _ = log(io::STDOUT, x)

   // Monomorphic string output with trailing newline to stdout.
   outs: String => ()
   outs = s =>
      nl = "\n"
      _ = writev_all(io::STDOUT, s, nl)

   // console.log-style to stderr.
   err: #! T: Type, T => ()
   err = x =>
      _ = log(io::STDERR, x)

   // Monomorphic string output with trailing newline to stderr.
   errs: String => ()
   errs = s =>
      nl = "\n"
      _ = writev_all(io::STDERR, s, nl)

   // Formatted ('{}' placeholders) to stdout.
   outf: #! T: Type, T, String => ()
   outf = x, fmt =>
      _ = logf(io::STDOUT, x, fmt)

   // Formatted ('{}' placeholders) to stderr.
   errf: #! T: Type, T, String => ()
   errf = x, fmt =>
      _ = logf(io::STDERR, x, fmt)

   // --- Reader-based buffered reading ----------------------------------------

   // Buffered read: reads up to 'max' available bytes from reader.
   // Returns <+ String +> or <--> on EOF.
   read: Reader, Int => < String | >
   read = r, max =>
      max !> 0 |-->
      r.pos !< ?r.buf |
         _ = refill(r)
      r.pos !< ?r.buf |-->
      avail = ?r.buf - r.pos
      take = avail < max | avail | max
      res = {take}
      take > 0 | %memcpy(&res, &r.buf + r.pos, take)
      ?res = take
      r.pos = r.pos + take
      <+ +res +>

   // Buffered drain: reads from reader until EOF, capped at 'max'.
   // Drains any bytes currently buffered, then continues reading from fd.
   // Returns <+ String +> or <--> if EOF before any bytes were read.
   read_all: Reader, Int => < String | >
   read_all = r, max =>
      max !> 0 |-->
      res_b = {max}
      avail = ?r.buf - r.pos
      avail > 0
         |
            take = avail < max | avail | max
            cur = ?res_b
            %memcpy(&res_b + cur, &r.buf + r.pos, take)
            ?res_b = cur + take
            r.pos = r.pos + take
      chunk = 4096
      0.. @
         rem = max - ?res_b
         rem !> 0 | -->
         to_read = rem < chunk | rem | chunk
         cur = ?res_b
         n = libc::read(r.fd, &res_b + cur, to_read)
         n < 0
            |
               errno_val = @[libc::__errno_location! i32]
               errno_val == 4 | --^
               r.err = Int(errno_val)
               -->
            |
               n == 0
                  |
                     r.eof = <+>
                     r.err = 0
                     -->
                  |
                     r.err = 0
                     ?res_b = cur + n
      ?res_b == 0 |-->
      <+ +res_b +>

   // Buffered read: reads a single byte from reader.
   // Returns <+ byte +> or <--> on EOF.
   read_byte: Reader => < Int | >
   read_byte = r =>
      r.pos !< ?r.buf | refill(r)
      r.pos !< ?r.buf |-->
      b = Int(@[&r.buf + r.pos i8]) .&. 255
      r.pos = r.pos + 1
      <+ b +>

   // Buffered read: reads bytes from reader until 'delim' or 'max'.
   // Consumes delimiter and returns preceding string. Returns <+ String +> or <--> on EOF.
   read_until: Reader, Int, Int => < String | >
   read_until = r, delim, max =>
      max !> 0
         | <-->
         |
            out = {max}
            done' = <->
            0.. @
               r.pos !< ?r.buf
                  |
                     n = refill(r)
                     n !> 0 | -->
               rem_budget = max - ?out
               rem_budget !> 0
                  |
                     done' = <+>
                     -->
               in_buf = ?r.buf - r.pos
               scan_count = in_buf < rem_budget | in_buf | rem_budget
               found_idx' = -1
               scan_count @ i =>
                  (Int(@[&r.buf + r.pos + i i8]) .&. 255) == delim
                     |
                        found_idx' = i
                        -->
               found_idx' !< 0
                  |
                     cur = ?out
                     found_idx' > 0
                        | %memcpy(&out + cur, &r.buf + r.pos, found_idx')
                     ?out = cur + found_idx'
                     r.pos = r.pos + found_idx' + 1
                     done' = <+>
                     -->
                  |
                     cur = ?out
                     scan_count > 0
                        | %memcpy(&out + cur, &r.buf + r.pos, scan_count)
                     ?out = cur + scan_count
                     r.pos = r.pos + scan_count
                     ?out !< max
                        |
                           done' = <+>
                           -->
            done'
               | <+ +out +>
               |
                  ?out > 0
                     | <+ +out +>
                     | <-->

   // Buffered line read: reads until '\n', stripping a trailing '\r'
   // if present. An empty line produces <+ "" +>; EOF produces <-->.
   read_line: Reader, Int => < String | >
   read_line = r, max =>
      res = read_until(r, 10, max)
      res
         | line =>
            n = ?line
            n > 0 && line(n - 1) == 13
               |
                  end_idx = n - 1
                  <+ line(0..end_idx) +>
               | <+ line +>
         | <-->
