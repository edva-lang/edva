// selfhost/src/tast.dva — Typed AST intermediate representation.
//
// Defines the typed expression tree (TypedExpr) and static layout metadata
// representing the explicit typed boundary between semantic inference and
// LLVM IR emission. Part of Milestone 2 (Phase 2) of unification roadmap.

#use "ast"
#use "unify"
#use "str"

// --- Layout Metadata -------------------------------------------------------

#type LayoutKind <
   Scalar
   Aggregate
   Ram
   Enum
   Slice
   Array
   FnClosure
   Void
>

#type TypedLayout (
   size: Int,
   align: Int,
   kind: LayoutKind
)

// --- Typed AST Nodes -------------------------------------------------------

#type TypedExprs (TypedExpr){}

#type TypedField (
   name: String,
   val: TypedExpr,
   offset: Int,
   ut: unify::UType
)
#type TypedFields (TypedField){}

#type TypedBranch (
   kind: ast::GuardKind,
   case_values: TypedExprs,
   pred_fn: <TypedExpr|>,
   variant_names: ast::Names,
   bind_vars: ast::Names,
   body: TypedExpr
)
#type TypedBranches (TypedBranch){}

#type TypedCapture (
   name: String,
   ut: unify::UType,
   offset: Int
)
#type TypedCaptures (TypedCapture){}

#type TypedMapPair (
   key: TypedExpr,
   val: TypedExpr
)
#type TypedMapPairs (TypedMapPair){}

#type TypedExprKind <
   LitInt(Int)
   LitFloat(Float)
   LitStr(String)
   LitRune(Int)
   LitFlag(<>)
   LitUnit
   Var((String, Int, <>))
   Bin((ast::BinaryOp, TypedExpr, TypedExpr))
   Unary((ast::UnaryOp, TypedExpr))
   Call((String, <TypedExpr|>, TypedExprs))
   Record(TypedFields)
   Member((TypedExpr, String, Int))
   MemberWrite((TypedExpr, String, Int, TypedExpr))
   Index((TypedExpr, TypedExpr))
   IndexWrite((TypedExpr, TypedExpr, TypedExpr))
   Choice((TypedExpr, TypedBranches))
   Lambda((ast::Names, TypedExpr, TypedCaptures))
   Block(TypedExprs)
   Assign((String, <>, <>, <>, <>, TypedExpr))
   Cycle((TypedExpr, TypedExpr, <TypedExpr|>, <>))
   CycleJump((<>, Int))
   RamConstruct((unify::URamShape, <>, <TypedExpr|>))
   EnumConstruct((String, <TypedExpr|>))
   BuilderNew(TypedExpr)
   Copy(TypedExpr)
   RawMemory((TypedExpr, ast::ValueType))
   RawMemoryWrite((TypedExpr, TypedExpr))
   PoisonError((Int, String))
   MapLiteral(TypedMapPairs)
   KeyAccess((TypedExpr, TypedExpr, <>, <>))
   Spawn(ast::SpawnExpr)
   Join(ast::JoinExpr)
   Exit(TypedExpr)
   UserDiag(ast::UserDiagExpr)
   CompileTime(ast::CompileTimeExpr)
>

#type TypedExpr (
   kind: TypedExprKind,
   ut: unify::UType,
   ti: ast::TypeInfo,
   layout: TypedLayout,
   line: Int,
   col: Int
)

// --- Stmt & Program --------------------------------------------------------

#type TypedStmt <
   Expr(TypedExpr)
   Binding((String, ast::TypeInfo, TypedExpr, <>))
   GlobalBinding((String, ast::TypeInfo, TypedExpr))
   TypeDecl((String, ast::TypeInfo))
>
#type TypedStmts (TypedStmt){}

#type TypedProgram (
   stmts: TypedStmts
)

// --- Layout Constructors ---------------------------------------------------

layout_scalar: Int, Int => TypedLayout
layout_scalar = size, align =>
   TypedLayout((size, align, LayoutKind(Scalar)))

layout_aggregate: Int, Int => TypedLayout
layout_aggregate = size, align =>
   TypedLayout((size, align, LayoutKind(Aggregate)))

layout_ram: Int, Int => TypedLayout
layout_ram = size, align =>
   TypedLayout((size, align, LayoutKind(Ram)))

layout_closure: () => TypedLayout
layout_closure = !=>
   TypedLayout((16, 8, LayoutKind(FnClosure)))

layout_void: () => TypedLayout
layout_void = !=>
   TypedLayout((0, 1, LayoutKind(Void)))

// --- Node Constructors -----------------------------------------------------

mk_typed_expr: TypedExprKind, unify::UType, ast::TypeInfo, TypedLayout,
   Int, Int => TypedExpr
mk_typed_expr = kind, ut, ti, layout, line, col =>
   TypedExpr((kind, ut, ti, layout, line, col))

mk_lit_int: Int, Int, Int => TypedExpr
mk_lit_int = val, line, col =>
   ut = unify::prim_int()
   ti = ast::TypeInfo(Prim, ast::ValueType(Int))
   lay = layout_scalar(8, 8)
   mk_typed_expr(TypedExprKind(LitInt, val), ut, ti, lay, line, col)

mk_lit_float: Float, Int, Int => TypedExpr
mk_lit_float = val, line, col =>
   ut = unify::prim_float()
   ti = ast::TypeInfo(Prim, ast::ValueType(Float))
   lay = layout_scalar(8, 8)
   mk_typed_expr(TypedExprKind(LitFloat, val), ut, ti, lay, line, col)

mk_lit_str: String, Int, Int => TypedExpr
mk_lit_str = val, line, col =>
   ut = unify::prim_str()
   ti = ast::TypeInfo(Prim, ast::ValueType(Str))
   lay = layout_scalar(16, 8)
   mk_typed_expr(TypedExprKind(LitStr, val), ut, ti, lay, line, col)

mk_lit_flag: <>, Int, Int => TypedExpr
mk_lit_flag = val, line, col =>
   ut = unify::prim_flag()
   ti = ast::TypeInfo(Prim, ast::ValueType(Flag))
   lay = layout_scalar(1, 1)
   mk_typed_expr(TypedExprKind(LitFlag, val), ut, ti, lay, line, col)

mk_lit_unit: Int, Int => TypedExpr
mk_lit_unit = line, col =>
   ut = unify::prim_unit()
   ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   lay = layout_void()
   mk_typed_expr(TypedExprKind(LitUnit), ut, ti, lay, line, col)

mk_typed_var: String, Int, <>, unify::UType, ast::TypeInfo, TypedLayout,
   Int, Int => TypedExpr
mk_typed_var = name, depth, is_mut, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Var, (name, depth, is_mut)), ut, ti, lay,
      line, col)

mk_typed_bin: ast::BinaryOp, TypedExpr, TypedExpr, unify::UType, ast::TypeInfo,
   TypedLayout, Int, Int => TypedExpr
mk_typed_bin = op, lhs, rhs, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Bin, (op, lhs, rhs)), ut, ti, lay, line, col)

mk_typed_unary: ast::UnaryOp, TypedExpr, unify::UType, ast::TypeInfo,
   TypedLayout, Int, Int => TypedExpr
mk_typed_unary = op, operand, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Unary, (op, operand)), ut, ti, lay, line, col)

mk_typed_call: String, <TypedExpr|>, TypedExprs, unify::UType, ast::TypeInfo,
   TypedLayout, Int, Int => TypedExpr
mk_typed_call = fn_name, fn_target, args, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Call, (fn_name, fn_target, args)), ut, ti,
      lay, line, col)

mk_typed_block: TypedExprs, unify::UType, ast::TypeInfo, TypedLayout,
   Int, Int => TypedExpr
mk_typed_block = exprs, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Block, exprs), ut, ti, lay, line, col)

mk_typed_assign: String, <>, <>, <>, <>, TypedExpr, unify::UType,
   ast::TypeInfo, TypedLayout, Int, Int => TypedExpr
mk_typed_assign = name, mut, cmp, glob, len, val, ut, ti, lay, l, c =>
   as_tup = (name, mut, cmp, glob, len, val)
   mk_typed_expr(TypedExprKind(Assign, as_tup), ut, ti, lay, l, c)

mk_typed_member: TypedExpr, String, Int, unify::UType, ast::TypeInfo,
   TypedLayout, Int, Int => TypedExpr
mk_typed_member = target, field_name, idx, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Member, (target, field_name, idx)),
      ut, ti, lay, line, col)

mk_typed_cycle: TypedExpr, TypedExpr, <TypedExpr|>, <>, unify::UType,
   ast::TypeInfo, TypedLayout, Int, Int => TypedExpr
mk_typed_cycle = iterable, body_fn, esc, is_rune, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Cycle, (iterable, body_fn, esc, is_rune)),
      ut, ti, lay, line, col)

mk_typed_copy: TypedExpr, unify::UType, ast::TypeInfo, TypedLayout, Int,
   Int => TypedExpr
mk_typed_copy = expr, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(Copy, expr), ut, ti, lay, line, col)

mk_typed_builder_new: TypedExpr, unify::UType, ast::TypeInfo, TypedLayout,
   Int, Int => TypedExpr
mk_typed_builder_new = cap, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(BuilderNew, cap), ut, ti, lay, line, col)

mk_typed_cycle_jump: <>, Int, Int, Int => TypedExpr
mk_typed_cycle_jump = is_break, level, line, col =>
   ut = unify::prim_unit()
   ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   lay = layout_void()
   mk_typed_expr(TypedExprKind(CycleJump, (is_break, level)), ut, ti, lay,
      line, col)

mk_typed_raw_memory: TypedExpr, ast::ValueType, unify::UType, ast::TypeInfo,
   TypedLayout, Int, Int => TypedExpr
mk_typed_raw_memory = addr, vt, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(RawMemory, (addr, vt)), ut, ti, lay, line, col)

mk_typed_ram_construct: unify::URamShape, <>, <TypedExpr|>, unify::UType,
   ast::TypeInfo, TypedLayout, Int, Int => TypedExpr
mk_typed_ram_construct = rsh, is_pos, target_opt, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(RamConstruct, (rsh, is_pos, target_opt)),
      ut, ti, lay, line, col)

mk_typed_enum_construct: String, <TypedExpr|>, unify::UType, ast::TypeInfo,
   TypedLayout, Int, Int => TypedExpr
mk_typed_enum_construct = name, target_opt, ut, ti, lay, line, col =>
   mk_typed_expr(TypedExprKind(EnumConstruct, (name, target_opt)),
      ut, ti, lay, line, col)
