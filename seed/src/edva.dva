// Self-hosted compiler driver, Phase 5 foundation.
//
// It loads a target file and file-backed local #use modules, prefixes module
// declarations, then sends one flattened program to the selfhost codegen.
// Directory modules, stdlib fallback, and CLI flags follow.

#use "annotate"
#use "ast"
#use "codegen"
#use "libc"
#use "parser"
#use "show"
#use "str"
#use "sys"
#use "tast"
#use "unify"
#use "mem"
#use "ccl"
#use "pkg"
#use "version"

#public

#foreign "LLVM-18"
   llvm_get_default_triple = LLVMGetDefaultTargetTriple: () => Addr
   llvm_dispose_message = LLVMDisposeMessage: (msg: Addr) => ()

#foreign "c"
   write: (fd: Int, buf: Addr, count: Int) => Int
   mkdir: (path: String, mode: Int) => Int
   signal: (sig: Int, handler: Addr) => Addr
   unlink: (path: String) => Int
   rmdir: (path: String) => Int
   getpid: () => Int
   getenv: (name: String) => Addr
   __errno_location: () => Addr

#private
   print: String => Int
   print = s =>
      b = {?s + 1}
      b += s
      b += 10
      write(1, &b, ?b)

#public

#type ModuleLoad (exprs: ast::Exprs, loaded: ast::Names,
   exports: ast::Names, dynamic_mods: ast::Names, dynamic_paths: ast::Names,
   ok: <>, native_libs: ast::Names, native_pkg_config: ast::Names,
   out_files: ast::Names, out_lines: ast::Ints, out_cols: ast::Ints,
   loaded_files: ast::Names)
#type SigResult (ti: ast::TypeInfo, ok: <>)
#type ImportMap String ^ String

#type PkgInstance (
   id: String,
   src: String,
   name: String,
   aliases: ImportMap
)

#type PkgInstances (PkgInstance){}

#type ImportMapState (
   has_map: <>,
   map_path: String,
   root_dir: String,
   root_name: String,
   instances: PkgInstances,
   native_libs: ast::Names,
   native_pkg_config: ast::Names
)

#type ResolvedFile (path: String, canonical_id: String, is_pkg: <>)
#type ResolvedDir (path: String, canonical_id: String, is_pkg: <>)
#type ResolvedModule <File(ResolvedFile), Dir(ResolvedDir), None>

#type Loader (
   out_exprs: ast::Exprs,
   loaded: ast::Names,
   exports: ast::Names,
   dynamic_mods: ast::Names,
   dynamic_paths: ast::Names,
   is_modular: <>,
   is_dep: <>,
   import_map: ImportMapState,
   loading_stack: ast::Names,
   out_files: ast::Names,
   out_lines: ast::Ints,
   out_cols: ast::Ints,
   loaded_files: ast::Names
)

#type ImportEntry (bound_name: String, canonical_id: String, is_import: <>)
#type ImportEntries (ImportEntry){}
#type ReplSession (
   dir: String,
   src_path: String,
   ll_path: String,
   bin_path: String,
   history: ast::Names
)

find_last_slash: String, Int, Int => Int
find_last_slash = path, i, last =>
   i < ?path
      |
         next_last = path(i) == '/' | i | last
         find_last_slash(path, i + 1, next_last)
      | last

dirname: String => String
dirname = path =>
   last = find_last_slash(path, 0, -1)
   last < 0 | "" | path(..last)

path_join: String, String => String
path_join = a, b =>
   ?a == 0 | b | a + "/" + b

canonical_path: String => String
canonical_path = path =>
   sys::addr_opt(libc::realpath(path, sys::addr_null))
      | raw =>
         res = sys::c_str(raw)
         libc::free(raw)
         res
      | path

compiler_std_dir: String
compiler_std_dir = "std"

compiler_exe_path: String
compiler_exe_path = ""

getenv_opt: String => <String|>
getenv_opt = name =>
   sys::addr_opt(getenv(name))
      | p => <+ sys::c_str(p) +>
      | <-->

init_compiler_paths: () => ()
init_compiler_paths = !=>
   exe = canonical_path("/proc/self/exe")
   exe != "/proc/self/exe"
      | compiler_exe_path ::= exe
      | compiler_exe_path ::= canonical_path(sys::argv_string(0))
   exe_dir = dirname(compiler_exe_path)
   prefix_dir = dirname(exe_dir)
   cand_in_tree = path_join(exe_dir, "std")
   cand_lib = path_join(prefix_dir, "lib/edva/std")
   cand_share = path_join(prefix_dir, "share/edva/std")
   env_std_opt = getenv_opt("EDVA_PATH")
      | s => <+ s +>
      | getenv_opt("EDVA_STDLIB")
   env_valid = env_std_opt
      | dir =>
         dir_exists(dir)
            | <+ dir +>
            | <-->
      | <-->
   env_valid
      | dir => compiler_std_dir ::= dir
      |
         dir_exists(cand_in_tree)
            | compiler_std_dir ::= cand_in_tree
            |
               dir_exists(cand_lib)
                  | compiler_std_dir ::= cand_lib
                  |
                     dir_exists(cand_share)
                        | compiler_std_dir ::= cand_share

dirent_name: Addr => String
dirent_name = entry =>
   raw = entry + 19
   b = {256}
   0.. @ i =>
      c = @[raw + i i8]
      c == 0i8 | -->
      b += c
   +b

is_dva_file: String => <>
is_dva_file = name =>
   name(-4..) == ".dva"

read_dir_entries: Addr, ast::Names => ast::Names
read_dir_entries = dp, names =>
   sys::addr_opt(libc::readdir(dp))
      | ent =>
         d_type = @[ent + 18 i8]
         d_type != 4i8
            |
               fname = dirent_name(ent)
               is_dva_file(fname) | names += fname
         read_dir_entries(dp, names)
      | names

sort_names: ast::Names => ()
sort_names = names =>
   n = ?names
   n @ i =>
      (n - 1) @ j =>
         a = names(j) | _ | ""
         b = names(j + 1) | _ | ""
         str::cmp(a, b) > 0
            |
               names(j) = b !| _
               names(j + 1) = a !| _

dir_dva_files: String => ast::Names
dir_dva_files = dir_path =>
   sys::addr_opt(libc::opendir(dir_path))
      | dp =>
         names = read_dir_entries(dp, ast::Names())
         libc::closedir(dp)
         sort_names(names)
         names
      | ast::Names()

loaded_has_step: ast::Names, String, Int => <>
loaded_has_step = names, name, i =>
   i !< ?names | --| <->
   (names(i) | _ | "") == name | --| <+>
   loaded_has_step(names, name, i + 1)

loaded_has: ast::Names, String => <>
loaded_has = names, name => loaded_has_step(names, name, 0)

loaded_add: ast::Names, String => ast::Names
loaded_add = names, name =>
   names += name
   names

append_names_to: ast::Names, ast::Names => ()
append_names_to = dest, src =>
   ?src @ i =>
      dest += (src(i) | _ | "")

unmark_private_name: String => String
unmark_private_name = name =>
   ?name > 1 && name(0) == '#' | name(1..) | name

unmark_private: ast::Expr => ast::Expr
unmark_private = e =>
   e
      [Assign t]
         ast::Expr(Assign, (unmark_private_name(t.0), t.1, t.2, t.3, t.4,
            t.5, t.6, t.7, t.8))
      [TypeDecl t]
         ast::Expr(TypeDecl, (ast::TypeDeclExpr((unmark_private_name(t.name),
            t.type_info))))
      [Foreign f]
         ast::Expr(Foreign, (ast::ForeignFnDecl((f.c_name,
            unmark_private_name(f.dva_name), f.abi, f.params,
            f.return_type, f.ret_record_info, f.is_variable))))
      [Block b]
         ast::Expr(Block, ast::BlockExpr(unmark_private_exprs(b.exprs)))
      | e

unmark_private_exprs: ast::Exprs => ast::Exprs
unmark_private_exprs = exprs =>
   out = ast::Exprs()
   exprs @ e => out += unmark_private(e)
   out

has_dcolon_step: String, Int => <>
has_dcolon_step = s, i =>
   i + 1 !< ?s | --| <->
   s(i) == ':' && s(i + 1) == ':' | --| <+>
   has_dcolon_step(s, i + 1)

has_dcolon: String => <>
has_dcolon = s => has_dcolon_step(s, 0)

// Walk a Member chain to the root, prefix the root Var.
prefix_member_root: ast::Expr, String => ast::Expr
prefix_member_root = e, prefix =>
   e
      [Member m]
         new_target = prefix_member_root(m.target, prefix)
         ast::Expr(Member, (ast::MemberExpr((new_target,
            m.field_name, m.is_module_access,
            m.index_expr, m.line, m.col))))
      [Var v]
         has_dcolon(v)
            | ast::Expr(Var, v)
            | ast::Expr(Var, (prefix + "::" + v))
      | e

// Prefix the root of an assignment LHS (Member or Call).
prefix_lhs_expr: ast::Expr, String => ast::Expr
prefix_lhs_expr = lhs, prefix =>
   lhs
      [Member m]
         !m.is_module_access
            | prefix_member_root(lhs, prefix)
            | lhs
      [Call c]
         has_dcolon(c.fn_name)
            | lhs
            |
               ast::Expr(Call, (ast::CallExpr((
                  prefix + "::" + c.fn_name,
                  c.fn_target, c.args,
                  c.line, c.col))))
      | lhs

is_public_name: ast::Names, ast::Names, String => <>
is_public_name = publics, privates, name =>
   loaded_has(publics, name) && !loaded_has(privates, name)

decl_clean_name: String => String
decl_clean_name = s =>
   (?s > 0 && s(0) == '#') | s(1..) | s

is_generic_fn: ast::Expr => <>
is_generic_fn = e =>
   e
      [Fn fe] (?fe.ct_params > 0)
      | <->

is_generic_assign: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
   String, ast::TypeInfo) => <>
is_generic_assign = t =>
   is_ct = ?t.7 > 4 && t.7(0..4) == "@ct0"
   is_ti = t.8 [Fn f] (?f.4 > 0) | <->
   is_fe = is_generic_fn(t.5)
   is_ct || is_ti || is_fe

prefix_decl_name: String, String, ast::Names, ast::Names => String
prefix_decl_name = name, prefix, publics, privates =>
   has_hash = ?name > 0 && name(0) == '#'
   clean = has_hash | name(1..) | name
   is_pub = is_public_name(publics, privates, clean)
   pfx = prefix + "::"
   is_pub | pfx + clean | pfx + "#" + clean

prefix_stmt_to_acc: ast::Expr, String, ast::Names, ast::Names, ast::Exprs, <> => ()
prefix_stmt_to_acc = e, prefix, publics, privates, acc, is_interface =>
   prefix == ""
      |
         e
            [Block b]
               b.exprs @ child =>
                  prefix_stmt_to_acc(child, "", publics, privates, acc, is_interface)
            |
               acc += unmark_private(e)
      |
         is_interface
            |
               e
                  [Block b]
                     b.exprs @ child =>
                        prefix_stmt_to_acc(child, prefix, publics, privates, acc, <+>)
                  [TypeDecl t]
                     clean = decl_clean_name(t.name)
                     is_pub = is_public_name(publics, privates, clean)
                     is_pub
                        |
                           new_td = prefix + "::" + clean
                           acc += ast::Expr(TypeDecl, (ast::TypeDeclExpr((new_td,
                              t.type_info))))
                  [Foreign f]
                     clean = decl_clean_name(f.dva_name)
                     is_pub = is_public_name(publics, privates, clean)
                     is_pub
                        |
                           new_f = prefix + "::" + clean
                           acc += ast::Expr(Foreign, (ast::ForeignFnDecl((f.c_name,
                              new_f, f.abi, f.params,
                              f.return_type, f.ret_record_info, f.is_variable))))
                  [Assign t]
                     t.0 != ""
                        |
                           clean = decl_clean_name(t.0)
                           is_pub = is_public_name(publics, privates, clean)
                           is_pub
                              |
                                 is_fn = t.5 [Fn _]
                                 is_fn
                                    |
                                       is_gen = is_generic_assign(t)
                                       is_gen
                                          |
                                             new_asgn = prefix + "::" + clean
                                             acc += ast::Expr(Assign, (
                                                new_asgn, t.1, t.2,
                                                t.3, t.4, t.5, t.6, t.7, t.8))
                                    |
                                       new_asgn = prefix + "::" + clean
                                       acc += ast::Expr(Assign, (
                                          new_asgn, t.1, t.2,
                                          t.3, t.4, t.5, t.6, t.7, t.8))
            |
               e
                  [Assign t]
                     t.0 == ""
                        |
                           new_lhs = prefix_lhs_expr(t.6, prefix)
                           acc += ast::Expr(Assign, (t.0, t.1,
                              t.2, t.3, t.4, t.5, new_lhs,
                              t.7, t.8))
                        |
                           new_asgn = prefix_decl_name(t.0, prefix,
                              publics, privates)
                           acc += ast::Expr(Assign, (
                              new_asgn, t.1, t.2,
                              t.3, t.4, t.5, t.6, t.7, t.8))
                  [TypeDecl t]
                     new_td = prefix_decl_name(t.name, prefix, publics, privates)
                     acc += ast::Expr(TypeDecl, (ast::TypeDeclExpr((new_td,
                        t.type_info))))
                  [Foreign f]
                     new_f = prefix_decl_name(f.dva_name, prefix,
                        publics, privates)
                     acc += ast::Expr(Foreign, (ast::ForeignFnDecl((f.c_name,
                        new_f, f.abi, f.params,
                        f.return_type, f.ret_record_info, f.is_variable))))
                  [Block b]
                     b.exprs @ child =>
                        prefix_stmt_to_acc(child, prefix, publics, privates, acc, <->)
                  |
                     acc += e

path_mode: String => Int
path_mode = path =>
   buf = {144}
   rc = libc::stat(path, &buf)
   mode_ptr = &buf + 24
   rc == 0 | Int(@[mode_ptr i32]) | -1

file_exists: String => <>
file_exists = path =>
   m = path_mode(path)
   m !< 0 && (m .&. 0xf000) != 0x4000

dir_exists: String => <>
dir_exists = path =>
   m = path_mode(path)
   m !< 0 && (m .&. 0xf000) == 0x4000

path_mtime: String => Int
path_mtime = path =>
   buf = {144}
   rc = libc::stat(path, &buf)
   rc == 0
      |
         sec = Int(@[(&buf + 88) i64])
         nsec = Int(@[(&buf + 96) i64])
         sec * 1000000000 + nsec
      | -1

empty_pkg_instance: () => PkgInstance
empty_pkg_instance = !=>
   m = ImportMap()
   PkgInstance(("", "", "", m))

empty_import_map_state: () => ImportMapState
empty_import_map_state = !=>
   insts = PkgInstances()
   nl = ast::Names()
   np = ast::Names()
   ImportMapState((<->, "", "", "", insts, nl, np))

find_instance: PkgInstances, String => < PkgInstance | >
find_instance = instances, id =>
   res' = <-->
   instances @ inst =>
      inst.id == id | (res' = <+ inst +>; -->)
   res'

find_char_idx: String, Int, Int => Int
find_char_idx = s, ch, i =>
   i < ?s
      | s(i) == ch | i | find_char_idx(s, ch, i + 1)
      | -1

starts_with: String, String => <>
starts_with = s, prefix =>
   lp = ?prefix
   ?s !< lp && s(0..lp) == prefix

ends_with: String, String => <>
ends_with = s, suffix =>
   ls = ?suffix
   ln = ?s
   ln !< ls && s(ln - ls..ln) == suffix

has_substr_step: String, String, Int => <>
has_substr_step = s, sub, i =>
   i + ?sub !> ?s
      |
         match' = <+>
         ?sub @ j =>
            s(i + j) != sub(j)
               |
                  match' = <->
                  -->
         match' | <+> | has_substr_step(s, sub, i + 1)
      | <->

has_substr: String, String => <>
has_substr = s, sub => has_substr_step(s, sub, 0)

string_contains: String, String => <>
string_contains = s, sub => has_substr(s, sub)

starts_with_path: String, String => <>
starts_with_path = path, prefix =>
   lp = ?prefix
   ?path > lp && path(0..lp) == prefix && path(lp) == '/'

get_dir_instance: ImportMapState, String => PkgInstance
get_dir_instance = map, dir =>
   canon_dir = canonical_path(dir)
   found' = empty_pkg_instance()
   is_found' = <->
   map.instances @ inst =>
      !is_found' && inst.id != "root" && inst.src != ""
         |
            canon_src = canonical_path(inst.src)
            match = canon_dir == canon_src || starts_with_path(canon_dir, canon_src)
            match | (found' = inst; is_found' = <+>)
   !is_found' && map.root_dir != ""
      |
         canon_root = canonical_path(map.root_dir)
         match_root = canon_dir == canon_root || starts_with_path(canon_dir, canon_root)
         match_root
            |
               map.instances @ inst =>
                  inst.id == "root" | (found' = inst; is_found' = <+>)
   found'

compute_eff_root: String, String => String
compute_eff_root = map_root, map_dir =>
   map_root == "" || map_root == "."
      | map_dir
      |
         map_root(0) == '/'
            | map_root
            | path_join(map_dir, map_root)

find_and_load_import_map: String, String => < ImportMapState | >
find_and_load_import_map = target_path, explicit_map_path =>
   map_path' = explicit_map_path
   root_dir' = ++ ""
   has_map_file' = <->
   explicit_map_path != ""
      |
         map_path' = explicit_map_path
         has_map_file' = file_exists(explicit_map_path)
      |
         target_full = canonical_path(target_path)
         start_dir = dir_exists(target_full) | target_full | dirname(target_full)
         curr_dir' = start_dir
         0..128 @ _ =>
            curr_dir' == "" || curr_dir' == "/" | -->
            cand_ccl = path_join(curr_dir', "edva.ccl")
            file_exists(cand_ccl)
               |
                  root_dir' = curr_dir'
                  cand_map = path_join(curr_dir', ".edva/imports.ccl")
                  file_exists(cand_map)
                     |
                        map_path' = cand_map
                        has_map_file' = <+>
                  -->
            next_d = dirname(curr_dir')
            next_d == curr_dir' | -->
            curr_dir' = next_d
   !has_map_file'
      |
         empty_state = empty_import_map_state()
         empty_state.root_dir = root_dir'
         <+ empty_state +>
      |
         mtime_map = path_mtime(map_path')
         doc_res = ccl::parse_file(map_path')
         doc_res
            | doc =>
               map_root = ccl::get(doc, "root") | _ | ""
               map_dir = root_dir' != "" | root_dir' | dirname(dirname(map_path'))
               eff_root = compute_eff_root(map_root, map_dir)
               ccl_file = path_join(eff_root, "edva.ccl")
               ccl_stale = file_exists(ccl_file) && mtime_map < path_mtime(ccl_file)
               lock_file = path_join(eff_root, "edva.lock.ccl")
               lock_stale = file_exists(lock_file) && mtime_map < path_mtime(lock_file)
               ccl_stale || lock_stale
                  |
                     print $ "E5031: import map is older than edva.ccl — run 'edva pkg fetch'"
                     <-->
                  |
                     inst_list = PkgInstances()
                     root_name' = ++ ""
                     file_exists(ccl_file)
                        |
                           ccl_doc_res = ccl::parse_file(ccl_file)
                           ccl_doc_res
                              | cdoc =>
                                 root_name' = ccl::get(cdoc, "name") | _ | ""
                     inst_sec_opt = ccl::get_section(doc, "instances")
                     inst_sec_opt
                        | sec =>
                           sec.entries @ entry =>
                              inst_id = entry.key
                              entry.val
                                 [Block b]
                                    isrc_raw = ccl::get(b, "src") | _ | ""
                                    is_rel = isrc_raw != "" && isrc_raw(0) != '/'
                                    isrc = is_rel | path_join(eff_root, isrc_raw) | isrc_raw
                                    iname_raw = ccl::get(b, "name") | _ | ""
                                    use_root_name = inst_id == "root" && iname_raw == ""
                                    iname = use_root_name | root_name' | iname_raw
                                    aliases_map = ImportMap()
                                    asec_opt = ccl::get_section(b, "aliases")
                                    asec_opt
                                       | asec =>
                                          asec.entries @ ae =>
                                             ae.val
                                                [Str aval]
                                                   aliases_map ^ (ae.key) = aval
                                    inst_list += PkgInstance((inst_id, isrc, iname, aliases_map))
                     nat_libs' = ast::Names()
                     nat_pkg' = ast::Names()
                     nat_sec_opt = ccl::get_section(doc, "native")
                     nat_sec_opt
                        | nsec =>
                           libs_list_opt = ccl::get_list(nsec, "libs")
                           libs_list_opt
                              | llist =>
                                 llist @ s => nat_libs' += s
                           pkg_list_opt = ccl::get_list(nsec, "pkg-config")
                           pkg_list_opt
                              | plist =>
                                 plist @ s => nat_pkg' += s
                     <+ ImportMapState((<+>, map_path', eff_root, root_name', inst_list,
                        nat_libs', nat_pkg')) +>
            | _ =>
               print $ "E5030: Could not parse import map '" + map_path' + "'"
               <-->

compute_local_cid: PkgInstance, String => String
compute_local_cid = curr_inst, mod_path =>
   seg = parser::last_segment(mod_path)
   curr_inst.id != "" && curr_inst.id != "root"
      | curr_inst.id + "::" + seg
      | seg

get_resolved_cid: ResolvedModule => String
get_resolved_cid = r =>
   r
      [File f] f.canonical_id
      [Dir d] d.canonical_id
      | ""

get_resolved_is_pkg: ResolvedModule => <>
get_resolved_is_pkg = r =>
   r
      [File f] f.is_pkg
      [Dir d] d.is_pkg
      | <->

find_name_idx: ast::Names, String => Int
find_name_idx = names, name =>
   idx' = -1
   0..?names @ i =>
      n = names(i) | _ | ""
      n == name | (idx' = i; -->)
   idx'

format_cycle_chain: ast::Names, Int, String => String
format_cycle_chain = stack, start_idx, target =>
   b = {128}
   start_idx..?stack @ i =>
      n = stack(i) | _ | ""
      i > start_idx | b += " -> "
      b += n
   b += " -> "
   b += target
   +b

pop_loading_stack: Loader => ()
pop_loading_stack = ldr =>
   n = ?ldr.loading_stack
   n > 0
      |
         stk = ast::Names()
         0..n - 1 @ i =>
            stk += (ldr.loading_stack(i) | _ | "")
         ldr.loading_stack = stk

// "<dir>/<mod_path>.dva" as a file module, else "<dir>/<mod_path>/" as a
// directory module, else None.
resolve_in_dir: String, String, String, <> => ResolvedModule
resolve_in_dir = dir, mod_path, cid, is_pkg =>
   f = path_join(dir, mod_path + ".dva")
   d = path_join(dir, mod_path)
   file_exists(f)
      | ResolvedModule(File, ((f, cid, is_pkg)))
      | dir_exists(d)
         | ResolvedModule(Dir, ((d, cid, is_pkg)))
         | ResolvedModule(None)

is_resolved: ResolvedModule => <>
is_resolved = r =>
   r
      [None] <->
      | <+>

is_internal_path: String => <>
is_internal_path = p =>
   p == "internal" || starts_with(p, "internal/") ||
      string_contains(p, "/internal/") || ends_with(p, "/internal")

// "@alias" -> the root module src/<name>.dva of the aliased package instance.
resolve_pkg_root: String, String, PkgInstance => ResolvedModule
resolve_pkg_root = alias, inst_id, inst =>
   root_f = path_join(inst.src, inst.name + ".dva")
   file_exists(root_f)
      | ResolvedModule(File, ((root_f, inst_id + "::" + inst.name, <+>)))
      |
         print $ "E5033: #use @" + alias + ": package '" + inst.name +
            "' has no root module src/" + inst.name + ".dva"
         ResolvedModule(None)

// "@alias/submod" -> a public (non-internal) module of the package instance.
resolve_pkg_sub: String, String, String, PkgInstance => ResolvedModule
resolve_pkg_sub = alias, submod, inst_id, inst =>
   use_path = "#use @" + alias + "/" + submod
   is_internal_path(submod)
      |
         print $ "E5035: " + use_path + ": module is internal to package '" +
            inst.name + "'"
         ResolvedModule(None)
      |
         r = resolve_in_dir(inst.src, submod, inst_id + "::" + submod, <+>)
         !is_resolved(r)
            | print $ "E5034: " + use_path + ": package '" + inst.name +
               "' has no module '" + submod + "'"
         r

// "@alias[/submod]": only a direct dependency of the importing package.
resolve_pkg_module: String, String, Loader => ResolvedModule
resolve_pkg_module = base, mod_path, ldr =>
   curr_inst = get_dir_instance(ldr.import_map, base)
   slash_idx = find_char_idx(mod_path, '/', 0)
   alias = slash_idx < 0 | mod_path(1..) | mod_path(1..slash_idx)
   submod = slash_idx < 0 | "" | mod_path(slash_idx + 1..)
   alias == curr_inst.name
      |
         print $ "E5037: #use @" + alias +
            ": a package cannot import itself; use a local #use"
         ResolvedModule(None)
      | !(curr_inst.aliases ^? alias)
         |
            print $ "E5032: #use @" + alias + ": '" + alias +
               "' is not a dependency of package '" + curr_inst.name + "'"
            ResolvedModule(None)
         |
            inst_id = curr_inst.aliases ^ alias | _ | ""
            find_instance(ldr.import_map.instances, inst_id)
               | inst =>
                  submod == ""
                     | resolve_pkg_root(alias, inst_id, inst)
                     | resolve_pkg_sub(alias, submod, inst_id, inst)
               | ResolvedModule(None)

// A local "#use name": next to the importer, then its parent directory, then
// the stdlib. Local modules are scoped to the importer's package instance.
resolve_local_module: String, String, Loader => ResolvedModule
resolve_local_module = base, mod_path, ldr =>
   curr_inst = ldr.import_map.has_map
      | get_dir_instance(ldr.import_map, base)
      | empty_pkg_instance()
   cid = compute_local_cid(curr_inst, mod_path)
   local = resolve_in_dir(base, mod_path, cid, <->)
   parent_base = dirname(base)
   has_parent = parent_base != "" && parent_base != "."
   is_resolved(local)
      | local
      |
         parent = has_parent
            | resolve_in_dir(parent_base, mod_path, cid, <->)
            | ResolvedModule(None)
         is_resolved(parent)
            | parent
            | resolve_std_module(mod_path)

resolve_std_module: String => ResolvedModule
resolve_std_module = mod_path =>
   seg = parser::last_segment(mod_path)
   std = resolve_in_dir(compiler_std_dir, mod_path, seg, <->)
   is_resolved(std) || compiler_std_dir == "std"
      | std
      | resolve_in_dir("std", mod_path, seg, <->)

resolve_module: String, String, Loader => ResolvedModule
resolve_module = base, mod_path, ldr =>
   is_pkg_import = ?mod_path > 0 && mod_path(0) == '@'
   !is_pkg_import
      | resolve_local_module(base, mod_path, ldr)
      | !ldr.import_map.has_map
         |
            print $ "E5030: #use " + mod_path + ": no import map — run 'edva pkg fetch'"
            ResolvedModule(None)
         | resolve_pkg_module(base, mod_path, ldr)

read_fd_bytes_loop: Int, Builder, Int, Int => < Int | >
read_fd_bytes_loop = fd, b, off, rem =>
   rem == 0 | --| <+ off +>
   chunk = rem < 65536 | rem | 65536
   n = libc::read(fd, &b + off, chunk)
   n < 0
      |
         err = @[__errno_location! i32]
         err == 4 | read_fd_bytes_loop(fd, b, off, rem) | <-->
      |
         n == 0 | <+ off +> | read_fd_bytes_loop(fd, b, off + n, rem - n)

read_file_text: String => < String | >
read_file_text = path =>
   fd = libc::open(path, 0)
   fd < 0 | --| <-->
   sz = libc::lseek(fd, 0, 2)
   sz < 0 | libc::close(fd); --| <-->
   sz == 0 | libc::close(fd); --| <+ "" +>
   libc::lseek(fd, 0, 0)
   b = {sz}
   read_res = read_fd_bytes_loop(fd, b, 0, sz)
   libc::close(fd)
   read_res
      | total =>
         ?b = total
         <+ +b +>
      | <-->

collect_module_exports: ast::Exprs, String, String, <>, ImportMap, ImportMap => <>
collect_module_exports = exprs, bound_name, canonical_id, is_import, table, sources =>
   ok' = <+>
   pfx = canonical_id + "::"
   pfx_priv = canonical_id + "::#"
   lpfx = ?pfx
   lpfx_priv = ?pfx_priv
   alias_pfx = bound_name + "::"
   exprs @ e =>
      !ok' | -->
      e
         [Assign a]
            a.0 != ""
               |
                  is_match = ?a.0 > lpfx && a.0(0..lpfx) == pfx
                  is_priv = ?a.0 > lpfx_priv && a.0(0..lpfx_priv) == pfx_priv
                  is_match && !is_priv
                     |
                        bare = a.0(lpfx..)
                        table ^ (alias_pfx + bare) = a.0
                        is_import
                           |
                              has_prev = table ^? bare
                              has_prev
                                 |
                                    existing = table ^ bare | _ | ""
                                    existing != a.0
                                       |
                                          src = sources ^ bare | _ | ""
                                          print $ "E3033: Name clash: symbol '" +
                                             bare + "' imported from '" + bound_name +
                                             "' conflicts with symbol already imported from '" +
                                             src + "'"
                                          ok' = <->
                                 |
                                    table ^ (bare) = a.0
                                    sources ^ (bare) = bound_name
         [TypeDecl td]
            is_match = ?td.name > lpfx && td.name(0..lpfx) == pfx
            is_priv = ?td.name > lpfx_priv && td.name(0..lpfx_priv) == pfx_priv
            is_match && !is_priv
               |
                  bare = td.name(lpfx..)
                  table ^ (alias_pfx + bare) = td.name
                  is_import
                     |
                        has_prev = table ^? bare
                        has_prev
                           |
                              existing = table ^ bare | _ | ""
                              existing != td.name
                                 |
                                    src = sources ^ bare | _ | ""
                                    print $ "E3033: Name clash: type '" +
                                       bare + "' imported from '" + bound_name +
                                       "' conflicts with type already imported from '" +
                                       src + "'"
                                    ok' = <->
                           |
                              table ^ (bare) = td.name
                              sources ^ (bare) = bound_name
         [Foreign f]
            is_match = ?f.dva_name > lpfx && f.dva_name(0..lpfx) == pfx
            is_priv = ?f.dva_name > lpfx_priv && f.dva_name(0..lpfx_priv) == pfx_priv
            is_match && !is_priv
               |
                  bare = f.dva_name(lpfx..)
                  table ^ (alias_pfx + bare) = f.dva_name
                  is_import
                     |
                        has_prev = table ^? bare
                        has_prev
                           |
                              existing = table ^ bare | _ | ""
                              existing != f.dva_name
                                 |
                                    src = sources ^ bare | _ | ""
                                    print $ "E3033: Name clash: foreign function '" +
                                       bare + "' imported from '" + bound_name +
                                       "' conflicts with symbol already imported from '" +
                                       src + "'"
                                    ok' = <->
                           |
                              table ^ (bare) = f.dva_name
                              sources ^ (bare) = bound_name
   ok'

check_file_clash: ast::Exprs, ImportMap, ImportMap => <>
check_file_clash = stmts, table, sources =>
   ok' = <+>
   stmts @ st =>
      !ok' | -->
      st
         [Assign a]
            a.0 != ""
               |
                  bare = decl_clean_name(a.0)
                  table ^? bare
                     |
                        src = sources ^ bare | _ | ""
                        print $ "E3033: Name clash: symbol '" + bare +
                           "' declared in module conflicts with symbol imported from '" +
                           src + "'"
                        ok' = <->
         [TypeDecl td]
            bare = decl_clean_name(td.name)
            table ^? bare
               |
                  src = sources ^ bare | _ | ""
                  print $ "E3033: Name clash: type '" + bare +
                     "' declared in module conflicts with type imported from '" +
                     src + "'"
                  ok' = <->
         [Foreign f]
            bare = decl_clean_name(f.dva_name)
            table ^? bare
               |
                  src = sources ^ bare | _ | ""
                  print $ "E3033: Name clash: foreign function '" + bare +
                     "' declared in module conflicts with symbol imported from '" +
                     src + "'"
                  ok' = <->
   ok'

rewrite_import_exprs: ast::Exprs, ImportMap, ast::Names => ast::Exprs
rewrite_import_exprs = exprs, table, locals =>
   res = ast::Exprs()
   exprs @ e => res += rewrite_import_expr(e, table, locals)
   res

rewrite_import_call: ast::CallExpr, ImportMap, ast::Names => ast::CallExpr
rewrite_import_call = c, table, locals =>
   fn_name = c.fn_name
   has_mod = fn_name != "" && !loaded_has(locals, fn_name) && (table ^? fn_name)
   new_fn = has_mod | (table ^ fn_name | _ | fn_name) | fn_name
   new_target = rewrite_import_expr(c.fn_target, table, locals)
   new_args = rewrite_import_exprs(c.args, table, locals)
   ast::CallExpr((new_fn, new_target, new_args, c.line, c.col))

rewrite_import_fparams: ast::FParams, ImportMap => ast::FParams
rewrite_import_fparams = params, table =>
   res = ast::FParams()
   params @ p =>
      new_rec = rewrite_import_type_info(p.record_info, table)
      res += ast::ForeignFnParam((p.name, p.param_type, new_rec))
   res

rewrite_import_type_info: ast::TypeInfo, ImportMap => ast::TypeInfo
rewrite_import_type_info = ti, table =>
   ti
      [TypeVar name]
         table ^? name
            | ast::TypeInfo(TypeVar, (table ^ name | _ | name))
            | ti
      [Rec r]
         new_fields = ast::FieldTypes()
         r.0 @ f =>
            new_fti = rewrite_import_type_info(f.rec_type, table)
            new_def = rewrite_import_expr(f.default_expr, table, ast::Names())
            new_fields += ast::RecordFieldType((f.name, f.val_type, new_fti,
               f.has_default, new_def))
         ast::TypeInfo(Rec, (new_fields, r.1, r.2, r.3, r.4, r.5))
      [Fn f]
         new_p_tis = ast::VInfos()
         f.1 @ pti => new_p_tis += rewrite_import_type_info(pti, table)
         new_ret_ti = rewrite_import_type_info(f.3, table)
         ast::TypeInfo(Fn, (f.0, new_p_tis, f.2, new_ret_ti, f.4))
      [Ram r]
         s0 = r.0
         s1 = r.1
         s0_ti = rewrite_import_type_info(s0.payload_record, table)
         s1_ti = rewrite_import_type_info(s1.payload_record, table)
         ast::TypeInfo(Ram, (
            ast::RamSlotInfo((s0.has_payload, s0.payload_type, s0_ti)),
            ast::RamSlotInfo((s1.has_payload, s1.payload_type, s1_ti))))
      [Enum es]
         new_es = ast::EnumSlots()
         es @ s =>
            new_sti = rewrite_import_type_info(s.payload_record, table)
            new_es += ast::EnumSlotInfo((s.label, s.has_payload,
               s.payload_type, new_sti))
         ast::TypeInfo(Enum, new_es)
      [Array a]
         new_elem_ti = rewrite_import_type_info(a.1, table)
         ast::TypeInfo(Array, (a.0, new_elem_ti, a.2))
      [Map m]
         new_val_ti = rewrite_import_type_info(m.2, table)
         ast::TypeInfo(Map, (m.0, m.1, new_val_ti))
      [ThreadId t]
         new_t_ti = rewrite_import_type_info(t.1, table)
         ast::TypeInfo(ThreadId, (t.0, new_t_ti))
      | ti

member_chain_name: ast::Expr => String
member_chain_name = e =>
   e
      [Var v] v
      [Member t]
         b = member_chain_name(t.target)
         b == "" | "" | b + (t.is_module_access | "::" | ".") + t.field_name
      | ""

rewrite_import_expr: ast::Expr, ImportMap, ast::Names => ast::Expr
rewrite_import_expr = e, table, locals =>
   e
      [Var v]
         !loaded_has(locals, v) && (table ^? v)
            | ast::Expr(Var, (table ^ v | _ | v))
            | e
      [Call c]
         ast::Expr(Call, rewrite_import_call(c, table, locals))
      [Bin b]
         ast::Expr(Bin, (b.0,
            rewrite_import_expr(b.1, table, locals),
            rewrite_import_expr(b.2, table, locals)))
      [Unary u]
         ast::Expr(Unary, (u.0,
            rewrite_import_expr(u.1, table, locals)))
      [Fn fe]
         fn_locals = ++locals
         fe.params @ p => (p != "" | fn_locals += p)
         fe.ct_params @ cp => (cp != "" | fn_locals += cp)
         new_body = rewrite_import_expr(fe.body, table, fn_locals)
         ast::Expr(Fn, (ast::FnExpr((fe.params, fe.ct_params, new_body))))
      [Block be]
         blk_locals = ++locals
         new_exprs = ast::Exprs()
         be.exprs @ child =>
            new_exprs += rewrite_import_expr(child, table, blk_locals)
            child [Assign ca] (ca.0 != "" | blk_locals += ca.0)
         ast::Expr(Block, (ast::BlockExpr(new_exprs)))
      [Choice ch]
         new_cond = rewrite_import_expr(ch.cond, table, locals)
         new_branches = ast::Branches()
         ch.branches @ br =>
            br_locals = ++locals
            br.bind_vars @ bv => (bv != "" | br_locals += bv)
            new_cases = rewrite_import_exprs(br.case_values, table, br_locals)
            new_pred = rewrite_import_expr(br.pred_fn, table, br_locals)
            new_blk = rewrite_import_expr(br.block, table, br_locals)
            new_branches += ast::ChoiceBranch((br.kind, new_cases, new_pred,
               br.variant_names, br.bind_vars, br.is_identity_extractor,
               new_blk))
         ast::Expr(Choice, (ast::ChoiceExpr((new_cond, ch.is_exhaustive,
            new_branches))))
      [Assign a]
         new_rhs = rewrite_import_expr(a.5, table, locals)
         new_lhs = rewrite_import_expr(a.6, table, locals)
         new_ti = rewrite_import_type_info(a.8, table)
         ast::Expr(Assign, (a.0, a.1, a.2, a.3, a.4, new_rhs, new_lhs,
            a.7, new_ti))
      [TypeDecl td]
         new_ti = rewrite_import_type_info(td.type_info, table)
         ast::Expr(TypeDecl, (ast::TypeDeclExpr((td.name, new_ti))))
      [Foreign f]
         new_params = rewrite_import_fparams(f.params, table)
         new_ret_ti = rewrite_import_type_info(f.ret_record_info, table)
         ast::Expr(Foreign, (ast::ForeignFnDecl((f.c_name, f.dva_name,
            f.abi, new_params, f.return_type, new_ret_ti, f.is_variable))))
      [Member m]
         m.is_module_access
            |
               qn = member_chain_name(e)
               table ^? qn
                  | ast::Expr(Var, (table ^ qn | _ | qn))
                  | e
            |
               new_target = rewrite_import_expr(m.target, table, locals)
               new_idx = rewrite_import_expr(m.index_expr, table, locals)
               ast::Expr(Member, (ast::MemberExpr((new_target, m.field_name,
                  m.is_module_access, new_idx, m.line, m.col))))
      [Record re]
         new_fields = ast::Fields()
         re.fields @ fld =>
            new_val = rewrite_import_expr(fld.val, table, locals)
            new_fields += ast::RecordField((fld.has_name, fld.name, new_val))
         ast::Expr(Record, (ast::RecordExpr((new_fields, re.is_repeat))))
      [KeyAccess ka]
         new_target = rewrite_import_expr(ka.target, table, locals)
         new_key = rewrite_import_expr(ka.key, table, locals)
         ast::Expr(KeyAccess, (ast::KeyAccessExpr((new_target, new_key,
            ka.is_membership, ka.is_delete, ka.line, ka.col))))
      [Cycle cy]
         new_iter = rewrite_import_expr(cy.iterable, table, locals)
         new_fn = rewrite_import_expr(cy.body_fn, table, locals)
         ast::Expr(Cycle, (ast::CycleExpr((new_iter, new_fn, cy.is_rune))))
      [CycleEscape ce]
         new_cy = rewrite_import_expr(ce.cycle, table, locals)
         new_br = rewrite_import_expr(ce.branch, table, locals)
         ast::Expr(CycleEscape, (ast::CycleEscapeExpr((new_cy, new_br))))
      [Range r]
         new_lhs = r.has_lhs | rewrite_import_expr(r.lhs, table, locals) | r.lhs
         new_rhs = r.has_rhs | rewrite_import_expr(r.rhs, table, locals) | r.rhs
         ast::Expr(Range, (ast::RangeExpr((r.has_lhs, r.has_rhs, new_lhs,
            new_rhs))))
      [NamedArg na]
         new_val = rewrite_import_expr(na.val, table, locals)
         ast::Expr(NamedArg, (ast::NamedArgExpr((na.name, new_val))))
      [Variant v]
         new_args = rewrite_import_exprs(v.args, table, locals)
         ast::Expr(Variant, (ast::VariantExpr((v.tag_name, new_args))))
      [TypeCast tc]
         new_expr = rewrite_import_expr(tc.expr, table, locals)
         ast::Expr(TypeCast, (ast::CastExpr((tc.target_type, new_expr))))
      [Spawn sp]
         ast::Expr(Spawn, (ast::SpawnExpr((rewrite_import_call(sp.call,
            table, locals)))))
      [Join jn]
         ast::Expr(Join, (ast::JoinExpr((rewrite_import_expr(jn.handle,
            table, locals)))))
      [Exit ex]
         new_ex = rewrite_import_expr(ex.code, table, locals)
         ast::Expr(Exit, (ast::ExitExpr(new_ex)))
      [UserDiag ud]
         new_msg = rewrite_import_expr(ud.msg, table, locals)
         ast::Expr(UserDiag, (ast::UserDiagExpr((ud.is_warn, new_msg,
            ud.line, ud.col))))
      [RawMemory rm]
         new_addr = rewrite_import_expr(rm.addr, table, locals)
         ast::Expr(RawMemory, (ast::RawMemoryExpr((new_addr, rm.load_type,
            rm.rec_name))))
      [SizeOf so]
         new_sti = rewrite_import_type_info(so.rec_type, table)
         ast::Expr(SizeOf, (ast::SizeOfExpr((so.val_type, new_sti))))
      [MapLiteral ml]
         new_pairs = ast::MapPairs()
         ml.pairs @ p =>
            new_pairs += ast::MapPair((rewrite_import_expr(p.key, table, locals),
               rewrite_import_expr(p.value, table, locals)))
         ast::Expr(MapLiteral, (ast::MapLiteralExpr(new_pairs)))
      [CompileTime ct]
         new_ce = rewrite_import_expr(ct.expr, table, locals)
         ast::Expr(CompileTime, (ast::CompileTimeExpr(new_ce)))
      [Copy cp]
         ast::Expr(Copy, (rewrite_import_expr(cp, table, locals)))
      [BuilderCreate bc]
         ast::Expr(BuilderCreate, (rewrite_import_expr(bc, table, locals)))
      | e

load_stmts: ast::Exprs, String, String, ast::Names, ast::Names, Loader, String, ast::Ints, ast::Ints => <>
load_stmts = stmts, base, prefix, publics, privates, ldr, path, lines, cols =>
   ok' = <+>
   import_entries = ImportEntries()
   has_imp_mods' = <->
   stmts @ st =>
      !ok' | -->
      st
         [Import imp]
            has_imp_mods' = <+>
            resolved = resolve_module(base, imp.module_path, ldr)
            resolved
               [None]
                  !starts_with(imp.module_path, "@")
                     |
                        print $ "E5006: Imported module '" + imp.module_name +
                           "' not found at '" + imp.module_path +
                           "' or in stdlib"
                  ok' = <->
               |
                  cid = get_resolved_cid(resolved)
                  import_entries += ImportEntry((imp.module_name, cid, imp.is_import))
                  imp.is_dynamic
                     |
                        has_dyn = loaded_has(ldr.dynamic_mods, imp.module_name)
                        !has_dyn
                           |
                              dmods = ldr.dynamic_mods
                              dmods += imp.module_name
                              ldr.dynamic_mods = dmods
                              dpath = resolved [File f] f.path [Dir d] d.path | imp.module_path
                              dpaths = ldr.dynamic_paths
                              dpaths += canonical_path(dpath)
                              ldr.dynamic_paths = dpaths
                              decl_code = "#public\n" +
                                 "reload_so: String => <>\n" +
                                 "reload_so = p => <+>\n" +
                                 "reload: () => <>\n" +
                                 "reload = !=> <+>\n"
                              dppr = parser::parse_init(decl_code)
                              dprog = parser::parse_program(dppr)
                              dprog | dp =>
                                 dp [Block db]
                                    db.exprs @ de =>
                                       prefix_stmt_to_acc(de, cid,
                                          dppr.publics, dppr.privates,
                                          ldr.out_exprs, <->)
                  saved_dep = ldr.is_dep
                  ldr.is_dep = <+>
                  res = load_resolved(resolved, imp.module_path, ldr)
                  ldr.is_dep = saved_dep
                  !res | ok' = <->
   !ok'
      | <->
      |
         import_table = ImportMap()
         import_source = ImportMap()
         ?import_entries @ mi =>
            !ok' | -->
            ientry = import_entries(mi) | _ | ImportEntry(("", "", <->))
            cres = collect_module_exports(ldr.out_exprs, ientry.bound_name,
               ientry.canonical_id, ientry.is_import, import_table, import_source)
            !cres | ok' = <->
         !ok'
            | <->
            |
               has_imp_mods'
                  |
                     fcres = check_file_clash(stmts, import_table, import_source)
                     !fcres | ok' = <->
               !ok'
                  | <->
                  |
                     is_iface = ldr.is_modular && ldr.is_dep
                     st_idx' = 0
                     stmts @ st2 =>
                        is_imp = st2 [Import _]
                        !is_imp
                           |
                              cur_st = has_imp_mods'
                                 | rewrite_import_expr(st2, import_table,
                                    ast::Names())
                                 | st2
                              prefix_stmt_to_acc(cur_st, prefix, publics,
                                 privates, ldr.out_exprs, is_iface)
                              !is_iface
                                 |
                                    f_line = lines(st_idx') | _ | 1
                                    f_col = cols(st_idx') | _ | 1
                                    ldr_f = ldr.out_files
                                    ldr_f += path
                                    ldr.out_files = ldr_f
                                    ldr_l = ldr.out_lines
                                    ldr_l += f_line
                                    ldr.out_lines = ldr_l
                                    ldr_c = ldr.out_cols
                                    ldr_c += f_col
                                    ldr.out_cols = ldr_c
                        st_idx' = st_idx' + 1
                     ok'

load_single_file: String, String, <>, String, Loader => <>
load_single_file = path, prefix, is_pkg, imp_path, ldr =>
   src_res = read_file_text(path)
   src_res
      | src =>
         ldr.loaded_files += path
         ?src == 0
            | <+>
            |
               ppr = parser::parse_init(src)
               parser::parser_set_file(ppr, path)
               lexer::lex_set_file(path)
               ppr.allow_module_refs = <+>
               prog_res = parser::parse_program(ppr)
               prog_res
                  | prog =>
                     is_pkg && ?ppr.publics == 0
                        |
                           print $ "E5036: #use " + imp_path +
                              ": module exports nothing (no #public)"
                           <->
                        |
                           prog
                              [Block b]
                                 !ldr.is_dep
                                    |
                                       ?ppr.exports @ ei =>
                                          ldr.exports += (ppr.exports(ei) | _ | "")
                                 load_stmts(b.exprs, dirname(path), prefix,
                                    ppr.publics, ppr.privates, ldr, path,
                                    ppr.top_lines, ppr.top_cols)
                              | <->
                  | <->
      |
         print $ "E5005: Could not read source file '" + path + "'"
         <->

load_file: String, String, <>, String, Loader => <>
load_file = path, prefix, is_pkg, imp_path, ldr =>
   prefix != "" && loaded_has(ldr.loaded, prefix)
      | <+>
      |
         prefix != ""
            |
               loaded = ldr.loaded
               loaded += prefix
               ldr.loaded = loaded
         load_single_file(path, prefix, is_pkg, imp_path, ldr)

load_dir_files: ast::Names, String, String, <>, String, Loader => <>
load_dir_files = files, dir_path, prefix, is_pkg, imp_path, ldr =>
   ok' = <+>
   ?files @ i =>
      !ok' | -->
      fname = (files(i) | _ | "")
      child_path = path_join(dir_path, fname)
      res = load_single_file(child_path, prefix, is_pkg, imp_path, ldr)
      !res | ok' = <->
   ok'

load_resolved: ResolvedModule, String, Loader => <>
load_resolved = resolved, imp_path, ldr =>
   resolved
      [File f]
         stk_idx = f.is_pkg | find_name_idx(ldr.loading_stack, f.canonical_id) | 0 - 1
         stk_idx !< 0
            |
               chain = format_cycle_chain(ldr.loading_stack, stk_idx, f.canonical_id)
               print $ "E5038: module import cycle across packages: " + chain
               <->
            |
               loaded_has(ldr.loaded, f.canonical_id)
                  | <+>
                  |
                     f.is_pkg
                        |
                           stk = ldr.loading_stack
                           stk += f.canonical_id
                           ldr.loading_stack = stk
                     res = load_file(f.path, f.canonical_id, f.is_pkg, imp_path, ldr)
                     f.is_pkg | pop_loading_stack(ldr)
                     res
      [Dir d]
         stk_idx = d.is_pkg | find_name_idx(ldr.loading_stack, d.canonical_id) | 0 - 1
         stk_idx !< 0
            |
               chain = format_cycle_chain(ldr.loading_stack, stk_idx, d.canonical_id)
               print $ "E5038: module import cycle across packages: " + chain
               <->
            |
               loaded_has(ldr.loaded, d.canonical_id)
                  | <+>
                  |
                     d.is_pkg
                        |
                           stk = ldr.loading_stack
                           stk += d.canonical_id
                           ldr.loading_stack = stk
                     ldr.loaded += d.canonical_id
                     files = dir_dva_files(d.path)
                     res = load_dir_files(files, d.path, d.canonical_id, d.is_pkg, imp_path, ldr)
                     d.is_pkg | pop_loading_stack(ldr)
                     res
      | <->

load_target: String, String, Loader => <>
load_target = path, prefix, ldr =>
   dir_exists(path)
      |
         main_cand = path_join(path, "main.dva")
         file_exists(main_cand)
            | load_file(main_cand, prefix, <->, "", ldr)
            |
               files = dir_dva_files(path)
               load_dir_files(files, path, prefix, <->, "", ldr)
      | load_file(path, prefix, <->, "", ldr)

load_all: String, String, <>, String => ModuleLoad
load_all = target, target_prefix, is_modular, import_map_arg =>
   map_res = find_and_load_import_map(target, import_map_arg)
   map_res
      | map =>
         ldr = Loader((ast::Exprs(), ast::Names(), ast::Names(),
            ast::Names(), ast::Names(), is_modular, <->,
            map, ast::Names(), ast::Names(), ast::Ints(), ast::Ints(),
            ast::Names()))
         tres = load_target(target, target_prefix, ldr)
         ModuleLoad((ldr.out_exprs, ldr.loaded, ldr.exports,
            ldr.dynamic_mods, ldr.dynamic_paths, tres,
            map.native_libs, map.native_pkg_config,
            ldr.out_files, ldr.out_lines, ldr.out_cols,
            ldr.loaded_files))
      |
         ModuleLoad((ast::Exprs(), ast::Names(), ast::Names(),
            ast::Names(), ast::Names(), <->,
            ast::Names(), ast::Names(),
            ast::Names(), ast::Ints(), ast::Ints(),
            ast::Names()))

strip_trailing_slash: String => String
strip_trailing_slash = s =>
   n = ?s
   n > 0 && s(n - 1) == '/' | s(..-1) | s

basename: String => String
basename = path =>
   s = strip_trailing_slash(path)
   last = find_last_slash(s, 0, -1)
   last < 0 | s | s(last + 1..)

derive_base_name: String => String
derive_base_name = target_path =>
   b = basename(target_path)
   b(-4..) == ".dva" | b(..-4) | b

build_argv: mem::Arena, ast::Names, Int, Int, Addr => ()
build_argv = a, args, i, n, buf =>
   i < n
      |
         arg = args(i) | _ | ""
         len = ?arg
         cstr = mem::alloc(a, len + 1)
         mem::copy(cstr, &arg, len)
         @[cstr + len] = 0i8
         @[buf + i * 8] = cstr
         build_argv(a, args, i + 1, n, buf)

#foreign
   environ: Addr

waitpid_loop: Int, Addr => Int
waitpid_loop = pid, status_buf =>
   w = libc::waitpid(pid, status_buf, 0)
   w < 0
      |
         err = @[__errno_location! i32]
         err == 4
            | waitpid_loop(pid, status_buf)
            | 0 - 1
      | 0

run_cmd: ast::Names => Int
run_cmd = args =>
   n = ?args
   n == 0
      | 0 - 1
      |
         cmd_a = mem::arena(4096)
         argv_buf = mem::alloc(cmd_a, (n + 1) * 8)
         build_argv(cmd_a, args, 0, n, argv_buf)
         @[argv_buf + n * 8] = sys::addr_null
         pid_buf = mem::alloc(cmd_a, 8)
         file = args(0) | _ | ""
         ret = libc::posix_spawnp(pid_buf, file, sys::addr_null, sys::addr_null,
            argv_buf, environ)
         ret != 0
            |
               mem::destroy(cmd_a)
               0 - 1
            |
               pid = Int(@[pid_buf i32])
               status_buf = mem::alloc(cmd_a, 8)
               wres = waitpid_loop(pid, status_buf)
               wres < 0
                  |
                     mem::destroy(cmd_a)
                     0 - 1
                  |
                     status = Int(@[status_buf i32])
                     mem::destroy(cmd_a)
                     sig = status .&. 127
                     sig != 0
                        |
                           print $ "Process terminated by signal " +
                              str::from_int(sig)
                           128 + sig
                        |
                           (status .>. 8) .&. 255

get_default_target_triple: Int => String
get_default_target_triple = _ =>
   sys::addr_opt(llvm_get_default_triple!)
      | t =>
         s = sys::c_str(t)
         llvm_dispose_message(t)
         s
      |
         print $ "E5016: LLVM could not determine" +
            " a default target triple; pass one with -target"
         sys::exit(1)
         ""

has_name_step: ast::Names, String, Int => <>
has_name_step = names, name, i =>
   i < ?names
      |
         (names(i) | _ | "") == name
            | <+>
            | has_name_step(names, name, i + 1)
      | <->

has_name: ast::Names, String => <>
has_name = names, name => has_name_step(names, name, 0)

collect_link_libs_expr: ast::Expr, ast::Names => ast::Names
collect_link_libs_expr = e, libs =>
   e
      [Foreign f]
         f.abi != "c" && !has_name(libs, f.abi)
            |
               libs += f.abi
               libs
            | libs
      [Block b]
         collect_link_libs_step(b.exprs, libs)
      | libs

collect_link_libs_step: ast::Exprs, ast::Names => ast::Names
collect_link_libs_step = stmts, libs =>
   cur' = libs
   stmts @ child =>
      cur' = collect_link_libs_expr(child, cur')
   cur'

collect_link_libs: ast::Exprs => ast::Names
collect_link_libs = stmts =>
   libs = ast::Names()
   libs += "pthread"
   libs += "m"
   collect_link_libs_step(stmts, libs)

#type CliOpts (
   target: String,
   outpath: String,
   run_exec: <>,
   ir_only: <>,
   no_runtime: <>,
   no_main: <>,
   repl_mode: <>,
   opt: String,
   triple: String,
   help: <>,
   ast_dump: <>,
   ast_tree: <>,
   eval_src: String,
   typed_ast: <>,
   typed_codegen: <>,
   header_path: String,
   is_shared: <>,
   is_module: <>,
   module_name: String,
   import_map: String,
   cache_dir: String,
   no_cache: <>
)

init_opts: Int => CliOpts
init_opts = _ =>
   CliOpts(("", "", <->, <->, <->, <->, <->, "", "", <->, <->, <->, "",
      <->, <+>, "", <->, <->, "", "", "", <->))


find_char_at: String, Int, Int => Int
find_char_at = s, i, ch =>
   i < ?s
      | (s(i) == ch | i | find_char_at(s, i + 1, ch))
      | -1

c_guard_char: Int => Int
c_guard_char = ch =>
   (ch !< 97 && ch !> 122)
      | ch - 32
      |
         ((ch !< 65 && ch !> 90) || (ch !< 48 && ch !> 57))
            | ch
            | 95

c_header_guard: String => String
c_header_guard = path =>
   slash = find_last_slash(path, 0, -1)
   base = slash !< 0 | path(slash + 1..?path) | path
   b = {?base + 8}
   ?base @ i =>
      b += c_guard_char(base(i))
   s = +b
   has_h = s(-2..) == "_H"
   res = has_h | s | s + "_H"
   ?res == 0 | "DVA_EXPORTS_H" | res

c_type_of_ti: ast::ValueType, ast::TypeInfo => String
c_type_of_ti = vt, ti =>
   ti
      [TypeVar name] codegen::decl_bare_name(name, 0)
      |
         vt
            [Int, I64] "int64_t"
            [I32] "int32_t"
            [I16] "int16_t"
            [I8] "int8_t"
            [U64] "uint64_t"
            [U32, Rune] "uint32_t"
            [U16] "uint16_t"
            [U8] "uint8_t"
            [Float, F64] "double"
            [F32] "float"
            [Addr, RawPtr] "void*"
            [Str] "const char*"
            [Flag] "bool"
            [Unit] "void"
            | "void*"

find_assign_sig: ast::Exprs, String => SigResult
find_assign_sig = stmts, name =>
   found' = <->
   res' = ast::TypeInfo(Prim, ast::ValueType(Unit))
   ?stmts @ i =>
      st = stmts(i)!!
      st
         [Assign a]
            a.8
               [Fn fn_info]
                  a.0 == name
                     |
                        res' = ast::TypeInfo(Fn, fn_info)
                        found' = <+>
                        -->
   SigResult((res', found'))

find_assign_params: ast::Exprs, String => ast::Names
find_assign_params = stmts, name =>
   params' = ast::Names()
   ?stmts @ i =>
      st = stmts(i)!!
      st
         [Assign a]
            a.5
               [Fn f]
                  a.0 == name
                     |
                        params' = f.params
                        -->
   params'

add_type_var_from_ti: ast::TypeInfo, ast::Names => ()
add_type_var_from_ti = ti, names =>
   n = ti [TypeVar name] name | ""
   n != ""
      |
         bare = codegen::decl_bare_name(n, 0)
         !loaded_has(names, bare) | names += bare

collect_used_record_types: ast::Exprs, ast::Names => ast::Names
collect_used_record_types = stmts, exports =>
   used = ast::Names()
   ?exports @ i =>
      item = exports(i)!!
      eq_pos = find_char_at(item, 0, 61)
      dva_name = eq_pos > 0 | item(0..eq_pos) | item
      bare = codegen::decl_bare_name(dva_name, 0)
      sig_res' = find_assign_sig(stmts, dva_name)
      !sig_res'.ok | sig_res' = find_assign_sig(stmts, bare)
      sig_res'.ok
         |
            sig_ti = sig_res'.ti
            sig_ti
               [Fn fn_info]
                  add_type_var_from_ti(fn_info.3, used)
                  params_ti = fn_info.1
                  ?params_ti @ j =>
                     pti = params_ti(j)!!
                     add_type_var_from_ti(pti, used)
   0.. @ _ =>
      prev_count = ?used
      ?stmts @ s_i =>
         st = stmts(s_i)!!
         st
            [TypeDecl td]
               bare_td = codegen::decl_bare_name(td.name, 0)
               loaded_has(used, bare_td)
                  |
                     td.type_info
                        [Rec r]
                           flds = r.0
                           ?flds @ f_i =>
                              f = flds(f_i)!!
                              add_type_var_from_ti(f.rec_type, used)
      ?used == prev_count | -->
   used

format_record_c_struct: ast::TypeDeclExpr => String
format_record_c_struct = td =>
   b = {256}
   td.type_info
      [Rec r]
         b += "typedef struct {\n"
         flds = r.0
         ?flds @ i =>
            f = flds(i)!!
            f_type = c_type_of_ti(f.val_type, f.rec_type)
            f_name = f.name != "" | f.name | ("_" + str::from_int(i))
            b += "    " + f_type + " " + f_name + ";\n"
         b_name = codegen::decl_bare_name(td.name, 0)
         packed_attr = r.5 | " __attribute__((packed))" | ""
         b += "}" + packed_attr + " " + b_name + ";\n\n"
         +b
      [Bitfield bf]
         b += "typedef struct {\n"
         f_type_bf = c_type_of_ti(bf.backing_type,
            ast::TypeInfo(Prim, bf.backing_type))
         ?bf.fields @ i =>
            f_bf = bf.fields(i)!!
            b += "    " + f_type_bf + " " + f_bf.name + " : " +
               str::from_int(f_bf.bit_width) + ";\n"
         b_name_bf = codegen::decl_bare_name(td.name, 0)
         b += "} __attribute__((packed)) " + b_name_bf + ";\n\n"
         +b
      | ""

generate_c_header: ast::Expr, ast::Names, String => <>
generate_c_header = prog, exports, header_path =>
   stmts = prog [Block b] b.exprs | ast::Exprs()
   guard = c_header_guard(header_path)
   hdr = {4096}
   hdr += ("#ifndef " + guard + "\n",
      "#define " + guard + "\n\n",
      "#include <stdint.h>\n",
      "#include <stddef.h>\n",
      "#include <stdbool.h>\n\n",
      "#ifdef __cplusplus\n",
      "extern \"C\" {\n",
      "#endif\n\n")

   used_records = collect_used_record_types(stmts, exports)
   emitted_structs = ast::Names()
   ?stmts @ s_i =>
      st = stmts(s_i)!!
      st
         [TypeDecl td]
            b_name = codegen::decl_bare_name(td.name, 0)
            loaded_has(used_records, b_name)
               |
                  !loaded_has(emitted_structs, b_name)
                     |
                        td.type_info
                           [Rec _]
                              hdr += format_record_c_struct(td)
                              emitted_structs += b_name
   has_error' = <->
   emitted_symbols = ast::Names()
   ?exports @ e_i =>
      item = exports(e_i)!!
      eq_pos = find_char_at(item, 0, 61)
      dva_name = eq_pos > 0 | item(0..eq_pos) | item
      c_name0 = eq_pos > 0 | item(eq_pos + 1..?item) |
         codegen::decl_bare_name(item, 0)
      c_name = (?c_name0 > 0 && c_name0(0) == '#') | c_name0(1..) | c_name0
      !loaded_has(emitted_symbols, c_name)
         |
            bare = codegen::decl_bare_name(dva_name, 0)
            sig_res' = find_assign_sig(stmts, dva_name)
            !sig_res'.ok | sig_res' = find_assign_sig(stmts, bare)
            !sig_res'.ok
               |
                  print $ "E5020: Exported function '" + dva_name +
                     "' has no type signature."
                  has_error' = <+>
               |
                  sig_ti = sig_res'.ti
                  sig_ti
                     [Fn fn_info]
                        ret_c = c_type_of_ti(fn_info.2, fn_info.3)
                        pnames' = find_assign_params(stmts, dva_name)
                        ?pnames' == 0 |
                           pnames' = find_assign_params(stmts, bare)
                        params_vt = fn_info.0
                        params_ti = fn_info.1
                        proto = {128}
                        proto += ret_c + " " + c_name + "("
                        ?params_vt == 0
                           | proto += "void"
                           |
                              ?params_vt @ j =>
                                 p_vt = params_vt(j)!!
                                 p_ti = params_ti(j)!!
                                 p_type = c_type_of_ti(p_vt, p_ti)
                                 p_name' = j < ?pnames'
                                    | pnames'(j)!!
                                    | ""
                                 p_name' == "" || p_name' == "_"
                                    | p_name' = "arg" + str::from_int(j)
                                 j > 0 | proto += ", "
                                 proto += p_type + " " + p_name'
                        proto += ");\n"
                        s_proto = +proto
                        hdr += s_proto
                        emitted_symbols += c_name
                     |
                        print $ "E5020: Exported symbol '" + dva_name +
                           "' is not a function."
                        has_error' = <+>

   hdr += ("\n#ifdef __cplusplus\n",
      "}\n",
      "#endif\n\n",
      "#endif // " + guard + "\n")

   has_error'
      | <->
      |
         ok = write_file(header_path, +hdr)
         !ok
            |
               print $ "E5021: Could not write header file '" +
                  header_path + "'"
               <->
            | <+>

is_wasm_triple: String => <>
is_wasm_triple = triple =>
   (?triple !< 6 && triple(..6) == "wasm32") ||
      (?triple !< 4 && triple(..4) == "wasm")

print_program_errors: unify::TypeErrors => ()
print_program_errors = errs =>
   ?errs @ i =>
      err_res = errs(i)
      err_res | err =>
         print $ unify::format_error(err)

sq: String => String
sq = s =>
   b = {?s + 8}
   b += 39
   ?s @ i =>
      c = s(i)
      c == 39
         | b += "'\\''"
         | b += c
   b += 39
   +b

append_pkg_config_words: String, ast::Names => ()
append_pkg_config_words = text, args =>
   w' = {64}
   ?text @ i =>
      c = text(i)
      c == ' ' || c == '\t' || c == '\n' || c == '\r'
         |
            ?w' > 0
               |
                  args += +w'
                  w' = {64}
         | w' += c
   ?w' > 0 | args += +w'

resolve_pkg_config: String, ast::Names => <>
resolve_pkg_config = name, clang_args =>
   tmp_file = "/tmp/edva_pkg_config_" + str::from_int(getpid!) + "_" + name + ".tmp"
   cmd = "pkg-config --libs " + sq(name) + " > " + sq(tmp_file) + " 2>/dev/null"
   st = libc::system(cmd)
   rc = st < 0 | -1 | (st .>. 8) .&. 255
   rc != 0
      |
         unlink(tmp_file)
         <->
      |
         content_opt = read_file_text(tmp_file)
         unlink(tmp_file)
         content_opt
            | content =>
               append_pkg_config_words(content, clang_args)
               <+>
            | <->

env_or: String, String => String
env_or = name, fallback =>
   getenv_opt(name)
      | v => v
      | fallback

copy_file: String, String => <>
copy_file = src, dst =>
   read_file_text(src)
      | txt => write_file(dst, txt)
      | <->

// Shared compile pipeline: codegen AST -> LLVM IR -> clang binary.
// Used by both the batch driver and the REPL.
compile_ast_to_binary: ast::Expr, ast::Names, CliOpts, String,
   String, ast::Names, ast::Names, ast::Names, ast::Names, ast::Names => < | Int >
compile_ast_to_binary = prog, exports, opts, out_ll, out_bin, dmods, dpaths, nlibs, npkg, lfiles =>
   nat_libs = nlibs
   nat_pkg = npkg
   output_ll = out_ll
   output_bin = out_bin
   dynamic_mods = dmods
   dynamic_paths = dpaths
   quiet = opts.repl_mode
   cg_err = opts.repl_mode | 6002 | 5011
   clang_err = opts.repl_mode | 6003 | 5013
   cg_opts = codegen::CodegenOpts((opts.triple, opts.no_runtime, opts.no_main,
      dynamic_mods, dynamic_paths, opts.is_shared, compiler_exe_path,
      opts.is_module, opts.module_name))
   annotate::set_source_file(opts.target)
   el_res = annotate::annotate_program(prog)
   cg_ok' = 0
   is_cached' = <->
   el_res
      | succ =>
         use_cache = !opts.no_cache && env_or("EDVA_NO_CACHE", "") != "1"
         eff_cache_dir = opts.cache_dir != "" | opts.cache_dir | pkg::default_cache!
         cache_flags = pkg::CacheCodegenFlags((opts.is_module, opts.is_shared,
            opts.no_runtime, opts.no_main))
         ast_summary = ""
         opt_str = opts.opt != "" | opts.opt | "-O2"
         target_triple = opts.triple != "" | opts.triple | get_default_target_triple(0)
         bkr = pkg::compute_ir_cache_key(opts.target, lfiles, nat_libs, nat_pkg,
            target_triple, opt_str, cache_flags, ast_summary)
         cached_hit = use_cache | pkg::cache_lookup(eff_cache_dir, bkr.key) | <-->
         cached_hit
            | cached_ll =>
               copy_file(cached_ll, output_ll)
                  |
                     cg_ok' = 1
                     is_cached' = <+>
                     !quiet | print $ "cached LLVM IR: " + output_ll
                  |
                     cg_ok' = codegen::codegen_typed_program_opts(succ.prog, prog,
                        output_ll, exports, opts.target, cg_opts)
                     cg_ok' != 0 && use_cache
                        | pkg::cache_store(eff_cache_dir, bkr.key, bkr.meta_text, output_ll)
            |
               cg_ok' = codegen::codegen_typed_program_opts(succ.prog, prog,
                  output_ll, exports, opts.target, cg_opts)
               cg_ok' != 0 && use_cache
                  | pkg::cache_store(eff_cache_dir, bkr.key, bkr.meta_text, output_ll)
      | errs =>
         print_program_errors(errs)
         cg_ok' = 0
   cg_ok' == 0
      |
         print $ "E" + str::from_int(cg_err) +
            ": Compilation aborted due to code generation errors."
         <- 1 ->
      |
         !quiet && !is_cached'
            |
               print $ "Successfully generated LLVM IR via LLVM C API: " +
                  output_ll
         opts.header_path != ""
            |
               hdr_ok = generate_c_header(prog, exports, opts.header_path)
               !hdr_ok | <- 1 ->
         opts.ir_only
            | <++>
            |
               target_triple = opts.triple != "" | opts.triple |
                  get_default_target_triple(0)
               is_wasm = is_wasm_triple(target_triple)
               is_wasm
                  |
                     output_o = output_ll + ".o"
                     clang_args = ast::Names()
                     clang_args += "clang"
                     clang_args += "-Qunused-arguments"
                     clang_args += "-Wno-unused-command-line-argument"
                     clang_args += "-w"
                     clang_args += (opts.opt != "" | opts.opt | "-O2")
                     clang_args += "--target=" + target_triple
                     clang_args += "-c"
                     clang_args += output_ll
                     clang_args += "-o"
                     clang_args += output_o
                     cres = run_cmd(clang_args)
                     cres != 0
                        |
                           print $ "E" + str::from_int(clang_err) +
                              ": Clang compilation failed with exit code " +
                              str::from_int(cres)
                           <- cres ->
                        |
                           ld_args = ast::Names()
                           ld_args += "wasm-ld"
                           ld_args += "--no-entry"
                           ld_args += "--export-all"
                           ld_args += output_o
                           ld_args += "-o"
                           ld_args += output_bin
                           lres = run_cmd(ld_args)
                           rm_args = ast::Names()
                           rm_args += "rm"
                           rm_args += "-f"
                           rm_args += output_o
                           run_cmd(rm_args)
                           lres != 0
                              |
                                 print $ "E" + str::from_int(clang_err) +
                                    ": wasm-ld linking failed with exit code " +
                                    str::from_int(lres)
                                 <- lres ->
                              |
                                 !quiet
                                    |
                                       print $ "Successfully compiled binary: " +
                                          output_bin
                                 <++>
                  |
                     clang_args = ast::Names()
                     clang_args += "clang"
                     clang_args += "-Qunused-arguments"
                     clang_args += "-Wno-unused-command-line-argument"
                     clang_args += "-w"
                     clang_args += (opts.opt != "" | opts.opt | "-O2")
                     clang_args += "--target=" + target_triple
                     opts.is_shared
                        |
                           clang_args += "-shared"
                           clang_args += "-fPIC"
                     pkg_err' = <->
                     opts.is_module
                        |
                           clang_args += "-c"
                           clang_args += output_ll
                           clang_args += "-o"
                           clang_args += output_bin
                        |
                           clang_args += output_ll
                           prog_exprs = prog [Block b] b.exprs | ast::Exprs()
                           link_libs = collect_link_libs(prog_exprs)
                           ?link_libs @ i =>
                              lib = (link_libs(i) | _ | "")
                              clang_args += "-l" + lib
                           ?nat_libs @ i =>
                              lib = (nat_libs(i) | _ | "")
                              clang_args += "-l" + lib
                           ?nat_pkg @ i =>
                              !pkg_err'
                                 |
                                    pname = (nat_pkg(i) | _ | "")
                                    ok = resolve_pkg_config(pname, clang_args)
                                    !ok
                                       |
                                          print $ "E5039: missing native requirement: pkg-config '" +
                                             pname + "' failed"
                                          pkg_err' = <+>
                           ?dynamic_mods > 0
                              |
                                 clang_args += "-Wl,--export-dynamic"
                                 clang_args += "-ldl"
                           clang_args += "-o"
                           clang_args += output_bin
                     pkg_err'
                        | <- 1 ->
                        |
                           cres = run_cmd(clang_args)
                           opts.is_module && !opts.ir_only
                              |
                                 rm_args = ast::Names()
                                 rm_args += "rm"
                                 rm_args += "-f"
                                 rm_args += output_ll
                                 run_cmd(rm_args)
                           cres != 0
                              |
                                 print $ "E" + str::from_int(clang_err) +
                                    ": Clang compilation failed with exit code " +
                                    str::from_int(cres)
                                 <- cres ->
                              |
                                 !quiet
                                    |
                                       mod_msg = "Successfully compiled module object: "
                                       bin_msg = "Successfully compiled binary: "
                                       msg = opts.is_module | mod_msg | bin_msg
                                       print $ msg + output_bin
                                 <++>

// --- REPL -------------------------------------------------------------------

// Read a single line from stdin (fd 0), up to max bytes.
// Returns < String | >: positive line on success, negative unit on EOF.
read_stdin_line: Int => < String | >
read_stdin_line = max =>
   ar = mem::arena(max + 128)
   buf = mem::alloc(ar, max + 1)
   n' = 0
   max @ i =>
      rb = libc::read(0, buf + i, 1)
      rb < 1
         | -->
         |
            n' = i + 1
            bval = Int(@[buf + i i8])
            bval == 10
               | -->
   n' == 0
      |
         mem::destroy(ar)
         <-->
      |
         len = (Int(@[buf + (n' - 1) i8]) == 10) | n' - 1 | n'
         out = {len}
         len @ j =>
            out += @[buf + j i8]
         mem::destroy(ar)
         <+ +out +>

write_bytes_loop: Int, String, Int, Int => <>
write_bytes_loop = fd, content, offset, remaining =>
   remaining !> 0
      | <+>
      |
         w = libc::write_ptr(fd, &content + offset, remaining)
         w < 0
            |
               errno_ptr = libc::__errno_location!
               errno = @[errno_ptr i32]
               errno == 4
                  | write_bytes_loop(fd, content, offset, remaining)
                  | <->
            | w == 0
               | <->
               | write_bytes_loop(fd, content, offset + w, remaining - w)

// Write content to a file (create/truncate, owner-only 0600 mode).
// Returns <+> on success.
write_file: String, String => <>
write_file = path, content =>
   fd = libc::creat(path, 384)
   fd < 0
      | <->
      |
         n = ?content
         ok = n == 0 | <+> | write_bytes_loop(fd, content, 0, n)
         libc::close(fd)
         ok

is_decl_stmt: ast::Expr => <>
is_decl_stmt = e =>
   e [Assign, TypeDecl, Foreign, Import]

exprs_have_decl: ast::Exprs => <>
exprs_have_decl = exprs =>
   found' = <->
   exprs @ e =>
      is_decl_stmt(e) | (found' = <+>; -->)
   found'

line_has_decl: String => <>
line_has_decl = line =>
   p = parser::parse_init(line)
   prog_res = parser::parse_program(p)
   prog_res
      | prog =>
         prog
            [Block b] exprs_have_decl(b.exprs)
            | is_decl_stmt(prog)
      | <->

is_writer_line: String => <>
is_writer_line = line =>
   line(..6) == "print " ||
      line(..7) == "print\t" ||
      line(..9) == "print_int" ||
      line(..7) == "io::out" ||
      line(..7) == "writeln" ||
      line(..11) == "libc::write" ||
      line(..10) == "libc::puts"

active_repl_src: String
active_repl_src = ""
active_repl_ll: String
active_repl_ll = ""
active_repl_bin: String
active_repl_bin = ""
active_repl_dir: String
active_repl_dir = ""
::orig_termios: <Addr|>
::orig_termios = <-->
::raw_mode_active: <>
::raw_mode_active = <->

enable_raw_mode: () => <>
enable_raw_mode = !=>
   libc::isatty(0) == 0
      | <->
      |
         buf = orig_termios
            | p => p
            |
               p = libc::malloc(128)
               orig_termios = <+ p +>
               p
         libc::tcgetattr(0, buf) != 0
            | <->
            |
               raw = libc::malloc(128)
               libc::memcpy(raw, buf, 128)
               libc::cfmakeraw(raw)
               res = libc::tcsetattr(0, 0, raw)
               libc::free(raw)
               res == 0
                  |
                     raw_mode_active = <+>
                     <+>
                  | <->

disable_raw_mode: () => ()
disable_raw_mode = !=>
   raw_mode_active
      |
         orig_termios | p => libc::tcsetattr(0, 0, p)
         raw_mode_active = <->

write_esc: String => ()
write_esc = seq =>
   b = {16}
   b += 27
   b += seq
   s = +b
   libc::write(1, s, ?s)

check_stdin_ready: Addr => <>
check_stdin_ready = pfd =>
   @[pfd + 6] = 0i16
   libc::poll(pfd, 1, 50) > 0

refresh_line: String, Int => ()
refresh_line = line, pos =>
   libc::write(1, "\r", 1)
   libc::write(1, "dva> ", 5)
   ?line > 0 | libc::write(1, line, ?line)
   write_esc("[K")
   pos < ?line
      |
         back = str::from_int(?line - pos)
         write_esc("[" + back + "D")

repl_history_get: ast::Names, Int, String => String
repl_history_get = hist, idx, uncommitted =>
   idx == ?hist | uncommitted | (hist(idx) | _ | "")

repl_history_append: ReplSession, String => ()
repl_history_append = sess, line =>
   ?line > 0
      |
         hist = sess.history
         nh = ?hist
         nh == 0 || (hist(nh - 1) | _ | "") != line
            | hist += line

read_line_raw: ReplSession => < String | >
read_line_raw = sess =>
   line' = ++""
   pos' = 0
   uncommitted' = ++""
   nh = ?sess.history
   hist_idx' = nh
   eof' = <->
   c_buf = libc::malloc(8)
   seq_buf = libc::malloc(8)
   pfd_buf = libc::malloc(8)
   @[pfd_buf] = 0i32
   @[pfd_buf + 4] = 1i16
   @[pfd_buf + 6] = 0i16
   refresh_line(line', pos')
   0.. @ _ =>
      rb = libc::read(0, c_buf, 1)
      rb < 1
         |
            eof' = <+>
            -->
         |
            b0 = Int(@[c_buf i8])
            b0 == 10 || b0 == 13
               |
                  libc::write(1, "\r\n", 2)
                  -->
            b0 == 4
               |
                  ?line' == 0
                     |
                        libc::write(1, "\r\n", 2)
                        eof' = <+>
                        -->
                     |
                        pos' < ?line'
                           |
                              line' = line'(0..pos') + line'((pos' + 1)..)
                              refresh_line(line', pos')
            b0 == 3
               |
                  libc::write(1, "^C\r\n", 4)
                  line' = ++""
                  pos' = 0
                  uncommitted' = ++""
                  hist_idx' = ?sess.history
                  refresh_line(line', pos')
            b0 == 127 || b0 == 8
               |
                  pos' > 0
                     |
                        line' = line'(0..(pos' - 1)) + line'(pos'..)
                        pos' = pos' - 1
                        refresh_line(line', pos')
            b0 == 1
               |
                  pos' = 0
                  refresh_line(line', pos')
            b0 == 5
               |
                  pos' = ?line'
                  refresh_line(line', pos')
            b0 == 2
               |
                  pos' > 0 | pos' = pos' - 1
                  refresh_line(line', pos')
            b0 == 6
               |
                  pos' < ?line' | pos' = pos' + 1
                  refresh_line(line', pos')
            b0 == 21
               |
                  line' = ++""
                  pos' = 0
                  refresh_line(line', pos')
            b0 == 11
               |
                  line' = line'(0..pos')
                  refresh_line(line', pos')
            b0 == 12
               |
                  write_esc("[H")
                  write_esc("[2J")
                  refresh_line(line', pos')
            b0 == 16
               |
                  cur_nh = ?sess.history
                  cur_nh > 0 && hist_idx' > 0
                     |
                        hist_idx' == cur_nh | uncommitted' = ++line'
                        hist_idx' = hist_idx' - 1
                        line' = ++repl_history_get(sess.history, hist_idx',
                           uncommitted')
                        pos' = ?line'
                        refresh_line(line', pos')
            b0 == 14
               |
                  cur_nh = ?sess.history
                  hist_idx' < cur_nh
                     |
                        hist_idx' = hist_idx' + 1
                        line' = ++repl_history_get(sess.history, hist_idx',
                           uncommitted')
                        pos' = ?line'
                        refresh_line(line', pos')
            b0 == 27
               |
                  check_stdin_ready(pfd_buf)
                     |
                        libc::read(0, seq_buf, 1)
                        b1 = Int(@[seq_buf i8])
                        b1 == 91
                           |
                              check_stdin_ready(pfd_buf)
                                 |
                                    libc::read(0, seq_buf, 1)
                                    b2 = Int(@[seq_buf i8])
                                    b2 == 65
                                       |
                                          cur_nh = ?sess.history
                                          cur_nh > 0 && hist_idx' > 0
                                             |
                                                hist_idx' == cur_nh |
                                                   uncommitted' = ++line'
                                                hist_idx' = hist_idx' - 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 66
                                       |
                                          cur_nh = ?sess.history
                                          hist_idx' < cur_nh
                                             |
                                                hist_idx' = hist_idx' + 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 67
                                       |
                                          pos' < ?line' | pos' = pos' + 1
                                          refresh_line(line', pos')
                                    b2 == 68
                                       |
                                          pos' > 0 | pos' = pos' - 1
                                          refresh_line(line', pos')
                                    b2 == 72
                                       |
                                          pos' = 0
                                          refresh_line(line', pos')
                                    b2 == 70
                                       |
                                          pos' = ?line'
                                          refresh_line(line', pos')
                                    b2 == 51
                                       |
                                          check_stdin_ready(pfd_buf) |
                                             libc::read(0, seq_buf, 1)
                                          pos' < ?line'
                                             |
                                                line' = line'(0..pos') +
                                                   line'((pos' + 1)..)
                                                refresh_line(line', pos')
                                    b2 == 49 || b2 == 55
                                       |
                                          check_stdin_ready(pfd_buf) |
                                             libc::read(0, seq_buf, 1)
                                          pos' = 0
                                          refresh_line(line', pos')
                                    b2 == 52 || b2 == 56
                                       |
                                          check_stdin_ready(pfd_buf) |
                                             libc::read(0, seq_buf, 1)
                                          pos' = ?line'
                                          refresh_line(line', pos')
                        b1 == 79
                           |
                              check_stdin_ready(pfd_buf)
                                 |
                                    libc::read(0, seq_buf, 1)
                                    b2 = Int(@[seq_buf i8])
                                    b2 == 65
                                       |
                                          cur_nh = ?sess.history
                                          cur_nh > 0 && hist_idx' > 0
                                             |
                                                hist_idx' == cur_nh |
                                                   uncommitted' = ++line'
                                                hist_idx' = hist_idx' - 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 66
                                       |
                                          cur_nh = ?sess.history
                                          hist_idx' < cur_nh
                                             |
                                                hist_idx' = hist_idx' + 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 67
                                       |
                                          pos' < ?line' | pos' = pos' + 1
                                          refresh_line(line', pos')
                                    b2 == 68
                                       |
                                          pos' > 0 | pos' = pos' - 1
                                          refresh_line(line', pos')
                                    b2 == 72
                                       |
                                          pos' = 0
                                          refresh_line(line', pos')
                                    b2 == 70
                                       |
                                          pos' = ?line'
                                          refresh_line(line', pos')
            b0 == 9
               |
                  line' = line'(0..pos') + "   " + line'(pos'..)
                  pos' = pos' + 3
                  refresh_line(line', pos')
            b0 !< 32 && b0 != 127
               |
                  ch = str::from_byte(b0)
                  line' = line'(0..pos') + ch + line'(pos'..)
                  pos' = pos' + 1
                  refresh_line(line', pos')
   libc::free(c_buf)
   libc::free(seq_buf)
   libc::free(pfd_buf)
   disable_raw_mode!
   eof' | <--> | <+ line' +>

readline_interactive: ReplSession => < String | >
readline_interactive = sess =>
   libc::isatty(0) == 0
      |
         libc::write(1, "dva> ", 5)
         read_stdin_line(4096)
      |
         enable_raw_mode!
            | read_line_raw(sess)
            |
               libc::write(1, "dva> ", 5)
               read_stdin_line(4096)

make_scratch_dir_loop: Int, Int => String
make_scratch_dir_loop = pid, seq =>
   seq > 100
      | ""
      |
         p_s = str::from_int(pid)
         cand = "/tmp/edva_repl_" + p_s + "_" + str::from_int(seq)
         res = mkdir(cand, 448)
         res == 0
            | cand
            | make_scratch_dir_loop(pid, seq + 1)

make_scratch_dir: () => String
make_scratch_dir = !=>
   pid = getpid!
   make_scratch_dir_loop(pid, 0)

repl_cleanup: ReplSession => ()
repl_cleanup = sess =>
   disable_raw_mode!
   ?sess.src_path > 0 | unlink(sess.src_path)
   ?sess.ll_path > 0 | unlink(sess.ll_path)
   ?sess.bin_path > 0 | unlink(sess.bin_path)
   ?sess.dir > 0 | rmdir(sess.dir)
   orig_termios | p => libc::free(p)
   orig_termios = <-->
   active_repl_src ::= ""
   active_repl_ll ::= ""
   active_repl_bin ::= ""
   active_repl_dir ::= ""

repl_step: CliOpts, String, String, ReplSession => String
repl_step = opts, session_src, line, sess =>
   disable_raw_mode!
   is_decl = line_has_decl(line)
   candidate = is_decl || is_writer_line(line) | line |
      "io::out(" + line + ")"
   full_src = session_src == "" | candidate |
      session_src + "\n" + candidate
   temp_src = sess.src_path
   !write_file(temp_src, full_src)
      |
         print $ "E6001: Could not write scratch source file"
         session_src
      |
         load_res = load_all(temp_src, "", <->, opts.import_map)
         !load_res.ok || ?load_res.exprs == 0
            | session_src
            |
               prog = ast::Expr(Block, ast::BlockExpr(load_res.exprs))
               comp = compile_ast_to_binary(prog, load_res.exports,
                  opts, sess.ll_path, sess.bin_path,
                  load_res.dynamic_mods, load_res.dynamic_paths,
                  load_res.native_libs, load_res.native_pkg_config,
                  load_res.loaded_files)
               comp
                  |
                     run_args = ast::Names()
                     run_args += sess.bin_path
                     rres = run_cmd(run_args)
                     rres != 0
                        |
                           print $ "E6004: Program exited with code " +
                              str::from_int(rres)
                           session_src
                        |
                           is_decl
                              |
                                 session_src == "" | line |
                                    session_src + "\n" + line
                              | session_src
                  | session_src

repl_loop: CliOpts, String, ReplSession => ()
repl_loop = opts, session_src, sess =>
   readline_interactive(sess)
      | line =>
         ?line == 0
            | repl_loop(opts, session_src, sess)
            |
               !(line == ":q" || line == ":quit" || line == "exit")
                  |
                     repl_history_append(sess, line)
                     next_src = repl_step(opts, session_src, line, sess)
                     repl_loop(opts, next_src, sess)
      |
         print $ ""
         print $ "Goodbye!"

on_sigint: Int => Int
on_sigint = _ =>
   disable_raw_mode!
   ?active_repl_src > 0 | unlink(active_repl_src)
   ?active_repl_ll > 0 | unlink(active_repl_ll)
   ?active_repl_bin > 0 | unlink(active_repl_bin)
   ?active_repl_dir > 0 | rmdir(active_repl_dir)
   libc::write(1, "\nGoodbye!\n", 10)
   libc::exit(0)
   0

repl_run: CliOpts => ()
repl_run = opts =>
   print $ "========================================="
   print $ "           DVA INTERACTIVE REPL          "
   print $ "========================================="
   print $ "Type expressions or statements. Press Ctrl-D to quit."
   print $ ""
   init_compiler_paths!
   scratch_dir = make_scratch_dir!
   ?scratch_dir == 0
      |
         print $ "E6005: Could not create scratch directory for REPL"
      |
         session_src = path_join(scratch_dir, "session.dva")
         session_ll = path_join(scratch_dir, "session.ll")
         session_bin = path_join(scratch_dir, "session")
         active_repl_src ::= session_src
         active_repl_ll ::= session_ll
         active_repl_bin ::= session_bin
         active_repl_dir ::= scratch_dir
         signal(2, @[Addr(on_sigint) Addr])
         sess = ReplSession((scratch_dir, session_src, session_ll,
            session_bin, ast::Names()))
         repl_opts = opts
         repl_opts.repl_mode = <+>
         repl_loop(repl_opts, "", sess)
         repl_cleanup(sess)

format_version: () => String
format_version = !=>
   version::COMMIT_HASH == "" || version::COMMIT_HASH == "unknown"
      | "edva " + version::VERSION
      | "edva " + version::VERSION + " (commit " + version::COMMIT_HASH + ")"

parse_args_step: Int, CliOpts => CliOpts
parse_args_step = i, opts =>
   i !< sys::argc
      | opts
      |
         arg = sys::argv_string(i)
         arg
            ["-v", "--version"]
               print $ format_version!
               sys::exit(0)
               opts
            ["-h", "--help"]
               opts.help = <+>
               parse_args_step(i + 1, opts)
            ["-r", "--run"]
               opts.run_exec = <+>
               parse_args_step(i + 1, opts)
            ["-ir", "--ir-only"]
               opts.ir_only = <+>
               parse_args_step(i + 1, opts)
            ["-no-runtime", "--no-runtime"]
               opts.no_runtime = <+>
               parse_args_step(i + 1, opts)
            ["-no-main", "--no-main"]
               opts.no_main = <+>
               parse_args_step(i + 1, opts)
            ["-shared", "--shared"]
               opts.is_shared = <+>
               opts.no_main = <+>
               parse_args_step(i + 1, opts)
            ["-repl", "--repl"]
               opts.repl_mode = <+>
               parse_args_step(i + 1, opts)
            ["-ast", "--ast", "--dump-ast"]
               opts.ast_dump = <+>
               parse_args_step(i + 1, opts)
            ["-ast-tree", "--ast-tree"]
               opts.ast_dump = <+>
               opts.ast_tree = <+>
               parse_args_step(i + 1, opts)
            ["-typed-ast", "--typed-ast", "-check-types", "--check-types"]
               opts.typed_ast = <+>
               parse_args_step(i + 1, opts)
            ["-typed-codegen", "--typed-codegen"]
               parse_args_step(i + 1, opts)
            ["-legacy-codegen", "--legacy-codegen"]
               print $ "E5008: Legacy untyped codegen has been retired; " +
                  "typed codegen is the standard pipeline."
               sys::exit(1)
               opts
            ["-typed-ast-tree", "--typed-ast-tree"]
               opts.typed_ast = <+>
               opts.ast_dump = <+>
               opts.ast_tree = <+>
               parse_args_step(i + 1, opts)
            ["-e", "--eval"]
               parse_eval_arg(i, opts)
            ["-O0", "-O1", "-O2", "-O3", "-Os", "-Oz"]
               opts.opt = arg
               parse_args_step(i + 1, opts)
            ["-O"]
               opts.opt = "-O2"
               parse_args_step(i + 1, opts)
            ["-target", "--target"]
               parse_target_arg(i, opts)
            ["-c", "--compile-only"]
               opts.is_module = <+>
               opts.no_main = <+>
               parse_args_step(i + 1, opts)
            ["--entry", "-entry"]
               opts.no_main = <->
               opts.module_name = ""
               parse_args_step(i + 1, opts)
            ["--module"]
               parse_module_arg(i, opts)
            ["--import-map"]
               parse_import_map_arg(i, opts)
            ["-H", "--header"]
               parse_header_arg(i, opts)
            ["--cache"]
               parse_cache_arg(i, opts)
            ["--no-cache"]
               opts.no_cache = <+>
               parse_args_step(i + 1, opts)
            ["-o", "--output"]
               parse_output_arg(i, opts)
            |
               parse_pos_arg(i, arg, opts)

parse_cache_arg: Int, CliOpts => CliOpts
parse_cache_arg = i, opts =>
   i + 1 !< sys::argc
      |
         print $ "E5016: '--cache' requires a directory path"
         sys::exit(1)
         opts
      |
         opts.cache_dir = sys::argv_string(i + 1)
         parse_args_step(i + 2, opts)

parse_module_arg: Int, CliOpts => CliOpts
parse_module_arg = i, opts =>
   i + 1 !< sys::argc
      |
         print $ "E5016: '--module' requires a module name argument"
         sys::exit(1)
         opts
      |
         mv = sys::argv_string(i + 1)
         ?mv > 0 && mv(0) == '-'
            |
               print $ "E5016: Module name must not begin with '-'; got '" +
                  mv + "'"
               sys::exit(1)
         opts.module_name = mv
         opts.is_module = <+>
         opts.no_main = <+>
         parse_args_step(i + 2, opts)

parse_eval_arg: Int, CliOpts => CliOpts
parse_eval_arg = i, opts =>
   i + 1 !< sys::argc
      |
         print $ "E5019: '-e' requires a code string argument"
         opts.help = <+>
         opts
      |
         opts.eval_src = sys::argv_string(i + 1)
         parse_args_step(i + 2, opts)

parse_target_arg: Int, CliOpts => CliOpts
parse_target_arg = i, opts =>
   i + 1 !< sys::argc
      |
         print $ "E5015: '-target' requires a target triple argument"
         opts.help = <+>
         opts
      |
         tv = sys::argv_string(i + 1)
         ?tv > 0 && tv(0) == '-'
            |
               print $ "E5017: Target triple must" +
                  " not begin with '-'; got '" +
                  tv + "'"
               sys::exit(1)
         opts.triple = tv
         parse_args_step(i + 2, opts)

parse_header_arg: Int, CliOpts => CliOpts
parse_header_arg = i, opts =>
   i + 1 !< sys::argc
      |
         print $ "E5018: '-H' requires a header file path argument"
         sys::exit(1)
         opts
      |
         hv = sys::argv_string(i + 1)
         ?hv > 0 && hv(0) == '-'
            |
               print $ "E5018: Header path must not begin with '-'; got '" +
                  hv + "'"
               sys::exit(1)
         opts.header_path = hv
         parse_args_step(i + 2, opts)

parse_output_arg: Int, CliOpts => CliOpts
parse_output_arg = i, opts =>
   i + 1 !< sys::argc
      |
         print $ "E5016: '-o' requires an output path argument"
         sys::exit(1)
         opts
      |
         ov = sys::argv_string(i + 1)
         ?ov > 0 && ov(0) == '-'
            |
               print $ "E5016: Output path must not begin with '-'; got '" +
                  ov + "'"
               sys::exit(1)
         opts.outpath = ov
         parse_args_step(i + 2, opts)

parse_import_map_arg: Int, CliOpts => CliOpts
parse_import_map_arg = i, opts =>
   i + 1 !< sys::argc
      |
         print $ "E5030: '--import-map' requires a file path argument"
         sys::exit(1)
         opts
      |
         mv = sys::argv_string(i + 1)
         ?mv > 0 && mv(0) == '-'
            |
               print $ "E5030: Import map path must not begin with '-'; got '" +
                  mv + "'"
               sys::exit(1)
         opts.import_map = mv
         parse_args_step(i + 2, opts)

parse_pos_arg: Int, String, CliOpts => CliOpts
parse_pos_arg = i, arg, opts =>
   ?arg > 0 && arg(0) == '-'
      |
         print $ "E5008: Unknown option '" +
            arg + "'"
         opts.help = <+>
         opts
      |
         opts.target == ""
            |
               opts.target = arg
               parse_args_step(i + 1, opts)
            |
               opts.outpath == ""
                  |
                     opts.outpath = arg
                     parse_args_step(i + 1, opts)
                  |
                     print $ "E5008: Extra argument '" +
                        arg + "'"
                     opts.help = <+>
                     opts

print_usage: Int => ()
print_usage = _ =>
   print $ "Usage: edva <input.dva | module_dir> [options]"
   print $ "       edva <init|add|fetch|build|test|update|graph|vendor> [dir] [options]"
   print $ "       edva pkg <command> [dir] [options]"
   print $ "Options:"
   print $ "  -v, --version    Print compiler version and exit"
   print $ "  -ast, --ast      Print AST of target program"
   print $ "  -ast-tree        Print AST as an indented tree"
   print $ "  -typed-ast       Elaborate and verify typed AST"
   print $ "  -typed-ast-tree  Elaborate, verify, and dump typed AST tree"
   print $ "  -e <code>        Evaluate/parse inline code string"
   print $ "  -r, --run        Run binary immediately after linking"
   print $ "  -ir, --ir-only   Emit LLVM IR (.ll) only; do not invoke clang"
   print $ "  -o <path>        Output binary path"
   print $ "  -target <triple> Target triple (e.g. x86_64-unknown-linux-gnu)"
   print $ "  -no-main         Emit main with internal linkage"
   print $ "  -shared          Build a shared library (.so)"
   print $ "  -repl, --repl    Interactive REPL (reads from stdin)"
   print $ "  -H, --header <h> Generate C header from #export declarations"
   print $ "  -h, --help       Show this help message"

verify_typed_ast: ast::Expr, <>, <> => ()
verify_typed_ast = prog, dump_ast, as_tree =>
   el_res = annotate::annotate_program(prog)
   el_res
      | succ =>
         dump_ast | show::dump_typed_program(succ.ctx, succ.prog, as_tree)
         annotate::print_elab_stats(succ.stats)
         sys::exit(0)
      | errs =>
         print_program_errors(errs)
         sys::exit(1)

dump_program_ast: ast::Expr, <> => ()
dump_program_ast = prog, as_tree =>
   prog
      [Block b]
         ?b.exprs @ i =>
            st = (b.exprs(i) | _ | ast::Expr(Var, "?"))
            as_tree
               | print $ show::show_tree(st, 0)
               | print $ show::show_expr(st)
      |
         as_tree
            | print $ show::show_tree(prog, 0)
            | print $ show::show_expr(prog)

is_pkg_subcmd: String => <>
is_pkg_subcmd = cmd =>
   cmd ["init", "add", "fetch", "build", "test", "update", "graph", "tree", "vendor", "version"]

run_driver: Int => ()
run_driver = _ =>
   sys::argc > 1 && sys::argv_string(1) == "pkg"
      |
         rc = pkg::main(2)
         sys::exit(rc)
   sys::argc > 1 && is_pkg_subcmd(sys::argv_string(1))
      |
         rc = pkg::main(1)
         sys::exit(rc)
   init_compiler_paths!
   ast::cell_var_reset!
   opts = parse_args_step(1, init_opts(0))
   opts.help
      |
         print_usage(0)
         sys::exit(0)

   opts.repl_mode
      |
         repl_run(opts)
         sys::exit(0)

   opts.eval_src != ""
      |
         src = opts.eval_src + "\n"
         ppr = parser::parse_init(src)
         parser::parser_set_file(ppr, "<eval>")
         lexer::lex_set_file("<eval>")
         annotate::set_source_file("<eval>")
         prog_res = parser::parse_program(ppr)
         prog_res | prog =>
            opts.typed_ast
               |
                  verify_typed_ast(prog, opts.ast_dump || opts.ast_tree,
                     opts.ast_tree)
               |
                  dump_program_ast(prog, opts.ast_tree)
                  sys::exit(0)
         |
            sys::exit(1)

   opts.ast_dump && !opts.typed_ast
      |
         opts.target == ""
            |
               print $ "E5007: No input .dva file specified."
               print_usage(0)
               sys::exit(1)
         target_prefix_dump = opts.is_module | opts.module_name | ""
         dump_load = load_all(opts.target, target_prefix_dump, opts.is_module,
            opts.import_map)
         !dump_load.ok
            | sys::exit(1)
            |
               dump_prog = ast::Expr(Block, ast::BlockExpr(dump_load.exprs))
               dump_program_ast(dump_prog, opts.ast_tree)
               sys::exit(0)

   opts.target == ""
      |
         print $ "E5007: No input .dva file specified."
         print_usage(0)
         sys::exit(1)

   is_dir = dir_exists(opts.target)
   !is_dir && !file_exists(opts.target)
      |
         print $ "E5009: Path '" + opts.target + "' does not exist"
         sys::exit(1)

   !is_dir && !is_dva_file(opts.target)
      |
         print $ "E5010: Input file must have a '.dva' extension, got '" +
            opts.target + "'"
         sys::exit(1)

   raw_base = derive_base_name(opts.target)
   base_name = is_dir && (raw_base == "src" || raw_base == ".")
      |
         clean_tgt = strip_trailing_slash(opts.target)
         cand_path = raw_base == "." | clean_tgt | path_join(clean_tgt, "..")
         proj_name = basename(canonical_path(cand_path))
         proj_name != "" && proj_name != "/" | proj_name | raw_base
      | raw_base

   ?base_name > 0 && base_name(0) == '-'
      |
         print $ "E5018: Output name '" + base_name +
            "' begins with '-'; rename the input."
         sys::exit(1)
   opts.is_module && opts.no_main && opts.module_name == "" | opts.module_name = base_name
   target_triple = opts.triple != "" | opts.triple |
      get_default_target_triple(0)
   is_wasm = is_wasm_triple(target_triple)
   bin_suffix = is_wasm | ".wasm" | (opts.is_shared | ".so" | (opts.is_module | ".o" | ""))
   output_bin = opts.outpath != "" | opts.outpath | base_name + bin_suffix
   !opts.ir_only && dir_exists(output_bin)
      |
         print $ "E5022: Output name '" + output_bin +
            "' collides with an existing directory; pass -o <name> to set output name."
         sys::exit(1)
   ll_stem = opts.outpath != "" | (opts.is_module | base_name | opts.outpath) | base_name
   output_ll = ll_stem + ".ll"
   ir_only = opts.ir_only
   is_freestanding = (?opts.triple !< 14 &&
      opts.triple(..14) == "wasm32-unknown")
   is_freestanding && !opts.no_runtime | opts.no_runtime = <+>
   target_prefix = opts.is_module && opts.no_main | opts.module_name | ""
   load_result = load_all(opts.target, target_prefix, opts.is_module, opts.import_map)
   !load_result.ok
      | sys::exit(1)
      |
         annotate::set_source_file(opts.target)
         annotate::set_program_locs(load_result.out_files,
            load_result.out_lines, load_result.out_cols)
         program = ast::Expr(Block, ast::BlockExpr(load_result.exprs))
         should_verify_only = opts.typed_ast &&
            !opts.run_exec && !opts.ir_only && (opts.outpath == "")
         should_verify_only
            |
               verify_typed_ast(program, opts.ast_dump || opts.ast_tree,
                  opts.ast_tree)
            |
               res = compile_ast_to_binary(program, load_result.exports, opts,
                  output_ll, output_bin, load_result.dynamic_mods,
                  load_result.dynamic_paths, load_result.native_libs,
                  load_result.native_pkg_config, load_result.loaded_files)
               res !| code => sys::exit(code)

   opts.run_exec
      |
         print $ "--- Running Executable ---"
         exec_bin = (?output_bin > 0 && output_bin(0) == '/') ||
            output_bin(..2) == "./"
            | output_bin
            | "./" + output_bin
         is_wasm_exec = is_wasm_triple(target_triple) ||
            (?output_bin !< 5 && output_bin(?output_bin - 5..) == ".wasm")
         run_args = ast::Names()
         is_wasm_exec
            |
               run_args += "node"
               run_args += "--disable-wasm-trap-handler"
               run_args += "-e"
               run_args += "const fs=require('fs')," +
                  "b=fs.readFileSync(process.argv[1]);" +
                  "WebAssembly.instantiate(b).then(m=>{" +
                  "const e=m.instance.exports;" +
                  "if(e._start)e._start();" +
                  "else if(e.main)process.exit(e.main());});"
               run_args += output_bin
            |
               run_args += exec_bin
         rres = run_cmd(run_args)
         rres != 0
            |
               print $ "E5014: Compiled program exited with code " +
                  str::from_int(rres)
               sys::exit(1)

run_driver(0)

