// src/fmt.dva — Canonical Edva source code formatter (`edva fmt`).
//
// Enforces 3-space indentation, strips trailing whitespace, normalizes
// delimiter spacing and blank lines while preserving comments, multiline
// strings/heredocs, and vertical alignment, and verifies AST equivalence
// via `parser::parse_program` + `show::show_expr`.

#use ./lexer
#use ./parser
#use ./ast
#use ./show
#use ./diag
#use str
#use path
#use log
#use fs
#use libc
#use sys

#public

// Multiline scanner state across line boundaries.
// 0 = Normal code line
// 1 = Inside /* ... */ block comment
// 2 = Inside single-quote-delimited multiline string ("...\n...")
// 3 = Inside triple-quote-delimited multiline string ("""...\n...""")

#type LineInfo (
   raw: String,
   start_state: Int,
   end_state: Int,
   raw_indent: Int,
   has_tabs: <>,
   is_blank: <>,
   is_comment_only: <>
)
#type LineInfos LineInfo{}

is_space_or_tab: Int => <>
is_space_or_tab = ['\s, '\t]

is_id_byte: Int => <>
is_id_byte = ['a...'z, 'A...'Z, '0...'9, '_]

// Advance multiline state across one line's content.
scan_line_state: String, Int => Int
scan_line_state = line, init_state =>
   n = ?line
   st' = init_state
   i' = 0
   in_str' = <->
   str_triple' = <->
   0.. @
      i' !< n | -->
      c = line(i')
      c1 = i' + 1 < n | line(i' + 1) | 0
      c2 = i' + 2 < n | line(i' + 2) | 0
      st'
         [1]
            c == '* && c1 == '/
               |
                  st' = 0
                  i' = i' + 2
               | i' = i' + 1
         [2]
            c == '\\
               | i' = i' + 2
               |
                  c == '"
                     |
                        st' = 0
                        i' = i' + 1
                     | i' = i' + 1
         [3]
            c == '\\
               | i' = i' + 2
               |
                  c == '" && c1 == '" && c2 == '"
                     |
                        st' = 0
                        i' = i' + 3
                     | i' = i' + 1
         |
            in_str'
               |
                  c == '\\
                     | i' = i' + 2
                     |
                        str_triple'
                           |
                              c == '" && c1 == '" && c2 == '"
                                 |
                                    in_str' = <->
                                    str_triple' = <->
                                    i' = i' + 3
                                 | i' = i' + 1
                           |
                              c == '"
                                 |
                                    in_str' = <->
                                    i' = i' + 1
                                 | i' = i' + 1
               |
                  c == '/ && c1 == '/
                     | i' = n
                     |
                        c == '/ && c1 == '*
                           |
                              st' = 1
                              i' = i' + 2
                           |
                              c == ''
                                 |
                                    prev_b = i' > 0 | line(i' - 1) | 0
                                    step = is_id_byte(prev_b)
                                       | 1
                                       | c1 == '\\ && i' + 2 < n
                                          | 3
                                          | i' + 1 < n | 2 | 1
                                    i' = i' + step
                                 |
                                    c == '"
                                       |
                                          c1 == '" && c2 == '"
                                             |
                                                i' + 3 == n
                                                   |
                                                      st' = 3
                                                      i' = n
                                                   |
                                                      in_str' = <+>
                                                      str_triple' = <+>
                                                      i' = i' + 3
                                             |
                                                i' + 1 == n
                                                   |
                                                      st' = 2
                                                      i' = n
                                                   |
                                                      in_str' = <+>
                                                      str_triple' = <->
                                                      i' = i' + 1
                                       | i' = i' + 1
   in_str'
      | (str_triple' | 3 | 2)
      | st'

strip_cr_and_trailing_ws: String => String
strip_cr_and_trailing_ws = s =>
   end' = ?s
   0.. @
      end' !> 0 | -->
      c = s(end' - 1)
      c ['\s, '\t, '\r]
         | end' = end' - 1
         | -->
   s(0..end')

strip_cr_only: String => String
strip_cr_only = s =>
   ?s > 0 && s(?s - 1) == '\r
      | s(0..?s - 1)
      | s

split_source_lines: String => LineInfos
split_source_lines = src =>
   res = LineInfos()
   n = ?src
   pos' = 0
   st' = 0
   0.. @
      pos' !< n | -->
      line_start = pos'
      0.. @
         pos' !< n || src(pos') == '\n | -->
         pos' = pos' + 1
      raw_slice = src(line_start..pos')
      pos' < n && src(pos') == '\n | pos' = pos' + 1
      cleaned = st' == 0 | strip_cr_and_trailing_ws(raw_slice) | strip_cr_only(raw_slice)
      sp' = 0
      tabs' = 0
      idx' = 0
      0.. @
         idx' !< ?cleaned | -->
         c = cleaned(idx')
         c == '\s
            |
               sp' = sp' + 1
               idx' = idx' + 1
            |
               c == '\t
                  |
                     tabs' = tabs' + 1
                     idx' = idx' + 1
                  | -->
      eff_indent = sp' + tabs' * 3
      is_blank = st' == 0 && idx' == ?cleaned
      is_comm = st' == 0 && !is_blank && idx' + 1 < ?cleaned &&
        cleaned(idx') == '/ && (cleaned(idx' + 1) == '/ || cleaned(idx' + 1) == '*)
      next_st = scan_line_state(cleaned, st')
      res += LineInfo(cleaned, st', next_st, eff_indent, tabs' > 0, is_blank, is_comm)
      st' = next_st
   res

// Format intra-line comma/semicolon spacing outside strings, runes, and comments.
format_code_body: String => String
format_code_body = body =>
   n = ?body
   b = {n + 16}
   i' = 0
   in_str' = <->
   str_triple' = <->
   in_blk_comm' = <->
   0.. @
      i' !< n | -->
      c = body(i')
      c1 = i' + 1 < n | body(i' + 1) | 0
      c2 = i' + 2 < n | body(i' + 2) | 0
      in_blk_comm'
         |
            b += c
            c == '* && c1 == '/
               |
                  b += c1
                  in_blk_comm' = <->
                  i' = i' + 2
               | i' = i' + 1
         |
            in_str'
               |
                  b += c
                  c == '\\ && i' + 1 < n
                     |
                        b += c1
                        i' = i' + 2
                     |
                        str_triple'
                           |
                              c == '" && c1 == '" && c2 == '"
                                 |
                                    b += c1
                                    b += c2
                                    in_str' = <->
                                    str_triple' = <->
                                    i' = i' + 3
                                 | i' = i' + 1
                           |
                              c == '" | in_str' = <->
                              i' = i' + 1
               |
                  c == '/ && c1 == '/
                     |
                        b += body(i'..n)
                        i' = n
                     |
                        c == '/ && c1 == '*
                           |
                              b += "/*"
                              in_blk_comm' = <+>
                              i' = i' + 2
                           |
                              c == ''
                                 |
                                    prev_b = i' > 0 | body(i' - 1) | 0
                                    b += c
                                    is_id_byte(prev_b)
                                       | i' = i' + 1
                                       |
                                          c1 == '\\ && i' + 2 < n
                                             |
                                                b += c1
                                                b += c2
                                                i' = i' + 3
                                             |
                                                i' + 1 < n
                                                   |
                                                      b += c1
                                                      i' = i' + 2
                                                   | i' = i' + 1
                                 |
                                    c == '"
                                       |
                                          c1 == '" && c2 == '"
                                             |
                                                b += "\"\"\""
                                                in_str' = <+>
                                                str_triple' = <+>
                                                i' = i' + 3
                                             |
                                                b += c
                                                in_str' = <+>
                                                str_triple' = <->
                                                i' = i' + 1
                                       |
                                          c [',, ';]
                                             |
                                                b += c
                                                need_sp = i' + 1 < n &&
                                                  !(c1 ['\s, '\t, '), '], '}, ',, ';])
                                                need_sp | b += '\s
                                                i' = i' + 1
                                             |
                                                prev_c = i' > 0 | body(i' - 1) | 0
                                                is_annot_colon = c == ': &&
                                                  !(prev_c [':, '-, '\s, '\t]) &&
                                                  !(c1 [':, '=, '\s, '\t, '), '], '}, ',, ';])
                                                is_annot_colon
                                                   |
                                                      b += ": "
                                                      i' = i' + 1
                                                   |
                                                      b += c
                                                      i' = i' + 1
   +b

make_spaces: Int => String
make_spaces = count =>
   count !> 0 | --| ""
   b = {count}
   count @
      b += '\s
   +b

strip_leading_ws: String => String
strip_leading_ws = s =>
   i' = 0
   n = ?s
   0.. @
      i' !< n | -->
      s(i') ['\s, '\t]
         | i' = i' + 1
         | -->
   s(i'..n)

// Strip trailing // comment (outside string/rune literals) and trailing horizontal whitespace.
strip_code_comment: String => String
strip_code_comment = body =>
   n = ?body
   i' = 0
   in_str' = <->
   end_idx' = n
   0.. @
      i' !< n | -->
      c = body(i')
      c1 = i' + 1 < n | body(i' + 1) | 0
      in_str'
         |
            c == '\\ && i' + 1 < n
               | i' = i' + 2
               |
                  c == '" | in_str' = <->
                  i' = i' + 1
         |
            c == '/ && c1 == '/
               |
                  end_idx' = i'
                  -->
               |
                  c == ''
                     |
                        prev_b = i' > 0 | body(i' - 1) | 0
                        step = is_id_byte(prev_b)
                           | 1
                           | c1 == '\\ && i' + 2 < n
                              | 3
                              | i' + 1 < n | 2 | 1
                        i' = i' + step
                     |
                        c == '"
                           |
                              in_str' = <+>
                              i' = i' + 1
                           | i' = i' + 1
   0.. @
      end_idx' > 0 && (body(end_idx' - 1) ['\s, '\t])
         | end_idx' = end_idx' - 1
         | -->
   body(0..end_idx')

ends_with_str: String, String => <>
ends_with_str = s, suf =>
   ?s !< ?suf && s(?s - ?suf..?s) == suf

starts_with_str: String, String => <>
starts_with_str = s, pfx =>
   ?s !< ?pfx && s(0..?pfx) == pfx

// True when a line starts a choice arm (|, !|, |->, |+>, |--> , |++>, [guard], ![guard])
// or a leading pipeline stage ($>, $>>, .>).
starts_with_choice_sep: String => <>
starts_with_choice_sep = code =>
   ?code == 0 | --| <->
   c0 = code(0)
   c0 == '[ | --| <+>
   starts_with_str(code, "![") | --| <+>
   starts_with_str(code, "!|") | --| <+>
   starts_with_str(code, "$>") || starts_with_str(code, "$+>") ||
     starts_with_str(code, "$->") || starts_with_str(code, ".>") | --| <+>
   c0 == '| && (?code == 1 || code(1) != '|)

// True when a line is an inline pipe arm (`| first_line` or `!| first_line`).
is_inline_pipe_arm: String => <>
is_inline_pipe_arm = code =>
   starts_with_str(code, "|->") || starts_with_str(code, "|+>") ||
     starts_with_str(code, "|-->") || starts_with_str(code, "|++>")
     | <->
     |
        starts_with_str(code, "!|")
           | ?code > 2
           | (?code > 1 && code(0) == '| && code(1) != '|)

// True when a line ends with a token that opens a standard +3 indented block on the next line.
ends_with_block_opener: String => <>
ends_with_block_opener = code =>
   ?code == 0 | --| <->
   code ["|", "!|", "#public", "#private", "#export", "#foreign"] | --| <+>
   starts_with_str(code, "#foreign ") | --| <+>
   ends_with_str(code, "=>") || ends_with_str(code, "!=>") | --| <+>
   ends_with_str(code, "@") || ends_with_str(code, "@@") || ends_with_str(code, ">--") | --| <+>
   ends_with_str(code, "(") || ends_with_str(code, "{") | --| <+>
   starts_with_str(code, "#type ") && ends_with_str(code, "<") | --| <+>
   (code(0) == '[ || starts_with_str(code, "![")) && ends_with_str(code, "]") | --| <+>
   ends_with_str(code, "=") && !ends_with_str(code, "==") &&
     !ends_with_str(code, "!=") && !ends_with_str(code, "^=") &&
     !ends_with_str(code, "<=") && !ends_with_str(code, ">=")

// True when a line ends with a continuation operator whose wrapped line indents +2 spaces.
ends_with_cont_op: String => <>
ends_with_cont_op = code =>
   ?code == 0 || ends_with_block_opener(code) | --| <->
   ends_with_str(code, "+") && !ends_with_str(code, "++") &&
     !ends_with_str(code, "<+>") && !ends_with_str(code, "<++>") | --| <+>
   ends_with_str(code, "-") && !ends_with_str(code, "--") &&
     !ends_with_str(code, "<->") && !ends_with_str(code, "<-->") | --| <+>
   ends_with_str(code, "*") || ends_with_str(code, "/") || ends_with_str(code, "%") ||
     ends_with_str(code, "&&") || ends_with_str(code, "||") ||
     ends_with_str(code, "==") || ends_with_str(code, "!=") ||
     ends_with_str(code, "!<") || ends_with_str(code, "!>") ||
     ends_with_str(code, ",") || ends_with_str(code, ";") || ends_with_str(code, "$") ||
     ends_with_str(code, "$>") || ends_with_str(code, "$>>") ||
     ends_with_str(code, "$+>") || ends_with_str(code, "$->") || ends_with_str(code, ".>") ||
     ends_with_str(code, ".&.") || ends_with_str(code, ".|.") || ends_with_str(code, ".^.")

// Check whether a child line at `raw` under `parent_raw` is followed by an intermediate
// dedent `mid` (`parent_raw < mid < raw`) before returning to `<= parent_raw`.
has_intermediate_dedent: LineInfos, Int, Int, Int => <>
has_intermediate_dedent = lines, start_idx, parent_raw, child_raw =>
   found' = <->
   idx' = start_idx + 1
   n = ?lines
   0.. @
      idx' !< n | -->
      ln = lines(idx')!!
      ln.start_state == 0 && !ln.is_blank && !ln.is_comment_only
         |
            r = ln.raw_indent
            r !> parent_raw | -->
            r < child_raw
               |
                  found' = <+>
                  -->
      idx' = idx' + 1
   found'

compute_child_delta: LineInfos, Int, String, String, Int, Int => Int
compute_child_delta = lines, idx, parent_code, child_code, parent_raw, child_raw =>
   starts_with_choice_sep(child_code) | --| 3
   is_inline_pipe_arm(parent_code) && !ends_with_block_opener(parent_code)
      |
         ends_with_cont_op(parent_code) &&
           has_intermediate_dedent(lines, idx, parent_raw, child_raw)
           | 4
           | 2
      |
         ends_with_cont_op(parent_code) | 2 | 3

find_stack_level: ast::Ints, Int, Int => Int
find_stack_level = stack, top, raw =>
   idx' = top - 1
   found' = 0
   0.. @
      idx' < 0 | -->
      v = stack(idx') | _ | 0
      v !> raw
         |
            found' = idx'
            -->
         | idx' = idx' - 1
   found'

// Core formatting pass producing canonical Edva source:
// - +3 spaces for standard blocks (functions `=>`, cycles `@`, `[guard]`, `#type`, `#foreign`, choice arms)
// - +2 spaces for inline choice arm blocks (`| first_line` -> `second_line` aligned under `first_line`)
// - +2 spaces for expression continuation lines
format_lines: LineInfos => String
format_lines = lines =>
   raw_stack = ast::Ints()
   canon_stack = ast::Ints()
   body_stack = ast::Names()
   raw_stack += 0
   canon_stack += 0
   body_stack += ""
   top' = 1
   out = {4096}
   blank_run' = 0
   started' = <->
   cur_canon_indent' = 0

   lines @ ln, idx =>
      ln.start_state != 0
         |
            started' = <+>
            blank_run' = 0
            out += ln.raw
            out += '\n
         |
            ln.is_blank
               |
                  started'
                     |
                        blank_run' = blank_run' + 1
                        max_blanks = cur_canon_indent' == 0 | 2 | 1
                        blank_run' !> max_blanks | out += '\n
               |
                  started' = <+>
                  blank_run' = 0
                  body = strip_leading_ws(ln.raw)
                  ln.is_comment_only
                     |
                        lvl = find_stack_level(raw_stack, top', ln.raw_indent)
                        base_c = canon_stack(lvl) | _ | 0
                        base_r = raw_stack(lvl) | _ | 0
                        p_code = body_stack(lvl) | _ | ""
                        c_indent = ln.raw_indent > base_r
                           | base_c + (is_inline_pipe_arm(p_code) && !ends_with_block_opener(p_code) | 2 | 3)
                           | base_c
                        out += make_spaces(c_indent)
                        out += body
                        out += '\n
                     |
                        raw = ln.raw_indent
                        cur_code = strip_code_comment(body)
                        top_raw = raw_stack(top' - 1) | _ | 0
                        raw > top_raw
                           |
                              p_canon = canon_stack(top' - 1) | _ | 0
                              p_code = body_stack(top' - 1) | _ | ""
                              delta = compute_child_delta(lines, idx, p_code, cur_code, top_raw, raw)
                              new_canon = p_canon + delta
                              top' == ?raw_stack
                                 |
                                    raw_stack += raw
                                    canon_stack += new_canon
                                    body_stack += cur_code
                                 |
                                    raw_stack(top') = raw !| _
                                    canon_stack(top') = new_canon !| _
                                    body_stack(top') = cur_code !| _
                              top' = top' + 1
                           |
                              0.. @
                                 top' > 1 && ((raw_stack(top' - 1) | _ | 0) > raw)
                                    | top' = top' - 1
                                    | -->
                              matched_raw = raw_stack(top' - 1) | _ | 0
                              raw > matched_raw
                                 |
                                    // Intermediate dedent landing on an inline block column
                                    p_canon = canon_stack(top' - 1) | _ | 0
                                    p_code = body_stack(top' - 1) | _ | ""
                                    delta = compute_child_delta(lines, idx, p_code, cur_code, matched_raw, raw)
                                    new_canon = p_canon + delta
                                    top' == ?raw_stack
                                       |
                                          raw_stack += raw
                                          canon_stack += new_canon
                                          body_stack += cur_code
                                       |
                                          raw_stack(top') = raw !| _
                                          canon_stack(top') = new_canon !| _
                                          body_stack(top') = cur_code !| _
                                    top' = top' + 1
                                 |
                                    body_stack(top' - 1) = cur_code !| _
                        canon_indent = canon_stack(top' - 1) | _ | 0
                        cur_canon_indent' = canon_indent
                        out += make_spaces(canon_indent)
                        out += format_code_body(body)
                        out += '\n
   res = +out
   // Trim trailing blank lines so file ends with a single newline
   end' = ?res
   0.. @
      end' > 1 && res(end' - 1) == '\n && res(end' - 2) == '\n
         | end' = end' - 1
         | -->
   res(0..end')

// Safe fallback normalization (strips trailing spaces on code lines, normalizes EOF newline).
format_safe_fallback: LineInfos => String
format_safe_fallback = lines =>
   out = {4096}
   lines @ ln =>
      out += ln.raw
      out += '\n
   res = +out
   end' = ?res
   0.. @
      end' > 1 && res(end' - 1) == '\n && res(end' - 2) == '\n
         | end' = end' - 1
         | -->
   res(0..end')

// Parse source with diagnostic capture enabled and return its canonical AST signature.
parse_ast_signature: String, String => < String | String >
parse_ast_signature = src, filename =>
   diag::enable_capture!
   lexer::lex_set_file(filename)
   ppr = parser::parse_init(src)
   parser::parser_set_file(ppr, filename)
   ppr.allow_module_refs = <+>
   prog_res = parser::parse_program(ppr)
   diags = diag::get_captured!
   diag::disable_capture!
   prog_res
      | prog =>
         ?diags > 0
            |
               d = diags(0)!!
               fn = d.file != "" | d.file + ":" | ""
               <- fn + str::from_int(d.line) + ":" + str::from_int(d.col) +
                 ": E" + str::from_int(d.code) + ": " + d.msg +>
            | <+ show::show_expr(prog) ->
      |
         ?diags > 0
            |
               d = diags(0)!!
               fn = d.file != "" | d.file + ":" | ""
               <- fn + str::from_int(d.line) + ":" + str::from_int(d.col) +
                 ": E" + str::from_int(d.code) + ": " + d.msg +>
            | <- filename + ": syntax error" +>

// Format Edva source code and verify AST equivalence.
format_source: String, String => < String | String >
format_source = src, filename =>
   ?src == 0 | --| <+ "" ->
   orig_sig_res = parse_ast_signature(src, filename)
   orig_sig_res
      | orig_sig =>
         lines = split_source_lines(src)
         candidate = format_lines(lines)
         cand_sig_res = parse_ast_signature(candidate, filename)
         cand_sig_res
            | cand_sig =>
               cand_sig == orig_sig
                  | <+ candidate ->
                  |
                     fb = format_safe_fallback(lines)
                     fb_sig_res = parse_ast_signature(fb, filename)
                     fb_sig_res
                        | fb_sig =>
                           fb_sig == orig_sig | <+ fb -> | <+ src ->
                        | <+ src ->
            |
               fb = format_safe_fallback(lines)
               fb_sig_res = parse_ast_signature(fb, filename)
               fb_sig_res
                  | fb_sig =>
                     fb_sig == orig_sig | <+ fb -> | <+ src ->
                  | <+ src ->
      | err => <- err +>

sort_names: ast::Names => ()
sort_names = names =>
   n = ?names
   n @
      (n - 1) @ j =>
         a = names(j) | _ | ""
         b = names(j + 1) | _ | ""
         str::cmp(a, b) > 0
            |
               names(j) = b !| _
               names(j + 1) = a !| _

// Collect `.dva` files recursively from a file or directory path.
collect_dva_files: String, ast::Names => ()
collect_dva_files = target, out =>
   fs::is_file(target)
      |
         fs::ext(target) == ".dva" | out += target
      |
         fs::is_dir(target)
            |
               names = fs::read_dir(target) @> ent =>
                  ent.name(0) != '. | <+ ent.name +>
               sort_names(names)
               names @ name =>
                  sub = fs::join(target, name)
                  collect_dva_files(sub, out)

read_stdin_all: () => String
read_stdin_all = !=>
   b = {4096}
   chunk = {4096}
   0.. @
      n = libc::read(0, &chunk, 4096)
      n !> 0 | -->
      ?chunk = n
      b += +chunk
   +b

write_stdout: String => ()
write_stdout = s =>
   ?s > 0 | libc::write(1, s, ?s)

print_line: String => ()
print_line = s =>
   write_stdout(s + "\n")

print_fmt_help: () => ()
print_fmt_help = !=>
   print_line("Usage: edva fmt [options] [file.dva | dir...]")
   print_line("")
   print_line("Options:")
   print_line("  --check     Check if files are formatted (exit 1 if changes needed)")
   print_line("  --stdout    Write formatted output to stdout instead of modifying files")
   print_line("  --stdin     Read source from stdin and write formatted output to stdout")
   print_line("  -h, --help  Display this help message and exit")

main: Int => Int
main = start_idx =>
   check_only' = <->
   to_stdout' = <->
   from_stdin' = <->
   targets = ast::Names()

   i' = start_idx
   0.. @
      i' !< sys::argc | -->
      arg = sys::argv_string(i')
      arg
         ["-h", "--help"]
            print_fmt_help!
            --| 0
         ["--check"]
            check_only' = <+>
         ["--stdout"]
            to_stdout' = <+>
         ["--stdin"]
            from_stdin' = <+>
         |
            ?arg > 0 && arg(0) == '-
               |
                  log::error("edva fmt: unknown option '" + arg + "'")
                  --| 1
               | targets += arg
      i' = i' + 1

   from_stdin'
      |
         src = read_stdin_all!
         res = format_source(src, "<stdin>")
         res
            | formatted =>
               check_only'
                  | (formatted == src | 0 | 1)
                  |
                     write_stdout(formatted)
                     0
            | err =>
               log::error(err)
               1
      |
         ?targets == 0 | targets += "."
         files = ast::Names()
         targets @ t =>
            !fs::exists(t)
               |
                  log::error("edva fmt: path '" + t + "' does not exist")
                  --| 1
            collect_dva_files(t, files)

         ?files == 0
            |
               log::error("edva fmt: no .dva files found")
               1
            |
               had_err' = <->
               unformatted' = 0
               files @ f =>
                  src_opt = fs::read_to_string(f)
                  src_opt
                     | src =>
                        res = format_source(src, f)
                        res
                           | formatted =>
                              to_stdout'
                                 | write_stdout(formatted)
                                 |
                                    formatted != src
                                       |
                                          check_only'
                                             |
                                                print_line(f)
                                                unformatted' = unformatted' + 1
                                             |
                                                !fs::write_file(f, formatted)
                                                   |
                                                      log::error("edva fmt: could not write '" + f + "'")
                                                      had_err' = <+>
                                                   | print_line(f)
                           | err =>
                              log::error(err)
                              had_err' = <+>
                     |
                        log::error("edva fmt: could not read '" + f + "'")
                        had_err' = <+>
               had_err' || unformatted' > 0 | 1 | 0
