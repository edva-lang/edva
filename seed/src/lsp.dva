// src/lsp.dva — Edva Language Server Protocol (`edva lsp`) implementation.
//
// Speaks JSON-RPC 2.0 over stdin/stdout (`Content-Length` framing) and
// provides live diagnostics (`textDocument/publishDiagnostics`), type hover
// (`textDocument/hover`), go-to-definition (`textDocument/definition`),
// document symbols (`textDocument/documentSymbol`), completion
// (`textDocument/completion`), and canonical formatting
// (`textDocument/formatting`) powered by Edva's self-hosted frontend.

#use ./lexer
#use ./parser
#use ./ast
#use ./tast
#use ./unify
#use ./annotate
#use ./show
#use ./diag
#use ./formatter
#use str
#use mem
#use path
#use log
#use ./version
#use fs
#use json
#use libc
#use sys

#public

// LSP SymbolKind constants
SYM_FUNCTION = 12
SYM_VARIABLE = 13
SYM_CONSTANT = 14
SYM_STRUCT   = 23
SYM_ENUM     = 10

#type SymEntry (
   name: String,
   detail: String,
   kind: Int,
   line: Int,
   col: Int,
   end_line: Int,
   end_col: Int,
   has_annot: <> = <->,
   is_local: <> = <->
)
#type SymEntries SymEntry{}

#type DocState (
   uri: String,
   path: String,
   text: String,
   syms: SymEntries
)
#type DocStates DocState{}

open_docs = DocStates()
stdlib_dir_path = ""
active_doc_text = ""
pending_syms = SymEntries()
pending_diags = diag::DiagEntries()

set_stdlib_dir: String => ()
set_stdlib_dir = dir =>
   stdlib_dir_path ::= dir

has_override: String => <>
has_override = fpath =>
   docs = open_docs
   found' = <->
   docs @ d =>
      d.path == fpath
         |
            found' = <+>
            -->
   found'

get_override_text: String => < String | >
get_override_text = fpath =>
   docs = open_docs
   res' = <-->
   docs @ d =>
      d.path == fpath
         |
            res' = <+ d.text +>
            -->
   res'

record_typecheck_ok: unify::Ctx, tast::TypedProgram => ()
record_typecheck_ok = ctx, tprog =>
   enrich_symbols_with_tast(pending_syms, ctx, tprog, active_doc_text)

record_typecheck_errs: String, unify::TypeErrors => ()
record_typecheck_errs = fpath, errs =>
   errs @ e =>
      (e.file == "" || e.file == fpath)
         | add_unique_diag(pending_diags, diag::DiagEntry(e.code, fpath, e.line, e.col, e.msg, <->))
         |
            e.root_file == fpath && e.root_line > 0
               | add_unique_diag(pending_diags, diag::DiagEntry(e.code, fpath,
                 e.root_line, e.root_col,
                 "${e.msg} (origin: ${e.file}:${str::from_int(e.line)}:${str::from_int(e.col)})",
                 <->))

// --- Low-level JSON-RPC 2.0 Framing over fd 0 / fd 1 -----------------------

read_byte: () => Int
read_byte = !=>
   buf = mem::zero_buf(4)
   n = libc::read(0, &buf, 1)
   n !> 0
      | -1
      | buf(0) .&. 0xFF

read_header_line: () => < String | >
read_header_line = !=>
   b = {128}
   eof' = <->
   0.. @
      c = read_byte!
      c < 0
         |
            ?b == 0 | eof' = <+>
            -->
      c == '\n | -->
      c != '\r | b += c
   eof' | <--> | <+ +b +>

parse_content_length: String => Int
parse_content_length = line =>
   lower = str::lower(line)
   prefix = "content-length:"
   ?lower !< ?prefix && lower(0..?prefix) == prefix
      |
         rest = str::trim(line(?prefix..?line))
         str::to_int(rest) | (.0) | -1
      | -1

read_exact_bytes: Int => < String | >
read_exact_bytes = count =>
   count !> 0 | --| <+ "" +>
   out = {count}
   rem' = count
   err' = <->
   0.. @
      rem' !> 0 | -->
      want = rem' < 4096 | rem' | 4096
      n = mem::write_tail(out, want, (dst, avail => libc::read(0, dst, avail)))
      n !> 0
         |
            err' = <+>
            -->
      rem' = rem' - n
   err' | <--> | <+ +out +>

read_rpc_message: () => < String | >
read_rpc_message = !=>
   content_len' = -1
   eof' = <->
   0.. @
      line_opt = read_header_line!
      line_opt
         | line =>
            ?line == 0
               |
                  content_len' !< 0 | -->
               |
                  cl = parse_content_length(line)
                  cl !< 0 | content_len' = cl
         |
            eof' = <+>
            -->
   eof' || content_len' < 0
      | <-->
      | read_exact_bytes(content_len')

send_rpc_payload: String => ()
send_rpc_payload = body =>
   hdr = "Content-Length: " + str::from_int(?body) + "\r\n\r\n"
   msg = hdr + body
   len = ?msg
   off' = 0
   0.. @
      off' !< len | -->
      slice = msg(off'..len)
      w = libc::write(1, slice, ?slice)
      w !> 0 | -->
      off' = off' + w

// --- URI <-> Filesystem Path Conversion ------------------------------------

hex_val: Int => Int
hex_val = c =>
   c ['0...'9] c - '0
   c ['a...'f] c - 'a + 10
   c ['A...'F] c - 'A + 10
   | -1

uri_to_path: String => String
uri_to_path = uri =>
   prefix = "file://"
   raw = ?uri !< ?prefix && uri(0..?prefix) == prefix
      | uri(?prefix..?uri)
      | uri
   b = {?raw}
   i' = 0
   n = ?raw
   0.. @
      i' !< n | -->
      c = raw(i')
      c == '% && i' + 2 < n
         |
            hi = hex_val(raw(i' + 1))
            lo = hex_val(raw(i' + 2))
            hi !< 0 && lo !< 0
               |
                  b += (hi * 16 + lo)
                  i' = i' + 3
               |
                  b += c
                  i' = i' + 1
         |
            b += c
            i' = i' + 1
   +b

path_to_uri: String => String
path_to_uri = p =>
   ?p !< 7 && p(0..7) == "file://"
      | p
      | "file://" + p

// --- AST & Type Inspection Helpers -----------------------------------------

format_value_type: ast::ValueType => String
format_value_type =
   [Int] "Int"
   [I8] "i8"
   [I16] "i16"
   [I32] "i32"
   [I64] "i64"
   [U8] "u8"
   [U16] "u16"
   [U32] "u32"
   [U64] "u64"
   [Float] "Float"
   [F32] "f32"
   [Str] "String"
   [Rune] "Rune"
   [Flag] "<>"
   [Unit] "()"
   [RawPtr] "Addr"
   [NullablePtr] "ptr"
   [Builder] "Builder"
   [Error] "Error"
   [Type] "Type"
   | "_"

format_type_info: ast::TypeInfo => String
format_type_info = ti =>
   ti
      [Prim vt] format_value_type(vt)
      [TypeVar name] name
      [Rec r]
         fs = r.0
         is_sl = r.1
         is_sl
            |
               ?fs > 0
                  |
                     f0 = fs(0).expect("missing fs")
                     format_type_info(f0.rec_type) + "[]"
                  | "_[]"
            |
               b = {64}
               b += "("
               fs @ f, idx =>
                  idx > 0 | b += ", "
                  f.name != "" | b += (f.name, ": ")
                  ft = format_type_info(f.rec_type)
                  b += (ft != "_" | ft | format_value_type(f.val_type))
               b += ")"
               +b
      [Bitfield bf]
         "#type(packed = " + format_value_type(bf.backing_type) + ")"
      [Ram rm]
         pos = rm.0
         neg = rm.1
         ps = pos.has_payload
            |
               pt = format_type_info(pos.payload_record)
               pt != "_" | pt | format_value_type(pos.payload_type)
            | ""
         ns = neg.has_payload
            |
               nt = format_type_info(neg.payload_record)
               nt != "_" | nt | format_value_type(neg.payload_type)
            | ""
         "< " + ps + " | " + ns + " >"
      [Enum slots]
         b = {64}
         b += "< "
         slots @ s, idx =>
            idx > 0 | b += ", "
            b += s.label
            s.has_payload
               |
                  pt = format_type_info(s.payload_record)
                  b += "(" + (pt != "_" | pt | format_value_type(s.payload_type)) + ")"
         b += " >"
         +b
      [Array a]
         et = format_type_info(a.1)
         base = et != "_" | et | format_value_type(a.0)
         base + "{" + (a.2 > 0 | str::from_int(a.2) | "") + "}"
      [Map m]
         kt = format_value_type(m.0)
         vt = format_type_info(m.2)
         v_str = vt != "_" | vt | format_value_type(m.1)
         kt + " ^ " + v_str
      [Fn f]
         p_vts = f.0
         p_tis = f.1
         r_vt = f.2
         r_ti = f.3
         b = {64}
         ?p_vts == 0
            | b += "()"
            |
               ?p_vts @ idx =>
                  idx > 0 | b += ", "
                  pti = idx < ?p_tis | format_type_info(p_tis(idx).expect("missing p tis")) | "_"
                  b += (pti != "_" | pti | format_value_type(p_vts(idx).expect("missing p vts")))
         b += " => "
         rti = format_type_info(r_ti)
         b += (rti != "_" | rti | format_value_type(r_vt))
         +b
      [Align a]
         "#type(align = " + str::from_int(a.0) + ") " + format_type_info(a.1)
      | "_"

is_fwd_marker: ast::Expr => <>
is_fwd_marker = e =>
   e
      [Var v] ?v !< 5 && v(0..5) == "<fwd>"
      | <->

// Extract top-level symbols from parsed AST and optional solved TypedProgram.
extract_symbols: ast::Exprs, ast::Ints, ast::Ints => SymEntries
extract_symbols = stmts, lines, cols =>
   syms = SymEntries()
   stmts @ st, idx =>
      ln = idx < ?lines | (lines(idx) | _ | 1) | 1
      cl = idx < ?cols | (cols(idx) | _ | 1) | 1
      st
         [TypeDecl td]
            k = td.type_info [Enum] SYM_ENUM | SYM_STRUCT
            detail = "#type " + td.name + " " + format_type_info(td.type_info)
            syms += SymEntry(td.name, detail, k, ln, cl, ln, cl + ?td.name, <+>, <->)
         [Foreign fd]
            b = {64}
            b += ("#foreign ", fd.dva_name, ": ")
            ?fd.params == 0
               | b += "()"
               |
                  fd.params @ p, pi =>
                     pi > 0 | b += ", "
                     pti = format_type_info(p.record_info)
                     b += (pti != "_" | pti | format_value_type(p.param_type))
            b += " => "
            rti = format_type_info(fd.ret_record_info)
            b += (rti != "_" | rti | format_value_type(fd.return_type))
            syms += SymEntry(fd.dva_name, +b, SYM_FUNCTION, ln, cl, ln, cl + ?fd.dva_name, <+>, <->)
         [Assign a]
            name = a.0
            rhs = a.5
            annot_ti = a.8
            is_fwd = is_fwd_marker(rhs)
            is_fn = rhs [Fn] || annot_ti [Fn]
            kind = is_fn | SYM_FUNCTION | (a.1 | SYM_VARIABLE | SYM_CONSTANT)
            ti_str = format_type_info(annot_ti)
            has_ann = ti_str != "_"
            detail = has_ann
               | name + ": " + ti_str
               |
                  rhs
                     [Fn fn_e]
                        pb = {32}
                        ?fn_e.params == 0
                           | pb += "()"
                           |
                              fn_e.params @ pn, pi =>
                                 pi > 0 | pb += ", "
                                 pb += pn
                        name + " = " + (+pb) + " => ..."
                     | name
            // If a forward signature `f: T` was already recorded, update its detail or skip duplicate
            updated' = <->
            !is_fwd
               |
                  ?syms @ si =>
                     prev = syms(si).expect("missing syms")
                     prev.name == name && !prev.is_local
                        |
                           new_det = prev.detail != name | prev.detail | detail
                           syms(si) = SymEntry(name, new_det, is_fn | SYM_FUNCTION | prev.kind,
                              prev.line, prev.col, ln, cl + ?name, prev.has_annot || has_ann, <->) !| _
                           updated' = <+>
            !updated'
               | syms += SymEntry(name, detail, kind, ln, cl, ln, cl + ?name, has_ann, <->)
   syms

sym_has_loc: SymEntries, Int, Int => <>
sym_has_loc = syms, ln, cl =>
   found' = <->
   syms @ s =>
      s.line == ln && s.col == cl
         |
            found' = <+>
            -->
   found'

find_top_sym_line: SymEntries, String => Int
find_top_sym_line = syms, name =>
   ln' = 0
   syms @ s =>
      !s.is_local && s.name == name
         |
            ln' = s.line
            -->
   ln'

next_top_sym_line: SymEntries, Int => Int
next_top_sym_line = syms, start_ln =>
   best' = 0
   syms @ s =>
      !s.is_local && s.line > start_ln && (best' == 0 || s.line < best')
         | best' = s.line
   best'

line_has_type_annot: String, Int, Int, String => <>
line_has_type_annot = text, min_ln, cur_ln, name =>
   found' = <->
   ln' = min_ln
   0.. @
      ln' < cur_ln |
         line_s = get_line_at(text, ln' - 1)
         n = ?line_s
         i' = 0
         0.. @
            i' < n && (line_s(i') ['\s, '\t]) | i' = i' + 1 | -->
         rest = i' < n | line_s(i'..n) | ""
         ?rest !< ?name + 1 && rest(..?name) == name && rest(?name) == ':
            |
               (?rest == ?name + 1 || rest(?name + 1) != ':)
                  |
                     found' = <+>
                     -->
         ln' = ln' + 1
      | -->
   found'

find_local_binding_loc: String, String, Int, Int, SymEntries => (Int, Int, Int)
find_local_binding_loc = text, name, min_ln, max_ln, syms =>
   text == "" || ?name == 0 | --| (0, 0, 0)
   start_ln = min_ln > 1 | min_ln | 1
   ln' = start_ln
   total_lines = count_doc_lines(text)
   end_ln = max_ln > 0 && max_ln !> total_lines | max_ln | total_lines
   res' = (0, 0, 0)
   0.. @
      ln' > end_ln | -->
      line_s = get_line_at(text, ln' - 1)
      n = ?line_s
      ws' = 0
      0.. @
         ws' < n && (line_s(ws') ['\s, '\t]) | ws' = ws' + 1 | -->
      ws' + ?name < n && line_s(ws'..ws' + ?name) == name
         |
            after = ws' + ?name
            has_prime = line_s(after) == ''
            p0 = has_prime | after + 1 | after
            p1' = p0
            0.. @
               p1' < n && (line_s(p1') ['\s, '\t]) | p1' = p1' + 1 | -->
            is_eq = p1' < n && line_s(p1') == '= && (p1' + 1 !< n || !(line_s(p1' + 1) ['=, '>]))
            is_eq && !sym_has_loc(syms, ln', ws' + 1)
               |
                  end_c = ws' + 1 + ?name + (has_prime | 1 | 0)
                  res' = (ln', ws' + 1, end_c)
                  -->
      ln' = ln' + 1
   res'

collect_local_typed_exprs: SymEntries, unify::Ctx, tast::TypedExpr, String, Int, Int => ()
collect_local_typed_exprs = syms, ctx, te, text, min_ln, max_ln =>
   te.kind
      [Lambda lm]
         collect_local_typed_exprs(syms, ctx, lm.1, text, min_ln, max_ln)
      [Block bk]
         bk @ sub =>
            collect_local_typed_exprs(syms, ctx, sub, text, min_ln, max_ln)
      [Choice ch]
         collect_local_typed_exprs(syms, ctx, ch.0, text, min_ln, max_ln)
         ch.1 @ br =>
            collect_local_typed_exprs(syms, ctx, br.body, text, min_ln, max_ln)
      [Cycle cy]
         collect_local_typed_exprs(syms, ctx, cy.0, text, min_ln, max_ln)
         collect_local_typed_exprs(syms, ctx, cy.1, text, min_ln, max_ln)
         cy.2 | esc =>
            collect_local_typed_exprs(syms, ctx, esc, text, min_ln, max_ln)
      [Assign a]
         collect_local_typed_exprs(syms, ctx, a.5, text, min_ln, max_ln)
         nm = a.0
         is_temp = ?nm == 0 || nm == "_" || (?nm !< 2 && nm(0..2) == "__")
         !is_temp && !a.2 && !a.3 && !a.4
            |
               ut_str = unify::show_utype(ctx, a.5.ut)
               valid_ut = ut_str != "" && ut_str != "?" && ut_str != "_" && ut_str != "()"
               valid_ut
                  |
                     loc = find_local_binding_loc(text, nm, min_ln, max_ln, syms)
                     loc.0 > 0
                        |
                           has_ann = line_has_type_annot(text, min_ln, loc.0, nm)
                           is_fn = a.5.kind [Lambda]
                           k = is_fn | SYM_FUNCTION | (a.1 | SYM_VARIABLE | SYM_CONSTANT)
                           syms += SymEntry(nm, "${nm}: ${ut_str}", k,
                              loc.0, loc.1, loc.0, loc.2, has_ann, <+>)

update_sym_type: SymEntries, String, String => ()
update_sym_type = syms, b_name, ut_str =>
   ut_str != "" && ut_str != "?"
      |
         ?syms @ i =>
            s = syms(i).expect("missing syms")
            !s.is_local && s.name == b_name && (s.detail == b_name || (?s.detail !< 3 && s.detail(?s.detail - 3..) == "..."))
               |
                  syms(i) = SymEntry(s.name, b_name + ": " + ut_str,
                     s.kind, s.line, s.col, s.end_line, s.end_col, s.has_annot, s.is_local) !| _

// Enrich symbol details with inferred types from `annotate::annotate_program` when available.
enrich_symbols_with_tast: SymEntries, unify::Ctx, tast::TypedProgram, String => ()
enrich_symbols_with_tast = syms, ctx, tprog, text =>
   tprog @ tst =>
      tst
         [Expr te]
            te.kind
               [Assign a]
                  a_name = a.0
                  a_val = a.5
                  ut_str = unify::show_utype(ctx, a_val.ut)
                  update_sym_type(syms, a_name, ut_str)
                  top_ln = find_top_sym_line(syms, a_name)
                  min_ln = top_ln > 0 | top_ln | 1
                  max_ln = next_top_sym_line(syms, min_ln)
                  collect_local_typed_exprs(syms, ctx, a_val, text, min_ln, max_ln)
         [Binding b]
            b_name = b.0
            b_te = b.2
            ut_str = unify::show_utype(ctx, b_te.ut)
            update_sym_type(syms, b_name, ut_str)
            top_ln = find_top_sym_line(syms, b_name)
            min_ln = top_ln > 0 | top_ln | 1
            max_ln = next_top_sym_line(syms, min_ln)
            collect_local_typed_exprs(syms, ctx, b_te, text, min_ln, max_ln)
         [GlobalBinding gb]
            gb_name = gb.0
            gb_te = gb.2
            ut_str = unify::show_utype(ctx, gb_te.ut)
            update_sym_type(syms, gb_name, ut_str)
            top_ln = find_top_sym_line(syms, gb_name)
            min_ln = top_ln > 0 | top_ln | 1
            max_ln = next_top_sym_line(syms, min_ln)
            collect_local_typed_exprs(syms, ctx, gb_te, text, min_ln, max_ln)

has_use_imports: ast::Exprs => <>
has_use_imports = stmts =>
   found' = <->
   stmts @ st =>
      st [Import]
         |
            found' = <+>
            -->
   found'

// --- JSON Builders for LSP Responses & Notifications -----------------------

lsp_range_json: Int, Int, Int, Int => String
lsp_range_json = sl, sc, el, ec =>
   s_line = sl > 0 | sl - 1 | 0
   s_col  = sc > 0 | sc - 1 | 0
   e_line = el > 0 | el - 1 | s_line
   e_col  = ec > 0 | ec - 1 | s_col + 1
   "{\"start\":{\"line\":" + str::from_int(s_line) +
      ",\"character\":" + str::from_int(s_col) +
      "},\"end\":{\"line\":" + str::from_int(e_line) +
      ",\"character\":" + str::from_int(e_col) + "}}"

lsp_diag_json: Int, Int, Int, String, <> => String
lsp_diag_json = code, line, col, msg, is_warn =>
   sev = is_warn | 2 | 1
   rng = lsp_range_json(line, col, line, col + 1)
   code_pfx = "E" + str::from_int(code) + ": "
   has_pfx = ?msg !< ?code_pfx && msg(0..?code_pfx) == code_pfx
   full_msg = has_pfx | msg | code_pfx + msg
   "{\"range\":" + rng +
      ",\"severity\":" + str::from_int(sev) +
      ",\"code\":\"E" + str::from_int(code) + "\"" +
      ",\"source\":\"edva\"" +
      ",\"message\":" + json::escape_string(full_msg) + "}"

publish_diagnostics: String, diag::DiagEntries => ()
publish_diagnostics = uri, diags =>
   b = {512}
   b += "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":"
   b += json::escape_string(uri)
   b += ",\"diagnostics\":["
   diags @ d, idx =>
      idx > 0 | b += ","
      b += lsp_diag_json(d.code, d.line, d.col, d.msg, d.is_warn)
   b += "]}}"
   send_rpc_payload(+b)

// --- Document Analysis & Caching -------------------------------------------

copy_sym_entries: SymEntries => SymEntries
copy_sym_entries = src =>
   out = SymEntries()
   src @ s =>
      out += SymEntry(++s.name, ++s.detail, s.kind, s.line, s.col, s.end_line, s.end_col, s.has_annot, s.is_local)
   out

upsert_doc: String, String, String, SymEntries => ()
upsert_doc = uri, fpath, text, syms =>
   mem::escape((!=>
      esc_uri = ++uri
      esc_path = ++fpath
      esc_text = ++text
      esc_syms = copy_sym_entries(syms)
      docs = open_docs
      found' = <->
      ?docs @ i =>
         d = docs(i).expect("missing docs")
         d.uri == esc_uri
            |
               docs(i) = DocState(esc_uri, esc_path, esc_text, esc_syms) !| _
               found' = <+>
               -->
      !found'
         |
            docs += DocState(esc_uri, esc_path, esc_text, esc_syms)
            open_docs ::= docs
   ))

get_doc: String => < DocState | >
get_doc = uri =>
   docs = open_docs
   res' = <-->
   docs @ d =>
      d.uri == uri
         |
            res' = <+ d +>
            -->
   res'

remove_doc: String => ()
remove_doc = uri =>
   mem::escape((!=>
      open_docs ::= (open_docs @> d => d.uri != uri | <+ d +>)
   ))

has_diag: diag::DiagEntries, diag::DiagEntry => <>
has_diag = list, item =>
   found' = <->
   list @ d =>
      d.code == item.code && d.line == item.line && d.col == item.col && d.msg == item.msg
         |
            found' = <+>
            -->
   found'

add_unique_diag: diag::DiagEntries, diag::DiagEntry => ()
add_unique_diag = list, item =>
   !has_diag(list, item) | list += item

analyze_document: String, String, (String => ()) => ()
analyze_document = uri, text, tc_hook =>
   active_doc_text ::= text
   fpath = uri_to_path(uri)
   ast::cell_var_reset!
   diag::enable_capture!
   lexer::lex_set_file(fpath)
   ppr = parser::parse_init(text)
   parser::parser_set_file(ppr, fpath)
   ppr.allow_module_refs = <+>
   prog_res = parser::parse_program(ppr)
   captured = diag::get_captured!
   diag::disable_capture!

   all_diags = diag::DiagEntries()
   captured @ cd => add_unique_diag(all_diags, cd)

   syms' = SymEntries()
   upsert_doc(uri, fpath, text, syms')
   prog_res
      | prog =>
         prog
            [Block stmts]
               folded = parser::fold_program_consts(stmts)
               syms' = extract_symbols(folded, ppr.top_lines, ppr.top_cols)
               upsert_doc(uri, fpath, text, syms')
               ?all_diags == 0
                  |
                     !has_use_imports(folded)
                        |
                           files = ast::Names()
                           ?folded @
                              files += fpath
                           annotate::set_source_file(fpath)
                           annotate::set_program_locs(files, ppr.top_lines, ppr.top_cols)
                           el_res = annotate::annotate_program(ast::Expr(Block, folded))
                           el_res
                              | succ =>
                                 enrich_symbols_with_tast(syms', succ.ctx, succ.prog, text)
                              | errs =>
                                 errs @ e =>
                                    add_unique_diag(all_diags, diag::DiagEntry(e.code, e.file, e.line, e.col, e.msg, <->))
                        |
                           pending_syms ::= syms'
                           pending_diags ::= all_diags
                           diag::enable_capture!
                           tc_hook(fpath)
                           ld_captured = diag::get_captured!
                           diag::disable_capture!
                           ld_captured @ lcd =>
                              (lcd.file == "" || lcd.file == fpath)
                                 | add_unique_diag(pending_diags, lcd)
                           syms' = pending_syms
   upsert_doc(uri, fpath, text, syms')
   publish_diagnostics(uri, all_diags)

// --- Word / Identifier Extraction at Cursor (0-based line, character) ------

is_ident_char: Int => <>
is_ident_char = c =>
   c ['a...'z, 'A...'Z, '0...'9, '_, '', '#, ':]

get_line_at: String, Int => String
get_line_at = text, target_line =>
   n = ?text
   pos' = 0
   cur_line' = 0
   res' = ++""
   0.. @
      pos' !< n | -->
      lstart = pos'
      0.. @
         pos' !< n || text(pos') == '\n | -->
         pos' = pos' + 1
      cur_line' == target_line
         |
            lend = pos' > lstart && text(pos' - 1) == '\r | pos' - 1 | pos'
            res' = text(lstart..lend)
            -->
      pos' < n && text(pos') == '\n | pos' = pos' + 1
      cur_line' = cur_line' + 1
   res'

count_doc_lines: String => Int
count_doc_lines = text =>
   cnt' = 1
   text @ ch_ =>
      ch_ == '\n | cnt' = cnt' + 1
   cnt'

extract_word_at: String, Int, Int => String
extract_word_at = text, line0, char0 =>
   line_str = get_line_at(text, line0)
   n = ?line_str
   n == 0 | --| ""
   idx = char0 < n | (char0 < 0 | 0 | char0) | n - 1
   !is_ident_char(line_str(idx)) | --| ""
   s' = idx
   0.. @
      s' > 0 && is_ident_char(line_str(s' - 1))
         | s' = s' - 1
         | -->
   e' = idx + 1
   0.. @
      e' < n && is_ident_char(line_str(e'))
         | e' = e' + 1
         | -->
   line_str(s'..e')

is_op_char: Int => <>
is_op_char = c =>
   c ['|, '!, '-, '+, '<, '>, '@, '$, '., '^, ':, '=, '?, '~, '&, '*, '/, '%]

extract_operator_at: String, Int, Int => String
extract_operator_at = text, line0, char0 =>
   line_str = get_line_at(text, line0)
   n = ?line_str
   n == 0 | --| ""
   idx = char0 < n | (char0 < 0 | 0 | char0) | n - 1
   // Check the special 3-byte `|_|` unwrap-or-default token whether hovering `|` or `_`
   has_def_l = idx + 2 < n && line_str(idx..idx + 3) == "|_|"
   has_def_m = idx > 0 && idx + 1 < n && line_str(idx - 1..idx + 2) == "|_|"
   has_def_r = idx !< 2 && line_str(idx - 2..idx + 1) == "|_|"
   (has_def_l || has_def_m || has_def_r) | --| "|_|"
   !is_op_char(line_str(idx)) | --| ""
   s' = idx
   0.. @
      s' > 0 && is_op_char(line_str(s' - 1))
         | s' = s' - 1
         | -->
   e' = idx + 1
   0.. @
      e' < n && is_op_char(line_str(e'))
         | e' = e' + 1
         | -->
   line_str(s'..e')

operator_hover_doc: String => String
operator_hover_doc = op =>
   op
      ["|"] "**Choice / fallback separator** `|` *(LBP 50 / RBP 60, left)* — Separates positive and negative ramification arms (`r | pos | neg`) or supplies the trailing fallback branch of a guarded choice."
      ["!|"] "**Skip-positive choice** `!|` *(LBP 50 / RBP 60, left)* — Ignores a unit positive slot (`< | E >` or `<>`) and evaluates its RHS only on negative/failure.\n\n```dva\narr(i) = val !| err => log::error(err.msg)\n```"
      ["--|"] "**Early return** `--|` — Immediately returns from the enclosing function (`--| value` or unit `--|`)."
      ["--!"] "**Propagate / unwrap** `--!` *(LBP 170, postfix, left)* — Unwraps the positive payload of a ramification or early-returns its negative slot from the enclosing function.\n\n```dva\nitem = lookup(key)--!\n```"
      ["-->"] "**Break cycle** `-->` / `-->N` *(LBP 10 / RBP 20)* — Exits the innermost enclosing `@` cycle (or `N` levels out, triggering any `>--` escape branch)."
      ["--^"] "**Continue cycle** `--^` / `--^N` *(LBP 10 / RBP 20)* — Advances immediately to the next iteration (skipping element emission in `@>`)."
      [">--"] "**Cycle escape branch** `>--` *(LBP 10 / RBP 20)* — Produces `<+ escape_val +>` when the attached cycle exits via `-->`, or `<-->` on normal completion."
      ["<+"] "**Positive ramification opener** `<+ expr ...` — Constructs a positive payload: `<+ expr +>` for `< T | >`, or `<+ expr ->` for `< T | E >`."
      ["+>"] "**Positive / RamPP-neg closer** `+>` — Closes `<+ expr +>` (`< T | >`) or `<- expr +>` (`< T | E >` negative slot)."
      ["<-"] "**Negative ramification opener** `<- expr ...` — Constructs a negative payload: `<- expr ->` for `< | E >`, or `<- expr +>` for `< T | E >`."
      ["->"] "**Negative / RamPP-pos closer** `->` — Closes `<- expr ->` (`< | E >`) or `<+ expr ->` (`< T | E >` positive slot)."
      ["<>"] "**Unit Flag type / negative flag** `<>` — Binary boolean type whose unit constructors are `<+>` (true) and `<->` (false)."
      ["<+>"] "**Positive Flag literal** `<+>` — True / positive unit value of `<>`."
      ["<->"] "**Negative Flag literal** `<->` — False / negative unit value of `<>`."
      ["<-->"] "**Absent RamPN value** `<-->` — Empty negative slot of `< T | >`."
      ["<++>"] "**Success RamNP value** `<++>` — Unit positive slot of `< | E >`."
      ["|->"] "**Return false on match** `cond |->` — Sugar for `cond | --| <->` inside `<>`-returning functions."
      ["|+>"] "**Return true on match** `cond |+>` — Sugar for `cond | --| <+>` inside `<>`-returning functions."
      ["|-->"] "**Return absence on match** `cond |-->` — Sugar for `cond | --| <-->` inside `< T | >`-returning functions."
      ["|++>"] "**Return success on match** `cond |++>` — Sugar for `cond | --| <++>` inside `< | E >`-returning functions."
      ["|_|"] "**Unwrap-or-default** `|_|` *(choice sugar)* — Evaluates to the positive payload of `< T | >` or `< T | E >`, or falls back to the RHS expression (`opt |_| fallback`)."
      ["@"] "**Cycle** `@` *(LBP 10 / RBP 20, left)* — Statement loop over integers, ranges, collections, maps, or conditions (`i =>`, `_`, `_i`)."
      ["@@"] "**Rune cycle** `@@` *(LBP 10 / RBP 20, left)* — Iterates decoded UTF-8 Unicode `Rune` codepoints of a `String` or `Builder`."
      ["@>"] "**Expression cycle** `@>` *(LBP 10 / RBP 20, left)* — Map (`xs @> f`), filter-map (`xs @> (x => cond | <+ y +>)`), direct freeze (`+(xs @> ...)`), or seeded fold (`(acc0, xs) @> f`)."
      ["@@>"] "**Rune expression cycle** `@@>` *(LBP 10 / RBP 20, left)* — Decodes UTF-8 `Rune`s and collects/folds across `@>`."
      ["$"] "**Low-precedence apply** `$` *(LBP 30 / RBP 30, right)* — Applies LHS to trailing RHS expression (`f $ x` is `f(x)`), absorbing unparenthesized choices."
      ["$>"] "**Pipeline feed** `$>` *(LBP 40 / RBP 50, left)* — Passes LHS as first argument (`x $> f(a)` is `f(x, a)`) or into explicit `_` placeholder slots (`x $> f(a, _)`)."
      ["$>>"] "**Monadic ram bind** `$>>` *(LBP 40 / RBP 50, left)* — Passes positive payload into a ram-returning continuation, short-circuiting negative values (`E3091` if continuation does not return a ram)."
      ["$+>"] "**Ram positive map** `$+>` *(LBP 40 / RBP 50, left)* — Maps over the positive slot of `< T | E >` or `< T | >`, preserving the negative slot."
      ["$->"] "**Ram negative map** `$->` *(LBP 40 / RBP 50, left)* — Maps over the negative slot of `< T | E >` or `< | E >`, preserving the positive slot."
      [".>"] "**Function composition** `.>` *(LBP 40 / RBP 50, left)* — Left-to-right composition: `(f .> g)(x)` evaluates `g(f(x))`."
      ["!!"] "The `!!` operator was removed. Use `--!`, `|_|`, a choice, or `.expect(\"reason\")`."
      ["!<"] "**Greater-or-equal** `!<` *(LBP 120 / RBP 130, left, chainable)* — Ordered \"not less\" (`>=`); yields `<->` on `NaN`."
      ["!>"] "**Less-or-equal** `!>` *(LBP 120 / RBP 130, left, chainable)* — Ordered \"not greater\" (`<=`); yields `<->` on `NaN`."
      ["=="] "**Structural equality** `==` *(LBP 120 / RBP 130, left)* — Compares scalars, `String`, records, enums, `Type`, and flags (`<>` XNOR)."
      ["!="] "**Structural inequality** `!=` *(LBP 120 / RBP 130, left)* — Negation of `==` (`<>` XOR; `NaN != NaN` is `<+>`)."
      [".."] "**Half-open range** `a..b` *(LBP 70 / RBP 80, left)* — Interval `[a, b)` for choice guards, cycles, and subviews."
      ["...", "..="] "**Closed range** `a...b` / `a..=b` *(LBP 70 / RBP 80, left)* — Inclusive interval `[a, b]` for choice guards, cycles, and slices."
      ["^"] "**Map lookup / insert** `m ^ k` — Returns `< V | Error >` on read (`m ^ k = v` inserts/updates)."
      ["^?"] "**Map key membership** `m ^? k` — Returns `<>` (`<+>` when key `k` exists in `m`)."
      ["^-"] "**Map key delete** `m ^- k` — Removes key `k` from map `m` and returns `<>`."
      ["+="] "**Append in-place** `+=` *(LBP 60 / RBP 50, right)* — Appends chunk to `Builder` or element to growable array `T{}`."
      [":="] "**Dynamic rebinding** `:=` — Rebinds an existing variable slot."
      ["::="] "**Global mutation** `::=` *(LBP 60 / RBP 50, right)* — Mutates a declared module-level global variable inside a function."
      ["="] "**Binding / update** `=` *(LBP 60 / RBP 50, right)* — Binds a new identifier or updates an active primed `x'` / field target."
      ["?"] "**Length / count** `?` *(LBP 160 / RBP 180, prefix)* — Returns byte length (`String`/`Builder`), element count (`T{}`/`T[]`), entry count (`K ^ V`), or member count."
      ["??"] "**UTF-8 codepoint count** `??` *(LBP 160 / RBP 180, prefix)* — Counts Unicode scalar values in a `String`."
      ["+"] "**Addition / concat / Builder freeze** `+` — Binary numeric add or string/builder concatenation (LBP 140); unary `+b` freezes `Builder` to `String`."
      ["++"] "**Deep arena copy** `++` *(LBP 160 / RBP 180, prefix)* — Deep-copies `String`, `Builder`, record, array, or slice into the active `mem::Arena`."
      ["~~"] "**State lens** `~~` *(LBP 160 / RBP 180, prefix)* — Creates a `(get, set)` two-way binding record over a mutable slot."
      ["&"] "**Address-of** `&` *(LBP 160 / RBP 180, prefix)* — Extracts raw `Addr` buffer or value pointer."
      ["=>"] "**Function / lambda arrow** `=>` — Defines function signature/body or parameter binder (`x => expr`)."
      ["!=>"] "**Nullary function arrow** `!=>` — Defines a 0-argument function invoked as `f!`."
      [".<.", ".>."] "**Bit shift** `.<.` (left) / `.>.` (right) *(LBP 130 / RBP 140, non-associative)* — Requires parentheses when chained (`E2025`)."
      [".&.", ".|.", ".^.", ".!."] "**Bitwise operators** `.&.` (AND, LBP 110), `.^.` (XOR, LBP 105), `.|.` (OR, LBP 100), `.!.` (unary NOT)."
      | ""

builtin_hover_doc: String => String
builtin_hover_doc = word =>
   word
      ["Int"] "`Int` — 64-bit signed integer (`i64`, 8 bytes)."
      ["Float"] "`Float` — 64-bit IEEE-754 floating-point (`f64`, 8 bytes)."
      ["String"] "`String` — Immutable UTF-8 byte view (`{ ptr, i64 }`, 16 bytes)."
      ["Rune"] "`Rune` — Unicode scalar value (`i32`, 4 bytes)."
      ["Builder"] "`Builder` — Mutable Arena-backed byte buffer (`{ cap }`)."
      ["Addr"] "`Addr` — Untyped raw memory address (`@[addr]`, `&x`)."
      ["Error"] "`Error` — Structured error record (`code`, `message`, `file`, `line`, `col`, `context`)."
      ["Type"] "`Type` — First-class compile-time type value (`#param T: Type`)."
      ["#use"] "`#use <module>` — Imports a standard library, relative, or `@pkg` module."
      ["#type"] "`#type[(mods)] <Name> <Def>` — Declares a named record, bitfield, ramification, or enum."
      ["#foreign"] "`#foreign(\"<abi>\")` — Declares external C ABI functions or symbols."
      ["#public"] "`#public` — Exports subsequent declarations from the current module."
      ["#private"] "`#private` — Marks subsequent declarations module-private."
      ["#export"] "`#export[(\"sym\")]` — Exports a function with unmangled C ABI linkage."
      ["#param"] "`#param <bindings>` — Compile-time functor parameters or function type/value params."
      ["#const"] "`#const <bindings>` — Compile-time constant bindings (module or local)."
      ["#pragma"] "`#pragma(<opts>)` — Sets module compiler pragmas (`integer`, `fpfast`, `swizzle`)."
      ["#infix"] "`#infix(<lbp>, <rbp>) <fn>` — Binds a user-defined infix operator precedence."
      ["#os"] "`#os` — Target operating system name (`\"linux\"`, `\"macos\"`, `\"windows\"`, ...)."
      ["#arch"] "`#arch` — Target CPU architecture (`\"x86_64\"`, `\"aarch64\"`, `\"wasm32\"`, ...)."
      ["#target"] "`#target` — Full target triple string."
      ["#size"] "`#size <Type>` — Compile-time byte size of a type (`Int`)."
      ["#align"] "`#align <Type>` — Compile-time byte alignment of a type (`Int`)."
      ["#name"] "`#name <Type>` — Canonical display name of a type (`String`)."
      ["#zero"] "`#zero <Type>` — Default zero value of a type."
      ["#arity"] "`#arity <Type>` — Member or variant count of a record or enum (`Int`)."
      ["#has_member"] "`#has_member <T>, <name>` — Compile-time check whether `<T>` has field/variant `<name>`."
      ["#members"] "`#members <T> @ m =>` — Compile-time unrolled iteration over fields/variants of `<T>`."
      ["#member"] "`#member <tgt>, <mem>[, <pay>]` — Accesses or constructs a field/variant dynamically by index/name."
      | ""

// Search an imported module on disk for `mod::member` hover/definition.
find_imported_symbol: String, String, String => < (String, SymEntry) | >
find_imported_symbol = doc_path, mod_name, member_name =>
   base_dir = path::parent(doc_path)
   cand1 = path::join(base_dir, mod_name + ".dva")
   cand2 = stdlib_dir_path != "" | path::join(stdlib_dir_path, mod_name + ".dva") | ""
   target_path = (has_override(cand1) || fs::is_file(cand1))
      | cand1
      | (cand2 != "" && (has_override(cand2) || fs::is_file(cand2)) | cand2 | "")
   target_path == "" | --| <-->
   src_opt = get_override_text(target_path)
      | txt => <+ txt +>
      | fs::read_to_string(target_path)
   src_opt
      | src =>
         diag::enable_capture!
         lexer::lex_set_file(target_path)
         ppr = parser::parse_init(src)
         parser::parser_set_file(ppr, target_path)
         ppr.allow_module_refs = <+>
         prog_res = parser::parse_program(ppr)
         diag::disable_capture!
         prog_res
            | prog =>
               prog
                  [Block stmts]
                     syms = extract_symbols(stmts, ppr.top_lines, ppr.top_cols)
                     hit' = <-->
                     syms @ s =>
                        s.name == member_name
                           |
                              hit' = <+ (target_path, s) +>
                              -->
                     hit'
                  | <-->
            | <-->
      | <-->

split_qualified: String => (String, String)
split_qualified = word =>
   n = ?word
   i' = 0
   found' = -1
   0.. @
      i' + 1 !< n | -->
      word(i') == ': && word(i' + 1) == ':
         |
            found' = i'
            -->
      i' = i' + 1
   found' !< 0
      | (word(0..found'), word(found' + 2..n))
      | ("", word)

// --- LSP Request Handlers --------------------------------------------------

format_id_json: json::Value => String
format_id_json = id_val =>
   id_val
      [Number n] json::format_number(n)
      [String s] json::escape_string(s)
      | "null"

send_result: json::Value, String => ()
send_result = id_val, result_json =>
   payload = "{\"jsonrpc\":\"2.0\",\"id\":" + format_id_json(id_val) +
      ",\"result\":" + result_json + "}"
   send_rpc_payload(payload)

handle_initialize: json::Value => ()
handle_initialize = id_val =>
   caps = "{\"capabilities\":{" +
      "\"textDocumentSync\":1," +
      "\"hoverProvider\":true," +
      "\"definitionProvider\":true," +
      "\"documentSymbolProvider\":true," +
      "\"documentFormattingProvider\":true," +
      "\"inlayHintProvider\":true," +
      "\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"]}" +
      "},\"serverInfo\":{\"name\":\"edva-lsp\",\"version\":" +
      json::escape_string(version::VERSION) + "}}"
   send_result(id_val, caps)

extract_doc_uri_and_pos: json::Value => (String, Int, Int)
extract_doc_uri_and_pos = params =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   pos = json::get(params, "position") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   line0 = json::get_int(pos, "line") | l => l | 0
   char0 = json::get_int(pos, "character") | c => c | 0
   (uri, line0, char0)

handle_hover: json::Value, json::Value => ()
handle_hover = id_val, params =>
   up = extract_doc_uri_and_pos(params)
   uri = up.0
   line0 = up.1
   char0 = up.2
   doc_opt = get_doc(uri)
   doc_opt
      | doc =>
         word = extract_word_at(doc.text, line0, char0)
         ?word == 0
            |
               op = extract_operator_at(doc.text, line0, char0)
               odoc = op != "" | operator_hover_doc(op) | ""
               odoc != ""
                  | send_result(id_val, "{\"contents\":{\"kind\":\"markdown\",\"value\":" +
                       json::escape_string(odoc) + "}}")
                  | send_result(id_val, "null")
            |
               qual = split_qualified(word)
               mod_name = qual.0
               bare = qual.1
               mod_name != ""
                  |
                     imp_opt = find_imported_symbol(doc.path, mod_name, bare)
                     imp_opt
                        | imp =>
                           sym = imp.1
                           md = "```dva\n" + sym.detail + "\n```\n*(from `" + mod_name + "`)*"
                           send_result(id_val, "{\"contents\":{\"kind\":\"markdown\",\"value\":" +
                              json::escape_string(md) + "}}")
                        | send_result(id_val, "null")
                  |
                     hit_det' = ++""
                     hit_local_ln' = 0
                     doc.syms @ s =>
                        s.name == bare
                           |
                              s.is_local
                                 |
                                    s.line !> line0 + 1 && s.line !< hit_local_ln'
                                       |
                                          hit_local_ln' = s.line
                                          hit_det' = s.detail
                                 |
                                    hit_det' == "" | hit_det' = s.detail
                     hit_det' != ""
                        |
                           md = "```dva\n" + hit_det' + "\n```"
                           send_result(id_val, "{\"contents\":{\"kind\":\"markdown\",\"value\":" +
                              json::escape_string(md) + "}}")
                        |
                           bdoc = builtin_hover_doc(word)
                           bdoc != ""
                              |
                                 send_result(id_val, "{\"contents\":{\"kind\":\"markdown\",\"value\":" +
                                    json::escape_string(bdoc) + "}}")
                              |
                                 op = extract_operator_at(doc.text, line0, char0)
                                 odoc = op != "" | operator_hover_doc(op) | ""
                                 odoc != ""
                                    | send_result(id_val, "{\"contents\":{\"kind\":\"markdown\",\"value\":" +
                                         json::escape_string(odoc) + "}}")
                                    | send_result(id_val, "null")
      | send_result(id_val, "null")

handle_definition: json::Value, json::Value => ()
handle_definition = id_val, params =>
   up = extract_doc_uri_and_pos(params)
   uri = up.0
   line0 = up.1
   char0 = up.2
   doc_opt = get_doc(uri)
   doc_opt
      | doc =>
         word = extract_word_at(doc.text, line0, char0)
         ?word == 0
            | send_result(id_val, "null")
            |
               qual = split_qualified(word)
               mod_name = qual.0
               bare = qual.1
               mod_name != ""
                  |
                     imp_opt = find_imported_symbol(doc.path, mod_name, bare)
                     imp_opt
                        | imp =>
                           tpath = imp.0
                           sym = imp.1
                           turi = path_to_uri(tpath)
                           rng = lsp_range_json(sym.line, sym.col, sym.end_line, sym.end_col)
                           send_result(id_val, "{\"uri\":" + json::escape_string(turi) +
                              ",\"range\":" + rng + "}")
                        | send_result(id_val, "null")
                  |
                     found' = <->
                     loc_json' = ++"null"
                     doc.syms @ s =>
                        s.name == bare
                           |
                              rng = lsp_range_json(s.line, s.col, s.end_line, s.end_col)
                              loc_json' = "{\"uri\":" + json::escape_string(uri) +
                                 ",\"range\":" + rng + "}"
                              found' = <+>
                              -->
                     send_result(id_val, loc_json')
      | send_result(id_val, "null")

handle_document_symbol: json::Value, json::Value => ()
handle_document_symbol = id_val, params =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   doc_opt = get_doc(uri)
   doc_opt
      | doc =>
         b = {512}
         b += "["
         emitted' = 0
         doc.syms @ s =>
            !s.is_local
               |
                  emitted' > 0 | b += ","
                  rng = lsp_range_json(s.line, s.col, s.end_line, s.end_col)
                  b += "{\"name\":" + json::escape_string(s.name) +
                     ",\"detail\":" + json::escape_string(s.detail) +
                     ",\"kind\":" + str::from_int(s.kind) +
                     ",\"range\":" + rng +
                     ",\"selectionRange\":" + rng + "}"
                  emitted' = emitted' + 1
         b += "]"
         send_result(id_val, +b)
      | send_result(id_val, "[]")

handle_formatting: json::Value, json::Value => ()
handle_formatting = id_val, params =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   doc_opt = get_doc(uri)
   doc_opt
      | doc =>
         fmt_res = formatter::format_source(doc.text, doc.path)
         fmt_res
            | formatted =>
               formatted == doc.text
                  | send_result(id_val, "[]")
                  |
                     nlines = count_doc_lines(doc.text)
                     rng = lsp_range_json(1, 1, nlines + 1, 1)
                     edit = "[{\"range\":" + rng + ",\"newText\":" +
                        json::escape_string(formatted) + "}]"
                     send_result(id_val, edit)
            | send_result(id_val, "[]")
      | send_result(id_val, "[]")

handle_completion: json::Value, json::Value => ()
handle_completion = id_val, params =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   b = {512}
   b += "["
   count' = 0
   doc_opt = get_doc(uri)
   doc_opt
      | doc =>
         doc.syms @ s =>
            !s.is_local
               |
                  count' > 0 | b += ","
                  ckind = s.kind == SYM_FUNCTION | 3 | (s.kind == SYM_STRUCT | 22 | 6)
                  b += "{\"label\":" + json::escape_string(s.name) +
                     ",\"kind\":" + str::from_int(ckind) +
                     ",\"detail\":" + json::escape_string(s.detail) + "}"
                  count' = count' + 1
   b += "]"
   send_result(id_val, +b)

handle_inlay_hint: json::Value, json::Value => ()
handle_inlay_hint = id_val, params =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   rng_obj = json::get(params, "range") | v => v | json::Value(Null)
   r_start_obj = json::get(rng_obj, "start") | v => v | json::Value(Null)
   r_end_obj = json::get(rng_obj, "end") | v => v | json::Value(Null)
   r_start = json::get_int(r_start_obj, "line") | l => l | 0
   r_end = json::get_int(r_end_obj, "line") | l => l | 1000000
   b = {512}
   b += "["
   emitted' = 0
   doc_opt = get_doc(uri)
   doc_opt
      | doc =>
         doc.syms @ s =>
            line0 = s.line - 1
            char0 = s.end_col - 1
            in_range = s.line > 0 && line0 !< r_start && line0 !> r_end
            pfx = "${s.name}: "
            has_type_pfx = ?s.detail > ?pfx && s.detail(0..?pfx) == pfx
            no_dots = ?s.detail < 3 || s.detail(?s.detail - 3..) != "..."
            !s.has_annot && in_range && has_type_pfx && no_dots && s.end_col > 0
               |
                  ty_str = s.detail(?pfx..)
                  ty_str != "" && ty_str != "_" && ty_str != "?" && ty_str != "()"
                     |
                        emitted' > 0 | b += ","
                        b += "{\"position\":{\"line\":${str::from_int(line0)},\"character\":${str::from_int(char0)}}"
                        b += ",\"label\":${json::escape_string(": " + ty_str)}"
                        b += ",\"kind\":1,\"paddingLeft\":false,\"paddingRight\":true}"
                        emitted' = emitted' + 1
   b += "]"
   send_result(id_val, +b)

handle_did_open: json::Value, (String => ()) => ()
handle_did_open = params, tc_hook =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   text = json::get_str(td, "text") | s => s | ""
   uri != "" | analyze_document(uri, text, tc_hook)

handle_did_change: json::Value, (String => ()) => ()
handle_did_change = params, tc_hook =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   changes = json::get(params, "contentChanges") | v => v | json::Value(Null)
   n = json::array_len(changes)
   uri != "" && n > 0
      |
         last_change = json::array_at(changes, n - 1)
         text = json::get_str(last_change, "text") | s => s | ""
         analyze_document(uri, text, tc_hook)

handle_did_save: json::Value, (String => ()) => ()
handle_did_save = params, tc_hook =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   text_opt = json::get_str(params, "text")
   text_opt
      | text =>
         uri != "" | analyze_document(uri, text, tc_hook)
      |
         fpath = uri_to_path(uri)
         fs::read_to_string(fpath)
            | disk_text => analyze_document(uri, disk_text, tc_hook)

handle_did_close: json::Value => ()
handle_did_close = params =>
   td = json::get(params, "textDocument") | v => v | json::Value(Null)
   uri = json::get_str(td, "uri") | s => s | ""
   uri != ""
      |
         remove_doc(uri)
         publish_diagnostics(uri, diag::DiagEntries())

// --- Main LSP Event Loop ---------------------------------------------------

main: String, (String => ()) => Int
main = stdlib_dir, tc_hook =>
   log::set_fd(2)
   log::set_timestamps(<->)
   set_stdlib_dir(stdlib_dir)
   shutdown_requested' = <->
   req_arena = mem::arena(4194304)

   0.. @
      // Return 0 = continue, 1 = shutdown requested, 2 = exit loop.
      step_rc = mem::with_value(req_arena, !=>
         msg_opt = read_rpc_message!
         msg_opt
            | raw_json =>
               parsed = json::parse(raw_json)
               parsed
                  | msg =>
                     method = json::get_str(msg, "method") | m => m | ""
                     id_val = json::get(msg, "id") | v => v | json::Value(Null)
                     params = json::get(msg, "params") | v => v | json::Value(Null)
                     method
                        ["initialize"]
                           handle_initialize(id_val)
                           0
                        ["initialized"]
                           0
                        ["shutdown"]
                           send_result(id_val, "null")
                           1
                        ["exit"]
                           2
                        ["textDocument/didOpen"]
                           handle_did_open(params, tc_hook)
                           0
                        ["textDocument/didChange"]
                           handle_did_change(params, tc_hook)
                           0
                        ["textDocument/didSave"]
                           handle_did_save(params, tc_hook)
                           0
                        ["textDocument/didClose"]
                           handle_did_close(params)
                           0
                        ["textDocument/hover"]
                           handle_hover(id_val, params)
                           0
                        ["textDocument/definition"]
                           handle_definition(id_val, params)
                           0
                        ["textDocument/documentSymbol"]
                           handle_document_symbol(id_val, params)
                           0
                        ["textDocument/formatting"]
                           handle_formatting(id_val, params)
                           0
                        ["textDocument/completion"]
                           handle_completion(id_val, params)
                           0
                        ["textDocument/inlayHint"]
                           handle_inlay_hint(id_val, params)
                           0
                        |
                           // Respond with MethodNotFound (-32601) if request had an id
                           json::has(msg, "id")
                              |
                                 err_payload = "{\"jsonrpc\":\"2.0\",\"id\":" +
                                    format_id_json(id_val) +
                                    ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}"
                                 send_rpc_payload(err_payload)
                           0
                  | 0
            | 2
      )
      mem::reset(req_arena)
      step_rc == 1 | shutdown_requested' = <+>
      step_rc == 2 | -->
   mem::destroy(req_arena)
   shutdown_requested' | 0 | 0
