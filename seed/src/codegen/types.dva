// codegen/types.dva — Type lowering, GEP helpers, struct/slice/union layouts.

#use(import) ../llvm
#use ../ast
#use const
#use ../diag
#use str
#use ../tast
#use ../layout
#use ../unify
#use mem
#use sys
#use ./runtime
#use ./expr
#use ./match
#use ./stmt
#use ./main
#use log

#public

#foreign("c")
   write: (fd: Int, buf: Addr, count: Int) => Int
   dva_arena_current: () => Addr
   rename: (oldpath: String, newpath: String) => Int
   unlink: (path: String) => Int

llvm_val_opt: Addr => <Addr|>
llvm_val_opt = a => a != sys::addr_null | <+ a +> | <-->

c_str_opt: <Addr|> => String
c_str_opt = raw_opt =>
   raw_opt
      | raw =>
         b = {256}
         0.. @ i =>
            c = @[raw + i i8]
            c == 0i8 | -->
            b += c
         +b
      | ""

c_str: Addr => String
c_str = raw => c_str_opt(llvm_val_opt(raw))

dbg: String => Int
dbg = s =>
   b = {?s}
   b += s
   write(2, &b, ?b)

#private
   print: String => Int
   print = s =>
      b = {?s + 1}
      b += s
      b += 10
      write(1, &b, ?b)

#public

// --- Module Implementation -------------------------------------------------

// A named variable's LLVM width, tracked by ValueType. is_heap marks a ram-
// typed variable whose slot is a heap { tag, payload } union pointer (not a
// bare i1 flag); dtype is the declared '#type' name (for payload resolution
// in a choice); rt + fnames are a record variable's LLVM struct type and its
// named field list ("" for positional fields).
#type CgVar (name: String, vt: ast::ValueType, is_heap: <>, dtype: String,
  rt: <Addr|>, fnames: ast::Names, slot: <Addr|>, is_local: <>,
  is_partial: <>, fvts: ast::VTypes, direct: <Addr|>)
#type CgVars CgVar{}

// Binding mutability is separate from CgVar so type/layout metadata remains
// stable. is_local selects the current function scope over same-named globals.
#type BindingMut (name: String, mod_name: String, is_local: <>, mutable: <>)
#type BindingMuts BindingMut{}
#type BindingState (found: <>, mutable: <>)

// A record-typed function PARAMETER's schema, pre-passed from its first call
// site (a record ctor/literal/var arg): the LLVM struct type, the named field
// list, and the per-field ValueTypes. Used to type member reads on a param
// ("id = r => r.a") that the body alone cannot infer.
#type ParamRec (name: String, rt: Addr, fnames: ast::Names, fvts: ast::VTypes)
#type ParamRecs ParamRec{}
#type FnRetRec (name: String, rt: <Addr|>, fnames: ast::Names,
  fvts: ast::VTypes, dtype: String)
#type FnRetRecs FnRetRec{}
#type Addrs Addr{}
#type IntArr Int{}

// Definite-initialization state for forward-annotated composites: dotted
// var/field paths that are whole-initialized ("" ancestors cover descendants)
// or definitely written. Gated on a variable's is_partial flag.
#type FieldInitState (whole: ast::Names, written: ast::Names)

// One active choice's must-init tracking (the pre state each branch starts
// from, the running intersection of branch-end states, and whether the choice
// is exhaustive — no fall-through path).
#type ChoiceInitFrame (pre: FieldInitState, merged: FieldInitState,
  started: <>, exhaustive: <>)
#type ChoiceInitFrames ChoiceInitFrame{}

// A user function definition and its compiled LLVM shape.
#type FnDef (name: String, params: ast::Names, body: ast::Expr)
#type FnDefs FnDef{}
#type FnNameIndex String ^ Int
#type FnInfo (name: String, llvm_fn: <Addr|>, llvm_type: <Addr|>, nparams: Int,
  param_types: ast::VTypes, ret_vt: ast::ValueType, declared: <>,
  generic: <>, value_safe: <>, no_capture: <>)
#type FnInfos FnInfo{}

// A declared '#type' name -> its TypeInfo (for payload resolution).
#type TypeDef (name: String, ti: ast::TypeInfo, rt: <Addr|>, in_progress: <>, fnames: ast::Names)
#type TypeDefs TypeDef{}
#type TypeIndex String ^ Int

#type LambdaEnvInfo (name: String, est: Addr, nc: Int, vts: ast::VTypes)
#type LambdaEnvInfos LambdaEnvInfo{}

empty_fndef = FnDef("", ast::Names(), ast::Expr(Var, ""))

#type CtVals CtVal{}
#type CtVal <
   None
   Int(Int)
   Float(Float)
   Str(String)
   Fn(String)
   Rec(CtVals, ast::Names)
   Map(CtVals, CtVals)
>
#type CtFrame (params: ast::Names, vals: CtVals)
#type CtFrames CtFrame{}

// The codegen state: the LLVM module/builder handles, the main function, the
// variables' types, whether the last evaluated branch ended in '#exit' (so a
// phi merge can substitute a type-correct null instead of the dead block's
// placeholder value), the String/union struct + libc fn types (cached), the
// string-literal counter, the declared user type names, and the declared type
#type CodegenOpts (
   target_triple: String,
   no_runtime: <>,
   no_main: <>,
   dynamic_modules: ast::Names,
   dynamic_paths: ast::Names,
   is_shared: <>,
   compiler_exe: String,
   is_module: <>,
   module_name: String,
   fuzz_cov: <> = <->,
   no_typed_opt: <> = <->,
   optimize_closures: <> = <->,
   check_arena_escapes: <> = <->
)

default_codegen_opts: () => CodegenOpts
default_codegen_opts = !=> CodegenOpts("", <->, <->, ast::Names(),
  ast::Names(), <->, "", <->, "", <->)

#type Cg (
   module: Addr,
   builder: Addr,
   target_machine: Addr,
   main_fn: <Addr|>,
   vars: CgVars,
   exited: <>,
   str_t: Addr,
   union_t: Addr,
   slice_t: Addr,
   malloc_t: <Addr|>,
   malloc_fn: <Addr|>,
   write_t: <Addr|>,
   write_fn: <Addr|>,
   exit_t: <Addr|>,
   exit_fn: <Addr|>,
   memcmp_t: <Addr|>,
   memcmp_fn: <Addr|>,
   strn: Int,
   strvals: ast::Names,
   strglobals: Addrs,
   typedefs: TypeDefs,
   type_indices: TypeIndex,
   last_type: String,
   last_rt: <Addr|>,
   last_fnames: ast::Names,
   last_fvts: ast::VTypes,
   fns: FnDefs,
   fn_names: FnNameIndex,
   fninfos: FnInfos,
   in_fn: <>,
   in_restore_scope: Int,
   current_module: String,
   current_fn: Addr,
cycle_breaks: Addrs,
cycle_conts: Addrs,
  fn_alias_names: ast::Names,
  fn_alias_tgts: ast::Names,
  last_closure_fn: String,
  closure_vars: ast::Names,
  closure_tgts: ast::Names,
  param_clo_names: ast::Names,
param_clo_tys: Addrs,
  param_clo_rets: ast::VTypes,
  param_recs: ParamRecs,
  param_arr_names: ast::Names,
  param_sl_names: ast::Names,
  thread_rec_t: <Addr|>,
  pthread_create_fn: <Addr|>,
  pthread_join_fn: <Addr|>,
  pthread_exit_fn: <Addr|>,
  thread_tls_rec: <Addr|>,
  thread_n: Int,
  builder_t: <Addr|>,
  closure_t: <Addr|>,
  init: FieldInitState,
  choice_frames: ChoiceInitFrames,
  bindings: BindingMuts,
  error: <>,
  escape_bb: <Addr|>,
  discard_result: <>,
  noncap_names: ast::Names,
  noncap_globs: Addrs,
  source_file: String,
  fn_var_start: Int,
  fn_binding_start: Int,
  opts: CodegenOpts,
   has_closure_dispatch: <> = <->
)

#type Flags <>{}
#type FnValueMeta (found: <>, declared: <>, generic: <>, value_safe: <>)

#type GlobalState (
   tmpc: Int,
   pstmts: ast::Exprs,
   typed_program_stmts: tast::TypedStmts,
   is_typed_pipeline: <>,
   pexports: ast::Names,
   alloc_rec_names: ast::Names,
   view_var_names: ast::Names,
   foreign_fn_names: ast::Names,
   foreign_i32_params: ast::Names,
   fn_ret_recs: FnRetRecs,
   fn_ret_fn_names: ast::Names,
   fn_ret_fn_tgts: ast::Names,
   user_fn_seen: ast::Names,
   expected_fn_ti: ast::TypeInfo,
   fn_ret_ll: <Addr|>,
   last_compiling_fn: String,
   ct_bind_names: ast::Names,
   ct_bind_tis: ast::VInfos,
   ct_bind_dnames: ast::Names,
   ct_cursor_names: ast::Names,
   ct_cursor_tis: ast::VInfos,
   ct_cursor_idxs: IntArr,
   ct_val_names: ast::Names,
   ct_val_vals: CtVals,
   marked_globals: ast::Names,
   restore_scope_var_starts: IntArr,
   lambda_env_infos: LambdaEnvInfos,
   targets_initialized: <>,
   cov_edge_seq: Int = 1,
   stack_alloc_next: <> = <->,
   stack_closure_next: <> = <->,
   current_fn_body: <tast::TypedExpr|> = <-->,
   current_fn_params: ast::Names = ast::Names(),
   fast_freeze_builders: ast::Names = ast::Names(),
   unboxed_ret_tail: Int = 0,
   current_fn_has_restore: <> = <->,
   inline_ret_bb: Addr = sys::addr_null,
   inline_ret_slot: Addr = sys::addr_null,
   validated_str_vals: Addrs = Addrs(),
   escape_check_depth: Int = 0
)

::g = GlobalState(
   0, ast::Exprs(), tast::TypedStmts(), <->, ast::Names(),
   ast::Names(), ast::Names(), ast::Names(), ast::Names(),
   types::FnRetRecs(), ast::Names(), ast::Names(), ast::Names(),
   ast::TypeInfo(Prim, ast::ValueType(Unknown)), <--> , "",
   ast::Names(), ast::VInfos(), ast::Names(),
   ast::Names(), ast::VInfos(), types::IntArr(),
   ast::Names(), types::CtVals(),
   ast::Names(), types::IntArr(), types::LambdaEnvInfos(), <->, 1,
   <->, <->, <-->, ast::Names(), ast::Names(), 0, <->,
   sys::addr_null, sys::addr_null, types::Addrs(), 0)

// Value-Range Analysis (VRA) lattice and per-module state.
// state: 0 = Bottom (unseen), 1 = Bounded [lo, hi], 2 = Top (unbounded).
#type VraRange (state: Int, lo: Int, hi: Int)
#type VraRanges VraRange{}
#type VraIndex String ^ Int
#type VraLocal (name: String, rng: VraRange)
#type VraLocals VraLocal{}
#type BoundedStrIdx (idx_var: String, str_var: String)
#type BoundedStrIdxs BoundedStrIdx{}
#type LenVarEntry (len_var: String, str_var: String)
#type LenVarEntries LenVarEntry{}
#type NamedShapeMeta (shape_key: String, anon_sig: String, field_names: ast::Names)
#type NamedShapeMetas NamedShapeMeta{}

// Reusable Function Effect Summary (DVA-102, generalized in DVA-105):
// - may_arena_effect: function may directly or transitively restore, reset, release,
//   destroy, switch (set_current), or enter a with/escape arena scope.
// - may_read_global / may_write_global: function may read or mutate global state.
// - param_str_read_only_mask: bit i is 1 if parameter i (i < 62) is only used in
//   non-escaping, non-mutating String read positions.
// - param_rec_proj_only_mask: bit i is 1 if parameter i (i < 62) is only field-projected
//   without escaping or address-taking.
// - param_mutated_mask: bit i is 1 if parameter i (i < 62) is mutated via member/index/raw write.
// - param_invoked_mask: bit i is 1 if parameter i (i < 62) is invoked as a callback.
// - param_escapes_mask: bit i is 1 if parameter i (i < 62) may escape (returned, stored to
//   global/outer state, or passed to an escaping/unknown sink).
// - param_ret_alias_mask: bit i is 1 if parameter i (i < 62) may alias the function's return value.
// - param_retained_mask: bit i is 1 if parameter i (i < 62) may be retained after the call returns
//   (stored into global/outer state, captured by an escaping closure, or written into another parameter).
#type FnEffectSummary (
   name: String,
   nparams: Int,
   has_body: <>,
   may_arena_effect: <>,
   may_read_global: <>,
   may_write_global: <>,
   param_str_read_only_mask: Int,
   param_rec_proj_only_mask: Int,
   param_mutated_mask: Int,
   param_invoked_mask: Int,
   param_escapes_mask: Int,
   param_ret_alias_mask: Int = 0,
   param_retained_mask: Int = 0
)
#type FnEffectSummaries FnEffectSummary{}
#type FnBodyEntry (
   name: String,
   params: ast::Names,
   body: tast::TypedExpr,
   fn_ti: ast::TypeInfo
)
#type FnBodyEntries FnBodyEntry{}
#type FnEffectState (
   ready: <>,
   idx: VraIndex,
   summaries: FnEffectSummaries,
   entries: FnBodyEntries
)

::fneff = FnEffectState(
   <->, VraIndex(), FnEffectSummaries(), FnBodyEntries()
)

// Codegen Phase Timings in nanoseconds (DVA-104):
// - analysis_ns: time spent in codegen pre-lowering analyses (closure/record/array scans,
//   whole-TU FnEffectSummary fixed-point solver, and VRA)
// - ir_emit_ns: time spent emitting LLVM IR instructions and writing the .ll file
#type CodegenPhaseTimings (
   analysis_ns: Int,
   ir_emit_ns: Int
)

::cg_timings = CodegenPhaseTimings(0, 0)

#type VraState (
   enabled: <>,
   whole_prog: <>,
   changed: <>,
   skip_bot_params: <>,
   in_narrow: <>,
   cur_fn_name: String,
   field_idx: VraIndex,
   field_rngs: VraRanges,
   anon_idx: VraIndex,
   anon_rngs: VraRanges,
   named_shapes: NamedShapeMetas,
   named_shape_keys: ast::Names,
   poison_shapes: ast::Names,
   param_idx: VraIndex,
   param_rngs: VraRanges,
   fn_ret_idx: VraIndex,
   fn_ret_rngs: VraRanges,
   poison_fns: ast::Names,
   locals: VraLocals,
   cur_muts: ast::Names,
   bounded_idxs: BoundedStrIdxs,
   len_vars: LenVarEntries,
   snap_field_rngs: VraRanges,
   snap_anon_rngs: VraRanges,
   snap_param_rngs: VraRanges,
   snap_fn_ret_rngs: VraRanges
)

::vra = VraState(
   <->, <->, <->, <->, <->, "",
   VraIndex(), VraRanges(), VraIndex(), VraRanges(),
   NamedShapeMetas(), ast::Names(), ast::Names(),
   VraIndex(), VraRanges(), VraIndex(), VraRanges(), ast::Names(),
   VraLocals(), ast::Names(), BoundedStrIdxs(), LenVarEntries(),
   VraRanges(), VraRanges(), VraRanges(), VraRanges()
)

emit_cov_edge: Cg => ()
emit_cov_edge = cg =>
   cg.opts.fuzz_cov && cg.current_module != "test"
      |
         cur_bb = LLVMGetInsertBlock(cg.builder)
         has_bb = cur_bb != sys::addr_null && !<>(llvm_val_opt(LLVMGetBasicBlockTerminator(cur_bb)))
         has_bb
            |
               edge_id = g.cov_edge_seq
               g.cov_edge_seq = ((edge_id + 1) .&. 65535) + 1
               fn = LLVMGetNamedFunction(cg.module, "dva_cov_trace")
               fn != sys::addr_null
                  |
                     i64t = LLVMInt64Type!
                     ft = fn_type1(LLVMVoidType!, i64t)
                     call1(cg, ft, fn, LLVMConstInt(i64t, edge_id, 0), "")

inc_tmpc: () => Int
inc_tmpc = !=>
   c = g.tmpc
   g.tmpc = c + 1
   c

// --- definite-init helpers ---------------------------------------------------

// The dotted field path of a member target whose ROOT is a variable: "a" for
// "x.a", "y.a" for "x.y.a". A helper (the member's target chain is walked).
member_fpath: ast::MemberExpr => String
member_fpath = m =>
   m.target [Member inner] (member_fpath(inner) + "." + m.field_name) | m.field_name

has_str: ast::Names, String => <>
has_str = arr, s => has_str_at(arr, s, 0, ?arr)

has_str_at: ast::Names, String, Int, Int => <>
has_str_at = arr, s, i, n =>
   i == n
      | <->
      |
         v = arr(i) | _ | ""
         v == s | <+> | has_str_at(arr, s, i + 1, n)

has_dcolon_step: String, Int => <>
has_dcolon_step = s, i =>
   i + 1 < ?s
      |
         (s(i) == ': && s(i + 1) == ':)
            | <+>
            | has_dcolon_step(s, i + 1)
      | <->

has_dcolon: String => <>
has_dcolon = s => has_dcolon_step(s, 0)

has_dcolon_hash: String, Int => <>
has_dcolon_hash = s, i =>
   i + 2 < ?s
      |
         (s(i) == ': && s(i + 1) == ': && s(i + 2) == '#)
            | <+>
            | has_dcolon_hash(s, i + 1)
      | <->

name_is_private: String => <>
name_is_private = s =>
   (?s > 0 && s(0) == '#) || has_dcolon_hash(s, 0)

name_is_in_current_module: Cg, String => <>
name_is_in_current_module = cg, name =>
   cg.opts.is_module
      |
         cg.opts.module_name == ""
            | !has_dcolon(name)
            |
               pfx = cg.opts.module_name + "::"
               lp = ?pfx
               ?name !< lp && name(..lp) == pfx
      | <+>

has_dollar_step: String, Int => <>
has_dollar_step = s, i =>
   i < ?s
      | (s(i) == '$ | <+> | has_dollar_step(s, i + 1))
      | <->

has_dollar: String => <>
has_dollar = s => has_dollar_step(s, 0)

is_external_module_name: Cg, String => <>
is_external_module_name = cg, name =>
   !has_dollar(name) && has_dcolon(name) && cg.opts.is_module && !name_is_in_current_module(cg, name)

fninfo_index_rev: Cg, String, Int => <Int|>
fninfo_index_rev = cg, name, i =>
   i < 0
      | <-->
      |
         fi = cg.fninfos(i)!!
         fi.name == name
            | <+ i +>
            | fninfo_index_rev(cg, name, i - 1)

fninfo_index: Cg, String => <Int|>
fninfo_index = cg, name =>
   fninfo_index_rev(cg, name, ?cg.fninfos - 1)

fninfo_find: Cg, String => <FnInfo|>
fninfo_find = cg, name =>
   fninfo_find_rev(cg, name, ?cg.fninfos - 1)

fninfo_find_rev: Cg, String, Int => <FnInfo|>
fninfo_find_rev = cg, name, i =>
   i < 0
      | <-->
      |
         fi = cg.fninfos(i)!!
         fi.name == name
            | <+ fi +>
            | fninfo_find_rev(cg, name, i - 1)

// Marks `path` (a dotted var/field path, e.g. "x" or "x.a") whole-initialized.
init_mark_whole: Cg, String => ()
init_mark_whole = cg, path =>
   !has_str(cg.init.whole, path) | init_whole_add(cg, path)

init_whole_add: Cg, String => ()
init_whole_add = cg, path =>
   cg.init.whole += ++path

// Marks `path` definitely written.
init_mark_written: Cg, String => ()
init_mark_written = cg, path =>
   !has_str(cg.init.written, path) | init_written_add(cg, path)

init_written_add: Cg, String => ()
init_written_add = cg, path =>
   cg.init.written += ++path

// True if variable `name` has already had its record chunk allocated.
alloc_rec_has: String => <>
alloc_rec_has = name =>
   has_str(g.alloc_rec_names, name)

alloc_rec_add: String => ()
alloc_rec_add = name =>
   g.alloc_rec_names += ++name

is_view_var: String => <>
is_view_var = name =>
   has_str(g.view_var_names, name)

view_var_add: String => ()
view_var_add = name =>
   g.view_var_names += ++name

choice_has_view: Cg, ast::Branches, Int => <>
choice_has_view = cg, bs, i =>
   i < ?bs && (is_view_expr(cg, (bs(i)!!).block) ||
     choice_has_view(cg, bs, i + 1))

is_view_expr: Cg, ast::Expr => <>
is_view_expr = cg, e =>
   e
      [Var v] is_view_var(v)
      [RawMemory rm] rm.rec_name != ""
      [Block b] ?b > 0 && is_view_expr(cg, b(?b - 1)!!)
      [Choice c] choice_has_view(cg, c.branches, 0)
      | <->

// A substring of a String's bytes [start, start+len).
substr: String, Int, Int => String
substr = s, start, n =>
   b = {n}
   n @ i =>
      b += s(start + i)
   +b

// "a.b.c" -> "a.b"; "" if there is no dot.
find_last_dot_at: String, Int => <Int|>
find_last_dot_at = path, i =>
   i < 0
      | <-->
      |
         path(i) == 46
            | <+ i +>
            | find_last_dot_at(path, i - 1)

drop_last_dot: String => String
drop_last_dot = path =>
   find_last_dot_at(path, ?path - 1)
      | cut =>
         cut > 0
            | substr(path, 0, cut)
            | ""
      | ""

// Whether a read of `path` is OK: the var or any ancestor is whole, or the
// exact path was written.
init_ok_walk: FieldInitState, String => <>
init_ok_walk = s, p =>
   p == ""
      | <->
      |
         init_has_whole(s, p)
            | <+>
            | init_ok_walk(s, drop_last_dot(p))

init_ok: FieldInitState, String => <>
init_ok = s, path =>
   init_ok_walk(s, path) || init_has_written(s, path)

init_has_whole: FieldInitState, String => <>
init_has_whole = s, path => init_has_whole_rec(s, 0, path)

init_has_whole_rec: FieldInitState, Int, String => <>
init_has_whole_rec = s, i, path =>
   (i < ?s.whole)
      |
         s.whole(i)!! == path | <+> | init_has_whole_rec(s, i + 1, path)
      | <->

init_has_written: FieldInitState, String => <>
init_has_written = s, path => init_has_written_rec(s, 0, path)

init_has_written_rec: FieldInitState, Int, String => <>
init_has_written_rec = s, i, path =>
   (i < ?s.written)
      |
         s.written(i)!! == path | <+> | init_has_written_rec(s, i + 1, path)
      | <->

copy_names_at: ast::Names, Int, Int, ast::Names => ast::Names
copy_names_at = src, i, n, acc =>
   i == n
      | acc
      |
         acc += (src(i) | _ | "")
         copy_names_at(src, i + 1, n, acc)

// A deep copy of an init state (for choice snapshot/restore).
init_snapshot: FieldInitState => FieldInitState
init_snapshot = s =>
   ws = copy_names_at(s.whole, 0, ?s.whole, ast::Names())
   ws2 = copy_names_at(s.written, 0, ?s.written, ast::Names())
   FieldInitState(ws, ws2)

init_merge_whole_at: ast::Names, FieldInitState, Int, Int, ast::Names => ast::Names
init_merge_whole_at = whole, b, i, n, acc =>
   i == n
      | acc
      |
         k = (whole(i) | _ | "")
         init_has_whole(b, k) | acc += k
         init_merge_whole_at(whole, b, i + 1, n, acc)

init_merge_written_at: ast::Names, FieldInitState, Int, Int, ast::Names => ast::Names
init_merge_written_at = written, b, i, n, acc =>
   i == n
      | acc
      |
         k = (written(i) | _ | "")
         init_has_written(b, k) | acc += k
         init_merge_written_at(written, b, i + 1, n, acc)

// Must-init merge: a path is definite only when in BOTH states.
init_merge: FieldInitState, FieldInitState => FieldInitState
init_merge = a, b =>
   ws = init_merge_whole_at(a.whole, b, 0, ?a.whole, ast::Names())
   ws2 = init_merge_written_at(a.written, b, 0, ?a.written, ast::Names())
   FieldInitState(ws, ws2)

// Reports a definite-init violation and marks the compile failed.
init_error: Cg, String, String, Int, Int => ()
init_error = cg, code, msg, line, col =>
   fn = ?cg.source_file > 0 | cg.source_file + ":" | ""
   pos = line > 0 | str::from_int(line) + ":" + str::from_int(col) + ": " | ""
   log::error(fn + pos + code + ": " + msg)
   cg.error = <+>

// Whether a partial composite is safe to pass by reference: whole-initialized,
// or every named field is written. Recursive (a '@' cycle's arena restore
// would reap the field-name array mid-scan).
init_fully_ok: Cg, String => <>
init_fully_ok = cg, vname =>
   init_has_whole(cg.init, vname)
      | <+>
      | init_fully_rec(cg, vname, 0, var_fnames(cg, vname))

init_fully_rec: Cg, String, Int, ast::Names => <>
init_fully_rec = cg, vname, i, fns =>
   (i < ?fns)
      |
         key = ++(vname + "." + fns(i)!!)
         init_has_written(cg.init, key)
            | init_fully_rec(cg, vname, i + 1, fns)
            | <->
      | <+>

// Rejects passing a partially-initialized composite as an argument (E3132).
init_check_escape: Cg, ast::Expr, Int, Int => ()
init_check_escape = cg, arg, line, col =>
   arg
      [Var v] init_check_escape_var(cg, v, line, col)

init_check_escape_var: Cg, String, Int, Int => ()
init_check_escape_var = cg, v, line, col =>
   main::var_partial(cg, v)
      | init_check_escape_full(cg, v, line, col)

init_check_escape_full: Cg, String, Int, Int => ()
init_check_escape_full = cg, v, line, col =>
   !init_fully_ok(cg, v)
      | init_error(cg, "E3132", diag::partial_composite_argument(v), line, col)

// This ordered pre-pass runs before user function bodies compile. That matters
// for `f(t)`: a bad member access in f's body must not hide the caller-side
// E3132 for a partially initialized t.
codegen_scan_partial_escapes: Cg, ast::Exprs => ()
codegen_scan_partial_escapes = cg, stmts =>
   codegen_scan_partial_escape_stmts(cg, stmts, 0)

codegen_scan_partial_escape_stmts: Cg, ast::Exprs, Int => ()
codegen_scan_partial_escape_stmts = cg, stmts, i =>
   i < ?stmts
      |
         codegen_scan_partial_escape_expr(cg, stmts(i)!!)
         codegen_scan_partial_escape_stmts(cg, stmts, i + 1)

codegen_scan_partial_escape_exprs: Cg, ast::Exprs, Int => ()
codegen_scan_partial_escape_exprs = cg, es, i =>
   i < ?es
      |
         codegen_scan_partial_escape_expr(cg, es(i)!!)
         codegen_scan_partial_escape_exprs(cg, es, i + 1)

codegen_scan_partial_escape_expr: Cg, ast::Expr => ()
codegen_scan_partial_escape_expr = cg, e =>
   e
      [Assign t] codegen_scan_partial_escape_assign(cg, t)
      [Bin t]
         codegen_scan_partial_escape_expr(cg, t.1)
         codegen_scan_partial_escape_expr(cg, t.2)
      [Call c]
         c.args @ a => init_check_escape(cg, a, c.line, c.col)
         codegen_scan_partial_escape_exprs(cg, c.args, 0)
      [Block b] codegen_scan_partial_escape_exprs(cg, b, 0)
      [Member m]
         codegen_scan_partial_escape_expr(cg, m.target)
         codegen_scan_partial_escape_expr(cg, m.index_expr)

codegen_scan_partial_escape_assign: Cg,
  (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_scan_partial_escape_assign = cg, t =>
   t.6
      [Member m] codegen_scan_partial_write(cg, m)
   !runtime::rhs_is_fn(t) | codegen_scan_partial_escape_expr(cg, t.5)

codegen_scan_partial_write: Cg, ast::MemberExpr => ()
codegen_scan_partial_write = cg, m =>
   m.target
      [Var v]
         main::var_partial(cg, v)
            | init_mark_written(cg, v + "." + member_fpath(m))

// --- choice must-init tracking -----------------------------------------------

choice_enter: Cg, <> => ()
choice_enter = cg, exhaustive =>
   cg.choice_frames += ChoiceInitFrame(init_snapshot(cg.init),
     FieldInitState(ast::Names(), ast::Names()), <->, exhaustive)

choice_branch_reset: Cg => ()
choice_branch_reset = cg =>
   (?cg.choice_frames > 0)
      |
         fr = cg.choice_frames(?cg.choice_frames - 1)!!
         cg.init = init_snapshot(fr.pre)

choice_branch_capture: Cg => ()
choice_branch_capture = cg =>
   (?cg.choice_frames > 0)
      |
         i = ?cg.choice_frames - 1
         fr = cg.choice_frames(i)!!
         fr.started
            | choice_frame_set(cg, i, ChoiceInitFrame(fr.pre,
              init_merge(fr.merged, cg.init), fr.started, fr.exhaustive))
            | choice_frame_set(cg, i, ChoiceInitFrame(fr.pre,
              init_snapshot(cg.init), <+>, fr.exhaustive))

choice_leave: Cg => ()
choice_leave = cg =>
   (?cg.choice_frames > 0)
      |
         i = ?cg.choice_frames - 1
         fr = cg.choice_frames(i)!!
         merged' = fr.merged
         !fr.started | merged' = init_snapshot(fr.pre)
         !fr.exhaustive | merged' = init_merge(merged', fr.pre)
         cg.init = merged'
         choice_frame_pop(cg, i)

choice_frame_set_at: ChoiceInitFrames, Int, ChoiceInitFrame, Int, Int, ChoiceInitFrames => ChoiceInitFrames
choice_frame_set_at = frames, at, fr, j, n, acc =>
   j == n
      | acc
      |
         j == at | acc += fr | acc += frames(j)!!
         choice_frame_set_at(frames, at, fr, j + 1, n, acc)

choice_frame_set: Cg, Int, ChoiceInitFrame => ()
choice_frame_set = cg, i, fr =>
   cg.choice_frames = choice_frame_set_at(cg.choice_frames, i, fr, 0,
     ?cg.choice_frames, ChoiceInitFrames())

choice_frame_pop_at: ChoiceInitFrames, Int, Int, Int, ChoiceInitFrames => ChoiceInitFrames
choice_frame_pop_at = frames, at, j, n, acc =>
   j == n
      | acc
      |
         j != at | acc += frames(j)!!
         choice_frame_pop_at(frames, at, j + 1, n, acc)

choice_frame_pop: Cg, Int => ()
choice_frame_pop = cg, i =>
   cg.choice_frames = choice_frame_pop_at(cg.choice_frames, i, 0,
     ?cg.choice_frames, ChoiceInitFrames())

// --- LLVM pointer-to-array-arg helpers ----------------------------------------
// The LLVM C API takes pointer-to-array args (`^LLVMTypeRef` etc.) where Dva
// has no record-buffer-address primitive for yet; store the words through a
// Builder's buffer and pass the buffer address.

// struct { e0, e1 }
struct_type2: Addr, Addr => Addr
struct_type2 = e0, e1 =>
   tarr = (e0, e1)
   LLVMStructType(&tarr, 2, 0)

// fn type ret() (zero params)
fn_type0: Addr => Addr
fn_type0 = ret =>
   parr = {8}
   sb = &parr
   LLVMFunctionType(ret, sb, 0, 0)

// fn type ret(p0)
fn_type1: Addr, Addr => Addr
fn_type1 = ret, p0 =>
   parr = (p0, p0)
   LLVMFunctionType(ret, &parr, 1, 0)

// fn type ret(p0, p1, p2)
fn_type3: Addr, Addr, Addr, Addr => Addr
fn_type3 = ret, p0, p1, p2 =>
   parr = (p0, p1, p2)
   LLVMFunctionType(ret, &parr, 3, 0)

// GEP2 with a single index value.
gep1: Cg, Addr, Addr, Addr, String => Addr
gep1 = cg, elem_t, base, idx, name =>
   idxarr = (idx, idx)
   LLVMBuildGEP2(cg.builder, elem_t, base, &idxarr, 1, name)

// GEP2 with two index values (an array element through a struct field).
gep2: Cg, Addr, Addr, Addr, Addr, String => Addr
gep2 = cg, elem_t, base, i0, i1, name =>
   idxarr = (i0, i1)
   LLVMBuildGEP2(cg.builder, elem_t, base, &idxarr, 2, name)

// BuildCall2 with zero arguments.
call0: Cg, Addr, Addr, String => Addr
call0 = cg, fty, fn, name =>
   LLVMBuildCall2(cg.builder, fty, fn, sys::addr_null, 0, name)

// BuildCall2 with one argument.
call1: Cg, Addr, Addr, Addr, String => Addr
call1 = cg, fty, fn, arg, name =>
   args = (arg, arg)
   LLVMBuildCall2(cg.builder, fty, fn, &args, 1, name)

// BuildCall2 with three arguments.
call3: Cg, Addr, Addr, Addr, Addr, Addr, String => Addr
call3 = cg, fty, fn, a0, a1, a2, name =>
   args = (a0, a1, a2)
   LLVMBuildCall2(cg.builder, fty, fn, &args, 3, name)

// Marshal a dynamic Addrs array into a raw C pointer array buffer for the LLVM C API.
addrs_buf: Addrs => Builder
addrs_buf = xs =>
   n = ?xs
   cap = n > 0 | n * 8 | 8
   buf = {cap}
   sb = &buf
   n @ i =>
      @[sb + i * 8] = xs(i)!!
   buf

// An LLVM struct type from a list of field LLVM types (dynamic arity, via a
// raw buffer — the C API's pointer-to-array arg).
struct_type_n: Cg, Addrs, Int => Addr
struct_type_n = cg, types, n =>
   LLVMStructType(&addrs_buf(types), n, 0)

struct_type_packed_n: Cg, Addrs, Int, <> => Addr
struct_type_packed_n = cg, types, n, is_packed =>
   p_flag = is_packed | 1 | 0
   LLVMStructType(&addrs_buf(types), n, p_flag)

// An alloca hoisted into the current function's entry block (so it dominates
// every use), leaving the builder position untouched.
hoisted_alloca: Cg, Addr, String => Addr
hoisted_alloca = cg, ty, name =>
   entry = LLVMGetEntryBasicBlock(cg.current_fn)
   saved_opt = llvm_val_opt(LLVMGetInsertBlock(cg.builder))
   first_opt = llvm_val_opt(LLVMGetFirstInstruction(entry))
   first_opt
      | first => LLVMPositionBuilderBefore(cg.builder, first)
      | LLVMPositionBuilderAtEnd(cg.builder, entry)
   a = LLVMBuildAlloca(cg.builder, ty, name)
   saved_opt | saved => LLVMPositionBuilderAtEnd(cg.builder, saved)
   a

// A variable's storage slot: a function-local alloca, or a named global.
create_slot: Cg, String, Addr, <> => Addr
create_slot = cg, name, llvm_type, is_local =>
   is_local
      |
         ast::is_cell_var(name)
            |
               sz = LLVMSizeOf(llvm_type)
               raw = expr::codegen_call_arena_alloc(cg, sz, "cell." + name)
               LLVMBuildPointerCast(cg.builder, raw,
                 LLVMPointerType(llvm_type, 0), "cell." + name + ".ptr")
            | hoisted_alloca(cg, llvm_type, "var." + name)
      | codegen_get_global(cg, name, llvm_type)

// The target data layout / triple (host x86-64), mirroring codegen_init.

codegen_init_targets: () => ()
codegen_init_targets = !=>
   !g.targets_initialized
      |
         g.targets_initialized = <+>
         LLVMInitializeAArch64Target!
         LLVMInitializeAArch64TargetInfo!
         LLVMInitializeAArch64TargetMC!
         LLVMInitializeAArch64AsmPrinter!
         LLVMInitializeAMDGPUTarget!
         LLVMInitializeAMDGPUTargetInfo!
         LLVMInitializeAMDGPUTargetMC!
         LLVMInitializeAMDGPUAsmPrinter!
         LLVMInitializeARMTarget!
         LLVMInitializeARMTargetInfo!
         LLVMInitializeARMTargetMC!
         LLVMInitializeARMAsmPrinter!
         LLVMInitializeAVRTarget!
         LLVMInitializeAVRTargetInfo!
         LLVMInitializeAVRTargetMC!
         LLVMInitializeAVRAsmPrinter!
         LLVMInitializeBPFTarget!
         LLVMInitializeBPFTargetInfo!
         LLVMInitializeBPFTargetMC!
         LLVMInitializeBPFAsmPrinter!
         LLVMInitializeHexagonTarget!
         LLVMInitializeHexagonTargetInfo!
         LLVMInitializeHexagonTargetMC!
         LLVMInitializeHexagonAsmPrinter!
         LLVMInitializeLanaiTarget!
         LLVMInitializeLanaiTargetInfo!
         LLVMInitializeLanaiTargetMC!
         LLVMInitializeLanaiAsmPrinter!
         LLVMInitializeLoongArchTarget!
         LLVMInitializeLoongArchTargetInfo!
         LLVMInitializeLoongArchTargetMC!
         LLVMInitializeLoongArchAsmPrinter!
         LLVMInitializeMipsTarget!
         LLVMInitializeMipsTargetInfo!
         LLVMInitializeMipsTargetMC!
         LLVMInitializeMipsAsmPrinter!
         LLVMInitializeMSP430Target!
         LLVMInitializeMSP430TargetInfo!
         LLVMInitializeMSP430TargetMC!
         LLVMInitializeMSP430AsmPrinter!
         LLVMInitializeNVPTXTarget!
         LLVMInitializeNVPTXTargetInfo!
         LLVMInitializeNVPTXTargetMC!
         LLVMInitializeNVPTXAsmPrinter!
         LLVMInitializePowerPCTarget!
         LLVMInitializePowerPCTargetInfo!
         LLVMInitializePowerPCTargetMC!
         LLVMInitializePowerPCAsmPrinter!
         LLVMInitializeRISCVTarget!
         LLVMInitializeRISCVTargetInfo!
         LLVMInitializeRISCVTargetMC!
         LLVMInitializeRISCVAsmPrinter!
         LLVMInitializeSparcTarget!
         LLVMInitializeSparcTargetInfo!
         LLVMInitializeSparcTargetMC!
         LLVMInitializeSparcAsmPrinter!
         LLVMInitializeSystemZTarget!
         LLVMInitializeSystemZTargetInfo!
         LLVMInitializeSystemZTargetMC!
         LLVMInitializeSystemZAsmPrinter!
         LLVMInitializeVETarget!
         LLVMInitializeVETargetInfo!
         LLVMInitializeVETargetMC!
         LLVMInitializeVEAsmPrinter!
         LLVMInitializeWebAssemblyTarget!
         LLVMInitializeWebAssemblyTargetInfo!
         LLVMInitializeWebAssemblyTargetMC!
         LLVMInitializeWebAssemblyAsmPrinter!
         LLVMInitializeX86Target!
         LLVMInitializeX86TargetInfo!
         LLVMInitializeX86TargetMC!
         LLVMInitializeX86AsmPrinter!
         LLVMInitializeXCoreTarget!
         LLVMInitializeXCoreTargetInfo!
         LLVMInitializeXCoreTargetMC!
         LLVMInitializeXCoreAsmPrinter!
         0

// Fallback layout (host x86-64).
codegen_layout: String
codegen_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

// Create the module + builder, pin the target triple/data layout, and declare
// the String struct type + the malloc/memcmp libc functions.
codegen_init: CodegenOpts => Cg
codegen_init = opts =>
   codegen_init_targets!
   module = LLVMModuleCreateWithName("dva_module")
   target_triple = opts.target_triple
   triple = ?target_triple > 0
      | target_triple
      |
         def_raw = LLVMGetDefaultTargetTriple!
         def_s = c_str(def_raw)
         LLVMDisposeMessage(def_raw)
         def_s
   LLVMSetTarget(module, triple)
   layout::set_target_triple(triple)
   target_raw' = 0
   err_raw' = 0
   res = LLVMGetTargetFromTriple(triple, &target_raw', &err_raw')
   tm = res == 0
      | LLVMCreateTargetMachine(Addr(target_raw'), triple, "", "", 2, 0, 0)
      | sys::addr_null
   layout = tm != sys::addr_null
      |
         td = LLVMCreateTargetDataLayout(tm)
         raw_l = LLVMCopyStringRepOfTargetData(td)
         l_str = c_str(raw_l)
         LLVMDisposeMessage(raw_l)
         LLVMDisposeTargetData(td)
         l_str
      |
         err_ptr_opt = llvm_val_opt(Addr(err_raw'))
         err_s = c_str_opt(err_ptr_opt)
         log::error $ "E3069: No LLVM target registered for triple '" + triple + "'" +
           (?err_s > 0 | ": " + err_s | "")
         err_ptr_opt | err_ptr => LLVMDisposeMessage(err_ptr)
         codegen_layout
   LLVMSetDataLayout(module, layout)
   builder = LLVMCreateBuilder!
   i64t = LLVMInt64Type!
   i32t = LLVMInt32Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   st = struct_type2(i64t, i8p)
   ut = struct_type2(i64t, i8p)
   st2 = struct_type2(i8p, i64t)
   eff_opts = CodegenOpts(triple, opts.no_runtime, opts.no_main,
     opts.dynamic_modules, opts.dynamic_paths, opts.is_shared,
     opts.compiler_exe, opts.is_module, opts.module_name, opts.fuzz_cov,
     opts.no_typed_opt, opts.optimize_closures, opts.check_arena_escapes)
   Cg(module, builder, tm, <-->, CgVars(), <->, st, ut, st2,
     <-->, <-->, <-->, <-->, <-->, <-->, <-->, <-->,
     0, ast::Names(), Addrs(), TypeDefs(), TypeIndex(), "", <-->,
     ast::Names(),
     ast::VTypes(), FnDefs(), FnNameIndex(), FnInfos(), <->, 0, "", sys::addr_null,
     Addrs(), Addrs(), ast::Names(), ast::Names(), "", ast::Names(),
     ast::Names(), ast::Names(), Addrs(), ast::VTypes(), ParamRecs(),
     ast::Names(), ast::Names(), <-->, <-->, <-->, <-->,
     <-->, 0, <-->, <-->,
     FieldInitState(ast::Names(), ast::Names()),
     ChoiceInitFrames(), BindingMuts(), <->, <-->, <->, ast::Names(),
     Addrs(), "", 0, 0, eff_opts)

// Define "i32 @main(i32, ptr)" or void @__dva_global_init().
codegen_build_main: Cg => Addr
codegen_build_main = cg =>
   cg.opts.no_main
      |
         fnty' = fn_type0(LLVMVoidType!)
         init_fn_name = cg.opts.is_module && cg.opts.module_name != ""
            | "__dva_global_init_" + cg.opts.module_name
            | "__dva_global_init"
         fn' = LLVMAddFunction(cg.module, init_fn_name, fnty')
         LLVMSetLinkage(fn', 8)
         runtime::mark_nounwind(cg, fn')
         entry' = LLVMAppendBasicBlock(fn', "entry")
         LLVMPositionBuilderAtEnd(cg.builder, entry')
         cg.main_fn = <+ fn' +>
         cg.current_fn = fn'
         !cg.opts.no_runtime && !cg.opts.is_module | emit_arena_init(cg)
         fn'
      |
         i32t = LLVMInt32Type!
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         ptypes = Addrs()
         ptypes += i32t
         ptypes += i8p
         fnty' = stmt::fn_type_n(cg, i32t, ptypes, 2)
         fn' = LLVMAddFunction(cg.module, "main", fnty')
         runtime::mark_nounwind(cg, fn')
         entry' = LLVMAppendBasicBlock(fn', "entry")
         LLVMPositionBuilderAtEnd(cg.builder, entry')
         cg.main_fn = <+ fn' +>
         cg.current_fn = fn'
         !cg.opts.no_runtime
            |
               argc_p = LLVMGetParam(fn', 0)
               argv_p = LLVMGetParam(fn', 1)
               argc_g = LLVMAddGlobal(cg.module, LLVMInt64Type!, "sys_argc_global")
               LLVMSetInitializer(argc_g, LLVMConstInt(LLVMInt64Type!, 0, 0))
               argv_g = LLVMAddGlobal(cg.module, i8p, "sys_argv_global")
               LLVMSetInitializer(argv_g, LLVMConstNull(i8p))
               argc64 = LLVMBuildSExt(cg.builder, argc_p, LLVMInt64Type!, "argc.i64")
               LLVMBuildStore(cg.builder, argc64, argc_g)
               LLVMBuildStore(cg.builder, argv_p, argv_g)
               emit_arena_init(cg)
         fn'

// call void @dva_arena_init(ptr @global_arena, i64 1048576) in main's entry.
emit_arena_init: Cg => Addr
emit_arena_init = cg =>
   at = runtime::arena_type(cg)
   atp = LLVMPointerType(at, 0)
   i64t = LLVMInt64Type!
   init_t = fn_type2(cg, LLVMVoidType!, atp, i64t)
   init_fn = LLVMGetNamedFunction(cg.module, "dva_arena_init")
   ga = LLVMGetNamedGlobal(cg.module, "global_arena")
   iargs = (ga, LLVMConstInt(i64t, 67108864, 0))
   LLVMBuildCall2(cg.builder, init_t, init_fn, &iargs, 2, "")

// fn type ret(p0, p1)
fn_type2: Cg, Addr, Addr, Addr => Addr
fn_type2 = cg, ret, p0, p1 =>
   parr = (p0, p1)
   LLVMFunctionType(ret, &parr, 2, 0)

// --- target layout & size helpers -------------------------------------------

is_32bit_triple: String => <>
is_32bit_triple = triple =>
   ast::triple_arch(triple)
      ["wasm32", "wasm", "x86", "armv7", "armv6", "thumb", "riscv32", "arm"]

is_32bit_target: Cg => <>
is_32bit_target = cg => is_32bit_triple(cg.opts.target_triple)

is_wasm_triple: String => <>
is_wasm_triple = triple =>
   ast::triple_arch(triple)
      ["wasm32", "wasm64", "wasm"]

is_wasm_target: Cg => <>
is_wasm_target = cg => is_wasm_triple(cg.opts.target_triple)

emit_wasm_trap: Cg => Addr
emit_wasm_trap = cg =>
   trap_ty = fn_type0(LLVMVoidType!)
   trap_fn = llvm_find_function(cg.module, "llvm.trap")
      | fn => fn
      | LLVMAddFunction(cg.module, "llvm.trap", trap_ty)
   call0(cg, trap_ty, trap_fn, "")

ensure_printf_fn: Cg => (Addr, Addr)
ensure_printf_fn = cg =>
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   parr = (i8p, i8p)
   pty = LLVMFunctionType(LLVMInt32Type!, &parr, 1, 1)
   pfn = llvm_find_function(cg.module, "printf")
      | fn => fn
      | LLVMAddFunction(cg.module, "printf", pty)
   (pty, pfn)

ensure_write_fn: Cg => (Addr, Addr)
ensure_write_fn = cg =>
   cg.write_fn
      | fn => (cg.write_t!!, fn)
      |
         i64t = LLVMInt64Type!
         i32t = LLVMInt32Type!
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         w_ty = fn_type3(i64t, i32t, i8p, i64t)
         w_fn = llvm_find_function(cg.module, "write")
            | fn => fn
            | LLVMAddFunction(cg.module, "write", w_ty)
         cg.write_t = <+ w_ty +>
         cg.write_fn = <+ w_fn +>
         (w_ty, w_fn)

ensure_exit_fn: Cg => (Addr, Addr)
ensure_exit_fn = cg =>
   cg.exit_fn
      | fn => (cg.exit_t!!, fn)
      |
         i32t = LLVMInt32Type!
         e_ty = fn_type1(LLVMVoidType!, i32t)
         e_fn = llvm_find_function(cg.module, "exit")
            | fn => fn
            | LLVMAddFunction(cg.module, "exit", e_ty)
         runtime::mark_nounwind(cg, e_fn)
         runtime::mark_fn_enum_attr(cg, e_fn, "noreturn")
         runtime::mark_fn_enum_attr(cg, e_fn, "cold")
         cg.exit_t = <+ e_ty +>
         cg.exit_fn = <+ e_fn +>
         (e_ty, e_fn)

ensure_memcmp_fn: Cg => (Addr, Addr)
ensure_memcmp_fn = cg =>
   cg.memcmp_fn
      | fn => (cg.memcmp_t!!, fn)
      |
         i64t = LLVMInt64Type!
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         mc_ty = fn_type3(LLVMInt32Type!, i8p, i8p, i64t)
         mc_fn = llvm_find_function(cg.module, "memcmp")
            | fn => fn
            | LLVMAddFunction(cg.module, "memcmp", mc_ty)
         runtime::mark_nounwind(cg, mc_fn)
         cg.memcmp_t = <+ mc_ty +>
         cg.memcmp_fn = <+ mc_fn +>
         (mc_ty, mc_fn)

target_ptr_size: Cg => Int
target_ptr_size = cg => is_32bit_target(cg) | 4 | 8

target_ptr_align: Cg => Int
target_ptr_align = cg => is_32bit_target(cg) | 4 | 8

codegen_error_size: Cg => Int
codegen_error_size = cg => is_32bit_target(cg) | 48 | 56

// --- type helpers ------------------------------------------------------------

is_float_vt: ast::ValueType => <>
is_float_vt = [Float, F32]

is_int_vt: ast::ValueType => <>
is_int_vt = [Int, Rune, I8, I16, I32, I64, U8, U16, U32, U64]

is_unsigned_vt: ast::ValueType => <>
is_unsigned_vt = [U8, U16, U32, U64]

is_ram_vt: ast::ValueType => <>
is_ram_vt = [Ram]

is_flag_vt: ast::ValueType => <>
is_flag_vt = [Flag]

is_enum_vt: ast::ValueType => <>
is_enum_vt = [Enum]

is_any_ram_vt: ast::ValueType => <>
is_any_ram_vt = [Flag, Ram, Enum]

is_str_vt: ast::ValueType => <>
is_str_vt = [Str]

is_rune_vt: ast::ValueType => <>
is_rune_vt = [Rune]

is_record_vt: ast::ValueType => <>
is_record_vt = [Record, Error]

is_array_vt: ast::ValueType => <>
is_array_vt = [Array]

is_builder_vt: ast::ValueType => <>
is_builder_vt = [Builder]

is_slice_vt: ast::ValueType => <>
is_slice_vt = [Slice]

is_scalar_vt: ast::ValueType => <>
is_scalar_vt = [Int, Rune, I8, I16, I32, I64, U8, U16, U32, U64,
  Float, F32, Str, Builder, Unit]

is_map_vt: ast::ValueType => <>
is_map_vt = [Map]

is_ptr_vt: ast::ValueType => <>
is_ptr_vt = [RawPtr]

// The LLVM type backing a ValueType (i64 Int, double Float, i1 ram-flag,
// ptr String). Slice-9 subset; composite types arrive with later slices.
// The LLVM type globals are pre-bound (a zero-arg 'fun!' call directly before
// ')' was an earlier parser gap).
// LLVM-reference discovery: find a named function or global in a module,
// returning <Addr|> so callers must explicitly match both states.
llvm_find_function: Addr, String => <Addr|>
llvm_find_function = module, name =>
   llvm_val_opt(LLVMGetNamedFunction(module, name))

llvm_find_global: Addr, String => <Addr|>
llvm_find_global = module, name =>
   llvm_val_opt(LLVMGetNamedGlobal(module, name))

float_llvm: ast::ValueType => Addr
float_llvm = vt => vt [F32] LLVMFloatType! | LLVMDoubleType!

llvm_type_of_vt: ast::ValueType => Addr
llvm_type_of_vt = vt =>
   f32t = LLVMFloatType!
   dbl = LLVMDoubleType!
   i1t = LLVMInt1Type!
   i8t = LLVMInt8Type!
   i16t = LLVMInt16Type!
   i32t = LLVMInt32Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   i64t = LLVMInt64Type!
   vt
      [Unit] LLVMVoidType!
      [Float] dbl
      [F32] f32t
      [Flag] i1t
      [I8, U8] i8t
      [I16, U16] i16t
      [I32, U32, Rune] i32t
      [Ram] i8p
      [Enum] i8p
      [Str] i8p
      [Map] i8p
      [Builder] i8p
      [Fn] i8p
      [Array] i8p
      [Slice] i8p
      [Error] i8p
      [RawPtr] i8p
      [Record] i8p
      | i64t

// --- strings ----------------------------------------------------------------

// The runtime's current arena. The main thread falls back to global_arena;
// spawned threads install their own arena in dva_arena_tls.
name_is_qualified: String, Int => <>
name_is_qualified = name, i =>
   i + 1 < ?name && name(i) != '$
      |
         (name(i) == ':) && (name(i + 1) == ':)
            | <+>
            | name_is_qualified(name, i + 1)
      | <->

// The first module component of "module::binding" (or "" for an unqualified
// declaration). Module names are path-tail prefixes, never runtime values.
// Stops before '$' so monomorphized type suffixes ("fn$Rec(mod::T:...)") do
// not corrupt the function's declaring module.
decl_module_find: String, Int, Int => Int
decl_module_find = name, i, last =>
   i + 1 < ?name && name(i) != '$
      |
         (name(i) == ':) && (name(i + 1) == ':)
            | decl_module_find(name, i + 2, i)
            | decl_module_find(name, i + 1, last)
      | last

decl_module: String, Int => String
decl_module = name, ignored =>
   last = decl_module_find(name, 0, -1)
   last < 0 | "" | name(0..last)

// The bare name without module prefix ("is_alpha" from "unicode::is_alpha").
decl_bare_name: String, Int => String
decl_bare_name = name, ignored =>
   s = bare_name_start(name, 0, 0)
   name(s..?name)

bare_name_start: String, Int, Int => Int
bare_name_start = name, i, last =>
   i + 1 < ?name && name(i) != '$
      |
         (name(i) == ':) && (name(i + 1) == ':)
            | bare_name_start(name, i + 2, i + 2)
            | bare_name_start(name, i + 1, last)
      | last

suffix_matches_step: String, Int, String, Int, Int => <>
suffix_matches_step = name, offset, bare, j, n =>
   j == n
      | <+>
      |
         (name(offset + j) == bare(j)) &&
           suffix_matches_step(name, offset, bare, j + 1, n)

name_matches_module_public: String, String, String => <>
name_matches_module_public = qual, mod, bare =>
   mlen = ?mod
   blen = ?bare
   (?qual == mlen + 2 + blen) &&
     (qual(mlen) == ':) && (qual(mlen + 1) == ':) &&
     suffix_matches_step(qual, 0, mod, 0, mlen) &&
     suffix_matches_step(qual, mlen + 2, bare, 0, blen)

name_matches_module_private: String, String, String => <>
name_matches_module_private = qual, mod, bare =>
   mlen = ?mod
   blen = ?bare
   (?qual == mlen + 3 + blen) &&
     (qual(mlen) == ':) && (qual(mlen + 1) == ':) && (qual(mlen + 2) == '#) &&
     suffix_matches_step(qual, 0, mod, 0, mlen) &&
     suffix_matches_step(qual, mlen + 3, bare, 0, blen)

name_bare_matches: String, String => <>
name_bare_matches = qual, bare =>
   start = bare_name_start(qual, 0, 0)
   start > 0 && (?qual - start == ?bare) &&
     suffix_matches_step(qual, start, bare, 0, ?bare)

// Whether a signature name matches a function name (exact).
sig_name_matches: String, String => <>
sig_name_matches = sig_name, fn_name =>
   sig_name == fn_name

// A local must shadow a same-named module global. Only after that check may a
// bare name resolve to current_module::name (or its private #name spelling).
has_local_var: Cg, String => <>
has_local_var = cg, name =>
   has_local_var_at(cg, name, ?cg.vars - 1, cg.fn_var_start)

has_local_var_at: Cg, String, Int, Int => <>
has_local_var_at = cg, name, i, start =>
   i < start
      | <->
      |
         v = cg.vars(i)!!
         ((v.name == name) && v.is_local)
            | <+>
            | has_local_var_at(cg, name, i - 1, start)

has_var_name: Cg, String => <>
has_var_name = cg, name => has_var_name_at(cg, name, ?cg.vars - 1)

has_var_name_at: Cg, String, Int => <>
has_var_name_at = cg, name, i =>
   i < 0
      | <->
      |
         v = cg.vars(i)!!
         (v.name == name) && (!v.is_local || (i !< cg.fn_var_start))
            | <+>
            | has_var_name_at(cg, name, i - 1)

// Scans non-local variables in cg.vars for current-module matches (match_mod = <+>) or bare names (<->).
resolve_var_name_pass: Cg, String, Int, <> => <String|>
resolve_var_name_pass = cg, name, i, match_mod =>
   i < 0
      | <-->
      |
         v = cg.vars(i)!!
         hit = !v.is_local && (match_mod
            | (name_matches_module_public(v.name, cg.current_module, name) ||
              name_matches_module_private(v.name, cg.current_module, name))
            | v.name == name)
         hit | <+ v.name +> | resolve_var_name_pass(cg, name, i - 1, match_mod)

resolve_var_name_at: Cg, String, Int => String
resolve_var_name_at = cg, name, i =>
   resolve_var_name_pass(cg, name, i, <+>)
      | v => v
      |
         cg.current_module != ""
            | "${cg.current_module}::${name}"
            |
               resolve_var_name_pass(cg, name, i, <->)
                  | v => v
                  | name

resolve_var_name: Cg, String => String
resolve_var_name = cg, name =>
   cg.current_module == ""
      | name
      |
         name_is_qualified(name, 0)
            | name
            |
               find_dot(name, 0) > 0
                  | name
                  |
                     has_local_var(cg, name)
                        | name
                        | resolve_var_name_at(cg, name, cg.fn_var_start - 1)

is_marked_global_name: Cg, String => <>
is_marked_global_name = cg, name =>
   cg.current_module != "" && !name_is_qualified(name, 0)
      |
         has_str(g.marked_globals, "${cg.current_module}::${name}") ||
           has_str(g.marked_globals, "${cg.current_module}::#${name}")
      | has_str(g.marked_globals, name)

has_fn_name: Cg, String => <>
has_fn_name = cg, name => cg.fn_names ^? name

add_fn_def: Cg, FnDef => ()
add_fn_def = cg, fd =>
   names = cg.fn_names
   known = names ^? fd.name
   !known | names ^ fd.name = ?cg.fns
   cg.fns += fd

is_fn_name: Cg, String => <>
is_fn_name = cg, name =>
   <>(fninfo_index(cg, name))

is_any_fn_name: Cg, String => <>
is_any_fn_name = cg, name =>
   rf = resolve_fn_name(cg, name)
   is_mod_fn = rf != name && (has_fn_name(cg, rf) || is_fn_name(cg, rf))
   is_root_fn = cg.current_module == "" &&
     (has_fn_name(cg, name) || is_fn_name(cg, name))
   is_qual_fn = name_is_qualified(name, 0) &&
     (has_fn_name(cg, name) || is_fn_name(cg, name))
   is_mod_fn || is_root_fn || is_qual_fn ||
     has_str(g.foreign_fn_names, name)

find_fn_module_name: Cg, String => String
find_fn_module_name = cg, name =>
   public = cg.current_module + "::" + name
   private = cg.current_module + "::#" + name
   indices = cg.fn_names
   has_public = indices ^? public
   has_private = indices ^? private
   has_public && has_private
      |
         public_idx = indices ^ public | _ | -1
         private_idx = indices ^ private | _ | -1
         public_idx < private_idx | public | private
      |
         has_public
            | public
            | has_private
               | private
               | ""

find_fi_module_name_at: Cg, String, Int, Int => String
find_fi_module_name_at = cg, name, i, n =>
   i == n
      | ""
      |
         fi = cg.fninfos(i)!!
         name_matches_module_public(fi.name, cg.current_module, name)
            | fi.name
            |
               name_matches_module_private(fi.name, cg.current_module, name)
                  | fi.name
                  | find_fi_module_name_at(cg, name, i + 1, n)

resolve_fn_name: Cg, String => String
resolve_fn_name = cg, name =>
   cg.current_module == ""
      | name
      |
         name_is_qualified(name, 0)
            | name
            |
               fd_name = find_fn_module_name(cg, name)
               fd_name != ""
                  | fd_name
                  |
                     fi_name = find_fi_module_name_at(cg, name, 0, ?cg.fninfos)
                     fi_name != "" | fi_name | "${cg.current_module}::${name}"

has_type_name: Cg, String => <>
has_type_name = cg, name => cg.type_indices ^? name

find_type_bare_name_at: Cg, String, Int, Int => String
find_type_bare_name_at = cg, name, i, n =>
   i == n
      | name
      |
         td = cg.typedefs(i)!!
         td.name == name
            | td.name
            |
               td.name(0) == 35
                  | find_type_bare_name_at(cg, name, i + 1, n)
                  |
                     name_bare_matches(td.name, name)
                        | td.name
                        | find_type_bare_name_at(cg, name, i + 1, n)

find_type_bare_name: Cg, String => String
find_type_bare_name = cg, name =>
   find_type_bare_name_at(cg, name, 0, ?cg.typedefs)

find_type_module_name: Cg, String => String
find_type_module_name = cg, name =>
   public = cg.current_module + "::" + name
   private = cg.current_module + "::#" + name
   indices = cg.type_indices
   has_public = indices ^? public
   has_private = indices ^? private
   has_public && has_private
      |
         public_idx = indices ^ public | _ | -1
         private_idx = indices ^ private | _ | -1
         public_idx < private_idx | public | private
      |
         has_public
            | public
            | has_private
               | private
               | ""

resolve_type_name: Cg, String => String
resolve_type_name = cg, name =>
   name_is_qualified(name, 0)
      | name
      |
         cg.current_module != ""
            |
               mod_name = find_type_module_name(cg, name)
               mod_name != "" | mod_name | name
            | find_type_bare_name(cg, name)

find_dot: String, Int => Int
find_dot = s, i =>
   (i < ?s)
      | (s(i) == 46) | i | find_dot(s, i + 1)
      | -1

dotted_var_type: Cg, String => ast::ValueType
dotted_var_type = cg, name =>
   dot = find_dot(name, 0)
   dot < 0
      | ast::ValueType(Unknown)
      |
         base_name = name(0..dot)
         field_name = name(dot + 1..?name)
         fnames = var_fnames(cg, base_name)
         idx = member_index(fnames, field_name)
         idx < 0
            | ast::ValueType(Unknown)
            |
               fvts = match::var_fvts(cg, base_name)
               idx < ?fvts | (fvts(idx) | _ | ast::ValueType(Unknown)) |
                  ast::ValueType(Unknown)

dotted_var_val: Cg, String => <(Addr, ast::ValueType)|>
dotted_var_val = cg, name =>
   dot = find_dot(name, 0)
   dot < 0
      | <-->
      |
         base_name = name(0..dot)
         field_name = name(dot + 1..?name)
         fnames = var_fnames(cg, base_name)
         idx = member_index(fnames, field_name)
         idx < 0
            | <-->
            |
               fvts = match::var_fvts(cg, base_name)
               fvt = idx < ?fvts | (fvts(idx) | _ | ast::ValueType(Unknown)) |
                  ast::ValueType(Unknown)
               base_val_opt = ptr_var_value_plain_opt(cg, base_name, "rec.ptr")
               base_val_opt
                  | base_val =>
                     var_rt(cg, base_name)
                        | rt =>
                           is_homo = expr::record_type_is_homogeneous(<+ rt +>, fvts)
                           ft = is_homo
                              | LLVMStructGetTypeAtIndex(rt, 0)
                              | LLVMStructGetTypeAtIndex(rt, idx)
                           fgep = record_field_gep(cg, rt, fvts, base_val, idx)
                           is_rec = fvt [Record]
                           val = is_rec
                              | fgep
                              | LLVMBuildLoad2(cg.builder, ft, fgep,
                                "field.load")
                           <+ (val, fvt) +>
                        | <-->
                  | <-->

dotted_var_dtype: Cg, String => String
dotted_var_dtype = cg, name =>
   dot = find_dot(name, 0)
   dot < 0
      | ""
      |
         base_name = name(0..dot)
         field_name = name(dot + 1..?name)
         fnames = var_fnames(cg, base_name)
         idx = member_index(fnames, field_name)
         idx < 0
            | ""
            |
               base_dt0 = var_dtype(cg, base_name)
               base_ti = base_dt0 != ""
                  | typedef_ti(cg, base_dt0)
                  |
                     var_rt(cg, base_name)
                        | rt => typedef_ti_of_rt(cg, rt)
                        | ast::TypeInfo(Prim, ast::ValueType(Unknown))
               record_field_dtype(cg, base_ti, idx)

dotted_fn_ret_vt: Cg, String => ast::ValueType
dotted_fn_ret_vt = cg, name =>
   dot = find_dot(name, 0)
   dot < 0
      | ast::ValueType(Unknown)
      |
         base_name = name(0..dot)
         field_name = name(dot + 1..?name)
         fnames = var_fnames(cg, base_name)
         idx = member_index(fnames, field_name)
         idx < 0
            | ast::ValueType(Unknown)
            |
               base_dt0 = var_dtype(cg, base_name)
               base_ti = base_dt0 != ""
                  | typedef_ti(cg, base_dt0)
                  |
                     var_rt(cg, base_name)
                        | rt => typedef_ti_of_rt(cg, rt)
                        | ast::TypeInfo(Prim, ast::ValueType(Unknown))
               fti = record_field_ti(cg, base_ti, idx)
               fti
                  [Fn f]
                     f.2 != ast::ValueType(Unknown)
                        | f.2
                        | ast::ValueType(Unknown)
                  | ast::ValueType(Unknown)

// The ValueType of a named variable (default Int). A function-local shadows a
// same-named top-level global.
var_type: Cg, String => ast::ValueType
var_type = cg, name =>
   find_dot(name, 0) > 0
      | dotted_var_type(cg, name)
      |
         vt = find_var_type(cg, resolve_var_name(cg, name), ?cg.vars - 1,
           ast::ValueType(Unknown))
         vt != ast::ValueType(Unknown) | vt | dotted_var_type(cg, name)

find_var_type: Cg, String, Int, ast::ValueType => ast::ValueType
find_var_type = cg, name, i, fallback =>
   i < 0
      | fallback
      |
         v = cg.vars(i)!!
         v.name == name
            |
               (i !< cg.fn_var_start) && v.is_local
                  | v.vt
                  |
                     !v.is_local
                        | v.vt
                        | find_var_type(cg, name, i - 1, fallback)
            | find_var_type(cg, name, i - 1, fallback)

// A variable's global: create it (with the width) or fetch the existing one.
codegen_get_global: Cg, String, Addr => Addr
codegen_get_global = cg, name, llvm_type =>
   gname = "var." + name
   llvm_find_global(cg.module, gname)
      | glob => glob
      |
         g2 = LLVMAddGlobal(cg.module, llvm_type, gname)
         is_ext = cg.opts.is_module && is_external_module_name(cg, name)
         !is_ext
            | LLVMSetInitializer(g2, LLVMConstNull(llvm_type))
         is_dyn = stmt::is_module_dynamic(cg, name) || cg.opts.is_shared || cg.opts.is_module
         !is_dyn
            | LLVMSetLinkage(g2, 8)
         g2

// Whether a named variable's ram slot is a heap union pointer (not a flag).
var_is_heap: Cg, String => <>
var_is_heap = cg, name =>
   find_dot(name, 0) > 0
      | <->
      | var_is_heap_at(cg, resolve_var_name(cg, name), ?cg.vars - 1)

var_is_heap_at: Cg, String, Int => <>
var_is_heap_at = cg, name, i =>
   i < 0
      | <->
      |
         v = cg.vars(i)!!
         v.name == name
            |
               (i !< cg.fn_var_start) && v.is_local
                  | v.is_heap
                  |
                     !v.is_local
                        | v.is_heap
                        | var_is_heap_at(cg, name, i - 1)
            | var_is_heap_at(cg, name, i - 1)

// The declared '#type' name of a variable (for ram payload resolution).
var_dtype: Cg, String => String
var_dtype = cg, name =>
   find_dot(name, 0) > 0
      | dotted_var_dtype(cg, name)
      | var_dtype_at(cg, resolve_var_name(cg, name), ?cg.vars - 1)

var_dtype_at: Cg, String, Int => String
var_dtype_at = cg, name, i =>
   i < 0
      | ""
      |
         v = cg.vars(i)!!
         v.name == name
            |
               (i !< cg.fn_var_start) && v.is_local
                  | v.dtype
                  |
                     !v.is_local
                        | v.dtype
                        | var_dtype_at(cg, name, i - 1)
            | var_dtype_at(cg, name, i - 1)

// A record variable's LLVM struct type.
var_rt: Cg, String => <Addr|>
var_rt = cg, name =>
   find_dot(name, 0) > 0
      | dotted_var_rt(cg, name)
      | var_rt_at(cg, resolve_var_name(cg, name), ?cg.vars - 1)

dotted_var_rt: Cg, String => <Addr|>
dotted_var_rt = cg, name =>
   dot = find_dot(name, 0)
   dot < 0
      | <-->
      |
         base_name = name(0..dot)
         field_name = name(dot + 1..?name)
         fnames = var_fnames(cg, base_name)
         idx = member_index(fnames, field_name)
         idx < 0
            | <-->
            |
               var_rt(cg, base_name)
                  | rt => <+ LLVMStructGetTypeAtIndex(rt, idx) +>
                  | <-->

var_rt_at: Cg, String, Int => <Addr|>
var_rt_at = cg, name, i =>
   i < 0
      | <-->
      |
         v = cg.vars(i)!!
         v.name == name
            |
               (i !< cg.fn_var_start) && v.is_local
                  | v.rt
                  |
                     !v.is_local
                        | v.rt
                        | var_rt_at(cg, name, i - 1)
            | var_rt_at(cg, name, i - 1)

// A record variable's named field list (empty for a positional record).
var_fnames: Cg, String => ast::Names
var_fnames = cg, name =>
   find_dot(name, 0) > 0
      | ast::Names()
      | var_fnames_at(cg, resolve_var_name(cg, name), ?cg.vars - 1)

var_fnames_at: Cg, String, Int => ast::Names
var_fnames_at = cg, name, i =>
   i < 0
      | ast::Names()
      |
         v = cg.vars(i)!!
         v.name == name
            |
               (i !< cg.fn_var_start) && v.is_local
                  | v.fnames
                  |
                     !v.is_local
                        | v.fnames
                        | var_fnames_at(cg, name, i - 1)
            | var_fnames_at(cg, name, i - 1)

// Resolves a member field to its slot index: a numeric name is the index; a
// named field is looked up in the record's field list.
member_index: ast::Names, String => Int
member_index = fnames, name =>
   n = parse_digits(name, 0, 0)
   n !< 0
      | n
      | find_field(fnames, name, 0) | _ | -1

// A dotted parenthesized member index is valid only when it is a literal or a
// compile-time constant. A dynamic index is diagnosed as E3170.
member_static_index: Cg, ast::MemberExpr, ast::Names => <Int|>
member_static_index = cg, m, fnames =>
   m.field_name == ""
      |
         m.index_expr
            [Int n] <+ n +>
            |
               saved_discard = cg.discard_result
               cg.discard_result = <->
               ev = expr::codegen_eval(cg, m.index_expr)
               cg.discard_result = saved_discard
               llvm_val_opt(ev.0)
                  | ev0 =>
                     LLVMIsConstant(ev0) != 0
                        | <+ LLVMConstIntGetZExtValue(ev0) +>
                        | <-->
                  | <-->
      |
         idx = member_index(fnames, m.field_name)
         idx !< 0 | <+ idx +> | <-->

// A non-negative decimal parse ("" or a non-digit -> -1).
parse_digits: String, Int, Int => Int
parse_digits = s, i, acc =>
   (i < ?s)
      |
         c = s(i)
         c ['0...'9]
            | parse_digits(s, i + 1, acc * 10 + (c - '0))
            | -1
      | acc

find_field: ast::Names, String, Int => <Int|>
find_field = fnames, name, acc =>
   acc < ?fnames
      |
         fnames(acc)!! == name | <+ acc +> | find_field(fnames, name, acc + 1)
      | <-->

// Loads a variable's global/local value, typed by its recorded ValueType (a
// heap ram slot loads a pointer; a flag loads i1). The storage slot (a global
// or a function-local alloca) comes from the variable record.
codegen_load: Cg, String => <(Addr, ast::ValueType)|>
codegen_load = cg, name =>
   find_dot(name, 0) > 0
      | (dotted_var_val(cg, name) | v => <+ v +> | codegen_undefined_name_error(cg, name))
      |
         vt = var_type(cg, name)
         is_heap = var_is_heap(cg, name)
         cg.last_rt = var_rt(cg, name)
         fnames = var_fnames(cg, name)
         ?fnames > 0 | cg.last_fnames = fnames
         fvts = match::var_fvts(cg, name)
         ?fvts > 0 | cg.last_fvts = fvts
         dt = var_dtype(cg, name)
         dt != "" | cg.last_type = dt
         cfn = main::is_fn_vt(vt) | expr::closure_fn_of(cg, name) | ""
         cfn != "" | cg.last_closure_fn = cfn
         is_ptr = is_heap || is_record_vt(vt) || is_map_vt(vt) ||
           is_array_vt(vt) || is_slice_vt(vt)
         lt = is_ptr
            | LLVMPointerType(LLVMInt8Type!, 0)
            | llvm_type_of_vt(vt)
         slot_opt = var_slot(cg, name)
         // A typed closure keeps ram parameters in their ABI representation.
         // Generic calls may read them through the untyped expression path,
         // which expects a heap union rather than an unboxed pair or niche.
         (vt [Ram]) && !is_heap && dt != ""
            |
               slot_opt | slot =>
                  ti = typedef_ti(cg, dt)
                  abi_type = llvm_abi_type_of_ti(cg, ti)
                  raw = LLVMBuildLoad2(cg.builder, abi_type, slot, "ram.abi.load")
                  heap = match::convert_abi_ram_to_heap_union(cg, raw, ti)
                  --| <+ (heap, vt) +>
         uninit = !cg.in_fn && main::var_partial(cg, name) && !init_ok(cg.init, name)
         forward_scalar = uninit && !is_record_vt(vt) &&
           !is_array_vt(vt) && !is_slice_vt(vt)
         forward_scalar
            | codegen_uninitialized_load_error(cg, name)
            |
               var_direct(cg, name)
                  | dv => <+ (dv, vt) +>
                  | codegen_load_after_forward(cg, slot_opt, lt, name, vt)

codegen_load_after_forward: Cg, <Addr|>, Addr, String, ast::ValueType => <(Addr, ast::ValueType)|>
codegen_load_after_forward = cg, slot_opt, lt, name, vt =>
   slot_opt
      | slot => codegen_load_known(cg, slot, lt, name, vt)
      | codegen_missing_load(cg, name)

codegen_uninitialized_load_error: Cg, String => <(Addr, ast::ValueType)|>
codegen_uninitialized_load_error = cg, name =>
   init_error(cg, "E3045", diag::uninitialized_variable_prefix! + name +
     "' — a forward annotation ('name: Type') allocates no storage; assign " +
     "a value before reading.", 0, 0)
   <-->

codegen_missing_load: Cg, String => <(Addr, ast::ValueType)|>
codegen_missing_load = cg, name =>
   dotted_var_val(cg, name) | v => <+ v +> | codegen_undefined_name_error(cg, name)

codegen_undefined_name_error: Cg, String => <(Addr, ast::ValueType)|>
codegen_undefined_name_error = cg, name =>
   init_error(cg, "E3004", "Undefined variable '" + name +
     "' in fn '" + g.last_compiling_fn + "'", 0, 0)
   <-->

codegen_load_known: Cg, Addr, Addr, String, ast::ValueType => <(Addr, ast::ValueType)|>
codegen_load_known = cg, slot, lt, name, vt =>
   lname = "load." + name
   <+ (LLVMBuildLoad2(cg.builder, lt, slot, lname), vt) +>

// A variable's direct SSA value (a fn param, used without a backing alloca).
var_direct: Cg, String => <Addr|>
var_direct = cg, name =>
   find_dot(name, 0) > 0
      | <-->
      | find_var_direct(cg, resolve_var_name(cg, name), ?cg.vars - 1)

find_var_direct: Cg, String, Int => <Addr|>
find_var_direct = cg, name, i =>
   i < 0
      | <-->
      |
         v = cg.vars(i)!!
         v.name == name
            |
               (i !< cg.fn_var_start) && v.is_local
                  | v.direct
                  |
                     !v.is_local
                        | v.direct
                        | find_var_direct(cg, name, i - 1)
            | find_var_direct(cg, name, i - 1)

// A pointer-typed variable's VALUE: a direct param's SSA value, or a load
// from its slot (creating a null-initialized slot for a never-slotted name).
ptr_var_value: Cg, String, String => Addr
ptr_var_value = cg, name, lname =>
   var_type(cg, name)
      [Array] main::codegen_array_var_value(cg, name, lname)
      | ptr_var_value_plain(cg, name, lname)

ptr_var_value_plain_opt: Cg, String, String => <Addr|>
ptr_var_value_plain_opt = cg, name, lname =>
   find_dot(name, 0) > 0
      | (dotted_var_val(cg, name) | dot_v => <+ dot_v.0 +> | <-->)
      |
         var_direct(cg, name)
            | d => <+ d +>
            |
               slot = var_slot(cg, name)
                  | _
                  |
                     i8p = LLVMPointerType(LLVMInt8Type!, 0)
                     s_new = create_slot(cg, name, i8p, cg.in_fn)
                     LLVMBuildStore(cg.builder,
                       LLVMConstNull(i8p), s_new)
                     s_new
               <+ LLVMBuildLoad2(cg.builder,
                 LLVMPointerType(LLVMInt8Type!, 0), slot, lname) +>

ptr_var_value_plain: Cg, String, String => Addr
ptr_var_value_plain = cg, name, lname =>
   ptr_var_value_plain_opt(cg, name, lname)
      | _
      | LLVMConstNull(LLVMPointerType(LLVMInt8Type!, 0))

// A variable's storage slot (a global pointer or a function-local alloca). A
// function-local (param or body local) shadows a same-named top-level global:
// prefer a local match, fall back to the first global.
var_slot: Cg, String => <Addr|>
var_slot = cg, name =>
   find_dot(name, 0) > 0
      | <-->
      | find_var_slot(cg, resolve_var_name(cg, name), ?cg.vars - 1)

find_var_slot: Cg, String, Int => <Addr|>
find_var_slot = cg, name, i =>
   i < 0
      | <-->
      |
         v = cg.vars(i)!!
         v.name == name
            |
               (i !< cg.fn_var_start) && v.is_local
                  | v.slot
                  |
                     !v.is_local
                        | v.slot
                        | find_var_slot(cg, name, i - 1)
            | find_var_slot(cg, name, i - 1)

var_has_storage: Cg, String => <>
var_has_storage = cg, name =>
   var_slot(cg, name)
      | <+>
      | <>(var_direct(cg, name))

// --- block / branch plumbing -------------------------------------------------

// True when the builder's current insertion block is terminated (or absent).
type_name_to_vt: String => (ast::ValueType, <>)
type_name_to_vt = name =>
   name
      ["Int"] (ast::ValueType(Int), <+>)
      ["i64"] (ast::ValueType(I64), <+>)
      ["i8"] (ast::ValueType(I8), <+>)
      ["i16"] (ast::ValueType(I16), <+>)
      ["i32"] (ast::ValueType(I32), <+>)
      ["u8"] (ast::ValueType(U8), <+>)
      ["u16"] (ast::ValueType(U16), <+>)
      ["u32"] (ast::ValueType(U32), <+>)
      ["u64"] (ast::ValueType(U64), <+>)
      ["i1", "<>"] (ast::ValueType(Flag), <+>)
      ["Rune"] (ast::ValueType(Rune), <+>)
      ["Float"] (ast::ValueType(Float), <+>)
      ["f64"] (ast::ValueType(Float), <+>)
      ["f32"] (ast::ValueType(F32), <+>)
      ["String"] (ast::ValueType(Str), <+>)
      ["void"] (ast::ValueType(Unit), <+>)
      ["Addr"] (ast::ValueType(RawPtr), <+>)
      ["ptr"] (ast::ValueType(RawPtr), <+>)
      ["Builder"] (ast::ValueType(Builder), <+>)
      ["Error"] (ast::ValueType(Error), <+>)
      ["Type"] (ast::ValueType(Type), <+>)
      | (ast::ValueType(Unknown), <->)

prim_type_tag: ast::ValueType => Int
prim_type_tag =
   [Int, I64] 1
   [Float] 2
   [Str] 3
   [Rune] 4
   [Flag] 5
   [I8] 6
   [I16] 7
   [I32] 8
   [U8] 9
   [U16] 10
   [U32] 11
   [U64] 12
   [F32] 13
   | 0

// Whether a name was declared by a '#type' statement (a pass-through
// constructor-call target).
is_user_type: Cg, String => <>
is_user_type = cg, name =>
   has_type_name(cg, resolve_type_name(cg, name))

// The TypeInfo of a declared '#type' name (default: an Unknown primitive).
typedef_ti: Cg, String => ast::TypeInfo
typedef_ti = cg, name =>
   resolved = resolve_type_name(cg, name)
   indices = cg.type_indices
   indices ^? resolved
      |
         idx = indices ^ resolved | _ | -1
         td = cg.typedefs(idx)!!
         td.ti
            [TypeVar tv]
               tv != name && is_user_type(cg, tv) | typedef_ti(cg, tv) | td.ti
            | td.ti
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

vt_from_ti: ast::TypeInfo => ast::ValueType
vt_from_ti = ti =>
   ti
      [Align a] vt_from_ti(a.1)
      [Enum] ast::ValueType(Enum)
      [Ram s]
         is_flag = !s.0.has_payload && !s.1.has_payload
         is_flag | ast::ValueType(Flag) | ast::ValueType(Ram)
      [Array] ast::ValueType(Array)
      [Map] ast::ValueType(Map)
      [Rec r]
         r.1 | ast::ValueType(Slice) | ast::ValueType(Record)
      [Bitfield b] b.backing_type
      [Fn] ast::ValueType(Fn)
      [Prim vt] vt
      | ast::ValueType(Unknown)

vt_from_ti_cg: Cg, ast::TypeInfo => ast::ValueType
vt_from_ti_cg = cg, ti =>
   ti
      [TypeVar tv]
         pvt = type_name_to_vt(tv)
         pvt.1
            | pvt.0
            |
               td = typedef_ti(cg, tv)
               vt_from_ti(td)
      | vt_from_ti(ti)

slot_payload_type: Cg, ast::RamSlotInfo => ast::ValueType
slot_payload_type = cg, slot =>
   resolved_vt = vt_from_ti_cg(cg, ctfe_canonical_ti(cg, slot.payload_record))
   resolved_vt != ast::ValueType(Unknown)
      | resolved_vt
      | slot.payload_type

is_niche_payload_vt: ast::ValueType => <>
is_niche_payload_vt = vt => vt [Str, Record, Error]

// Classifies a TypeInfo's ramification layout via the centralized layout pass.
classify_ti_ram_layout: Cg, ast::TypeInfo => tast::TypedLayout
classify_ti_ram_layout = cg, ti =>
   ti
      [Align a] classify_ti_ram_layout(cg, a.1)
      [Ram slots]
         s0 = slots.0
         s1 = slots.1
         pos_niche = s0.has_payload && is_niche_payload_vt(slot_payload_type(cg, s0))
         neg_niche = s1.has_payload && is_niche_payload_vt(slot_payload_type(cg, s1))
         layout::classify_ram_layout(s0.has_payload, s1.has_payload, pos_niche, neg_niche)
      [TypeVar name]
         ?name !< 10 && name(0..10) == "#heap_ram_"
            | tast::layout_void!
            | classify_ti_ram_layout(cg, typedef_ti(cg, name))
      | tast::layout_void!

is_niche_ram_ti: Cg, ast::TypeInfo => (<>, <>, ast::ValueType)
is_niche_ram_ti = cg, ti =>
   lay = classify_ti_ram_layout(cg, ti)
   lay.kind
      [RamNichePos]
         can_ti = ctfe_canonical_ti(cg, ti)
         pvt = can_ti [Ram s] slot_payload_type(cg, s.0) | ast::ValueType(Unknown)
         (<+>, <+>, pvt)
      [RamNicheNeg]
         can_ti = ctfe_canonical_ti(cg, ti)
         nvt = can_ti [Ram s] slot_payload_type(cg, s.1) | ast::ValueType(Unknown)
         (<+>, <->, nvt)
      | (<->, <->, ast::ValueType(Unknown))

is_unboxed_ram_ti: Cg, ast::TypeInfo => <>
is_unboxed_ram_ti = cg, ti =>
   classify_ti_ram_layout(cg, ti).kind [RamUnboxed]

// Centralized LLVM value/storage/parameter type for any resolved TypeInfo.
// Maps Unit values to i64 so Unit parameters and storage remain valid LLVM IR.
llvm_abi_type_of_ti: Cg, ast::TypeInfo => Addr
llvm_abi_type_of_ti = cg, ti =>
   is_unboxed_ram_ti(cg, ti)
      | match::unboxed_ram_struct_t(cg)
      |
         vt = vt_from_ti_cg(cg, ti)
         vt [Unit]
            | LLVMInt64Type!
            | llvm_type_of_vt(vt)

is_unboxed_ret_field_vt: ast::ValueType => <>
is_unboxed_ret_field_vt = vt =>
   vt [Int, Rune, I8, I16, I32, I64, U8, U16, U32, U64, Float, F32, Flag, RawPtr, Str]

rec_fields_unboxed_ok: Cg, ast::FieldTypes, Int, Int => <>
rec_fields_unboxed_ok = cg, fields, i, n =>
   i !< n | --| <+>
   rf = fields(i)!!
   (rf.rec_type [Align]) || stmt::ti_is_slice(rf.rec_type) | --| <->
   tv_ok = rf.rec_type
      [TypeVar tv] type_name_to_vt(tv).1 || is_user_type(cg, tv)
      | <+>
   !tv_ok | --| <->
   fvt = runtime::rec_field_vt(cg, rf)
   !is_unboxed_ret_field_vt(fvt) | --| <->
   rec_fields_unboxed_ok(cg, fields, i + 1, n)

unboxed_ret_struct_ti: Cg, ast::TypeInfo => <(Addr, Int)|>
unboxed_ret_struct_ti = cg, ti =>
   !g.is_typed_pipeline || cg.opts.no_runtime | --| <-->
   ti [Align] | --| <-->
   vt = vt_from_ti_cg(cg, ti)
   vt [Str] | --| <+ (cg.str_t, 1) +>
   niche = is_niche_ram_ti(cg, ti)
   niche.0 && (niche.2 [Str]) | --| <+ (cg.str_t, 2) +>
   rti = resolve_record_ti(cg, ti)
   rti
      [Rec rr]
         is_bad = rr.1 || rr.5 || <>(ti_get_bitfield(cg, rti))
         nf = ?rr.0
         is_ok = !is_bad && nf !< 1 && nf !> 3 && rec_fields_unboxed_ok(cg, rr.0, 0, nf)
         !is_ok
            | <-->
            |
               rm = runtime::record_meta_from_ti(cg, rti)
               rm | m => <+ (m.0, 3) +> | <-->
      | <-->

is_foreign_in_mod_step: String, String, Int, Int => <>
is_foreign_in_mod_step = mod, bare, i, n =>
   i !< n | --| <->
   fnm = g.foreign_fn_names(i) | _ | ""
   (name_matches_module_public(fnm, mod, bare) ||
     name_matches_module_private(fnm, mod, bare))
        | <+>
        | is_foreign_in_mod_step(mod, bare, i + 1, n)

fn_uses_c_ret_abi: Cg, String => <>
fn_uses_c_ret_abi = cg, fname =>
   fname == "" | --| <->
   bare = decl_bare_name(fname, 0)
   is_esc_bare = (bare == "escape_value") ||
     (?bare > 13 && bare(0..13) == "escape_value$")
   is_esc = is_esc_bare && ((fname == "mem::escape_value") ||
     (?fname > 18 && fname(0..18) == "mem::escape_value$") ||
     ((fname == bare) && (cg.current_module == "mem")))
   is_esc | --| <+>
   is_exp = (?g.pexports > 0) && <>(stmt::find_export_symbol(g.pexports, fname))
   is_exp | --| <+>
   stmt::is_foreign_fn(fname) ||
     ((fname != bare) && stmt::is_foreign_fn(bare)) ||
     ((fname == bare) && (cg.current_module != "") &&
       is_foreign_in_mod_step(cg.current_module, bare, 0, ?g.foreign_fn_names))

llvm_abi_ret_type_of_ti_c: Cg, ast::TypeInfo => Addr
llvm_abi_ret_type_of_ti_c = cg, ti =>
   is_unboxed_ram_ti(cg, ti)
      | match::unboxed_ram_struct_t(cg)
      |
         vt = vt_from_ti_cg(cg, ti)
         vt [Unit]
            | LLVMVoidType!
            | llvm_type_of_vt(vt)

// Centralized LLVM function return type for any resolved TypeInfo (Unit -> void).
llvm_abi_ret_type_of_ti: Cg, ast::TypeInfo => Addr
llvm_abi_ret_type_of_ti = cg, ti =>
   unboxed_ret_struct_ti(cg, ti)
      | ub => ub.0
      | llvm_abi_ret_type_of_ti_c(cg, ti)

llvm_abi_ret_type_of_ti_for_fn: Cg, String, ast::TypeInfo => Addr
llvm_abi_ret_type_of_ti_for_fn = cg, fname, ti =>
   fn_uses_c_ret_abi(cg, fname)
      | llvm_abi_ret_type_of_ti_c(cg, ti)
      | llvm_abi_ret_type_of_ti(cg, ti)

codegen_cond_value_with_ti: Cg, Addr, ast::ValueType, ast::TypeInfo => Addr
codegen_cond_value_with_ti = cg, v, vt, ti =>
   niche = is_niche_ram_ti(cg, ti)
   niche.0
      |
         niche.1
            |
               LLVMBuildICmp(cg.builder, 33, v,
                 LLVMConstNull(LLVMTypeOf(v)), "niche.ne.null")
            |
               LLVMBuildICmp(cg.builder, 32, v,
                 LLVMConstNull(LLVMTypeOf(v)), "niche.eq.null")
      |
         (LLVMGetTypeKind(LLVMTypeOf(v)) == 10)
            | LLVMBuildExtractValue(cg.builder, v, 0, "ram.tag")
            | stmt::codegen_cond_value(cg, v, vt)

ti_fn_ret_vt: Cg, ast::TypeInfo => ast::ValueType
ti_fn_ret_vt = cg, ti =>
   ti
      [Fn f]
         f.2 != ast::ValueType(Unknown) | f.2 | vt_from_ti(f.3)
      [TypeVar name] ti_fn_ret_vt(cg, typedef_ti(cg, name))
      | ast::ValueType(Unknown)

fn_ret_sig_with_ti: Cg, ast::TypeInfo => String
fn_ret_sig_with_ti = cg, ti =>
   ti
      [Fn f]
         ret_vt = f.2 != ast::ValueType(Unknown) | f.2 | vt_from_ti(f.3)
         ret_vt == ast::ValueType(Unknown)
            | ""
            |
               sname = "#sig_" + ensure_ti_dtype(cg, ti)
               !has_type_name(cg, sname) | runtime::add_type(cg, sname, ti)
               fret = expr::fn_ret_vt_of(cg, sname)
               fret == ast::ValueType(Unknown)
                  |
                     cg.fninfos += FnInfo(sname, <-->, <-->, 0,
                       ast::VTypes(), ret_vt, <->, <->, <+>, <->)
               ret_ti = f.3
               is_rec = ret_vt [Record]
               is_rec
                  |
                     rm = runtime::record_meta_from_ti(cg, ret_ti)
                     rm
                        | m =>
                           rfvts = match::field_vts_from_ti(cg, ret_ti)
                           rdt = ret_ti [TypeVar tn] tn | ""
                           stmt::fn_ret_rec_add(cg, sname, <+ m.0 +>, m.1, rfvts, rdt)
               sname
      [TypeVar name] fn_ret_sig_with_ti(cg, typedef_ti(cg, name))
      | ""

ti_get_bitfield: Cg, ast::TypeInfo => <ast::BitfieldInfo|>
ti_get_bitfield = cg, ti =>
   ti
      [Bitfield b] <+ b +>
      [TypeVar name]
         is_user_type(cg, name)
            | ti_get_bitfield(cg, typedef_ti(cg, name))
            | <-->
      | <-->

ti_is_packed_or_bf: Cg, ast::TypeInfo => <>
ti_is_packed_or_bf = cg, ti =>
   ti
      [Align a] ti_is_packed_or_bf(cg, a.1)
      [Bitfield] <+>
      [Rec r] r.5
      [TypeVar name]
         is_user_type(cg, name)
            | ti_is_packed_or_bf(cg, typedef_ti(cg, name))
            | <->
      | <->

find_bitfield_field: ast::BitfieldFields, String => <ast::BitfieldField|>
find_bitfield_field = fields, name =>
   res' = <-->
   fields @ f =>
      f.name == name
         |
            res' = <+ f +>
            -->
   res'

member_index_in_fields: ast::FieldTypes, String => Int
member_index_in_fields = flds, name =>
   res' = -1
   flds @ f, i =>
      f.name == name
         |
            res' = i
            -->
   res'

record_field_ti_by_name: Cg, ast::TypeInfo, String => ast::TypeInfo
record_field_ti_by_name = cg, ti, name =>
   ti
      [TypeVar tv] record_field_ti_by_name(cg, typedef_ti(cg, tv), name)
      [Rec r]
         flds = r.0
         idx = member_index_in_fields(flds, name)
         idx !< 0
            |
               rf = flds(idx)!!
               rf.rec_type [TypeVar tv] typedef_ti(cg, tv) | rf.rec_type
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      [Prim p]
         is_err = p [Error]
         is_err
            | error_field_ti_by_name(name)
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

member_target_ti: Cg, ast::Expr => ast::TypeInfo
member_target_ti = cg, e =>
   e
      [Var v] expr::var_ti(cg, v)
      [Member inner_m]
         parent_ti = member_target_ti(cg, inner_m.target)
         record_field_ti_by_name(cg, parent_ti, inner_m.field_name)
      [RawMemory rm]
         rm.rec_name != "" | typedef_ti(cg, rm.rec_name) |
            ast::TypeInfo(Prim, rm.load_type)
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

typed_member_target_ti: Cg, tast::TypedExpr => ast::TypeInfo
typed_member_target_ti = cg, te =>
   te.kind
      [Var v]
         dt = var_dtype(cg, v.0)
         dt_ti = dt != "" && has_type_name(cg, dt)
            | typedef_ti(cg, dt)
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         is_bf = dt_ti [Bitfield]
         is_bf
            | dt_ti
            |
               is_unk = te.ti [Prim p] (p [Unknown, Unit]) | <->
               !is_unk
                  |
                     te.ti [TypeVar tv]
                        tv != "" && has_type_name(cg, tv)
                           | typedef_ti(cg, tv)
                           | te.ti
                     | te.ti
                  |
                     dt_ti [Prim p2]
                        p2 [Unknown] te.ti | dt_ti
                     | dt_ti
      [Member inner_m]
         parent_ti = typed_member_target_ti(cg, inner_m.0)
         rf_ti = record_field_ti_by_name(cg, parent_ti, inner_m.1)
         rf_ti_res = rf_ti [TypeVar tv]
            tv != "" && has_type_name(cg, tv) | typedef_ti(cg, tv) | rf_ti
         | rf_ti
         is_unk = rf_ti_res [Prim p] (p [Unknown]) | <->
         is_unk
            |
               te.ti [TypeVar tv2]
                  tv2 != "" && has_type_name(cg, tv2)
                     | typedef_ti(cg, tv2)
                     | te.ti
               | te.ti
            | rf_ti_res
      [RawMemory rm]
         rec_name = te.ti [TypeVar tv] tv | ""
         rec_name != "" && has_type_name(cg, rec_name)
            | typedef_ti(cg, rec_name)
            | te.ti
      |
         te.ti [TypeVar tv]
            tv != "" && has_type_name(cg, tv)
               | typedef_ti(cg, tv)
               | te.ti
         | te.ti

codegen_sizeof_bytes: Cg, ast::SizeOfExpr => Int
codegen_sizeof_bytes = cg, so =>
   eff_ti = subst_ct_binds_ti(so.rec_type)
   eff_vt = eff_ti
      [Prim p] p
      [Rec] ast::ValueType(Record)
      [Enum] ast::ValueType(Enum)
      [Ram] ast::ValueType(Ram)
      [Array] ast::ValueType(Array)
      [Map] ast::ValueType(Map)
      [Fn] ast::ValueType(Fn)
      [Bitfield b] b.backing_type
      [Align a] vt_from_ti_cg(cg, a.1)
      [TypeVar tv]
         is_user_type(cg, tv)
            | vt_from_ti_cg(cg, typedef_ti(cg, tv))
            | so.val_type
      | so.val_type
   eff_vt
      [Record] codegen_record_size_bytes(cg, eff_ti)
      | codegen_type_size(cg, eff_vt, eff_ti)

codegen_alignof_bytes: Cg, ast::AlignOfExpr => Int
codegen_alignof_bytes = cg, ao =>
   eff_ti = subst_ct_binds_ti(ao.rec_type)
   eff_vt = eff_ti
      [Prim p] p
      [Rec] ast::ValueType(Record)
      [Enum] ast::ValueType(Enum)
      [Ram] ast::ValueType(Ram)
      [Array] ast::ValueType(Array)
      [Map] ast::ValueType(Map)
      [Fn] ast::ValueType(Fn)
      [Bitfield b] b.backing_type
      [Align a] vt_from_ti_cg(cg, a.1)
      [TypeVar tv]
         is_user_type(cg, tv)
            | vt_from_ti_cg(cg, typedef_ti(cg, tv))
            | ao.val_type
      | ao.val_type
   codegen_type_align(cg, eff_vt, eff_ti)

codegen_type_size: Cg, ast::ValueType, ast::TypeInfo => Int
codegen_type_size = cg, vt, ti =>
   ti
      [Align a]
         inner_sz = codegen_type_size(cg, vt, a.1)
         align_to(inner_sz, a.0)
      [TypeVar tv]
         is_user_type(cg, tv)
            |
               td_ti = typedef_ti(cg, tv)
               codegen_type_size(cg, vt_from_ti_cg(cg, td_ti), td_ti)
            | codegen_prim_type_size(cg, vt, ti)
      [Rec] codegen_record_size_bytes(cg, ti)
      [Array] target_ptr_size(cg) * 3
      [Map, Fn, Enum] target_ptr_size(cg) * 2
      [Ram r]
         ptr_sz = target_ptr_size(cg)
         has0 = r.0.has_payload && r.0.payload_type ![Unit]
         has1 = r.1.has_payload && r.1.payload_type ![Unit]
         !has0 && !has1
            | 1
            |
               is_n0 = has0 && !has1 && (r.0.payload_type [Str, Record, Error])
               is_n1 = !has0 && has1 && (r.1.payload_type [Str, Record, Error])
               is_n0 || is_n1 | ptr_sz | ptr_sz * 2
      |
         bf_opt = ti_get_bitfield(cg, ti)
         bf_opt
            | b => b.total_bits / 8
            | codegen_prim_type_size(cg, vt, ti)

codegen_prim_type_size: Cg, ast::ValueType, ast::TypeInfo => Int
codegen_prim_type_size = cg, vt, ti =>
   vt
      [I8, U8, Flag] 1
      [I16, U16] 2
      [I32, U32, F32, Rune] 4
      [Record] codegen_record_size_bytes(cg, ti)
      [RawPtr, Fn] target_ptr_size(cg)
      [Str, Slice, Map] target_ptr_size(cg) * 2
      [Builder, Array] target_ptr_size(cg) * 3
      [Error] codegen_error_size(cg)
      | 8

codegen_type_align: Cg, ast::ValueType, ast::TypeInfo => Int
codegen_type_align = cg, vt, ti =>
   ti
      [Align a]
         inner_al = codegen_type_align(cg, vt, a.1)
         a.0 < inner_al | inner_al | a.0
      [TypeVar tv]
         is_user_type(cg, tv)
            |
               td_ti = typedef_ti(cg, tv)
               codegen_type_align(cg, vt_from_ti_cg(cg, td_ti), td_ti)
            | codegen_prim_type_align(cg, vt, ti)
      [Rec] codegen_record_align(cg, ti)
      [Array, Map, Fn, Enum] target_ptr_align(cg)
      |
         bf_opt = ti_get_bitfield(cg, ti)
         bf_opt
            | b => 1
            | codegen_prim_type_align(cg, vt, ti)

codegen_prim_type_align: Cg, ast::ValueType, ast::TypeInfo => Int
codegen_prim_type_align = cg, vt, ti =>
   vt
      [I8, U8, Flag] 1
      [I16, U16] 2
      [I32, U32, F32, Rune] 4
      [Record] codegen_record_align(cg, ti)
      [RawPtr, Fn] target_ptr_align(cg)
      [Str, Slice, Map, Builder, Array] target_ptr_align(cg)
      [Error] 8
      | 8

align_to: Int, Int => Int
align_to = offset, align =>
   align !> 1
      | offset
      |
         rem = offset % align
         rem == 0 | offset | offset + (align - rem)

rec_elem_ti: ast::FieldTypes => ast::TypeInfo
rec_elem_ti = fields =>
   ?fields > 0
      |
         f = fields(0)!!
         f.rec_type
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

codegen_record_size_bytes: Cg, ast::TypeInfo => Int
codegen_record_size_bytes = cg, ti =>
   raw_sz = codegen_record_llvm_size(cg, ti)
   min_sz = is_32bit_target(cg) | 8 | 16
   ti_is_packed_or_bf(cg, ti) | raw_sz | (raw_sz < min_sz | min_sz | raw_sz)

codegen_record_llvm_size: Cg, ast::TypeInfo => Int
codegen_record_llvm_size = cg, ti =>
   min_sz = is_32bit_target(cg) | 8 | 16
   ti
      [Align a]
         inner_sz = codegen_record_llvm_size(cg, a.1)
         align_to(inner_sz, a.0)
      [TypeVar name] codegen_record_llvm_size(cg, typedef_ti(cg, name))
      [Bitfield b] b.total_bits / 8
      [Rec r]
         r.1
            | min_sz
            |
               r.2
                  |
                     elem_sz = codegen_type_size(cg, r.3, rec_elem_ti(r.0))
                     r.4 * elem_sz
                  |
                     r.5
                        | codegen_struct_size_packed(cg, r.0)
                        | codegen_struct_size(cg, r.0)
      | min_sz

codegen_struct_size_packed: Cg, ast::FieldTypes => Int
codegen_struct_size_packed = cg, fields =>
   codegen_struct_size_packed_step(cg, fields, 0, ?fields, 0)

codegen_struct_size_packed_step: Cg, ast::FieldTypes, Int, Int, Int => Int
codegen_struct_size_packed_step = cg, fields, i, n, cur_off =>
   i == n
      | cur_off
      |
         f = fields(i)!!
         fsz = codegen_type_size(cg, f.val_type, f.rec_type)
         codegen_struct_size_packed_step(cg, fields, i + 1, n, cur_off + fsz)

codegen_struct_size: Cg, ast::FieldTypes => Int
codegen_struct_size = cg, fields =>
   codegen_struct_size_step(cg, fields, 0, ?fields, 0, 1)

codegen_struct_size_step: Cg, ast::FieldTypes, Int, Int, Int, Int => Int
codegen_struct_size_step = cg, fields, i, n, cur_off, max_al =>
   i == n
      | align_to(cur_off, max_al)
      |
         f = fields(i)!!
         fsz = codegen_type_size(cg, f.val_type, f.rec_type)
         fal = codegen_type_align(cg, f.val_type, f.rec_type)
         off = align_to(cur_off, fal)
         nal = fal > max_al | fal | max_al
         codegen_struct_size_step(cg, fields, i + 1, n, off + fsz, nal)

codegen_record_align: Cg, ast::TypeInfo => Int
codegen_record_align = cg, ti =>
   ti
      [Align a]
         inner_al = codegen_record_align(cg, a.1)
         a.0 < inner_al | inner_al | a.0
      [TypeVar name] codegen_record_align(cg, typedef_ti(cg, name))
      [Bitfield b] 1
      [Rec r]
         r.5
            | 1
            |
               r.1
                  | (is_32bit_target(cg) | 4 | 8)
                  |
                     r.2
                        | codegen_type_align(cg, r.3, rec_elem_ti(r.0))
                        | codegen_struct_align(cg, r.0)
      | (is_32bit_target(cg) | 4 | 8)

codegen_struct_align: Cg, ast::FieldTypes => Int
codegen_struct_align = cg, fields =>
   codegen_struct_align_step(cg, fields, 0, ?fields, 1)

codegen_struct_align_step: Cg, ast::FieldTypes, Int, Int, Int => Int
codegen_struct_align_step = cg, fields, i, n, max_al =>
   i == n
      | max_al
      |
         f = fields(i)!!
         fal = codegen_type_align(cg, f.val_type, f.rec_type)
         nal = fal > max_al | fal | max_al
         codegen_struct_align_step(cg, fields, i + 1, n, nal)

truncate_names: ast::Names, Int => ast::Names
truncate_names = names, n =>
   acc = ast::Names()
   n @ i => acc += (names(i) | _ | "")
   acc

truncate_vinfos: ast::VInfos, Int => ast::VInfos
truncate_vinfos = tis, n =>
   acc = ast::VInfos()
   n @ i => acc += (tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown)))
   acc

truncate_ints: IntArr, Int => IntArr
truncate_ints = arr, n =>
   acc = IntArr()
   n @ i => acc += (arr(i) | _ | 0)
   acc

is_internal_type_name: String => <>
is_internal_type_name = s =>
   s == "" || (?s !< 2 && s(0..2) == "__") || (?s !< 1 && s(0..1) == "#") ||
     (?s !< 1 && s(0..1) == "?")

ct_bind_find_at: String, Int => (ast::TypeInfo, <>)
ct_bind_find_at = name, i =>
   i < 0
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      |
         n = g.ct_bind_names(i) | _ | ""
         n == name
            |
               ti = g.ct_bind_tis(i) | _ |
                  ast::TypeInfo(Prim, ast::ValueType(Unknown))
               (ti, <+>)
            | ct_bind_find_at(name, i - 1)

ct_bind_find: String => (ast::TypeInfo, <>)
ct_bind_find = name =>
   ct_bind_find_at(name, ?g.ct_bind_names - 1)

ct_bind_find_dname_at: String, Int => String
ct_bind_find_dname_at = name, i =>
   i < 0
      | ""
      |
         n = g.ct_bind_names(i) | _ | ""
         n == name
            | (g.ct_bind_dnames(i) | _ | "")
            | ct_bind_find_dname_at(name, i - 1)

ct_bind_find_dname: String => String
ct_bind_find_dname = name =>
   ct_bind_find_dname_at(name, ?g.ct_bind_names - 1)

ct_bind_push: String, ast::TypeInfo => ()
ct_bind_push = name, ti =>
   g.ct_bind_names += name
   g.ct_bind_tis += ti
   dname = ti [TypeVar tv] (!is_internal_type_name(tv) | tv | "") | ""
   g.ct_bind_dnames += dname

ct_bind_set_last_dname: String => ()
ct_bind_set_last_dname = dname =>
   n = ?g.ct_bind_dnames
   n > 0 && dname != ""
      |
         names = truncate_names(g.ct_bind_dnames, n - 1)
         names += dname
         g.ct_bind_dnames = names

ct_bind_pop_to: Int => ()
ct_bind_pop_to = n =>
   names = truncate_names(g.ct_bind_names, n)
   tis = truncate_vinfos(g.ct_bind_tis, n)
   dnames = truncate_names(g.ct_bind_dnames, n)
   g.ct_bind_names = names
   g.ct_bind_tis = tis
   g.ct_bind_dnames = dnames

ct_cursor_find_at: String, Int => (ast::TypeInfo, Int, <>)
ct_cursor_find_at = name, i =>
   i < 0
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), 0, <->)
      |
         n = g.ct_cursor_names(i) | _ | ""
         n == name
            |
               ti = g.ct_cursor_tis(i) | _ |
                  ast::TypeInfo(Prim, ast::ValueType(Unknown))
               idx = g.ct_cursor_idxs(i) | _ | 0
               (ti, idx, <+>)
            | ct_cursor_find_at(name, i - 1)

ct_cursor_find: String => (ast::TypeInfo, Int, <>)
ct_cursor_find = name =>
   ct_cursor_find_at(name, ?g.ct_cursor_names - 1)

ct_cursor_push: String, ast::TypeInfo, Int => ()
ct_cursor_push = name, ti, idx =>
   g.ct_cursor_names += name
   g.ct_cursor_tis += ti
   g.ct_cursor_idxs += idx

ct_cursor_pop_to: Int => ()
ct_cursor_pop_to = n =>
   names = truncate_names(g.ct_cursor_names, n)
   tis = truncate_vinfos(g.ct_cursor_tis, n)
   idxs = truncate_ints(g.ct_cursor_idxs, n)
   g.ct_cursor_names = names
   g.ct_cursor_tis = tis
   g.ct_cursor_idxs = idxs

ct_val_bind_find_at: String, Int => (CtVal, <>)
ct_val_bind_find_at = name, i =>
   i < 0
      | (CtVal(None), <->)
      |
         n = g.ct_val_names(i) | _ | ""
         n == name
            |
               v = g.ct_val_vals(i) | _ | CtVal(None)
               (v, <+>)
            | ct_val_bind_find_at(name, i - 1)

ct_val_bind_find: String => (CtVal, <>)
ct_val_bind_find = name =>
   ct_val_bind_find_at(name, ?g.ct_val_names - 1)

ct_val_bind_push: String, CtVal => ()
ct_val_bind_push = name, val =>
   g.ct_val_names += name
   g.ct_val_vals += val

truncate_ct_vals_at: CtVals, Int, Int, CtVals => CtVals
truncate_ct_vals_at = vals, i, n, acc =>
   i == n || i == ?vals
      | acc
      |
         v = vals(i) | _ | CtVal(None)
         next = acc
         next += v
         truncate_ct_vals_at(vals, i + 1, n, next)

truncate_ct_vals: CtVals, Int => CtVals
truncate_ct_vals = vals, n =>
   truncate_ct_vals_at(vals, 0, n, CtVals())

ct_val_bind_pop_to: Int => ()
ct_val_bind_pop_to = n =>
   names = truncate_names(g.ct_val_names, n)
   vals = truncate_ct_vals(g.ct_val_vals, n)
   g.ct_val_names = names
   g.ct_val_vals = vals

rec_fields_equal_at: ast::FieldTypes, ast::FieldTypes, Int, Int => <>
rec_fields_equal_at = f1, f2, i, n =>
   i == n
      | <+>
      |
         f1i = f1(i)!!
         f2i = f2(i)!!
         match = f1i.name == f2i.name && f1i.val_type == f2i.val_type &&
           type_info_equal(f1i.rec_type, f2i.rec_type)
         match
            | rec_fields_equal_at(f1, f2, i + 1, n)
            | <->

enum_slots_equal_at: ast::EnumSlots, ast::EnumSlots, Int, Int => <>
enum_slots_equal_at = s1, s2, i, n =>
   i == n
      | <+>
      |
         s1i = s1(i)!!
         s2i = s2(i)!!
         same_p = s1i.has_payload | s2i.has_payload | !s2i.has_payload
         match = s1i.label == s2i.label && same_p &&
           (!s1i.has_payload || (s1i.payload_type == s2i.payload_type &&
             type_info_equal(s1i.payload_record, s2i.payload_record)))
         match
            | enum_slots_equal_at(s1, s2, i + 1, n)
            | <->

fn_params_equal_at: ast::VInfos, ast::VInfos, Int, Int => <>
fn_params_equal_at = p1, p2, i, n =>
   i == n
      | <+>
      |
         p1i = p1(i)!!
         p2i = p2(i)!!
         type_info_equal(p1i, p2i)
            | fn_params_equal_at(p1, p2, i + 1, n)
            | <->

type_info_equal: ast::TypeInfo, ast::TypeInfo => <>
type_info_equal = a, b =>
   a
      [Align a1]
         b
            [Align a2]
               a1.0 == a2.0 && type_info_equal(a1.1, a2.1)
            | type_info_equal(a1.1, b)
      [Prim p1]
         b
            [Prim p2] p1 == p2
            [Ram s2]
               is_flag_vt(p1) && !s2.0.has_payload && !s2.1.has_payload
            | <->
      [TypeVar v1]
         b [TypeVar v2] v1 == v2 | <->
      [Rec r1]
         b
            [Rec r2]
               same_sl = r1.1 | r2.1 | !r2.1
               same_sl && ?r1.0 == ?r2.0 &&
                 rec_fields_equal_at(r1.0, r2.0, 0, ?r1.0)
            | <->
      [Ram ram1]
         b
            [Prim p2]
               is_flag_vt(p2) && !ram1.0.has_payload && !ram1.1.has_payload
            [Ram ram2]
               l_same_p = ram1.0.has_payload | ram2.0.has_payload |
                  !ram2.0.has_payload
               r_same_p = ram1.1.has_payload | ram2.1.has_payload |
                  !ram2.1.has_payload
               l_ok = !ram1.0.has_payload ||
                 (ram1.0.payload_type == ram2.0.payload_type &&
                   type_info_equal(ram1.0.payload_record,
                     ram2.0.payload_record))
               r_ok = !ram1.1.has_payload ||
                 (ram1.1.payload_type == ram2.1.payload_type &&
                   type_info_equal(ram1.1.payload_record,
                     ram2.1.payload_record))
               l_same_p && r_same_p && l_ok && r_ok
            | <->
      [Enum s1]
         b
            [Enum s2]
               ?s1 == ?s2 && enum_slots_equal_at(s1, s2, 0, ?s1)
            | <->
      [Array a1]
         b
            [Array a2]
               a1.0 == a2.0 && type_info_equal(a1.1, a2.1)
            | <->
      [Map m1]
         b
            [Map m2]
               m1.0 == m2.0 && m1.1 == m2.1 && type_info_equal(m1.2, m2.2)
            | <->
      [Fn f1]
         b
            [Fn f2]
               ?f1.1 == ?f2.1 && fn_params_equal_at(f1.1, f2.1, 0, ?f1.1) &&
                 type_info_equal(f1.3, f2.3)
            | <->
      | <->

norm_slot_ti: ast::ValueType, ast::TypeInfo => ast::TypeInfo
norm_slot_ti = vt, ti =>
   ti
      [Prim p]
         p
            [Unknown] ast::TypeInfo(Prim, vt)
            | ti
      | ti

field_type_info: ast::RecordFieldType => ast::TypeInfo
field_type_info = fld =>
   norm_slot_ti(fld.val_type, fld.rec_type)

pstmts_typedef_ti_at: ast::Exprs, Int, Int, String => (ast::TypeInfo, <>)
pstmts_typedef_ti_at = stmts, i, n, name =>
   i == n
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      |
         st = stmts(i) | _ | ast::Expr(Int, 0)
         st
            [TypeDecl td]
               td.name == name || decl_bare_name(td.name, 0) == name
                  | (td.type_info, <+>)
                  | pstmts_typedef_ti_at(stmts, i + 1, n, name)
            | pstmts_typedef_ti_at(stmts, i + 1, n, name)

pstmts_typedef_ti: String => (ast::TypeInfo, <>)
pstmts_typedef_ti = name =>
   res = pstmts_typedef_ti_at(g.pstmts, 0, ?g.pstmts, name)
   res.1
      |
         res.0
            [TypeVar tv]
               tv != name
                  |
                     sub = pstmts_typedef_ti(tv)
                     sub.1 | sub | res
                  | res
            | res
      | res

strip_align_ti: ast::TypeInfo => ast::TypeInfo
strip_align_ti = ti =>
   ti
      [Align a] strip_align_ti(a.1)
      | ti

ctfe_canonical_ti_simple: ast::TypeInfo => ast::TypeInfo
ctfe_canonical_ti_simple = ti =>
   ti
      [Align a] ctfe_canonical_ti_simple(a.1)
      [TypeVar n]
         pt = pstmts_typedef_ti(n)
         pt.1
            | strip_align_ti(pt.0)
            |
               tn = type_name_to_vt(n)
               tn.1 | ast::TypeInfo(Prim, tn.0) | ti
      | ti

cursor_member_ti: ast::TypeInfo, Int => (ast::TypeInfo, <>)
cursor_member_ti = ti, idx =>
   ti
      [Align a] cursor_member_ti(a.1, idx)
      [Rec r]
         idx !< 0 && idx < ?r.0
            | (field_type_info(r.0(idx)!!), <+>)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      [Enum slots]
         idx !< 0 && idx < ?slots
            |
               sl = slots(idx)!!
               sl.has_payload
                  | (norm_slot_ti(sl.payload_type, sl.payload_record), <+>)
                  | (ast::TypeInfo(Prim, ast::ValueType(Unit)), <+>)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

resolve_type_record_index: Cg, ast::TypeInfo, ast::Expr => (ast::TypeInfo, <>)
resolve_type_record_index = cg, ti, index_expr =>
   can_ti = ctfe_canonical_ti(cg, ti)
   can_ti
      [Rec r]
         saved_discard = cg.discard_result
         cg.discard_result = <->
         idx_v = expr::codegen_eval(cg, index_expr)
         cg.discard_result = saved_discard
         llvm_val_opt(idx_v.0)
            | iv =>
               LLVMIsConstant(iv) != 0
                  |
                     idx = LLVMConstIntGetZExtValue(iv)
                     idx !< 0 && idx < ?r.0
                        |
                           fld = r.0(idx)!!
                           (field_type_info(fld), <+>)
                        | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                  | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

resolve_type_val_member_type: Cg, ast::MemberExpr => (ast::TypeInfo, <>)
resolve_type_val_member_type = cg, m =>
   m.target
      [Member im]
         im.field_name == ""
            |
               vname = im.target [Var v] v | ""
               dt = vname != "" | var_dtype(cg, vname) | ""
               is_user_type(cg, dt)
                  |
                     resolve_type_record_index(cg, typedef_ti(cg, dt),
                       im.index_expr)
                  | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

subst_ct_binds_vt: ast::TypeInfo, ast::ValueType => ast::ValueType
subst_ct_binds_vt = orig_ti, fallback =>
   orig_ti
      [TypeVar n]
         ct = ct_bind_find(n)
         ct.1 | vt_from_ti(ct.0) | fallback
      | fallback

subst_ct_binds_ram_slot: ast::RamSlotInfo => ast::RamSlotInfo
subst_ct_binds_ram_slot = sl =>
   !sl.has_payload | --| sl
   pt = subst_ct_binds_vt(sl.payload_record, sl.payload_type)
   ast::RamSlotInfo(<+>, pt, subst_ct_binds_ti(sl.payload_record))

subst_ct_binds_ti: ast::TypeInfo => ast::TypeInfo
subst_ct_binds_ti = ti =>
   ti
      [TypeVar name]
         ct = ct_bind_find(name)
         ct.1 | ct.0 | ti
      [Align a]
         ast::TypeInfo(Align, (a.0, subst_ct_binds_ti(a.1)))
      [Ram s]
         ast::TypeInfo(Ram, (subst_ct_binds_ram_slot(s.0),
           subst_ct_binds_ram_slot(s.1)))
      [Rec r]
         new_flds = ast::FieldTypes()
         elem_vt' = r.3
         r.0 @ f, i =>
            new_rti = subst_ct_binds_ti(f.rec_type)
            sub_vt = subst_ct_binds_vt(f.rec_type, f.val_type)
            i == 0 && (r.1 || r.2) | (elem_vt' = sub_vt)
            new_flds += ast::RecordFieldType(f.name, sub_vt, new_rti,
              f.has_default, f.default_expr)
         ast::TypeInfo(Rec, (new_flds, r.1, r.2, elem_vt', r.4, r.5))
      [Array a]
         new_eti = subst_ct_binds_ti(a.1)
         new_evt = subst_ct_binds_vt(a.1, a.0)
         ast::TypeInfo(Array, (new_evt, new_eti, a.2))
      [Map m]
         new_vti = subst_ct_binds_ti(m.2)
         new_vvt = subst_ct_binds_vt(m.2, m.1)
         ast::TypeInfo(Map, (m.0, new_vvt, new_vti))
      [Fn f]
         nvts = ast::VTypes()
         ntis = ast::VInfos()
         f.1 @ pi, i =>
            new_pti = subst_ct_binds_ti(pi)
            old_vt = f.0(i) | _ | ast::ValueType(Unknown)
            new_pvt = subst_ct_binds_vt(pi, old_vt)
            nvts += new_pvt
            ntis += new_pti
         new_rti = subst_ct_binds_ti(f.3)
         new_rvt = subst_ct_binds_vt(f.3, f.2)
         ast::TypeInfo(Fn, (nvts, ntis, new_rvt, new_rti, f.4))
      [ThreadId t]
         new_tti = subst_ct_binds_ti(t.1)
         new_tvt = subst_ct_binds_vt(t.1, t.0)
         ast::TypeInfo(ThreadId, (new_tvt, new_tti))
      | ti

field_types_has_name: ast::FieldTypes, String, Int => <>
field_types_has_name = fts, name, i =>
   i !< ?fts | --| <->
   fts(i)!!.name == name | --| <+>
   field_types_has_name(fts, name, i + 1)

ti_has_member_name: Cg, ast::TypeInfo, String => <>
ti_has_member_name = cg, ti, mname =>
   bf_opt = ti_get_bitfield(cg, ti)
   bf_opt
      | bf => <>(find_bitfield_field(bf.fields, mname))
      |
         can_ti = ctfe_canonical_ti(cg, ti)
         can_ti
            [Rec r] !r.1 && field_types_has_name(r.0, mname, 0)
            [Bitfield bf] <>(find_bitfield_field(bf.fields, mname))
            [Enum slots] <>(enum_slot_index(slots, mname))
            | <->

ti_has_member_name_simple: ast::TypeInfo, String => <>
ti_has_member_name_simple = ti, mname =>
   can_ti = ctfe_canonical_ti_simple(ti)
   can_ti
      [Rec r] !r.1 && field_types_has_name(r.0, mname, 0)
      [Bitfield bf] <>(find_bitfield_field(bf.fields, mname))
      [Enum slots] <>(enum_slot_index(slots, mname))
      | <->

mod_member_qname: ast::Expr => String
mod_member_qname = e =>
   e
      [Var v] v
      [Member m]
         m.is_module_access
            |
               p = mod_member_qname(m.target)
               p != "" | "${p}::${m.field_name}" | ""
            | ""
      | ""

resolve_type_value_simple: ast::Expr => (ast::TypeInfo, <>)
resolve_type_value_simple = expr =>
   expr
      [SizeOf so]
         (subst_ct_binds_ti(so.rec_type), <+>)
      [Var v]
         ct = ct_bind_find(v)
         ct.1
            | (ct.0, <+>)
            |
               tn = type_name_to_vt(v)
               tn.1
                  | (ast::TypeInfo(Prim, tn.0), <+>)
                  | pstmts_typedef_ti(v)
      [Member m]
         m.is_module_access
            |
               qn = mod_member_qname(expr)
               qn != "" | pstmts_typedef_ti(qn) |
                  (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
            |
               m.field_name == ""
                  |
                     tgt = resolve_type_value_simple(m.target)
                     tgt.1
                        |
                           can_tgt = ctfe_canonical_ti_simple(tgt.0)
                           can_tgt
                              [Rec r]
                                 idx_val = m.index_expr
                                    [Int idx] idx
                                    [Var iv]
                                       cur_i = ct_cursor_find(iv)
                                       cur_i.2 | cur_i.1 | -1
                                    | -1
                                 idx_val !< 0 && idx_val < ?r.0
                                    |
                                       fld = r.0(idx_val)!!
                                       (field_type_info(fld), <+>)
                                    |
                                       (ast::TypeInfo(Prim,
                                         ast::ValueType(Unknown)), <->)
                              | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                        | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                  |
                     m.field_name == "type" || m.field_name == "Type"
                        |
                           cname = m.target [Var cv] cv | ""
                           cur = cname != ""
                              | ct_cursor_find(cname)
                              | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), 0, <->)
                           cur.2
                              | cursor_member_ti(ctfe_canonical_ti_simple(cur.0), cur.1)
                              |
                                 m.field_name == "Type"
                                    | resolve_type_value_simple(m.target)
                                    | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                        | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      [Record r]
         ?r.fields == 0
            | (ast::TypeInfo(Prim, ast::ValueType(Unit)), <+>)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

resolve_type_value: Cg, ast::Expr => (ast::TypeInfo, <>)
resolve_type_value = cg, expr =>
   s = resolve_type_value_simple(expr)
   s.1
      | s
      |
         expr
            [Var v]
               is_user_type(cg, v)
                  | (typedef_ti(cg, v), <+>)
                  | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
            [Member m]
               m.is_module_access
                  |
                     qn = mod_member_qname(expr)
                     qn != "" && is_user_type(cg, qn)
                        | (typedef_ti(cg, qn), <+>)
                        | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                  |
                     m.field_name == ""
                        |
                           tgt = resolve_type_value(cg, m.target)
                           tgt.1
                              | resolve_type_record_index(cg, tgt.0, m.index_expr)
                              | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                        |
                           m.field_name == "type" || m.field_name == "Type"
                              |
                                 cname = m.target [Var cv] cv | ""
                                 cur = cname != ""
                                    | ct_cursor_find(cname)
                                    | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), 0, <->)
                                 cur.2
                                    | cursor_member_ti(ctfe_canonical_ti(cg, cur.0), cur.1)
                                    |
                                       m.field_name == "Type"
                                          |
                                             t_res = resolve_type_value(cg, m.target)
                                             t_res.1
                                                | t_res
                                                | resolve_type_val_member_type(cg, m)
                                          | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                              | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

ctfe_eval_type_flag_simple: ast::Expr => (Int, <>)
ctfe_eval_type_flag_simple = cond =>
   cond
      [Unary u]
         u.0
            [Not]
               inner = ctfe_eval_type_flag_simple(u.1)
               inner.1 | ((inner.0 == 0 | 1 | 0), <+>) | (0, <->)
            | (0, <->)
      [Bin t]
         op = t.0
         is_eq = op [Eq]
         is_neq = op [NotEq]
         is_eq || is_neq
            |
               lt = resolve_type_value_simple(t.1)
               rt = resolve_type_value_simple(t.2)
               lt.1 && rt.1
                  |
                     eq = type_info_equal(lt.0, rt.0)
                     flag = is_neq != eq
                     (flag | 1 | 0, <+>)
                  | (0, <->)
            |
               op
                  [And]
                     lf = ctfe_eval_type_flag_simple(t.1)
                     lf.1 && lf.0 == 0
                        | (0, <+>)
                        |
                           rf = ctfe_eval_type_flag_simple(t.2)
                           lf.1 && rf.1 | (rf.0 != 0 | 1 | 0, <+>) | (0, <->)
                  [Or]
                     lf = ctfe_eval_type_flag_simple(t.1)
                     lf.1 && lf.0 != 0
                        | (1, <+>)
                        |
                           rf = ctfe_eval_type_flag_simple(t.2)
                           lf.1 && rf.1 | (rf.0 != 0 | 1 | 0, <+>) | (0, <->)
                  | (0, <->)
      [Call c]
         c.fn_name == "#has_member" && ?c.args == 2
            |
               rt = resolve_type_value_simple(c.args(0)!!)
               mname = c.args(1)!!
                  [Var v] v
                  [Str s] s
                  | ""
               rt.1 && mname != ""
                  |
                     can_rt = ctfe_canonical_ti_simple(rt.0)
                     is_tv = can_rt [TypeVar]
                     is_tv
                        | (0, <->)
                        | (ti_has_member_name_simple(can_rt, mname) | 1 | 0, <+>)
                  | (0, <->)
            | (0, <->)
      | (0, <->)

ctfe_eval_type_flag: Cg, ast::Expr => (Int, <>)
ctfe_eval_type_flag = cg, cond =>
   cond
      [Unary u]
         u.0
            [Not]
               inner = ctfe_eval_type_flag(cg, u.1)
               inner.1 | ((inner.0 == 0 | 1 | 0), <+>) | (0, <->)
            | (0, <->)
      [Bin t]
         op = t.0
         is_eq = op [Eq]
         is_neq = op [NotEq]
         is_eq || is_neq
            |
               lt = resolve_type_value(cg, t.1)
               rt = resolve_type_value(cg, t.2)
               lt.1 && rt.1
                  |
                     eq = type_info_equal(lt.0, rt.0)
                     flag = is_neq != eq
                     (flag | 1 | 0, <+>)
                  | (0, <->)
            |
               op
                  [And]
                     lf = ctfe_eval_type_flag(cg, t.1)
                     lf.1 && lf.0 == 0
                        | (0, <+>)
                        |
                           rf = ctfe_eval_type_flag(cg, t.2)
                           lf.1 && rf.1 | (rf.0 != 0 | 1 | 0, <+>) | (0, <->)
                  [Or]
                     lf = ctfe_eval_type_flag(cg, t.1)
                     lf.1 && lf.0 != 0
                        | (1, <+>)
                        |
                           rf = ctfe_eval_type_flag(cg, t.2)
                           lf.1 && rf.1 | (rf.0 != 0 | 1 | 0, <+>) | (0, <->)
                  | (0, <->)
      [Call c]
         c.fn_name == "#has_member" && ?c.args == 2
            |
               rt = resolve_type_value(cg, c.args(0)!!)
               mname0 = c.args(1)!!
                  [Var v] v
                  [Str s] s
                  | ""
               mname = mname0 != ""
                  | mname0
                  |
                     ev_m = match::ctfe_eval(cg, c.args(1)!!, CtFrames(), 0)
                     ev_m.0 [Str ms] ms | ""
               rt.1 && mname != ""
                  | (ti_has_member_name(cg, rt.0, mname) | 1 | 0, <+>)
                  | (0, <->)
            | (0, <->)
      | (0, <->)

ctfe_canonical_ti: Cg, ast::TypeInfo => ast::TypeInfo
ctfe_canonical_ti = cg, ti =>
   ti
      [Align a] ctfe_canonical_ti(cg, a.1)
      [TypeVar n]
         is_user_type(cg, n)
            | strip_align_ti(typedef_ti(cg, n))
            |
               tn = type_name_to_vt(n)
               tn.1 | ast::TypeInfo(Prim, tn.0) | ti
      | ti

is_rec_homo_fields: ast::FieldTypes, ast::TypeInfo, ast::ValueType, Int,
  Int => <>
is_rec_homo_fields = flds, f0_ti, f0_vt, i, n =>
   i == n
      | <+>
      |
         fi = flds(i)!!
         fi.val_type == f0_vt && type_info_equal(fi.rec_type, f0_ti)
            | is_rec_homo_fields(flds, f0_ti, f0_vt, i + 1, n)
            | <->

is_rec_homo: ast::TypeInfo => <>
is_rec_homo = ti =>
   ti
      [Align a] is_rec_homo(a.1)
      [Rec r]
         nf = ?r.0
         nf == 0
            | <->
            |
               f0 = r.0(0)!!
               is_rec_homo_fields(r.0, f0.rec_type, f0.val_type, 1, nf)
      | <->

type_is_record: ast::TypeInfo => <>
type_is_record = ti =>
   ti
      [Align a] type_is_record(a.1)
      [Rec r] !r.1
      [Prim p]
         is_rec = p [Record, Unit]
         is_rec
      | <->

type_is_enum: ast::TypeInfo => <>
type_is_enum = ti =>
   ti
      [Enum] <+>
      [Prim p]
         is_en = p [Enum]
         is_en
      | <->

type_is_ram: ast::TypeInfo => <>
type_is_ram = ti =>
   ti
      [Ram] <+>
      [Prim p]
         is_rm = p [Ram, Flag]
         is_rm
      | <->

type_is_fn: ast::TypeInfo => <>
type_is_fn = ti =>
   ti
      [Fn] <+>
      [Prim p]
         is_f = p [Fn]
         is_f
      | <->

f0_is_unit: ast::FieldTypes => <>
f0_is_unit = flds =>
   ?flds == 1
      |
         f0 = flds(0)!!
         f0.val_type [Unit]
      | <->

type_is_unit: ast::TypeInfo => <>
type_is_unit = ti =>
   ti
      [Prim p]
         is_u = p [Unit]
         is_u
      [Rec r]
         !r.1 && (?r.0 == 0 || f0_is_unit(r.0))
      | <->

type_is_homogeneous: ast::TypeInfo => <>
type_is_homogeneous = ti =>
   ti
      [Rec r] !r.1 && is_rec_homo(ti)
      | <->

type_is_array: ast::TypeInfo => <>
type_is_array = ti =>
   ti
      [Array] <+>
      [Prim p]
         is_arr = p [Array]
         is_arr
      | <->

type_is_slice: ast::TypeInfo => <>
type_is_slice = ti =>
   ti
      [Rec r] r.1
      [Prim p]
         is_sl = p [Slice]
         is_sl
      | <->

type_is_map: ast::TypeInfo => <>
type_is_map = ti =>
   ti
      [Map] <+>
      [Prim p]
         is_mp = p [Map]
         is_mp
      | <->

type_is_indexable: ast::TypeInfo => <>
type_is_indexable = ti =>
   ti
      [Array, Map] <+>
      [Rec r] r.1 || is_rec_homo(ti)
      [Prim p]
         is_idx = p [Array, Slice, Map, Str]
         is_idx
      | <->

type_is_iterable: ast::TypeInfo => <>
type_is_iterable = ti =>
   ti
      [Array, Map] <+>
      [Rec r] r.1 || is_rec_homo(ti)
      [Prim p]
         is_it = p [Array, Slice, Map] || is_int_vt(p)
         is_it
      | <->

type_is_scalar: ast::TypeInfo => <>
type_is_scalar = ti =>
   ti
      [Prim p]
         is_sc = p [RawPtr, Flag] || is_int_vt(p) || is_float_vt(p)
         is_sc
      | <->

type_is_int: ast::TypeInfo => <>
type_is_int = ti =>
   ti
      [Prim p] is_int_vt(p)
      | <->

type_is_float: ast::TypeInfo => <>
type_is_float = ti =>
   ti
      [Prim p] is_float_vt(p)
      | <->

type_is_numeric: ast::TypeInfo => <>
type_is_numeric = ti =>
   ti
      [Prim p]
         is_num = is_int_vt(p) || is_float_vt(p)
         is_num
      | <->

type_is_pointer: ast::TypeInfo => <>
type_is_pointer = ti =>
   ti
      [Prim p]
         is_ptr = p [RawPtr]
         is_ptr
      | <->

type_pred_name_from_str: String => String
type_pred_name_from_str = s =>
   has_type_pfx = ?s > 6 && s(0..6) == "type::"
   has_type_pfx
      | s(6..(?s))
      |
         has_is_pfx = ?s > 3 && s(0..3) == "is_"
         has_is_pfx
            | s
            | ""

type_pred_name_from_expr: ast::Expr => String
type_pred_name_from_expr = e =>
   e
      [Member m]
         vname = m.target [Var v] v | ""
         m.is_module_access || vname == "type"
            | type_pred_name_from_str(m.field_name)
            | ""
      [Var v] type_pred_name_from_str(v)
      | ""

call_type_pred_name: ast::CallExpr => String
call_type_pred_name = call =>
   call.fn_name != ""
      | type_pred_name_from_str(call.fn_name)
      | type_pred_name_from_expr(call.fn_target)

eval_type_predicate_simple: String, ast::TypeInfo => <>
eval_type_predicate_simple = pred, ti =>
   pred
      ["is_record"] type_is_record(ti)
      ["is_enum"] type_is_enum(ti)
      ["is_ram"] type_is_ram(ti)
      ["is_fn"] type_is_fn(ti)
      ["is_unit"] type_is_unit(ti)
      ["is_homogeneous"] type_is_homogeneous(ti)
      ["is_array"] type_is_array(ti)
      ["is_slice"] type_is_slice(ti)
      ["is_map"] type_is_map(ti)
      ["is_indexable"] type_is_indexable(ti)
      ["is_iterable"] type_is_iterable(ti)
      ["is_scalar"] type_is_scalar(ti)
      ["is_int"] type_is_int(ti)
      ["is_float"] type_is_float(ti)
      ["is_numeric"] type_is_numeric(ti)
      ["is_pointer"] type_is_pointer(ti)
      | <->

eval_type_predicate: Cg, String, ast::TypeInfo => <>
eval_type_predicate = cg, pred, ti =>
   eval_type_predicate_simple(pred, ctfe_canonical_ti(cg, ti))

parse_pos_int: String, Int, Int, Int => (Int, <>)
parse_pos_int = s, i, n, acc =>
   i == n
      | (acc, n > 0)
      |
         c = s(i)
         c [48..=57]
            | parse_pos_int(s, i + 1, n, acc * 10 + (c - 48))
            | (0, <->)

ctfe_resolve_fixed_type_simple: String => (ast::TypeInfo, <>)
ctfe_resolve_fixed_type_simple = bname =>
   tn = type_name_to_vt(bname)
   tn.1
      | (ast::TypeInfo(Prim, tn.0), <+>)
      | pstmts_typedef_ti(bname)

ctfe_resolve_fixed_type: Cg, String => (ast::TypeInfo, <>)
ctfe_resolve_fixed_type = cg, bname =>
   tn = type_name_to_vt(bname)
   tn.1
      | (ast::TypeInfo(Prim, tn.0), <+>)
      |
         is_user_type(cg, bname)
            | (typedef_ti(cg, bname), <+>)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

ctfe_bind_matches_simple: String, ast::TypeInfo => <>
ctfe_bind_matches_simple = bname, slot_ti =>
   bname == "" || bname == "_"
      | <+>
      |
         fx = ctfe_resolve_fixed_type_simple(bname)
         fx.1
            | type_info_equal(ctfe_canonical_ti_simple(slot_ti),
              ctfe_canonical_ti_simple(fx.0))
            | <+>

ctfe_bind_matches: Cg, String, ast::TypeInfo => <>
ctfe_bind_matches = cg, bname, slot_ti =>
   bname == "" || bname == "_"
      | <+>
      |
         fx = ctfe_resolve_fixed_type(cg, bname)
         fx.1
            | type_info_equal(ctfe_canonical_ti(cg, slot_ti),
              ctfe_canonical_ti(cg, fx.0))
            | <+>

ctfe_binds_match_slots_simple: ast::Names, ast::VInfos, Int, Int => <>
ctfe_binds_match_slots_simple = binds, slots, i, n =>
   i == n || i == ?slots
      | <+>
      |
         ctfe_bind_matches_simple(binds(i)!!, slots(i)!!)
            | ctfe_binds_match_slots_simple(binds, slots, i + 1, n)
            | <->

ctfe_binds_match_slots: Cg, ast::Names, ast::VInfos, Int, Int => <>
ctfe_binds_match_slots = cg, binds, slots, i, n =>
   i == n || i == ?slots
      | <+>
      |
         ctfe_bind_matches(cg, binds(i)!!, slots(i)!!)
            | ctfe_binds_match_slots(cg, binds, slots, i + 1, n)
            | <->

ctfe_bind_push_if_var_simple: String, ast::TypeInfo => ()
ctfe_bind_push_if_var_simple = bname, slot_ti =>
   bname != "" && bname != "_"
      |
         fx = ctfe_resolve_fixed_type_simple(bname)
         !fx.1 | ct_bind_push(bname, slot_ti)

ctfe_bind_push_if_var: Cg, String, ast::TypeInfo => ()
ctfe_bind_push_if_var = cg, bname, slot_ti =>
   bname != "" && bname != "_"
      |
         fx = ctfe_resolve_fixed_type(cg, bname)
         !fx.1 | ct_bind_push(bname, slot_ti)

ctfe_extract_pattern_slots: String, ast::TypeInfo => (ast::VInfos, <>)
ctfe_extract_pattern_slots = tag, can_ti =>
   tag
      ["#type:()"] (ast::VInfos(), type_is_unit(can_ti))
      ["#type:(..)"]
         (ast::VInfos(), type_is_record(can_ti) && !type_is_unit(can_ti))
      ["#type:<..>"] (ast::VInfos(), type_is_enum(can_ti))
      ["#type:<>"]
         is_bare_flag = can_ti
            [Prim p] is_flag_vt(p)
            [Ram s] !s.0.has_payload && !s.1.has_payload
            | <->
         (ast::VInfos(), is_bare_flag)
      ["#type:<P|>"]
         can_ti
            [Ram s]
               s.0.has_payload && !s.1.has_payload
                  |
                     slots = ast::VInfos()
                     slots += norm_slot_ti(s.0.payload_type, s.0.payload_record)
                     (slots, <+>)
                  | (ast::VInfos(), <->)
            | (ast::VInfos(), <->)
      ["#type:<|N>"]
         can_ti
            [Ram s]
               !s.0.has_payload && s.1.has_payload
                  |
                     slots = ast::VInfos()
                     slots += norm_slot_ti(s.1.payload_type, s.1.payload_record)
                     (slots, <+>)
                  | (ast::VInfos(), <->)
            | (ast::VInfos(), <->)
      ["#type:<P|N>"]
         can_ti
            [Ram s]
               s.0.has_payload && s.1.has_payload
                  |
                     slots = ast::VInfos()
                     slots += norm_slot_ti(s.0.payload_type, s.0.payload_record)
                     slots += norm_slot_ti(s.1.payload_type, s.1.payload_record)
                     (slots, <+>)
                  | (ast::VInfos(), <->)
            | (ast::VInfos(), <->)
      ["#type:{}"]
         can_ti
            [Array a]
               slots = ast::VInfos()
               slots += norm_slot_ti(a.0, a.1)
               (slots, <+>)
            | (ast::VInfos(), <->)
      ["#type:[]"]
         can_ti
            [Rec r]
               r.1
                  |
                     e_ti = ?r.0 > 0
                        | field_type_info(r.0(0)!!)
                        | ast::TypeInfo(Prim, r.3)
                     slots = ast::VInfos()
                     slots += e_ti
                     (slots, <+>)
                  | (ast::VInfos(), <->)
            | (ast::VInfos(), <->)
      ["#type:^"]
         can_ti
            [Map m]
               slots = ast::VInfos()
               slots += ast::TypeInfo(Prim, m.0)
               slots += norm_slot_ti(m.1, m.2)
               (slots, <+>)
            | (ast::VInfos(), <->)
      ["#type:(*..)"]
         can_ti
            [Rec r]
               !r.1 && ?r.0 > 0 && is_rec_homo(can_ti)
                  |
                     slots = ast::VInfos()
                     slots += field_type_info(r.0(0)!!)
                     (slots, <+>)
                  | (ast::VInfos(), <->)
            | (ast::VInfos(), <->)
      |
         ?tag > 9 && tag(0..8) == "#type:(*"
            |
               np = parse_pos_int(tag, 8, ?tag - 1, 0)
               np.1
                  |
                     can_ti
                        [Rec r]
                           !r.1 && ?r.0 == np.0 && is_rec_homo(can_ti)
                              |
                                 slots = ast::VInfos()
                                 slots += field_type_info(r.0(0)!!)
                                 (slots, <+>)
                              | (ast::VInfos(), <->)
                        | (ast::VInfos(), <->)
                  | (ast::VInfos(), <->)
            | (ast::VInfos(), <->)

ctfe_push_branch_type_binds_simple: ast::ChoiceBranch, ast::Expr => ()
ctfe_push_branch_type_binds_simple = br, cond =>
   is_var = br.kind [Variant]
   is_var && ?br.variant_names > 0 && ?br.bind_vars > 0
      |
         tag = br.variant_names(0)!!
         ?tag > 6 && tag(0..6) == "#type:"
            |
               cond_ti = resolve_type_value_simple(cond)
               cond_ti.1
                  |
                     ext = ctfe_extract_pattern_slots(tag,
                       ctfe_canonical_ti_simple(cond_ti.0))
                     ext.1
                        |
                           nb = ?br.bind_vars < ?ext.0 | ?br.bind_vars | ?ext.0
                           nb @ i =>
                              ctfe_bind_push_if_var_simple(br.bind_vars(i)!!,
                                ext.0(i)!!)

ctfe_push_branch_type_binds: Cg, ast::ChoiceBranch, ast::Expr => ()
ctfe_push_branch_type_binds = cg, br, cond =>
   is_var = br.kind [Variant]
   is_var && ?br.variant_names > 0 && ?br.bind_vars > 0
      |
         tag = br.variant_names(0)!!
         ?tag > 6 && tag(0..6) == "#type:"
            |
               cond_ti = resolve_type_value(cg, cond)
               cond_ti.1
                  |
                     ext = ctfe_extract_pattern_slots(tag,
                       ctfe_canonical_ti(cg, cond_ti.0))
                     ext.1
                        |
                           nb = ?br.bind_vars < ?ext.0 | ?br.bind_vars | ?ext.0
                           nb @ i =>
                              ctfe_bind_push_if_var(cg, br.bind_vars(i)!!,
                                ext.0(i)!!)

ctfe_variant_names_match: Cg, ast::Names, ast::Names, Int, Int,
  ast::TypeInfo => <>
ctfe_variant_names_match = cg, vnames, binds, i, n, target_ti =>
   i == n
      | <->
      |
         vname = vnames(i) | _ | ""
         ?vname > 6 && vname(0..6) == "#type:"
            |
               ext = ctfe_extract_pattern_slots(vname,
                 ctfe_canonical_ti(cg, target_ti))
               ext.1 && ctfe_binds_match_slots(cg, binds, ext.0, 0, ?binds)
                  | <+>
                  | ctfe_variant_names_match(cg, vnames, binds, i + 1, n,
                    target_ti)
            |
               v_res = resolve_type_value(cg, ast::Expr(Var, vname))
               v_res.1 && type_info_equal(ctfe_canonical_ti(cg, target_ti),
                 ctfe_canonical_ti(cg, v_res.0))
                 | <+>
                 | ctfe_variant_names_match(cg, vnames, binds, i + 1, n,
                   target_ti)

ctfe_variant_names_match_simple: ast::Names, ast::Names, Int, Int,
  ast::TypeInfo => <>
ctfe_variant_names_match_simple = vnames, binds, i, n, target_ti =>
   i == n
      | <->
      |
         vname = vnames(i) | _ | ""
         ?vname > 6 && vname(0..6) == "#type:"
            |
               ext = ctfe_extract_pattern_slots(vname,
                 ctfe_canonical_ti_simple(target_ti))
               ext.1 && ctfe_binds_match_slots_simple(binds, ext.0, 0, ?binds)
                  | <+>
                  | ctfe_variant_names_match_simple(vnames, binds, i + 1, n,
                    target_ti)
            |
               v_res = resolve_type_value_simple(ast::Expr(Var, vname))
               v_res.1 && type_info_equal(ctfe_canonical_ti_simple(target_ti),
                 ctfe_canonical_ti_simple(v_res.0))
                 | <+>
                 | ctfe_variant_names_match_simple(vnames, binds, i + 1, n,
                   target_ti)

ctfe_case_values_match: Cg, ast::Exprs, Int, Int, ast::TypeInfo => <>
ctfe_case_values_match = cg, cvals, i, n, target_ti =>
   i == n
      | <->
      |
         cval = cvals(i) | _ | ast::Expr(Int, 0)
         pred = type_pred_name_from_expr(cval)
         pred != ""
            |
               matched = eval_type_predicate(cg, pred, target_ti)
               matched
                  | <+>
                  | ctfe_case_values_match(cg, cvals, i + 1, n, target_ti)
            |
               c_res = resolve_type_value(cg, cval)
               c_res.1 && type_info_equal(ctfe_canonical_ti(cg, target_ti),
                 ctfe_canonical_ti(cg, c_res.0))
                 | <+>
                 | ctfe_case_values_match(cg, cvals, i + 1, n, target_ti)

ctfe_case_values_match_simple: ast::Exprs, Int, Int, ast::TypeInfo => <>
ctfe_case_values_match_simple = cvals, i, n, target_ti =>
   i == n
      | <->
      |
         cval = cvals(i) | _ | ast::Expr(Int, 0)
         pred = type_pred_name_from_expr(cval)
         pred != ""
            |
               matched = eval_type_predicate_simple(pred, target_ti)
               matched
                  | <+>
                  | ctfe_case_values_match_simple(cvals, i + 1, n, target_ti)
            |
               c_res = resolve_type_value_simple(cval)
               c_res.1 && type_info_equal(ctfe_canonical_ti_simple(target_ti),
                 ctfe_canonical_ti_simple(c_res.0))
                 | <+>
                 | ctfe_case_values_match_simple(cvals, i + 1, n, target_ti)

ctfe_branch_matches_type: Cg, ast::ChoiceBranch, ast::TypeInfo => <>
ctfe_branch_matches_type = cg, br, target_ti =>
   is_bare = br.kind [Bare]
   is_bare
      | <+>
      |
         br.kind
            [Variant]
               ctfe_variant_names_match(cg, br.variant_names, br.bind_vars, 0,
                 ?br.variant_names, target_ti)
            [Case]
               ctfe_case_values_match(cg, br.case_values, 0,
                 ?br.case_values, target_ti)
            [Predicate]
               pred = type_pred_name_from_expr(br.pred_fn)
               pred != ""
                  | eval_type_predicate(cg, pred, target_ti)
                  | <->
            | <->

ctfe_branch_matches_type_simple: ast::ChoiceBranch, ast::TypeInfo => <>
ctfe_branch_matches_type_simple = br, target_ti =>
   is_bare = br.kind [Bare]
   is_bare
      | <+>
      |
         br.kind
            [Variant]
               ctfe_variant_names_match_simple(br.variant_names, br.bind_vars,
                 0, ?br.variant_names, target_ti)
            [Case]
               ctfe_case_values_match_simple(br.case_values, 0,
                 ?br.case_values, target_ti)
            [Predicate]
               pred = type_pred_name_from_expr(br.pred_fn)
               pred != ""
                  | eval_type_predicate_simple(pred, target_ti)
                  | <->
            | <->

ctfe_find_matching_type_branch: Cg, ast::Branches, Int, Int,
  ast::TypeInfo => Int
ctfe_find_matching_type_branch = cg, branches, i, n, target_ti =>
   i == n
      | -1
      |
         br = branches(i) | _ | ast::ChoiceBranch(ast::GuardKind(Bare),
           ast::Exprs(), ast::Expr(Int, 0), ast::Names(), ast::Names(), <->,
           ast::Expr(Int, 0))
         ctfe_branch_matches_type(cg, br, target_ti)
            | i
            | ctfe_find_matching_type_branch(cg, branches, i + 1, n, target_ti)

ctfe_find_matching_type_branch_simple: ast::Branches, Int, Int,
  ast::TypeInfo => Int
ctfe_find_matching_type_branch_simple = branches, i, n, target_ti =>
   i == n
      | -1
      |
         br = branches(i) | _ | ast::ChoiceBranch(ast::GuardKind(Bare),
           ast::Exprs(), ast::Expr(Int, 0), ast::Names(), ast::Names(), <->,
           ast::Expr(Int, 0))
         ctfe_branch_matches_type_simple(br, target_ti)
            | i
            | ctfe_find_matching_type_branch_simple(branches, i + 1, n,
              target_ti)

ctfe_eval_type_choice_simple: ast::ChoiceExpr => (Int, <>)
ctfe_eval_type_choice_simple = c =>
   ct = ctfe_eval_type_flag_simple(c.cond)
   ct.1
      |
         idx' = ct.0 == 0 | 1 | 0
         (idx', <+>)
      |
         cond_ti = resolve_type_value_simple(c.cond)
         cond_ti.1
            |
               idx' = ctfe_find_matching_type_branch_simple(c.branches, 0,
                 ?c.branches, cond_ti.0)
               (idx', <+>)
            | (-1, <->)

ctfe_eval_type_choice: Cg, ast::ChoiceExpr => (Int, <>)
ctfe_eval_type_choice = cg, c =>
   ct = ctfe_eval_type_flag(cg, c.cond)
   ct.1
      |
         idx' = ct.0 == 0 | 1 | 0
         (idx', <+>)
      |
         cond_ti = resolve_type_value(cg, c.cond)
         cond_ti.1
            |
               idx' = ctfe_find_matching_type_branch(cg, c.branches, 0,
                 ?c.branches, cond_ti.0)
               (idx', <+>)
            | (-1, <->)

// The positive slot's payload ValueType of a declared ram TypeInfo.
ram_payload_type: ast::TypeInfo => ast::ValueType
ram_payload_type = ti =>
   ti
      [Ram s] s.0.payload_type
      | ast::ValueType(Unknown)

// The slot index of a variant label in a declared enum's slots (-1 if absent).
// The EnumSlots array is threaded through a param (an '['Enum s']'-bound local
// lacks the array TypeInfo for direct indexing — an earlier bind gap).
enum_slot_index: ast::EnumSlots, String => <Int|>
enum_slot_index = slots, label => enum_find_index(slots, label, 0)

enum_find_index: ast::EnumSlots, String, Int => <Int|>
enum_find_index = s, label, acc =>
   acc < ?s
      |
         sl = s(acc)!!
         sl.label == label | <+ acc +> | enum_find_index(s, label, acc + 1)
      | <-->

// The payload ValueType of a variant slot (Unknown if it carries none).
enum_slot_payload: ast::EnumSlots, String => ast::ValueType
enum_slot_payload = slots, label => enum_find_payload(slots, label, ast::ValueType(Unknown))

enum_find_payload: ast::EnumSlots, String, ast::ValueType => ast::ValueType
enum_find_payload = s, label, fallback =>
   enum_find_index(s, label, 0)
      | idx =>
         sl = s(idx)!!
         sl.payload_type
      | fallback

enum_slot_ti: ast::EnumSlots, String => ast::TypeInfo
enum_slot_ti = slots, label =>
   enum_find_ti(slots, label, ast::TypeInfo(Prim, ast::ValueType(Unknown)))

enum_find_ti: ast::EnumSlots, String, ast::TypeInfo => ast::TypeInfo
enum_find_ti = s, label, fallback =>
   enum_find_index(s, label, 0)
      | idx =>
         sl = s(idx)!!
         sl.payload_record
      | fallback

resolve_record_ti: Cg, ast::TypeInfo => ast::TypeInfo
resolve_record_ti = cg, ti =>
   ti
      [TypeVar name]
         is_user_type(cg, name)
            | typedef_ti(cg, name)
            | ti
      | ti

// A variant-only choice over an enum must name every variant unless it has a
// trailing bare fallback. Coverage is static: erased runtime unions contain
// no schema or descriptor.
codegen_check_enum_choice_coverage: Cg, ast::EnumSlots, ast::Branches => ()
codegen_check_enum_choice_coverage = cg, slots, branches =>
   hb = enum_choice_has_bare(branches, 0)
   !cg.discard_result && !hb
      | codegen_check_enum_choice_without_bare(cg, slots, branches)

codegen_check_enum_choice_without_bare: Cg, ast::EnumSlots, ast::Branches => ()
codegen_check_enum_choice_without_bare = cg, slots, branches =>
   missing = enum_choice_missing_labels(slots, branches, 0, "")
   missing != ""
      | init_error(cg, "E3102", "Choice over an enum does not cover " +
        "variants: " + missing + " — add a branch for each or a trailing " +
        "'|' fallback.", 0, 0)

enum_choice_has_bare: ast::Branches, Int => <>
enum_choice_has_bare = branches, at =>
   at == ?branches
      | <->
      |
         br = branches(at)!!
         is_bare = br.kind [Bare]
         is_bare | <+> | enum_choice_has_bare(branches, at + 1)

enum_choice_missing_labels: ast::EnumSlots, ast::Branches, Int, String => String
enum_choice_missing_labels = slots, branches, at, found =>
   at == ?slots
      | found
      |
         slot = slots(at)!!
         has = enum_choice_has_label(branches, slot.label, 0)
         next = enum_choice_missing_next(has, found, slot.label)
         enum_choice_missing_labels(slots, branches, at + 1, next)

enum_choice_missing_next: <>, String, String => String
enum_choice_missing_next = has, found, label =>
   has | found | enum_choice_missing_append(found, label)

enum_choice_missing_append: String, String => String
enum_choice_missing_append = found, label =>
   found == "" | label | found + ", " + label

enum_choice_has_label: ast::Branches, String, Int => <>
enum_choice_has_label = branches, label, at =>
   at == ?branches
      | <->
      |
         br = branches(at)!!
         is_var = br.kind [Variant]
         is_var
            |
               found_lbl' = <->
               br.variant_names @ vn =>
                  decl_bare_name(vn, 0) == label | (found_lbl' = <+>; -->)
               found_lbl'
                  | <+>
                  | enum_choice_has_label(branches, label, at + 1)
            | enum_choice_has_label(branches, label, at + 1)

call_arg_is_splat: ast::Expr => <>
call_arg_is_splat = a =>
   a
      [Range r] !r.has_lhs && r.has_rhs
      | <->

call_arg_is_named: ast::Expr => <>
call_arg_is_named = a => a [NamedArg]

call_has_splat_or_named: ast::Exprs, Int, Int => <>
call_has_splat_or_named = args, i, n =>
   i !< n
      | <->
      |
         a = args(i) | _ | ast::Expr(Int, 0)
         call_arg_is_splat(a) || call_arg_is_named(a)
            | <+>
            | call_has_splat_or_named(args, i + 1, n)

codegen_copy_base_fields: Cg, Addr, Addr, Addr, ast::FieldTypes, ast::VTypes,
  Flags, Int => ()
codegen_copy_base_fields = cg, dst, base_ev, tgt_rt, flds, tfvts, fin, n =>
   n @ k =>
      rf_base = flds(k)!!
      src_idx = member_index(cg.last_fnames, rf_base.name)
      src_idx !< 0
         |
            src_rt = cg.last_rt | _ | tgt_rt
            src_gep = record_field_gep(cg, src_rt, cg.last_fvts,
              base_ev, src_idx)
            dst_gep = record_field_gep(cg, tgt_rt, tfvts, dst, k)
            src_fvt = cg.last_fvts(src_idx)!!
            tgt_fvt = tfvts(k)!!
            is_rf_base = src_fvt [Record] || (tgt_fvt [Record])
            is_rf_base
               |
                  ft_base = LLVMStructGetTypeAtIndex(tgt_rt, k)
                  isz_base = LLVMSizeOf(ft_base)
                  LLVMBuildMemCpy(cg.builder, dst_gep, 1,
                    src_gep, 1, isz_base, 0)
               |
                  sty = src_fvt != ast::ValueType(Unknown)
                     | llvm_type_of_vt(src_fvt)
                     | LLVMStructGetTypeAtIndex(src_rt, src_idx)
                  selem = LLVMBuildLoad2(cg.builder, sty, src_gep,
                    "base.elem")
                  dft = LLVMStructGetTypeAtIndex(tgt_rt, k)
                  cval_base = stmt::coerce_int(cg, selem, dft)
                  LLVMBuildStore(cg.builder, cval_base, dst_gep)
            fin(k) = <+> !| _

coerce_record_field: Cg, Addr, ast::TypeInfo, Int, Addr => Addr
coerce_record_field = cg, value, parent, index, llvm_type =>
   field_ti = record_field_ti(cg, parent, index)
   resolved = stmt::resolve_ti(cg, field_ti)
   resolved
      [Ram] match::coerce_ram_repr(cg, value, resolved)
      | stmt::coerce_int(cg, value, llvm_type)

codegen_eval_record_ctor: Cg, ast::TypeInfo,
  ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_record_ctor = cg, ti, t =>
   rm = runtime::record_meta_from_ti(cg, ti)
   rm_0 = rm | m => m.0 | LLVMInt8Type!
   rm_1 = rm | m => m.1 | ast::Names()
   rm_rt_opt = rm | m => <+ m.0 +> | <-->
   tgt_fvts = field_vts(cg, ti)
   tgt_nf = ?tgt_fvts
   nargs = ?t.args
   is_update = call_has_splat_or_named(t.args, 0, nargs) ||
     (nargs == 0 && tgt_nf > 0) || nargs > 1
   is_update
      |
         sz' = <>(rm) | LLVMSizeOf(rm_0) |
            LLVMConstInt(LLVMInt64Type!, 16, 0)
         dst' = expr::codegen_call_arena_alloc(cg, sz', "record.alloc")
         dst' = LLVMBuildPointerCast(cg.builder, dst',
           LLVMPointerType(rm_0, 0), "record.ptr")
         fields = ti [Rec r] r.0 | ast::FieldTypes()
         f_init = Flags()
         tgt_nf @ f_init += <->
         nargs @ i =>
            sarg = t.args(i) | _ | ast::Expr(Int, 0)
            sarg [Range r]
               !r.has_lhs && r.has_rhs
                  |
                     is_def = r.rhs [Var v] (v == "default") | <->
                     !is_def
                        |
                           base_ev = expr::codegen_eval(cg, r.rhs)
                           is_same = cg.last_rt | lrt => lrt == rm_0 | <->
                           is_same
                              |
                                 LLVMBuildMemCpy(cg.builder, dst', 1,
                                   base_ev.0, 1, sz', 0)
                                 tgt_nf @ k =>
                                    f_init(k) = <+> !| _
                              |
                                 codegen_copy_base_fields(cg, dst', base_ev.0,
                                   rm_0, fields, tgt_fvts, f_init, tgt_nf)
         nargs @ i =>
            uarg = t.args(i) | _ | ast::Expr(Int, 0)
            !call_arg_is_splat(uarg)
               |
                  uarg
                     [NamedArg na]
                        idx_named = member_index(rm_1, na.name)
                        idx_named < 0
                           |
                              init_error(cg, "E3117", "Record '" + t.fn_name +
                                "' has no field '" + na.name + "'",
                                t.line, t.col)
                           |
                              ev_named = expr::codegen_eval(cg, na.val)
                              dst_gep_named = record_field_gep(cg, rm_0,
                                tgt_fvts, dst', idx_named)
                              tgt_fvt_named = tgt_fvts(idx_named)!!
                              is_rf_named = ev_named.1 [Record] ||
                                (tgt_fvt_named [Record])
                              is_rf_named
                                 |
                                    ft_named' = LLVMStructGetTypeAtIndex(
                                       rm_0, idx_named)
                                    isz_named = LLVMSizeOf(ft_named')
                                    LLVMBuildMemCpy(cg.builder,
                                      dst_gep_named, 1, ev_named.0, 1,
                                      isz_named, 0)
                                 |
                                    ft_named' = LLVMStructGetTypeAtIndex(
                                       rm_0, idx_named)
                                    cval_named = coerce_record_field(cg, ev_named.0, ti,
                                      idx_named, ft_named')
                                    LLVMBuildStore(cg.builder,
                                      cval_named, dst_gep_named)
                              f_init(idx_named) = <+> !| _
                     |
                        i < tgt_nf
                           |
                              ev_pos = expr::codegen_eval(cg, uarg)
                              dst_gep_pos = record_field_gep(cg, rm_0,
                                tgt_fvts, dst', i)
                              tgt_fvt_pos = tgt_fvts(i)!!
                              is_rf_pos = ev_pos.1 [Record] ||
                                (tgt_fvt_pos [Record])
                              is_rf_pos
                                 |
                                    ft_pos' = LLVMStructGetTypeAtIndex(
                                       rm_0, i)
                                    isz_pos = LLVMSizeOf(ft_pos')
                                    LLVMBuildMemCpy(cg.builder,
                                      dst_gep_pos, 1, ev_pos.0, 1,
                                      isz_pos, 0)
                                 |
                                    ft_pos' = LLVMStructGetTypeAtIndex(
                                       rm_0, i)
                                    cval_pos = coerce_record_field(cg, ev_pos.0, ti,
                                      i, ft_pos')
                                    LLVMBuildStore(cg.builder,
                                      cval_pos, dst_gep_pos)
                              f_init(i) = <+> !| _
         tgt_nf @ i =>
            is_init = f_init(i)!!
            !is_init
               |
                  rf_def = fields(i)!!
                  rf_def.has_default
                     |
                        def_ev = expr::codegen_eval(cg, rf_def.default_expr)
                        dst_gep_def = record_field_gep(cg, rm_0, tgt_fvts,
                          dst', i)
                        tgt_fvt_def = tgt_fvts(i)!!
                        is_rf_def = def_ev.1 [Record] || (tgt_fvt_def [Record])
                        is_rf_def
                           |
                              ft_def' = LLVMStructGetTypeAtIndex(rm_0, i)
                              isz_def = LLVMSizeOf(ft_def')
                              LLVMBuildMemCpy(cg.builder, dst_gep_def, 1,
                                def_ev.0, 1, isz_def, 0)
                           |
                              ft_def' = LLVMStructGetTypeAtIndex(rm_0, i)
                              cval_def = coerce_record_field(cg, def_ev.0, ti, i, ft_def')
                              LLVMBuildStore(cg.builder, cval_def,
                                dst_gep_def)
                     |
                        init_error(cg, "E3130",
                          diag::record_default_missing(rf_def.name, t.fn_name),
                          t.line, t.col)
         cg.last_rt = rm_rt_opt
         cg.last_fnames = rm_1
         cg.last_fvts = tgt_fvts
         t.fn_name != "" | cg.last_type = t.fn_name
         (dst', ast::ValueType(Record))
      |
         nargs == 1
            |
               arg0 = t.args(0)!!
               src_ev = expr::codegen_eval(cg, arg0)
               src_val = src_ev.0
               src_vt = src_ev.1
               src_rt = cg.last_rt
               src_fvts = cg.last_fvts
               tgt_nf == 1
                  |
                     sz' = <>(rm) | LLVMSizeOf(rm_0) |
                        LLVMConstInt(LLVMInt64Type!, 16, 0)
                     dst' = expr::codegen_call_arena_alloc(cg, sz', "record.alloc")
                     LLVMBuildPointerCast(cg.builder, dst',
                       LLVMPointerType(rm_0, 0), "record.ptr")
                     dst_gep' = record_field_gep(cg, rm_0, tgt_fvts, dst', 0)
                     tgt_fvt0 = tgt_fvts(0) | _ | ast::ValueType(Unknown)
                     is_rec_0 = src_vt [Record] || (tgt_fvt0 [Record])
                     is_rec_0
                        |
                           ft' = LLVMStructGetTypeAtIndex(rm_0, 0)
                           inner_sz' = LLVMSizeOf(ft')
                           LLVMBuildMemCpy(cg.builder, dst_gep', 1,
                             src_val, 1, inner_sz', 0)
                        |
                           LLVMBuildStore(cg.builder, src_val, dst_gep')
                     cg.last_rt = rm_rt_opt
                     cg.last_fnames = rm_1
                     cg.last_fvts = tgt_fvts
                     t.fn_name != "" | cg.last_type = t.fn_name
                     (dst', ast::ValueType(Record))
                  |
                     is_rec = src_vt [Record]
                     is_rec && <>(src_rt)
                        |
                           src_rt_val = src_rt | _ | rm_0
                           sz' = <>(rm) | LLVMSizeOf(rm_0) |
                              LLVMConstInt(LLVMInt64Type!, 16, 0)
                           dst' = expr::codegen_call_arena_alloc(cg, sz',
                             "record.cast.alloc")
                           LLVMBuildPointerCast(cg.builder, dst',
                             LLVMPointerType(rm_0, 0), "record.cast.ptr")
                           tgt_nf @ i =>
                              src_gep = record_field_gep(cg, src_rt_val, src_fvts,
                                src_val, i)
                              dst_gep' = record_field_gep(cg, rm_0, tgt_fvts,
                                dst', i)
                              src_fvt = src_fvts(i) | _ |
                                 ast::ValueType(Unknown)
                              tgt_fvt' = tgt_fvts(i) | _ |
                                 ast::ValueType(Unknown)
                              is_rec_f' = src_fvt [Record] || (tgt_fvt' [Record])
                              is_rec_f'
                                 |
                                    ft' = LLVMStructGetTypeAtIndex(
                                       rm_0, i)
                                    inner_sz' = LLVMSizeOf(ft')
                                    LLVMBuildMemCpy(cg.builder,
                                      dst_gep', 1, src_gep, 1, inner_sz', 0)
                                 |
                                    src_elem_ty =
                                       src_fvt != ast::ValueType(Unknown)
                                          | llvm_type_of_vt(src_fvt)
                                          | LLVMStructGetTypeAtIndex(
                                             src_rt_val, i)
                                    src_elem = LLVMBuildLoad2(cg.builder,
                                      src_elem_ty, src_gep, "cast.src.elem")
                                    LLVMBuildStore(cg.builder, src_elem,
                                      dst_gep')
                           cg.last_rt = rm_rt_opt
                           cg.last_fnames = rm_1
                           cg.last_fvts = tgt_fvts
                           t.fn_name != "" | cg.last_type = t.fn_name
                           (dst', ast::ValueType(Record))
                        |
                           i8p = LLVMPointerType(LLVMInt8Type!, 0)
                           dst' = is_ptrish_vt(src_vt)
                              | src_val
                              | LLVMBuildIntToPtr(cg.builder, src_val,
                                i8p, "cast.int2ptr")
                           cg.last_rt = rm_rt_opt
                           cg.last_fnames = rm_1
                           cg.last_fvts = tgt_fvts
                           t.fn_name != "" | cg.last_type = t.fn_name
                           (dst', ast::ValueType(Record))
            |
               sz' = <>(rm) | LLVMSizeOf(rm_0) |
                  LLVMConstInt(LLVMInt64Type!, 16, 0)
               dst' = expr::codegen_call_arena_alloc(cg, sz', "record.alloc")
               LLVMBuildPointerCast(cg.builder, dst',
                 LLVMPointerType(rm_0, 0), "record.ptr")
               tgt_nf @ i =>
                  av = t.args(i)!!
                  ev = expr::codegen_eval(cg, av)
                  dst_gep' = record_field_gep(cg, rm_0, tgt_fvts, dst', i)
                  tgt_fvt' = tgt_fvts(i) | _ | ast::ValueType(Unknown)
                  is_rec_f' = ev.1 [Record] || (tgt_fvt' [Record])
                  is_rec_f'
                     |
                        ft' = LLVMStructGetTypeAtIndex(rm_0, i)
                        inner_sz' = LLVMSizeOf(ft')
                        LLVMBuildMemCpy(cg.builder, dst_gep', 1, ev.0, 1,
                          inner_sz', 0)
                     |
                        LLVMBuildStore(cg.builder, ev.0, dst_gep')
               cg.last_rt = rm_rt_opt
               cg.last_fnames = rm_1
               cg.last_fvts = tgt_fvts
               t.fn_name != "" | cg.last_type = t.fn_name
               (dst', ast::ValueType(Record))

find_typedef_name_for_ti_at: TypeDefs, Int, Int, ast::TypeInfo => String
find_typedef_name_for_ti_at = tds, i, n, ti =>
   i == n
      | ""
      |
         td = tds(i)!!
         !is_internal_type_name(td.name) && type_info_equal(td.ti, ti)
            | td.name
            | find_typedef_name_for_ti_at(tds, i + 1, n, ti)

find_typedef_name_for_ti: Cg, ast::TypeInfo => String
find_typedef_name_for_ti = cg, ti =>
   ti
      [TypeVar tv] (!is_internal_type_name(tv) | tv | "")
      [Prim] ""
      | find_typedef_name_for_ti_at(cg.typedefs, 0, ?cg.typedefs, ti)

prim_vt_display_name: ast::ValueType => String
prim_vt_display_name = vt =>
   vt
      [Int] "Int"
      [I8] "I8"
      [I16] "I16"
      [I32] "I32"
      [I64] "I64"
      [U8] "U8"
      [U16] "U16"
      [U32] "U32"
      [U64] "U64"
      [Rune] "Rune"
      [Float] "Float"
      [F32] "F32"
      [Str] "String"
      [Builder] "Builder"
      [Flag] "<>"
      [Unit] "()"
      [RawPtr] "Addr"
      [Type] "Type"
      [Record] "Record"
      [Enum] "Enum"
      [Ram] "Ram"
      [Array] "Array"
      [Slice] "Slice"
      [Map] "Map"
      [Fn] "Fn"
      | ""

type_info_display_name: Cg, ast::Expr, ast::TypeInfo => String
type_info_display_name = cg, expr, ti =>
   vname = expr
      [Var v] v
      [SizeOf so] (so.rec_type [TypeVar tv] tv | "")
      | ""
   dname = vname != "" | ct_bind_find_dname(vname) | ""
   dname != ""
      | dname
      |
         vname != "" && is_user_type(cg, vname) && !is_internal_type_name(vname)
            | vname
            |
               is_nominal_ti = ti
                  [Enum] <+>
                  [TypeVar] <+>
                  [Rec r] (!r.1 && ?r.0 > 0 && r.0(0)!!.name != "")
                  | <->
               td_name = is_nominal_ti | find_typedef_name_for_ti(cg, ti) | ""
               td_name != ""
                  | td_name
                  |
                     ti
                        [TypeVar tv]
                           !is_internal_type_name(tv)
                              | tv
                              | type_info_display_name(cg, expr, typedef_ti(cg, tv))
                        [Align a] type_info_display_name(cg, expr, a.1)
                        [Prim p] prim_vt_display_name(p)
                        [Array a]
                           type_info_display_name(cg, ast::Expr(Int, 0),
                             norm_slot_ti(a.0, a.1)) + "{}"
                        [Rec r]
                           r.1
                              |
                                 e_ti = ?r.0 > 0
                                    | field_type_info(r.0(0)!!)
                                    | ast::TypeInfo(Prim, r.3)
                                 "${type_info_display_name(cg, ast::Expr(Int, 0), e_ti)}[]"
                              | r.2 && r.4 > 0
                                 |
                                    e_ti = ?r.0 > 0
                                       | field_type_info(r.0(0)!!)
                                       | ast::TypeInfo(Prim, r.3)
                                    et = type_info_display_name(cg, ast::Expr(Int, 0), e_ti)
                                    "(${et} * ${r.4})"
                                 | !r.1 && !r.2 && ?r.0 > 0 && r.0(0)!!.name == ""
                                    |
                                       b_tup = {64}
                                       r.0 @ el_, i =>
                                          i > 0 | b_tup += ", "
                                          ft_i = field_type_info(el_)
                                          ts = type_info_display_name(cg, ast::Expr(Int, 0), ft_i)
                                          b_tup += ts
                                       "(${+b_tup})"
                                    | "(..)"
                        [Map m]
                           prim_vt_display_name(m.0) + " ^ " +
                             type_info_display_name(cg, ast::Expr(Int, 0),
                               norm_slot_ti(m.1, m.2))
                        [Enum] "<..>"
                        [Ram r]
                           !r.0.has_payload && !r.1.has_payload
                              | "<>"
                              |
                                 p_str = r.0.has_payload
                                    | type_info_display_name(cg,
                                      ast::Expr(Int, 0),
                                      norm_slot_ti(r.0.payload_type,
                                        r.0.payload_record))
                                    | ""
                                 n_str = r.1.has_payload
                                    | type_info_display_name(cg,
                                      ast::Expr(Int, 0),
                                      norm_slot_ti(r.1.payload_type,
                                        r.1.payload_record))
                                    | ""
                                 "<" + p_str + "|" + n_str + ">"
                        | ""

// A declared type constructor call: an ENUM builds a heap union (tag = the
// variant label's slot index, payload from the optional second arg); a RAM's
// single arg is passed through (it is already a heap union).
codegen_eval_enum_idx_ctor: Cg, String, ast::EnumSlots, ast::CallExpr,
  Int => (Addr, ast::ValueType)
codegen_eval_enum_idx_ctor = cg, eff_tname, slots, t, idx =>
   idx < 0 || !(idx < ?slots)
      |
         init_error(cg, "E3096",
           diag::enum_no_variant(eff_tname, str::from_int(idx)), t.line, t.col)
         (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Enum))
      |
         sl = slots(idx)!!
         na = ?t.args
         !sl.has_payload && na > 1
            | init_error(cg, "E3098",
              diag::enum_unit_payload(eff_tname, sl.label), t.line, t.col)
         sl.has_payload && na > 1
            |
               actual = static_expr_vt(cg, t.args(1)!!)
               actual != ast::ValueType(Unknown) && actual != sl.payload_type
                  | init_error(cg, "E3099", diag::enum_payload_type(eff_tname,
                    sl.label, value_type_name(sl.payload_type),
                    value_type_name(actual)), t.line, t.col)
         payargs = ast::Exprs()
         sl.has_payload && na > 1
            | payargs += t.args(1)!!
         u' = codegen_build_union(cg, idx, payargs, "enum.alloc")
         cg.last_type = eff_tname
         (u', ast::ValueType(Enum))

codegen_eval_ctor_ex: Cg, ast::TypeInfo, ast::CallExpr, <> => (Addr, ast::ValueType)
codegen_eval_ctor_ex = cg, ti, t, allow_cursor =>
   ti
      [Align a] codegen_eval_ctor_ex(cg, a.1, t, allow_cursor)
      [Array ae]
         ?t.args > 0
            |
               init_e = ast::Expr(Call, ast::CallExpr(t.fn_name, ast::Expr(Var, ""), ast::Exprs(), t.line, t.col))
               elem_is_fn = ae.0 [Fn]
               res = expr::desugar_array_lit_call_ast(cg, t, init_e, elem_is_fn)
               cg.last_type = t.fn_name
               res
            |
               u' = main::codegen_array_create_cap(cg, ae.2, "a.new")
               (u', ast::ValueType(Array))
      [Map mk]
         u' = runtime::codegen_map_create(cg, "m.new")
         (u', ast::ValueType(Map))
      [Enum s]
         slots = ti [Enum s2] s2 | ast::EnumSlots()
         lbl = t.args(0)!!
         lname = lbl
            [Var v] v
            [Str sv] (allow_cursor | sv | "")
            | ""
         dname0 = ct_bind_find_dname(t.fn_name)
         dname1 = dname0 != "" | dname0 | find_typedef_name_for_ti(cg, ti)
         eff_tname = dname1 != "" | dname1 | t.fn_name
         is_pt = lbl [Var] && var_dtype(cg, lname) == eff_tname
         is_pt
            |
               lv = codegen_load(cg, lname)
               cg.last_type = eff_tname
               lv | _ | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               cur = allow_cursor && lname != ""
                  | ct_cursor_find(lname)
                  | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), 0, <->)
               cur.2
                  |
                     idx = cur.1
                     sl_has_pay = idx !< 0 && idx < ?slots
                        | slots(idx)!!.has_payload
                        | <->
                     na = ?t.args
                     na > 1 && sl_has_pay
                        |
                           pv = t.args(1)!!
                           payargs = ast::Exprs()
                           payargs += pv
                           u' = codegen_build_union(cg, idx, payargs, "enum.alloc")
                           cg.last_type = eff_tname
                           (u', ast::ValueType(Enum))
                        |
                           na > 1
                              | expr::codegen_eval(cg, t.args(1)!!)
                           u2 = codegen_build_union(cg, idx, ast::Exprs(), "enum.alloc")
                           cg.last_type = eff_tname
                           (u2, ast::ValueType(Enum))
                  |
                     is_int_lbl = allow_cursor && (lbl [Int])
                     is_int_lbl
                        |
                           idx_lit = lbl [Int ii] ii | -1
                           codegen_eval_enum_idx_ctor(cg, eff_tname, slots, t, idx_lit)
                        |
                           chk_call = (lbl [Str]) && allow_cursor
                              |
                                 cargs = ast::Exprs()
                                 cargs += ast::Expr(Var, lname)
                                 ?t.args > 1 | (cargs += t.args(1)!!)
                                 ast::CallExpr(t.fn_name, t.fn_target, cargs, t.line, t.col)
                              | t
                           codegen_check_enum_ctor(cg, eff_tname, slots, chk_call)
                           idx = enum_slot_index(slots, lname) | _ | 0
                           na = ?t.args
                           na > 1
                              |
                                 pv = t.args(1)!!
                                 payargs = ast::Exprs()
                                 payargs += pv
                                 u' = codegen_build_union(cg, idx, payargs, "enum.alloc")
                                 cg.last_type = eff_tname
                                 (u', ast::ValueType(Enum))
                              |
                                 u2 = codegen_build_union(cg, idx, ast::Exprs(), "enum.alloc")
                                 cg.last_type = eff_tname
                                 (u2, ast::ValueType(Enum))
      [Rec rr]
         codegen_eval_record_ctor(cg, ti, t)
      [Ram slots]
         codegen_eval_ram_ctor(cg, t.fn_name, slots, t)
      |
         arg2 = t.args(0)!!
         expr::codegen_eval(cg, arg2)

codegen_eval_ctor: Cg, ast::TypeInfo, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_ctor = cg, ti, t => codegen_eval_ctor_ex(cg, ti, t, <->)

// Enum constructor calls are statically checked before their erased union is
// materialized. The union retains only its tag and payload at runtime; label
// and payload-schema information remains in the declared TypeInfo here.
codegen_check_enum_ctor: Cg, String, ast::EnumSlots, ast::CallExpr => ()
codegen_check_enum_ctor = cg, enum_name, slots, call =>
   lbl = call.args(0)!!
   label = lbl [Var v] v | ""
   idx_opt = enum_slot_index(slots, label)
   has_idx = <>(idx_opt)
   !has_idx
      | init_error(cg, "E3096", diag::enum_no_variant(enum_name, label),
        call.line, call.col)
   idx_opt
      |
         payload = enum_slot_payload(slots, label)
         has_payload = enum_slot_has_payload(slots, label)
         nargs = ?call.args
         !has_payload && nargs > 1
            | init_error(cg, "E3098", diag::enum_unit_payload(enum_name, label),
              call.line, call.col)
         has_payload && nargs > 1
            |
               actual = static_expr_vt(cg, call.args(1)!!)
               actual != ast::ValueType(Unknown) && actual != payload
                  | init_error(cg, "E3099", diag::enum_payload_type(enum_name,
                    label, value_type_name(payload), value_type_name(actual)),
                    call.line, call.col)

enum_slot_has_payload: ast::EnumSlots, String => <>
enum_slot_has_payload = slots, label =>
   enum_slot_index(slots, label)
      | idx => slots(idx)!!.has_payload
      | <->

// This scanner deliberately leaves unknown values for later unification; it
// never invents an Int default for an unresolved expression.
static_expr_vt: Cg, ast::Expr => ast::ValueType
static_expr_vt = cg, e =>
   e
      [Int] ast::ValueType(Int)
      [Rune] ast::ValueType(Rune)
      [Float] ast::ValueType(Float)
      [TypeCast t] t.target_type
      [Str] ast::ValueType(Str)
      [Var v] var_type(cg, v)
      [Unary u]
         u.0
            [Freeze] ast::ValueType(Str)
            [AddrOf] ast::ValueType(RawPtr)
            | ast::ValueType(Unknown)
      [Bin bt]
         bt.0
            [Add]
               is_str_vt(static_expr_vt(cg, bt.1)) ||
                 is_str_vt(static_expr_vt(cg, bt.2))
                 | ast::ValueType(Str)
                 | ast::ValueType(Unknown)
            | ast::ValueType(Unknown)
      [Variant v]
         is_flag = v.tag_name [Positive, Negative] && ?v.args == 0
         is_flag | ast::ValueType(Flag) | ast::ValueType(Ram)
      [Record] ast::ValueType(Record)
      [Fn] ast::ValueType(Fn)
      [Call c]
         c.fn_name == "%bitcast" && ?c.args == 2
            | ((c.args(0)!!) [SizeOf so] vt_from_ti_cg(cg, so.rec_type) | ast::ValueType(Unknown))
            |
               c.fn_name == "Builder" && ?c.args == 0
                  | ast::ValueType(Builder)
                  |
                     is_user_type(cg, c.fn_name)
                        |
                           ti = ctfe_canonical_ti(cg, typedef_ti(cg, c.fn_name))
                           ti
                              [Enum] ast::ValueType(Enum)
                              [Ram] ast::ValueType(Ram)
                              [Rec] ast::ValueType(Record)
                              [Map] ast::ValueType(Map)
                              [Array] ast::ValueType(Array)
                              | ast::ValueType(Unknown)
                        | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)

value_type_name: ast::ValueType => String
value_type_name =
   [Unknown] "Unknown"
   [Int] "Int"
   [I8] "I8"
   [I16] "I16"
   [I32] "I32"
   [I64] "I64"
   [U8] "U8"
   [U16] "U16"
   [U32] "U32"
   [U64] "U64"
   [Rune] "Rune"
   [Float] "Float"
   [F32] "F32"
   [Str] "String"
   [Flag] "Flag"
   [Ram] "Ramification"
   [Enum] "Enum"
   [Record] "Record"
   [Unit] "Void"
   [RawPtr] "Addr"
   [Fn] "Function"
   [Type] "Type"
   [Slice] "Slice"
   [Builder] "Builder"
   [Array] "Array"
   [Map] "Map"
   [Error] "Error"
   [ThreadId] "ThreadId"
   | "unknown"

// Named ram construction checks the literal against the declared slot layout
// while leaving the runtime value as the same erased union/flag representation.
codegen_eval_ram_ctor: Cg, String, (ast::RamSlotInfo, ast::RamSlotInfo), ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_ram_ctor = cg, name, slots, call =>
   arg = call.args(0)!!
   codegen_check_ram_ctor(cg, name, slots, call, arg)
   res = expr::codegen_eval(cg, arg)
   cg.last_type = name
   res

codegen_check_ram_ctor: Cg, String, (ast::RamSlotInfo, ast::RamSlotInfo), ast::CallExpr, ast::Expr => ()
codegen_check_ram_ctor = cg, name, slots, call, arg =>
   arg
      [Variant v] codegen_check_ram_variant(cg, name, slots, call, v)
      |
         actual = static_expr_vt(cg, arg)
         actual != ast::ValueType(Ram)
            | init_error(cg, "E3055", "Ramification '" + name +
              "' expects a ramification value, got type " +
              value_type_name(actual) + ".", call.line, call.col)

codegen_check_ram_variant: Cg, String, (ast::RamSlotInfo, ast::RamSlotInfo), ast::CallExpr, ast::VariantExpr => ()
codegen_check_ram_variant = cg, name, slots, call, variant =>
   ram_slots_are_flag(slots) && ram_tag_is_heap_unit(variant.tag_name)
      | init_error(cg, "E3090", "Ramification '" + name +
        "' is a Flag (<>), whose unit branches are '<+>' (Positive) or " +
        "'<->' (Negative), got '" + ram_tag_name(variant.tag_name) +
        "'. '<++>'/'<-->' are heap-ram units and never coerce down.",
        call.line, call.col)
   !ram_slots_are_flag(slots) && !ram_tag_is_heap_unit(variant.tag_name) &&
     (?variant.args == 0)
     | init_error(cg, "E3083", "Ramification '" + name +
       "' unit branch must use '<++>' (Succ) or '<-->' (Noth). '<+>' and " +
       "'<->' are Flags and do not coerce into heap rams.", call.line, call.col)
   slot = ram_tag_is_positive(variant.tag_name) | slots.0 | slots.1
   has_payload = ?variant.args > 0
   !slot.has_payload && has_payload
      | init_error(cg, "E3053", "Ramification '" + name +
        "' expects a unit slot here, but this value has a payload. Tag '" +
        ram_tag_name(variant.tag_name) + "' (" +
        str::from_int(tag_id_of(variant.tag_name)) + ").", call.line, call.col)
   slot.has_payload && has_payload
      |
         slot_pt = slot_payload_type(cg, slot)
         actual = static_expr_vt(cg, variant.args(0)!!)
         actual != ast::ValueType(Unknown) && actual != slot_pt
            | init_error(cg, "E3054", "Ramification '" + name + "' slot '" +
              ram_slot_name(variant.tag_name) + "' expects payload of type " +
              value_type_name(slot_pt) + ", got " +
              value_type_name(actual) + ".", call.line, call.col)

ram_slots_are_flag: (ast::RamSlotInfo, ast::RamSlotInfo) => <>
ram_slots_are_flag = slots => !slots.0.has_payload && !slots.1.has_payload

ram_tag_is_positive: ast::Tag => <>
ram_tag_is_positive = tag =>
   tag == ast::Tag(Positive) || tag == ast::Tag(Some) || tag == ast::Tag(Succ)

ram_tag_is_heap_unit: ast::Tag => <>
ram_tag_is_heap_unit = tag => tag == ast::Tag(Succ) || tag == ast::Tag(Noth)

ram_tag_is_flag: ast::Tag => <>
ram_tag_is_flag = tag => tag == ast::Tag(Positive) || tag == ast::Tag(Negative)

ram_tag_name: ast::Tag => String
ram_tag_name =
   [Positive] "Positive"
   [Negative] "Negative"
   [Some] "Some"
   [Err] "Err"
   [Succ] "Succ"
   | "Noth"

ram_slot_name: ast::Tag => String
ram_slot_name = tag => ram_tag_is_positive(tag) | "Some" | "Err"

// A bare label is valid only when a single enum declares it. Existing local
// bindings win normally; this check is for an otherwise unresolved name.
codegen_check_ambiguous_enum_label: Cg, String => ()
codegen_check_ambiguous_enum_label = cg, label =>
   has_slot = <>(var_slot(cg, label))
   !has_slot
      |
         owners = enum_label_owner_count(cg, label, 0)
         owners > 1
            | init_error(cg, "E3105", "Enum label '" + label +
              diag::E3105_enum_label_ambiguous_suffix! + label + "'.", 0, 0)

codegen_eval_enum_label_val: Cg, String, Int => <(Addr, ast::ValueType)|>
codegen_eval_enum_label_val = cg, label, owners =>
   owners > 1
      |
         init_error(cg, "E3105", "Enum label '" + label +
           diag::E3105_enum_label_ambiguous_suffix! + label + "'.", 0, 0)
         <-->
      |
         es = match::enum_slots_for_label(cg, label)
         idx = enum_slot_index(es.1, label) | _ | 0
         u = codegen_build_union(cg, idx, ast::Exprs(), "enum.alloc")
         cg.last_type = es.0
         <+ (u, ast::ValueType(Enum)) +>

enum_label_owner_count_at: Cg, String, Int, Int, Int => Int
enum_label_owner_count_at = cg, label, i, n, seen =>
   i == n
      | seen
      |
         td = cg.typedefs(i)!!
         has_lbl = td.ti [Enum slots] (<>(enum_slot_index(slots, label)) | 1 | 0) | 0
         enum_label_owner_count_at(cg, label, i + 1, n, seen + has_lbl)

enum_label_owner_count: Cg, String, Int => Int
enum_label_owner_count = cg, label, count =>
   enum_label_owner_count_at(cg, label, 0, ?cg.typedefs, count)

codegen_map_literal_insert_rest: Cg, Addr, ast::MapPairs, Int, Int, ast::ValueType => ()
codegen_map_literal_insert_rest = cg, m, pairs, i, n, key_vt =>
   i != n
      |
         p = pairs(i)!!
         kv = expr::codegen_eval(cg, p.key)
         vv = expr::codegen_eval(cg, p.value)
         runtime::codegen_map_insert(cg, m, kv.0, vv.0, key_vt)
         codegen_map_literal_insert_rest(cg, m, pairs, i + 1, n, key_vt)

// Map literal keys and values are homogeneous. Check this before lowering so
// a mismatched literal never becomes a partially-emitted map value.
codegen_eval_map_literal: Cg, ast::MapPairs => (Addr, ast::ValueType)
codegen_eval_map_literal = cg, pairs =>
   codegen_check_map_pairs(cg, pairs, 0)
   m = runtime::codegen_map_create(cg, "map.literal")
   np = ?pairs
   np == 0
      | (m, ast::ValueType(Map))
      |
         first = pairs(0)!!
         kv0 = expr::codegen_eval(cg, first.key)
         vv0 = expr::codegen_eval(cg, first.value)
         key_vt = kv0.1
         val_vt = vv0.1
         vdt = cg.last_type
         val_rec = vdt != "" | typedef_ti(cg, vdt) |
            ast::TypeInfo(Prim, val_vt)
         tname = "#map_" + value_type_name(key_vt) + "_" +
           value_type_name(val_vt)
         ti = ast::TypeInfo(Map, (key_vt, val_vt, val_rec))
         !has_type_name(cg, tname) | runtime::add_type(cg, tname, ti)
         cg.last_type = tname
         runtime::codegen_map_insert(cg, m, kv0.0, vv0.0, key_vt)
         np > 1
            | codegen_map_literal_insert_rest(cg, m, pairs, 1, np, key_vt)
         (m, ast::ValueType(Map))

raw_addr_value: Cg, Addr, ast::ValueType, Addr => <Addr|>
raw_addr_value = cg, value, vt, i8p =>
   llvm_val_opt(value)
      | v =>
         raw_ptr = vt [RawPtr] v |
            LLVMBuildIntToPtr(cg.builder, v, i8p, "raw.ptr")
         <+ expr::validate_and_strip_addr_tag(cg, raw_ptr, i8p) +>
      | <-->

codegen_eval_raw_memory: Cg, ast::RawMemoryExpr => (Addr, ast::ValueType)
codegen_eval_raw_memory = cg, rm =>
   raw_address_uses_string(cg, rm.addr)
      |
         codegen_raw_string_index_error(cg)
         (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         av = expr::codegen_eval(cg, rm.addr)
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         ptr_val_opt = raw_addr_value(cg, av.0, av.1, i8p)
         ptr_val = ptr_val_opt | _ | LLVMConstNull(i8p)
         rm.rec_name != ""
            |
               ti = typedef_ti(cg, rm.rec_name)
               meta = runtime::record_meta_from_ti(cg, ti)
               meta_rt = meta | m => m.0 | LLVMInt8Type!
               typed_ptr = LLVMBuildPointerCast(cg.builder,
                 ptr_val, LLVMPointerType(meta_rt, 0), "view.ptr")
               meta_rt_opt = meta | m => <+ m.0 +> | <-->
               cg.last_rt = meta_rt_opt
               meta_fns = meta | m => m.1 | ast::Names()
               cg.last_fnames = meta_fns
               cg.last_fvts = match::field_vts_from_ti(cg, ti)
               cg.last_type = rm.rec_name
               (typed_ptr, ast::ValueType(Record))
            |
               rm.load_type
                  [Unknown] (ptr_val, ast::ValueType(RawPtr))
                  |
                     elem_ty = llvm_type_of_vt(rm.load_type)
                     elem_ptr = LLVMBuildPointerCast(cg.builder, ptr_val,
                       LLVMPointerType(elem_ty, 0), "raw.ptr.t")
                     loaded = LLVMBuildLoad2(cg.builder, elem_ty,
                       elem_ptr, "raw.load")
                     LLVMSetVolatile(loaded, 1)
                     (loaded, rm.load_type)

raw_address_uses_string: Cg, ast::Expr => <>
raw_address_uses_string = cg, e =>
   e
      [Str] <+>
      [Var v] main::is_str_var(cg, v)
      [Bin t] raw_address_uses_string(cg, t.1) || raw_address_uses_string(cg, t.2)
      | <->

codegen_raw_string_index_error: Cg => <(Addr, ast::ValueType)|>
codegen_raw_string_index_error = cg =>
   init_error(cg, "E3063", "'@[...]' does not index a String (the '@[s + i]' " +
     "sugar was removed, B7). Read a byte with 's(i)' or write one to a " +
     "Builder.", 0, 0)
   <-->

codegen_check_map_pairs: Cg, ast::MapPairs, Int => ()
codegen_check_map_pairs = cg, pairs, at =>
   at < ?pairs
      |
         first = pairs(0)!!
         pair = pairs(at)!!
         first_key = static_expr_vt(cg, first.key)
         first_val = static_expr_vt(cg, first.value)
         key = static_expr_vt(cg, pair.key)
         val = static_expr_vt(cg, pair.value)
         at > 0 && key != ast::ValueType(Unknown) && key != first_key
            | init_error(cg, "E3137", "Map literal key type mismatch: entry " +
              str::from_int(at) + " has key type " + value_type_name(key) +
              ", first entry " + value_type_name(first_key) + ".", 0, 0)
         at > 0 && val != ast::ValueType(Unknown) && val != first_val
            | init_error(cg, "E3138", "Map literal value type mismatch: entry " +
              str::from_int(at) + " has value type " + value_type_name(val) +
              ", first entry " + value_type_name(first_val) + ".", 0, 0)
         codegen_check_map_pairs(cg, pairs, at + 1)

// A bare declared type name used as an expression: emit E3129.
codegen_eval_type_value: Cg, String => <(Addr, ast::ValueType)|>
codegen_eval_type_value = cg, name =>
   init_error(cg, "E3129", "Type name '" + name +
     "' cannot be used as an expression.", 0, 0)
   <-->

// The built-in ram tag ids: 1 = positive-ish (Positive/Some), 2 = Succ,
// 3 = Noth, 0 = negative-ish (Negative/Err).
tag_id_of: ast::Tag => Int
tag_id_of =
   [Positive] 1
   [Some] 1
   [Succ] 2
   [Noth] 3
   | 0

// A pointer-shaped payload is stored in the union slot directly; a scalar is
// boxed. The chain form (not a '||' merge) avoids flag-phi inference.
is_ptrish_vt: ast::ValueType => <>
is_ptrish_vt = [Str, RawPtr, Builder, Ram, Record, Map, Error, Array, Slice, Enum, Fn]

// A heap { tag, payload } union: malloc'd 16-byte struct, tag in slot 0, the
// payload in slot 1 (a pointer-shaped value stored directly, a scalar boxed
// into an 8-byte slot).
codegen_build_union: Cg, Int, ast::Exprs, String => Addr
codegen_build_union = cg, tid, args, alloc_name =>
   ut = cg.union_t
   up = expr::codegen_call_arena_alloc(cg,
     LLVMConstInt(LLVMInt64Type!, 16, 0), alloc_name)
   tgep = LLVMBuildStructGEP2(cg.builder, ut, up, 0, "tag.gep")
   LLVMBuildStore(cg.builder, LLVMConstInt(LLVMInt64Type!, tid, 0), tgep)
   na = ?args
   na > 0
      |
         av = args(0)!!
         ev = expr::codegen_eval(cg, av)
         ev_dt = ev.1 [Str] "String" [Int] "Int" [Float] "Float" |
            (cg.last_type != "" | cg.last_type | "")
         ev_dt != "" | cg.last_type = ev_dt
         pgep' = LLVMBuildStructGEP2(cg.builder, ut, up, 1, "pay.gep")
         is_ptrish = is_ptrish_vt(ev.1)
         is_ptrish
            | LLVMBuildStore(cg.builder, ev.0, pgep')
            |
               box_name = alloc_name == "enum.alloc" | "enum.pay.alloc" | "pay.alloc"
               box = expr::codegen_call_arena_alloc(cg,
                 LLVMConstInt(LLVMInt64Type!, 8, 0), box_name)
               LLVMBuildStore(cg.builder, LLVMConstInt(LLVMInt64Type!, 0, 0), box)
               LLVMBuildStore(cg.builder, ev.0, box)
               LLVMBuildStore(cg.builder, box, pgep')
      |
         pgep' = LLVMBuildStructGEP2(cg.builder, ut, up, 1, "pay.gep")
         LLVMBuildStore(cg.builder,
           LLVMConstNull(LLVMPointerType(LLVMInt8Type!, 0)), pgep')
   up

// A variant literal: "<+>" / "<->" with no payload is a bare i1 flag; anything
// else (<++>, <-->, or a "<+ p ->"-style payload variant) is a heap union.
codegen_eval_variant: Cg, ast::VariantExpr => (Addr, ast::ValueType)
codegen_eval_variant = cg, t =>
   na = ?t.args
   is_pos_neg = t.tag_name [Positive, Negative]
   is_flag = (na == 0) && is_pos_neg
   is_flag
      |
         bit = t.tag_name [Positive] 1 | 0
         (LLVMConstInt(LLVMInt1Type!, bit, 0), ast::ValueType(Flag))
      |
         u = codegen_build_union(cg, tag_id_of(t.tag_name), t.args,
           "variant.alloc")
         (u, ast::ValueType(Ram))

// Compute the GEP for a record field: homogeneous records use rec.elem.gep,
// heterogeneous records use rec.field.gep.
record_field_gep_opt: Cg, Addr, ast::VTypes, Addr, Int => <Addr|>
record_field_gep_opt = cg, rt, fvts, base, idx =>
   b_opt = llvm_val_opt(base)
   rt_opt = llvm_val_opt(rt)
   ! <>(b_opt) || ! <>(rt_opt)
      | <-->
      |
         base_val = b_opt!!
         rt_val = rt_opt!!
         base_ptr = LLVMGetTypeKind(LLVMTypeOf(base_val)) == 8
            | LLVMBuildIntToPtr(cg.builder, base_val,
              LLVMPointerType(LLVMInt8Type!, 0), "rec.base.ptr")
            | base_val
         is_homo = expr::record_type_is_homogeneous(<+ rt_val +>, fvts)
         res = is_homo
            |
               elem_t = LLVMStructGetTypeAtIndex(rt_val, 0)
               typed = LLVMBuildPointerCast(cg.builder, base_ptr,
                 LLVMPointerType(elem_t, 0), "rec.typed")
               idx_v = LLVMConstInt(LLVMInt64Type!, idx, 0)
               gep1(cg, elem_t, typed, idx_v, "rec.elem.gep")
            | LLVMBuildStructGEP2(cg.builder, rt_val, base_ptr, idx,
              "rec.field.gep")
         <+ res +>

record_field_gep: Cg, Addr, ast::VTypes, Addr, Int => Addr
record_field_gep = cg, rt, fvts, base, idx =>
   record_field_gep_opt(cg, rt, fvts, base, idx)
      | g => g
      | LLVMConstNull(LLVMPointerType(LLVMInt8Type!, 0))

// A record literal: build the LLVM struct type from the field value shapes,
// malloc it, and store each field at its GEP. The struct type + named field
// list are recorded (cg.last_rt / last_fnames) for the member-access path.
codegen_eval_record: Cg, ast::RecordExpr => (Addr, ast::ValueType)
codegen_eval_record = cg, r =>
   expected = g.expected_fn_ti
   payload = expected [Ram slots] slots.0.payload_record | expected
   ti = stmt::resolve_ti(cg, payload)
   ti [Rec schema]
      matches' = ?schema.0 == ?r.fields && ?r.fields > 0
      r.fields @ field, i =>
         !field.has_name | matches' = <->
         i < ?schema.0
            | schema.0(i)!!.name != field.name | matches' = <->
      matches'
         |
            args = ast::Exprs()
            r.fields @ field =>
               args += ast::Expr(NamedArg, ast::NamedArgExpr(field.name, field.val))
            --| codegen_eval_record_ctor(cg, ti,
              ast::CallExpr("", ast::Expr(Var, ""), args, 0, 0))
   codegen_eval_record_inferred(cg, r)

codegen_eval_record_inferred: Cg, ast::RecordExpr => (Addr, ast::ValueType)
codegen_eval_record_inferred = cg, r =>
   nf = ?r.fields
   ftypes = Addrs()
   fvals = Addrs()
   fvts = ast::VTypes()
   fnames = ast::Names()
   r.fields @ f =>
      ev = expr::codegen_eval(cg, f.val)
      fvals += ev.0
      is_rec_field = ev.1 [Record]
      field_t = is_rec_field | (cg.last_rt | _ | LLVMTypeOf(ev.0)) | LLVMTypeOf(ev.0)
      ftypes += field_t
      fvts += ev.1
      f.has_name | fnames += f.name
   st = struct_type_n(cg, ftypes, nf)
   ?fnames > 0 && typedef_name_of_rt(cg, st) == ""
      |
         anon_name = "$rec." + str::from_int(?cg.typedefs)
         runtime::push_typedef(cg, TypeDef(anon_name,
           ast::TypeInfo(Prim, ast::ValueType(Record)), <+ st +>, <->, fnames))
   cg.last_rt = <+ st +>
   cg.last_fnames = fnames
   cg.last_fvts = fvts
   alloc_sz = LLVMSizeOf(st)
   rp = expr::codegen_call_arena_alloc(cg, alloc_sz, "record.alloc")
   is_homo = expr::record_type_is_homogeneous(<+ st +>, fvts)
   elem_t = (is_homo && nf > 0)
      | LLVMStructGetTypeAtIndex(st, 0)
      | LLVMVoidType!
   typed = is_homo
      |
         LLVMBuildPointerCast(cg.builder, rp,
           LLVMPointerType(elem_t, 0), "rec.typed")
      | rp
   nf @ i =>
      ft = LLVMStructGetTypeAtIndex(st, i)
      fgep = is_homo
         |
            idx_v = LLVMConstInt(LLVMInt64Type!, i, 0)
            gep1(cg, elem_t, typed, idx_v, "rec.elem.gep")
         | LLVMBuildStructGEP2(cg.builder, st, rp, i, "rec.field.gep")
      f_vt = (fvts(i) | _ | ast::ValueType(Unknown))
      is_rec_f = f_vt [Record]
      is_rec_f
         |
            inner_sz = LLVMSizeOf(ft)
            LLVMBuildMemCpy(cg.builder, fgep, 1,
              fvals(i)!!, 1, inner_sz, 0)
         |
            cval = stmt::coerce_int(cg, fvals(i)!!, ft)
            LLVMBuildStore(cg.builder, cval, fgep)
   (rp, ast::ValueType(Record))

// (rt, fnames) recorded for a record-typed eval result (from the last record
// literal built). A plain function so the guarded choice parses cleanly.
rec_meta: Cg, ast::ValueType => <(Addr, ast::Names)|>
rec_meta = cg, vt =>
   vt [Record]
      (cg.last_rt
         | rt =>
            ?cg.last_fnames > 0
               | <+ (rt, cg.last_fnames) +>
               | (cg.last_type != "" | td_record_meta_by_name(cg, cg.last_type) | <+ (rt, cg.last_fnames) +>)
         | (cg.last_type != "" | td_record_meta_by_name(cg, cg.last_type) | <-->))
      | <-->

td_record_meta: Cg, Int => <(Addr, ast::Names)|>
td_record_meta = cg, idx =>
   td = cg.typedefs(idx)!!
   td.in_progress
      | <-->
      |
         td.rt
            | rt => <+ (rt, td.fnames) +>
            |
               cg.typedefs(idx) = TypeDef(td.name, td.ti, <-->, <+>, td.fnames) !| _
               meta = runtime::record_meta_from_ti(cg, td.ti)
               cached_rt = meta | m => <+ m.0 +> | <-->
               cached_fn = meta | m => m.1 | ast::Names()
               cg.typedefs(idx) = TypeDef(td.name, td.ti, cached_rt, <->, cached_fn) !| _
               meta

td_record_meta_by_name: Cg, String => <(Addr, ast::Names)|>
td_record_meta_by_name = cg, name =>
   resolved = resolve_type_name(cg, name)
   indices = cg.type_indices
   indices ^? resolved
      |
         idx = indices ^ resolved | _ | -1
         td_record_meta(cg, idx)
      | <-->

typedef_name_of_rt_at: Cg, Addr, Int, Int => String
typedef_name_of_rt_at = cg, rt, i, n =>
   i == n
      | ""
      |
         meta = td_record_meta(cg, i)
         meta
            | m =>
               m.0 == rt
                  | cg.typedefs(i)!!.name
                  | typedef_name_of_rt_at(cg, rt, i + 1, n)
            | typedef_name_of_rt_at(cg, rt, i + 1, n)

typedef_name_of_rt: Cg, Addr => String
typedef_name_of_rt = cg, rt =>
   typedef_name_of_rt_at(cg, rt, 0, ?cg.typedefs)

typedef_ti_of_rt: Cg, Addr => ast::TypeInfo
typedef_ti_of_rt = cg, rt =>
   tname = typedef_name_of_rt(cg, rt)
   tname != ""
      | typedef_ti(cg, tname)
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

record_field_ti: Cg, ast::TypeInfo, Int => ast::TypeInfo
record_field_ti = cg, ti, idx =>
   ti
      [Align a] record_field_ti(cg, a.1, idx)
      [Rec rr]
         fields = rr.0
         (idx < ?fields)
            |
               rf = fields(idx)!!
               rf.rec_type
                  [TypeVar name] typedef_ti(cg, name)
                  | rf.rec_type
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      [TypeVar name] record_field_ti(cg, typedef_ti(cg, name), idx)
      [Prim p]
         is_err = p [Error]
         is_err
            | error_field_ti_by_idx(idx)
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

find_any_typedef_name_for_ti_at: TypeDefs, Int, Int, ast::TypeInfo => String
find_any_typedef_name_for_ti_at = tds, i, n, ti =>
   i == n
      | ""
      |
         td = tds(i)!!
         !(?td.name !< 10 && td.name(0..10) == "#heap_ram_") &&
           type_info_equal(td.ti, ti)
           | td.name
           | find_any_typedef_name_for_ti_at(tds, i + 1, n, ti)

ensure_ti_dtype: Cg, ast::TypeInfo => String
ensure_ti_dtype = cg, ti =>
   ti
      [Align a] ensure_ti_dtype(cg, a.1)
      [TypeVar name] resolve_type_name(cg, name)
      [Prim] ""
      |
         existing = find_any_typedef_name_for_ti_at(cg.typedefs, 0,
           ?cg.typedefs, ti)
         existing != ""
            | existing
            |
               tname = "__fld_ti_" + str::from_int(?cg.typedefs) + "_" +
                 str::from_int(g.tmpc)
               g.tmpc = g.tmpc + 1
               is_rec_ti = ti [Rec r] !r.1 | <->
               rm = is_rec_ti | runtime::record_meta_from_ti(cg, ti) | <-->
               rm_rt = rm | m => <+ m.0 +> | <-->
               rm_fns = rm | m => m.1 | ast::Names()
               runtime::add_type_rec(cg, tname, ti, rm_rt, rm_fns)
               tname

record_field_dtype: Cg, ast::TypeInfo, Int => String
record_field_dtype = cg, ti, idx =>
   ti
      [Align a] record_field_dtype(cg, a.1, idx)
      [Rec rr]
         fields = rr.0
         idx < ?fields
            |
               rf = fields(idx)!!
               rf.rec_type
                  [TypeVar name] resolve_type_name(cg, name)
                  [Rec rr2]
                     !rr2.1
                        |
                           meta = runtime::build_rec_meta(cg, rr2.0, 0, ?rr2.0,
                             Addrs(), ast::Names())
                           tn = typedef_name_of_rt(cg, meta.0)
                           tn != "" | tn | ensure_ti_dtype(cg, rf.rec_type)
                        | ensure_ti_dtype(cg, rf.rec_type)
                  [Array, Map, Ram, Enum]
                     ensure_ti_dtype(cg, rf.rec_type)
                  | ""
            | ""
      [TypeVar name] record_field_dtype(cg, typedef_ti(cg, name), idx)
      | ""

field_vts: Cg, ast::TypeInfo => ast::VTypes
field_vts = cg, ti =>
   ti
      [Align a] field_vts(cg, a.1)
      [Rec rr] runtime::field_vts_step(cg, rr.0, 0, ?rr.0, ast::VTypes())
      [TypeVar name] field_vts(cg, typedef_ti(cg, name))
      [Prim p]
         is_err = p [Error]
         is_err
            | error_field_vts!
            | ast::VTypes()
      | ast::VTypes()

error_context_ti: () => ast::TypeInfo
error_context_ti = !=>
   flds = ast::FieldTypes()
   flds += ast::RecordFieldType("", ast::ValueType(Int),
     ast::TypeInfo(Prim, ast::ValueType(Int)), <->, ast::Expr(Int, 0))
   flds += ast::RecordFieldType("", ast::ValueType(Int),
     ast::TypeInfo(Prim, ast::ValueType(Int)), <->, ast::Expr(Int, 0))
   ast::TypeInfo(Rec, (flds, <->, <->, ast::ValueType(Record), 2, <->))

error_field_ti_by_idx: Int => ast::TypeInfo
error_field_ti_by_idx = idx =>
   idx
      [0] ast::TypeInfo(Prim, ast::ValueType(Int))
      [1] ast::TypeInfo(Prim, ast::ValueType(Str))
      [2] ast::TypeInfo(Prim, ast::ValueType(Str))
      [3] ast::TypeInfo(Prim, ast::ValueType(Int))
      [4] ast::TypeInfo(Prim, ast::ValueType(Int))
      [5] error_context_ti!
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

error_field_ti_by_name: String => ast::TypeInfo
error_field_ti_by_name = name =>
   name
      ["code"] ast::TypeInfo(Prim, ast::ValueType(Int))
      ["msg"] ast::TypeInfo(Prim, ast::ValueType(Str))
      ["file"] ast::TypeInfo(Prim, ast::ValueType(Str))
      ["line"] ast::TypeInfo(Prim, ast::ValueType(Int))
      ["col"] ast::TypeInfo(Prim, ast::ValueType(Int))
      ["context"] error_context_ti!
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

error_field_vts: () => ast::VTypes
error_field_vts = !=>
   fv = ast::VTypes()
   fv += ast::ValueType(Int)
   fv += ast::ValueType(Str)
   fv += ast::ValueType(Str)
   fv += ast::ValueType(Int)
   fv += ast::ValueType(Int)
   fv += ast::ValueType(Record)
   fv

error_field_names: () => ast::Names
error_field_names = !=>
   fn = ast::Names()
   fn += "code"
   fn += "msg"
   fn += "file"
   fn += "line"
   fn += "col"
   fn += "context"
   fn

// --- Intra-module Value-Range Analysis (VRA) --------------------------------

// Range lattice state: 0 = Bottom (unseen), 1 = Bounded [lo, hi], 2 = Top.
vra_bot: () => VraRange
vra_bot = !=> VraRange(0, 0, 0)

vra_top: () => VraRange
vra_top = !=> VraRange(2, 0, 0)

vra_bounded: Int, Int => VraRange
vra_bounded = lo, hi => lo > hi | vra_bot! | VraRange(1, lo, hi)

vra_const: Int => VraRange
vra_const = v => VraRange(1, v, v)

vra_is_tracked_int_vt: ast::ValueType => <>
vra_is_tracked_int_vt = [Int, I64]

vra_eq: VraRange, VraRange => <>
vra_eq = a, b =>
   a.state == b.state && (a.state != 1 || (a.lo == b.lo && a.hi == b.hi))

vra_join: VraRange, VraRange => VraRange
vra_join = a, b =>
   a.state == 0 | --| b
   b.state == 0 | --| a
   a.state == 2 || b.state == 2 | --| vra_top!
   lo = a.lo < b.lo | a.lo | b.lo
   hi = a.hi > b.hi | a.hi | b.hi
   VraRange(1, lo, hi)

vra_meet: VraRange, VraRange => VraRange
vra_meet = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   a.state == 2 | --| b
   b.state == 2 | --| a
   lo = a.lo > b.lo | a.lo | b.lo
   hi = a.hi < b.hi | a.hi | b.hi
   lo > hi | vra_bot! | VraRange(1, lo, hi)

vra_reset: () => ()
vra_reset = !=>
   vra.enabled = <->
   vra.whole_prog = <->
   vra.changed = <->
   vra.skip_bot_params = <->
   vra.in_narrow = <->
   vra.cur_fn_name = ""
   vra.field_idx = VraIndex()
   vra.field_rngs = VraRanges()
   vra.anon_idx = VraIndex()
   vra.anon_rngs = VraRanges()
   vra.named_shapes = NamedShapeMetas()
   vra.named_shape_keys = ast::Names()
   vra.poison_shapes = ast::Names()
   vra.param_idx = VraIndex()
   vra.param_rngs = VraRanges()
   vra.fn_ret_idx = VraIndex()
   vra.fn_ret_rngs = VraRanges()
   vra.poison_fns = ast::Names()
   vra.locals = VraLocals()
   vra.cur_muts = ast::Names()
   vra.bounded_idxs = BoundedStrIdxs()
   vra.len_vars = LenVarEntries()
   vra.snap_field_rngs = VraRanges()
   vra.snap_anon_rngs = VraRanges()
   vra.snap_param_rngs = VraRanges()
   vra.snap_fn_ret_rngs = VraRanges()

attach_i64_range_md: Cg, Addr, Int, Int => ()
attach_i64_range_md = cg, load_val, lo, hi =>
   near_full = lo == (const::min_i64 + 1) && hi == (const::max_i64 - 1)
   ok = load_val != sys::addr_null && lo > const::min_i64 &&
     hi < const::max_i64 && lo !> hi && !near_full
   ok
      |
         ctx = LLVMGetGlobalContext!
         i64t = LLVMInt64Type!
         md0 = LLVMValueAsMetadata(LLVMConstInt(i64t, lo, 0))
         md1 = LLVMValueAsMetadata(LLVMConstInt(i64t, hi + 1, 0))
         mds = (md0, md1)
         node = LLVMMDNodeInContext2(ctx, &mds, 2)
         kind = LLVMGetMDKindIDInContext(ctx, "range", 5)
         LLVMSetMetadata(load_val, kind, LLVMMetadataAsValue(ctx, node))

vra_checked_add: Int, Int => <Int|>
vra_checked_add = a, b =>
   ovf_pos = b > 0 && a > (const::max_i64 - b)
   ovf_neg = b < 0 && a < (const::min_i64 - b)
   ovf_pos || ovf_neg | <--> | <+ a + b +>

vra_checked_sub: Int, Int => <Int|>
vra_checked_sub = a, b =>
   ovf_pos = b < 0 && a > (const::max_i64 + b)
   ovf_neg = b > 0 && a < (const::min_i64 + b)
   ovf_pos || ovf_neg | <--> | <+ a - b +>

vra_checked_mul: Int, Int => <Int|>
vra_checked_mul = a, b =>
   a == 0 || b == 0 | --| <+ 0 +>
   (a == const::min_i64 && b == -1) || (b == const::min_i64 && a == -1) | --| <-->
   ovf = a > 0 && b > 0
      | a > (const::max_i64 / b)
      | a < 0 && b < 0
         | a < (const::max_i64 / b)
         | a > 0 && b < 0
            | b < (const::min_i64 / a)
            | a < (const::min_i64 / b)
   ovf | <--> | <+ a * b +>

vra_neg: VraRange => VraRange
vra_neg = r =>
   r.state != 1 | --| r
   r.lo == const::min_i64 | vra_top! | VraRange(1, -r.hi, -r.lo)

vra_add: VraRange, VraRange => VraRange
vra_add = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   a.state == 2 || b.state == 2 | --| vra_top!
   lo_opt = vra_checked_add(a.lo, b.lo)
   hi_opt = vra_checked_add(a.hi, b.hi)
   lo_opt
      | lo =>
         hi_opt
            | hi => VraRange(1, lo, hi)
            | vra_top!
      | vra_top!

vra_sub: VraRange, VraRange => VraRange
vra_sub = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   a.state == 2 || b.state == 2 | --| vra_top!
   lo_opt = vra_checked_sub(a.lo, b.hi)
   hi_opt = vra_checked_sub(a.hi, b.lo)
   lo_opt
      | lo =>
         hi_opt
            | hi => VraRange(1, lo, hi)
            | vra_top!
      | vra_top!

vra_mul: VraRange, VraRange => VraRange
vra_mul = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   (a.state == 1 && a.lo == 0 && a.hi == 0) || (b.state == 1 && b.lo == 0 && b.hi == 0)
      | --| vra_const(0)
   a.state == 2 || b.state == 2 | --| vra_top!
   p00 = vra_checked_mul(a.lo, b.lo)
   p01 = vra_checked_mul(a.lo, b.hi)
   p10 = vra_checked_mul(a.hi, b.lo)
   p11 = vra_checked_mul(a.hi, b.hi)
   !(<>(p00) && <>(p01) && <>(p10) && <>(p11)) | --| vra_top!
   v0 = p00!!
   v1 = p01!!
   v2 = p10!!
   v3 = p11!!
   lo0 = v0 < v1 | v0 | v1
   lo1 = v2 < v3 | v2 | v3
   hi0 = v0 > v1 | v0 | v1
   hi1 = v2 > v3 | v2 | v3
   VraRange(1, (lo0 < lo1 | lo0 | lo1), (hi0 > hi1 | hi0 | hi1))

vra_square: VraRange => VraRange
vra_square = a =>
   a.state == 0 | --| vra_bot!
   a.state == 2 | --| vra_top!
   p_lo = vra_checked_mul(a.lo, a.lo)
   p_hi = vra_checked_mul(a.hi, a.hi)
   !(<>(p_lo) && <>(p_hi)) | --| vra_top!
   s_lo = p_lo!!
   s_hi = p_hi!!
   a.lo !< 0
      | VraRange(1, s_lo, s_hi)
      | a.hi !> 0
         | VraRange(1, s_hi, s_lo)
         | VraRange(1, 0, (s_lo > s_hi | s_lo | s_hi))

vra_mod: VraRange, VraRange => VraRange
vra_mod = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   b.state != 1 | --| vra_top!
   b.lo == 0 && b.hi == 0 | --| vra_top!
   b_lim = b.lo == const::min_i64
      | const::max_i64
      |
         alo = b.lo < 0 | -b.lo | b.lo
         ahi = b.hi < 0 | -b.hi | b.hi
         bmax = alo > ahi | alo | ahi
         bmax == 0 | 0 | bmax - 1
   a.state == 1 && a.lo !< 0
      | --| VraRange(1, 0, (a.hi < b_lim | a.hi | b_lim))
   a.state == 1 && a.hi !> 0
      | --| VraRange(1, (a.lo > -b_lim | a.lo | -b_lim), 0)
   lo = a.state == 1 && a.lo > -b_lim | a.lo | -b_lim
   hi = a.state == 1 && a.hi < b_lim | a.hi | b_lim
   VraRange(1, lo, hi)

vra_div: VraRange, VraRange => VraRange
vra_div = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   a.state != 1 || b.state != 1 | --| vra_top!
   b.lo == 0 && b.hi == 0 | --| vra_top!
   a.lo == 0 && a.hi == 0 | --| vra_const(0)
   has_neg_one = b.lo !> -1 && b.hi !< -1
   a.lo == const::min_i64 && has_neg_one | --| vra_top!
   b.lo > 0 || b.hi < 0
      |
         q00 = a.lo / b.lo
         q01 = a.lo / b.hi
         q10 = a.hi / b.lo
         q11 = a.hi / b.hi
         lo0 = q00 < q01 | q00 | q01
         lo1 = q10 < q11 | q10 | q11
         hi0 = q00 > q01 | q00 | q01
         hi1 = q10 > q11 | q10 | q11
         --| VraRange(1, (lo0 < lo1 | lo0 | lo1), (hi0 > hi1 | hi0 | hi1))
   // b spans 0; non-trapping paths satisfy |b| >= 1.
   b.lo == 0 && a.lo !< 0
      | --| VraRange(1, a.lo / b.hi, a.hi)
   a.lo == const::min_i64 | --| vra_top!
   abs_alo = a.lo < 0 | -a.lo | a.lo
   abs_ahi = a.hi < 0 | -a.hi | a.hi
   max_a = abs_alo > abs_ahi | abs_alo | abs_ahi
   b.lo == 0
      | VraRange(1, a.lo, a.hi)
      | VraRange(1, -max_a, max_a)

vra_bitand: VraRange, VraRange => VraRange
vra_bitand = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   a.state == 1 && b.state == 1 && a.lo == a.hi && b.lo == b.hi
      | --| vra_const(a.lo .&. b.lo)
   a_nn = a.state == 1 && a.lo !< 0
   b_nn = b.state == 1 && b.lo !< 0
   a_nn && b_nn
      | --| VraRange(1, 0, (a.hi < b.hi | a.hi | b.hi))
   b_nn | --| VraRange(1, 0, b.hi)
   a_nn | --| VraRange(1, 0, a.hi)
   vra_top!

vra_shr: VraRange, VraRange => VraRange
vra_shr = a, b =>
   a.state == 0 || b.state == 0 | --| vra_bot!
   a.state != 1 || b.state != 1 | --| vra_top!
   b.lo < 0 || b.hi !< 64 | --| vra_top!
   s00 = a.lo .>. b.lo
   s01 = a.lo .>. b.hi
   s10 = a.hi .>. b.lo
   s11 = a.hi .>. b.hi
   lo0 = s00 < s01 | s00 | s01
   lo1 = s10 < s11 | s10 | s11
   hi0 = s00 > s01 | s00 | s01
   hi1 = s10 > s11 | s10 | s11
   VraRange(1, (lo0 < lo1 | lo0 | lo1), (hi0 > hi1 | hi0 | hi1))

vra_resolve_ti_name_d: Cg, ast::TypeInfo, Int => String
vra_resolve_ti_name_d = cg, ti, depth =>
   depth !< 8 | --| ""
   ti
      [Align a] vra_resolve_ti_name_d(cg, a.1, depth + 1)
      [TypeVar tv]
         rname = resolve_type_name(cg, tv)
         under = typedef_ti(cg, rname)
         under
            [TypeVar tv2]
               (tv2 == tv || tv2 == rname)
                  | rname
                  | vra_resolve_ti_name_d(cg, under, depth + 1)
            [Align a2] vra_resolve_ti_name_d(cg, a2.1, depth + 1)
            | rname
      | ""

vra_resolve_ti_name: Cg, ast::TypeInfo => String
vra_resolve_ti_name = cg, ti => vra_resolve_ti_name_d(cg, ti, 0)

vra_vt_tag: ast::ValueType => String
vra_vt_tag =
   [Int] "i64"
   [I64] "i64"
   [I8] "i8"
   [I16] "i16"
   [I32] "i32"
   [U8] "u8"
   [U16] "u16"
   [U32] "u32"
   [U64] "u64"
   [Rune] "rune"
   [Float] "f64"
   [F32] "f32"
   [Str] "str"
   [Flag] "flag"
   [Unit] "unit"
   [RawPtr] "ptr"
   [Builder] "bldr"
   [Error] "err"
   [Ram] "ram"
   [Enum] "enum"
   [Array] "arr"
   [Slice] "sl"
   [Map] "map"
   [Fn] "fn"
   [Record] "rec"
   | "oth"

vra_rf_ti: ast::RecordFieldType => ast::TypeInfo
vra_rf_ti = rf =>
   rf.rec_type
      [Prim up] (up [Unknown] ast::TypeInfo(Prim, rf.val_type) | rf.rec_type)
      | rf.rec_type

vra_ti_sig_d: Cg, ast::TypeInfo, Int => String
vra_ti_sig_d = cg, ti, depth =>
   depth !< 6 | --| ""
   ti
      [Prim p] vra_vt_tag(p)
      [TypeVar tv]
         rname = vra_resolve_ti_name(cg, ti)
         under = typedef_ti(cg, rname)
         under [Prim] "tv:${rname}" | vra_ti_sig_d(cg, under, depth)
      [Align a] vra_ti_sig_d(cg, a.1, depth)
      [Rec r]
         flds = r.0
         nf = ?flds
         r.1
            |
               fsig0 = nf > 0 | vra_ti_sig_d(cg, vra_rf_ti(flds(0)!!), depth + 1) | ""
               "sl[${vra_vt_tag(r.3)}:${fsig0}]"
            | r.2 && r.4 > 0
               |
                  fsig0 = nf > 0
                     | vra_ti_sig_d(cg, vra_rf_ti(flds(0)!!), depth + 1)
                     | vra_vt_tag(r.3)
                  "rep${str::from_int(r.4)}[${fsig0}]"
               | nf > 32
                  | "rec_large_${str::from_int(nf)}"
                  |
                     b = {64}
                     b += "rec${str::from_int(nf)}["
                     nf @ i =>
                        i > 0 | b += ","
                        rf = flds(i)!!
                        b += vra_ti_sig_d(cg, vra_rf_ti(rf), depth + 1)
                     b += "]"
                     +b
      [Array a] "arr[${vra_ti_sig_d(cg, norm_slot_ti(a.0, a.1), depth + 1)}]"
      [Map m] "map[${vra_vt_tag(m.0)},${vra_ti_sig_d(cg, norm_slot_ti(m.1, m.2), depth + 1)}]"
      [Bitfield bf] "bf[${vra_vt_tag(bf.backing_type)}:${str::from_int(bf.total_bits)}]"
      [Ram rs]
         !rs.0.has_payload && !rs.1.has_payload | --| "flag"
         s0 = rs.0.has_payload
            | vra_ti_sig_d(cg, norm_slot_ti(rs.0.payload_type, rs.0.payload_record), depth + 1)
            | "_"
         s1 = rs.1.has_payload
            | vra_ti_sig_d(cg, norm_slot_ti(rs.1.payload_type, rs.1.payload_record), depth + 1)
            | "_"
         "ram[${s0}|${s1}]"
      [Enum slots] "enum${str::from_int(?slots)}"
      [Fn] "fn"
      | "oth"

vra_rec_anon_sig: Cg, ast::TypeInfo => String
vra_rec_anon_sig = cg, ti => vra_ti_sig_d(cg, ti, 0)

vra_ti_is_record_like: Cg, ast::TypeInfo => <>
vra_ti_is_record_like = cg, ti =>
   ti
      [Align a] vra_ti_is_record_like(cg, a.1)
      [Rec r] !r.1
      [TypeVar tv]
         rname = vra_resolve_ti_name(cg, ti)
         rname != "" && vra_ti_is_record_like(cg, typedef_ti(cg, rname))
      | <->

vra_ti_field_types: Cg, ast::TypeInfo => ast::FieldTypes
vra_ti_field_types = cg, ti =>
   ti
      [Align a] vra_ti_field_types(cg, a.1)
      [Rec r]
         res_r = r.1 | ast::FieldTypes() | r.0
         res_r
      [TypeVar tv]
         rname = vra_resolve_ti_name(cg, ti)
         res_tv = rname != ""
            | vra_ti_field_types(cg, typedef_ti(cg, rname))
            | ast::FieldTypes()
         res_tv
      | ast::FieldTypes()

vra_resolve_field_idx: Cg, ast::TypeInfo, String, Int => Int
vra_resolve_field_idx = cg, rec_ti, fname, fidx =>
   fidx !< 0 | --| fidx
   fname == "" | --| -1
   flds = vra_ti_field_types(cg, rec_ti)
   flds @ el_, i =>
      el_.name == fname | --| i
   -1

vra_add_poison_shape: String => ()
vra_add_poison_shape = skey =>
   skey != "" && !has_str(vra.poison_shapes, skey)
      | vra.poison_shapes += skey

vra_add_poison_fn: String => ()
vra_add_poison_fn = fname =>
   fname != "" && !has_str(vra.poison_fns, fname)
      | vra.poison_fns += fname

vra_poison_ti_shapes_d: Cg, ast::TypeInfo, Int => ()
vra_poison_ti_shapes_d = cg, ti, depth =>
   depth < 8
      |
         ti
            [Align a] vra_poison_ti_shapes_d(cg, a.1, depth + 1)
            [TypeVar]
               rname = vra_resolve_ti_name(cg, ti)
               rname != "" && !has_str(vra.poison_shapes, rname)
                  |
                     vra_add_poison_shape(rname)
                     under = typedef_ti(cg, rname)
                     vra_ti_is_record_like(cg, under)
                        |
                           asig = vra_rec_anon_sig(cg, under)
                           asig != "" | vra_add_poison_shape("anon::${asig}")
                     vra_poison_ti_shapes_d(cg, under, depth + 1)
            [Rec r]
               nf = ?r.0
               !r.1 && nf !> 32
                  | vra_add_poison_shape("anon::${vra_ti_sig_d(cg, ti, depth)}")
               lim = r.2 | (nf > 0 | 1 | 0) | %min(nf, 32)
               lim @ i =>
                  rf = r.0(i)!!
                  fti = vra_rf_ti(rf)
                  vra_poison_ti_shapes_d(cg, fti, depth + 1)
            [Array a] vra_poison_ti_shapes_d(cg, norm_slot_ti(a.0, a.1), depth + 1)
            [Map m] vra_poison_ti_shapes_d(cg, norm_slot_ti(m.1, m.2), depth + 1)
            [Ram rs]
               rs.0.has_payload
                  | vra_poison_ti_shapes_d(cg, norm_slot_ti(rs.0.payload_type, rs.0.payload_record), depth + 1)
               rs.1.has_payload
                  | vra_poison_ti_shapes_d(cg, norm_slot_ti(rs.1.payload_type, rs.1.payload_record), depth + 1)
            [Enum slots]
               slots @ sl =>
                  sl.has_payload | vra_poison_ti_shapes_d(cg, sl.payload_record, depth + 1)
            [Fn f]
               f.1 @ el_ => vra_poison_ti_shapes_d(cg, el_, depth + 1)
               vra_poison_ti_shapes_d(cg, f.3, depth + 1)
            [ThreadId t] vra_poison_ti_shapes_d(cg, t.1, depth + 1)

vra_poison_ti_shapes: Cg, ast::TypeInfo => ()
vra_poison_ti_shapes = cg, ti => vra_poison_ti_shapes_d(cg, ti, 0)

vra_join_slot: VraIndex, VraRanges, String, VraRange => ()
vra_join_slot = idx_map, rngs, key, nr =>
   nr.state != 0
      |
         idx_map ^? key
            |
               pos = idx_map ^ key | _ | -1
               pos !< 0
                  |
                     old = rngs(pos)!!
                     merged = vra_join(old, nr)
                     !vra_eq(old, merged)
                        |
                           rngs(pos) = merged !| _
                           vra.changed = <+>
            |
               idx_map ^ key = ?rngs
               rngs += nr
               vra.changed = <+>

vra_record_shape_field: Cg, ast::TypeInfo, Int, VraRange => ()
vra_record_shape_field = cg, rec_ti, fidx, rng =>
   vra.whole_prog && fidx !< 0 && fidx < 32 && rng.state != 0
      |
         ti_is_packed_or_bf(cg, rec_ti)
            | vra_poison_ti_shapes(cg, rec_ti)
            |
               rname = vra_resolve_ti_name(cg, rec_ti)
               rname != ""
                  |
                     !has_str(vra.poison_shapes, rname)
                        |
                           key = "${rname}::${str::from_int(fidx)}"
                           vra_join_slot(vra.field_idx, vra.field_rngs, key, rng)
                  |
                     flds = vra_ti_field_types(cg, rec_ti)
                     ?flds > 0 && ?flds !> 32
                        |
                           asig = vra_rec_anon_sig(cg, rec_ti)
                           !has_str(vra.poison_shapes, "anon::${asig}")
                              |
                                 key = "${asig}::${str::from_int(fidx)}"
                                 vra_join_slot(vra.anon_idx, vra.anon_rngs, key, rng)

vra_read_slot: VraIndex, VraRanges, VraRanges, String => VraRange
vra_read_slot = idx_map, live_rngs, snap_rngs, key =>
   !(idx_map ^? key) | --| vra_bot!
   pos = idx_map ^ key | _ | -1
   pos < 0 | --| vra_bot!
   vra.in_narrow && pos < ?snap_rngs
      | snap_rngs(pos)!!
      | live_rngs(pos)!!

vra_lookup_field: Cg, ast::TypeInfo, Int, <> => VraRange
vra_lookup_field = cg, rec_ti, fidx, bot_as_top =>
   !vra.enabled || !vra.whole_prog || fidx < 0 || fidx !< 32 | --| vra_top!
   ti_is_packed_or_bf(cg, rec_ti) | --| vra_top!
   rname = vra_resolve_ti_name(cg, rec_ti)
   res = rname != ""
      |
         has_str(vra.poison_shapes, rname)
            | vra_top!
            |
               key = "${rname}::${str::from_int(fidx)}"
               vra_read_slot(vra.field_idx, vra.field_rngs, vra.snap_field_rngs, key)
      |
         flds = vra_ti_field_types(cg, rec_ti)
         ?flds == 0 || ?flds > 32
            | vra_top!
            |
               asig = vra_rec_anon_sig(cg, rec_ti)
               has_str(vra.poison_shapes, "anon::${asig}")
                  | vra_top!
                  |
                     key = "${asig}::${str::from_int(fidx)}"
                     vra_read_slot(vra.anon_idx, vra.anon_rngs, vra.snap_anon_rngs, key)
   bot_as_top && res.state == 0 | vra_top! | res

vra_lookup_field_for_load: Cg, ast::TypeInfo, Int => VraRange
vra_lookup_field_for_load = cg, rec_ti, fidx =>
   vra_lookup_field(cg, rec_ti, fidx, <+>)

vra_lookup_param_for_codegen: String, Int => VraRange
vra_lookup_param_for_codegen = fn_name, pidx =>
   !vra.enabled || !vra.whole_prog | --| vra_top!
   has_str(vra.poison_fns, fn_name) | --| vra_top!
   key = "${fn_name}::${str::from_int(pidx)}"
   !(vra.param_idx ^? key) | --| vra_top!
   r = vra.param_rngs(vra.param_idx ^ key | _ | 0)!!
   r.state == 0 | vra_top! | r

vra_lookup_fn_ret: String, <> => VraRange
vra_lookup_fn_ret = fn_name, bot_as_top =>
   !vra.enabled || !vra.whole_prog | --| vra_top!
   has_str(vra.poison_fns, fn_name) | --| vra_top!
   r = vra_read_slot(vra.fn_ret_idx, vra.fn_ret_rngs, vra.snap_fn_ret_rngs, fn_name)
   bot_as_top && r.state == 0 | vra_top! | r

vra_finalize_anon_merges: () => ()
vra_finalize_anon_merges = !=>
   vra.whole_prog && (?vra.anon_rngs > 0 || ?vra.poison_shapes > 0)
      |
         vra.named_shapes @ ns =>
            ap_key = "anon::${ns.anon_sig}"
            has_str(vra.poison_shapes, ap_key)
               | vra_add_poison_shape(ns.shape_key)
            has_str(vra.poison_shapes, ns.shape_key)
               | vra_add_poison_shape(ap_key)
            nf = ?ns.field_names
            nf @ k =>
               kstr = str::from_int(k)
               ak = "${ns.anon_sig}::${kstr}"
               fk = "${ns.shape_key}::${kstr}"
               vra.anon_idx ^? ak
                  |
                     ar = vra.anon_rngs(vra.anon_idx ^ ak | _ | 0)!!
                     vra_join_slot(vra.field_idx, vra.field_rngs, fk, ar)
               vra.field_idx ^? fk
                  |
                     fr = vra.field_rngs(vra.field_idx ^ fk | _ | 0)!!
                     vra.anon_idx ^? ak
                        | vra_join_slot(vra.anon_idx, vra.anon_rngs, ak, fr)

#type VraCycleScope (locals: VraLocals, bounds: BoundedStrIdxs, lengths: LenVarEntries)

vra_scope_shadows: ast::Names, String, <>, String => <>
vra_scope_shadows = params, binding, is_cycle, name =>
   (is_cycle && (name ["_", "_i"])) || (binding != "" && name == binding) || has_str(params, name)

// A bound depends on both the index and the collection it describes.
vra_enter_scope: ast::Names, String, <> => VraCycleScope
vra_enter_scope = params, binding, is_cycle =>
   saved = VraCycleScope(vra.locals, vra.bounded_idxs, vra.len_vars)
   vra.enabled
      |
         locals = VraLocals()
         saved.locals @ e =>
            !vra_scope_shadows(params, binding, is_cycle, e.name) | locals += e
         bounds = BoundedStrIdxs()
         saved.bounds @ e =>
            !(vra_scope_shadows(params, binding, is_cycle, e.idx_var) ||
              vra_scope_shadows(params, binding, is_cycle, e.str_var))
               | bounds += e
         lengths = LenVarEntries()
         saved.lengths @ e =>
            !(vra_scope_shadows(params, binding, is_cycle, e.len_var) ||
              vra_scope_shadows(params, binding, is_cycle, e.str_var))
               | lengths += e
         vra.locals = locals
         vra.bounded_idxs = bounds
         vra.len_vars = lengths
   saved

vra_enter_cycle: ast::Names => VraCycleScope
vra_enter_cycle = params => vra_enter_scope(params, "", <+>)

vra_enter_binding: String => <VraCycleScope|>
vra_enter_binding = name =>
   vra.enabled && name != "" | <+ vra_enter_scope(ast::Names(), name, <->) +> | <-->

vra_leave_scope: VraCycleScope => ()
vra_leave_scope = saved =>
   vra.locals = saved.locals
   vra.bounded_idxs = saved.bounds
   vra.len_vars = saved.lengths

vra_truncate_locals: Int => ()
vra_truncate_locals = n =>
   ?vra.locals > n
      |
         out = VraLocals()
         n @ i => out += vra.locals(i)!!
         vra.locals = out

vra_truncate_bounded: Int => ()
vra_truncate_bounded = n =>
   ?vra.bounded_idxs > n
      |
         out = BoundedStrIdxs()
         n @ i => out += vra.bounded_idxs(i)!!
         vra.bounded_idxs = out

vra_truncate_len_vars: Int => ()
vra_truncate_len_vars = n =>
   ?vra.len_vars > n
      |
         out = LenVarEntries()
         n @ i => out += vra.len_vars(i)!!
         vra.len_vars = out

vra_find_str_idx: ast::Names, String => Int
vra_find_str_idx = names, target =>
   names @ el_, i =>
      el_ == target | --| i
   -1

// Collect variables reassigned, mutated, taken by addr, or shadowed inside a fn.
// Sibling `Cycle` loop vars stay tracked unless also bound outside Cycle headers.
vra_bump_bind: ast::Names, ast::Ints, String, Int => ()
vra_bump_bind = bnames, bcnts, nm, delta =>
   nm != "" && nm != "_" && nm != "_i"
      |
         pos = vra_find_str_idx(bnames, nm)
         pos !< 0
            |
               bcnts(pos) = bcnts(pos)!! + delta !| _
            |
               bnames += nm
               bcnts += delta

vra_scan_muts_list: tast::TypedExprs, ast::Names, ast::Ints, ast::Names => ()

vra_scan_muts_expr: tast::TypedExpr, ast::Names, ast::Ints, ast::Names => ()
vra_scan_muts_expr = te, bnames, bcnts, cyc_vars =>
   te.kind
      [Assign a]
         delta = (a.1 || a.2 || a.3) | 2 | 1
         vra_bump_bind(bnames, bcnts, a.0, delta)
         vra_scan_muts_expr(a.5, bnames, bcnts, cyc_vars)
      [Unary u]
         u.0 [AddrOf]
            u.1.kind [Var v] vra_bump_bind(bnames, bcnts, v.0, 2)
         vra_scan_muts_expr(u.1, bnames, bcnts, cyc_vars)
      [Bin b]
         vra_scan_muts_expr(b.1, bnames, bcnts, cyc_vars)
         vra_scan_muts_expr(b.2, bnames, bcnts, cyc_vars)
      [Call c]
         c.1 | ct => vra_scan_muts_expr(ct, bnames, bcnts, cyc_vars)
         vra_scan_muts_list(c.2, bnames, bcnts, cyc_vars)
      [Block bk] vra_scan_muts_list(bk, bnames, bcnts, cyc_vars)
      [Record rf]
         rf @ el_ => vra_scan_muts_expr(el_.val, bnames, bcnts, cyc_vars)
      [Member m] vra_scan_muts_expr(m.0, bnames, bcnts, cyc_vars)
      [MemberWrite mw]
         vra_scan_muts_expr(mw.0, bnames, bcnts, cyc_vars)
         vra_scan_muts_expr(mw.3, bnames, bcnts, cyc_vars)
      [Index ix]
         vra_scan_muts_expr(ix.0, bnames, bcnts, cyc_vars)
         vra_scan_muts_expr(ix.1, bnames, bcnts, cyc_vars)
      [IndexWrite iw]
         vra_scan_muts_expr(iw.0, bnames, bcnts, cyc_vars)
         vra_scan_muts_expr(iw.1, bnames, bcnts, cyc_vars)
         vra_scan_muts_expr(iw.2, bnames, bcnts, cyc_vars)
      [KeyAccess ka]
         vra_scan_muts_expr(ka.0, bnames, bcnts, cyc_vars)
         vra_scan_muts_expr(ka.1, bnames, bcnts, cyc_vars)
      [Choice ch]
         vra_scan_muts_expr(ch.0, bnames, bcnts, cyc_vars)
         ch.1 @ br =>
            br.bind_vars @ el_ =>
               vra_bump_bind(bnames, bcnts, el_, 1)
            vra_scan_muts_list(br.case_values, bnames, bcnts, cyc_vars)
            vra_scan_muts_expr(br.body, bnames, bcnts, cyc_vars)
      [Cycle cy]
         vra_scan_muts_expr(cy.0, bnames, bcnts, cyc_vars)
         cy.1.kind
            [Lambda lam]
               lam.0 @ p =>
                  p != "" && p != "_" && !has_str(cyc_vars, p)
                     | cyc_vars += p
               vra_scan_muts_expr(lam.1, bnames, bcnts, cyc_vars)
            | vra_scan_muts_expr(cy.1, bnames, bcnts, cyc_vars)
         cy.2 | e => vra_scan_muts_expr(e, bnames, bcnts, cyc_vars)
      [Lambda lam]
         lam.0 @ el_ => vra_bump_bind(bnames, bcnts, el_, 1)
         vra_scan_muts_expr(lam.1, bnames, bcnts, cyc_vars)
      [Copy cp] vra_scan_muts_expr(cp, bnames, bcnts, cyc_vars)
      [BuilderNew bn] vra_scan_muts_expr(bn, bnames, bcnts, cyc_vars)
      [RawMemory rm] vra_scan_muts_expr(rm.0, bnames, bcnts, cyc_vars)
      [RawMemoryWrite rmw]
         vra_scan_muts_expr(rmw.0, bnames, bcnts, cyc_vars)
         vra_scan_muts_expr(rmw.1, bnames, bcnts, cyc_vars)
      [MapLiteral ml]
         ml @ pr =>
            vra_scan_muts_expr(pr.key, bnames, bcnts, cyc_vars)
            vra_scan_muts_expr(pr.val, bnames, bcnts, cyc_vars)
      [RamConstruct rc]
         rc.2 | p => vra_scan_muts_expr(p, bnames, bcnts, cyc_vars)
      [EnumConstruct ec]
         ec.1 | p => vra_scan_muts_expr(p, bnames, bcnts, cyc_vars)
      [Exit ex] vra_scan_muts_expr(ex, bnames, bcnts, cyc_vars)
      [Return r_opt]
         r_opt | rv => vra_scan_muts_expr(rv, bnames, bcnts, cyc_vars)

vra_scan_muts_list = exprs, bnames, bcnts, cyc_vars =>
   exprs @ el_ => vra_scan_muts_expr(el_, bnames, bcnts, cyc_vars)

vra_collect_mut_vars: ast::Names, tast::TypedExpr => ast::Names
vra_collect_mut_vars = fn_params, body =>
   bnames = ast::Names()
   bcnts = ast::Ints()
   cyc_vars = ast::Names()
   fn_params @ el_ => vra_bump_bind(bnames, bcnts, el_, 1)
   vra_scan_muts_expr(body, bnames, bcnts, cyc_vars)
   muts = ast::Names()
   muts += "_"
   muts += "_i"
   ?bnames @ i =>
      nm = bnames(i)!!
      cnt = bcnts(i)!!
      in_cyc = has_str(cyc_vars, nm)
      cnt !< 2 || (cnt !< 1 && in_cyc)
         | muts += nm
   muts

vra_expr_always_exits: tast::TypedExpr => <>
vra_expr_always_exits = te =>
   te.kind
      [Return] <+>
      [Exit] <+>
      [CycleJump] <+>
      [Block bk]
         ?bk == 0
            | <->
            | vra_expr_always_exits(bk(?bk - 1)!!)
      [Choice ch]
         ?ch.1 == 0
            | <->
            |
               last_br = ch.1(?ch.1 - 1)!!
               last_br.kind [Bare]
                  |
                     all_ex' = <+>
                     ch.1 @ el_ =>
                        !vra_expr_always_exits(el_.body)
                           |
                              all_ex' = <->
                              -->
                     all_ex'
                  | <->
      | <->

vra_same_pure_expr: tast::TypedExpr, tast::TypedExpr => <>
vra_same_pure_expr = a, b =>
   a.kind
      [LitInt av]
         b.kind [LitInt bv] av == bv | <->
      [Var av]
         !av.2 && !has_str(vra.cur_muts, av.0)
            | (b.kind [Var bv] (!bv.2 && av.0 == bv.0) | <->)
            | <->
      [Member am]
         b.kind [Member bm]
            (am.1 == bm.1 && am.2 == bm.2 && vra_same_pure_expr(am.0, bm.0))
         | <->
      [Unary au]
         au.0 [Neg, Length, BitNot]
            | (b.kind [Unary bu]
              (vra_same_pure_expr(au.1, bu.1) &&
                ((au.0 [Neg] && bu.0 [Neg]) ||
                  (au.0 [Length] && bu.0 [Length]) ||
                  (au.0 [BitNot] && bu.0 [BitNot])))
              | <->)
            | <->
      [Bin ab]
         ab.0 [Add, Sub]
            | (b.kind [Bin bb]
              ((ab.0 [Add] && bb.0 [Add]) || (ab.0 [Sub] && bb.0 [Sub])) &&
                vra_same_pure_expr(ab.1, bb.1) &&
                vra_same_pure_expr(ab.2, bb.2)
              | <->)
            | <->
      | <->

vra_lookup_local_var: Cg, String => VraRange
vra_lookup_local_var = cg, vname =>
   vname == "" || has_str(vra.cur_muts, vname) || is_marked_global_name(cg, vname)
      | --| vra_top!
   n = ?vra.locals
   n @ rev_i =>
      i = n - 1 - rev_i
      e = vra.locals(i)!!
      e.name == vname | --| e.rng
   vra_top!

vra_narrow_local_var: Cg, String, VraRange => ()
vra_narrow_local_var = cg, vname, nr =>
   vname != "" && !has_str(vra.cur_muts, vname) &&
     !is_marked_global_name(cg, vname)
        |
           cur = vra_lookup_local_var(cg, vname)
           narrowed = vra_meet(cur, nr)
           vra.locals += VraLocal(vname, narrowed)

vra_imm_var: Cg, tast::TypedExpr, <> => String
vra_imm_var = cg, te, want_int =>
   vopt = te.kind [Var v] <+ v +> | <-->
   vopt
      | v =>
         vt = vt_from_ti_cg(cg, te.ti)
         type_ok = want_int | vra_is_tracked_int_vt(vt) | is_str_vt(vt)
         imm_ok = !v.2 && !has_str(vra.cur_muts, v.0) &&
           !is_marked_global_name(cg, v.0)
         type_ok && imm_ok | v.0 | ""
      | ""

vra_len_var_root: Cg, String => String
vra_len_var_root = cg, name =>
   has_str(vra.cur_muts, name) | --| ""
   n = ?vra.len_vars
   n @ rev_i =>
      i = n - 1 - rev_i
      lv = vra.len_vars(i)!!
      lv.len_var == name | --| lv.str_var
   ""

vra_str_bound_var: Cg, tast::TypedExpr => String
vra_str_bound_var = cg, te =>
   te.kind
      [Unary u]
         res_u = u.0 [Length] | vra_imm_var(cg, u.1, <->) | ""
         res_u
      [Var v]
         res_v = !v.2 && !has_str(vra.cur_muts, v.0) && !is_marked_global_name(cg, v.0)
            | vra_len_var_root(cg, v.0)
            | ""
         res_v
      [Bin b]
         res_b = b.0 [Sub]
            |
               k = b.2.kind [LitInt kv] kv | -1
               k !< 0 | vra_str_bound_var(cg, b.1) | ""
            | ""
         res_b
      [Call c]
         res_c = c.0 == "%min" && ?c.2 == 2
            |
               r0 = vra_str_bound_var(cg, c.2(0)!!)
               r0 != "" | r0 | vra_str_bound_var(cg, c.2(1)!!)
            | ""
         res_c
      | ""

vra_record_len_var: Cg, String, tast::TypedExpr => ()
vra_record_len_var = cg, lhs_name, rhs_te =>
   vra.enabled && lhs_name != "" && !has_str(vra.cur_muts, lhs_name) &&
     !is_marked_global_name(cg, lhs_name)
        |
           sv = vra_str_bound_var(cg, rhs_te)
           sv != "" | vra.len_vars += LenVarEntry(lhs_name, sv)

vra_fn_exists_in: ast::Names, String => <>
vra_fn_exists_in = fn_names, target => has_str(fn_names, target)

vra_resolve_callee_in: Cg, String, ast::Names => String
vra_resolve_callee_in = cg, raw, fn_names =>
   raw == "" | --| ""
   vra_fn_exists_in(fn_names, raw) | --| raw
   rf = resolve_fn_name(cg, raw)
   vra_fn_exists_in(fn_names, rf) | --| rf
   cg.current_module != "" && !name_is_qualified(raw, 0)
      |
         p0 = "${cg.current_module}::${raw}"
         vra_fn_exists_in(fn_names, p0) | --| p0
         p1 = "${cg.current_module}::#${raw}"
         vra_fn_exists_in(fn_names, p1) | --| p1
         ""
      | ""

vra_walk_expr: Cg, tast::TypedExpr, <>, ast::Names => VraRange

vra_narrow_cond: Cg, tast::TypedExpr, <>, ast::Names => ()
vra_narrow_cond = cg, cond, is_true, fn_names =>
   cond.kind
      [Unary u]
         u.0 [Not] | vra_narrow_cond(cg, u.1, !is_true, fn_names)
      [Bin b]
         is_true && (b.0 [And])
            |
               vra_narrow_cond(cg, b.1, <+>, fn_names)
               vra_narrow_cond(cg, b.2, <+>, fn_names)
         !is_true && (b.0 [Or])
            |
               vra_narrow_cond(cg, b.1, <->, fn_names)
               vra_narrow_cond(cg, b.2, <->, fn_names)
         !(is_true && (b.0 [And])) && !(!is_true && (b.0 [Or])) &&
           (b.0 [Eq, NotEq, Lt, Gt, NotLt, NotGt])
              |
                 lv = vra_walk_expr(cg, b.1, <->, fn_names)
                 rv = vra_walk_expr(cg, b.2, <->, fn_names)
                 l_var = vra_imm_var(cg, b.1, <+>)
                 r_var = vra_imm_var(cg, b.2, <+>)
                 // Normalize predicate polarity: NotEq<->==Eq, NotLt<->==Lt, NotGt<->==Gt
                 eff_eq = (b.0 [Eq] && is_true) || (b.0 [NotEq] && !is_true)
                 eff_ne = (b.0 [NotEq] && is_true) || (b.0 [Eq] && !is_true)
                 eff_gt = (b.0 [Gt] && is_true) || (b.0 [NotGt] && !is_true)
                 eff_nlt = (b.0 [NotLt] && is_true) || (b.0 [Lt] && !is_true)
                 eff_lt = (b.0 [Lt] && is_true) || (b.0 [NotLt] && !is_true)
                 eff_ngt = (b.0 [NotGt] && is_true) || (b.0 [Gt] && !is_true)
                 eff_eq
                    |
                       l_var != "" | vra_narrow_local_var(cg, l_var, rv)
                       r_var != "" | vra_narrow_local_var(cg, r_var, lv)
                    | eff_ne
                       |
                          l_var != "" && rv.state == 1 && rv.lo == rv.hi &&
                            lv.state == 1
                               |
                                  lv.lo == rv.lo && lv.lo < const::max_i64
                                     | vra_narrow_local_var(cg, l_var,
                                       vra_bounded(lv.lo + 1, lv.hi))
                                  lv.hi == rv.lo && lv.hi > const::min_i64
                                     | vra_narrow_local_var(cg, l_var,
                                       vra_bounded(lv.lo, lv.hi - 1))
                          r_var != "" && lv.state == 1 && lv.lo == lv.hi &&
                            rv.state == 1
                               |
                                  rv.lo == lv.lo && rv.lo < const::max_i64
                                     | vra_narrow_local_var(cg, r_var,
                                       vra_bounded(rv.lo + 1, rv.hi))
                                  rv.hi == lv.lo && rv.hi > const::min_i64
                                     | vra_narrow_local_var(cg, r_var,
                                       vra_bounded(rv.lo, rv.hi - 1))
                       |
                          eff_gt && rv.state == 1 && rv.lo < const::max_i64
                             | (l_var != "" | vra_narrow_local_var(cg, l_var,
                               VraRange(1, rv.lo + 1, const::max_i64)))
                          eff_gt && lv.state == 1 && lv.hi > const::min_i64
                             | (r_var != "" | vra_narrow_local_var(cg, r_var,
                               VraRange(1, const::min_i64, lv.hi - 1)))
                          eff_nlt && rv.state == 1
                             | (l_var != "" | vra_narrow_local_var(cg, l_var,
                               VraRange(1, rv.lo, const::max_i64)))
                          eff_nlt && lv.state == 1
                             | (r_var != "" | vra_narrow_local_var(cg, r_var,
                               VraRange(1, const::min_i64, lv.hi)))
                          eff_lt && rv.state == 1 && rv.hi > const::min_i64
                             | (l_var != "" | vra_narrow_local_var(cg, l_var,
                               VraRange(1, const::min_i64, rv.hi - 1)))
                          eff_lt && lv.state == 1 && lv.lo < const::max_i64
                             | (r_var != "" | vra_narrow_local_var(cg, r_var,
                               VraRange(1, lv.lo + 1, const::max_i64)))
                          eff_ngt && rv.state == 1
                             | (l_var != "" | vra_narrow_local_var(cg, l_var,
                               VraRange(1, const::min_i64, rv.hi)))
                          eff_ngt && lv.state == 1
                             | (r_var != "" | vra_narrow_local_var(cg, r_var,
                               VraRange(1, lv.lo, const::max_i64)))

vra_push_cycle_bounds_in: Cg, tast::TypedExpr, <>, ast::Names, <>, ast::Names => ()
vra_push_cycle_bounds_in = cg, iterable, is_rune, params, rec_eff, fn_names =>
   vra.enabled
      |
         p0 = ?params > 0 | params(0)!! | ""
         p1 = ?params > 1 | params(1)!! | ""
         p0_track = p0 != "" && p0 != "_" && !has_str(vra.cur_muts, p0)
         p1_track = p1 != "" && p1 != "_" && !has_str(vra.cur_muts, p1)
         bound_pushed' = <->
         iterable.kind
            [Bin b]
               b.0 [Seq]
                  |
                     lo_r = vra_walk_expr(cg, b.1, rec_eff, fn_names)
                     is_unb = b.2.kind [LitUnit]
                     hi_r = is_unb | vra_top! | vra_walk_expr(cg, b.2, rec_eff, fn_names)
                     p0_track
                        |
                           p0_rng = !is_unb && lo_r.state == 1 && hi_r.state == 1
                              |
                                 hi_r.hi !> lo_r.lo
                                    | vra_bot!
                                    | VraRange(1, lo_r.lo, hi_r.hi - 1)
                              | lo_r.state == 1
                                 | VraRange(1, lo_r.lo, const::max_i64)
                                 | vra_top!
                           vra.locals += VraLocal(p0, p0_rng)
                           is_zero_lo = b.1.kind [LitInt lv] (lv == 0) | <->
                           sv = is_zero_lo && !is_unb | vra_str_bound_var(cg, b.2) | ""
                           sv != ""
                              |
                                 vra.bounded_idxs += BoundedStrIdx(p0, sv)
                                 bound_pushed' = <+>
                     p1_track
                        |
                           vra.locals += VraLocal(p1, VraRange(1, 0, const::max_i64))
                  |
                     it_r = vra_walk_expr(cg, iterable, rec_eff, fn_names)
                     p0_track
                        |
                           p0_rng = it_r.state == 0
                              | vra_bot!
                              | it_r.state == 1
                                 | (it_r.hi > 0
                                    | VraRange(1, 0, it_r.hi - 1)
                                    | vra_bot!)
                                 | VraRange(1, 0, const::max_i64)
                           vra.locals += VraLocal(p0, p0_rng)
                           sv = vra_str_bound_var(cg, iterable)
                           sv != ""
                              |
                                 vra.bounded_idxs += BoundedStrIdx(p0, sv)
                                 bound_pushed' = <+>
            |
               it_vt = vt_from_ti_cg(cg, iterable.ti)
               is_str_it = is_str_vt(it_vt)
               is_coll_it = is_str_it || is_builder_vt(it_vt) || is_array_vt(it_vt) ||
                 is_slice_vt(it_vt) || is_record_vt(it_vt)
               is_coll_it
                  |
                     it_r = vra_walk_expr(cg, iterable, rec_eff, fn_names)
                     p0_track && is_str_it && !is_rune
                        | vra.locals += VraLocal(p0, VraRange(1, 0, 255))
                     p1_track
                        |
                           vra.locals += VraLocal(p1, VraRange(1, 0, const::max_i64))
                           is_str_it && !is_rune
                              |
                                 sv = vra_imm_var(cg, iterable, <->)
                                 sv != ""
                                    |
                                       vra.bounded_idxs += BoundedStrIdx(p1, sv)
                                       vra.bounded_idxs += BoundedStrIdx(p0, "")
                                       bound_pushed' = <+>
                  |
                     it_r = vra_walk_expr(cg, iterable, rec_eff, fn_names)
                     p0_track
                        |
                           p0_rng = it_r.state == 0
                              | vra_bot!
                              | it_r.state == 1
                                 | (it_r.hi > 0
                                    | VraRange(1, 0, it_r.hi - 1)
                                    | vra_bot!)
                                 | VraRange(1, 0, const::max_i64)
                           vra.locals += VraLocal(p0, p0_rng)
                           sv = vra_str_bound_var(cg, iterable)
                           sv != ""
                              |
                                 vra.bounded_idxs += BoundedStrIdx(p0, sv)
                                 bound_pushed' = <+>
         !bound_pushed' && p0 != "" && p0 != "_"
            | vra.bounded_idxs += BoundedStrIdx(p0, "")
         !bound_pushed' && p1 != "" && p1 != "_"
            | vra.bounded_idxs += BoundedStrIdx(p1, "")

vra_push_cycle_bounds: Cg, tast::TypedExpr, <>, ast::Names, <> => ()
vra_push_cycle_bounds = cg, iterable, is_rune, params, rec_eff =>
   vra_push_cycle_bounds_in(cg, iterable, is_rune, params, rec_eff, ast::Names())

vra_eval_intrinsic_call: Cg, String, tast::TypedExprs, <>, ast::Names => <VraRange|>
vra_eval_intrinsic_call = cg, fname, args, rec_eff, fn_names =>
   fname == "%min" && ?args == 2
      |
         r0 = vra_walk_expr(cg, args(0)!!, rec_eff, fn_names)
         r1 = vra_walk_expr(cg, args(1)!!, rec_eff, fn_names)
         res = r0.state == 0 || r1.state == 0
            | vra_bot!
            | r0.state == 1 && r1.state == 1
               | VraRange(1, (r0.lo < r1.lo | r0.lo | r1.lo),
                 (r0.hi < r1.hi | r0.hi | r1.hi))
               | r1.state == 1
                  | VraRange(1, const::min_i64, r1.hi)
                  | r0.state == 1
                     | VraRange(1, const::min_i64, r0.hi)
                     | vra_top!
         --| <+ res +>
   fname == "%max" && ?args == 2
      |
         r0 = vra_walk_expr(cg, args(0)!!, rec_eff, fn_names)
         r1 = vra_walk_expr(cg, args(1)!!, rec_eff, fn_names)
         res = r0.state == 0 || r1.state == 0
            | vra_bot!
            | r0.state == 1 && r1.state == 1
               | VraRange(1, (r0.lo > r1.lo | r0.lo | r1.lo),
                 (r0.hi > r1.hi | r0.hi | r1.hi))
               | r1.state == 1
                  | VraRange(1, r1.lo, const::max_i64)
                  | r0.state == 1
                     | VraRange(1, r0.lo, const::max_i64)
                     | vra_top!
         --| <+ res +>
   fname == "%clamp" && ?args == 3
      |
         rv = vra_walk_expr(cg, args(0)!!, rec_eff, fn_names)
         rl = vra_walk_expr(cg, args(1)!!, rec_eff, fn_names)
         rh = vra_walk_expr(cg, args(2)!!, rec_eff, fn_names)
         res = rv.state == 0 || rl.state == 0 || rh.state == 0
            | vra_bot!
            | rl.state == 1 && rh.state == 1 && rl.hi !> rh.lo
               |
                  rv.state == 1
                     | VraRange(1, (rv.lo > rl.lo | rv.lo | rl.lo),
                       (rv.hi < rh.hi | rv.hi | rh.hi))
                     | VraRange(1, rl.lo, rh.hi)
               | vra_top!
         --| <+ res +>
   <-->

vra_rf_default_range: ast::RecordFieldType => VraRange
vra_rf_default_range = rf =>
   !rf.has_default | --| vra_const(0)
   rf.default_expr
      [Int dv] vra_const(dv)
      [Unary u]
         u.0 [Neg]
            |
               u.1
                  [Int dv] vra_const(-dv)
                  | vra_top!
            | vra_top!
      | vra_top!

vra_zero_ti_fields_d: Cg, ast::TypeInfo, Int => ()
vra_zero_ti_fields_d = cg, ti, depth =>
   depth < 6 && !ti_is_packed_or_bf(cg, ti)
      |
         flds = vra_ti_field_types(cg, ti)
         flds @ rf, i =>
            fti = vra_rf_ti(rf)
            fvt = vt_from_ti_cg(cg, fti)
            vra_is_tracked_int_vt(fvt)
               | vra_record_shape_field(cg, ti, i, vra_rf_default_range(rf))
               | vra_ti_is_record_like(cg, fti)
                  | vra_zero_ti_fields_d(cg, fti, depth + 1)

vra_walk_expr = cg, te, rec_eff, fn_names =>
   !vra.enabled | --| vra_top!
   te_vt = vt_from_ti_cg(cg, te.ti)
   te.kind
      [LitInt v]
         res_lit = vra_is_tracked_int_vt(te_vt) | vra_const(v) | vra_top!
         res_lit
      [Var v]
         res_var = vra_is_tracked_int_vt(te_vt) && !v.2
            | vra_lookup_local_var(cg, v.0)
            | vra_top!
         res_var
      [Unary u]
         ur = vra_walk_expr(cg, u.1, rec_eff, fn_names)
         u.0
            [Neg]
               res_neg = vra_is_tracked_int_vt(te_vt) | vra_neg(ur) | vra_top!
               res_neg
            [Length] VraRange(1, 0, const::max_i64)
            [RuneCount] VraRange(1, 0, const::max_i64)
            | vra_top!
      [Bin b]
         b.0 [Seq]
            |
               vra_walk_expr(cg, b.1, rec_eff, fn_names)
               --| vra_walk_expr(cg, b.2, rec_eff, fn_names)
         lr = vra_walk_expr(cg, b.1, rec_eff, fn_names)
         rr = vra_walk_expr(cg, b.2, rec_eff, fn_names)
         !vra_is_tracked_int_vt(te_vt)
            | vra_top!
            | b.0
               [Add] vra_add(lr, rr)
               [Sub] vra_sub(lr, rr)
               [Mul]
                  res_mul = vra_same_pure_expr(b.1, b.2)
                     | vra_square(lr)
                     | vra_mul(lr, rr)
                  res_mul
               [Div] vra_div(lr, rr)
               [Mod] vra_mod(lr, rr)
               [BitAnd] vra_bitand(lr, rr)
               [Shr] vra_shr(lr, rr)
               | vra_top!
      [Copy cp]
         cpr = vra_walk_expr(cg, cp, rec_eff, fn_names)
         !vra_is_tracked_int_vt(te_vt)
            | vra_top!
            |
               svt = vt_from_ti_cg(cg, cp.ti)
               svt
                  [Int, I64] cpr
                  [Flag] VraRange(1, 0, 1)
                  [U8] VraRange(1, 0, 255)
                  [U16] VraRange(1, 0, 65535)
                  [U32] VraRange(1, 0, 4294967295)
                  [I8] VraRange(1, -128, 127)
                  [I16] VraRange(1, -32768, 32767)
                  [I32] VraRange(1, -2147483648, 2147483647)
                  | vra_top!
      [Assign a]
         vra_walk_expr(cg, a.5, rec_eff, fn_names)
      [Block bk]
         saved_binding = vra_enter_binding(tast::block_binding_name(bk))
         saved_locs = ?vra.locals
         saved_lvs = ?vra.len_vars
         last_r' = vra_top!
         bk @ st =>
            st.kind
               [Assign a]
                  vr = vra_walk_expr(cg, a.5, rec_eff, fn_names)
                  last_r' = vr
                  !a.1 && !a.2 && !a.3 && !has_str(vra.cur_muts, a.0) &&
                    !is_marked_global_name(cg, a.0)
                       |
                          avt = vt_from_ti_cg(cg, a.5.ti)
                          vra_is_tracked_int_vt(avt) && vr.state != 2
                             | vra.locals += VraLocal(a.0, vr)
                          sv = vra_str_bound_var(cg, a.5)
                          sv != "" | vra.len_vars += LenVarEntry(a.0, sv)
               |
                  sr = vra_walk_expr(cg, st, rec_eff, fn_names)
                  last_r' = sr
                  st.kind
                     [Choice ch]
                        ?ch.1 == 1
                           |
                              b0 = ch.1(0)!!
                              b0.kind [Bare] && vra_expr_always_exits(b0.body)
                                 | vra_narrow_cond(cg, ch.0, <->, fn_names)
                           |
                              ?ch.1 == 2
                                 |
                                    b0 = ch.1(0)!!
                                    b1 = ch.1(1)!!
                                    b0.kind [Bare] && b1.kind [Bare]
                                       |
                                          ex0 = vra_expr_always_exits(b0.body)
                                          ex1 = vra_expr_always_exits(b1.body)
                                          ex0 && !ex1
                                             | vra_narrow_cond(cg, ch.0, <->, fn_names)
                                          ex1 && !ex0
                                             | vra_narrow_cond(cg, ch.0, <+>, fn_names)
         vra_truncate_locals(saved_locs)
         vra_truncate_len_vars(saved_lvs)
         saved_binding | scope => vra_leave_scope(scope)
         last_r'
      [Record rfields]
         track_rf = rec_eff && vra.whole_prog && ?rfields !> 32
         rfields @ tf, i =>
            fr = vra_walk_expr(cg, tf.val, rec_eff, fn_names)
            track_rf && vra_is_tracked_int_vt(vt_from_ti_cg(cg, tf.val.ti))
               | vra_record_shape_field(cg, te.ti, i, fr)
         vra_top!
      [Member m]
         vra_walk_expr(cg, m.0, rec_eff, fn_names)
         fidx = vra_resolve_field_idx(cg, m.0.ti, m.1, m.2)
         res_mem = vra.whole_prog && vra_is_tracked_int_vt(te_vt) && fidx !< 0
            | vra_lookup_field(cg, m.0.ti, fidx, !rec_eff)
            | vra_top!
         res_mem
      [MemberWrite mw]
         vra_walk_expr(cg, mw.0, rec_eff, fn_names)
         vr = vra_walk_expr(cg, mw.3, rec_eff, fn_names)
         fidx = vra_resolve_field_idx(cg, mw.0.ti, mw.1, mw.2)
         rec_eff && vra.whole_prog && fidx !< 0 &&
           vra_is_tracked_int_vt(vt_from_ti_cg(cg, mw.3.ti))
              | vra_record_shape_field(cg, mw.0.ti, fidx, vr)
         vra_top!
      [Index ix]
         vra_walk_expr(cg, ix.0, rec_eff, fn_names)
         vra_walk_expr(cg, ix.1, rec_eff, fn_names)
         res_ix = is_str_vt(vt_from_ti_cg(cg, ix.0.ti)) && vra_is_tracked_int_vt(te_vt)
            | VraRange(1, 0, 255)
            | vra_top!
         res_ix
      [IndexWrite iw]
         vra_walk_expr(cg, iw.0, rec_eff, fn_names)
         idx_r = vra_walk_expr(cg, iw.1, rec_eff, fn_names)
         vr = vra_walk_expr(cg, iw.2, rec_eff, fn_names)
         rec_eff && vra.whole_prog && vra_ti_is_record_like(cg, iw.0.ti) &&
           vra_is_tracked_int_vt(vt_from_ti_cg(cg, iw.2.ti))
              |
                 flds = vra_ti_field_types(cg, iw.0.ti)
                 ?flds !> 32
                    |
                       idx_r.state == 1 && idx_r.lo == idx_r.hi &&
                         idx_r.lo !< 0 && idx_r.lo < ?flds
                            | vra_record_shape_field(cg, iw.0.ti, idx_r.lo, vr)
                            | ?flds @ k =>
                               vra_record_shape_field(cg, iw.0.ti, k, vr)
         vra_top!
      [KeyAccess ka]
         vra_walk_expr(cg, ka.0, rec_eff, fn_names)
         vra_walk_expr(cg, ka.1, rec_eff, fn_names)
         vra_top!
      [Choice ch]
         vra_walk_expr(cg, ch.0, rec_eff, fn_names)
         nb = ?ch.1
         is_two_bare = nb == 2 && (ch.1(0)!!.kind [Bare]) && (ch.1(1)!!.kind [Bare])
         is_one_bare = nb == 1 && (ch.1(0)!!.kind [Bare])
         c_var = vra_imm_var(cg, ch.0, <+>)
         res_r' = vra_bot!
         any_non_exit' = <->
         has_bare' = <->
         nb @ i =>
            br = ch.1(i)!!
            br.kind [Bare] | has_bare' = <+>
            saved_br_locs = ?vra.locals
            is_two_bare
               | vra_narrow_cond(cg, ch.0, i == 0, fn_names)
               | is_one_bare
                  | vra_narrow_cond(cg, ch.0, <+>, fn_names)
                  | br.kind [Case] && c_var != "" && ?br.case_values > 0
                     |
                        case_r' = vra_bot!
                        br.case_values @ el_ =>
                           cvr = vra_walk_expr(cg, el_,
                             rec_eff, fn_names)
                           case_r' = vra_join(case_r', cvr)
                        vra_narrow_local_var(cg, c_var, case_r')
            br.kind ![Case]
               | ?br.case_values @ ci =>
                  vra_walk_expr(cg, br.case_values(ci)!!, rec_eff, fn_names)
            br_r = vra_walk_expr(cg, br.body, rec_eff, fn_names)
            vra_truncate_locals(saved_br_locs)
            !vra_expr_always_exits(br.body)
               |
                  any_non_exit' = <+>
                  res_r' = vra_join(res_r', br_r)
         !vra_is_tracked_int_vt(te_vt)
            | vra_top!
            | !any_non_exit'
               | vra_bot!
               | (has_bare' || nb == 2) | res_r' | vra_top!
      [Cycle cy]
         lam_params = cy.1.kind [Lambda lam] lam.0 | ast::Names()
         saved_ranges = vra_enter_cycle(lam_params)
         (cy.0.ti [Map, Ram])
            | _ignored = vra_walk_expr(cg, cy.0, rec_eff, fn_names)
            | vra_push_cycle_bounds_in(cg, cy.0, cy.3, lam_params, rec_eff, fn_names)
         cy.1.kind
            [Lambda lam]
               vra_walk_expr(cg, lam.1, rec_eff, fn_names)
            | vra_walk_expr(cg, cy.1, rec_eff, fn_names)
         vra_leave_scope(saved_ranges)
         cy.2
            | esc =>
               esc_ranges = vra_enter_cycle(lam_params)
               vra_walk_expr(cg, esc, rec_eff, fn_names)
               vra_leave_scope(esc_ranges)
         vra_top!
      [Lambda lam]
         saved_locs = vra.locals
         saved_muts = vra.cur_muts
         saved_bnds = vra.bounded_idxs
         saved_lvs = vra.len_vars
         saved_fn = vra.cur_fn_name
         vra.locals = VraLocals()
         vra.bounded_idxs = BoundedStrIdxs()
         vra.len_vars = LenVarEntries()
         vra.cur_muts = vra_collect_mut_vars(lam.0, lam.1)
         vra.cur_fn_name = ""
         vra_walk_expr(cg, lam.1, rec_eff, fn_names)
         vra.cur_fn_name = saved_fn
         vra.cur_muts = saved_muts
         vra.locals = saved_locs
         vra.bounded_idxs = saved_bnds
         vra.len_vars = saved_lvs
         vra_top!
      [Call c]
         c.1 | ct => vra_walk_expr(cg, ct, rec_eff, fn_names)
         c.0 == "#type_zero"
            |
               c.2 @ el_ => vra_walk_expr(cg, el_, rec_eff, fn_names)
               rec_eff && vra.whole_prog
                  | vra_zero_ti_fields_d(cg, te.ti, 0)
               zero_res = vra_is_tracked_int_vt(te_vt) | vra_const(0) | vra_top!
               --| zero_res
         ic_opt = vra_eval_intrinsic_call(cg, c.0, c.2, rec_eff, fn_names)
         ic_opt
            | ic_r =>
               ic_res = vra_is_tracked_int_vt(te_vt) | ic_r | vra_top!
               --| ic_res
         callee = vra.whole_prog && ?fn_names > 0
            | vra_resolve_callee_in(cg, c.0, fn_names)
            | ""
         is_known_fn = callee != "" && !has_str(vra.poison_fns, callee)
         ?c.2 @ ai =>
            arg_te = c.2(ai)!!
            ar = vra_walk_expr(cg, arg_te, rec_eff, fn_names)
            rec_eff && is_known_fn && vra_is_tracked_int_vt(vt_from_ti_cg(cg, arg_te.ti))
               | vra_join_slot(vra.param_idx, vra.param_rngs,
                 "${callee}::${str::from_int(ai)}", ar)
         is_known_fn && vra_is_tracked_int_vt(te_vt)
            | vra_lookup_fn_ret(callee, !rec_eff)
            | vra_top!
      [BuilderNew bn]
         vra_walk_expr(cg, bn, rec_eff, fn_names)
         vra_top!
      [RawMemory rm]
         vra_walk_expr(cg, rm.0, rec_eff, fn_names)
         vra_top!
      [RawMemoryWrite rmw]
         vra_walk_expr(cg, rmw.0, rec_eff, fn_names)
         vra_walk_expr(cg, rmw.1, rec_eff, fn_names)
         vra_top!
      [MapLiteral ml]
         ml @ pr =>
            vra_walk_expr(cg, pr.key, rec_eff, fn_names)
            vra_walk_expr(cg, pr.val, rec_eff, fn_names)
         vra_top!
      [RamConstruct rc]
         rc.2 | p => vra_walk_expr(cg, p, rec_eff, fn_names)
         vra_top!
      [EnumConstruct ec]
         ec.1 | p => vra_walk_expr(cg, p, rec_eff, fn_names)
         vra_top!
      [Exit ex]
         vra_walk_expr(cg, ex, rec_eff, fn_names)
         vra_bot!
      [Return r_opt]
         r_opt
            | rv =>
               rr = vra_walk_expr(cg, rv, rec_eff, fn_names)
               rec_eff && vra.whole_prog && vra.cur_fn_name != "" &&
                 !has_str(vra.poison_fns, vra.cur_fn_name) &&
                 vra_is_tracked_int_vt(vt_from_ti_cg(cg, rv.ti))
                    | vra_join_slot(vra.fn_ret_idx, vra.fn_ret_rngs,
                      vra.cur_fn_name, rr)
         vra_bot!
      | vra_top!

vra_eval: Cg, tast::TypedExpr => VraRange
vra_eval = cg, te => vra_walk_expr(cg, te, <->, ast::Names())

vra_has_bounded_str_idx: String, String => <>
vra_has_bounded_str_idx = idx_name, str_name =>
   n = ?vra.bounded_idxs
   n @ rev_i =>
      i = n - 1 - rev_i
      entry = vra.bounded_idxs(i)!!
      entry.idx_var == idx_name
         | --| (entry.str_var == str_name && entry.str_var != "")
   <->

vra_is_bounded_str_access: Cg, tast::TypedExpr, tast::TypedExpr => <>
vra_is_bounded_str_access = cg, target, index =>
   !vra.enabled | --| <->
   !is_str_vt(vt_from_ti_cg(cg, target.ti)) | --| <->
   target.kind
      [LitStr lit]
         ir = vra_eval(cg, index)
         (ir.state == 1 && ir.lo !< 0 && ir.hi < ?lit)
      [Var sv]
         sv.2 || has_str(vra.cur_muts, sv.0) || is_marked_global_name(cg, sv.0)
            | <->
            |
               idx_name0 = vra_imm_var(cg, index, <+>)
               idx_name = idx_name0 == ""
                  |
                     res_bn = index.kind
                        [Bin b]
                           res_add = b.0 [Add]
                              |
                                 d = b.2.kind [LitInt dv] dv | -1
                                 d == 0 | vra_imm_var(cg, b.1, <+>) | ""
                              | ""
                           res_add
                        | ""
                     res_bn
                  | idx_name0
               idx_name == "" | <-> | vra_has_bounded_str_idx(idx_name, sv.0)
      | <->

vra_register_named_shapes: Cg => ()
vra_register_named_shapes = cg =>
   cg.typedefs @ td =>
      ti_is_packed_or_bf(cg, td.ti)
         | vra_add_poison_shape(td.name)
         | vra_ti_is_record_like(cg, td.ti) && !has_str(vra.named_shape_keys, td.name)
            |
               flds = vra_ti_field_types(cg, td.ti)
               ?flds !> 32
                  |
                     asig = vra_rec_anon_sig(cg, td.ti)
                     fnames = ast::Names()
                     flds @ el_ => fnames += el_.name
                     vra.named_shape_keys += td.name
                     vra.named_shapes += NamedShapeMeta(td.name, asig, fnames)

vra_poison_ast_expr: Cg, ast::Expr, ast::Names => ()

vra_poison_ast_list: Cg, ast::Exprs, ast::Names => ()
vra_poison_ast_list = cg, exprs, fn_names =>
   exprs @ el_ => vra_poison_ast_expr(cg, el_, fn_names)

vra_poison_ast_expr = cg, e, fn_names =>
   e
      [Var v]
         fn = vra_resolve_callee_in(cg, v, fn_names)
         fn != "" | vra_add_poison_fn(fn)
      [Bin b]
         vra_poison_ast_expr(cg, b.1, fn_names)
         vra_poison_ast_expr(cg, b.2, fn_names)
      [Unary u] vra_poison_ast_expr(cg, u.1, fn_names)
      [Block bk] vra_poison_ast_list(cg, bk, fn_names)
      [Assign a]
         vra_poison_ast_expr(cg, a.5, fn_names)
         vra_poison_ast_expr(cg, a.6, fn_names)
      [Call c]
         fn = vra_resolve_callee_in(cg, c.fn_name, fn_names)
         !(fn != "" && c.fn_name != "")
            | vra_poison_ast_expr(cg, c.fn_target, fn_names)
         vra_poison_ast_list(cg, c.args, fn_names)
      [Record r]
         r.fields @ el_ => vra_poison_ast_expr(cg, el_.val, fn_names)
      [Member m]
         vra_poison_ast_expr(cg, m.target, fn_names)
         vra_poison_ast_expr(cg, m.index_expr, fn_names)
         !m.is_module_access
            |
               vra.named_shape_keys @ el_ =>
                  vra_add_poison_shape(el_)
      [Choice ch]
         vra_poison_ast_expr(cg, ch.cond, fn_names)
         ch.branches @ el_ => vra_poison_ast_expr(cg, el_.block, fn_names)
      [Cycle cy]
         vra_poison_ast_expr(cg, cy.iterable, fn_names)
         vra_poison_ast_expr(cg, cy.body_fn, fn_names)
      [CycleEscape ce]
         vra_poison_ast_expr(cg, ce.cycle, fn_names)
         vra_poison_ast_expr(cg, ce.branch, fn_names)
      [Fn f] vra_poison_ast_expr(cg, f.body, fn_names)
      [TypeCast tc] vra_poison_ast_expr(cg, tc.expr, fn_names)
      [Copy cp] vra_poison_ast_expr(cg, cp, fn_names)
      [RawMemory rm] vra_poison_ast_expr(cg, rm.addr, fn_names)
      [Spawn sp] vra_poison_ast_list(cg, sp.args, fn_names)
      [Join j] vra_poison_ast_expr(cg, j, fn_names)
      [Exit ex] vra_poison_ast_expr(cg, ex, fn_names)

vra_poison_scan_expr: Cg, tast::TypedExpr, ast::Names, <> => ()

vra_poison_scan_list: Cg, tast::TypedExprs, ast::Names => ()
vra_poison_scan_list = cg, exprs, fn_names =>
   exprs @ el_ => vra_poison_scan_expr(cg, el_, fn_names, <->)

vra_poison_scan_expr = cg, te, fn_names, is_top_fn =>
   ti_is_packed_or_bf(cg, te.ti) | vra_poison_ti_shapes(cg, te.ti)
   te.kind
      [Var v]
         vt_from_ti_cg(cg, te.ti) [Fn]
            |
               callee = vra_resolve_callee_in(cg, v.0, fn_names)
               callee != "" | vra_add_poison_fn(callee)
      [Unary u]
         u.0 [AddrOf] | vra_poison_ti_shapes(cg, u.1.ti)
         vra_ti_is_record_like(cg, te.ti) | vra_poison_ti_shapes(cg, te.ti)
         vra_poison_scan_expr(cg, u.1, fn_names, <->)
      [Bin b]
         b.0 ![Seq] && vra_ti_is_record_like(cg, te.ti)
            | vra_poison_ti_shapes(cg, te.ti)
         vra_poison_scan_expr(cg, b.1, fn_names, <->)
         vra_poison_scan_expr(cg, b.2, fn_names, <->)
      [Call c]
         is_unsafe_op = c.0 == "%bitcast" || c.0 == "%memcpy" ||
           c.0 == "%memset" || c.0 == "%memmove" ||
           c.0 == "%alloc" || c.0 == "%realloc"
         has_raw_arg' = <->
         c.2 @ ate =>
            vt_from_ti_cg(cg, ate.ti) [RawPtr, Type] | has_raw_arg' = <+>
            ate.kind
               [Var av] (is_user_type(cg, av.0) | has_raw_arg' = <+>)
            vra_poison_scan_expr(cg, ate, fn_names, <->)
         c.1 | ct => vra_poison_scan_expr(cg, ct, fn_names, <->)
         callee = vra_resolve_callee_in(cg, c.0, fn_names)
         is_foreign = stmt::is_foreign_fn(c.0) || stmt::is_foreign_fn(callee)
         is_intrinsic_call = ?c.0 > 0 && (c.0(0) == '% || c.0(0) == '#)
         is_indirect = c.0 == "" || (callee == "" && !is_foreign && !is_intrinsic_call)
         is_poison_callee = callee != "" && has_str(vra.poison_fns, callee)
         is_intrinsic_call && c.0 != "#type_zero" && vra_ti_is_record_like(cg, te.ti)
            | vra_poison_ti_shapes(cg, te.ti)
         is_unsafe_op || is_foreign || is_indirect || is_poison_callee || has_raw_arg'
            |
               vra_poison_ti_shapes(cg, te.ti)
               c.2 @ ate =>
                  vra_poison_ti_shapes(cg, ate.ti)
                  ate.kind
                     [Var av]
                        is_user_type(cg, av.0)
                           | vra_poison_ti_shapes(cg, typedef_ti(cg, av.0))
               callee != "" | vra_add_poison_fn(callee)
      [Record rfields]
         rfields @ el_ => vra_poison_scan_expr(cg, el_.val, fn_names, <->)
      [Member m]
         vra_resolve_field_idx(cg, m.0.ti, m.1, m.2) < 0 &&
           vra_ti_is_record_like(cg, te.ti)
              | vra_poison_ti_shapes(cg, te.ti)
         vra_poison_scan_expr(cg, m.0, fn_names, <->)
      [MemberWrite mw]
         vra_poison_scan_expr(cg, mw.0, fn_names, <->)
         vra_poison_scan_expr(cg, mw.3, fn_names, <->)
      [Index ix]
         vra_poison_scan_expr(cg, ix.0, fn_names, <->)
         vra_poison_scan_expr(cg, ix.1, fn_names, <->)
      [IndexWrite iw]
         vra_poison_scan_expr(cg, iw.0, fn_names, <->)
         vra_poison_scan_expr(cg, iw.1, fn_names, <->)
         vra_poison_scan_expr(cg, iw.2, fn_names, <->)
      [KeyAccess ka]
         vra_poison_scan_expr(cg, ka.0, fn_names, <->)
         vra_poison_scan_expr(cg, ka.1, fn_names, <->)
      [Block bk] vra_poison_scan_list(cg, bk, fn_names)
      [Assign a] vra_poison_scan_expr(cg, a.5, fn_names, <->)
      [Choice ch]
         vra_poison_scan_expr(cg, ch.0, fn_names, <->)
         ch.1 @ br =>
            vra_poison_scan_list(cg, br.case_values, fn_names)
            vra_poison_scan_expr(cg, br.body, fn_names, <->)
      [Cycle cy]
         vra_poison_scan_expr(cg, cy.0, fn_names, <->)
         cy.1.kind
            [Lambda lam]
               vra_poison_scan_expr(cg, lam.1, fn_names, <->)
            | vra_poison_scan_expr(cg, cy.1, fn_names, <->)
         cy.2 | esc => vra_poison_scan_expr(cg, esc, fn_names, <->)
      [Lambda lam]
         !is_top_fn | vra_poison_ti_shapes(cg, te.ti)
         vra_poison_scan_expr(cg, lam.1, fn_names, <->)
      [Copy cp] vra_poison_scan_expr(cg, cp, fn_names, <->)
      [BuilderNew bn] vra_poison_scan_expr(cg, bn, fn_names, <->)
      [RawMemory rm]
         vra_poison_ti_shapes(cg, te.ti)
         vra_poison_scan_expr(cg, rm.0, fn_names, <->)
      [RawMemoryWrite rmw]
         vra_poison_ti_shapes(cg, rmw.1.ti)
         vra_poison_scan_expr(cg, rmw.0, fn_names, <->)
         vra_poison_scan_expr(cg, rmw.1, fn_names, <->)
      [MapLiteral ml]
         ml @ pr =>
            vra_poison_scan_expr(cg, pr.key, fn_names, <->)
            vra_poison_scan_expr(cg, pr.val, fn_names, <->)
      [RamConstruct rc]
         rc.2 | p => vra_poison_scan_expr(cg, p, fn_names, <->)
      [EnumConstruct ec]
         ec.1 | p => vra_poison_scan_expr(cg, p, fn_names, <->)
      [Spawn sp]
         fn = vra_resolve_callee_in(cg, sp.fn_name, fn_names)
         fn != "" | vra_add_poison_fn(fn)
         vra_poison_ti_shapes(cg, te.ti)
         vra_poison_ast_list(cg, sp.args, fn_names)
      [Join j]
         vra_poison_ti_shapes(cg, te.ti)
         vra_poison_ast_expr(cg, j, fn_names)
      [CompileTime ct] vra_poison_ast_expr(cg, ct, fn_names)
      [CtUnrollCycle c]
         vra.changed = <+>
         vra_poison_ast_expr(cg, c.iterable, fn_names)
         vra_poison_ast_expr(cg, c.body_fn, fn_names)
      [Exit ex] vra_poison_scan_expr(cg, ex, fn_names, <->)
      [Return r_opt]
         r_opt | rv => vra_poison_scan_expr(cg, rv, fn_names, <->)

vra_poison_fn_sig_shapes: Cg, ast::TypeInfo => ()
vra_poison_fn_sig_shapes = cg, fn_ti =>
   fn_ti
      [Fn f]
         f.1 @ el_ => vra_poison_ti_shapes(cg, el_)
         vra_poison_ti_shapes(cg, f.3)

vra_seed_top_fn_params: Cg, String, ast::Names, ast::TypeInfo => <>
vra_seed_top_fn_params = cg, fn_name, params, fn_ti =>
   has_str(vra.poison_fns, fn_name)
      | --| <+>
   p_tis = fn_ti [Fn f] f.1 | ast::VInfos()
   missing_bot' = <->
   ?params @ i =>
      pname = params(i)!!
      pti = i < ?p_tis | p_tis(i)!! | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      pvt = vt_from_ti_cg(cg, pti)
      vra_is_tracked_int_vt(pvt) && !has_str(vra.cur_muts, pname)
         |
            key = "${fn_name}::${str::from_int(i)}"
            pr = vra_read_slot(vra.param_idx, vra.param_rngs, vra.snap_param_rngs, key)
            pr.state == 0
               | missing_bot' = <+>
               | pr.state == 1
                  | vra.locals += VraLocal(pname, pr)
   !(vra.skip_bot_params && missing_bot')

vra_clone_rngs: VraRanges => VraRanges
vra_clone_rngs = rngs =>
   out = VraRanges()
   rngs @ el_ => out += el_
   out

vra_save_snapshots: () => ()
vra_save_snapshots = !=>
   vra.snap_field_rngs = vra_clone_rngs(vra.field_rngs)
   vra.snap_anon_rngs = vra_clone_rngs(vra.anon_rngs)
   vra.snap_param_rngs = vra_clone_rngs(vra.param_rngs)
   vra.snap_fn_ret_rngs = vra_clone_rngs(vra.fn_ret_rngs)

vra_widen_table_for_narrow: VraRanges, VraRanges => VraRanges
vra_widen_table_for_narrow = live_rngs, prev_rngs =>
   out = VraRanges()
   ?live_rngs @ i =>
      cur = live_rngs(i)!!
      prev = i < ?prev_rngs | prev_rngs(i)!! | vra_bot!
      prev.state != 0 && !vra_eq(cur, prev)
         |
            out += vra_top!
            live_rngs(i) = vra_bot! !| _
         | out += cur
   out

vra_prepare_widen_narrow: () => ()
vra_prepare_widen_narrow = !=>
   vra.snap_field_rngs = vra_widen_table_for_narrow(vra.field_rngs, vra.snap_field_rngs)
   vra.snap_anon_rngs = vra_widen_table_for_narrow(vra.anon_rngs, vra.snap_anon_rngs)
   vra.snap_param_rngs = vra_widen_table_for_narrow(vra.param_rngs, vra.snap_param_rngs)
   vra.snap_fn_ret_rngs = vra_widen_table_for_narrow(vra.fn_ret_rngs, vra.snap_fn_ret_rngs)

vra_restore_bot_from_snap: VraRanges, VraRanges => ()
vra_restore_bot_from_snap = live_rngs, snap_rngs =>
   ?live_rngs @ i =>
      live_rngs(i)!!.state == 0 && i < ?snap_rngs && snap_rngs(i)!!.state == 2
         | live_rngs(i) = vra_top! !| _

vra_widen_unconverged_table: VraRanges, VraRanges => <>
vra_widen_unconverged_table = live_rngs, snap_rngs =>
   any' = <->
   ?live_rngs @ i =>
      cur = live_rngs(i)!!
      prev = i < ?snap_rngs | snap_rngs(i)!! | vra_bot!
      !vra_eq(cur, prev) && cur.state != 2
         |
            live_rngs(i) = vra_top! !| _
            any' = <+>
   any'

vra_widen_unconverged_slots: () => <>
vra_widen_unconverged_slots = !=>
   c0 = vra_widen_unconverged_table(vra.field_rngs, vra.snap_field_rngs)
   c1 = vra_widen_unconverged_table(vra.anon_rngs, vra.snap_anon_rngs)
   c2 = vra_widen_unconverged_table(vra.param_rngs, vra.snap_param_rngs)
   c3 = vra_widen_unconverged_table(vra.fn_ret_rngs, vra.snap_fn_ret_rngs)
   c0 || c1 || c2 || c3

vra_run_one_pass: Cg, tast::TypedExprs, ast::Names, ast::Names,
  tast::TypedExprs, ast::VInfos => ()
vra_run_one_pass = cg, top_stmts, top_mods, fn_names, fn_lams, fn_tis =>
   vra.changed = <->
   ?top_stmts @ i =>
      cg.current_module = top_mods(i)!!
      vra.cur_fn_name = ""
      vra.locals = VraLocals()
      vra.bounded_idxs = BoundedStrIdxs()
      vra.len_vars = LenVarEntries()
      te = top_stmts(i)!!
      vra.cur_muts = vra_collect_mut_vars(ast::Names(), te)
      vra_walk_expr(cg, te, <+>, fn_names)
   ?fn_names @ fi =>
      fname = fn_names(fi)!!
      cg.current_module = decl_module(fname, 0)
      vra.cur_fn_name = fname
      vra.locals = VraLocals()
      vra.bounded_idxs = BoundedStrIdxs()
      vra.len_vars = LenVarEntries()
      lam = fn_lams(fi)!!.kind [Lambda l] l |
         (ast::Names(), tast::mk_lit_unit(0, 0), tast::TypedCaptures())
      fn_ti = fn_tis(fi)!!
      vra.cur_muts = vra_collect_mut_vars(lam.0, lam.1)
      run_body = vra_seed_top_fn_params(cg, fname, lam.0, fn_ti)
      run_body
         |
            body_r = vra_walk_expr(cg, lam.1, <+>, fn_names)
            ret_ti = fn_ti [Fn f] f.3 |
               ast::TypeInfo(Prim, ast::ValueType(Unknown))
            !has_str(vra.poison_fns, fname) &&
              vra_is_tracked_int_vt(vt_from_ti_cg(cg, ret_ti)) &&
              !vra_expr_always_exits(lam.1)
                 | vra_join_slot(vra.fn_ret_idx, vra.fn_ret_rngs, fname, body_r)
   vra_finalize_anon_merges!

vra_widen_unvisited_bot_params: Cg, ast::Names, tast::TypedExprs, ast::VInfos => <>
vra_widen_unvisited_bot_params = cg, fn_names, fn_lams, fn_tis =>
   widened' = <->
   ?fn_names @ fi =>
      fname = fn_names(fi)!!
      !has_str(vra.poison_fns, fname)
         |
            lam = fn_lams(fi)!!.kind [Lambda l] l |
               (ast::Names(), tast::mk_lit_unit(0, 0), tast::TypedCaptures())
            fn_ti = fn_tis(fi)!!
            p_tis = fn_ti [Fn f] f.1 | ast::VInfos()
            ?lam.0 @ pi =>
               pti = pi < ?p_tis | p_tis(pi)!! |
                  ast::TypeInfo(Prim, ast::ValueType(Unknown))
               vra_is_tracked_int_vt(vt_from_ti_cg(cg, pti))
                  |
                     key = "${fname}::${str::from_int(pi)}"
                     !(vra.param_idx ^? key)
                        |
                           vra_join_slot(vra.param_idx, vra.param_rngs, key, vra_top!)
                           widened' = <+>
                        |
                           pos = vra.param_idx ^ key | _ | -1
                           pos !< 0 && (vra.param_rngs(pos)!!.state == 0)
                              |
                                 vra_join_slot(vra.param_idx, vra.param_rngs, key, vra_top!)
                                 widened' = <+>
   widened'

run_typed_vra: Cg, tast::TypedStmts => ()
run_typed_vra = cg, prog =>
   vra_reset!
   vra.enabled = !cg.opts.fuzz_cov
   vra.whole_prog = !cg.opts.is_module
   vra.enabled && vra.whole_prog
      |
         saved_mod = cg.current_module
         vra_register_named_shapes(cg)
         fn_names = ast::Names()
         fn_lams = tast::TypedExprs()
         fn_tis = ast::VInfos()
         top_stmts = tast::TypedExprs()
         top_mods = ast::Names()
         prog @ st =>
            st
               [Expr te]
                  te.kind
                     [Assign a]
                        a.5.kind [Lambda]
                           |
                              fn_ti = a.5.ti [Fn] a.5.ti | te.ti
                              fn_names += a.0
                              fn_lams += a.5
                              fn_tis += fn_ti
                           |
                              top_stmts += te
                              top_mods += decl_module(a.0, 0)
                     |
                        top_stmts += te
                        top_mods += ""
               [Binding b]
                  b.2.kind [Lambda]
                     |
                        fn_ti = b.1 [Fn] b.1 | b.2.ti
                        fn_names += b.0
                        fn_lams += b.2
                        fn_tis += fn_ti
                     |
                        top_stmts += b.2
                        top_mods += decl_module(b.0, 0)
               [GlobalBinding gb]
                  gb.2.kind [Lambda]
                     |
                        fn_ti = gb.1 [Fn] gb.1 | gb.2.ti
                        fn_names += gb.0
                        fn_lams += gb.2
                        fn_tis += fn_ti
                     |
                        top_stmts += gb.2
                        top_mods += decl_module(gb.0, 0)
         // Pass 0: poison exported / foreign / unsafe functions and record shapes.
         (?g.pexports > 0)
            |
               ?fn_names @ fi =>
                  fname = fn_names(fi)!!
                  <>(stmt::find_export_symbol(g.pexports, fname))
                     |
                        vra_add_poison_fn(fname)
                        vra_poison_fn_sig_shapes(cg, fn_tis(fi)!!)
         g.foreign_fn_names @ el_ => vra_add_poison_fn(el_)
         ?fn_names @ fi =>
            fn_tis(fi)!!
               [Fn f] (?f.4 > 0 | vra_add_poison_fn(fn_names(fi)!!))
         g.pstmts @ pe =>
            pe
               [Foreign fd]
                  vra_add_poison_fn(fd.dva_name)
                  vra_add_poison_fn(fd.c_name)
                  fd.params @ el_ => vra_poison_ti_shapes(cg, el_.record_info)
                  vra_poison_ti_shapes(cg, fd.ret_record_info)
               [Assign t]
                  has_cp = (t.8 [Fn f] (?f.4 > 0) | <->) ||
                    (t.5 [Fn fe] (?fe.ct_params > 0) | <->)
                  has_cp | vra_add_poison_fn(t.0)
         ?top_stmts @ i =>
            cg.current_module = top_mods(i)!!
            vra_poison_scan_expr(cg, top_stmts(i)!!, fn_names, <->)
         ?fn_names @ fi =>
            cg.current_module = decl_module(fn_names(fi)!!, 0)
            vra.changed = <->
            vra_poison_scan_expr(cg, fn_lams(fi)!!, fn_names, <+>)
            vra.changed | vra_poison_fn_sig_shapes(cg, fn_tis(fi)!!)
         vra.changed = <->
         vra_finalize_anon_merges!
         // Phase 1: 4 Gauss-Seidel passes; if still changing, widen & narrow.
         vra.skip_bot_params = <+>
         4 @ iter_i =>
            iter_i == 3 | vra_save_snapshots!
            vra_run_one_pass(cg, top_stmts, top_mods, fn_names, fn_lams, fn_tis)
            !vra.changed | -->
         vra.changed
            |
               vra_prepare_widen_narrow!
               vra.in_narrow = <+>
               vra_run_one_pass(cg, top_stmts, top_mods, fn_names, fn_lams, fn_tis)
               vra.in_narrow = <->
               vra_restore_bot_from_snap(vra.field_rngs, vra.snap_field_rngs)
               vra_restore_bot_from_snap(vra.anon_rngs, vra.snap_anon_rngs)
               vra_restore_bot_from_snap(vra.param_rngs, vra.snap_param_rngs)
               vra_restore_bot_from_snap(vra.fn_ret_rngs, vra.snap_fn_ret_rngs)
               vra_finalize_anon_merges!
         // Phase 2: Widen any still-Bottom params of unreached functions to Top.
         widened = vra_widen_unvisited_bot_params(cg, fn_names, fn_lams, fn_tis)
         widened
            |
               vra.skip_bot_params = <->
               2 @ iter_j =>
                  vra_run_one_pass(cg, top_stmts, top_mods, fn_names, fn_lams, fn_tis)
                  !vra.changed | -->
         // Phase 3: Post-fixed-point verification; widen any still-moving slot to Top.
         vra.skip_bot_params = <->
         vra.changed
            |
               3 @ iter_v =>
                  vra_save_snapshots!
                  vra_run_one_pass(cg, top_stmts, top_mods, fn_names, fn_lams, fn_tis)
                  !vra.changed | -->
                  !vra_widen_unconverged_slots! | -->
                  vra_finalize_anon_merges!
         cg.current_module = saved_mod
         vra.cur_fn_name = ""
         vra.locals = VraLocals()
         vra.bounded_idxs = BoundedStrIdxs()
         vra.len_vars = LenVarEntries()
         vra.cur_muts = ast::Names()
