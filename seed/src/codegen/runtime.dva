// codegen/runtime.dva

#use(import) llvm
#use "../ast"
#use "str"
#use "../tast"
#use "../unify"
#use "mem"
#use "types"
#use "expr"
#use "match"
#use "stmt"
#use "main"

#foreign "c"
   write: (fd: Int, buf: Addr, count: Int) => Int
   dva_arena_current: () => Addr
   rename: (oldpath: String, newpath: String) => Int
   unlink: (path: String) => Int

#type Cg types::Cg
#type CodegenOpts types::CodegenOpts
#type CgVar types::CgVar
#type CgVars types::CgVars
#type TypeDef types::TypeDef
#type TypeDefs types::TypeDefs
#type TypeIndex types::TypeIndex
#type FnInfo types::FnInfo
#type FnInfos types::FnInfos
#type FnDef types::FnDef
#type FnDefs types::FnDefs
#type FnNameIndex types::FnNameIndex
#type BindingMut types::BindingMut
#type BindingMuts types::BindingMuts
#type BindingState types::BindingState
#type ParamRec types::ParamRec
#type ParamRecs types::ParamRecs
#type FnRetRec types::FnRetRec
#type FnRetRecs types::FnRetRecs
#type Addrs types::Addrs
#type IntArr types::IntArr
#type FieldInitState types::FieldInitState
#type ChoiceInitFrame types::ChoiceInitFrame
#type ChoiceInitFrames types::ChoiceInitFrames
#type LambdaEnvInfo types::LambdaEnvInfo
#type LambdaEnvInfos types::LambdaEnvInfos
#type Flags types::Flags
#type FnValueMeta types::FnValueMeta

c_str: Addr => String
c_str = raw => types::c_str(raw)

dbg: String => Int
dbg = s => types::dbg(s)

empty_fndef: FnDef
empty_fndef = FnDef(("", ast::Names(), ast::Expr(Var, "")))

#private
print: String => Int
print = s =>
   b = {?s + 1}
   b += s
   b += 10
   write(1, &b, ?b)

// --- Module Implementation -------------------------------------------------

arena_type: types::Cg => Addr
arena_type = cg =>
   i64t = LLVMInt64Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   chunks = LLVMArrayType(i8p, 16384)
   tarr = types::Addrs()
   tarr += i64t
   tarr += i64t
   tarr += i64t
   tarr += chunks
   tarr += i64t
   types::struct_type_n(cg, tarr, 5)

// A NUL-terminated unnamed_addr constant string global.
const_string_global: types::Cg, String, String => Addr
const_string_global = cg, msg, name =>
   types::llvm_find_global(cg.module, name)
      | _
      |
         len = ?msg
         arr_t = LLVMArrayType(LLVMInt8Type!, len + 1)
         gv = LLVMAddGlobal(cg.module, arr_t, name)
         LLVMSetInitializer(gv, LLVMConstString(msg, len, 0))
         LLVMSetGlobalConstant(gv, 1)
         LLVMSetUnnamedAddr(gv, 1)
         LLVMSetLinkage(gv, 8)
         gv

// The "nounwind" function attribute (suppresses unwind tables).
mark_nounwind: types::Cg, Addr => ()
mark_nounwind = cg, fn =>
   ctx = LLVMGetGlobalContext!
   attr = LLVMCreateStringAttribute(ctx, "nounwind", 8, "", 0)
   LLVMAddAttributeAtIndex(fn, -1, attr)

// write(2, msg, len); exit(1) — a runtime abort with a fixed message.
emit_abort_msg: types::Cg, String, String => Addr
emit_abort_msg = cg, msg, gname =>
   cg.opts.no_runtime
      |
         LLVMBuildUnreachable(cg.builder)
         cur_bb = LLVMGetInsertBlock(cg.builder)
         parent = LLVMGetBasicBlockParent(cur_bb)
         dead_bb = LLVMAppendBasicBlock(parent, "no_rt.abort")
         LLVMPositionBuilderAtEnd(cg.builder, dead_bb)
         Addr(0)
      |
         gv = const_string_global(cg, msg, gname)
         mlen = ?msg
         i8t = LLVMInt8Type!
         i32t = LLVMInt32Type!
         zero = LLVMConstInt(LLVMInt64Type!, 0, 0)
         garr = LLVMTypeOf(gv)
         msg_ptr = types::gep2(cg, garr, gv, zero, zero, "fail.msg.ptr")
         wargs = {24}
         sb = &wargs
         @[sb] = LLVMConstInt(i32t, 2, 0)
         @[sb + 8] = msg_ptr
         @[sb + 16] = LLVMConstInt(LLVMInt64Type!, mlen, 0)
         LLVMBuildCall2(cg.builder, cg.write_t, cg.write_fn, sb, 3, "")
         eargs = {16}
         esb = &eargs
         @[esb] = LLVMConstInt(i32t, 1, 0)
         LLVMBuildCall2(cg.builder, cg.exit_t, cg.exit_fn, esb, 1, "")

// Emits the full runtime: the arena globals + helper functions, the message
// globals, the FNV hash, and the string-overflow intrinsic declaration.
codegen_emit_runtime_module: types::Cg => Addr
codegen_emit_runtime_module = cg =>
   i64t = LLVMInt64Type!
   i32t = LLVMInt32Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   at = arena_type(cg)
   atp = LLVMPointerType(at, 0)

   const_string_global(cg, "Error %lld: %.*s\n  at %.*s:%lld:%lld\n", "fmt_error")
   arena_tls = LLVMAddGlobal(cg.module, atp, "dva_arena_tls")
   LLVMSetThreadLocal(arena_tls, 1)
   garena = LLVMAddGlobal(cg.module, at, "global_arena")

   cur_t = types::fn_type0(LLVMPointerType(at, 0))
   LLVMAddFunction(cg.module, "dva_arena_current", cur_t)

   set_cur_params = types::Addrs()
   set_cur_params += atp
   set_cur_t = stmt::fn_type_n(cg, atp, set_cur_params, 1)
   LLVMAddFunction(cg.module, "dva_arena_set_current", set_cur_t)

   cg.malloc_t = types::fn_type1(i8p, i64t)
   cg.malloc_fn = LLVMAddFunction(cg.module, "malloc", cg.malloc_t)
   free_t = types::fn_type1(LLVMVoidType!, i8p)
   LLVMAddFunction(cg.module, "free", free_t)
   cg.write_t = types::fn_type3(LLVMInt64Type!, i32t, i8p, i64t)
   cg.write_fn = LLVMAddFunction(cg.module, "write", cg.write_t)
   cg.exit_t = types::fn_type1(LLVMVoidType!, i32t)
   cg.exit_fn = LLVMAddFunction(cg.module, "exit", cg.exit_t)

   const_string_global(cg, "E4002: string length overflow (concatenation exceeds 64-bit capacity)\n", "str_overflow_msg")
   const_string_global(cg, "E4004: arena allocation too large for a single chunk (requested %llu bytes, chunk cap %llu bytes)\n", "arena_toobig_msg")
   const_string_global(cg, "E4003: arena chunk limit reached (too many arena chunks)\n", "arena_chunklimit_msg")
   const_string_global(cg, "E4001: arena allocator exhausted (out of memory)\n", "arena_oom_msg")
   const_string_global(cg, "E4008: Builder length assignment out of bounds\n", "builder_len_oob_msg")

   ovf_struct = types::struct_type2(i64t, LLVMInt1Type!)
   ovf_params = types::Addrs()
   ovf_params += i64t
   ovf_params += i64t
   ovf_t = stmt::fn_type_n(cg, ovf_struct, ovf_params, 2)
   LLVMAddFunction(cg.module, "llvm.uadd.with.overflow.i64", ovf_t)

   init_params = types::Addrs()
   init_params += atp
   init_params += i64t
   init_t = stmt::fn_type_n(cg, LLVMVoidType!, init_params, 2)
   LLVMAddFunction(cg.module, "dva_arena_init", init_t)

   alloc_params = types::Addrs()
   alloc_params += atp
   alloc_params += i64t
   alloc_t = stmt::fn_type_n(cg, i8p, alloc_params, 2)
   LLVMAddFunction(cg.module, "dva_arena_alloc", alloc_t)

   dest_params = types::Addrs()
   dest_params += atp
   dest_t = stmt::fn_type_n(cg, LLVMVoidType!, dest_params, 1)
   LLVMAddFunction(cg.module, "dva_arena_destroy", dest_t)

   save_t = stmt::fn_type_n(cg, i64t, dest_params, 1)
   LLVMAddFunction(cg.module, "dva_arena_save", save_t)

   rest_params = types::Addrs()
   rest_params += atp
   rest_params += i64t
   rest_t = stmt::fn_type_n(cg, LLVMVoidType!, rest_params, 2)
   LLVMAddFunction(cg.module, "dva_arena_restore", rest_t)

   adopt_params = types::Addrs()
   adopt_params += atp
   adopt_params += atp
   adopt_t = stmt::fn_type_n(cg, LLVMVoidType!, adopt_params, 2)
   LLVMAddFunction(cg.module, "dva_arena_adopt", adopt_t)

   strlen_t = types::fn_type1(i64t, i8p)
   LLVMAddFunction(cg.module, "strlen", strlen_t)
   cg.memcmp_t = types::fn_type3(LLVMInt32Type!, i8p, i8p, i64t)
   cg.memcmp_fn = LLVMAddFunction(cg.module, "memcmp", cg.memcmp_t)

   hash_params = types::Addrs()
   hash_params += i8p
   hash_params += i64t
   hash_t = stmt::fn_type_n(cg, i64t, hash_params, 2)
   LLVMAddFunction(cg.module, "dva_hash_string", hash_t)
   garena

codegen_emit_runtime: types::Cg => Addr
codegen_emit_runtime = cg =>
   cg.opts.no_main
      | codegen_emit_runtime_module(cg)
      | codegen_emit_runtime_full(cg)

codegen_emit_runtime_full: types::Cg => Addr
codegen_emit_runtime_full = cg =>
   i64t = LLVMInt64Type!
   i32t = LLVMInt32Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   at = arena_type(cg)
   atp = LLVMPointerType(at, 0)
   pp = {8}
   psb = &pp
   @[psb] = i8p
   chunks_arr = LLVMArrayType(i8p, 16384)
   zero = LLVMConstInt(i64t, 0, 0)
   one = LLVMConstInt(i64t, 1, 0)
   cap_v = LLVMConstInt(i64t, 67108864, 0)
   maxc = LLVMConstInt(i64t, 16384, 0)

   const_string_global(cg, "Error %lld: %.*s\n  at %.*s:%lld:%lld\n", "fmt_error")
   arena_tls = LLVMAddGlobal(cg.module, atp, "dva_arena_tls")
   LLVMSetInitializer(arena_tls, LLVMConstNull(atp))
   LLVMSetThreadLocal(arena_tls, 1)
   garena = LLVMAddGlobal(cg.module, at, "global_arena")
   LLVMSetInitializer(garena, LLVMConstNull(at))

   // dva_arena_current()
   cur_t = types::fn_type0(LLVMPointerType(at, 0))
   cur_fn = LLVMAddFunction(cg.module, "dva_arena_current", cur_t)
   c_bb = LLVMAppendBasicBlock(cur_fn, "entry")
   tls_bb = LLVMAppendBasicBlock(cur_fn, "use_tls")
   fb_bb = LLVMAppendBasicBlock(cur_fn, "fallback")
   LLVMPositionBuilderAtEnd(cg.builder, c_bb)
   tls_v = LLVMBuildLoad2(cg.builder, atp, arena_tls, "arena.tls")
   is_n = LLVMBuildICmp(cg.builder, 32, tls_v, LLVMConstNull(atp), "arena.tls.null")
   LLVMBuildCondBr(cg.builder, is_n, fb_bb, tls_bb)
   LLVMPositionBuilderAtEnd(cg.builder, tls_bb)
   LLVMBuildRet(cg.builder, tls_v)
   LLVMPositionBuilderAtEnd(cg.builder, fb_bb)
   LLVMBuildRet(cg.builder, garena)

   // dva_arena_set_current(ptr) -> ptr
   set_cur_params = types::Addrs()
   set_cur_params += atp
   set_cur_t = stmt::fn_type_n(cg, atp, set_cur_params, 1)
   set_cur_fn = LLVMAddFunction(cg.module, "dva_arena_set_current",
      set_cur_t)
   sc_bb = LLVMAppendBasicBlock(set_cur_fn, "entry")
   LLVMPositionBuilderAtEnd(cg.builder, sc_bb)
   sc_new = LLVMGetParam(set_cur_fn, 0)
   sc_prev = types::call0(cg, cur_t, cur_fn, "prev.arena")
   LLVMBuildStore(cg.builder, sc_new, arena_tls)
   LLVMBuildRet(cg.builder, sc_prev)

   cg.malloc_t = types::fn_type1(i8p, i64t)
   cg.malloc_fn = LLVMAddFunction(cg.module, "malloc", cg.malloc_t)
   free_t = types::fn_type1(LLVMVoidType!, i8p)
   free_fn = LLVMAddFunction(cg.module, "free", free_t)
   cg.write_t = types::fn_type3(LLVMInt64Type!, i32t, i8p, i64t)
   cg.write_fn = LLVMAddFunction(cg.module, "write", cg.write_t)
   cg.exit_t = types::fn_type1(LLVMVoidType!, i32t)
   cg.exit_fn = LLVMAddFunction(cg.module, "exit", cg.exit_t)

   // message globals
   const_string_global(cg, "E4002: string length overflow (concatenation exceeds 64-bit capacity)\n", "str_overflow_msg")
   const_string_global(cg, "E4004: arena allocation too large for a " +
      "single chunk (requested %llu bytes, chunk cap %llu bytes)\n",
      "arena_toobig_msg")
   const_string_global(cg, "E4003: arena chunk limit reached (too many arena chunks)\n", "arena_chunklimit_msg")
   const_string_global(cg, "E4001: arena allocator exhausted (out of memory)\n", "arena_oom_msg")
   const_string_global(cg, "E4008: Builder length assignment out of bounds\n", "builder_len_oob_msg")

   // llvm.uadd.with.overflow.i64 declaration
   ovf_struct = types::struct_type2(i64t, LLVMInt1Type!)
   ovf_params = types::Addrs()
   ovf_params += i64t
   ovf_params += i64t
   ovf_t = stmt::fn_type_n(cg, ovf_struct, ovf_params, 2)
   LLVMAddFunction(cg.module, "llvm.uadd.with.overflow.i64", ovf_t)

   // dva_arena_init(ptr, i64)
   init_params = types::Addrs()
   init_params += atp
   init_params += i64t
   init_t = stmt::fn_type_n(cg, LLVMVoidType!, init_params, 2)
   init_fn = LLVMAddFunction(cg.module, "dva_arena_init", init_t)
   init_bb = LLVMAppendBasicBlock(init_fn, "entry")
   LLVMPositionBuilderAtEnd(cg.builder, init_bb)
   a0 = LLVMGetParam(init_fn, 0)
   cg0 = LLVMGetParam(init_fn, 1)
   LLVMBuildStore(cg.builder, cg0, LLVMBuildStructGEP2(cg.builder, at, a0, 0, "cap_ptr"))
   LLVMBuildStore(cg.builder, zero, LLVMBuildStructGEP2(cg.builder, at, a0, 1, "num_chunks_ptr"))
   LLVMBuildStore(cg.builder, zero, LLVMBuildStructGEP2(cg.builder, at, a0, 2, "off_ptr"))
   LLVMBuildStore(cg.builder, one, LLVMBuildStructGEP2(cg.builder, at, a0, 4, "gen_ptr"))
   LLVMBuildRetVoid(cg.builder)

   // dva_arena_alloc(ptr, i64) -> ptr
   alloc_params = types::Addrs()
   alloc_params += atp
   alloc_params += i64t
   alloc_t = stmt::fn_type_n(cg, i8p, alloc_params, 2)
   alloc_fn = LLVMAddFunction(cg.module, "dva_arena_alloc", alloc_t)
   al_e = LLVMAppendBasicBlock(alloc_fn, "entry")
   al_l = LLVMAppendBasicBlock(alloc_fn, "lazy_init")
   al_i = LLVMAppendBasicBlock(alloc_fn, "init_done")
   al_b = LLVMAppendBasicBlock(alloc_fn, "too_large")
   al_c = LLVMAppendBasicBlock(alloc_fn, "checks")
   al_f = LLVMAppendBasicBlock(alloc_fn, "fit_check")
   al_u = LLVMAppendBasicBlock(alloc_fn, "bump")
   al_n = LLVMAppendBasicBlock(alloc_fn, "new_chunk")
   al_lm = LLVMAppendBasicBlock(alloc_fn, "chunk_limit")
   al_m = LLVMAppendBasicBlock(alloc_fn, "malloc")
   al_o = LLVMAppendBasicBlock(alloc_fn, "oom")
   al_s = LLVMAppendBasicBlock(alloc_fn, "store_chunk")
   LLVMPositionBuilderAtEnd(cg.builder, al_e)
   a1 = LLVMGetParam(alloc_fn, 0)
   s1 = LLVMGetParam(alloc_fn, 1)
   cap_gep = LLVMBuildStructGEP2(cg.builder, at, a1, 0, "cap_gep")
   cap_vl = LLVMBuildLoad2(cg.builder, i64t, cap_gep, "cap")
   nc_gep = LLVMBuildStructGEP2(cg.builder, at, a1, 1, "num_chunks_gep")
   nc_vl = LLVMBuildLoad2(cg.builder, i64t, nc_gep, "num_chunks")
   off_gep = LLVMBuildStructGEP2(cg.builder, at, a1, 2, "off_gep")
   off_vl = LLVMBuildLoad2(cg.builder, i64t, off_gep, "off")
   uninit = LLVMBuildICmp(cg.builder, 32, cap_vl, zero, "arena.uninit")
   LLVMBuildCondBr(cg.builder, uninit, al_l, al_i)
   LLVMPositionBuilderAtEnd(cg.builder, al_l)
   LLVMBuildStore(cg.builder, cap_v, cap_gep)
   LLVMBuildStore(cg.builder, one, LLVMBuildStructGEP2(cg.builder, at, a1, 4, "gen_gep"))
   LLVMBuildBr(cg.builder, al_i)
   LLVMPositionBuilderAtEnd(cg.builder, al_i)
   cap_phi = LLVMBuildPhi(cg.builder, i64t, "cap.phi")
   stmt::llvm_add_incoming1(cg, cap_phi, cap_v, al_l)
   stmt::llvm_add_incoming1(cg, cap_phi, cap_vl, al_e)
   too_big = LLVMBuildICmp(cg.builder, 38, s1, cap_phi, "size_gt_cap")
   LLVMBuildCondBr(cg.builder, too_big, al_b, al_c)
   LLVMPositionBuilderAtEnd(cg.builder, al_b)
   pargs = {24}
   pb = &pargs
   @[pb] = LLVMGetNamedGlobal(cg.module, "arena_toobig_msg")
   @[pb + 8] = s1
   @[pb + 16] = cap_phi
   LLVMBuildCall2(cg.builder,
      LLVMFunctionType(i32t, psb, 1, 1),
      LLVMGetNamedFunction(cg.module, "printf"), pb, 3, "")
   eargs = {16}
   eb = &eargs
   @[eb] = LLVMConstInt(i32t, 1, 0)
   LLVMBuildCall2(cg.builder, cg.exit_t, cg.exit_fn, eb, 1, "")
   LLVMBuildRet(cg.builder, LLVMConstNull(i8p))
   LLVMPositionBuilderAtEnd(cg.builder, al_c)
   no_c = LLVMBuildICmp(cg.builder, 32, nc_vl, zero, "no_chunks")
   LLVMBuildCondBr(cg.builder, no_c, al_n, al_f)
   LLVMPositionBuilderAtEnd(cg.builder, al_f)
   new_off = LLVMBuildAdd(cg.builder, off_vl, s1, "new_off")
   full = LLVMBuildICmp(cg.builder, 38, new_off, cap_phi, "chunk_full")
   LLVMBuildCondBr(cg.builder, full, al_n, al_u)
   LLVMPositionBuilderAtEnd(cg.builder, al_u)
   chunks_bump = LLVMBuildStructGEP2(cg.builder, at, a1, 3, "chunks_bump")
   last_idx = LLVMBuildSub(cg.builder, nc_vl, one, "last_chunk_idx")
   last_slot = types::gep2(cg, chunks_arr, chunks_bump, zero, last_idx, "last_chunk_slot")
   last_chunk = LLVMBuildLoad2(cg.builder, i8p, last_slot, "last_chunk")
   res_ptr = types::gep1(cg, LLVMInt8Type!, last_chunk, off_vl, "res_ptr")
   LLVMBuildStore(cg.builder, new_off, off_gep)
   LLVMBuildRet(cg.builder, res_ptr)
   LLVMPositionBuilderAtEnd(cg.builder, al_n)
   limit_reached = LLVMBuildICmp(cg.builder, 39, nc_vl, maxc, "chunk_limit")
   LLVMBuildCondBr(cg.builder, limit_reached, al_lm, al_m)
   LLVMPositionBuilderAtEnd(cg.builder, al_lm)
   emit_abort_msg(cg, "E4003: arena chunk limit reached (too many arena chunks)\n", "arena_chunklimit_msg")
   LLVMBuildRet(cg.builder, LLVMConstNull(i8p))
   LLVMPositionBuilderAtEnd(cg.builder, al_m)
   chunk_v = types::call1(cg, cg.malloc_t, cg.malloc_fn, cap_phi, "chunk")
   chunk_n = LLVMBuildICmp(cg.builder, 32, chunk_v, LLVMConstNull(i8p), "malloc_null")
   LLVMBuildCondBr(cg.builder, chunk_n, al_o, al_s)
   LLVMPositionBuilderAtEnd(cg.builder, al_o)
   emit_abort_msg(cg, "E4001: arena allocator exhausted (out of memory)\n", "arena_oom_msg")
   LLVMBuildRet(cg.builder, LLVMConstNull(i8p))
   LLVMPositionBuilderAtEnd(cg.builder, al_s)
   chunks_new = LLVMBuildStructGEP2(cg.builder, at, a1, 3, "chunks_new")
   new_slot = types::gep2(cg, chunks_arr, chunks_new, zero, nc_vl, "chunk_slot")
   LLVMBuildStore(cg.builder, chunk_v, new_slot)
   nc_next = LLVMBuildAdd(cg.builder, nc_vl, one, "num_chunks_next")
   LLVMBuildStore(cg.builder, nc_next, nc_gep)
   LLVMBuildStore(cg.builder, s1, off_gep)
   LLVMBuildRet(cg.builder, chunk_v)

   // dva_arena_save(ptr) -> i64
   save_params = types::Addrs()
   save_params += atp
   save_t = stmt::fn_type_n(cg, i64t, save_params, 1)
   save_fn = LLVMAddFunction(cg.module, "dva_arena_save", save_t)
   sv_bb = LLVMAppendBasicBlock(save_fn, "entry")
   LLVMPositionBuilderAtEnd(cg.builder, sv_bb)
   a2 = LLVMGetParam(save_fn, 0)
   sv_nc = LLVMBuildLoad2(cg.builder, i64t, LLVMBuildStructGEP2(cg.builder, at, a2, 1, "num_chunks_gep"), "num_chunks")
   sv_cap = LLVMBuildLoad2(cg.builder, i64t, LLVMBuildStructGEP2(cg.builder, at, a2, 0, "cap_gep"), "cap")
   sv_off = LLVMBuildLoad2(cg.builder, i64t, LLVMBuildStructGEP2(cg.builder, at, a2, 2, "off_gep"), "saved_off")
   sv_nc1 = LLVMBuildSub(cg.builder, sv_nc, one, "nc_minus_1")
   sv_prod = LLVMBuildMul(cg.builder, sv_nc1, sv_cap, "chunks_bytes")
   sv_lin = LLVMBuildAdd(cg.builder, sv_prod, sv_off, "linear_off")
   sv_emp = LLVMBuildICmp(cg.builder, 32, sv_nc, zero, "save_empty")
   sv_mark = LLVMBuildSelect(cg.builder, sv_emp, zero, sv_lin, "mark")
   LLVMBuildRet(cg.builder, sv_mark)

   // dva_arena_restore(ptr, i64)
   rest_params = types::Addrs()
   rest_params += atp
   rest_params += i64t
   rest_t = stmt::fn_type_n(cg, LLVMVoidType!, rest_params, 2)
   rest_fn = LLVMAddFunction(cg.module, "dva_arena_restore", rest_t)
   rs_e = LLVMAppendBasicBlock(rest_fn, "entry")
   rs_b = LLVMAppendBasicBlock(rest_fn, "body")
   rs_l = LLVMAppendBasicBlock(rest_fn, "free_loop")
   rs_f = LLVMAppendBasicBlock(rest_fn, "finish")
   rs_d = LLVMAppendBasicBlock(rest_fn, "done")
   LLVMPositionBuilderAtEnd(cg.builder, rs_e)
   a3 = LLVMGetParam(rest_fn, 0)
   m3 = LLVMGetParam(rest_fn, 1)
   r_nc_gep = LLVMBuildStructGEP2(cg.builder, at, a3, 1, "num_chunks_gep")
   r_nc = LLVMBuildLoad2(cg.builder, i64t, r_nc_gep, "num_chunks")
   r_cap_gep = LLVMBuildStructGEP2(cg.builder, at, a3, 0, "cap_gep")
   r_cap = LLVMBuildLoad2(cg.builder, i64t, r_cap_gep, "cap")
   r_off_gep = LLVMBuildStructGEP2(cg.builder, at, a3, 2, "off_gep")
   r_emp = LLVMBuildICmp(cg.builder, 32, r_nc, zero, "restore_empty")
   LLVMBuildCondBr(cg.builder, r_emp, rs_d, rs_b)
   LLVMPositionBuilderAtEnd(cg.builder, rs_b)
   r_chunk_idx = LLVMBuildSDiv(cg.builder, m3, r_cap, "mark_chunk")
   r_keep = LLVMBuildAdd(cg.builder, r_chunk_idx, one, "keep_chunks")
   r_off_n = LLVMBuildSRem(cg.builder, m3, r_cap, "mark_off")
   r_beyond = LLVMBuildICmp(cg.builder, 38, r_keep, r_nc, "mark_beyond_last")
   r_off_f = LLVMBuildSelect(cg.builder, r_beyond, r_cap, r_off_n, "off_final")
   LLVMBuildStore(cg.builder, r_off_f, r_off_gep)
   r_need = LLVMBuildICmp(cg.builder, 40, r_keep, r_nc, "needs_free")
   LLVMBuildCondBr(cg.builder, r_need, rs_l, rs_f)
   LLVMPositionBuilderAtEnd(cg.builder, rs_l)
   free_i = LLVMBuildPhi(cg.builder, i64t, "free_i")
   stmt::llvm_add_incoming1(cg, free_i, r_keep, rs_b)
   r_chunks = LLVMBuildStructGEP2(cg.builder, at, a3, 3, "chunks_gep")
   r_slot = types::gep2(cg, chunks_arr, r_chunks, zero, free_i, "chunk_slot")
   r_chunk = LLVMBuildLoad2(cg.builder, i8p, r_slot, "chunk_ptr")
   freeargs = {16}
   fsb = &freeargs
   @[fsb] = r_chunk
   LLVMBuildCall2(cg.builder, free_t, LLVMGetNamedFunction(cg.module, "free"), fsb, 1, "")
   free_next = LLVMBuildAdd(cg.builder, free_i, one, "free_i_next")
   free_more = LLVMBuildICmp(cg.builder, 40, free_next, r_nc, "free_more")
   stmt::llvm_add_incoming1(cg, free_i, free_next, rs_l)
   LLVMBuildCondBr(cg.builder, free_more, rs_l, rs_f)
   LLVMPositionBuilderAtEnd(cg.builder, rs_f)
   r_new_nc = LLVMBuildSelect(cg.builder, r_beyond, r_nc, r_keep, "num_chunks_final")
   LLVMBuildStore(cg.builder, r_new_nc, r_nc_gep)
   LLVMBuildBr(cg.builder, rs_d)
   LLVMPositionBuilderAtEnd(cg.builder, rs_d)
   r_gen_gep = LLVMBuildStructGEP2(cg.builder, at, a3, 4, "gen_gep")
   r_gen = LLVMBuildLoad2(cg.builder, i64t, r_gen_gep, "gen")
   LLVMBuildStore(cg.builder, LLVMBuildAdd(cg.builder, r_gen, one, "gen_next"), r_gen_gep)
   LLVMBuildRetVoid(cg.builder)

   // dva_arena_destroy(ptr)
   dest_params = types::Addrs()
   dest_params += atp
   dest_t = stmt::fn_type_n(cg, LLVMVoidType!, dest_params, 1)
   dest_fn = LLVMAddFunction(cg.module, "dva_arena_destroy", dest_t)
   ds_e = LLVMAppendBasicBlock(dest_fn, "entry")
   ds_l = LLVMAppendBasicBlock(dest_fn, "free_loop")
   ds_f = LLVMAppendBasicBlock(dest_fn, "finish")
   LLVMPositionBuilderAtEnd(cg.builder, ds_e)
   a4 = LLVMGetParam(dest_fn, 0)
   d_nc_gep = LLVMBuildStructGEP2(cg.builder, at, a4, 1, "num_chunks_gep")
   d_nc = LLVMBuildLoad2(cg.builder, i64t, d_nc_gep, "num_chunks")
   d_off_gep = LLVMBuildStructGEP2(cg.builder, at, a4, 2, "off_gep")
   d_emp = LLVMBuildICmp(cg.builder, 32, d_nc, zero, "destroy_empty")
   LLVMBuildCondBr(cg.builder, d_emp, ds_f, ds_l)
   LLVMPositionBuilderAtEnd(cg.builder, ds_l)
   d_i = LLVMBuildPhi(cg.builder, i64t, "free_i")
   stmt::llvm_add_incoming1(cg, d_i, zero, ds_e)
   d_chunks = LLVMBuildStructGEP2(cg.builder, at, a4, 3, "chunks_gep")
   d_slot = types::gep2(cg, chunks_arr, d_chunks, zero, d_i, "chunk_slot")
   d_chunk = LLVMBuildLoad2(cg.builder, i8p, d_slot, "chunk_ptr")
   dargs = {16}
   dsb = &dargs
   @[dsb] = d_chunk
   LLVMBuildCall2(cg.builder, free_t, LLVMGetNamedFunction(cg.module, "free"), dsb, 1, "")
   d_next = LLVMBuildAdd(cg.builder, d_i, one, "free_i_next")
   d_more = LLVMBuildICmp(cg.builder, 40, d_next, d_nc, "free_more")
   stmt::llvm_add_incoming1(cg, d_i, d_next, ds_l)
   LLVMBuildCondBr(cg.builder, d_more, ds_l, ds_f)
   LLVMPositionBuilderAtEnd(cg.builder, ds_f)
   LLVMBuildStore(cg.builder, zero, d_nc_gep)
   LLVMBuildStore(cg.builder, zero, d_off_gep)
   LLVMBuildRetVoid(cg.builder)

   // dva_arena_adopt(parent, child)
   adopt_params = types::Addrs()
   adopt_params += atp
   adopt_params += atp
   adopt_t = stmt::fn_type_n(cg, LLVMVoidType!, adopt_params, 2)
   adopt_fn = LLVMAddFunction(cg.module, "dva_arena_adopt", adopt_t)
   ad_e = LLVMAppendBasicBlock(adopt_fn, "entry")
   ad_ap = LLVMAppendBasicBlock(adopt_fn, "append")
   ad_pz = LLVMAppendBasicBlock(adopt_fn, "parent_zero")
   ad_pp = LLVMAppendBasicBlock(adopt_fn, "parent_pos")
   ad_l = LLVMAppendBasicBlock(adopt_fn, "loop")
   ad_c = LLVMAppendBasicBlock(adopt_fn, "clear")
   ad_d = LLVMAppendBasicBlock(adopt_fn, "done")
   LLVMPositionBuilderAtEnd(cg.builder, ad_e)
   ad_parent = LLVMGetParam(adopt_fn, 0)
   ad_child = LLVMGetParam(adopt_fn, 1)
   ad_c_nc_gep = LLVMBuildStructGEP2(cg.builder, at, ad_child, 1,
      "c_nc_gep")
   ad_c_nc = LLVMBuildLoad2(cg.builder, i64t, ad_c_nc_gep, "c_nc")
   ad_c_emp = LLVMBuildICmp(cg.builder, 32, ad_c_nc, zero, "c_emp")
   LLVMBuildCondBr(cg.builder, ad_c_emp, ad_d, ad_ap)
   LLVMPositionBuilderAtEnd(cg.builder, ad_ap)
   ad_p_nc_gep = LLVMBuildStructGEP2(cg.builder, at, ad_parent, 1,
      "p_nc_gep")
   ad_p_nc = LLVMBuildLoad2(cg.builder, i64t, ad_p_nc_gep, "p_nc")
   ad_p_chunks = LLVMBuildStructGEP2(cg.builder, at, ad_parent, 3,
      "p_chunks")
   ad_c_chunks = LLVMBuildStructGEP2(cg.builder, at, ad_child, 3,
      "c_chunks")
   ad_p_emp = LLVMBuildICmp(cg.builder, 32, ad_p_nc, zero, "p_emp")
   LLVMBuildCondBr(cg.builder, ad_p_emp, ad_pz, ad_pp)
   LLVMPositionBuilderAtEnd(cg.builder, ad_pz)
   ad_c_off_gep = LLVMBuildStructGEP2(cg.builder, at, ad_child, 2,
      "c_off_gep")
   ad_c_off = LLVMBuildLoad2(cg.builder, i64t, ad_c_off_gep, "c_off")
   ad_p_off_gep = LLVMBuildStructGEP2(cg.builder, at, ad_parent, 2,
      "p_off_gep")
   LLVMBuildStore(cg.builder, ad_c_off, ad_p_off_gep)
   LLVMBuildBr(cg.builder, ad_l)
   LLVMPositionBuilderAtEnd(cg.builder, ad_pp)
   ad_last_idx = LLVMBuildSub(cg.builder, ad_p_nc, one, "p_last_idx")
   ad_p_last_slot = types::gep2(cg, chunks_arr, ad_p_chunks, zero, ad_last_idx,
      "p_last_slot")
   ad_p_last_chunk = LLVMBuildLoad2(cg.builder, i8p, ad_p_last_slot,
      "p_last_chunk")
   ad_new_act_idx = LLVMBuildAdd(cg.builder, ad_last_idx, ad_c_nc,
      "p_new_act_idx")
   ad_p_new_slot = types::gep2(cg, chunks_arr, ad_p_chunks, zero, ad_new_act_idx,
      "p_new_slot")
   LLVMBuildStore(cg.builder, ad_p_last_chunk, ad_p_new_slot)
   LLVMBuildBr(cg.builder, ad_l)
   LLVMPositionBuilderAtEnd(cg.builder, ad_l)
   ad_start_idx = LLVMBuildPhi(cg.builder, i64t, "start_idx")
   stmt::llvm_add_incoming1(cg, ad_start_idx, zero, ad_pz)
   stmt::llvm_add_incoming1(cg, ad_start_idx, ad_last_idx, ad_pp)
   ad_j = LLVMBuildPhi(cg.builder, i64t, "ad_j")
   stmt::llvm_add_incoming1(cg, ad_j, zero, ad_pz)
   stmt::llvm_add_incoming1(cg, ad_j, zero, ad_pp)
   ad_c_slot = types::gep2(cg, chunks_arr, ad_c_chunks, zero, ad_j, "c_slot")
   ad_c_chunk = LLVMBuildLoad2(cg.builder, i8p, ad_c_slot, "c_chunk")
   ad_dst_idx = LLVMBuildAdd(cg.builder, ad_start_idx, ad_j,
      "dst_idx")
   ad_dst_slot = types::gep2(cg, chunks_arr, ad_p_chunks, zero, ad_dst_idx,
      "dst_slot")
   LLVMBuildStore(cg.builder, ad_c_chunk, ad_dst_slot)
   ad_j_next = LLVMBuildAdd(cg.builder, ad_j, one, "ad_j_next")
   ad_more = LLVMBuildICmp(cg.builder, 40, ad_j_next, ad_c_nc,
      "ad_more")
   stmt::llvm_add_incoming1(cg, ad_start_idx, ad_start_idx, ad_l)
   stmt::llvm_add_incoming1(cg, ad_j, ad_j_next, ad_l)
   LLVMBuildCondBr(cg.builder, ad_more, ad_l, ad_c)
   LLVMPositionBuilderAtEnd(cg.builder, ad_c)
   ad_new_nc = LLVMBuildAdd(cg.builder, ad_p_nc, ad_c_nc, "new_p_nc")
   LLVMBuildStore(cg.builder, ad_new_nc, ad_p_nc_gep)
   LLVMBuildStore(cg.builder, zero, ad_c_nc_gep)
   ad_c_off_clr = LLVMBuildStructGEP2(cg.builder, at, ad_child, 2,
      "c_off_clr")
   LLVMBuildStore(cg.builder, zero, ad_c_off_clr)
   LLVMBuildBr(cg.builder, ad_d)
   LLVMPositionBuilderAtEnd(cg.builder, ad_d)
   LLVMBuildRetVoid(cg.builder)

   strlen_t = types::fn_type1(i64t, i8p)
   strlen_fn = LLVMAddFunction(cg.module, "strlen", strlen_t)
   cg.memcmp_t = types::fn_type3(LLVMInt32Type!, i8p, i8p, i64t)
   cg.memcmp_fn = LLVMAddFunction(cg.module, "memcmp", cg.memcmp_t)

   // dva_hash_string(ptr, i64) -> i64
   hash_params = types::Addrs()
   hash_params += i8p
   hash_params += i64t
   hash_t = stmt::fn_type_n(cg, i64t, hash_params, 2)
   hash_fn = LLVMAddFunction(cg.module, "dva_hash_string", hash_t)
   mark_nounwind(cg, hash_fn)
   hs_e = LLVMAppendBasicBlock(hash_fn, "entry")
   hs_l = LLVMAppendBasicBlock(hash_fn, "loop")
   hs_b = LLVMAppendBasicBlock(hash_fn, "body")
   hs_d = LLVMAppendBasicBlock(hash_fn, "done")
   LLVMPositionBuilderAtEnd(cg.builder, hs_e)
   hp = LLVMGetParam(hash_fn, 0)
   hl = LLVMGetParam(hash_fn, 1)
   LLVMBuildBr(cg.builder, hs_l)
   LLVMPositionBuilderAtEnd(cg.builder, hs_l)
   h_phi = LLVMBuildPhi(cg.builder, i64t, "h.phi")
   i_phi = LLVMBuildPhi(cg.builder, i64t, "i.phi")
   stmt::llvm_add_incoming1(cg, h_phi, LLVMConstInt(i64t, -3750763034362895579, 0), hs_e)
   stmt::llvm_add_incoming1(cg, i_phi, zero, hs_e)
   lt = LLVMBuildICmp(cg.builder, 40, i_phi, hl, "hash.lt")
   LLVMBuildCondBr(cg.builder, lt, hs_b, hs_d)
   LLVMPositionBuilderAtEnd(cg.builder, hs_b)
   bgep = types::gep1(cg, LLVMInt8Type!, hp, i_phi, "hash.byte.gep")
   bv = LLVMBuildLoad2(cg.builder, LLVMInt8Type!, bgep, "hash.byte")
   bz = LLVMBuildZExt(cg.builder, bv, i64t, "hash.byte.zext")
   hadd = LLVMBuildAdd(cg.builder, h_phi, bz, "hash.add")
   hmul = LLVMBuildMul(cg.builder, hadd, LLVMConstInt(i64t, 1099511628211, 0), "hash.mul")
   inx = LLVMBuildAdd(cg.builder, i_phi, one, "hash.i.next")
   stmt::llvm_add_incoming1(cg, h_phi, hmul, hs_b)
   stmt::llvm_add_incoming1(cg, i_phi, inx, hs_b)
   LLVMBuildBr(cg.builder, hs_l)
   LLVMPositionBuilderAtEnd(cg.builder, hs_d)
   LLVMBuildRet(cg.builder, h_phi)

// "x = <expr>" — evaluate the RHS and store it into the variable's global.
// A heap ram (Ram-typed but a pointer, not an i1) is stored as a pointer and
// the variable marked is_heap so later loads read a pointer.
codegen_emit_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_assign = cg, t =>
   !cg.in_fn && t.3 && !types::has_str(types::g.marked_globals, t.0)
      | types::g.marked_globals += t.0
   codegen_check_binding(cg, t)
   expr::codegen_check_addr_escape(cg, t)
   !cg.error
      |
         saved_discard = cg.discard_result
         cg.discard_result = <->
         codegen_emit_assign_after_binding(cg, t)
         cg.discard_result = saved_discard

codegen_emit_assign_after_binding: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_assign_after_binding = cg, t =>
   t.4 | codegen_emit_length_set(cg, t) | codegen_emit_assign_g(cg, t)

// "x ::= v" — global mutation: write the existing binding, bypassing any
// function-local shadow (the top-level slot for a top-level binding).
codegen_emit_assign_g: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_assign_g = cg, t =>
   is_glob = t.3 || types::has_str(types::g.marked_globals, t.0)
   is_glob | codegen_emit_global_assign(cg, t) | codegen_emit_assign_c(cg, t)

is_builder_record_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
is_builder_record_assign = cg, t =>
   !t.2 && (!cg.in_fn || types::has_local_var(cg, t.0)) &&
      types::is_builder_vt(types::var_type(cg, t.0)) &&
      types::is_record_vt(types::static_expr_vt(cg, t.5))

codegen_emit_assign_c: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_assign_c = cg, t =>
   is_b_rec = is_builder_record_assign(cg, t)
   t.2 || is_b_rec | codegen_emit_compound_assign(cg, t) |
      t.6
         [Member mm] codegen_emit_member_assign(cg, t)
         [KeyAccess ka] codegen_emit_map_assign(cg, t, ka)
         [RawMemory rm] codegen_emit_raw_assign(cg, t, rm)
         [Call call] codegen_emit_call_assign(cg, t, call)
         | codegen_emit_plain_assign(cg, t)

// "?b = n" — set a Builder's length (the report model after an FFI read).
codegen_emit_length_set: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => Addr
codegen_emit_length_set = cg, t =>
   saved_discard = cg.discard_result
   cg.discard_result = <->
   bv = expr::codegen_eval(cg, t.5)
   cg.discard_result = saved_discard
   bval = types::ptr_var_value(cg, t.0, "b.load")
   main::builder_set_len_checked(cg, bval, bv.0, t.0)

// "x ::= v" — global mutation: write the existing binding, bypassing any
// function-local shadow (the top-level slot for a top-level binding).
codegen_emit_global_assign: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_global_assign = cg, t =>
   codegen_emit_plain_assign(cg, t)

// "x = <fwd>" — a forward annotation: create a zeroed slot of the declared
// type's LLVM shape and register the binding (a later '=' / '::=' fills it).
codegen_emit_forward: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_forward = cg, t =>
   codegen_forward_registry(cg, t)
   ti = forward_type_info(cg, t)
   is_arr_anno = ti [Array _]
   is_arr_anno
      |
         types::var_slot(cg, t.0)
            | slot =>
               i8p = LLVMPointerType(LLVMInt8Type!, 0)
               LLVMBuildStore(cg.builder, LLVMConstNull(i8p), slot)
            | 0
      | 0

// The LLVM struct type + field names of a record TypeInfo (an empty names for
// non-records). A helper so a forward-annotated record ("t: T") resolves its
// schema before the field-by-field writes compile. Built via a param-threaded
// recursion (no '@' cycle — a nested cycle's arena restore would reap the
// field-name array).
record_meta_from_ti: types::Cg, ast::TypeInfo => <(Addr, ast::Names)|>
record_meta_from_ti = cg, ti =>
   stmt::ti_is_slice(ti)
      | <-->
      |
         ti
            [Rec rr]
               nf = ?rr.0
               <+ build_rec_meta_packed(cg, rr.0, 0, nf, types::Addrs(), ast::Names(),
                  rr.5) ->
            [Bitfield b]
               fnames = ast::Names()
               ?b.fields @ i =>
                  bf = b.fields(i) | _ | ast::BitfieldField(("", 0, 0))
                  fnames += ++bf.name
               <+ (types::llvm_type_of_vt(b.backing_type), fnames) ->
            [TypeVar name] types::td_record_meta_by_name(cg, name)
            [Prim p]
               is_err = p [Error]
               is_err
                  | <+ (main::error_struct_type(cg), types::error_field_names!) ->
                  | <-->
            | <-->


rec_field_vt: types::Cg, ast::RecordFieldType => ast::ValueType
rec_field_vt = cg, rf =>
   stmt::ti_is_slice(rf.rec_type)
      | ast::ValueType(Slice)
      |
         rf.rec_type
            [TypeVar name]
               ti = types::typedef_ti(cg, name)
               stmt::ti_is_slice(ti)
                  | ast::ValueType(Slice)
                  |
                     resolved = types::vt_from_ti(ti)
                     resolved != ast::ValueType(Unknown) | resolved | rf.val_type
            | rf.val_type

field_vts_step: types::Cg, ast::FieldTypes, Int, Int, ast::VTypes => ast::VTypes
field_vts_step = cg, fields, i, n, acc =>
   i == n
      | acc
      |
         rf = fields(i)!!
         acc += rec_field_vt(cg, rf)
         field_vts_step(cg, fields, i + 1, n, acc)

rec_field_rec_llvm_type: types::Cg, ast::TypeInfo => Addr
rec_field_rec_llvm_type = cg, ti =>
   m = record_meta_from_ti(cg, ti)
   m | m0 => m0.0 | LLVMPointerType(LLVMInt8Type!, 0)

rec_field_llvm_type: types::Cg, ast::RecordFieldType => Addr
rec_field_llvm_type = cg, rf =>
   bf_opt = types::ti_get_bitfield(cg, rf.rec_type)
   bf_opt
      | b => types::llvm_type_of_vt(b.backing_type)
      |
         vt = rec_field_vt(cg, rf)
         is_heap = vt [Ram] match::ram_ti_is_heap(cg, rf.rec_type) | (vt [Enum])
         is_sl = (vt [Slice]) || stmt::ti_is_slice(rf.rec_type)
         is_rec = (vt [Record]) && !is_sl
         is_heap || is_sl
            | LLVMPointerType(LLVMInt8Type!, 0)
            |
               is_rec
                  | rec_field_rec_llvm_type(cg, rf.rec_type)
                  | types::llvm_type_of_vt(vt)

build_rec_meta: types::Cg, ast::FieldTypes, Int, Int, types::Addrs, ast::Names => (Addr, ast::Names)
build_rec_meta = cg, fields, i, nf, ftypes, fnames =>
   build_rec_meta_packed(cg, fields, i, nf, ftypes, fnames, <->)

build_rec_meta_packed: types::Cg, ast::FieldTypes, Int, Int, types::Addrs, ast::Names,
   <> => (Addr, ast::Names)
build_rec_meta_packed = cg, fields, i, nf, ftypes, fnames, is_packed =>
   (i < nf)
      |
         rf = fields(i)!!
         ftypes += rec_field_llvm_type(cg, rf)
         fnames += ++rf.name
         build_rec_meta_packed(cg, fields, i + 1, nf, ftypes, fnames,
            is_packed)
      | (types::struct_type_packed_n(cg, ftypes, nf, is_packed), fnames)

// Whether a ValueType is a whole-assignable composite (a record; arrays are
// whole-initialized via their record-literal RHS, tracked separately).
is_composite_vt: ast::ValueType => <>
is_composite_vt = vt =>
   types::is_record_vt(vt)

// A forward annotation is uninitialized until a whole assignment. Composite
// values additionally use this bit for field-level must-initialize tracking.
is_partial_anno: types::Cg, ast::ValueType, String, ast::TypeInfo => <>
is_partial_anno = cg, vt, dtype, ti =>
   <+>

// Registers the '#type' declarations before the forward annotations and
// functions compile (a forward-annotated record type name must resolve).
codegen_register_types: types::Cg, ast::Exprs => ()
codegen_register_types = cg, stmts =>
   codegen_register_types_step(cg, stmts, 0)

codegen_register_types_step: types::Cg, ast::Exprs, Int => ()
codegen_register_types_step = cg, stmts, i =>
   i !< ?stmts
      | 0
      |
         e = stmts(i)!!
         e
            [TypeDecl t] add_type(cg, t.name, t.type_info)
            [Block b] codegen_register_types(cg, b.exprs)
            | 0
         codegen_register_types_step(cg, stmts, i + 1)

string_has_double_colon: String, Int => <>
string_has_double_colon = s, i =>
   i + 1 < ?s
      |
         a = s(i)
         b = s(i + 1)
         a == 58 && b == 58
            | <+>
            | string_has_double_colon(s, i + 1)
      | <->

// Registers a forward annotation's slot + CgVar (idempotent: finds an
// existing slot). A top-level "x: T" must exist before the functions compile,
// so a fn body's '::='/'=' can resolve the global.
codegen_forward_registry: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
   String, ast::TypeInfo) => ()
codegen_forward_registry = cg, t =>
   tv = types::type_name_to_vt(t.7)
   ti = forward_type_info(cg, t)
   bf_opt_fwd = types::ti_get_bitfield(cg, ti)
   is_bf_fwd = <>(bf_opt_fwd)
   rec_m = record_meta_from_ti(cg, ti)
   rec_fnames = rec_m | m => m.1 | ast::Names()
   vt_bf = bf_opt_fwd | b => b.backing_type | tv.0
   vt0 = is_bf_fwd | vt_bf | tv.0
   rec_vt = !is_bf_fwd && ?rec_fnames > 0 | ast::ValueType(Record) | vt0
   ti_vt = types::vt_from_ti(ti)
   vt_rec = ti_vt != ast::ValueType(Unknown) | ti_vt | rec_vt
   vt' = is_bf_fwd | vt0 | vt_rec
   lt = is_bf_fwd
      | types::llvm_type_of_vt(vt')
      |
         types::is_record_vt(vt')
            | LLVMPointerType(LLVMInt8Type!, 0)
            | types::llvm_type_of_vt(vt')
   is_ct_sig = t.7(..4) == "@ct0"
   is_sig = t.7(..5) == "@sig0"
   is_fn_ti = ti [Fn _]
   is_fn_sig = is_fn_ti || is_ct_sig || is_sig
   !is_fn_sig && string_has_double_colon(t.7, 0) && !types::has_type_name(cg, t.7)
      | types::init_error(cg, "E3120", "Unresolved type name '" + t.7 + "'", 0, 0)
      | 0
   vt' = is_fn_sig | ast::ValueType(Fn) | vt'
   !is_fn_sig && (types::has_fn_name(cg, t.0) || types::is_fn_name(cg, t.0))
      | types::init_error(cg, "E3151", "Cannot assign Function to '" + t.0 +
         "' (bound as " + types::value_type_name(vt') + ").", 0, 0)
      | 0
   slot = types::var_slot(cg, t.0)
      | _
      | (!is_fn_sig | types::create_slot(cg, t.0, lt, cg.in_fn) | Addr(0))
   is_partial = !is_bf_fwd && is_partial_anno(cg, tv.0, t.7, t.8)
   rec_m0_opt = rec_m | m => <+ m.0 -> | <-->
   slot_opt = slot != Addr(0) | <+ slot -> | <-->
   cg.vars += types::CgVar((t.0, vt', <->, t.7, rec_m0_opt, rec_fnames, slot_opt,
      cg.in_fn, is_partial, types::field_vts(cg, ti), <-->))
   bf_opt_fwd
      | bfi =>
         LLVMBuildStore(cg.builder, LLVMConstInt(lt, 0, 0), slot)
         types::init_mark_whole(cg, t.0)
      | 0
   !is_fn_sig && !binding_state(cg, t.0).found
      | binding_add(cg, t.0, <+>)

// A named annotation resolves through the typedef table. Parenthesized
// records and slices instead carry their schema directly in the Assign node.
forward_type_info: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ast::TypeInfo
forward_type_info = cg, t =>
   t.8
      [Prim v]
         v [Unknown] types::typedef_ti(cg, t.7) | t.8
      [TypeVar name] types::typedef_ti(cg, name)
      | t.8

// Scans the top-level statements and registers the forward annotations.
codegen_register_forwards: types::Cg, ast::Exprs => ()
codegen_register_forwards = cg, stmts =>
   codegen_register_forwards_step(cg, stmts, 0)

codegen_register_forwards_step: types::Cg, ast::Exprs, Int => ()
codegen_register_forwards_step = cg, stmts, i =>
   i !< ?stmts
      | 0
      |
         e = stmts(i)!!
         e
            [Assign t]
               is_fwd_expr(cg, t)
                  | codegen_forward_registry(cg, t)
                  | 0
            [Block b] codegen_register_forwards(cg, b.exprs)
            | 0
         codegen_register_forwards_step(cg, stmts, i + 1)

// "b += rhs" — in-place Builder append (also "arr += v" for growable arrays).
codegen_emit_compound_assign: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_compound_assign = cg, t =>
   t.6
      [Member mm] codegen_emit_member_compound(cg, t, mm)
      |
         vt_arr = types::is_array_vt(types::var_type(cg, t.0))
         is_arr = vt_arr || stmt::typedef_is_array(cg, types::var_dtype(cg, t.0))
         is_arr
            | codegen_emit_array_append(cg, t)
            |
               bval = types::ptr_var_value(cg, t.0, "b.load")
               main::codegen_builder_append(cg, bval, t.5)
               types::var_slot(cg, t.0)
                  | slot => LLVMBuildStore(cg.builder, bval, slot)
                  | 0

// "a += v" for an array variable.
codegen_emit_array_append: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_array_append = cg, t =>
   types::is_view_expr(cg, t.5)
      | types::init_error(cg, "E3150", "View cannot escape function frame", 0, 0)
      | 0
   want = array_elem_type(cg, t.0)
   got = types::static_expr_vt(cg, t.5)
   mismatch = want.1 && (got != ast::ValueType(Unknown)) && (got != want.0) &&
      !(types::is_int_vt(want.0) && types::is_int_vt(got))
   mismatch
      | types::init_error(cg, "E3110", "Array '" + t.0 + "' holds " +
         types::value_type_name(want.0) + ", append got " +
         types::value_type_name(got) + ".", 0, 0)
      | codegen_emit_array_append_valid(cg, t)

// The element type carried by a growable-array typedef such as
// '#type Ints (Int){}'. It remains compile-time-only metadata.
array_elem_type: types::Cg, String => (ast::ValueType, <>)
array_elem_type = cg, name =>
   ti = types::typedef_ti(cg, types::var_dtype(cg, name))
   ti
      [Array a]
         resolved_ti = a.1 [TypeVar n] types::typedef_ti(cg, n) | a.1
         resolved_vt = types::vt_from_ti(resolved_ti)
         elem_vt = resolved_vt != ast::ValueType(Unknown) | resolved_vt | a.0
         (elem_vt, <+>)
      | (ast::ValueType(Unknown), <->)

codegen_emit_array_append_valid: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_array_append_valid = cg, t =>
   aval = types::ptr_var_value(cg, t.0, "a.load")
   ev = expr::codegen_eval(cg, t.5)
   main::codegen_array_append(cg, aval, ev.0)

// "r.out += v" — a compound append to a record field (a Builder / growable
// array). GEP into the record's field slot and append to the field value.
codegen_emit_member_compound: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::MemberExpr => ()
codegen_emit_member_compound = cg, t, m =>
   base = expr::codegen_eval(cg, m.target)
   vname = m.target [Var v] v | ""
   fnames = vname != "" | types::var_fnames(cg, vname) | cg.last_fnames
   rt_opt = vname != ""
      | (types::var_rt(cg, vname) | cg.last_rt)
      | cg.last_rt
   rt = rt_opt | r => r | Addr(0)
   fvts = vname != "" | match::var_fvts(cg, vname) | cg.last_fvts
   idx = types::member_index(fnames, m.field_name)
   fgep = types::record_field_gep(cg, rt, fvts, base.0, idx)
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   val_ptr = LLVMBuildLoad2(cg.builder, i8p, fgep, "m.val.load")
   fvt = idx < ?fvts
      | fvts(idx) | _ | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)
   is_arr = fvt [Array]
   is_arr
      |
         ev = expr::codegen_eval(cg, t.5)
         main::codegen_array_append(cg, val_ptr, ev.0)
      | main::codegen_builder_append(cg, val_ptr, t.5)

// "x = <expr>" for a non-member LHS. A function definition ("f = x => body")
// is compiled separately and stores nothing here. A heap ram (Ram-typed but a
// pointer, not an i1) is stored as a pointer and the variable marked is_heap
// so later loads read a pointer; record values carry their struct type.
binding_state_at: types::Cg, String, Int => types::BindingState
binding_state_at = cg, name, i =>
   i < 0
      | types::BindingState((<->, <->))
      |
         b = cg.bindings(i)!!
         is_cur = (!cg.in_fn && !b.is_local) ||
            (cg.in_fn && b.is_local && (i !< cg.fn_binding_start))
         cur_mut = is_cur | b.mutable | <->
         bname = types::decl_bare_name(name, 0)
         req_mod = types::name_is_qualified(name, 0) | types::decl_module(name, 0) |
            cg.current_module
         mod_ok = b.is_local || (b.mod_name == req_mod)
         b.name == bname && mod_ok
            | types::BindingState((<+>, cur_mut))
            | binding_state_at(cg, name, i - 1)

name_is_primed: String => <>
name_is_primed = name => ?name > 0 && name(-1..) == "'"

binding_state: types::Cg, String => types::BindingState
binding_state = cg, name =>
   binding_state_at(cg, name, ?cg.bindings - 1)

binding_add: types::Cg, String, <> => ()
binding_add = cg, name, mutable =>
   bname = types::decl_bare_name(name, 0)
   mname = types::name_is_qualified(name, 0) | types::decl_module(name, 0) |
      cg.current_module
   cg.bindings += types::BindingMut((bname, mname, cg.in_fn, mutable))

binding_truncate_step: types::BindingMuts, Int, Int, types::BindingMuts => types::BindingMuts
binding_truncate_step = bs, n, i, acc =>
   i == n
      | acc
      |
         acc += bs(i)!!
         binding_truncate_step(bs, n, i + 1, acc)

binding_truncate: types::BindingMuts, Int => types::BindingMuts
binding_truncate = bs, n =>
   binding_truncate_step(bs, n, 0, types::BindingMuts())

only_globals_step: types::Cg, types::BindingMuts, Int, Int, types::BindingMuts => types::BindingMuts
only_globals_step = cg, bs, n, i, acc =>
   i == n
      | acc
      |
         b = bs(i)!!
         !b.is_local && (b.mod_name == cg.current_module) | acc += b | 0
         only_globals_step(cg, bs, n, i + 1, acc)

only_globals: types::Cg, types::BindingMuts => types::BindingMuts
only_globals = cg, bs =>
   only_globals_step(cg, bs, ?bs, 0, types::BindingMuts())

codegen_check_binding: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_check_binding = cg, t =>
   name_type = types::type_name_to_vt(t.0)
   name_type.1
      | codegen_reserved_type_binding_error(cg, t.0)
      | codegen_check_binding_valid(cg, t)

codegen_reserved_type_binding_error: types::Cg, String => ()
codegen_reserved_type_binding_error = cg, name =>
   types::init_error(cg, "E3050", "Cannot define '" + name +
      "' — it is a built-in type name and is reserved for type coercion.", 0, 0)

codegen_check_binding_valid: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_check_binding_valid = cg, t =>
   plain_lhs = !lhs_is_member(t) && !lhs_is_keyaccess(t) &&
      !lhs_is_rawmemory(t) && !lhs_is_call(t)
   is_b_rec = is_builder_record_assign(cg, t)
   is_glob = t.3 || types::has_str(types::g.marked_globals, t.0)
   ordinary = !t.2 && !is_glob && !t.4 && !is_fwd_expr(cg, t) &&
      !rhs_is_fn(t) && plain_lhs && !is_b_rec
   ordinary
      |
         types::is_any_fn_name(cg, t.0)
            |
               types::init_error(cg, "E3033",
                  "Cannot re-assign immutable binding '" + t.0 +
                  "'. Use a prime suffix ('" + t.0 +
                  "\'') for rebindable variables.", 0, 0)
            |
               prior = binding_state(cg, t.0)
               prior.found
                  |
                     !prior.mutable
                        |
                           types::init_error(cg, "E3033",
                              "Cannot re-assign immutable binding '" + t.0 +
                              "'. Use a prime suffix ('" + t.0 +
                              "\'') for rebindable variables.", 0, 0)
                        | 0
                  |
                     is_mut = t.1 || name_is_primed(t.0)
                     binding_add(cg, t.0, is_mut)

// Whether an Assign's LHS is a key-access write ("e ^ 'a' = v" — a map
// element store, not a binding reassign).
lhs_is_keyaccess: (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
lhs_is_keyaccess = t => t.6 [KeyAccess _]

lhs_is_rawmemory: (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
lhs_is_rawmemory = t => t.6 [RawMemory _]

lhs_is_call: (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
lhs_is_call = t => t.6 [Call _]

expr_kind_str: ast::Expr => String
expr_kind_str = e =>
   e
      [Int _] "Int"
      [Rune _] "Rune"
      [Float _] "Float"
      [Str _] "Str"
      [Var v] "Var(" + v + ")"
      [Bin _] "Bin"
      [Unary _] "Unary"
      [Call _] "Call"
      [Block _] "Block"
      [Assign _] "Assign"
      [Choice _] "Choice"
      [Cycle _] "Cycle"
      [Fn _] "Fn"
      [Member _] "Member"
      [Record _] "Record"
      | "Other"

codegen_emit_plain_assign: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_plain_assign = cg, t =>
   is_fn_decl = !cg.in_fn && (t.5 [Fn _])
   is_fn_decl
      |
         f = t.5 [Fn fe] fe | ast::FnExpr((ast::Names(), ast::Names(),
            ast::Expr(Var, "")))
         types::has_fn_name(cg, t.0)
            |
               types::add_fn_def(cg, types::FnDef((t.0, f.params, f.body)))
               types::is_fn_name(cg, t.0)
                  | stmt::compile_fn_lazy_force(cg, t.0, ast::VTypes())
                  | <->
               0
            | 0
      |
         is_fwd_expr(cg, t)
            | codegen_emit_forward(cg, t)
            |
               rhs_is_inexhaustive_choice(t.5)
                  | types::init_error(cg, "E3032", "Cannot assign inexhaustive choice " +
                     "expression to variable '" + t.0 + "'. Inexhaustive choice " +
                     "expressions are unassignable.", 0, 0)
                  | codegen_emit_plain_assign_val(cg, t)

// Whether an assign is a forward annotation ("x: T" — RHS is the "<fwd>" marker).
is_fwd_expr: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
is_fwd_expr = cg, t =>
   t.5 [Var v] (v == "<fwd>") | <->

// Choice expressions without a total branch set cannot produce a value for
// every scrutinee. Native codegen returns Unassignable for these; diagnose at
// the assignment boundary before emitting a store.
rhs_is_inexhaustive_choice: ast::Expr => <>
rhs_is_inexhaustive_choice = e =>
   e [Choice c]
      nb = ?c.branches
      last_br = nb > 0 | c.branches(nb - 1)!! | ast::ChoiceBranch((
         ast::GuardKind(Bare), ast::Exprs(), ast::Expr(Int, 0), ast::Names(),
         ast::Names(), <->, ast::Expr(Int, 0)))
      is_bare = last_br.kind [Bare]
      has_bare = nb > 0 && is_bare
      !c.is_exhaustive && !has_bare
   | <->

codegen_emit_plain_assign_val: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_plain_assign_val = cg, t =>
   match::choice_mixed_declared_fns(cg, t.5)
      |
         cg.closure_vars += t.0
         cg.closure_tgts += "<mixed>"
      | 0
   saved_discard = cg.discard_result
   cg.discard_result = <->
   cg.last_closure_fn = ""
   ev = expr::codegen_eval(cg, t.5)
   cg.discard_result = saved_discard
   is_un = ev.1 [Unit]
   is_un
      |
         types::init_error(cg, "E3032", "Cannot assign Void expression to variable '" +
            t.0 + "'.", 0, 0)
      |
         codegen_emit_plain_assign_val_store(cg, t, ev)
         t.5 [CompileTime ct]
            ct_res = match::ctfe_eval(cg, ct.expr, types::CtFrames(), 0)
            !match::ctfe_is_none(ct_res.0)
               |
                  types::ct_val_bind_push(t.0, ct_res.0)
                  bare = types::decl_bare_name(t.0, 0)
                  bare != t.0 | types::ct_val_bind_push(bare, ct_res.0)

codegen_emit_plain_assign_val_store: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   (Addr, ast::ValueType) => ()
codegen_emit_plain_assign_val_store = cg, t, ev =>
   is_glob = t.3 || types::has_str(types::g.marked_globals, t.0)
   is_view = types::is_view_expr(cg, t.5)
   is_view && (!cg.in_fn || is_glob)
      | types::init_error(cg, "E3150", "View cannot escape function frame", 0, 0)
      | 0
   is_view | types::view_var_add(t.0) | 0
   fresh_local = !is_glob | (cg.in_fn | !types::has_local_var(cg, t.0) | <->) | <->
   !fresh_local | codegen_check_flag_to_heap_assign(cg, t, ev.0) | 0
   !fresh_local | codegen_check_rebind_type(cg, t.0, ev.1, t.3, t.5) | 0
   !fresh_local | codegen_check_annotated_record_rebind(cg, t, ev.1) | 0
   is_clo = main::is_fn_vt(ev.1) || (expr::is_fnv_t(t.5))
   is_clo && !match::choice_mixed_declared_fns(cg, t.5)
      |
         cg.closure_vars += t.0
         cg.closure_tgts += cg.last_closure_fn
      | 0
   i1t = LLVMInt1Type!
   is_heap = types::is_ram_vt(ev.1) && LLVMTypeOf(ev.0) != i1t ||
      (ev.1 [Enum])
   is_mv = ev.1 [Map, Builder, Fn, Array, Slice]
   is_ptr = is_heap || types::is_record_vt(ev.1) || is_mv
   rm = types::rec_meta(cg, ev.1)
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   llvm_type = is_ptr | i8p | types::llvm_type_of_vt(ev.1)
   is_local = cg.in_fn
   slot = fresh_local
      | types::create_slot(cg, t.0, llvm_type, cg.in_fn)
      |
         types::var_slot(cg, t.0)
            | _
            | types::create_slot(cg, t.0, llvm_type, cg.in_fn)
   store_v = ev.0 != Addr(0) | ev.0 | LLVMConstNull(llvm_type)
   LLVMBuildStore(cg.builder, store_v, slot)
   // A heap ram keeps the declared-type name (its payload type resolves from
   // it); an unwrapped scalar does not — the last_type may name an unrelated
   // typedef (e.g. "#arrread") whose dtype would mis-type later choices.
   is_rec = types::is_record_vt(ev.1)
   rt_name = is_rec | (rm | m => types::typedef_name_of_rt(cg, m.0) | "") | ""
   keep_dt = is_heap || is_rec || types::is_array_vt(ev.1) || types::is_map_vt(ev.1) ||
      types::is_slice_vt(ev.1) || (ev.1 [Fn])
   dtype0 = keep_dt | cg.last_type | ""
   dtype = rt_name != "" | rt_name | dtype0
   rm_fnames = rm | m => m.1 | ast::Names()
   need_fnames = !fresh_local | (is_rec | ?rm_fnames == 0 | <->) | <->
   prior_fnames = need_fnames | types::var_fnames(cg, t.0) | ast::Names()
   use_prior = need_fnames | ?prior_fnames > 0 | <->
   prior_rt = use_prior | types::var_rt(cg, t.0) | <-->
   rm_rt_opt = rm | m => <+ m.0 -> | <-->
   final_rm0_opt = <>(prior_rt) | prior_rt | rm_rt_opt
   final_rm1 = use_prior | prior_fnames | rm_fnames
   final_dt = use_prior | types::var_dtype(cg, t.0) | dtype
   cg.vars += types::CgVar((t.0, ev.1, is_heap, final_dt, final_rm0_opt, final_rm1,
      <+ slot ->, is_local, <->, cg.last_fvts, <-->))
   is_rec_expr = t.5 [Record _]
   is_part = !fresh_local | main::var_partial(cg, t.0) | <->
   is_whole = is_composite_vt(ev.1) | <+> | (is_rec_expr | <+> | is_part)
   is_whole | types::init_mark_whole(cg, t.0) | 0
   is_whole | types::alloc_rec_add(t.0) | 0
   cg.last_type = ""

// A forward annotation can name a heap ram before its first assignment. Do
// not silently turn an i1 Flag into that heap union: the source must spell the
// heap unit (<++> or <-->).
codegen_check_flag_to_heap_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo), Addr => ()
codegen_check_flag_to_heap_assign = cg, t, value =>
   value != Addr(0) | codegen_check_flag_to_heap_value(cg, t, value)

codegen_check_flag_to_heap_value: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo), Addr => ()
codegen_check_flag_to_heap_value = cg, t, value =>
   is_flag = LLVMTypeOf(value) == LLVMInt1Type!
   is_flag | codegen_check_flag_to_known_ram(cg, t)

codegen_check_flag_to_known_ram: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_check_flag_to_known_ram = cg, t =>
   dtype = types::var_dtype(cg, t.0)
   dtype != "" | codegen_check_flag_to_named_heap(cg, t, dtype)

codegen_check_flag_to_named_heap: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   String => ()
codegen_check_flag_to_named_heap = cg, t, dtype =>
   types::typedef_ti(cg, dtype)
      [Ram slots] codegen_check_flag_to_heap_slots(cg, t, slots)

codegen_check_flag_to_heap_slots: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   (ast::RamSlotInfo, ast::RamSlotInfo) => ()
codegen_check_flag_to_heap_slots = cg, t, slots =>
   !types::ram_slots_are_flag(slots)
      | codegen_check_flag_to_heap_expr(cg, t)

codegen_check_flag_to_heap_expr: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_check_flag_to_heap_expr = cg, t =>
   expr_is_bare_flag(t.5)
      | types::init_error(cg, "E3056", "Cannot assign a bare Flag to '" + t.0 +
         "' (a heap ramification). Construct its unit branch explicitly with " +
         "'<++>' or '<-->'.", 0, 0)

ram_type_is_heap: ast::TypeInfo => <>
ram_type_is_heap = ti =>
   ti [Ram slots] !types::ram_slots_are_flag(slots) | <->

expr_is_bare_flag: ast::Expr => <>
expr_is_bare_flag = e =>
   e [Variant v] expr_is_bare_flag_variant(v)
   | <->

expr_is_bare_flag_variant: ast::VariantExpr => <>
expr_is_bare_flag_variant = v =>
   types::ram_tag_is_flag(v.tag_name) | (?v.args == 0) | <->

// A forward annotation fixes a record layout even before a whole value is
// assigned. Rebinding it with a different record shape would make later field
// accesses unsound, so compare the static field ValueTypes before storing.
codegen_check_annotated_record_rebind: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::ValueType => ()
codegen_check_annotated_record_rebind = cg, t, rhs_type =>
   main::var_partial(cg, t.0)
      | codegen_check_annotated_record_rhs(cg, t, rhs_type)

codegen_check_annotated_record_rhs: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::ValueType => ()
codegen_check_annotated_record_rhs = cg, t, rhs_type =>
   bad = !vtypes_same(match::var_fvts(cg, t.0), cg.last_fvts, 0)
   rhs_type [Record] codegen_check_record_bad(cg, t.0, bad)

codegen_check_record_bad: types::Cg, String, <> => ()
codegen_check_record_bad = cg, name, bad =>
   bad | codegen_record_rebind_error(cg, name)

codegen_record_rebind_error: types::Cg, String => ()
codegen_record_rebind_error = cg, name =>
   types::init_error(cg, "E3151", "Cannot assign a Record with a different " +
      "layout to '" + name + "'.", 0, 0)

find_global_var_type: types::Cg, String, Int => ast::ValueType
find_global_var_type = cg, name, i =>
   i < 0
      | ast::ValueType(Unknown)
      |
         v = cg.vars(i)!!
         (v.name == name) && !v.is_local
            | v.vt
            | find_global_var_type(cg, name, i - 1)

codegen_check_rebind_type: types::Cg, String, ast::ValueType, <>, ast::Expr => ()
codegen_check_rebind_type = cg, name, rhs_vt, is_gmut, rhs_expr =>
   cg.in_fn && !is_gmut && !types::has_local_var(cg, name)
      | 0
      |
         target_ti = expr::var_ti(cg, name)
         target_ti [Ram _]
            |
               rhs_ram_ti = expr::codegen_ram_type_of_expr(cg, rhs_expr)
               rhs_ram_ti [Ram _]
                  |
                     !expr::ram_shape_compatible(cg, target_ti, rhs_ram_ti)
                        |
                           types::init_error(cg, "E3089",
                              "Cannot assign ramification of shape " +
                              expr::ram_shape_str(cg, rhs_ram_ti) + " to '" + name +
                              "' (declared as " + expr::ram_shape_str(cg, target_ti) +
                              ").", 0, 0)
                        | 0
                  | 0
            | 0
         prev_vt = is_gmut
            | find_global_var_type(cg, name, ?cg.vars - 1)
            | types::var_type(cg, name)
         prev_vt == ast::ValueType(Unknown) || rhs_vt == ast::ValueType(Unknown)
            | 0
            |
               intish_ok = types::is_int_vt(prev_vt) &&
                  (types::is_int_vt(rhs_vt) || (rhs_vt [RawPtr]))
               ram_ok = prev_vt [Ram] &&
                  (types::is_int_vt(rhs_vt) || (rhs_vt [Ram]) || types::is_record_vt(rhs_vt))
               same = prev_vt == rhs_vt || intish_ok || ram_ok
               same
                  | 0
                  |
                     types::init_error(cg, "E3151", "Cannot assign " +
                        types::value_type_name(rhs_vt) + " to '" + name +
                        "' (bound as " + types::value_type_name(prev_vt) + ").", 0, 0)

vtypes_same: ast::VTypes, ast::VTypes, Int => <>
vtypes_same = left, right, at =>
   nl = ?left
   nr = ?right
   nl != nr
      | <->
      | at == nl
         | <+>
         |
            lv = vtypes_at(left, at)
            rv = vtypes_at(right, at)
            lv == rv && vtypes_same(left, right, at + 1)

// Is an Assign's LHS a member write? ("r.f = v" / "r.0 = v")
lhs_is_member: (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
lhs_is_member = t => t.6 [Member _]

// Is an Assign's RHS a function definition? ("f = x => body")
rhs_is_fn: (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
rhs_is_fn = t => t.5 [Fn _]

member_root_name: ast::Expr => String
member_root_name = e =>
   e
      [Var v] v
      [Member m] member_root_name(m.target)
      | ""

// "r.field = v" / "r.0 = v" — a member write: GEP into the record and store.
codegen_emit_member_assign: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_emit_member_assign = cg, t =>
   m = (t.6 [Member mm] mm | ast::MemberExpr((ast::Expr(Var, ""), "", <->, ast::Expr(Var, ""), 0, 0)))
   root_name = member_root_name(m.target)
   root_vt = types::var_type(cg, root_name)
   root_vt [Str] types::init_error(cg, "E3066", "Cannot write member '" + m.field_name +
      "' of String '" + root_name + "' — Strings are immutable (A1) and have no members. Length is '?s', byte reads are 's(i)', and building goes through a Builder.", 0, 0) | 0
   root_vt [Builder] types::init_error(cg, "E3066", "Cannot write member '" + m.field_name +
      "' of Builder '" + root_name + "' — a Builder's length is '?b' and its buffer is '&b'.", 0, 0) | 0
   cg.error | 0 | member_assign_emit(cg, root_name, m, t)

member_assign_emit: types::Cg, String, ast::MemberExpr, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
member_assign_emit = cg, root_name, m, t =>
   member_assign_emit_valid(cg, root_name, m, t)

record_member_type: types::Cg, String, String => (ast::ValueType, <>)
record_member_type = cg, vname, field =>
   idx = types::member_index(types::var_fnames(cg, vname), field)
   dt = types::var_dtype(cg, vname)
   fvs = match::var_fvts(cg, vname)
   nf = ?fvs
   (idx !< 0) && (idx < nf)
      |
         vt0 = vtypes_at(fvs, idx)
         dt_ti = dt != "" | types::typedef_ti(cg, dt) |
            ast::TypeInfo(Prim, ast::ValueType(Unknown))
         fti = types::record_field_ti(cg, dt_ti, idx)
         fvt_dt = types::vt_from_ti(fti)
         res_vt = fvt_dt != ast::ValueType(Unknown) | fvt_dt | vt0
         (res_vt, <+>)
      | (ast::ValueType(Unknown), <->)

vtypes_at: ast::VTypes, Int => ast::ValueType
vtypes_at = fvs, idx => fvs(idx) | _ | ast::ValueType(Unknown)

member_assign_bitfield: types::Cg, String, ast::MemberExpr,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::BitfieldInfo => ()
member_assign_bitfield = cg, root_name, m, t, bfi =>
   is_var = m.target [Var _]
   !is_var && main::var_partial(cg, root_name) && !types::alloc_rec_has(root_name)
      |
         fvs_sz = ?match::var_fvts(cg, root_name) * 8
         sz_c = types::var_rt(cg, root_name)
            | rt0 => LLVMSizeOf(rt0)
            | LLVMConstInt(LLVMInt64Type!, fvs_sz, 0)
         alloc_p = expr::codegen_call_arena_alloc(cg, sz_c, "record.alloc")
         types::var_slot(cg, root_name)
            | slot => LLVMBuildStore(cg.builder, alloc_p, slot)
            | 0
         types::alloc_rec_add(root_name)
      | 0
   bf_fld = types::find_bitfield_field(bfi.fields, m.field_name)
   bf_fld
      | bf =>
         vname = m.target [Var v] v | ""
         bf_ptr = vname != ""
            | (types::var_slot(cg, vname) | _ | Addr(0))
            | (expr::codegen_eval(cg, m.target)).0
         saved_discard = cg.discard_result
         cg.discard_result = <->
         ev = expr::codegen_eval(cg, t.5)
         cg.discard_result = saved_discard
         !types::is_int_vt(ev.1)
            | types::init_error(cg, "E3152", "Cannot write bitfield member '" +
               m.field_name + "': expected integer, got " +
               types::value_type_name(ev.1) + ".", 0, 0)
            |
               bty = types::llvm_type_of_vt(bfi.backing_type)
               curr = LLVMBuildLoad2(cg.builder, bty, bf_ptr, "bf.cur")
               fmask = (1 .<. bf.bit_width) - 1
               shifted_mask = fmask .<. bf.bit_offset
               cmask = .!. shifted_mask
               cmask_val = LLVMConstInt(bty, cmask, 0)
               cleared = LLVMBuildAnd(cg.builder, curr, cmask_val,
                  "bf.clr")
               v_cast = stmt::coerce_int(cg, ev.0, bty)
               v_masked = LLVMBuildAnd(cg.builder, v_cast,
                  LLVMConstInt(bty, fmask, 0), "bf.val")
               v_shifted = bf.bit_offset > 0
                  | LLVMBuildShl(cg.builder, v_masked,
                     LLVMConstInt(bty, bf.bit_offset, 0), "bf.shl")
                  | v_masked
               new_val = LLVMBuildOr(cg.builder, cleared, v_shifted,
                  "bf.new")
               LLVMBuildStore(cg.builder, new_val, bf_ptr)
               main::var_partial(cg, root_name)
                  |
                     types::init_mark_written(cg, root_name + "." + types::member_fpath(m))
                     im_name = m.target [Member im] im.field_name | ""
                     im_name != ""
                        |
                           types::init_mark_written(cg, root_name + "." + im_name)
                        | 0
                  | 0
      |
         types::init_error(cg, "E3017", "Unknown bitfield member '" +
            m.field_name + "'.", m.line, m.col)


member_assign_emit_valid: types::Cg, String, ast::MemberExpr,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
member_assign_emit_valid = cg, root_name, m, t =>
   target_ti = types::member_target_ti(cg, m.target)
   bf_opt = types::ti_get_bitfield(cg, target_ti)
   bf_opt
      | bfi => member_assign_bitfield(cg, root_name, m, t, bfi)
      | member_assign_record(cg, root_name, m, t)

member_assign_record: types::Cg, String, ast::MemberExpr,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
member_assign_record = cg, root_name, m, t =>
   main::var_partial(cg, root_name) && !types::alloc_rec_has(root_name)
      |
         fvs_sz = ?match::var_fvts(cg, root_name) * 8
         sz_c = types::var_rt(cg, root_name)
            | rt0 => LLVMSizeOf(rt0)
            | LLVMConstInt(LLVMInt64Type!, fvs_sz, 0)
         alloc_p = expr::codegen_call_arena_alloc(cg, sz_c, "record.alloc")
         types::var_slot(cg, root_name)
            | slot => LLVMBuildStore(cg.builder, alloc_p, slot)
            | 0
         types::alloc_rec_add(root_name)
      | 0
   main::var_partial(cg, root_name) | types::init_mark_written(cg, root_name + "." + types::member_fpath(m)) | 0
   target_ev = expr::codegen_eval(cg, m.target)
   is_var = m.target [Var _]
   target_rt_opt = is_var
      | (types::var_rt(cg, root_name) | cg.last_rt)
      | cg.last_rt
   target_rt = target_rt_opt | r => r | Addr(0)
   target_fnames = is_var | types::var_fnames(cg, root_name) | cg.last_fnames
   target_fvts = is_var | match::var_fvts(cg, root_name) | cg.last_fvts
   idx = types::member_index(target_fnames, m.field_name)
   fgep = types::record_field_gep(cg, target_rt, target_fvts, target_ev.0, idx)
   saved_discard = cg.discard_result
   cg.discard_result = <->
   ev = expr::codegen_eval(cg, t.5)
   cg.discard_result = saved_discard
   is_un = ev.1 [Unit]
   is_un
      |
         types::init_error(cg, "E3032", "Cannot assign Void expression to member '" +
            m.field_name + "'.", 0, 0)
      |
         types::is_view_expr(cg, t.5)
            | types::init_error(cg, "E3150", "View cannot escape function frame", 0, 0)
            | 0
         f_vt = idx < 0 | ast::ValueType(Unknown) |
            (target_fvts(idx) | _ | ast::ValueType(Unknown))
         rec_ok = f_vt == ast::ValueType(Record) &&
            ev.1 == ast::ValueType(Record)
         flag_int_ok = f_vt == ast::ValueType(Flag) && types::is_int_vt(ev.1)
         field_bad = f_vt != ast::ValueType(Unknown) &&
            ev.1 != ast::ValueType(Unknown) &&
            !(types::is_int_vt(f_vt) && types::is_int_vt(ev.1)) &&
            !(f_vt == ast::ValueType(Ram) && ev.1 == ast::ValueType(Ram)) &&
            !rec_ok && !flag_int_ok && f_vt != ev.1
         field_bad
            |
               types::init_error(cg, "E3152", "Cannot write member '" + m.field_name +
                  "': the field holds " + types::value_type_name(f_vt) + ", got " +
                  types::value_type_name(ev.1) + ".", 0, 0)
            |
               is_rec_ev = ev.1 [Record]
               is_rec_ev
                  |
                     target_ft = LLVMStructGetTypeAtIndex(target_rt, idx)
                     inner_sz = LLVMSizeOf(target_ft)
                     LLVMBuildMemCpy(cg.builder, fgep, 1, ev.0, 1,
                        inner_sz, 0)
                  |
                     flag_int_ok
                        |
                           c_val = LLVMBuildICmp(cg.builder, 33, ev.0,
                              LLVMConstInt(LLVMTypeOf(ev.0), 0, 0),
                              "flag.cast")
                           LLVMBuildStore(cg.builder, c_val, fgep)
                        |
                           LLVMBuildStore(cg.builder, ev.0, fgep)

// "@[addr] = expr" — raw stores use the value's natural integer/pointer
// width. Floats and ramifications have no raw-memory slot representation.
codegen_emit_raw_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::RawMemoryExpr => ()
codegen_emit_raw_assign = cg, t, rm =>
   rm.load_type
      [Unknown] codegen_emit_raw_assign_untyped(cg, t, rm)
      |
         types::init_error(cg, "E2093", "Cannot assign to a typed load; write through " +
            "the untyped '@[addr]' form instead.", 0, 0)

codegen_emit_raw_assign_untyped: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::RawMemoryExpr => ()
codegen_emit_raw_assign_untyped = cg, t, rm =>
   saved_discard = cg.discard_result
   cg.discard_result = <->
   ev = expr::codegen_eval(cg, t.5)
   cg.discard_result = saved_discard
   types::is_int_vt(ev.1)
      | codegen_emit_raw_assign_value(cg, t, rm, ev)
      | codegen_emit_raw_assign_pointer_value(cg, t, rm, ev)

codegen_emit_raw_assign_pointer_value: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::RawMemoryExpr, (Addr, ast::ValueType) => ()
codegen_emit_raw_assign_pointer_value = cg, t, rm, ev =>
   ev.1 [Str, RawPtr, Error] codegen_emit_raw_assign_value(cg, t, rm, ev)
      | types::init_error(cg, "E3142", "Raw memory write '@[addr] = expr' requires " +
         "an integerish or pointer value, got Float", 0, 0)

codegen_emit_raw_assign_value: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::RawMemoryExpr, (Addr, ast::ValueType) => ()
codegen_emit_raw_assign_value = cg, t, rm, ev =>
   av = expr::codegen_eval(cg, rm.addr)
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   raw_addr = types::raw_addr_value(cg, av.0, av.1, i8p)
   elem_ty = raw_store_elem_type(ev.1, i8p)
   elem_ptr = LLVMBuildPointerCast(cg.builder, raw_addr,
      LLVMPointerType(elem_ty, 0), "raw.ptr.w")
   LLVMBuildStore(cg.builder, ev.0, elem_ptr)


raw_store_elem_type: ast::ValueType, Addr => Addr
raw_store_elem_type = vt, i8p =>
   vt [Str, RawPtr, Error] i8p | types::llvm_type_of_vt(vt)

codegen_emit_record_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::CallExpr => ()
codegen_emit_record_assign = cg, t, call =>
   vname = types::resolve_var_name(cg, call.fn_name)
   fvs = match::var_fvts(cg, vname)
   elem_vt = ?fvs > 0 | (fvs(0) | _ | ast::ValueType(Unknown)) |
      ast::ValueType(Unknown)
   elem_ll_type_raw = types::var_rt(cg, vname)
      | rt => LLVMStructGetTypeAtIndex(rt, 0)
      | types::llvm_type_of_vt(elem_vt)
   elem_ll_type = elem_ll_type_raw == Addr(0)
      | LLVMInt64Type!
      | elem_ll_type_raw
   av = call.args(0)!!
   idx_ev = expr::codegen_eval(cg, av)
   rhs_ev = expr::codegen_eval(cg, t.5)
   is_un = rhs_ev.1 [Unit]
   is_un
      |
         types::init_error(cg, "E3032", "Cannot assign Void expression to element of '" +
            call.fn_name + "'.", 0, 0)
      |
         main::codegen_emit_index_bounds_check(cg, idx_ev.0, idx_ev.1, ?fvs)
         idx_i64 = main::codegen_widen_idx_to_i64(cg, idx_ev.0, idx_ev.1, "idx")
         base_ptr = types::ptr_var_value_plain(cg, vname, "rec.ptr")
         typed_arr = LLVMBuildPointerCast(cg.builder, base_ptr,
            LLVMPointerType(elem_ll_type, 0), "rec.typed")
         elem_gep = types::gep1(cg, elem_ll_type, typed_arr, idx_i64, "rec.elem.gep")
         cval = stmt::coerce_int(cg, rhs_ev.0, elem_ll_type)
         LLVMBuildStore(cg.builder, cval, elem_gep)

slice_elem_vt: types::Cg, String => ast::ValueType
slice_elem_vt = cg, name =>
   fvs = match::var_fvts(cg, name)
   first_vt = ?fvs > 0 | (fvs(0) | _ | ast::ValueType(Int)) | ast::ValueType(Int)
   first_vt [Slice] ast::ValueType(Int) | first_vt

codegen_emit_slice_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::CallExpr => ()
codegen_emit_slice_assign = cg, t, call =>
   av = call.args(0)!!
   idx_ev = expr::codegen_eval(cg, av)
   rhs_ev = expr::codegen_eval(cg, t.5)
   is_un = rhs_ev.1 [Unit]
   is_un
      |
         types::init_error(cg, "E3032", "Cannot assign Void expression to element of '" +
            call.fn_name + "'.", 0, 0)
      |
         sv = types::ptr_var_value_plain(cg, call.fn_name, "rec.ptr")
         data = main::slice_data(cg, sv, "slice.data")
         elem_vt = slice_elem_vt(cg, call.fn_name)
         elem_ll = types::is_ptrish_vt(elem_vt)
            | LLVMPointerType(LLVMInt8Type!, 0)
            | types::llvm_type_of_vt(elem_vt)
         typed_data = LLVMBuildPointerCast(cg.builder, data,
            LLVMPointerType(elem_ll, 0), "slice.data.typed")
         idx_i64 = main::codegen_widen_idx_to_i64(cg, idx_ev.0, idx_ev.1, "idx")
         slot2 = types::gep1(cg, elem_ll, typed_data, idx_i64, "slice.elem.gep")
         cval = stmt::coerce_int(cg, rhs_ev.0, elem_ll)
         LLVMBuildStore(cg.builder, cval, slot2)

codegen_emit_array_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::CallExpr => ()
codegen_emit_array_assign = cg, t, call =>
   i64t = LLVMInt64Type!
   av = call.args(0)!!
   idx_ev = expr::codegen_eval(cg, av)
   rhs_ev = expr::codegen_eval(cg, t.5)
   is_un = rhs_ev.1 [Unit]
   is_un
      |
         types::init_error(cg, "E3032", "Cannot assign Void expression to element of '" +
            call.fn_name + "'.", 0, 0)
      |
         aval = types::ptr_var_value_plain(cg, call.fn_name, "rec.ptr")
         elem_vt = main::array_elem_vt(cg, call.fn_name)
         idx_i64 = main::codegen_widen_idx_to_i64(cg, idx_ev.0, idx_ev.1, "idx")
         data = main::builder_data(cg, aval, "a.wr.data")
         slot = types::gep1(cg, i64t, data, idx_i64, "a.elem.gep")
         val_st = types::is_ptrish_vt(elem_vt)
            | LLVMBuildPtrToInt(cg.builder, rhs_ev.0, i64t, "a.wr.p2i")
            | stmt::coerce_int(cg, rhs_ev.0, i64t)
         LLVMBuildStore(cg.builder, val_st, slot)

// Indexed assignment through a call target: arr(i) = v or sl(i) = v.
codegen_emit_call_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::CallExpr => ()
codegen_emit_call_assign = cg, t, call =>
   vt = types::var_type(cg, call.fn_name)
   is_str = main::is_str_var(cg, call.fn_name) || (vt [Builder])
   is_str
      |
         types::init_error(cg, "E3067", "Cannot write through a String call-target '" +
            call.fn_name + "(...)' — Strings are immutable and a Builder is " +
            "written with 'b + c'.", 0, 0)
      |
         is_hetero = stmt::is_heterogeneous_record_var(cg, call.fn_name)
         is_hetero
            |
               types::init_error(cg, "E3051", "Dynamic indexing is only allowed on " +
                  "homogeneous records.", 0, 0)
            |
               is_rec = types::is_record_vt(vt)
               is_sl = main::is_slice_var(cg, call.fn_name)
               is_arr = main::is_array_var(cg, call.fn_name) || (vt [Array])
               is_dotted = types::find_dot(call.fn_name, 0) > 0
               not_init = !is_dotted && !types::var_has_storage(cg, call.fn_name)
               is_sl && (not_init || main::var_partial(cg, call.fn_name))
                  | types::init_error(cg, "E3049", "Cannot write element of " +
                     "forward-annotated slice '" + call.fn_name +
                     "' before whole-value initialization.", 0, 0)
                  |
                     is_rec && (not_init || main::var_partial(cg, call.fn_name))
                        | types::init_error(cg, "E3131", "Homogeneous record '" +
                           call.fn_name + "' requires whole-value " +
                           "initialization before element access.", 0, 0)
                        |
                           ?call.args != 1
                              | types::init_error(cg, "E3029", "Record/Slice index " +
                                 "assignment expects exactly 1 argument, got " +
                                 str::from_int(?call.args) + ".", 0, 0)
                              |
                                 is_rec
                                    | codegen_emit_record_assign(cg, t, call)
                                    | is_sl
                                       | codegen_emit_slice_assign(cg, t, call)
                                       | is_arr
                                          |
                                             codegen_emit_array_assign(cg,
                                                t, call)
                                          | 0

// "#exit code" — truncate to i32, destroy the global arena, call exit(code),
// park the builder at a fresh dead block so subsequent emission (including
// main's destroy+ret epilogue) stays valid.
codegen_emit_exit: types::Cg, ast::ExitExpr => ()
codegen_emit_exit = cg, e =>
   ev = expr::codegen_eval(cg, e.code)
   types::is_int_vt(ev.1)
      |
         i32t = LLVMInt32Type!
         tr = LLVMBuildTrunc(cg.builder, ev.0, i32t, "exit.code")
         cg.opts.no_runtime
            |
               code_g = LLVMAddGlobal(cg.module, i32t, "dva_exit_code")
               LLVMSetInitializer(code_g, LLVMConstInt(i32t, 0, 0))
               LLVMBuildStore(cg.builder, tr, code_g)
               LLVMBuildUnreachable(cg.builder)
               cg.exited = <+>
               dead' = LLVMAppendBasicBlock(cg.current_fn, "exit.halt")
               LLVMPositionBuilderAtEnd(cg.builder, dead')
            |
               emit_arena_destroy(cg)
               eargs = {16}
               esb = &eargs
               @[esb] = tr
               LLVMBuildCall2(cg.builder, cg.exit_t, cg.exit_fn, esb, 1,
                  "")
               LLVMBuildUnreachable(cg.builder)
               cg.exited = <+>
               dead' = LLVMAppendBasicBlock(cg.current_fn, "exit.done")
               LLVMPositionBuilderAtEnd(cg.builder, dead')
      |
         types::init_error(cg, "E3172", "'#exit' expects an integerish status code", 0, 0)


codegen_emit_stmt: types::Cg, ast::Expr => ()
codegen_emit_stmt = cg, e =>
   e
      [Assign t] codegen_emit_assign(cg, t)
      [Exit t] codegen_emit_exit(cg, t)
      [TypeDecl t] add_type(cg, t.name, t.type_info)
      [Block b] codegen_emit_stmts(cg, b.exprs)
      [Foreign f] stmt::codegen_emit_foreign_var(cg, f)
      | expr::codegen_eval(cg, e); 0

// Registers a '#type' name + TypeInfo (a pass-through constructor target and
// payload-type source). A helper (not an inline member '+=', which does not
// parse in a choice branch body).
update_type_ti: types::Cg, String, ast::TypeInfo => ()
update_type_ti = cg, name, ti =>
   indices = cg.type_indices
   idx = indices ^ name | _ | -1
   idx !< 0
      |
         td = cg.typedefs(idx)!!
         cg.typedefs(idx) = types::TypeDef((name, ti, td.rt, td.fnames)) !| _

update_type_rec: types::Cg, String, ast::TypeInfo, Addr, ast::Names => ()
update_type_rec = cg, name, ti, rt, fnames =>
   indices = cg.type_indices
   idx = indices ^ name | _ | -1
   idx !< 0
      | cg.typedefs(idx) = types::TypeDef((name, ti, rt, fnames)) !| _

push_typedef: types::Cg, types::TypeDef => ()
push_typedef = cg, td =>
   indices = cg.type_indices
   indices ^ (td.name) = ?cg.typedefs
   cg.typedefs += td

add_type: types::Cg, String, ast::TypeInfo => ()
add_type = cg, name, ti =>
   types::has_type_name(cg, name)
      | update_type_ti(cg, name, ti)
      | push_typedef(cg, types::TypeDef((name, ti, Addr(0), ast::Names())))

add_type_rec: types::Cg, String, ast::TypeInfo, Addr, ast::Names => ()
add_type_rec = cg, name, ti, rt, fnames =>
   types::has_type_name(cg, name)
      | update_type_rec(cg, name, ti, rt, fnames)
      | push_typedef(cg, types::TypeDef((name, ti, rt, fnames)))

codegen_emit_stmts: types::Cg, ast::Exprs => ()
codegen_emit_stmts = cg, stmts =>
   ?stmts @ i =>
      e = stmts(i)!!
      saved_module = cg.current_module
      e
         [Assign t] cg.current_module = types::decl_module(t.0, 0)
         [TypeDecl t] cg.current_module = types::decl_module(t.name, 0)
         | 0
      cg.error | 0 | codegen_emit_stmt(cg, e)
      cg.current_module = saved_module

codegen_register_global_ctor: types::Cg, Addr => ()
codegen_register_global_ctor = cg, fn =>
   i32t = LLVMInt32Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   buf3 = {24}
   sb3 = &buf3
   @[sb3] = i32t
   @[sb3 + 8] = i8p
   @[sb3 + 16] = i8p
   ctor_struct_type = LLVMStructType(sb3, 3, 0)
   vbuf = {24}
   svbuf = &vbuf
   @[svbuf] = LLVMConstInt(i32t, 65535, 0)
   @[svbuf + 8] = fn
   @[svbuf + 16] = LLVMConstNull(i8p)
   ctor_const = LLVMConstStruct(svbuf, 3, 0)
   cbuf = {8}
   scbuf = &cbuf
   @[scbuf] = ctor_const
   ctor_array = LLVMConstArray2(ctor_struct_type, scbuf, 1)
   gv = LLVMAddGlobal(cg.module, LLVMTypeOf(ctor_array), "llvm.global_ctors")
   LLVMSetLinkage(gv, 7)
   LLVMSetInitializer(gv, ctor_array)

// Finish: ret i32 0 or ret void in __dva_global_init, verify and print module.
codegen_finish: types::Cg, String => ()
codegen_finish = cg, out_path =>
   !cg.opts.no_runtime && !cg.opts.no_main | emit_arena_destroy(cg) | 0
   cg.opts.no_main
      |
         LLVMBuildRetVoid(cg.builder)
         codegen_register_global_ctor(cg, cg.main_fn)
      |
         LLVMBuildRet(cg.builder, LLVMConstInt(LLVMInt32Type!, 0, 0))
   ar = mem::arena(1024)
   err_buf = mem::alloc(ar, 8)
   @[err_buf] = Addr(0)
   tmp_out = out_path + ".tmp"
   p_res = LLVMPrintModuleToFile(cg.module, tmp_out, err_buf)
   v_err_buf = mem::alloc(ar, 8)
   @[v_err_buf] = Addr(0)
   v_res = LLVMVerifyModule(cg.module, 2, v_err_buf)
   v_res != 0
      |
         v_msg = @[v_err_buf Addr]
         v_msg != Addr(0)
            |
               v_str = c_str(v_msg)
               print $ "E5011: LLVM module verification failed: " + v_str
               LLVMDisposeMessage(v_msg)
            |
               print $ "E5011: LLVM module verification failed"
         cg.error = <+>
      |
         p_res != 0
            |
               err_msg = @[err_buf Addr]
               err_msg != Addr(0)
                  |
                     err_str = c_str(err_msg)
                     print $ "E5012: Failed to write LLVM IR to '" + out_path +
                        "': " + err_str
                     LLVMDisposeMessage(err_msg)
                  |
                     print $ "E5012: Failed to write LLVM IR to '" + out_path + "'"
               cg.error = <+>
            |
               r = rename(tmp_out, out_path)
               r != 0
                  |
                     print $ "E5012: Failed to publish LLVM IR to '" + out_path + "'"
                     unlink(tmp_out)
                     cg.error = <+>
                  | 0
   mem::destroy(ar)

// call void @dva_arena_destroy(ptr @global_arena) before a function returns.
emit_arena_destroy: types::Cg => ()
emit_arena_destroy = cg =>
   at = arena_type(cg)
   atp = LLVMPointerType(at, 0)
   dest_t = types::fn_type1(LLVMVoidType!, atp)
   dest_fn = LLVMGetNamedFunction(cg.module, "dva_arena_destroy")
   ga = LLVMGetNamedGlobal(cg.module, "global_arena")
   dargs = {16}
   sb = &dargs
   @[sb] = ga
   LLVMBuildCall2(cg.builder, dest_t, dest_fn, sb, 1, "")

// --- maps (slice 17) ---------------------------------------------------------

// The map struct: { i64 count, i64 cap, ptr keys, ptr vals, ptr states }.
map_struct_type: types::Cg => Addr
map_struct_type = cg =>
   i64t = LLVMInt64Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   tarr = types::Addrs()
   tarr += i64t
   tarr += i64t
   tarr += i8p
   tarr += i8p
   tarr += i8p
   types::struct_type_n(cg, tarr, 5)

// The (cap, keys, vals, states) fields of a map value.
map_fields: types::Cg, Addr => (Addr, Addr, Addr, Addr)
map_fields = cg, m =>
   mt = map_struct_type(cg)
   cap = LLVMBuildLoad2(cg.builder, LLVMInt64Type!,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap"), "m.cap")
   keys = LLVMBuildLoad2(cg.builder, LLVMPointerType(LLVMInt8Type!, 0),
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.keys"), "m.keys")
   vals = LLVMBuildLoad2(cg.builder, LLVMPointerType(LLVMInt8Type!, 0),
      LLVMBuildStructGEP2(cg.builder, mt, m, 3, "m.vals"), "m.vals")
   states = LLVMBuildLoad2(cg.builder, LLVMPointerType(LLVMInt8Type!, 0),
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.states"), "m.states")
   (cap, keys, vals, states)

// An empty map: an arena-backed { count, cap, keys, vals, states } with cap 8.
codegen_map_create: types::Cg, String => Addr
codegen_map_create = cg, name =>
   mt = map_struct_type(cg)
   i64t = LLVMInt64Type!
   m = expr::codegen_call_arena_alloc(cg,
      LLVMConstInt(i64t, 40, 0), name)
   zero = LLVMConstInt(i64t, 0, 0)
   cap = LLVMConstInt(i64t, 8, 0)
   key_bytes = LLVMBuildMul(cg.builder, cap,
      LLVMConstInt(i64t, 8, 0), "m.keys.bytes")
   val_bytes = LLVMBuildMul(cg.builder, cap,
      LLVMConstInt(i64t, 8, 0), "m.vals.bytes")
   kb = expr::codegen_call_arena_alloc(cg, key_bytes, "m.keys")
   vb = expr::codegen_call_arena_alloc(cg, val_bytes, "m.vals")
   sb = expr::codegen_call_arena_alloc(cg, cap, "m.states")
   LLVMBuildMemSet(cg.builder, sb, LLVMConstInt(LLVMInt8Type!, 0, 0), cap, 1)
   LLVMBuildStore(cg.builder, zero,
      LLVMBuildStructGEP2(cg.builder, mt, m, 0, "m.count.gep"))
   LLVMBuildStore(cg.builder, cap,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap.gep"))
   LLVMBuildStore(cg.builder, kb,
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.keys.gep"))
   LLVMBuildStore(cg.builder, vb,
      LLVMBuildStructGEP2(cg.builder, mt, m, 3, "m.vals.gep"))
   LLVMBuildStore(cg.builder, sb,
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.states.gep"))
   m

// // FNV-1a of a String key via dva_hash_string(data, len), or Knuth/splitmix
// multiplication for integer/pointer keys.
codegen_map_hash: types::Cg, Addr, ast::ValueType => Addr
codegen_map_hash = cg, key_val, key_vt =>
   is_int = types::is_int_vt(key_vt)
   is_int
      |
         i64t' = LLVMInt64Type!
         mix' = LLVMConstInt(i64t', 0 - 7046029254386353131, 0)
         LLVMBuildMul(cg.builder, key_val, mix', "mk.hash")
      |
         is_ptr = key_vt [RawPtr]
         is_ptr
            |
               i64t' = LLVMInt64Type!
               mix' = LLVMConstInt(i64t', 0 - 7046029254386353131, 0)
               k = LLVMBuildPtrToInt(cg.builder, key_val, i64t', "mk.ptr")
               LLVMBuildMul(cg.builder, k, mix', "mk.hash")
            |
               data = expr::codegen_string_data(cg, key_val, "mk.data")
               len = expr::codegen_string_len(cg, key_val, "mk.len")
               i64t' = LLVMInt64Type!
               i8p = LLVMPointerType(LLVMInt8Type!, 0)
               hash_t = types::fn_type2(cg, i64t', i8p, i64t')
               hash_fn = LLVMGetNamedFunction(cg.module,
                  "dva_hash_string")
               hargs = {16}
               sb = &hargs
               @[sb] = data
               @[sb + 8] = len
               LLVMBuildCall2(cg.builder, hash_t, hash_fn, sb, 2,
                  "hash.str")

// Native maps compare String keys directly: both lengths are loaded before a
// single memcmp, rather than using the general short-circuit String equality
// expression lowering. The direct shape matters inside a probe loop.
codegen_map_string_key_equal: types::Cg, Addr, Addr => Addr
codegen_map_string_key_equal = cg, slot, key_val =>
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   stored = LLVMBuildLoad2(cg.builder, i8p, slot, "mk.stored")
   stored_len = expr::codegen_string_len(cg, stored, "mk.slen")
   stored_data = expr::codegen_string_data(cg, stored, "mk.sdata")
   new_len = expr::codegen_string_len(cg, key_val, "mk.nlen")
   new_data = expr::codegen_string_data(cg, key_val, "mk.ndata")
   lengths_equal = LLVMBuildICmp(cg.builder, 32, stored_len, new_len,
      "mk.lenseq")
   compared = types::call3(cg, cg.memcmp_t, cg.memcmp_fn, stored_data, new_data,
      new_len, "mk.memcmp")
   equal = LLVMBuildICmp(cg.builder, 32, compared,
      LLVMConstInt(LLVMInt32Type!, 0, 0), "mk.cmpeq")
   LLVMBuildAnd(cg.builder, lengths_equal, equal, "mk.eq")

codegen_map_key_equal: types::Cg, Addr, Addr, ast::ValueType => Addr
codegen_map_key_equal = cg, slot, key_val, key_vt =>
   is_int = types::is_int_vt(key_vt)
   is_int
      |
         i64t' = LLVMInt64Type!
         stored' = LLVMBuildLoad2(cg.builder, i64t', slot, "mk.stored")
         LLVMBuildICmp(cg.builder, 32, stored', key_val, "mk.eq")
      |
         is_ptr = key_vt [RawPtr]
         is_ptr
            |
               i64t' = LLVMInt64Type!
               i8p = LLVMPointerType(LLVMInt8Type!, 0)
               stored' = LLVMBuildLoad2(cg.builder, i8p, slot,
                  "mk.stored")
               si = LLVMBuildPtrToInt(cg.builder, stored', i64t',
                  "mk.stored.i")
               ki = LLVMBuildPtrToInt(cg.builder, key_val, i64t',
                  "mk.key.i")
               LLVMBuildICmp(cg.builder, 32, si, ki, "mk.eq")
            | codegen_map_string_key_equal(cg, slot, key_val)

// Insert or rebind a key with an i64 value, without resizing.
codegen_map_insert_raw: types::Cg, Addr, Addr, Addr, ast::ValueType => ()
codegen_map_insert_raw = cg, m, key_val, val_val, key_vt =>
   i64t = LLVMInt64Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   mt = map_struct_type(cg)
   mf = map_fields(cg, m)
   hash = codegen_map_hash(cg, key_val, key_vt)
   one = LLVMConstInt(i64t, 1, 0)
   capm1 = LLVMBuildSub(cg.builder, mf.0, one, "m.capm1")
   idx0 = LLVMBuildAnd(cg.builder, hash, capm1, "m.idx0")
   cur = LLVMGetInsertBlock(cg.builder)
   loop = LLVMAppendBasicBlock(cg.current_fn, "m.loop")
   occ_bb = LLVMAppendBasicBlock(cg.current_fn, "m.found")
   empty_bb = LLVMAppendBasicBlock(cg.current_fn, "m.empty")
   done = LLVMAppendBasicBlock(cg.current_fn, "m.done")
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, loop)
   idx_phi = LLVMBuildPhi(cg.builder, i64t, "m.idx")
   stmt::llvm_add_incoming1(cg, idx_phi, idx0, cur)
   state_gep = types::gep1(cg, LLVMInt8Type!, mf.3, idx_phi, "m.state.gep")
   state = LLVMBuildLoad2(cg.builder, LLVMInt8Type!, state_gep,
      "m.state")
   is_empty = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 0, 0), "m.is.empty")
   is_tomb = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 2, 0), "m.is.tomb")
   is_free = LLVMBuildOr(cg.builder, is_empty, is_tomb, "m.is.free")
   LLVMBuildCondBr(cg.builder, is_free, empty_bb, occ_bb)
   LLVMPositionBuilderAtEnd(cg.builder, occ_bb)
   key_slot = types::gep1(cg, i8p, mf.1, idx_phi, "m.key.slot")
   eq = codegen_map_key_equal(cg, key_slot, key_val, key_vt)
   next = LLVMAppendBasicBlock(cg.current_fn, "m.next")
   overwrite = LLVMAppendBasicBlock(cg.current_fn, "m.overwrite")
   LLVMBuildCondBr(cg.builder, eq, overwrite, next)
   LLVMPositionBuilderAtEnd(cg.builder, overwrite)
   LLVMBuildStore(cg.builder, val_val,
      types::gep1(cg, i64t, mf.2, idx_phi, "m.val.slot"))
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, next)
   idx_next = LLVMBuildAnd(cg.builder,
      LLVMBuildAdd(cg.builder, idx_phi, one, "m.idx.add"), capm1,
      "m.idx.next")
   stmt::llvm_add_incoming1(cg, idx_phi, idx_next, next)
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, empty_bb)
   LLVMBuildStore(cg.builder, key_val,
      types::gep1(cg, i8p, mf.1, idx_phi, "m.key.slot"))
   LLVMBuildStore(cg.builder, val_val,
      types::gep1(cg, i64t, mf.2, idx_phi, "m.val.slot"))
   LLVMBuildStore(cg.builder,
      LLVMConstInt(LLVMInt8Type!, 1, 0), state_gep)
   count_p = LLVMBuildStructGEP2(cg.builder, mt, m, 0, "m.count")
   count = LLVMBuildLoad2(cg.builder, i64t, count_p, "m.count")
   count_next = LLVMBuildAdd(cg.builder, count, one, "m.count.next")
   LLVMBuildStore(cg.builder, count_next,
      LLVMBuildStructGEP2(cg.builder, mt, m, 0, "m.count.gep"))
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, done)

// Double capacity and reinsert every occupied slot. The old arena buffers are
// intentionally retained; only the map header is mutated to point at the new
// hash table, matching the native arena ownership model.
codegen_map_grow: types::Cg, Addr, ast::ValueType => ()
codegen_map_grow = cg, m, key_vt =>
   i64t = LLVMInt64Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   mt = map_struct_type(cg)
   old_cap = LLVMBuildLoad2(cg.builder, i64t,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.old.cap"),
      "m.old.cap")
   old_keys = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.old.keys"),
      "m.old.keys")
   old_vals = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 3, "m.old.vals"),
      "m.old.vals")
   old_states = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.old.states"),
      "m.old.states")
   two = LLVMConstInt(i64t, 2, 0)
   zero = LLVMConstInt(i64t, 0, 0)
   one = LLVMConstInt(i64t, 1, 0)
   new_cap = LLVMBuildMul(cg.builder, old_cap, two, "m.new.cap")
   key_bytes = LLVMBuildMul(cg.builder, new_cap,
      LLVMConstInt(i64t, 8, 0), "m.gk.bytes")
   new_keys = expr::codegen_call_arena_alloc(cg, key_bytes, "m.gk")
   val_bytes = LLVMBuildMul(cg.builder, new_cap,
      LLVMConstInt(i64t, 8, 0), "m.gv.bytes")
   new_vals = expr::codegen_call_arena_alloc(cg, val_bytes, "m.gv")
   new_states = expr::codegen_call_arena_alloc(cg, new_cap, "m.gs")
   LLVMBuildMemSet(cg.builder, new_states,
      LLVMConstInt(LLVMInt8Type!, 0, 0), new_cap, 1)
   LLVMBuildStore(cg.builder, new_cap,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap.gep"))
   LLVMBuildStore(cg.builder, new_keys,
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.keys.gep"))
   LLVMBuildStore(cg.builder, new_vals,
      LLVMBuildStructGEP2(cg.builder, mt, m, 3, "m.vals.gep"))
   LLVMBuildStore(cg.builder, new_states,
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.states.gep"))
   LLVMBuildStore(cg.builder, zero,
      LLVMBuildStructGEP2(cg.builder, mt, m, 0, "m.count.gep"))
   start = LLVMGetInsertBlock(cg.builder)
   loop = LLVMAppendBasicBlock(cg.current_fn, "m.re.loop")
   body = LLVMAppendBasicBlock(cg.current_fn, "m.re.body")
   cont = LLVMAppendBasicBlock(cg.current_fn, "m.re.cont")
   done = LLVMAppendBasicBlock(cg.current_fn, "m.re.done")
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, loop)
   i = LLVMBuildPhi(cg.builder, i64t, "m.re.i")
   stmt::llvm_add_incoming1(cg, i, zero, start)
   more = LLVMBuildICmp(cg.builder, 40, i, old_cap, "m.re.lt")
   LLVMBuildCondBr(cg.builder, more, body, done)
   LLVMPositionBuilderAtEnd(cg.builder, body)
   state = LLVMBuildLoad2(cg.builder, LLVMInt8Type!,
      types::gep1(cg, LLVMInt8Type!, old_states, i, "m.re.state.gep"),
      "m.re.state")
   occupied = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 1, 0), "m.re.occ")
   ins = LLVMAppendBasicBlock(cg.current_fn, "m.re.ins")
   LLVMBuildCondBr(cg.builder, occupied, ins, cont)
   LLVMPositionBuilderAtEnd(cg.builder, ins)
   key_slot = types::gep1(cg, i8p, old_keys, i, "m.re.key.slot")
   val_slot = types::gep1(cg, i64t, old_vals, i, "m.re.val.slot")
   key = types::is_int_vt(key_vt)
      | LLVMBuildLoad2(cg.builder, i64t, key_slot, "m.re.key")
      | LLVMBuildLoad2(cg.builder, i8p, key_slot, "m.re.key")
   val = LLVMBuildLoad2(cg.builder, i64t, val_slot, "m.re.val")
   codegen_map_insert_raw(cg, m, key, val, key_vt)
   LLVMBuildBr(cg.builder, cont)
   LLVMPositionBuilderAtEnd(cg.builder, cont)
   next = LLVMBuildAdd(cg.builder, i, one, "m.re.i.next")
   stmt::llvm_add_incoming1(cg, i, next, cont)
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, done)

// Grow at load factor 0.75, then perform the normal probe/insert.
codegen_map_insert: types::Cg, Addr, Addr, Addr, ast::ValueType => ()
codegen_map_insert = cg, m, key_val, val_val, key_vt =>
   i64t = LLVMInt64Type!
   mt = map_struct_type(cg)
   count = LLVMBuildLoad2(cg.builder, i64t,
      LLVMBuildStructGEP2(cg.builder, mt, m, 0, "m.count"), "m.count")
   cap = LLVMBuildLoad2(cg.builder, i64t,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap"), "m.cap")
   one = LLVMConstInt(i64t, 1, 0)
   lhs = LLVMBuildMul(cg.builder,
      LLVMBuildAdd(cg.builder, count, one, "m.c.plus"),
      LLVMConstInt(i64t, 4, 0), "m.c.lhs")
   rhs = LLVMBuildMul(cg.builder, cap,
      LLVMConstInt(i64t, 3, 0), "m.c.rhs")
   need = LLVMBuildICmp(cg.builder, 38, lhs, rhs, "m.need.grow")
   grow = LLVMAppendBasicBlock(cg.current_fn, "m.grow")
   ins = LLVMAppendBasicBlock(cg.current_fn, "m.ins")
   LLVMBuildCondBr(cg.builder, need, grow, ins)
   LLVMPositionBuilderAtEnd(cg.builder, grow)
   codegen_map_grow(cg, m, key_vt)
   LLVMBuildBr(cg.builder, ins)
   LLVMPositionBuilderAtEnd(cg.builder, ins)
   codegen_map_insert_raw(cg, m, key_val, val_val, key_vt)

// A lookup returns `< value | Error >`: it allocates one result union before
// probing, skips tombstones, and writes either a boxed value or E4013 Error.
codegen_map_lookup: types::Cg, Addr, Addr, ast::ValueType, ast::ValueType,
   Int, Int => Addr
codegen_map_lookup = cg, m, key_val, key_vt, val_vt, line, col =>
   i64t = LLVMInt64Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   mt = map_struct_type(cg)
   result = expr::codegen_call_arena_alloc(cg,
      LLVMConstInt(i64t, 16, 0), "m.rd.alloc")
   tag_gep = LLVMBuildStructGEP2(cg.builder, cg.union_t, result, 0,
      "m.rd.tag.gep")
   pay_gep = LLVMBuildStructGEP2(cg.builder, cg.union_t, result, 1,
      "m.rd.pay.gep")
   cap = LLVMBuildLoad2(cg.builder, i64t,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap"), "m.cap")
   keys = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.keys"), "m.keys")
   vals = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 3, "m.vals"), "m.vals")
   states = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.states"), "m.states")
   hash = codegen_map_hash(cg, key_val, key_vt)
   one = LLVMConstInt(i64t, 1, 0)
   zero = LLVMConstInt(i64t, 0, 0)
   capm1 = LLVMBuildSub(cg.builder, cap, one, "m.capm1")
   idx0 = LLVMBuildAnd(cg.builder, hash, capm1, "m.idx0")
   cur = LLVMGetInsertBlock(cg.builder)
   loop = LLVMAppendBasicBlock(cg.current_fn, "m.rd.loop")
   probe = LLVMAppendBasicBlock(cg.current_fn, "m.rd.probe")
   found_bb = LLVMAppendBasicBlock(cg.current_fn, "m.rd.found")
   next = LLVMAppendBasicBlock(cg.current_fn, "m.rd.next")
   miss_bb = LLVMAppendBasicBlock(cg.current_fn, "m.rd.miss")
   done = LLVMAppendBasicBlock(cg.current_fn, "m.rd.done")
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, loop)
   idx_phi = LLVMBuildPhi(cg.builder, i64t, "m.rd.idx")
   stmt::llvm_add_incoming1(cg, idx_phi, idx0, cur)
   state = LLVMBuildLoad2(cg.builder, LLVMInt8Type!,
      types::gep1(cg, LLVMInt8Type!, states, idx_phi, "m.rd.state.gep"),
      "m.rd.state")
   is_empty = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 0, 0), "m.rd.is.empty")
   is_tomb = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 2, 0), "m.rd.is.tomb")
   LLVMBuildCondBr(cg.builder, is_empty, miss_bb, probe)
   LLVMPositionBuilderAtEnd(cg.builder, probe)
   LLVMBuildCondBr(cg.builder, is_tomb, next, found_bb)
   LLVMPositionBuilderAtEnd(cg.builder, found_bb)
   key_slot = types::gep1(cg, i8p, keys, idx_phi, "m.rd.key.slot")
   eq = codegen_map_key_equal(cg, key_slot, key_val, key_vt)
   hit = LLVMAppendBasicBlock(cg.current_fn, "m.rd.hit")
   LLVMBuildCondBr(cg.builder, eq, hit, next)
   LLVMPositionBuilderAtEnd(cg.builder, next)
   idx_next = LLVMBuildAnd(cg.builder,
      LLVMBuildAdd(cg.builder, idx_phi, one, "m.rd.idx.add"), capm1,
      "m.rd.idx.next")
   stmt::llvm_add_incoming1(cg, idx_phi, idx_next, next)
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, hit)
   LLVMBuildStore(cg.builder, one, tag_gep)
   val_is_ptr = types::is_ptrish_vt(val_vt)
   val = val_is_ptr
      | LLVMBuildLoad2(cg.builder, i8p,
         types::gep1(cg, i8p, vals, idx_phi, "m.rd.val.slot"), "m.rd.val")
      | LLVMBuildLoad2(cg.builder, i64t,
         types::gep1(cg, i64t, vals, idx_phi, "m.rd.val.slot"), "m.rd.val")
   main::codegen_array_box_payload(cg, result, val, val_vt)
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, miss_bb)
   LLVMBuildStore(cg.builder, zero, tag_gep)
   err = main::codegen_build_error(cg, LLVMConstInt(i64t, 4013, 0),
      "key not found", line, col, zero, zero)
   LLVMBuildStore(cg.builder, err, pay_gep)
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   result

// A heap union with an already-evaluated payload (tag, value, type).
codegen_build_union_ev: types::Cg, Int, Addr, ast::ValueType => Addr
codegen_build_union_ev = cg, tid, val, vt =>
   ut = cg.union_t
   up = expr::codegen_call_arena_alloc(cg,
      LLVMConstInt(LLVMInt64Type!, 16, 0), "variant.alloc")
   tgep = LLVMBuildStructGEP2(cg.builder, ut, up, 0, "tag.gep")
   LLVMBuildStore(cg.builder,
      LLVMConstInt(LLVMInt64Type!, tid, 0), tgep)
   pgep = LLVMBuildStructGEP2(cg.builder, ut, up, 1, "pay.gep")
   is_ptrish = types::is_ptrish_vt(vt)
   is_ptrish
      | LLVMBuildStore(cg.builder, val, pgep)
      |
         box = expr::codegen_call_arena_alloc(cg,
            LLVMConstInt(LLVMInt64Type!, 8, 0), "pay.alloc")
         LLVMBuildStore(cg.builder, val, box)
         LLVMBuildStore(cg.builder, box, pgep)
   up

// "m ^? k" — membership: a bare flag.
codegen_map_membership: types::Cg, Addr, Addr, ast::ValueType => Addr
codegen_map_membership = cg, m, key_val, key_vt =>
   i64t = LLVMInt64Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   mt = map_struct_type(cg)
   cap = LLVMBuildLoad2(cg.builder, i64t,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap"), "m.cap")
   keys = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.keys"), "m.keys")
   states = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.states"), "m.states")
   hash = codegen_map_hash(cg, key_val, key_vt)
   one = LLVMConstInt(i64t, 1, 0)
   capm1 = LLVMBuildSub(cg.builder, cap, one, "m.capm1")
   idx0 = LLVMBuildAnd(cg.builder, hash, capm1, "m.idx0")
   cur = LLVMGetInsertBlock(cg.builder)
   loop = LLVMAppendBasicBlock(cg.current_fn, "m.mem.loop")
   probe = LLVMAppendBasicBlock(cg.current_fn, "m.mem.probe")
   found = LLVMAppendBasicBlock(cg.current_fn, "m.mem.found")
   next = LLVMAppendBasicBlock(cg.current_fn, "m.mem.next")
   miss_bb = LLVMAppendBasicBlock(cg.current_fn, "m.mem.miss")
   done = LLVMAppendBasicBlock(cg.current_fn, "m.mem.done")
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, loop)
   idx_phi = LLVMBuildPhi(cg.builder, i64t, "m.mem.idx")
   stmt::llvm_add_incoming1(cg, idx_phi, idx0, cur)
   state = LLVMBuildLoad2(cg.builder, LLVMInt8Type!,
      types::gep1(cg, LLVMInt8Type!, states, idx_phi, "m.mem.state.gep"),
      "m.mem.state")
   is_empty = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 0, 0), "m.mem.is.empty")
   is_tomb = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 2, 0), "m.is.tomb")
   LLVMBuildCondBr(cg.builder, is_empty, miss_bb, probe)
   LLVMPositionBuilderAtEnd(cg.builder, probe)
   LLVMBuildCondBr(cg.builder, is_tomb, next, found)
   LLVMPositionBuilderAtEnd(cg.builder, found)
   key_slot = types::gep1(cg, i8p, keys, idx_phi, "m.mem.key.slot")
   eq = codegen_map_key_equal(cg, key_slot, key_val, key_vt)
   hit = LLVMAppendBasicBlock(cg.current_fn, "m.mem.hit")
   LLVMBuildCondBr(cg.builder, eq, hit, next)
   LLVMPositionBuilderAtEnd(cg.builder, next)
   idx_next = LLVMBuildAnd(cg.builder,
      LLVMBuildAdd(cg.builder, idx_phi, one, "m.mem.idx.add"), capm1,
      "m.mem.idx.next")
   stmt::llvm_add_incoming1(cg, idx_phi, idx_next, next)
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, hit)
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, miss_bb)
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   phi = LLVMBuildPhi(cg.builder, LLVMInt1Type!, "m.mem.res")
   stmt::llvm_add_incoming1(cg, phi, LLVMConstInt(LLVMInt1Type!, 1, 0),
      hit)
   stmt::llvm_add_incoming1(cg, phi, LLVMConstInt(LLVMInt1Type!, 0, 0),
      miss_bb)
   phi

// "m ^- k" — delete: an i1 Flag, true when the key was present.
codegen_map_delete: types::Cg, Addr, Addr, ast::ValueType => Addr
codegen_map_delete = cg, m, key_val, key_vt =>
   i64t = LLVMInt64Type!
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   mt = map_struct_type(cg)
   cap = LLVMBuildLoad2(cg.builder, i64t,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap"), "m.cap")
   keys = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.keys"), "m.keys")
   states = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.states"), "m.states")
   hash = codegen_map_hash(cg, key_val, key_vt)
   one = LLVMConstInt(i64t, 1, 0)
   capm1 = LLVMBuildSub(cg.builder, cap, one, "m.del.capm1")
   idx0 = LLVMBuildAnd(cg.builder, hash, capm1, "m.del.idx0")
   cur = LLVMGetInsertBlock(cg.builder)
   loop = LLVMAppendBasicBlock(cg.current_fn, "m.del.loop")
   probe = LLVMAppendBasicBlock(cg.current_fn, "m.del.probe")
   found = LLVMAppendBasicBlock(cg.current_fn, "m.del.found")
   next = LLVMAppendBasicBlock(cg.current_fn, "m.del.next")
   hit = LLVMAppendBasicBlock(cg.current_fn, "m.del.hit")
   miss_bb = LLVMAppendBasicBlock(cg.current_fn, "m.del.miss")
   done = LLVMAppendBasicBlock(cg.current_fn, "m.del.done")
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, loop)
   idx_phi = LLVMBuildPhi(cg.builder, i64t, "m.del.idx")
   stmt::llvm_add_incoming1(cg, idx_phi, idx0, cur)
   state_gep = types::gep1(cg, LLVMInt8Type!, states, idx_phi, "m.del.st.gep")
   state = LLVMBuildLoad2(cg.builder, LLVMInt8Type!,
      state_gep, "m.del.state")
   is_empty = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 0, 0), "m.del.is.empty")
   is_tomb = LLVMBuildICmp(cg.builder, 32, state,
      LLVMConstInt(LLVMInt8Type!, 2, 0), "m.del.is.tomb")
   LLVMBuildCondBr(cg.builder, is_empty, miss_bb, probe)
   LLVMPositionBuilderAtEnd(cg.builder, probe)
   LLVMBuildCondBr(cg.builder, is_tomb, next, found)
   LLVMPositionBuilderAtEnd(cg.builder, found)
   key_slot = types::gep1(cg, i8p, keys, idx_phi, "m.del.key.slot")
   eq = codegen_map_key_equal(cg, key_slot, key_val, key_vt)
   LLVMBuildCondBr(cg.builder, eq, hit, next)
   LLVMPositionBuilderAtEnd(cg.builder, next)
   idx_next = LLVMBuildAnd(cg.builder,
      LLVMBuildAdd(cg.builder, idx_phi, one, "m.del.idx.add"), capm1,
      "m.del.idx.next")
   stmt::llvm_add_incoming1(cg, idx_phi, idx_next, next)
   LLVMBuildBr(cg.builder, loop)
   LLVMPositionBuilderAtEnd(cg.builder, hit)
   LLVMBuildStore(cg.builder,
      LLVMConstInt(LLVMInt8Type!, 2, 0), state_gep)
   count_p = LLVMBuildStructGEP2(cg.builder, mt, m, 0, "m.count")
   cur_count = LLVMBuildLoad2(cg.builder, i64t, count_p, "m.del.count")
   count_next = LLVMBuildSub(cg.builder, cur_count, one, "m.del.cnt.next")
   LLVMBuildStore(cg.builder, count_next, count_p)
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, miss_bb)
   LLVMBuildBr(cg.builder, done)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   phi = LLVMBuildPhi(cg.builder, LLVMInt1Type!, "m.del.res")
   stmt::llvm_add_incoming1(cg, phi, LLVMConstInt(LLVMInt1Type!, 1, 0),
      hit)
   stmt::llvm_add_incoming1(cg, phi, LLVMConstInt(LLVMInt1Type!, 0, 0),
      miss_bb)
   phi

// "m ^ k" (lookup -> a fallible ram) / "m ^? k" (membership -> a flag).
codegen_eval_key_access: types::Cg, ast::KeyAccessExpr => (Addr, ast::ValueType)
codegen_eval_key_access = cg, t =>
   bv = expr::codegen_eval(cg, t.target)
   kv = expr::codegen_eval(cg, t.key)
   map_name = t.target [Var v] v | ""
   map_dt = types::var_dtype(cg, map_name)
   ti = types::typedef_ti(cg, map_dt)
   ti_kvt = ti [Map m] m.0 | ast::ValueType(Unknown)
   key_vt = ti_kvt != ast::ValueType(Unknown) | ti_kvt | kv.1
   ti_vvt = ti [Map m] m.1 | ast::ValueType(Unknown)
   val_vt = ti_vvt != ast::ValueType(Unknown) | ti_vvt | ast::ValueType(Int)
   t.is_delete
      | (codegen_map_delete(cg, bv.0, kv.0, key_vt),
         ast::ValueType(Flag))
      |
         t.is_membership
            | (codegen_map_membership(cg, bv.0, kv.0, key_vt),
               ast::ValueType(Flag))
            |
               map_name != "" | cg.last_type = main::map_read_typedef(cg, map_name) | 0
               ret_u = codegen_map_lookup(cg, bv.0, kv.0, key_vt, val_vt,
                  t.line, t.col)
               (ret_u, ast::ValueType(Ram))

// "m ^ k = v" — insert/rebind.
codegen_emit_map_assign: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo),
   ast::KeyAccessExpr => ()
codegen_emit_map_assign = cg, t, ka =>
   bv = expr::codegen_eval(cg, ka.target)
   kv = expr::codegen_eval(cg, ka.key)
   ev = expr::codegen_eval(cg, t.5)
   map_name = ka.target [Var v] v | ""
   map_dt = types::var_dtype(cg, map_name)
   ti = types::typedef_ti(cg, map_dt)
   ti_kvt = ti [Map m] m.0 | ast::ValueType(Unknown)
   key_vt = ti_kvt != ast::ValueType(Unknown) | ti_kvt | kv.1
   codegen_map_insert(cg, bv.0, kv.0, ev.0, key_vt)

// --- builders (slice 12) -----------------------------------------------------

// The Builder struct: { i64 len, ptr data, i64 cap }.
