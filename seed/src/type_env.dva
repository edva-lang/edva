// selfhost/src/type_env.dva — Lexical type environment and scoping.
//
// Tracks symbol bindings across local scopes, functions, and module globals.
// Part of Milestone 2 (Phase 2).

#use "ast"
#use "unify"
#use "tast"
#use "str"

#public

#type TypeBinding (
   name: String,
   ut: unify::UType,
   ti: ast::TypeInfo,
   is_mut: <>,
   is_global: <>,
   depth: Int
)
// Keep the most recent binding index for each name in this scope.
// Avoid allocating a fallible array-read result for every name comparison.
#type BindingIndices String ^ Int

#type TypeScope (
   bindings: TypeBinding{},
   parent: Int,
   indices: BindingIndices
)

#type FieldInit (
   tracked: ast::Names,
   whole: ast::Names,
   written: ast::Names
)

#type GenericDecl (
   name: String,
   ti: ast::TypeInfo
)

#type UserTypeDef (
   name: String,
   ti: ast::TypeInfo,
   ut: unify::UType
)
#type CachedBodies String ^ tast::TypedExpr

#type TypeEnv (
   scopes: TypeScope{},
   cur_scope: Int,
   cur_depth: Int,
   globals: TypeBinding{},
   init: FieldInit,
   generics: GenericDecl{},
   user_types: UserTypeDef{},
   cached_bodies: CachedBodies,
   current_module: String,
   discard_result: <>,
   in_fn: <>,
   in_lvalue: <>,
   in_member_target: <>,
   generic_bindings: ast::Names,
   marked_globals: ast::Names,
   cur_fn_ret: <unify::UType|>,
   swizzle_mode: String
)

empty_scope: () => TypeScope
empty_scope = !=>
   b: TypeBinding{}
   TypeScope(b, -1, BindingIndices())

new_init: () => FieldInit
new_init = !=> FieldInit(ast::Names(), ast::Names(), ast::Names())

new_env: () => TypeEnv
new_env = !=>
   b: TypeBinding{}
   root_scope = TypeScope(b, -1, BindingIndices())
   scopes: TypeScope{}
   scopes += root_scope
   globals: TypeBinding{}
   generics: GenericDecl{}
   user_types: UserTypeDef{}
   TypeEnv(scopes, 0, 0, globals, new_init(), generics,
      user_types, CachedBodies(), "", <->, <->, <->, <->,
      ast::Names(), ast::Names(), <-->, "none")

cache_fn_body: TypeEnv, String, tast::TypedExpr => ()
cache_fn_body = env, name, body =>
   bodies = env.cached_bodies
   bodies ^ name = body

lookup_fn_body: TypeEnv, String => < tast::TypedExpr | >
lookup_fn_body = env, name =>
   bodies = env.cached_bodies
   bodies ^? name
      |
         body = bodies ^ name | _ | _
         <+ body +>
      | <-->

mark_generic_binding: TypeEnv, String => ()
mark_generic_binding = env, name =>
   env.generic_bindings += name

is_generic_binding: TypeEnv, String => <>
is_generic_binding = env, name =>
   found' = <->
   env.generic_bindings @ n =>
      n == name | (found' = <+>; -->)
   found'

mark_global_var: TypeEnv, String => ()
mark_global_var = env, name =>
   env.marked_globals += name

is_marked_global: TypeEnv, String => <>
is_marked_global = env, name =>
   found' = <->
   qname = env.current_module != "" | env.current_module + "::" + name | name
   env.marked_globals @ n =>
      match = n == name || n == qname ||
         (env.current_module != "" && name == env.current_module + "::" + n)
      match | (found' = <+>; -->)
   found'

enter_scope: TypeEnv => ()
enter_scope = env =>
   parent_idx = env.cur_scope
   bnds: TypeBinding{}
   new_scope = TypeScope(bnds, parent_idx, BindingIndices())
   scs = env.scopes
   new_idx = ?scs
   scs += new_scope
   env.scopes = scs
   env.cur_scope = new_idx
   env.cur_depth = env.cur_depth + 1

leave_scope: TypeEnv => ()
leave_scope = env =>
   cur_idx = env.cur_scope
   cur_idx !< 0
      |
         scs = env.scopes
         cur_sc = scs(cur_idx) | _ | empty_scope()
         env.cur_scope = cur_sc.parent
         env.cur_depth > 0
            | env.cur_depth = env.cur_depth - 1
            | env.cur_depth = 0

bind_local: TypeEnv, String, unify::UType, ast::TypeInfo, <> => ()
bind_local = env, name, ut, ti, is_mut =>
   cur_idx = env.cur_scope
   cur_idx !< 0
      |
         scs = env.scopes
         cur_sc = scs(cur_idx) | _ | empty_scope()
         bnds = cur_sc.bindings
         indices = cur_sc.indices
         indices ^ name = ?bnds
         bnds += TypeBinding(name, ut, ti, is_mut, <->, env.cur_depth)
         cur_sc.bindings = bnds
         scs(cur_idx) = cur_sc !| _
         env.scopes = scs

unbind_local: TypeEnv, String => ()
unbind_local = env, name =>
   cur_idx = env.cur_scope
   cur_idx !< 0
      |
         scs = env.scopes
         cur_sc = scs(cur_idx) | _ | empty_scope()
         indices = cur_sc.indices
         indices ^ name = 0 - 1
         scs(cur_idx) = cur_sc !| _
         env.scopes = scs

bind_global: TypeEnv, String, unify::UType, ast::TypeInfo => ()
bind_global = env, name, ut, ti =>
   gls = env.globals
   gls += TypeBinding(name, ut, ti, <->, <+>, 0)
   env.globals = gls

name_is_qualified: String, Int => <>
name_is_qualified = name, i =>
   i + 1 < ?name
      |
         (name(i) == ':') && (name(i + 1) == ':')
            | <+>
            | name_is_qualified(name, i + 1)
      | <->

decl_module_find: String, Int, Int => Int
decl_module_find = name, i, last =>
   i + 1 < ?name
      |
         (name(i) == ':') && (name(i + 1) == ':')
            | decl_module_find(name, i + 2, i)
            | decl_module_find(name, i + 1, last)
      | last

decl_module: String, Int => String
decl_module = name, ignored =>
   last = decl_module_find(name, 0, -1)
   last < 0 | "" | name(0..last)

set_current_module: TypeEnv, String => ()
set_current_module = env, mod_name =>
   env.current_module = mod_name

lookup_local_exact: TypeEnv, String => < TypeBinding | >
lookup_local_exact = env, name =>
   cur_idx = env.cur_scope
   cur_idx < 0
      | <-->
      |
         scs = env.scopes
         cur_sc = scs(cur_idx) | _ | empty_scope()
         lookup_scope(cur_sc, name)

lookup_scope: TypeScope, String => < TypeBinding | >
lookup_scope = scope, name =>
   indices = scope.indices
   indices ^? name
      |
         idx = indices ^ name | _ | _
         idx < 0
            | <-->
            |
               scope.bindings(idx)
                  | binding => <+ binding +>
                  | <-->
      | <-->

lookup_local: TypeEnv, String => < TypeBinding | >
lookup_local = env, name =>
   exact = lookup_local_exact(env, name)
   exact
      | b => <+ b +>
      |
         env.current_module != "" && !name_is_qualified(name, 0)
            |
               pub = lookup_local_exact(env, env.current_module + "::" + name)
               pub
                  | p => <+ p +>
                  | lookup_local_exact(env, env.current_module + "::#" + name)
            | <-->

lookup_binding_exact: TypeEnv, String => < TypeBinding | >
lookup_binding_exact = env, name =>
   curr' = env.cur_scope
   found' = <-->
   scs = env.scopes
   max_iters = ?scs + 1
   max_iters @
      curr' < 0
         | -->
         |
            sc = scs(curr') | _ | empty_scope()
            lookup_scope(sc, name)
               | binding =>
                  found' = <+ binding +>
                  curr' = -1
            curr' !< 0
               | curr' = sc.parent
   found'
      | found'
      |
         gls = env.globals
         g_found' = <-->
         ?gls @ k =>
            i = (?gls) - 1 - k
            b = gls(i)!!
            b.name == name
               | (g_found' = <+ b +>; -->)
         g_found'

lookup_binding: TypeEnv, String => < TypeBinding | >
lookup_binding = env, name =>
   exact = lookup_binding_exact(env, name)
   exact
      | b => <+ b +>
      |
         env.current_module != ""
            |
               qname = env.current_module + "::" + name
               pub = lookup_binding_exact(env, qname)
               pub
                  | p => <+ p +>
                  | lookup_binding_exact(env, env.current_module + "::#" + name)
            | <-->

// --- Field Initialization Tracking -----------------------------------------

find_last_dot: String, Int => <Int|>
find_last_dot = s, i =>
   i < 0 | --| <-->
   s(i) == 46 | <+ i +> | find_last_dot(s, i - 1)

drop_last_dot: String => String
drop_last_dot = s =>
   cut = find_last_dot(s, ?s - 1) | _ | --| ""
   cut !> 0 | --| ""
   b = {cut}
   cut @ i => b += s(i)
   +b

init_has_name: ast::Names, String => <>
init_has_name = names, s =>
   names @ n =>
      n == s | --| <+>
   <->

init_mark_tracked: TypeEnv, String => ()
init_mark_tracked = env, name =>
   !init_has_name(env.init.tracked, name)
      |
         tr = env.init.tracked
         tr += name
         env.init = FieldInit(tr, env.init.whole, env.init.written)

init_is_tracked: TypeEnv, String => <>
init_is_tracked = env, name =>
   init_has_name(env.init.tracked, name)

init_mark_whole: TypeEnv, String => ()
init_mark_whole = env, name =>
   !init_has_name(env.init.whole, name)
      |
         wh = env.init.whole
         wh += name
         env.init = FieldInit(env.init.tracked, wh, env.init.written)

init_is_whole: TypeEnv, String => <>
init_is_whole = env, name =>
   init_has_name(env.init.whole, name)

init_mark_written: TypeEnv, String => ()
init_mark_written = env, path =>
   !init_has_name(env.init.written, path)
      |
         wr = env.init.written
         wr += path
         env.init = FieldInit(env.init.tracked, env.init.whole, wr)

init_is_ok_walk: TypeEnv, String => <>
init_is_ok_walk = env, p =>
   p == ""
      | <->
      |
         init_has_name(env.init.whole, p)
            | <+>
            | init_is_ok_walk(env, drop_last_dot(p))

init_has_subpath: ast::Names, String => <>
init_has_subpath = written, path =>
   prefix = path + "."
   plen = ?prefix
   has' = <->
   written @ w =>
      ?w > plen && w(0..plen) == prefix
         | (has' = <+>; -->)
   has'

init_is_ok: TypeEnv, String => <>
init_is_ok = env, path =>
   init_is_ok_walk(env, path) || init_has_name(env.init.written, path) ||
      init_has_subpath(env.init.written, path)

init_snapshot: TypeEnv => FieldInit
init_snapshot = env =>
   tr = ast::Names()
   env.init.tracked @ t => tr += t
   wh = ast::Names()
   env.init.whole @ w => wh += w
   wr = ast::Names()
   env.init.written @ p => wr += p
   FieldInit(tr, wh, wr)

init_snapshot_of: FieldInit => FieldInit
init_snapshot_of = fi =>
   tr = ast::Names()
   fi.tracked @ t => tr += t
   wh = ast::Names()
   fi.whole @ w => wh += w
   wr = ast::Names()
   fi.written @ p => wr += p
   FieldInit(tr, wh, wr)

init_restore: TypeEnv, FieldInit => ()
init_restore = env, snap =>
   env.init = snap

init_merge_two: FieldInit, FieldInit => FieldInit
init_merge_two = a, b =>
   tr = ast::Names()
   a.tracked @ t => tr += t
   b.tracked @ t2 =>
      !init_has_name(tr, t2) | tr += t2
   wh = ast::Names()
   a.whole @ name =>
      init_has_name(b.whole, name) | wh += name
   wr = ast::Names()
   a.written @ path =>
      init_has_name(b.written, path) | wr += path
   FieldInit(tr, wh, wr)

init_is_fully_init: TypeEnv, String, unify::UType => <>
init_is_fully_init = env, name, ut =>
   !init_is_tracked(env, name) || init_has_name(env.init.whole, name)
      | <+>
      |
         ut
            [Rec flds]
               all_wr' = <+>
               flds @ f =>
                  f.name != ""
                     |
                        path = name + "." + f.name
                        !init_has_name(env.init.written, path)
                           |
                              all_wr' = <->
                              -->
               all_wr'
            | init_is_ok_walk(env, name) || init_has_name(env.init.written, name)

bind_generic: TypeEnv, String, ast::TypeInfo => ()
bind_generic = env, name, ti =>
   gens = env.generics
   gens += GenericDecl(name, ti)
   env.generics = gens

lookup_generic_exact: TypeEnv, String => < ast::TypeInfo | >
lookup_generic_exact = env, name =>
   res' = <-->
   ?env.generics @ k =>
      i = (?env.generics) - 1 - k
      g = env.generics(i)!!
      g.name == name | (res' = <+ g.ti +>; -->)
   res'

lookup_generic: TypeEnv, String => < ast::TypeInfo | >
lookup_generic = env, name =>
   exact = lookup_generic_exact(env, name)
   exact
      | ti => <+ ti +>
      |
         env.current_module != "" && !name_is_qualified(name, 0)
            |
               pub = lookup_generic_exact(env,
                  env.current_module + "::" + name)
               pub
                  | p => <+ p +>
                  |
                     lookup_generic_exact(env,
                        env.current_module + "::#" + name)
            | <-->

bind_user_type: TypeEnv, String, ast::TypeInfo, unify::UType => ()
bind_user_type = env, name, ti, ut =>
   uts = env.user_types
   uts += UserTypeDef(name, ti, ut)
   env.user_types = uts

lookup_user_type_exact: TypeEnv, String => < UserTypeDef | >
lookup_user_type_exact = env, name =>
   res' = <-->
   ?env.user_types @ k =>
      i = (?env.user_types) - 1 - k
      u = env.user_types(i)!!
      u.name == name | (res' = <+ u +>; -->)
   res'

lookup_user_type: TypeEnv, String => < UserTypeDef | >
lookup_user_type = env, name =>
   exact = lookup_user_type_exact(env, name)
   exact
      | u => <+ u +>
      |
         env.current_module != "" && !name_is_qualified(name, 0)
            |
               pub = lookup_user_type_exact(env,
                  env.current_module + "::" + name)
               pub
                  | p => <+ p +>
                  |
                     lookup_user_type_exact(env,
                        env.current_module + "::#" + name)
            | <-->
