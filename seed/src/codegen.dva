// selfhost/src/codegen.dva — Facade for modular codegen units.

#use "codegen/types"
#use "codegen/main"

#public

#type CodegenOpts types::CodegenOpts

default_codegen_opts: () => types::CodegenOpts
default_codegen_opts = !=> types::default_codegen_opts!

decl_bare_name: String, Int => String
decl_bare_name = s, i => types::decl_bare_name(s, i)

codegen_typed_program_opts: tast::TypedProgram, ast::Expr, String, ast::Names, String, types::CodegenOpts => Int
codegen_typed_program_opts = prog, raw, out_path, exports, src_file, opts =>
   main::codegen_typed_program_opts(prog, raw, out_path, exports, src_file, opts)
