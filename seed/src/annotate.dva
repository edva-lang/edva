// selfhost/src/annotate.dva — AST type annotation and elaboration pass.
//
// Walks an untyped ast::Expr, generates type variables and constraints,
// solves them via the unify engine, enforces groundness (no defaulting to Int),
// and produces a verified tast::TypedExpr. Part of Milestone 2 (Phase 2).

#use ./ast
#use ./unify
#use ./tast
#use ./type_env
#use ./layout
#use ./dep_graph
#use ./overloads
#use str
#use ./show
#use ./diag
#use log

#foreign("c")
   write: (fd: Int, buf: Addr, count: Int) => Int

#private
   print: String => Int
   print = s =>
      b = {?s + 1}
      b += s
      b += 10
      write(1, &b, ?b)

#public

cur_source_file = ""
cur_target_triple = ""
cur_stmt_files = ast::Names()
cur_stmt_lines = ast::Ints()
cur_stmt_cols = ast::Ints()
cur_stmt_mods = ast::Names()
cur_is_call_arg = <->
in_ct_expr = <->
cur_fn_name = ""
unroll_seq = 0
cur_expected_ut: <unify::UType|>
cur_expected_ut = <-->
cur_program_exprs = ast::Exprs()
invalid_scc_fns = ast::Names()

#type CtTypeBind (name: String, ut: unify::UType, ti: ast::TypeInfo, dtype: String)
#type CtValBind (name: String, te: tast::TypedExpr, is_const: <>)
#type CtCursorBind (
   var_name: String,
   owner_ti: ast::TypeInfo,
   idx: Int,
   field_name: String,
   field_ut: unify::UType,
   field_ti: ast::TypeInfo,
   has_default: <>,
   default_expr: ast::Expr,
)
#type CtIntBind (var_name: String, idx: Int)

#type CtTypeBinds CtTypeBind{}
#type CtValBinds CtValBind{}
#type CtCursorBinds CtCursorBind{}
#type CtIntBinds CtIntBind{}

cur_ct_types = CtTypeBinds()
cur_ct_vals = CtValBinds()
cur_ct_cursors = CtCursorBinds()
cur_ct_ints = CtIntBinds()

/// Pushes a compile-time type parameter binding for generic elaboration.
push_ct_type: String, unify::UType, ast::TypeInfo, String => ()
push_ct_type = name, ut, ti, dtype =>
   next = cur_ct_types
   next += CtTypeBind(name, ut, ti, dtype)
   cur_ct_types ::= next

/// Truncates active compile-time type bindings back to `n`.
pop_ct_types_to: Int => ()
pop_ct_types_to = n =>
   next = CtTypeBinds()
   n @ i => next += cur_ct_types(i)!!
   cur_ct_types ::= next

/// Looks up the innermost active compile-time type binding by name.
lookup_ct_type: String => < CtTypeBind | >
lookup_ct_type = name =>
   ?cur_ct_types @ k =>
      i = ?cur_ct_types - 1 - k
      b = cur_ct_types(i)!!
      b.name == name | --| <+ b +>
   <-->

/// Pushes a compile-time value parameter binding.
push_ct_val: String, tast::TypedExpr, <> => ()
push_ct_val = name, te, is_const =>
   next = cur_ct_vals
   next += CtValBind(name, te, is_const)
   cur_ct_vals ::= next

/// Truncates active compile-time value bindings back to `n`.
pop_ct_vals_to: Int => ()
pop_ct_vals_to = n =>
   next = CtValBinds()
   n @ i => next += cur_ct_vals(i)!!
   cur_ct_vals ::= next

/// Looks up the innermost active compile-time value binding by name.
lookup_ct_val: String => < CtValBind | >
lookup_ct_val = name =>
   ?cur_ct_vals @ k =>
      i = ?cur_ct_vals - 1 - k
      b = cur_ct_vals(i)!!
      b.name == name | --| <+ b +>
   <-->

/// Pushes a `#members` cursor binding for cycle unrolling.
push_ct_cursor: CtCursorBind => ()
push_ct_cursor = b =>
   next = cur_ct_cursors
   next += b
   cur_ct_cursors ::= next

/// Truncates active `#members` cursor bindings back to `n`.
pop_ct_cursors_to: Int => ()
pop_ct_cursors_to = n =>
   next = CtCursorBinds()
   n @ i => next += cur_ct_cursors(i)!!
   cur_ct_cursors ::= next

/// Looks up an active `#members` cursor binding by variable name.
lookup_ct_cursor: String => < CtCursorBind | >
lookup_ct_cursor = name =>
   ?cur_ct_cursors @ k =>
      i = ?cur_ct_cursors - 1 - k
      b = cur_ct_cursors(i)!!
      b.var_name == name | --| <+ b +>
   <-->

/// Pushes a compile-time integer loop index binding.
push_ct_int: String, Int => ()
push_ct_int = name, idx =>
   next = cur_ct_ints
   next += CtIntBind(name, idx)
   cur_ct_ints ::= next

/// Truncates active compile-time integer loop bindings back to `n`.
pop_ct_ints_to: Int => ()
pop_ct_ints_to = n =>
   next = CtIntBinds()
   n @ i => next += cur_ct_ints(i)!!
   cur_ct_ints ::= next

/// Looks up an active compile-time integer loop binding by name.
lookup_ct_int: String => < Int | >
lookup_ct_int = name =>
   ?cur_ct_ints @ k =>
      i = ?cur_ct_ints - 1 - k
      b = cur_ct_ints(i)!!
      b.var_name == name | --| <+ b.idx +>
   <-->

/// Maps a resolved `TypeInfo` to its coarse `ast::ValueType`.
vt_of_resolved_ti: ast::TypeInfo => ast::ValueType
vt_of_resolved_ti = ti =>
   ti
      [Prim vt] vt
      [Rec r]
         r.1 | ast::ValueType(Slice) | ast::ValueType(Record)
      [Bitfield] ast::ValueType(Record)
      [Ram] ast::ValueType(Ram)
      [Enum] ast::ValueType(Enum)
      [Array] ast::ValueType(Array)
      [Map] ast::ValueType(Map)
      [Fn] ast::ValueType(Fn)
      [ThreadId] ast::ValueType(ThreadId)
      [Align a] vt_of_resolved_ti(a.1)
      | ast::ValueType(Unknown)

resolve_slot_vt: ast::TypeInfo, ast::ValueType => ast::ValueType
resolve_slot_vt = slot_ti, orig_vt =>
   slot_ti
      [TypeVar tv]
         lookup_ct_type(tv) | b => vt_of_resolved_ti(b.ti) | orig_vt
      | orig_vt

/// Substitutes active `cur_ct_types` aliases inside an AST `TypeInfo`.
resolve_ct_ti_aliases: type_env::TypeEnv, ast::TypeInfo => ast::TypeInfo
resolve_ct_ti_aliases = env, ti =>
   ti
      [TypeVar tv]
         lookup_ct_type(tv)
            | b => b.ti
            | ti
      [Align a] ast::TypeInfo(Align, (a.0, resolve_ct_ti_aliases(env, a.1)))
      [Rec r]
         new_flds = ast::FieldTypes()
         r.0 @ fld =>
            new_ti = resolve_ct_ti_aliases(env, fld.rec_type)
            new_vt = resolve_slot_vt(fld.rec_type, fld.val_type)
            new_flds += ast::RecordFieldType(fld.name, new_vt, new_ti,
               fld.has_default, fld.default_expr)
         new_elem_vt = r.1 && ?new_flds > 0
            | new_flds(0)!!.val_type
            | r.3
         ast::TypeInfo(Rec, (new_flds, r.1, r.2, new_elem_vt, r.4, r.5))
      [Ram r]
         s0_ti = r.0.has_payload
            | resolve_ct_ti_aliases(env, r.0.payload_record)
            | r.0.payload_record
         s0_vt = r.0.has_payload
            | resolve_slot_vt(r.0.payload_record, r.0.payload_type)
            | r.0.payload_type
         s1_ti = r.1.has_payload
            | resolve_ct_ti_aliases(env, r.1.payload_record)
            | r.1.payload_record
         s1_vt = r.1.has_payload
            | resolve_slot_vt(r.1.payload_record, r.1.payload_type)
            | r.1.payload_type
         ast::TypeInfo(Ram, (ast::RamSlotInfo(r.0.has_payload, s0_vt, s0_ti),
            ast::RamSlotInfo(r.1.has_payload, s1_vt, s1_ti)))
      [Array a]
         new_elem = resolve_ct_ti_aliases(env, a.1)
         new_vt = resolve_slot_vt(a.1, a.0)
         ast::TypeInfo(Array, (new_vt, new_elem, a.2))
      [Map m]
         new_val = resolve_ct_ti_aliases(env, m.2)
         new_vvt = resolve_slot_vt(m.2, m.1)
         ast::TypeInfo(Map, (m.0, new_vvt, new_val))
      [Fn f]
         new_pis = ast::VInfos()
         new_vts = ast::VTypes()
         ?f.1 @ i =>
            pi_raw = f.1(i)!!
            pi_res = resolve_ct_ti_aliases(env, pi_raw)
            new_pis += pi_res
            pv_raw = f.0(i) | _ | ast::ValueType(Unknown)
            new_vts += resolve_slot_vt(pi_raw, pv_raw)
         ret_res = resolve_ct_ti_aliases(env, f.3)
         ret_vt = resolve_slot_vt(f.3, f.2)
         ast::TypeInfo(Fn, (new_vts, new_pis, ret_vt, ret_res, f.4))
      [ThreadId t] ast::TypeInfo(ThreadId, (t.0, resolve_ct_ti_aliases(env, t.1)))
      | ti

/// Compares two canonicalized `UType` values structurally without unifying.
utype_eq: unify::Ctx, unify::UType, unify::UType => <>
utype_eq = ctx, a, b =>
   ca = unify::canon(ctx, a)
   cb = unify::canon(ctx, b)
   ca
      [None] cb [None]
      [Var va]
         cb [Var vb] va == vb | <->
      [Prim pa]
         cb [Prim pb] pa == pb | <->
      [Rec ra]
         cb
            [Rec rb]
               ?ra != ?rb | --| <->
               ?ra @ i =>
                  fa = ra(i)!!
                  fb = rb(i)!!
                  (fa.name != fb.name || fa.rec_name != fb.rec_name ||
                    !utype_eq(ctx, fa.ut, fb.ut)) | --| <->
               <+>
            | <->
      [Array a1]
         cb
            [Array a2]
               (a1.count == 0 || a2.count == 0 || a1.count == a2.count) &&
                 utype_eq(ctx, a1.elem, a2.elem)
            | <->
      [Slice s1]
         cb [Slice s2] utype_eq(ctx, s1, s2) | <->
      [Map m1]
         cb
            [Map m2] utype_eq(ctx, m1.key, m2.key) && utype_eq(ctx, m1.val, m2.val)
            | <->
      [Ram r1]
         cb
            [Ram r2]
               r1.pos.has_payload == r2.pos.has_payload &&
                 r1.neg.has_payload == r2.neg.has_payload &&
                 (!r1.pos.has_payload || utype_eq(ctx, r1.pos.ut, r2.pos.ut)) &&
                 (!r1.neg.has_payload || utype_eq(ctx, r1.neg.ut, r2.neg.ut))
            | <->
      [Fn f1]
         cb
            [Fn f2]
               ?f1.params != ?f2.params | --| <->
               ?f1.params @ i =>
                  !utype_eq(ctx, f1.params(i)!!, f2.params(i)!!) | --| <->
               utype_eq(ctx, f1.ret, f2.ret)
            | <->
      [Enum e1]
         cb
            [Enum e2]
               (e1.name != "" || e2.name != "")
                  | e1.name == e2.name
                  |
                     ?e1.variants != ?e2.variants | --| <->
                     ?e1.variants @ i =>
                        va = e1.variants(i)!!
                        vb = e2.variants(i)!!
                        (va.label != vb.label || va.has_payload != vb.has_payload ||
                          (va.has_payload && !utype_eq(ctx, va.payload_type, vb.payload_type)))
                           | --| <->
                     <+>
            | <->
      | <->

set_expected_type: <unify::UType|> => ()
set_expected_type = expected => cur_expected_ut ::= expected

/// Sets the active function name used for `E3149` return diagnostics.
set_fn_name: String => ()
set_fn_name = name => cur_fn_name ::= name

set_source_file: String => ()
set_source_file = f =>
   cur_source_file ::= f

set_target_triple: String => ()
set_target_triple = t =>
   cur_target_triple ::= t
   layout::set_target_triple(t)

is_32bit_triple: String => <>
is_32bit_triple = triple => layout::is_32bit_triple(triple)

is_32bit_target: () => <>
is_32bit_target = !=>
   is_32bit_triple(cur_target_triple)

set_program_locs: ast::Names, ast::Ints, ast::Ints => ()
set_program_locs = files, lines, cols =>
   cur_stmt_files ::= files
   cur_stmt_lines ::= lines
   cur_stmt_cols ::= cols
   cur_stmt_mods ::= ast::Names()

set_program_mods: ast::Names => ()
set_program_mods = mods =>
   cur_stmt_mods ::= mods

name_is_primed: String => <>
name_is_primed = name => ?name > 0 && name(-1..) == "'"

// --- Member Root Helper ----------------------------------------------------

member_root_str: ast::Expr => String
member_root_str = e =>
   e
      [Var name] name
      [Member m]
         sub = member_root_str(m.target)
         sub != "" | sub + "." + m.field_name | ""
      | ""

member_root_name: ast::Expr => String
member_root_name = e =>
   e
      [Var v] v
      [Member m] member_root_name(m.target)
      | ""

member_has_module_access: ast::Expr => <>
member_has_module_access = e =>
   e
      [Member m] m.is_module_access || member_has_module_access(m.target)
      | <->

module_qualified_name: ast::Expr, String => String
module_qualified_name = e, field =>
   e
      [Var name] name + "::" + field
      [Member m]
         sub = module_qualified_name(
            m.target, m.field_name)
         sub != "" | sub + "::" + field | ""
      | ""

split_mod_sym: String => (String, String)
split_mod_sym = qn =>
   n = ?qn
   k' = n - 2
   split_pos' = -1
   0.. @
      k' < 0 | -->
      qn(k') == 58 && qn(k' + 1) == 58
         |
            split_pos' = k'
            -->
      k' = k' - 1
   split_pos' > 0
      | (qn(..split_pos'), qn((split_pos' + 2)..))
      | ("", "")

exprs_has_mod_prefix: ast::Exprs, String => <>
exprs_has_mod_prefix = exprs, pfx =>
   exprs @ e =>
      hit' = e
         [Assign a] ?a.0 !< ?pfx && a.0(..(?pfx)) == pfx
         [TypeDecl td] ?td.name !< ?pfx && td.name(..(?pfx)) == pfx
         [Foreign f] ?f.dva_name !< ?pfx && f.dva_name(..(?pfx)) == pfx
         | <->
      hit' | --| <+>
   <->

find_decl_loc_str: ast::Exprs, String => String
find_decl_loc_str = exprs, name =>
   name == "" | --| ""
   idx' = -1
   exprs @ e, i =>
      e
         [Assign a]
            a.0 == name && !a.2
               |
                  !is_fwd_assign(a)
                     |
                        idx' = i
                        -->
                     | (idx' < 0 | idx' = i)
   (idx' < 0 || idx' !< ?cur_stmt_lines) | --| ""
   s_l = cur_stmt_lines(idx') | _ | 0
   s_l !> 0 | --| ""
   s_c = idx' < ?cur_stmt_cols | (cur_stmt_cols(idx') | _ | 0) | 0
   s_f = idx' < ?cur_stmt_files | (cur_stmt_files(idx') | _ | cur_source_file) | cur_source_file
   eff_f = s_f != "" | s_f | cur_source_file
   eff_f != ""
      | "${eff_f}:${str::from_int(s_l)}:${str::from_int(s_c)}"
      | "${str::from_int(s_l)}:${str::from_int(s_c)}"

resolve_module_access: unify::Ctx, type_env::TypeEnv,
  String, Int, Int => tast::TypedExpr
resolve_module_access = ctx, env, qn, line, col =>
   bnd0 = type_env::lookup_binding(env, qn)
   bnd = <>(bnd0)
      | bnd0
      |
         env.current_module != ""
            |
               pub_b = type_env::lookup_binding_exact(env, "${env.current_module}::${qn}")
               <>(pub_b)
                  | pub_b
                  | type_env::lookup_binding_exact(env, "${env.current_module}::#${qn}")
            | <-->
   bnd
      | b =>
         ti = unify::type_info_from_utype(ctx, b.ut)
         lay = layout::compute_layout(ctx, b.ut)
         --| tast::mk_typed_var(b.name, b.depth,
           b.is_mut, b.ut, ti, lay, line, col)

   gen = type_env::lookup_generic(env, qn)
   gen
      | gen_ti =>
         gut = instantiate_generic_ti(ctx, env, type_env::decl_module(qn, 0), gen_ti)
         gti = unify::type_info_from_utype(ctx, gut)
         glay = layout::compute_layout(ctx, gut)
         --| tast::mk_typed_var(qn, 0, <->,
           gut, gti, glay, line, col)

   ut_opt = type_env::lookup_user_type(env, qn)
   ut_opt
      | udef =>
         ulay = layout::compute_layout(ctx, udef.ut)
         --| tast::mk_typed_var(qn, 0, <->,
           udef.ut, udef.ti, ulay, line, col)

   ms = split_mod_sym(qn)
   priv_qn = ms.0 != "" | "${ms.0}::#${ms.1}" | ""
   is_priv_hit = priv_qn != "" &&
     (<>(type_env::lookup_binding_exact(env, priv_qn)) ||
       <>(type_env::lookup_user_type(env, priv_qn)))
   hint = is_priv_hit
      | " (symbol is private to module '${ms.0}')"
      |
         ms.0 != "" && !exprs_has_mod_prefix(cur_program_exprs, "${ms.0}::") &&
           !<>(type_env::lookup_binding(env, ms.0))
            | " (module '${ms.0}' has no loaded symbols; check '#use')"
            | ""
   emsg = "Undefined identifier: ${qn}${hint}"
   unify::add_error(ctx, 3004, emsg)
   e_ut = unify::poison_utype!
   e_ti = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   e_lay = tast::layout_scalar(8, 8)
   tast::mk_typed_var(qn, 0, <->, e_ut, e_ti, e_lay, line, col)

is_fwd_assign: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
  String, ast::TypeInfo) => <>
is_fwd_assign = a =>
   a.5 [Var v] (v == "<fwd>") | <->

is_generic_sig: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
  String, ast::TypeInfo) => <>
is_generic_sig = a =>
   is_ct = ?a.7 > 4 && a.7(0..4) == "@ct0"
   is_ti = a.8 [Fn f] (?f.4 > 0) | <->
   is_ct || is_ti

mk_lambda_te: ast::Names, tast::TypedExpr, unify::UType,
  ast::TypeInfo => tast::TypedExpr
mk_lambda_te = params, body_te, fn_ut, ti =>
   lay = tast::layout_closure!
   tast::mk_typed_expr(
      tast::TypedExprKind(Lambda, (params, body_te, tast::TypedCaptures())),
      fn_ut, ti, lay, 0, 0)

mk_lambda_te_at: ast::Names, tast::TypedExpr, unify::UType,
  ast::TypeInfo, Int, Int => tast::TypedExpr
mk_lambda_te_at = params, body_te, fn_ut, ti, line, col =>
   lay = tast::layout_closure!
   tast::mk_typed_expr(
      tast::TypedExprKind(Lambda, (params, body_te, tast::TypedCaptures())),
      fn_ut, ti, lay, line, col)

type_name_to_uprim: String => < unify::UPrim | >
type_name_to_uprim =
   ["Int", "i64"] <+ unify::UPrim(Int) +>
   ["i8"] <+ unify::UPrim(I8) +>
   ["i16"] <+ unify::UPrim(I16) +>
   ["i32"] <+ unify::UPrim(I32) +>
   ["u8"] <+ unify::UPrim(U8) +>
   ["u16"] <+ unify::UPrim(U16) +>
   ["u32"] <+ unify::UPrim(U32) +>
   ["u64"] <+ unify::UPrim(U64) +>
   ["i1", "<>"] <+ unify::UPrim(Flag) +>
   ["Rune"] <+ unify::UPrim(Rune) +>
   ["Float", "f64"] <+ unify::UPrim(Float) +>
   ["f32"] <+ unify::UPrim(F32) +>
   ["String"] <+ unify::UPrim(Str) +>
   ["void"] <+ unify::UPrim(Unit) +>
   ["Addr", "ptr"] <+ unify::UPrim(RawPtr) +>
   ["Builder"] <+ unify::UPrim(Builder) +>
   ["Error"] <+ unify::UPrim(Error) +>
   ["Type"] <+ unify::UPrim(Type) +>
   | <-->

is_uprim_int: unify::UPrim => <>
is_uprim_int = [Int, I8, I16, I32, I64, U8, U16, U32, U64, Rune]

is_uprim_float: unify::UPrim => <>
is_uprim_float = [Float, F32]

is_uprim_flag: unify::UPrim => <>
is_uprim_flag = [Flag]

is_uprim_ptr: unify::UPrim => <>
is_uprim_ptr = [RawPtr]

is_uprim_str: unify::UPrim => <>
is_uprim_str = [Str]

is_uprim_builder: unify::UPrim => <>
is_uprim_builder = [Builder]

cast_name_to_uprim: String => < unify::UPrim | >
cast_name_to_uprim =
   ["Int", "i64"] <+ unify::UPrim(Int) +>
   ["i8"] <+ unify::UPrim(I8) +>
   ["i16"] <+ unify::UPrim(I16) +>
   ["i32"] <+ unify::UPrim(I32) +>
   ["u8"] <+ unify::UPrim(U8) +>
   ["u16"] <+ unify::UPrim(U16) +>
   ["u32"] <+ unify::UPrim(U32) +>
   ["u64"] <+ unify::UPrim(U64) +>
   ["i1", "<>"] <+ unify::UPrim(Flag) +>
   ["Rune"] <+ unify::UPrim(Rune) +>
   ["Float", "f64"] <+ unify::UPrim(Float) +>
   ["f32"] <+ unify::UPrim(F32) +>
   ["String"] <+ unify::UPrim(Str) +>
   ["Addr", "ptr"] <+ unify::UPrim(RawPtr) +>
   | <-->

check_addr_target: unify::Ctx, String, <>, unify::UType => ()
check_addr_target = ctx, fn_name, is_tgt_ptr, src_ut =>
   unify::add_error(ctx, 3084,
     "Cannot cast '" + unify::show_utype(ctx, src_ut) +
     "' to '" + fn_name + "'")

validate_primitive_cast: unify::Ctx, String, unify::UPrim, unify::UType => ()
validate_primitive_cast = ctx, fn_name, tgt_uprim, src_ut =>
   is_tgt_int = is_uprim_int(tgt_uprim)
   is_tgt_float = is_uprim_float(tgt_uprim)
   is_tgt_flag = is_uprim_flag(tgt_uprim)
   is_tgt_ptr = is_uprim_ptr(tgt_uprim)
   is_tgt_str = is_uprim_str(tgt_uprim)

   src_ut
      [Var] --|
      [Ram]
         is_tgt_flag
            | --|
            |
               unify::add_error(ctx, 3084,
                 "Cannot cast '" + unify::show_utype(ctx, src_ut) +
                 "' to '" + fn_name + "'")
      [Rec] check_addr_target(ctx, fn_name, is_tgt_ptr, src_ut)
      [Array] check_addr_target(ctx, fn_name, is_tgt_ptr, src_ut)
      [Slice] check_addr_target(ctx, fn_name, is_tgt_ptr, src_ut)
      [Fn] check_addr_target(ctx, fn_name, is_tgt_ptr, src_ut)
      [Prim src_prim]
         is_src_int = is_uprim_int(src_prim)
         is_src_float = is_uprim_float(src_prim)
         is_src_flag = is_uprim_flag(src_prim)
         is_src_ptr = is_uprim_ptr(src_prim)
         is_src_str = is_uprim_str(src_prim)
         is_src_builder = is_uprim_builder(src_prim)

         is_ok = is_tgt_int
            | (is_src_int || is_src_float || is_src_flag || is_src_ptr)
            |
               is_tgt_float
                  | (is_src_float || is_src_int || is_src_flag)
                  |
                     is_tgt_flag
                        |
                           (is_src_flag || is_src_int || is_src_float ||
                             is_src_ptr || is_src_str)
                        |
                           is_tgt_ptr
                              | (is_src_ptr || is_src_int)
                              |
                                 is_tgt_str
                                    |
                                       is_src_ptr
                                          |
                                             unify::add_error(ctx, 3065,
                                               diag::E3065_rawptr_to_string!)
                                       is_src_str
                                    | <->
         !is_ok
            |
               !(is_tgt_str && is_src_ptr)
                  |
                     unify::add_error(ctx, 3084,
                       "Cannot cast '" + unify::show_utype(ctx, src_ut) +
                       "' to '" + fn_name + "'")
      |
         unify::add_error(ctx, 3084,
           "Cannot cast '" + unify::show_utype(ctx, src_ut) +
           "' to '" + fn_name + "'")

#type TypeVarMapEntry (name: String, ut: unify::UType)
#type TypeVarMap TypeVarMapEntry{}

tv_lookup: TypeVarMap, String => < unify::UType | >
tv_lookup = tvm, name =>
   res' = <-->
   tvm @ e =>
      e.name == name | (res' = <+ e.ut +>; -->)
   res'

tv_get_or_create: unify::Ctx, TypeVarMap, String => (TypeVarMap, unify::UType)
tv_get_or_create = ctx, tvm, name =>
   existing = tv_lookup(tvm, name)
   existing
      | ut => (tvm, ut)
      |
         fresh = unify::fresh_var(ctx)
         new_tvm = tvm
         new_tvm += TypeVarMapEntry(name, fresh)
         (new_tvm, fresh)

#type TiInstRes (tvm: TypeVarMap, ut: unify::UType)

instantiate_ti_step: unify::Ctx, type_env::TypeEnv, String, TypeVarMap, ast::TypeInfo => TiInstRes
instantiate_ti_step = ctx, env, fn_mod, tvm, ti =>
   ti
      [Prim vt]
         TiInstRes(tvm, unify::UType(Prim, unify::vt_to_uprim(vt)))
      [TypeVar name]
         tv_opt = tv_lookup(tvm, name)
         tv_opt
            | tv_ut => TiInstRes(tvm, tv_ut)
            |
               cast_opt = type_name_to_uprim(name)
               cast_opt
                  | uprim => TiInstRes(tvm, unify::UType(Prim, uprim))
                  |
                     ut_opt0 = type_env::lookup_user_type(env, name)
                     ut_opt = <>(ut_opt0)
                        | ut_opt0
                        |
                           (fn_mod != "" && !type_env::name_is_qualified(name, 0))
                              | type_env::lookup_user_type_exact(env, fn_mod + "::" + name)
                              | <-->
                     ut_opt
                        | udef => TiInstRes(tvm, udef.ut)
                        |
                           res = tv_get_or_create(ctx, tvm, name)
                           TiInstRes(res)
      [Fn f]
         cur_tvm' = tvm
         vinfos = f.1
         params = unify::UTypes()
         f.4 @ cp =>
            cp.1 == ast::ValueType(Type)
               |
                  tv_res = tv_get_or_create(ctx, cur_tvm', cp.0)
                  cur_tvm' = tv_res.0
               |
                  cp_res = instantiate_ti_step(ctx, env, fn_mod, cur_tvm', cp.2)
                  cur_tvm' = cp_res.tvm
                  params += cp_res.ut
         vinfos @ pi =>
            p_res = instantiate_ti_step(ctx, env, fn_mod, cur_tvm', pi)
            cur_tvm' = p_res.tvm
            params += p_res.ut
         ret_res = instantiate_ti_step(ctx, env, fn_mod, cur_tvm', f.3)
         cur_tvm' = ret_res.tvm
         TiInstRes(cur_tvm', unify::UType(Fn,
           unify::UFn(params, ret_res.ut)))
      [Ram r]
         s0 = r.0
         s1 = r.1
         (!s0.has_payload && !s1.has_payload)
            | TiInstRes(tvm, unify::UType(Prim, unify::UPrim(Flag)))
            |
               cur_tvm2' = tvm
               p_ut' = unify::UType(None)
               s0.has_payload
                  |
                     res0 = instantiate_ti_step(ctx, env, fn_mod, cur_tvm2',
                       s0.payload_record)
                     cur_tvm2' = res0.tvm
                     p_ut' = res0.ut
               n_ut' = unify::UType(None)
               s1.has_payload
                  |
                     res1 = instantiate_ti_step(ctx, env, fn_mod, cur_tvm2',
                       s1.payload_record)
                     cur_tvm2' = res1.tvm
                     n_ut' = res1.ut
               slot0 = unify::URamSlot(s0.has_payload, p_ut')
               slot1 = unify::URamSlot(s1.has_payload, n_ut')
               TiInstRes(cur_tvm2', unify::UType(Ram,
                 unify::URam(slot0, slot1)))
      [Rec r]
         r.1
            |
               fts = r.0
               n_fts = ?fts
               cur_tvm3' = tvm
               elem_ut' = unify::UType(None)
               n_fts > 0
                  |
                     f0 = fts(0) | _ | ast::RecordFieldType("",
                       ast::ValueType(Unknown),
                       ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                       <->, ast::Expr(Int, 0))
                     res0 = instantiate_ti_step(ctx, env, fn_mod, cur_tvm3', f0.rec_type)
                     cur_tvm3' = res0.tvm
                     elem_ut' = res0.ut
                  | elem_ut' = unify::UType(Prim, unify::vt_to_uprim(r.3))
               TiInstRes(cur_tvm3', unify::UType(Slice, elem_ut'))
            |
               fts = r.0
               cur_tvm4' = tvm
               flds = unify::UFields()
               fts @ ft =>
                  res_i = instantiate_ti_step(ctx, env, fn_mod, cur_tvm4', ft.rec_type)
                  cur_tvm4' = res_i.tvm
                  flds += unify::UField(ft.name, res_i.ut)
               TiInstRes(cur_tvm4', unify::UType(Rec, flds))
      [Align a]
         instantiate_ti_step(ctx, env, fn_mod, tvm, a.1)
      [Bitfield b]
         flds = unify::UFields()
         b.fields @ bf =>
            f_up = bf.is_flag | unify::UPrim(Flag) | unify::vt_to_uprim(b.backing_type)
            flds += unify::UField(bf.name, unify::UType(Prim, f_up))
         TiInstRes(tvm, unify::UType(Rec, flds))
      [Array a]
         res_a = instantiate_ti_step(ctx, env, fn_mod, tvm, a.1)
         TiInstRes(res_a.tvm, unify::UType(Array,
           unify::UArray(res_a.ut, a.2)))
      [Map m]
         k_ut = unify::UType(Prim, unify::vt_to_uprim(m.0))
         res_v = instantiate_ti_step(ctx, env, fn_mod, tvm, m.2)
         v_val = res_v.ut
         v_ut = v_val [None] unify::UType(Prim, unify::vt_to_uprim(m.1)) | v_val
         TiInstRes(res_v.tvm, unify::UType(Map, unify::UMap(k_ut, v_ut)))
      |
         TiInstRes(tvm, unify::utype_from_type_info(ti))

#type VarInstMapEntry (old_id: Int, new_ut: unify::UType)
#type VarInstMap VarInstMapEntry{}
#type VarInstRes (vim: VarInstMap, ut: unify::UType)

vim_lookup: VarInstMap, Int => < unify::UType | >
vim_lookup = vim, id =>
   res' = <-->
   vim @ e =>
      e.old_id == id | (res' = <+ e.new_ut +>; -->)
   res'

instantiate_unbound_step: unify::Ctx, VarInstMap, unify::UType => VarInstRes
instantiate_unbound_step = ctx, vim, ut =>
   c = unify::canon(ctx, ut)
   c
      [Var id]
         existing = vim_lookup(vim, id)
         existing
            | ex => VarInstRes(vim, ex)
            |
               fresh = unify::fresh_var(ctx)
               new_vim = vim
               new_vim += VarInstMapEntry(id, fresh)
               VarInstRes(new_vim, fresh)
      [Fn f]
         cur_vim' = vim
         new_params = unify::UTypes()
         f.params @ p =>
            p_res = instantiate_unbound_step(ctx, cur_vim', p)
            cur_vim' = p_res.vim
            new_params += p_res.ut
         ret_res = instantiate_unbound_step(ctx, cur_vim', f.ret)
         cur_vim' = ret_res.vim
         fn_ut = unify::UType(Fn, unify::UFn(new_params, ret_res.ut))
         VarInstRes(cur_vim', fn_ut)
      | VarInstRes(vim, c)

instantiate_unbound_fn: unify::Ctx, unify::UType => unify::UType
instantiate_unbound_fn = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Fn]
         res = instantiate_unbound_step(ctx, VarInstMap(), c)
         res.ut
      | ut

instantiate_generic_ti: unify::Ctx, type_env::TypeEnv, String, ast::TypeInfo => unify::UType
instantiate_generic_ti = ctx, env, fn_mod, ti =>
   res = instantiate_ti_step(ctx, env, fn_mod, TypeVarMap(), ti)
   res.ut

resolve_type_name_ut_ti: unify::Ctx, type_env::TypeEnv, String,
  String => (unify::UType, ast::TypeInfo, <>)
resolve_type_name_ut_ti = ctx, env, fn_mod, tv =>
   ct_opt = lookup_ct_type(tv)
   ct_opt | ct => --| (ct.ut, ct.ti, <+>)
   cast_opt = type_name_to_uprim(tv)
   cast_opt
      | up =>
         ut = unify::UType(Prim, up)
         (ut, unify::type_info_from_utype(ctx, ut), <+>)
      |
         ut_opt0 = type_env::lookup_user_type(env, tv)
         ut_opt = <>(ut_opt0)
            | ut_opt0
            |
               (fn_mod != "" && !type_env::name_is_qualified(tv, 0))
                  | type_env::lookup_user_type_exact(env, fn_mod + "::" + tv)
                  | <-->
         ut_opt
            | udef => (udef.ut, ast::TypeInfo(TypeVar, udef.name), <+>)
            | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

resolve_enum_ut: unify::Ctx, type_env::TypeEnv, unify::UEnum => unify::UEnum
extract_child_ti: unify::Ctx, type_env::TypeEnv, ast::TypeInfo, Int,
  unify::UType => ast::TypeInfo

resolve_type_expr_ut_ti: unify::Ctx, type_env::TypeEnv, String,
  ast::Expr => (unify::UType, ast::TypeInfo, <>)
resolve_type_expr_ut_ti = ctx, env, fn_mod, e =>
   e
      [Var tv]
         ct_opt = lookup_ct_type(tv)
         ct_opt | ct => --| (ct.ut, ct.ti, <+>)
         has_bnd = <>(type_env::lookup_binding(env, tv))
         has_bnd
            | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
            | resolve_type_name_ut_ti(ctx, env, fn_mod, tv)
      [Record r]
         ?r.fields == 0
            | (unify::prim_unit!, ast::TypeInfo(Prim, ast::ValueType(Unit)), <+>)
            | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      [Member m]
         m.is_module_access
            |
               qn = module_qualified_name(m.target, m.field_name)
               ut_opt = type_env::lookup_user_type(env, qn)
               ut_opt
                  | udef => (udef.ut, ast::TypeInfo(TypeVar, qn), <+>)
                  | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
            |
               m.field_name == ""
                  |
                     rt_tgt = resolve_type_expr_ut_ti(ctx, env, fn_mod, m.target)
                     idx_opt = m.index_expr
                        [Int iv] <+ iv +>
                        [Var v]
                           lookup_ct_int(v)
                              | ci => <+ ci +>
                              | lookup_ct_cursor(v) | cur => <+ cur.idx +> | <-->
                        | <-->
                     (rt_tgt.2 && <>(idx_opt))
                        |
                           idx_n = idx_opt!!
                           c_rt_t = unify::canon(ctx, rt_tgt.0)
                           c_rt_t
                              [Rec flds]
                                 (idx_n !< 0 && idx_n < ?flds)
                                    |
                                       fld_ut = (flds(idx_n)!!).ut
                                       fld_ti = extract_child_ti(ctx, env, rt_tgt.1, idx_n, fld_ut)
                                       --| (fld_ut, fld_ti, <+>)
                              [Enum ue_raw]
                                 uenum = resolve_enum_ut(ctx, env, ue_raw)
                                 (idx_n !< 0 && idx_n < ?uenum.variants)
                                    |
                                       uv = uenum.variants(idx_n)!!
                                       v_ut = uv.has_payload | uv.payload_type | unify::prim_unit!
                                       --| (v_ut, unify::type_info_from_utype(ctx, v_ut), <+>)
                     --| (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
               cur_tv = m.target [Var cv] cv | ""
               cur_opt = cur_tv != "" && m.field_name ["type", "Type"]
                  | lookup_ct_cursor(cur_tv)
                  | <-->
               cur_opt
                  | cur => (cur.field_ut, cur.field_ti, <+>)
                  | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      [SizeOf so]
         so.rec_type
            [TypeVar tv] resolve_type_name_ut_ti(ctx, env, fn_mod, tv)
            |
               ut = utype_from_ti_env(env, so.rec_type)
               ut [None]
                  | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                  | (ut, so.rec_type, <+>)
      | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

// Does the (parser) TypeInfo mention the compile-time type variable `name`?
ti_mentions_tv: ast::TypeInfo, String => <>
ti_mentions_tv = ti, name =>
   ti
      [TypeVar tv] tv == name
      [Align a] ti_mentions_tv(a.1, name)
      [Rec r]
         hit' = <->
         r.0 @ f => ti_mentions_tv(f.rec_type, name) | (hit' = <+>; -->)
         hit'
      [Ram r]
         (r.0.has_payload && ti_mentions_tv(r.0.payload_record, name)) ||
           (r.1.has_payload && ti_mentions_tv(r.1.payload_record, name))
      [Enum slots]
         hit' = <->
         slots @ sl =>
            sl.has_payload && ti_mentions_tv(sl.payload_record, name) | (hit' = <+>; -->)
         hit'
      [Fn f]
         hit' = ti_mentions_tv(f.3, name)
         f.1 @ pi => ti_mentions_tv(pi, name) | (hit' = <+>; -->)
         hit'
      [Array a] ti_mentions_tv(a.1, name)
      [Map m] ti_mentions_tv(m.2, name)
      [ThreadId t] ti_mentions_tv(t.1, name)
      | <->

// A compile-time type parameter that is neither passed explicitly nor
// mentioned by the declared parameter/result types cannot be inferred.
// Result types can receive later constraints (for example a curried call),
// and unannotated parameters are inferred from the body instead.
check_ct_param_inferable: unify::Ctx, ast::VInfos, ast::TypeInfo, String, String => <>
check_ct_param_inferable = ctx, vinfos, ret_ti, fn_name, cp_name =>
   inferable' = ti_mentions_tv(ret_ti, cp_name)
   vinfos @ pi =>
      unspecified = pi [Prim vt] vt [Unknown] | <->
      ti_mentions_tv(pi, cp_name) || unspecified | (inferable' = <+>; -->)
   !inferable'
      | unify::add_error(ctx, 3176, diag::uninferable_type_param(cp_name, fn_name))
   inferable'

instantiate_generic_ti_call: unify::Ctx, type_env::TypeEnv, String, ast::TypeInfo,
  ast::Exprs => unify::UType
instantiate_generic_ti_call = ctx, env, fn_mod, ti, call_args =>
   instantiate_generic_ti_call_named(ctx, env, fn_mod, ti, call_args, "")

instantiate_generic_ti_call_named: unify::Ctx, type_env::TypeEnv, String, ast::TypeInfo,
  ast::Exprs, String => unify::UType
instantiate_generic_ti_call_named = ctx, env, fn_mod, ti, call_args, fn_name =>
   ti
      [Fn f]
         cur_tvm' = TypeVarMap()
         vinfos = f.1
         params = unify::UTypes()
         arg_idx' = 0
         n_call = ?call_args
         f.4 @ cp =>
            cp.1 == ast::ValueType(Type)
               |
                  arg_idx' < n_call
                     |
                        arg_e = call_args(arg_idx')!!
                        is_unit_lit = arg_e [Record r_u] (?r_u.fields == 0) | <->
                        has_extra = (n_call - arg_idx') > ?vinfos
                        rt = (!(arg_e [SizeOf]) && (!is_unit_lit || has_extra))
                           | resolve_type_expr_ut_ti(ctx, env, fn_mod, arg_e)
                           | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                        rt.2
                           |
                              cur_tvm' += TypeVarMapEntry(cp.0, rt.0)
                              params += unify::prim_type!
                              arg_idx' = arg_idx' + 1
                           |
                              !check_ct_param_inferable(ctx, vinfos, f.3, fn_name, cp.0)
                                 | (cur_tvm' += TypeVarMapEntry(cp.0, unify::poison_utype!))
                                 |
                                    tv_res = tv_get_or_create(ctx, cur_tvm', cp.0)
                                    cur_tvm' = tv_res.0
                     |
                        !check_ct_param_inferable(ctx, vinfos, f.3, fn_name, cp.0)
                           | (cur_tvm' += TypeVarMapEntry(cp.0, unify::poison_utype!))
                           |
                              tv_res = tv_get_or_create(ctx, cur_tvm', cp.0)
                              cur_tvm' = tv_res.0
               |
                  cp_res = instantiate_ti_step(ctx, env, fn_mod, cur_tvm', cp.2)
                  cur_tvm' = cp_res.tvm
                  params += cp_res.ut
                  arg_idx' = arg_idx' + 1
         vinfos @ pi =>
            p_res = instantiate_ti_step(ctx, env, fn_mod, cur_tvm', pi)
            cur_tvm' = p_res.tvm
            params += p_res.ut
         ret_res = instantiate_ti_step(ctx, env, fn_mod, cur_tvm', f.3)
         unify::UType(Fn, unify::UFn(params, ret_res.ut))
      | instantiate_generic_ti(ctx, env, fn_mod, ti)

lookup_user_type_any_mod: type_env::TypeEnv, String => < type_env::UserTypeDef | >
lookup_user_type_any_mod = env, name =>
   type_env::name_is_qualified(name, 0) | --| <-->
   pub_sfx = "::" + name
   priv_sfx = "::#" + name
   ?env.user_types @ k =>
      i = (?env.user_types) - 1 - k
      u = env.user_types(i)!!
      !(u.ut [None]) && (u.name == name || str::ends_with(u.name, pub_sfx) || str::ends_with(u.name, priv_sfx))
         | --| <+ u +>
   <-->

find_enum_utype_by_slots: type_env::TypeEnv, ast::EnumSlots => < unify::UType | >
find_enum_utype_by_slots = env, slots =>
   n = ?slots
   ?env.user_types @ k =>
      i = (?env.user_types) - 1 - k
      u = env.user_types(i)!!
      u.ti
         [Enum u_slots]
            u.ut
               [Enum ue]
                  (ue.name != "" && ?u_slots == n && ?ue.variants == n)
                     |
                        ok' = <+>
                        n @ idx =>
                           v = ue.variants(idx)!!
                           us = u_slots(idx)!!
                           ss = slots(idx)!!
                           (us.label != ss.label || us.has_payload != ss.has_payload ||
                             us.payload_type != ss.payload_type ||
                             (v.has_payload && (v.payload_type [None])))
                              | (ok' = <->; -->)
                        ok' | --| <+ u.ut +>
   <-->

utype_from_ti_env: type_env::TypeEnv, ast::TypeInfo => unify::UType
utype_from_ti_env = env, ti =>
   ti
      [TypeVar tv]
         lookup_ct_type(tv) | ctb => --| ctb.ut
         cast_opt = type_name_to_uprim(tv)
         cast_opt
            | uprim => unify::UType(Prim, uprim)
            |
               ut_opt = type_env::lookup_user_type(env, tv)
               ut_opt
                  | udef => udef.ut
                  |
                     lookup_user_type_any_mod(env, tv)
                        | udef => udef.ut
                        | unify::UType(None)
      [Ram r]
         s0 = r.0
         s1 = r.1
         (!s0.has_payload && !s1.has_payload)
            | unify::prim_flag!
            |
               p_ut = s0.has_payload
                  | utype_from_ti_env(env, s0.payload_record)
                  | unify::UType(None)
               n_ut = s1.has_payload
                  | utype_from_ti_env(env, s1.payload_record)
                  | unify::UType(None)
               slot0 = unify::URamSlot(s0.has_payload, p_ut)
               slot1 = unify::URamSlot(s1.has_payload, n_ut)
               unify::UType(Ram, unify::URam(slot0, slot1))
      [Fn f]
         vinfos = f.1
         params = unify::UTypes()
         vinfos @ pi =>
            params += utype_from_ti_env(env, pi)
         ret = utype_from_ti_env(env, f.3)
         unify::UType(Fn, unify::UFn(params, ret))
      [Rec r]
         r.1
            |
               fts = r.0
               n_fts = ?fts
               elem_ut' = unify::UType(None)
               n_fts > 0
                  |
                     f0 = fts(0) | _ | ast::RecordFieldType("",
                       ast::ValueType(Unknown),
                       ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                       <->, ast::Expr(Int, 0))
                     elem_ut' = utype_from_ti_env(env, f0.rec_type)
                  |
                     elem_ut' = unify::UType(Prim,
                       unify::vt_to_uprim(r.3))
               unify::UType(Slice, elem_ut')
            |
               fts = r.0
               flds = unify::UFields()
               fts @ ft =>
                  flds += unify::UField(ft.name,
                    utype_from_ti_env(env, ft.rec_type))
               unify::UType(Rec, flds)
      [Align a] utype_from_ti_env(env, a.1)
      [Bitfield b]
         flds = unify::UFields()
         b.fields @ bf =>
            f_up = bf.is_flag | unify::UPrim(Flag) | unify::vt_to_uprim(b.backing_type)
            flds += unify::UField(bf.name, unify::UType(Prim, f_up))
         unify::UType(Rec, flds)
      [Array a]
         unify::UType(Array, unify::UArray(utype_from_ti_env(env, a.1), a.2))
      [Enum slots]
         find_enum_utype_by_slots(env, slots) | named_ut => --| named_ut
         vars = unify::UEnumVariants()
         slots @ sl =>
            p_ut = sl.has_payload
               | utype_from_ti_env(env, sl.payload_record)
               | unify::UType(None)
            vars += unify::UEnumVariant(sl.label, sl.has_payload, p_ut)
         unify::UType(Enum, unify::UEnum("", vars))
      [Map m]
         k_ut = unify::UType(Prim, unify::vt_to_uprim(m.0))
         v_val = utype_from_ti_env(env, m.2)
         v_ut = v_val [None] unify::UType(Prim, unify::vt_to_uprim(m.1)) | v_val
         unify::UType(Map, unify::UMap(k_ut, v_ut))
      | unify::utype_from_type_info(ti)

resolve_user_ti_depth: type_env::TypeEnv, ast::TypeInfo, Int => ast::TypeInfo
resolve_user_ti_depth = env, ti, depth =>
   depth !< 16 | --| ti
   ti_res = resolve_ct_ti_aliases(env, ti)
   ti_res
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt
            | u => resolve_user_ti_depth(env, u.ti, depth + 1)
            |
               lookup_user_type_any_mod(env, tv)
                  | u2 => resolve_user_ti_depth(env, u2.ti, depth + 1)
                  | ti_res
      | ti_res

resolve_user_ti: type_env::TypeEnv, ast::TypeInfo => ast::TypeInfo
resolve_user_ti = env, ti => resolve_user_ti_depth(env, ti, 0)

is_bitfield_ti_env: type_env::TypeEnv, ast::TypeInfo => <>
is_bitfield_ti_env = env, ti =>
   resolve_user_ti(env, ti) [Bitfield]

is_growable_ti_env: type_env::TypeEnv, ast::TypeInfo => <>
is_growable_ti_env = env, ti =>
   resolve_user_ti(env, ti) [Array]

mark_bitfield_fields_whole: type_env::TypeEnv, String, ast::TypeInfo => ()
mark_bitfield_fields_whole = env, prefix, ti =>
   eff_ti = resolve_user_ti(env, ti)
   eff_ti
      [Rec r]
         r.0 @ fld =>
            fld.name != ""
               |
                  sub_path = prefix + "." + fld.name
                  is_sub_bf = is_bitfield_ti_env(env, fld.rec_type)
                  is_sub_bf
                     | type_env::init_mark_whole(env, sub_path)
                     | mark_bitfield_fields_whole(env, sub_path, fld.rec_type)
rec_elem_ti_env: ast::FieldTypes => ast::TypeInfo
rec_elem_ti_env = fields =>
   ?fields > 0
      |
         f = fields(0) | _ | ast::RecordFieldType("", ast::ValueType(Unknown),
           ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->, ast::Expr(Int, 0))
         f.rec_type
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

align_to: Int, Int => Int
align_to = offset, align =>
   align !> 1
      | offset
      |
         rem = offset % align
         rem == 0 | offset | offset + (align - rem)

annotate_type_align: type_env::TypeEnv, ast::ValueType, ast::TypeInfo => Int
annotate_type_align = env, vt, ti =>
   ptr_al = is_32bit_target! | 4 | 8
   eff_ti = resolve_user_ti(env, ti)
   eff_vt = eff_ti
      [Prim p] (p [Unknown] vt | p)
      | vt
   eff_ti
      [Align a]
         inner_al = annotate_type_align(env, eff_vt, a.1)
         a.0 < inner_al | inner_al | a.0
      [Bitfield] 1
      [Rec r]
         r.5 | 1 | ptr_al
      |
         eff_vt
            [I8, U8, Flag] 1
            [I16, U16] 2
            [I32, U32, F32, Rune] 4
            [Record] ptr_al
            [RawPtr, Fn, Str, Slice, Map, Builder] ptr_al
            [Error] 8
            | ptr_al

annotate_struct_size_packed: type_env::TypeEnv, ast::FieldTypes, Int, Int,
  Int => Int
annotate_struct_size_packed = env, fields, i, n, acc =>
   i == n
      | acc
      |
         f = fields(i) | _ | ast::RecordFieldType("", ast::ValueType(Unknown),
           ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->, ast::Expr(Int, 0))
         fsz = annotate_type_size(env, f.val_type, f.rec_type)
         annotate_struct_size_packed(env, fields, i + 1, n, acc + fsz)

annotate_struct_size_aligned: type_env::TypeEnv, ast::FieldTypes, Int, Int,
  Int, Int => Int
annotate_struct_size_aligned = env, fields, i, n, cur_off, max_al =>
   i == n
      | align_to(cur_off, max_al)
      |
         f = fields(i) | _ | ast::RecordFieldType("", ast::ValueType(Unknown),
           ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->, ast::Expr(Int, 0))
         fal = annotate_type_align(env, f.val_type, f.rec_type)
         new_max = max_al < fal | fal | max_al
         aligned_off = align_to(cur_off, fal)
         fsz = annotate_type_size(env, f.val_type, f.rec_type)
         annotate_struct_size_aligned(env, fields, i + 1, n, aligned_off + fsz,
           new_max)

annotate_type_size: type_env::TypeEnv, ast::ValueType, ast::TypeInfo => Int
annotate_type_size = env, vt, ti =>
   ptr_sz = is_32bit_target! | 4 | 8
   min_sz = ptr_sz * 2
   err_sz = is_32bit_target! | 48 | 56
   eff_ti = resolve_user_ti(env, ti)
   eff_vt = eff_ti
      [Prim p] (p [Unknown] vt | p)
      | vt
   eff_ti
      [Align a]
         inner_sz = annotate_type_size(env, eff_vt, a.1)
         align_to(inner_sz, a.0)
      [Bitfield b] b.total_bits / 8
      [Rec r]
         r.1
            | min_sz
            |
               r.2
                  |
                     elem_sz = annotate_type_size(env, r.3,
                       rec_elem_ti_env(r.0))
                     r.4 * elem_sz
                  |
                     r.5
                        | annotate_struct_size_packed(env, r.0, 0, ?r.0, 0)
                        |
                           sz = annotate_struct_size_aligned(env, r.0, 0, ?r.0,
                             0, 1)
                           sz < min_sz | min_sz | sz
      [Array] ptr_sz * 3
      [Map] min_sz
      [Fn] min_sz
      [Enum] min_sz
      [Ram r]
         s0 = r.0
         s1 = r.1
         has0 = s0.has_payload && s0.payload_type ![Unit]
         has1 = s1.has_payload && s1.payload_type ![Unit]
         !has0 && !has1
            | 1
            |
               is_niche0 = has0 && !has1 && (s0.payload_type [Str, Record, Error])
               is_niche1 = !has0 && has1 && (s1.payload_type [Str, Record, Error])
               is_niche0 || is_niche1 | ptr_sz | min_sz
      |
         eff_vt
            [I8, U8, Flag] 1
            [I16, U16] 2
            [I32, U32, F32, Rune] 4
            [Int, I64, U64, Float] 8
            [RawPtr] ptr_sz
            [Str, Slice, Map] ptr_sz * 2
            [Builder] ptr_sz * 3
            [Error] err_sz
            | ptr_sz

is_integerish_ut: unify::Ctx, unify::UType => <>
is_integerish_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Int, Rune, I8, I16, I32, I64, U8, U16, U32, U64]) | <->

is_int_or_ptr_ut: unify::Ctx, unify::UType => <>
is_int_or_ptr_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Int, Rune, I8, I16, I32, I64,
     U8, U16, U32, U64, RawPtr]) | <->

is_ptr_ut: unify::Ctx, unify::UType => <>
is_ptr_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [RawPtr]) | <->

is_builder_ut: unify::Ctx, unify::UType => <>
is_builder_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Builder]) | <->

is_str_ut: unify::Ctx, unify::UType => <>
is_str_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Str]) | <->

is_reserved_type_name: String => <>
is_reserved_type_name = ["Int", "i64", "i8", "i16", "i32", "u8", "u16", "u32", "u64",
  "i1", "<>", "Rune", "Float", "f64", "f32", "String", "void",
  "Addr", "ptr", "Builder", "Error", "Type"]

is_ufields_homogeneous: unify::Ctx, unify::UFields => <>
is_ufields_homogeneous = ctx, flds =>
   n = ?flds
   n < 2
      | <+>
      |
         f0 = flds(0) | _ | unify::UField("", unify::UType(None))
         homo' = <+>
         n @ i =>
            i > 0
               |
                  fi = flds(i) | _ | unify::UField("", unify::UType(None))
                  !unify::unify(ctx, f0.ut, fi.ut)
                     | (homo' = <->; -->)
         homo'

check_swizzle_pattern: unify::Ctx, String, unify::UFields, String => Int
check_swizzle_pattern = ctx, mode, flds, fname =>
   mode == "none"
      | 0
      |
         flen = ?fname
         flen < 1 || flen > 4
            | 0
            |
               !is_ufields_homogeneous(ctx, flds) || ?flds == 0
                  | 0
                  |
                     has_xyzw' = <->
                     has_rgba' = <->
                     all_match' = <+>
                     oob' = <->
                     bad_ch' = ++""
                     nf = ?flds
                     flen @ i =>
                        ch = fname(i)
                        ch_str = fname(i..i + 1)
                        f_idx = unify::find_field_idx(flds, ch_str)
                        f_idx !< 0
                           |
                              f_idx !< nf
                                 | (oob' = <+>; bad_ch' = ++ch_str)
                           |
                              is_xyzw = ch == 'x || ch == 'y || ch == 'z || ch == 'w
                              is_rgba = ch == 'r || ch == 'g || ch == 'b || ch == 'a
                              allowed = mode == "all" | (is_xyzw || is_rgba) |
                                 (mode == "xyzw" | is_xyzw | (mode == "rgba" | is_rgba | <->))
                              !allowed
                                 | (all_match' = <->; -->)
                                 |
                                    is_xyzw | (has_xyzw' = <+>)
                                    is_rgba | (has_rgba' = <+>)
                                    p_idx = ch == 'x || ch == 'r | 0 |
                                       (ch == 'y || ch == 'g | 1 |
                                       (ch == 'z || ch == 'b | 2 | 3))
                                    p_idx !< nf
                                       | (oob' = <+>; bad_ch' = ++ch_str)
                     !all_match'
                        | 0
                        |
                           mode == "all" && has_xyzw' && has_rgba'
                              |
                                 unify::add_error(ctx, 3043,
                                   "Cannot mix 'xyzw' and 'rgba' swizzle components in '" +
                                   fname + "'")
                                 2
                              |
                                 oob'
                                    |
                                       unify::add_error(ctx, 3043,
                                         "Swizzle component '" + bad_ch' +
                                         "' out of bounds for " +
                                         str::from_int(nf) + "-element vector")
                                       2
                                    | 1

view_vars = ast::Names()
declared_fns = ast::Names()
called_fns = ast::Names()
user_fns = ast::Names()
value_used_fns = ast::Names()
fn_alias_vars = ast::Names()
fn_alias_tgts = ast::Names()

has_name_in: ast::Names, String => <>
has_name_in = names, name =>
   found' = <->
   names @ n =>
      n == name | (found' = <+>; -->)
   found'

is_view_name: String => <>
is_view_name = name =>
   has_name_in(view_vars, name)

add_view_name: String => ()
add_view_name = name =>
   !is_view_name(name)
      | (view_vars += name)

expr_refs_var_list: ast::Exprs, String => <>
expr_refs_var_name: ast::Expr, String => <>
expr_refs_var_name = e, vname =>
   e
      [Var v] v == vname
      [Member m]
         (!m.is_module_access && expr_refs_var_name(m.target, vname)) ||
           expr_refs_var_name(m.index_expr, vname)
      [Call c]
         c.fn_name == vname || expr_refs_var_name(c.fn_target, vname) ||
           expr_refs_var_list(c.args, vname)
      [Assign a]
         a.0 == vname || expr_refs_var_name(a.5, vname) ||
           expr_refs_var_name(a.6, vname)
      [Block bs] expr_refs_var_list(bs, vname)
      [Bin b] expr_refs_var_name(b.1, vname) || expr_refs_var_name(b.2, vname)
      [Unary u] expr_refs_var_name(u.1, vname)
      [Record r]
         r.fields @ f =>
            expr_refs_var_name(f.val, vname) | --| <+>
         <->
      [Variant v] expr_refs_var_list(v.args, vname)
      [MapLiteral ml]
         ml @ p =>
            (expr_refs_var_name(p.key, vname) || expr_refs_var_name(p.value, vname)) | --| <+>
         <->
      [Choice ch]
         expr_refs_var_name(ch.cond, vname) | --| <+>
         ch.branches @ br =>
            (!has_name_in(br.bind_vars, vname) && expr_refs_var_name(br.block, vname)) | --| <+>
         <->
      [Cycle cy]
         expr_refs_var_name(cy.iterable, vname) || expr_refs_var_name(cy.body_fn, vname)
      [CycleEscape ce]
         expr_refs_var_name(ce.cycle, vname) || expr_refs_var_name(ce.branch, vname)
      [Fn fe] !has_name_in(fe.params, vname) && expr_refs_var_name(fe.body, vname)
      [Return r] r.has_val && expr_refs_var_name(r.val, vname)
      [TypeCast tc] expr_refs_var_name(tc.expr, vname)
      [NamedArg na] expr_refs_var_name(na.val, vname)
      [RawMemory rm] expr_refs_var_name(rm.addr, vname)
      [KeyAccess ka] expr_refs_var_name(ka.target, vname) || expr_refs_var_name(ka.key, vname)
      | <->

expr_refs_var_list = es, vname =>
   es @ e =>
      expr_refs_var_name(e, vname) | --| <+>
   <->

fn_captures_view: ast::FnExpr => <>
fn_captures_view = fe =>
   view_vars @ vn =>
      (!has_name_in(fe.params, vn) && expr_refs_var_name(fe.body, vn)) | --| <+>
   <->

is_view_expr: ast::Expr => <>
is_view_expr = e =>
   e
      [Var v] is_view_name(v)
      [RawMemory rm] rm.rec_name != ""
      [Block b]
         b(?b - 1) | last_e => is_view_expr(last_e) | <->
      [Choice c]
         c.branches @ br =>
            is_view_expr(br.block) | --| <+>
         <->
      [Record r]
         r.fields @ f =>
            is_view_expr(f.val) | --| <+>
         <->
      [Variant v]
         v.args @ a =>
            is_view_expr(a) | --| <+>
         <->
      [MapLiteral ml]
         ml @ p =>
            (is_view_expr(p.key) || is_view_expr(p.value)) | --| <+>
         <->
      [NamedArg na] is_view_expr(na.val)
      [Fn fe] fn_captures_view(fe) || is_view_expr(fe.body)
      [Call cc]
         is_ctor = cc.fn_name != "" && !has_name_in(user_fns, cc.fn_name) &&
           !has_name_in(declared_fns, cc.fn_name)
         is_ctor
            |
               cc.args @ a =>
                  is_view_expr(a) | --| <+>
               <->
            | <->
      | <->

is_builder_append_prim: unify::UPrim => <>
is_builder_append_prim = [Int, Rune, Str, I8, I16, I32, I64, U8, U16, U32, U64]

is_builder_append_rec: unify::Ctx, unify::UFields, Int, Int => <>
is_builder_append_rec = ctx, fields, i, n =>
   i == n
      | <+>
      |
         fld = fields(i) | _ | unify::UField("", unify::UType(None))
         c_fld = unify::canon(ctx, fld.ut)
         ok = c_fld [Prim pr] is_builder_append_prim(pr) | (c_fld [Var])
         ok
            | is_builder_append_rec(ctx, fields, i + 1, n)
            | <->

is_rune_ut: unify::Ctx, unify::UType => <>
is_rune_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Rune]) | <->

is_float_ut: unify::Ctx, unify::UType => <>
is_float_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Float, F32]) | <->

rec_all_fields_homogeneous: unify::Ctx, unify::UFields => <>
rec_all_fields_homogeneous = ctx, flds =>
   ?flds == 0 | --| <->
   f0_ut = flds(0)!!.ut
   flds @ el_, i =>
      i > 0 && !utype_eq(ctx, f0_ut, el_.ut) | --| <->
   <+>

is_known_type_pred: String => <>
is_known_type_pred = ["is_record", "is_enum", "is_ram", "is_fn", "is_unit",
  "is_homogeneous", "is_array", "is_slice", "is_map", "is_indexable",
  "is_iterable", "is_scalar", "is_int", "is_float", "is_numeric", "is_pointer"]

type_pred_name_from_str: String => String
type_pred_name_from_str = s =>
   cand = (?s > 6 && s(0..6) == "type::") | s(6..) | s
   is_known_type_pred(cand) | cand | ""

type_pred_name_from_expr: ast::Expr => String
type_pred_name_from_expr = e =>
   e
      [Member m]
         vname = m.target [Var v] v | ""
         (m.is_module_access || vname == "type")
            | type_pred_name_from_str(m.field_name)
            | ""
      [Var v] type_pred_name_from_str(v)
      | ""

is_allowed_type_pred_call: type_env::TypeEnv, ast::CallExpr, String => <>
is_allowed_type_pred_call = env, ce, pred =>
   pred == "" | --| <->
   ce.fn_name != "" && ?ce.fn_name > 6 && ce.fn_name(0..6) == "type::" | --| <+>
   ce.fn_name == ""
      |
         ce.fn_target
            [Member m]
               m_v = m.target [Var mv] mv | ""
               --| (m.is_module_access || m_v == "type")
            | --| <->
   bnd = type_env::lookup_binding(env, ce.fn_name)
   bnd
      | b => ?b.name > 6 && b.name(0..6) == "type::"
      | !<>(type_env::lookup_generic(env, ce.fn_name))

eval_utype_predicate: unify::Ctx, String, unify::UType => <>
eval_utype_predicate = ctx, pred, ut =>
   c = unify::canon(ctx, ut)
   is_rec = c [Rec]
   is_empty_rec = c [Rec flds] (?flds == 0) | <->
   is_homo_rec = c [Rec flds] rec_all_fields_homogeneous(ctx, flds) | <->
   is_unit_prim = c [Prim p] (p [Unit]) | <->
   is_flag_prim = c [Prim p] (p [Flag]) | <->
   is_str_prim = c [Prim p] (p [Str]) | <->
   is_ptr_prim = c [Prim p] (p [RawPtr]) | <->
   is_int = is_integerish_ut(ctx, c)
   is_flt = is_float_ut(ctx, c)
   is_coll = c [Array, Slice, Map]
   pred
      ["is_record"] is_rec || is_unit_prim
      ["is_enum"] c [Enum]
      ["is_ram"] (c [Ram]) || is_flag_prim
      ["is_fn"] c [Fn]
      ["is_unit"] is_unit_prim || is_empty_rec
      ["is_homogeneous"] is_homo_rec
      ["is_array"] c [Array]
      ["is_slice"] c [Slice]
      ["is_map"] c [Map]
      ["is_indexable"] is_coll || is_str_prim || is_homo_rec
      ["is_iterable"] is_coll || is_int || is_homo_rec
      ["is_scalar"] is_int || is_flt || is_ptr_prim || is_flag_prim
      ["is_int"] is_int
      ["is_float"] is_flt
      ["is_numeric"] is_int || is_flt
      ["is_pointer"] is_ptr_prim
      | <->

is_numeric_ut: unify::Ctx, unify::UType => <>
is_numeric_ut = ctx, ut =>
   is_integerish_ut(ctx, ut) || is_float_ut(ctx, ut)

is_flag_ut: unify::Ctx, unify::UType => <>
is_flag_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Flag]) | <->

make_rec_of: Int, unify::UType => unify::UType
make_rec_of = n, elem_ut =>
   flds = unify::UFields()
   n @ flds += unify::UField("", elem_ut)
   unify::UType(Rec, flds)

is_same_uprim: unify::UType, unify::UType => <>
is_same_uprim = u1, u2 =>
   u1 [Prim p1] (u2 [Prim p2] (p1 == p2) | <->) | <->

is_numeric_rec: unify::Ctx, unify::UType => <>
is_numeric_rec = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         n = ?flds
         n == 0
            | <->
            |
               f0 = flds(0) | _ | unify::UField("", unify::UType(None))
               e_ut = unify::canon(ctx, f0.ut)
               is_num = is_numeric_ut(ctx, e_ut)
               is_num
                  |
                     all_same' = <+>
                     flds @ fi =>
                        fi_ut = unify::canon(ctx, fi.ut)
                        same = is_same_uprim(e_ut, fi_ut)
                        !same | (all_same' = <->; -->)
                     all_same'
                  | <->
      | <->

rec_count: unify::Ctx, unify::UType => Int
rec_count = ctx, u =>
   c = unify::canon(ctx, u)
   c [Rec flds] ?flds | 0

rec_elem: unify::Ctx, unify::UType => unify::UType
rec_elem = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         ?flds > 0
            |
               f0 = flds(0) | _ | unify::UField("", unify::UType(None))
               f0.ut
            | unify::UType(None)
      | unify::UType(None)

is_cmp_rec: unify::Ctx, unify::UType => <>
is_cmp_rec = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         n = ?flds
         n == 0
            | <->
            |
               f0 = flds(0) | _ | unify::UField("", unify::UType(None))
               e_ut = unify::canon(ctx, f0.ut)
               is_ok = is_numeric_ut(ctx, e_ut) || is_flag_ut(ctx, e_ut)
               is_ok
                  |
                     all_same' = <+>
                     flds @ fi =>
                        fi_ut = unify::canon(ctx, fi.ut)
                        same = is_same_uprim(e_ut, fi_ut)
                        !same | (all_same' = <->; -->)
                     all_same'
                  | <->
      | <->

iter_elem_ti: unify::Ctx, ast::TypeInfo, unify::UType => ast::TypeInfo
iter_elem_ti = ctx, iter_ti, elem_ut =>
   from_iter = iter_ti
      [Array a] a.1
      [Map m] m.2
      [Rec r]
         ?r.0 > 0
            | (r.0(0) | _ | ast::RecordFieldType("", ast::ValueType(Unknown),
              ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->,
              ast::Expr(Int, 0))).rec_type
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))
   is_unk = from_iter [Prim p] (p [Unknown]) | <->
   is_tvar = from_iter [TypeVar tv] (?tv > 0 && tv(0) == '?) | <->
   (is_unk || is_tvar)
      | unify::type_info_from_utype(ctx, elem_ut)
      | from_iter

cycle_iter_elem_info: unify::Ctx, tast::TypedExpr, <> => (<>, unify::UType)
cycle_iter_elem_info = ctx, iter_te, is_rune =>
   c_iter = unify::canon(ctx, iter_te.ut)
   is_rune
      |
         is_s = is_str_ut(ctx, iter_te.ut) || is_builder_ut(ctx, iter_te.ut)
         !is_s
            |
               unify::add_error(ctx, 3084,
                 "Codepoint cycle (@@) requires String iterable")
   is_rune
      | (<+>, unify::prim_rune!)
      |
         c_iter
            [Array arr] (<+>, arr.elem)
            [Slice sl] (<+>, sl)
            [Map m] (<+>, m.val)
            [Prim p]
               p
                  [Str, Builder] (<+>, unify::prim_int!)
                  [Rune] (<+>, unify::prim_rune!)
                  [Int] (<->, unify::prim_int!)
                  | (<->, unify::fresh_var(ctx))
            [Rec r]
               !is_ufields_homogeneous(ctx, r)
                  |
                     unify::add_error(ctx, 3051, diag::E3051_cycle_iter_hetero!)
               r_elem = ?r > 0
                  | (r(0) | _ | unify::UField("", unify::UType(None))).ut
                  | unify::fresh_var(ctx)
               (<+>, r_elem)
            | (<->, unify::fresh_var(ctx))

collect_ct_cycle_called: ast::Names, String => ()
collect_ct_cycle_called = aliases_dummy, fname =>
   fname != ""
      |
         !has_name_in(called_fns, fname)
            | (called_fns += fname)
         ?fn_alias_vars @ ai =>
            avn = fn_alias_vars(ai) | _ | ""
            has_name_in(called_fns, avn)
               |
                  tgt = fn_alias_tgts(ai) | _ | ""
                  tgt != "" && !has_name_in(called_fns, tgt)
                     | (called_fns += tgt)

collect_ct_cycle_refs_list: unify::Ctx, type_env::TypeEnv, ast::Exprs => ()
collect_ct_cycle_refs_list = ctx, env, es =>
   es @ e => collect_ct_cycle_refs(ctx, env, e)

collect_ct_cycle_refs: unify::Ctx, type_env::TypeEnv, ast::Expr => ()
collect_ct_cycle_refs = ctx, env, e =>
   e
      [Call c]
         collect_ct_cycle_called(called_fns, c.fn_name)
         collect_ct_cycle_refs(ctx, env, c.fn_target)
         collect_ct_cycle_refs_list(ctx, env, c.args)
      [Spawn sp]
         collect_ct_cycle_called(called_fns, sp.fn_name)
         collect_ct_cycle_refs(ctx, env, sp.fn_target)
         collect_ct_cycle_refs_list(ctx, env, sp.args)
      [Assign a]
         a.0 != ""
            | type_env::init_mark_whole(env, a.0)
            |
               a.6
                  [Member mm]
                     root = member_root_name(mm.target)
                     root != "" | type_env::init_mark_whole(env, root)
         collect_ct_cycle_refs(ctx, env, a.5)
         collect_ct_cycle_refs(ctx, env, a.6)
      [Var v]
         has_name_in(user_fns, v) && !has_name_in(value_used_fns, v)
            | (value_used_fns += v)
      [Bin b]
         collect_ct_cycle_refs(ctx, env, b.1)
         collect_ct_cycle_refs(ctx, env, b.2)
      [Unary u] collect_ct_cycle_refs(ctx, env, u.1)
      [Block bs] collect_ct_cycle_refs_list(ctx, env, bs)
      [Fn fe] collect_ct_cycle_refs(ctx, env, fe.body)
      [Record rec]
         rec.fields @ rf => collect_ct_cycle_refs(ctx, env, rf.val)
      [MapLiteral ml]
         ml @ p =>
            collect_ct_cycle_refs(ctx, env, p.key)
            collect_ct_cycle_refs(ctx, env, p.value)
      [Member m]
         collect_ct_cycle_refs(ctx, env, m.target)
         collect_ct_cycle_refs(ctx, env, m.index_expr)
      [KeyAccess ka]
         collect_ct_cycle_refs(ctx, env, ka.target)
         collect_ct_cycle_refs(ctx, env, ka.key)
      [NamedArg na] collect_ct_cycle_refs(ctx, env, na.val)
      [Variant v] collect_ct_cycle_refs_list(ctx, env, v.args)
      [Choice ch]
         collect_ct_cycle_refs(ctx, env, ch.cond)
         ch.branches @ br =>
            collect_ct_cycle_refs_list(ctx, env, br.case_values)
            collect_ct_cycle_refs(ctx, env, br.pred_fn)
            collect_ct_cycle_refs(ctx, env, br.block)
      [Cycle cy]
         collect_ct_cycle_refs(ctx, env, cy.iterable)
         collect_ct_cycle_refs(ctx, env, cy.body_fn)
      [CycleEscape ce]
         collect_ct_cycle_refs(ctx, env, ce.cycle)
         collect_ct_cycle_refs(ctx, env, ce.branch)
      [Range r]
         r.has_lhs | collect_ct_cycle_refs(ctx, env, r.lhs)
         r.has_rhs | collect_ct_cycle_refs(ctx, env, r.rhs)
      [Return r]
         r.has_val | collect_ct_cycle_refs(ctx, env, r.val)
      [Copy cp] collect_ct_cycle_refs(ctx, env, cp)
      [CompileTime ct] collect_ct_cycle_refs(ctx, env, ct)
      [Join jn] collect_ct_cycle_refs(ctx, env, jn)
      [Exit ex] collect_ct_cycle_refs(ctx, env, ex)
      [BuilderCreate bc] collect_ct_cycle_refs(ctx, env, bc)
      [TypeCast tc] collect_ct_cycle_refs(ctx, env, tc.expr)
      [RawMemory rm] collect_ct_cycle_refs(ctx, env, rm.addr)
      [UserDiag ud] collect_ct_cycle_refs(ctx, env, ud.msg)

/// Collects `Var` and `Assign` target names while alpha-renaming iteration-local variables.
collect_assign_lhs_exprs: ast::Exprs, ast::Names => ()

collect_assign_lhs: ast::Expr, ast::Names => ()
collect_assign_lhs = e, out =>
   e
      [Assign a]
         a.0 != "" && !a.2 && !a.3 && !a.4 && !has_name_in(out, a.0)
            | (out += a.0)
         collect_assign_lhs(a.5, out)
      [Block bs] collect_assign_lhs_exprs(bs, out)
      [Choice ch]
         ch.branches @ br => collect_assign_lhs(br.block, out)
      [Call c] collect_assign_lhs_exprs(c.args, out)
      [Bin b]
         collect_assign_lhs(b.1, out)
         collect_assign_lhs(b.2, out)
      [Unary u] collect_assign_lhs(u.1, out)
      [Member m] collect_assign_lhs(m.target, out)
      [Return r]
         r.has_val | collect_assign_lhs(r.val, out)

collect_assign_lhs_exprs = es, out =>
   es @ e => collect_assign_lhs(e, out)

lookup_rename: ast::Names, ast::Names, String => String
lookup_rename = old_ns, new_ns, name =>
   ?old_ns @ i =>
      old_ns(i)!! == name | --| new_ns(i)!!
   name

filter_shadows: ast::Names, ast::Names, ast::Names, ast::Names, ast::Names => (ast::Names, ast::Names)
filter_shadows = old_ns, new_ns, shadows, out_old, out_new =>
   ?old_ns @ i =>
      on = old_ns(i)!!
      !has_name_in(shadows, on)
         |
            out_old += on
            out_new += new_ns(i)!!
   (out_old, out_new)

rename_ast_exprs: ast::Exprs, ast::Names, ast::Names => ast::Exprs
rename_ast_fields: ast::Fields, ast::Names, ast::Names => ast::Fields
rename_ast_branches: ast::Branches, ast::Names, ast::Names => ast::Branches

rename_ast_expr: ast::Expr, ast::Names, ast::Names => ast::Expr
rename_ast_expr = e, old_ns, new_ns =>
   ?old_ns == 0 | --| e
   e
      [Var v] ast::Expr(Var, lookup_rename(old_ns, new_ns, v))
      [Assign a]
         new_rhs = rename_ast_expr(a.5, old_ns, new_ns)
         new_init = rename_ast_expr(a.6, old_ns, new_ns)
         new_lhs = lookup_rename(old_ns, new_ns, a.0)
         ast::Expr(Assign, (new_lhs, a.1, a.2, a.3, a.4, new_rhs, new_init, a.7, a.8))
      [Block bs] ast::Expr(Block, rename_ast_exprs(bs, old_ns, new_ns))
      [Bin b] ast::Expr(Bin, (b.0, rename_ast_expr(b.1, old_ns, new_ns),
         rename_ast_expr(b.2, old_ns, new_ns)))
      [Unary u] ast::Expr(Unary, (u.0, rename_ast_expr(u.1, old_ns, new_ns)))
      [Call c]
         new_fn = lookup_rename(old_ns, new_ns, c.fn_name)
         ast::Expr(Call, ast::CallExpr(new_fn,
            rename_ast_expr(c.fn_target, old_ns, new_ns),
            rename_ast_exprs(c.args, old_ns, new_ns), c.line, c.col))
      [Spawn c]
         new_fn = lookup_rename(old_ns, new_ns, c.fn_name)
         ast::Expr(Spawn, ast::CallExpr(new_fn,
            rename_ast_expr(c.fn_target, old_ns, new_ns),
            rename_ast_exprs(c.args, old_ns, new_ns), c.line, c.col))
      [Record rec]
         ast::Expr(Record, ast::RecordExpr(
            rename_ast_fields(rec.fields, old_ns, new_ns), rec.is_repeat))
      [Member m]
         ast::Expr(Member, ast::MemberExpr(
            rename_ast_expr(m.target, old_ns, new_ns), m.field_name,
            m.is_module_access, rename_ast_expr(m.index_expr, old_ns, new_ns),
            m.line, m.col))
      [KeyAccess ka]
         ast::Expr(KeyAccess, ast::KeyAccessExpr(
            rename_ast_expr(ka.target, old_ns, new_ns),
            rename_ast_expr(ka.key, old_ns, new_ns),
            ka.is_membership, ka.is_delete, ka.line, ka.col))
      [NamedArg na]
         ast::Expr(NamedArg, ast::NamedArgExpr(na.name,
            rename_ast_expr(na.val, old_ns, new_ns)))
      [Variant v]
         ast::Expr(Variant, ast::VariantExpr(v.tag_name,
            rename_ast_exprs(v.args, old_ns, new_ns)))
      [Choice ch]
         ast::Expr(Choice, ast::ChoiceExpr(
            rename_ast_expr(ch.cond, old_ns, new_ns), ch.is_exhaustive,
            rename_ast_branches(ch.branches, old_ns, new_ns)))
      [Fn fe]
         sh = filter_shadows(old_ns, new_ns, fe.params, ast::Names(), ast::Names())
         ast::Expr(Fn, ast::FnExpr(fe.params, fe.ct_params,
            rename_ast_expr(fe.body, sh.0, sh.1), fe.line, fe.col))
      [Cycle cy]
         new_it = rename_ast_expr(cy.iterable, old_ns, new_ns)
         new_bf = cy.body_fn
            [Fn fe]
               sh = filter_shadows(old_ns, new_ns, fe.params, ast::Names(), ast::Names())
               ast::Expr(Fn, ast::FnExpr(fe.params, fe.ct_params,
                  rename_ast_expr(fe.body, sh.0, sh.1), fe.line, fe.col))
            | rename_ast_expr(cy.body_fn, old_ns, new_ns)
         ast::Expr(Cycle, ast::CycleExpr(new_it, new_bf, cy.is_rune, cy.is_expr))
      [Range r]
         ast::Expr(Range, ast::RangeExpr(r.has_lhs, r.has_rhs,
            r.has_lhs | rename_ast_expr(r.lhs, old_ns, new_ns) | r.lhs,
            r.has_rhs | rename_ast_expr(r.rhs, old_ns, new_ns) | r.rhs,
            r.is_inclusive))
      [Return r]
         ast::Expr(Return, ast::ReturnExpr(r.has_val,
            r.has_val | rename_ast_expr(r.val, old_ns, new_ns) | r.val,
            r.line, r.col))
      [Copy cp] ast::Expr(Copy, rename_ast_expr(cp, old_ns, new_ns))
      [Join jn] ast::Expr(Join, rename_ast_expr(jn, old_ns, new_ns))
      [Exit ex] ast::Expr(Exit, rename_ast_expr(ex, old_ns, new_ns))
      [BuilderCreate bc] ast::Expr(BuilderCreate, rename_ast_expr(bc, old_ns, new_ns))
      [TypeCast tc] ast::Expr(TypeCast, ast::CastExpr(tc.target_type,
         rename_ast_expr(tc.expr, old_ns, new_ns)))
      [RawMemory rm] ast::Expr(RawMemory, ast::RawMemoryExpr(
         rename_ast_expr(rm.addr, old_ns, new_ns), rm.load_type, rm.rec_name))
      [MapLiteral ml]
         new_ml = ast::MapPairs()
         ml @ p =>
            new_ml += ast::MapPair(rename_ast_expr(p.key, old_ns, new_ns),
               rename_ast_expr(p.value, old_ns, new_ns))
         ast::Expr(MapLiteral, new_ml)
      | e

rename_ast_exprs = es, old_ns, new_ns =>
   out = ast::Exprs()
   es @ e => out += rename_ast_expr(e, old_ns, new_ns)
   out

rename_ast_fields = flds, old_ns, new_ns =>
   out = ast::Fields()
   flds @ f => out += ast::RecordField(f.has_name, f.name,
      rename_ast_expr(f.val, old_ns, new_ns))
   out

rename_ast_branches = brs, old_ns, new_ns =>
   out = ast::Branches()
   brs @ br =>
      sh = filter_shadows(old_ns, new_ns, br.bind_vars, ast::Names(), ast::Names())
      out += ast::ChoiceBranch(br.kind, rename_ast_exprs(br.case_values, old_ns, new_ns),
         rename_ast_expr(br.pred_fn, old_ns, new_ns), br.variant_names,
         br.bind_vars, br.is_identity_extractor,
         rename_ast_expr(br.block, sh.0, sh.1))
   out

/// Alpha-renames iteration-local `Assign` variables so unrolled iterations have unique storage.
alpha_rename_iter_body: type_env::TypeEnv, ast::Names, ast::Expr => ast::Expr
alpha_rename_iter_body = env, loop_params, body =>
   cands = ast::Names()
   collect_assign_lhs(body, cands)
   old_ns = ast::Names()
   new_ns = ast::Names()
   ?cands > 0
      |
         unroll_seq ::= unroll_seq + 1
         seq = str::from_int(unroll_seq)
         cands @ c =>
            !has_name_in(loop_params, c) &&
              !<>(type_env::lookup_binding(env, c)) &&
              !<>(lookup_ct_val(c)) &&
              !<>(lookup_ct_cursor(c)) &&
              !<>(lookup_ct_int(c))
               |
                  old_ns += c
                  new_ns += "${c}$u${seq}"
   ?old_ns > 0 | rename_ast_expr(body, old_ns, new_ns) | body

cycle_uses_ct_index_exprs: ast::Exprs, String => <>

cycle_uses_ct_index: ast::Expr, String => <>
cycle_uses_ct_index = e, pname =>
   e
      [Member m]
         !m.is_module_access
            |
               idx_hit = m.index_expr [Var v] (v == pname || v == "_") | <->
               idx_hit || cycle_uses_ct_index(m.target, pname) ||
                 cycle_uses_ct_index(m.index_expr, pname)
            | <->
      [Call c]
         ct_m3 = c.fn_name == "#member3" && ?c.args == 3 &&
           (c.args(1)!! [Var v] (v == pname || v == "_") | <->)
         ct_m3 || cycle_uses_ct_index(c.fn_target, pname) ||
           cycle_uses_ct_index_exprs(c.args, pname)
      [Assign a]
         cycle_uses_ct_index(a.5, pname) || cycle_uses_ct_index(a.6, pname)
      [Block bs] cycle_uses_ct_index_exprs(bs, pname)
      [Bin b] cycle_uses_ct_index(b.1, pname) || cycle_uses_ct_index(b.2, pname)
      [Unary u] cycle_uses_ct_index(u.1, pname)
      [Record r]
         r.fields @ f => cycle_uses_ct_index(f.val, pname) | --| <+>
         <->
      [Choice ch]
         cycle_uses_ct_index(ch.cond, pname) | --| <+>
         ch.branches @ br =>
            cycle_uses_ct_index(br.block, pname) | --| <+>
         <->
      [Cycle cy]
         cycle_uses_ct_index(cy.iterable, pname) ||
           cycle_uses_ct_index(cy.body_fn, pname)
      [Fn fe] !has_name_in(fe.params, pname) && cycle_uses_ct_index(fe.body, pname)
      [Return r] r.has_val && cycle_uses_ct_index(r.val, pname)
      [TypeCast tc] cycle_uses_ct_index(tc.expr, pname)
      | <->

cycle_uses_ct_index_exprs = es, pname =>
   es @ e => cycle_uses_ct_index(e, pname) | --| <+>
   <->

extract_cycle_body_parts: ast::CycleExpr => (ast::Names, ast::Expr)
extract_cycle_body_parts = c =>
   c.body_fn
      [Fn fe] (fe.params, fe.body)
      |
         callee = apply_callee_name(c.body_fn)
         callee != ""
            |
               pns = ast::Names()
               pns += "_"
               cargs = ast::Exprs()
               cargs += ast::Expr(Var, "_")
               (pns, ast::Expr(Call, ast::CallExpr(callee, ast::Expr(Var, ""),
                  cargs, 0, 0)))
            | (ast::Names(), c.body_fn)

unroll_members_cycle: unify::Ctx, type_env::TypeEnv, ast::CycleExpr,
  unify::UType, ast::TypeInfo => tast::TypedExpr
unroll_members_cycle = ctx, env, c, target_ut, target_ti =>
   c_rt = unify::canon(ctx, target_ut)
   parts = extract_cycle_body_parts(c)
   pns = parts.0
   raw_body = parts.1
   p0 = pns(0) | _ | "_"
   p1 = pns(1) | _ | ""
   cur_vname = p0 == "" | "_" | p0
   eff_ti2 = resolve_user_ti(env, target_ti)
   iter_tes = tast::TypedExprs()
   c_rt
      [Rec flds]
         rec_ftis = eff_ti2 [Rec rti] rti.0 | ast::FieldTypes()
         ?flds @ idx =>
            uf = flds(idx)!!
            rft_opt = idx < ?rec_ftis | <+ rec_ftis(idx)!! +> | <-->
            f_name = uf.name
            f_ti = rft_opt
               | rft => resolve_ct_ti_aliases(env, rft.rec_type)
               | unify::type_info_from_utype(ctx, uf.ut)
            has_def = rft_opt | rft => rft.has_default | <->
            def_e = rft_opt | rft => rft.default_expr | ast::Expr(Int, 0)
            saved_cur_n = ?cur_ct_cursors
            saved_int_n = ?cur_ct_ints
            push_ct_cursor(CtCursorBind(cur_vname, eff_ti2, idx, f_name,
               uf.ut, f_ti, has_def, def_e))
            p1 != "" && p1 != "_" | push_ct_int(p1, idx)
            body_i = alpha_rename_iter_body(env, pns, raw_body)
            env.discard_result = <+>
            iter_tes += annotate_expr(ctx, env, body_i)
            pop_ct_ints_to(saved_int_n)
            pop_ct_cursors_to(saved_cur_n)
      [Enum uenum_raw]
         uenum' = uenum_raw
         ?uenum'.variants == 0 && uenum'.name != ""
            |
               type_env::lookup_user_type(env, uenum'.name)
                  | ude =>
                     unify::canon(ctx, ude.ut)
                        [Enum uer] (uenum' = uer)
         eslots = eff_ti2 [Enum sls] sls | ast::EnumSlots()
         ?uenum'.variants @ idx =>
            uv = uenum'.variants(idx)!!
            v_ut = uv.has_payload | uv.payload_type | unify::prim_unit!
            v_ti = (idx < ?eslots && uv.has_payload)
               | resolve_ct_ti_aliases(env, (eslots(idx)!!).payload_record)
               | (uv.has_payload
                  | unify::type_info_from_utype(ctx, v_ut)
                  | ast::TypeInfo(Prim, ast::ValueType(Unit)))
            saved_cur_n = ?cur_ct_cursors
            saved_int_n = ?cur_ct_ints
            push_ct_cursor(CtCursorBind(cur_vname, eff_ti2, idx, uv.label,
               v_ut, v_ti, <->, ast::Expr(Int, 0)))
            p1 != "" && p1 != "_" | push_ct_int(p1, idx)
            body_i = alpha_rename_iter_body(env, pns, raw_body)
            env.discard_result = <+>
            iter_tes += annotate_expr(ctx, env, body_i)
            pop_ct_ints_to(saved_int_n)
            pop_ct_cursors_to(saved_cur_n)
   tast::mk_typed_expr(tast::TypedExprKind(Block, iter_tes),
     unify::prim_unit!, ast::TypeInfo(Prim, ast::ValueType(Unit)),
     tast::layout_void!, 0, 0)

annotate_cycle: unify::Ctx, type_env::TypeEnv, ast::CycleExpr,
  <ast::Expr|> => tast::TypedExpr
annotate_cycle = ctx, env, c, esc_expr_opt =>
   is_members_iter = c.iterable
      [Member mi] !mi.is_module_access && mi.field_name == "#members"
      | <->
   is_members_iter
      |
         mi_tgt = c.iterable [Member mi] mi.target | c.iterable
         rt = resolve_type_expr_ut_ti(ctx, env, "", mi_tgt)
         c_rt = rt.2 | unify::canon(ctx, rt.0) | unify::UType(None)
         (c_rt [Rec, Enum])
            | --| unroll_members_cycle(ctx, env, c, rt.0, rt.1)
         ok_t = rt.2 && (c_rt [Rec, Enum, Var])
         !ok_t
            | unify::add_error(ctx, 3084, "'#members' requires a record or enum type.")
         collect_ct_cycle_refs(ctx, env, c.body_fn)
         --| tast::mk_typed_expr(tast::TypedExprKind(CtUnrollCycle, c),
           unify::prim_unit!, ast::TypeInfo(Prim, ast::ValueType(Unit)),
           tast::layout_void!, 0, 0)
   c.iterable
      [Range rng]
         parts_r = extract_cycle_body_parts(c)
         p0_r = parts_r.0(0) | _ | "_"
         p0_name = p0_r == "" | "_" | p0_r
         !c.is_expr && !<>(esc_expr_opt) &&
           rng.has_rhs && cycle_uses_ct_index(parts_r.1, p0_name)
            |
               lhs_opt = rng.has_lhs
                  | eval_static_int_expr(ctx, env, rng.lhs)
                  | <+ 0 +>
               rhs_opt = eval_static_int_expr(ctx, env, rng.rhs)
               lhs_opt
                  | start_i =>
                     rhs_opt
                        | end_i =>
                           count = rng.is_inclusive
                              | (end_i - start_i + 1)
                              | (end_i - start_i)
                           count !< 0 && count < 4096
                              |
                                 iter_tes = tast::TypedExprs()
                                 p1_r = parts_r.0(1) | _ | ""
                                 count @ k =>
                                    iv = start_i + k
                                    saved_in = ?cur_ct_ints
                                    push_ct_int(p0_name, iv)
                                    p1_r != "" && p1_r != "_" | push_ct_int(p1_r, k)
                                    body_k = alpha_rename_iter_body(env, parts_r.0, parts_r.1)
                                    env.discard_result = <+>
                                    iter_tes += annotate_expr(ctx, env, body_k)
                                    pop_ct_ints_to(saved_in)
                                 --| tast::mk_typed_expr(
                                   tast::TypedExprKind(Block, iter_tes),
                                   unify::prim_unit!,
                                   ast::TypeInfo(Prim, ast::ValueType(Unit)),
                                   tast::layout_void!, 0, 0)
   is_ct_type_iter = c.iterable [Var tv_it] <>(lookup_ct_type(tv_it)) | <->
   iter_te = is_ct_type_iter
      | tast::mk_typed_var("", 0, <->, unify::prim_type!,
        ast::TypeInfo(Prim, ast::ValueType(Type)), tast::layout_void!, 0, 0)
      | annotate_expr(ctx, env, c.iterable)
   c_iter = unify::canon(ctx, iter_te.ut)
   is_type_iter = is_ct_type_iter || (c_iter [Prim p] (p [Type]) | <->)
   is_type_iter
      | unify::add_error(ctx, 3084,
        "Cannot iterate over a type directly; use '#members T @ m =>'.")
   iter_elem_info = cycle_iter_elem_info(ctx, iter_te, c.is_rune)
   has_elem = iter_elem_info.0
   elem_ut = iter_elem_info.1
   elem_ti = iter_elem_ti(ctx, iter_te.ti, elem_ut)
   ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   key_ut' = c_iter [Map m] m.key | unify::prim_int!
   prev_u = type_env::lookup_binding_exact(env, "_")
   prev_ui = type_env::lookup_binding_exact(env, "_i")
   p0_saved = c.body_fn
      [Fn fe0] (fe0.params(0) | _ | "")
      | ""
   (?p0_saved > 10 && p0_saved(0..10) == "_splat_el_" && !(c_iter [Array, Slice, Rec]))
      |
         unify::add_error(ctx, 3084,
           "Splat operator '..' in array constructor requires an array, slice, or homogeneous record")
   p1_saved = c.body_fn
      [Fn fe1] (fe1.params(1) | _ | "")
      | ""
   prev_p0 = p0_saved != "" && p0_saved != "_"
      | type_env::lookup_local_exact(env, p0_saved)
      | <-->
   prev_p1 = p1_saved != "" && p1_saved != "_"
      | type_env::lookup_local_exact(env, p1_saved)
      | <-->
   body_te = c.body_fn
      [Fn fe]
         p0 = p0_saved
         p1 = p1_saved
         np = ?fe.params
         np > 2
            | unify::add_error(ctx, 3138,
              "Cycle body takes at most two parameters")
         has_elem
            |
               np == 1
                  |
                     p0 != "" && p0 != "_"
                        |
                           type_env::bind_local(env, p0, elem_ut, elem_ti, <->)
                           type_env::init_mark_whole(env, p0)
                  |
                     np > 1
                        |
                           c_iter
                              [Map m2]
                                 p0 != "" && p0 != "_"
                                    |
                                       type_env::bind_local(env, p0,
                                         m2.val, elem_ti, <->)
                                       type_env::init_mark_whole(env, p0)
                                 p1 != "" && p1 != "_"
                                    |
                                       type_env::bind_local(env, p1,
                                         m2.key, ti_unk, <->)
                                       type_env::init_mark_whole(env, p1)
                              |
                                 p0 != "" && p0 != "_"
                                    |
                                       type_env::bind_local(env, p0,
                                         elem_ut, elem_ti, <->)
                                       type_env::init_mark_whole(env, p0)
                                 p1 != "" && p1 != "_"
                                    |
                                       type_env::bind_local(env, p1,
                                         unify::prim_int!, ti_unk, <->)
                                       type_env::init_mark_whole(env, p1)
            |
               p0 != "" && p0 != "_"
                  |
                     type_env::bind_local(env, p0, unify::prim_int!,
                       ti_unk, <->)
                     type_env::init_mark_whole(env, p0)
               np > 1 && p1 != "" && p1 != "_"
                  |
                     type_env::bind_local(env, p1, unify::prim_int!,
                       ti_unk, <->)
                     type_env::init_mark_whole(env, p1)
         type_env::bind_local(env, "_i", key_ut', ti_unk, <->)
         type_env::bind_local(env, "_", elem_ut, elem_ti, <->)
         env.discard_result = <+>
         fe_body_te = annotate_expr(ctx, env, fe.body)
         param_uts = unify::UTypes()
         fe.params @ pname, pi =>
            bnd = type_env::lookup_local(env, pname)
            put = bnd
               | b => b.ut
               |
                  pi < 2
                     | unify::add_error(ctx, 3139,
                       "Cycle body parameter '" + pname +
                       "' has no inferred type")
                  unify::fresh_var(ctx)
            param_uts += put
         fn_ut = unify::mk_fn(param_uts, unify::prim_unit!)
         ti_fn = unify::type_info_from_utype(ctx, fn_ut)
         mk_lambda_te(fe.params, fe_body_te, fn_ut, ti_fn)
      |
         type_env::bind_local(env, "_i", key_ut', ti_unk, <->)
         type_env::bind_local(env, "_", elem_ut, elem_ti, <->)
         env.discard_result = <+>
         callee = apply_callee_name(c.body_fn)
         callee != ""
            |
               u_expr = ast::Expr(Var, "_")
               call_args = ast::Exprs()
               call_args += u_expr
               fn_call = ast::CallExpr(callee, ast::Expr(Var, ""),
                 call_args, 0, 0)
               call_e = ast::Expr(Call, fn_call)
               pnames = ast::Names()
               pnames += "_"
               fe_body_te = annotate_expr(ctx, env, call_e)
               param_uts = unify::UTypes()
               param_uts += elem_ut
               fn_ut = unify::mk_fn(param_uts, unify::prim_unit!)
               ti_fn = unify::type_info_from_utype(ctx, fn_ut)
               mk_lambda_te(pnames, fe_body_te, fn_ut, ti_fn)
            | annotate_expr(ctx, env, c.body_fn)
   esc_opt = esc_expr_opt
      | esc_e =>
         env.discard_result = <->
         <+ annotate_expr(ctx, env, esc_e) +>
      | <-->
   p0_saved != "" && p0_saved != "_"
      |
         prev_p0
            | pp0 => type_env::bind_local(env, p0_saved, pp0.ut, pp0.ti, pp0.is_mut)
            | type_env::unbind_local(env, p0_saved)
   p1_saved != "" && p1_saved != "_"
      |
         prev_p1
            | pp1 => type_env::bind_local(env, p1_saved, pp1.ut, pp1.ti, pp1.is_mut)
   prev_u
      | pu => type_env::bind_local(env, "_", pu.ut, pu.ti, pu.is_mut)
      | type_env::unbind_local(env, "_")
   prev_ui
      | pui => type_env::bind_local(env, "_i", pui.ut, pui.ti, pui.is_mut)
      | type_env::unbind_local(env, "_i")
   esc_opt
      | esc_te =>
         ram_ut = unify::ram_pn(esc_te.ut)
         ti = unify::type_info_from_utype(ctx, ram_ut)
         lay = layout::compute_layout(ctx, ram_ut)
         tast::mk_typed_cycle(iter_te, body_te, <+ esc_te +>, c.is_rune,
           ram_ut, ti, lay, 0, 0)
      |
         ut = unify::prim_unit!
         ti = unify::type_info_from_utype(ctx, ut)
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_cycle(iter_te, body_te, <-->, c.is_rune, ut, ti, lay,
           0, 0)

module_member_name: ast::Expr => String
module_member_name = e =>
   e
      [Var v] v
      [Member m]
         m.is_module_access
            | module_member_name(m.target) + "::" + m.field_name
            | ""
      | ""

apply_callee_name: ast::Expr => String
apply_callee_name = e =>
   e
      [Var v] v
      [Member m]
         tgt = m.target [Var tv] tv | module_member_name(m.target)
         tgt != ""
            | tgt + (m.is_module_access | "::" | ".") + m.field_name
            | ""
      | ""

is_saturated_curried_call: unify::Ctx, type_env::TypeEnv, ast::Expr => <>
is_saturated_curried_call = ctx, env, rhs =>
   rhs
      [Call c]
         c.fn_name != ""
            |
               type_env::lookup_binding(env, c.fn_name)
                  | bnd =>
                     cb = unify::canon(ctx, bnd.ut)
                     cb
                        [Fn f_sig]
                           ?f_sig.params == ?c.args && (unify::canon(ctx, f_sig.ret) [Fn])
                        | <->
                  | <->
            | <->
      | <->

leftmost_feed_leaf: ast::Expr => ast::Expr
leftmost_feed_leaf = e =>
   e
      [Bin b]
         is_f = b.0 [Feed]
         is_f | leftmost_feed_leaf(b.1) | e
      | e

prepend_feed_arg: ast::Expr, ast::Expr => ast::Expr
prepend_feed_arg = arg_e, body_e =>
   body_e
      [Bin b]
         is_f = b.0 [Feed]
         is_f
            |
               ast::Expr(Bin, (ast::BinaryOp(Feed),
                 prepend_feed_arg(arg_e, b.1), b.2))
            |
               ast::Expr(Bin, (ast::BinaryOp(Feed), arg_e, body_e))
      |
         ast::Expr(Bin, (ast::BinaryOp(Feed), arg_e, body_e))

is_pointfree_leaf: unify::Ctx, type_env::TypeEnv, ast::Expr => <>
is_pointfree_leaf = ctx, env, leaf =>
   leaf
      [Fn] <+>
      [Call pc]
         pc.fn_name != ""
            |
               type_env::lookup_binding(env, pc.fn_name)
                  | bnd =>
                     cb = unify::canon(ctx, bnd.ut)
                     cb
                        [Fn f_sig]
                           is_sat_non_fn = ?f_sig.params == ?pc.args && !(unify::canon(ctx, f_sig.ret) [Fn])
                           is_sat_non_fn | <-> | <+>
                        | <+>
                  | <+>
            | <->
      |
         callee = apply_callee_name(leaf)
         (callee == "" || callee == "_" || callee == "_i")
            | <->
            |
               type_env::lookup_binding(env, callee)
                  | bnd =>
                     cb = unify::canon(ctx, bnd.ut)
                     (cb [Fn, Var]) || has_name_in(user_fns, callee) ||
                       has_name_in(declared_fns, callee) ||
                       type_env::is_generic_binding(env, callee) ||
                       <>(type_env::lookup_generic(env, callee)) ||
                       <>(type_env::lookup_user_type(env, callee)) ||
                       is_reserved_type_name(callee)
                  | <+>

annotate_seeded_cycle_expr: unify::Ctx, type_env::TypeEnv, ast::CycleExpr,
  tast::TypedExpr, tast::TypedExpr, <> => tast::TypedExpr
annotate_seeded_cycle_expr = ctx, env, c, seed_te, iter_te, saved_disc =>
   c_iter = unify::canon(ctx, iter_te.ut)
   iter_elem_info = cycle_iter_elem_info(ctx, iter_te, c.is_rune)
   has_elem = iter_elem_info.0
   elem_ut = iter_elem_info.1
   elem_ti = iter_elem_ti(ctx, iter_te.ti, elem_ut)
   eff_elem_ut = has_elem | elem_ut | unify::prim_int!
   eff_elem_ti = has_elem | elem_ti | ast::TypeInfo(Prim, ast::ValueType(Int))
   ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   key_ut = c_iter [Map m] m.key | unify::prim_int!
   acc_ut = seed_te.ut
   seed_ti_unk = seed_te.ti [Prim p_st] (p_st [Unknown]) | <->
   acc_ti0 = !seed_ti_unk | seed_te.ti | unify::type_info_from_utype(ctx, acc_ut)
   fold_v = unify::fresh_var(ctx)
   fold_id = fold_v [Var id] id | 0
   acc_name = "_fold_acc_" + str::from_int(fold_id)
   val_name = "_fold_v_" + str::from_int(fold_id)
   step_el_name = "_fold_el_" + str::from_int(fold_id)
   prev_u = type_env::lookup_binding_exact(env, "_")
   prev_ui = type_env::lookup_binding_exact(env, "_i")
   step_info = c.body_fn
      [Fn fe]
         np = ?fe.params
         np > 3
            | unify::add_error(ctx, 3138,
              "Seeded cycle (@>) body takes at most three parameters")
         p_acc = fe.params(0) | _ | ""
         p_elem = fe.params(1) | _ | ""
         p_idx = fe.params(2) | _ | ""
         prev_p0 = p_acc != "" && p_acc != "_"
            | type_env::lookup_local_exact(env, p_acc)
            | <-->
         prev_p1 = p_elem != "" && p_elem != "_"
            | type_env::lookup_local_exact(env, p_elem)
            | <-->
         prev_p2 = p_idx != "" && p_idx != "_"
            | type_env::lookup_local_exact(env, p_idx)
            | <-->
         p_acc != "" && p_acc != "_"
            |
               type_env::bind_local(env, p_acc, acc_ut, acc_ti0, <->)
               type_env::init_mark_whole(env, p_acc)
         np > 1 && p_elem != "" && p_elem != "_"
            |
               type_env::bind_local(env, p_elem, eff_elem_ut, eff_elem_ti, <->)
               type_env::init_mark_whole(env, p_elem)
         np > 2 && p_idx != "" && p_idx != "_"
            |
               type_env::bind_local(env, p_idx, key_ut, ti_unk, <->)
               type_env::init_mark_whole(env, p_idx)
         type_env::bind_local(env, "_i", key_ut, ti_unk, <->)
         (np == 1 && p_acc == "_")
            | type_env::bind_local(env, "_", acc_ut, acc_ti0, <->)
            | type_env::bind_local(env, "_", eff_elem_ut, eff_elem_ti, <->)
         env.discard_result = <->
         fe_body_te = annotate_expr(ctx, env, fe.body)
         p_acc != "" && p_acc != "_"
            |
               prev_p0
                  | pp0 => type_env::bind_local(env, p_acc, pp0.ut, pp0.ti, pp0.is_mut)
                  | type_env::unbind_local(env, p_acc)
         p_elem != "" && p_elem != "_"
            |
               prev_p1
                  | pp1 => type_env::bind_local(env, p_elem, pp1.ut, pp1.ti, pp1.is_mut)
                  | type_env::unbind_local(env, p_elem)
         p_idx != "" && p_idx != "_"
            |
               prev_p2
                  | pp2 => type_env::bind_local(env, p_idx, pp2.ut, pp2.ti, pp2.is_mut)
                  | type_env::unbind_local(env, p_idx)
         lparams = ast::Names()
         np < 2
            | lparams += step_el_name
            |
               lparams += (p_elem != "" | p_elem | step_el_name)
               np > 2
                  | lparams += (p_idx != "" | p_idx | "_i")
         (fe_body_te, p_acc, lparams)
      |
         p_acc = "_fold_a_" + str::from_int(fold_id)
         p_elem = "_fold_x_" + str::from_int(fold_id)
         type_env::bind_local(env, p_acc, acc_ut, acc_ti0, <->)
         type_env::init_mark_whole(env, p_acc)
         type_env::bind_local(env, p_elem, eff_elem_ut, eff_elem_ti, <->)
         type_env::init_mark_whole(env, p_elem)
         type_env::bind_local(env, "_i", key_ut, ti_unk, <->)
         type_env::bind_local(env, "_", eff_elem_ut, eff_elem_ti, <->)
         env.discard_result = <->
         callee = apply_callee_name(c.body_fn)
         call_e = callee != ""
            |
               cargs = ast::Exprs()
               cargs += ast::Expr(Var, p_acc)
               cargs += ast::Expr(Var, p_elem)
               ast::Expr(Call, ast::CallExpr(callee, ast::Expr(Var, ""), cargs, 0, 0))
            |
               c.body_fn
                  [Call pc]
                     cargs = ast::Exprs()
                     cargs += ast::Expr(Var, p_acc)
                     pc.args @ pca => cargs += pca
                     cargs += ast::Expr(Var, p_elem)
                     ast::Expr(Call, ast::CallExpr(pc.fn_name, pc.fn_target, cargs, pc.line, pc.col))
                  |
                     cargs = ast::Exprs()
                     cargs += ast::Expr(Var, p_acc)
                     cargs += ast::Expr(Var, p_elem)
                     ast::Expr(Call, ast::CallExpr("", c.body_fn, cargs, 0, 0))
         fe_body_te = annotate_expr(ctx, env, call_e)
         type_env::unbind_local(env, p_acc)
         type_env::unbind_local(env, p_elem)
         lparams = ast::Names()
         lparams += p_elem
         (fe_body_te, p_acc, lparams)
   prev_u
      | pu => type_env::bind_local(env, "_", pu.ut, pu.ti, pu.is_mut)
      | type_env::unbind_local(env, "_")
   prev_ui
      | pui => type_env::bind_local(env, "_i", pui.ut, pui.ti, pui.is_mut)
      | type_env::unbind_local(env, "_i")
   env.discard_result = saved_disc
   fe_body_te = step_info.0
   p_acc_name = step_info.1
   loop_params = step_info.2
   c_body = unify::canon(ctx, fe_body_te.ut)
   c_acc = unify::canon(ctx, acc_ut)
   is_acc_builder = c_acc [Prim p_ab] (p_ab [Builder]) | <->
   is_body_unit = c_body [Prim p_bu] (p_bu [Unit]) | <->
   is_cond_fold = c_body
      [Ram uram] uram.pos.has_payload && !(c_acc [Ram])
      | <->
   pay_ut = is_cond_fold
      | (c_body [Ram ur] ur.pos.ut | fe_body_te.ut)
      | fe_body_te.ut
   c_pay = unify::canon(ctx, pay_ut)
   is_pay_builder = c_pay [Prim p_pb] (p_pb [Builder]) | <->
   is_bld_append_step = is_acc_builder && !is_body_unit && !is_pay_builder &&
     (c_pay
        [Prim pr] is_builder_append_prim(pr)
        [Rec r] is_builder_append_rec(ctx, r, 0, ?r)
        [Var])
   !(is_acc_builder && (is_body_unit || is_bld_append_step))
      |
         ok_u = unify::unify(ctx, acc_ut, pay_ut)
         !ok_u
            | unify::add_error(ctx, 3084,
              "Type mismatch in seeded cycle (@>) accumulator")
   acc_ti = !seed_ti_unk | seed_te.ti | unify::type_info_from_utype(ctx, acc_ut)
   acc_lay = layout::compute_layout(ctx, acc_ut)
   unit_ut = unify::prim_unit!
   unit_ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   unit_lay = tast::layout_void!
   step_stmts = tast::TypedExprs()
   p_acc_name != ""
      |
         acc_var_te = tast::mk_typed_var(acc_name, 0, <+>, acc_ut, acc_ti, acc_lay, 0, 0)
         bind_acc_te = tast::mk_typed_assign(p_acc_name, <+>, <->, <->, <->,
           acc_var_te, unit_ut, unit_ti, unit_lay, 0, 0)
         step_stmts += bind_acc_te
   upd_acc_te = (is_acc_builder && is_body_unit)
      | fe_body_te
      |
         is_cond_fold
            |
               pay_ti = is_bld_append_step | unify::type_info_from_utype(ctx, pay_ut) | acc_ti
               pay_lay = is_bld_append_step | layout::compute_layout(ctx, pay_ut) | acc_lay
               val_var_te = tast::mk_typed_var(val_name, 0, <->, pay_ut, pay_ti, pay_lay, 0, 0)
               assign_val_te = tast::mk_typed_assign(acc_name, <->, is_bld_append_step, <->, <->,
                 val_var_te, unit_ut, unit_ti, unit_lay, 0, 0)
               bvars = ast::Names()
               bvars += val_name
               br = tast::TypedBranch(ast::GuardKind(Bare), tast::TypedExprs(), <-->,
                 ast::Names(), bvars, assign_val_te)
               brs = tast::TypedBranches()
               brs += br
               tast::mk_typed_expr(tast::TypedExprKind(Choice, (fe_body_te, brs)),
                 unit_ut, unit_ti, unit_lay, 0, 0)
            |
               tast::mk_typed_assign(acc_name, <->, is_bld_append_step, <->, <->, fe_body_te,
                 unit_ut, unit_ti, unit_lay, 0, 0)
   step_stmts += upd_acc_te
   step_te = tast::mk_typed_block(step_stmts, unit_ut, unit_ti, unit_lay, 0, 0)
   param_uts = unify::UTypes()
   param_uts += eff_elem_ut
   ?loop_params > 1 | (param_uts += key_ut)
   fn_ut = unify::mk_fn(param_uts, unit_ut)
   ti_fn = unify::type_info_from_utype(ctx, fn_ut)
   lambda_te = mk_lambda_te(loop_params, step_te, fn_ut, ti_fn)
   init_acc_te = tast::mk_typed_assign(acc_name, <+>, <->, <->, <->, seed_te,
     unit_ut, unit_ti, unit_lay, 0, 0)
   cyc_te = tast::mk_typed_cycle(iter_te, lambda_te, <-->, c.is_rune, unit_ut,
     unit_ti, unit_lay, 0, 0)
   res_var_te = tast::mk_typed_var(acc_name, 0, <+>, acc_ut, acc_ti, acc_lay, 0, 0)
   blk_exprs = tast::TypedExprs()
   blk_exprs += init_acc_te
   blk_exprs += cyc_te
   blk_exprs += res_var_te
   tast::mk_typed_block(blk_exprs, acc_ut, acc_ti, acc_lay, 0, 0)

annotate_unseeded_cycle_expr: unify::Ctx, type_env::TypeEnv, ast::CycleExpr,
  tast::TypedExpr, <>, <tast::TypedExpr|>, <> => tast::TypedExpr
annotate_unseeded_cycle_expr = ctx, env, c, iter_te, saved_disc, seed_opt, want_builder =>
   c_iter = unify::canon(ctx, iter_te.ut)
   iter_elem_info = cycle_iter_elem_info(ctx, iter_te, c.is_rune)
   has_elem = iter_elem_info.0
   elem_ut = iter_elem_info.1
   elem_ti = iter_elem_ti(ctx, iter_te.ti, elem_ut)
   eff_elem_ut = has_elem | elem_ut | unify::prim_int!
   eff_elem_ti = has_elem | elem_ti | ast::TypeInfo(Prim, ast::ValueType(Int))
   ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   key_ut = c_iter [Map m] m.key | unify::prim_int!
   map_v = unify::fresh_var(ctx)
   map_id = map_v [Var id] id | 0
   out_name = "_map_out_" + str::from_int(map_id)
   val_name = "_map_v_" + str::from_int(map_id)
   prev_u = type_env::lookup_binding_exact(env, "_")
   prev_ui = type_env::lookup_binding_exact(env, "_i")
   step_info = c.body_fn
      [Fn fe]
         p0 = fe.params(0) | _ | ""
         p1 = fe.params(1) | _ | ""
         np = ?fe.params
         np > 2
            | unify::add_error(ctx, 3138,
              "Cycle body takes at most two parameters")
         prev_p0 = p0 != "" && p0 != "_"
            | type_env::lookup_local_exact(env, p0)
            | <-->
         prev_p1 = p1 != "" && p1 != "_"
            | type_env::lookup_local_exact(env, p1)
            | <-->
         p0 != "" && p0 != "_"
            |
               type_env::bind_local(env, p0, eff_elem_ut, eff_elem_ti, <->)
               type_env::init_mark_whole(env, p0)
         np > 1 && p1 != "" && p1 != "_"
            |
               type_env::bind_local(env, p1, key_ut, ti_unk, <->)
               type_env::init_mark_whole(env, p1)
         type_env::bind_local(env, "_i", key_ut, ti_unk, <->)
         type_env::bind_local(env, "_", eff_elem_ut, eff_elem_ti, <->)
         env.discard_result = <->
         fe_body_te = annotate_expr(ctx, env, fe.body)
         p0 != "" && p0 != "_"
            |
               prev_p0
                  | pp0 => type_env::bind_local(env, p0, pp0.ut, pp0.ti, pp0.is_mut)
                  | type_env::unbind_local(env, p0)
         p1 != "" && p1 != "_"
            |
               prev_p1
                  | pp1 => type_env::bind_local(env, p1, pp1.ut, pp1.ti, pp1.is_mut)
                  | type_env::unbind_local(env, p1)
         (fe_body_te, fe.params)
      |
         type_env::bind_local(env, "_i", key_ut, ti_unk, <->)
         type_env::bind_local(env, "_", eff_elem_ut, eff_elem_ti, <->)
         env.discard_result = <->
         leaf = leftmost_feed_leaf(c.body_fn)
         is_pf = is_pointfree_leaf(ctx, env, leaf)
         stage_e = is_pf
            | prepend_feed_arg(ast::Expr(Var, "_"), c.body_fn)
            | c.body_fn
         fe_body_te = annotate_expr(ctx, env, stage_e)
         lparams = ast::Names()
         lparams += "_"
         (fe_body_te, lparams)
   prev_u
      | pu => type_env::bind_local(env, "_", pu.ut, pu.ti, pu.is_mut)
      | type_env::unbind_local(env, "_")
   prev_ui
      | pui => type_env::bind_local(env, "_i", pui.ut, pui.ti, pui.is_mut)
      | type_env::unbind_local(env, "_i")
   env.discard_result = saved_disc
   fe_body_te = step_info.0
   loop_params = step_info.1
   c_body = unify::canon(ctx, fe_body_te.ut)
   is_filter_map = c_body
      [Ram uram] uram.pos.has_payload
      | <->
   out_elem_ut = is_filter_map
      | (c_body [Ram ur] ur.pos.ut | fe_body_te.ut)
      | fe_body_te.ut
   c_out_elem = unify::canon(ctx, out_elem_ut)
   is_out_unit = c_out_elem [Prim p_u] (p_u [Unit]) | <->
   is_out_unit
      | unify::add_error(ctx, 3084,
        "Expression cycle (@>) body must return a value; use '@' for side-effect cycles")
   has_seed_bld = <>(seed_opt)
   is_out_rune = c_out_elem [Prim p_r] (p_r [Rune]) | <->
   is_out_bld_rhs = c_out_elem
      [Prim pr] is_builder_append_prim(pr)
      [Rec r] is_builder_append_rec(ctx, r, 0, ?r)
      [Var]
   is_out_builder = has_seed_bld || is_out_rune || (want_builder && is_out_bld_rhs)
   has_seed_bld && !is_out_unit && !is_out_bld_rhs
      | unify::add_error(ctx, 3084, diag::E3084_builder_append_type!)
   raw_elem_ti = is_filter_map
      | (fe_body_te.ti [Ram r_ti] r_ti.0.payload_record | ti_unk)
      | fe_body_te.ti
   raw_ti_unk = raw_elem_ti [Prim p_rt] (p_rt [Unknown]) | <->
   out_elem_ti = !raw_ti_unk | raw_elem_ti | unify::type_info_from_utype(ctx, out_elem_ut)
   out_elem_lay = layout::compute_layout(ctx, out_elem_ut)
   elem_vt = unify::vt_from_utype(ctx, out_elem_ut)
   out_ut = is_out_builder
      | unify::prim_builder!
      | unify::mk_array(out_elem_ut, 16)
   out_ti = is_out_builder
      | ast::TypeInfo(Prim, ast::ValueType(Builder))
      | ast::TypeInfo(Array, (elem_vt, out_elem_ti, 16))
   out_lay = layout::compute_layout(ctx, out_ut)
   unit_ut = unify::prim_unit!
   unit_ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   unit_lay = tast::layout_void!
   out_new_te = seed_opt
      | s_te => s_te
      |
         is_out_builder
            |
               cap_te = tast::mk_lit_int(16, 0, 0)
               tast::mk_typed_builder_new(cap_te, out_ut, out_ti, out_lay, 0, 0)
            |
               ac = ast::ArrayCreateExpr(out_elem_ti, 16)
               tast::mk_typed_expr(tast::TypedExprKind(ArrayNew, ac),
                 out_ut, out_ti, out_lay, 0, 0)
   init_out_te = tast::mk_typed_assign(out_name, <+>, <->, <->, <->, out_new_te,
     unit_ut, unit_ti, unit_lay, 0, 0)
   step_te = is_filter_map
      |
         val_var_te = tast::mk_typed_var(val_name, 0, <->, out_elem_ut, out_elem_ti,
           out_elem_lay, 0, 0)
         append_te = tast::mk_typed_assign(out_name, <->, <+>, <->, <->, val_var_te,
           unit_ut, unit_ti, unit_lay, 0, 0)
         bvars = ast::Names()
         bvars += val_name
         br = tast::TypedBranch(ast::GuardKind(Bare), tast::TypedExprs(), <-->,
           ast::Names(), bvars, append_te)
         brs = tast::TypedBranches()
         brs += br
         tast::mk_typed_expr(tast::TypedExprKind(Choice, (fe_body_te, brs)),
           unit_ut, unit_ti, unit_lay, 0, 0)
      |
         tast::mk_typed_assign(out_name, <->, <+>, <->, <->, fe_body_te,
           unit_ut, unit_ti, unit_lay, 0, 0)
   param_uts = unify::UTypes()
   param_uts += eff_elem_ut
   ?loop_params > 1 | (param_uts += key_ut)
   fn_ut = unify::mk_fn(param_uts, unit_ut)
   ti_fn = unify::type_info_from_utype(ctx, fn_ut)
   lambda_te = mk_lambda_te(loop_params, step_te, fn_ut, ti_fn)
   cyc_te = tast::mk_typed_cycle(iter_te, lambda_te, <-->, c.is_rune, unit_ut,
     unit_ti, unit_lay, 0, 0)
   res_var_te = tast::mk_typed_var(out_name, 0, <+>, out_ut, out_ti, out_lay, 0, 0)
   blk_exprs = tast::TypedExprs()
   blk_exprs += init_out_te
   blk_exprs += cyc_te
   blk_exprs += res_var_te
   tast::mk_typed_block(blk_exprs, out_ut, out_ti, out_lay, 0, 0)

try_unroll_seeded_ct_range_fold: unify::Ctx, type_env::TypeEnv, ast::CycleExpr,
  ast::Expr, ast::Expr => <tast::TypedExpr|>
try_unroll_seeded_ct_range_fold = ctx, env, c, seed_e, rhs_e =>
   rhs_e
      [Range rng_f]
         c.body_fn
            [Fn fe_f]
               ?fe_f.params < 2 || !rng_f.has_rhs ||
                 !cycle_uses_ct_index(fe_f.body, fe_f.params(1)!!) | --| <-->
               lhs_opt = rng_f.has_lhs
                  | eval_static_int_expr(ctx, env, rng_f.lhs)
                  | <+ 0 +>
               rhs_opt = eval_static_int_expr(ctx, env, rng_f.rhs)
               start_i = lhs_opt | v => v | --| <-->
               end_i = rhs_opt | v => v | --| <-->
               count = rng_f.is_inclusive
                  | (end_i - start_i + 1)
                  | (end_i - start_i)
               (count < 0 || count !< 4096) | --| <-->
               seed_f = annotate_expr(ctx, env, seed_e)
               fold_v = unify::fresh_var(ctx)
               fold_id = fold_v [Var id] id | 0
               acc_name = "_fold_acc_" + str::from_int(fold_id)
               p_acc = fe_f.params(0)!!
               p_elem = fe_f.params(1)!!
               p_idx = fe_f.params(2) | _ | ""
               unit_ut = unify::prim_unit!
               unit_ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
               unit_lay = tast::layout_void!
               type_env::bind_local(env, acc_name, seed_f.ut, seed_f.ti, <+>)
               type_env::init_mark_whole(env, acc_name)
               blk_exprs = tast::TypedExprs()
               blk_exprs += tast::mk_typed_assign(acc_name, <+>, <->, <->, <->,
                 seed_f, unit_ut, unit_ti, unit_lay, 0, 0)
               prev_p0 = p_acc != "" && p_acc != "_"
                  | type_env::lookup_local_exact(env, p_acc)
                  | <-->
               p_acc != "" && p_acc != "_"
                  |
                     type_env::bind_local(env, p_acc, seed_f.ut, seed_f.ti, <->)
                     type_env::init_mark_whole(env, p_acc)
               count @ k =>
                  iv = start_i + k
                  saved_in = ?cur_ct_ints
                  push_ct_int(p_elem, iv)
                  p_idx != "" && p_idx != "_" | push_ct_int(p_idx, k)
                  p_acc != "" && p_acc != "_"
                     |
                        acc_ref = tast::mk_typed_var(acc_name, 0, <+>,
                          seed_f.ut, seed_f.ti, seed_f.layout, 0, 0)
                        blk_exprs += tast::mk_typed_assign(p_acc, <+>, <->, <->, <->,
                          acc_ref, unit_ut, unit_ti, unit_lay, 0, 0)
                  body_k = alpha_rename_iter_body(env, fe_f.params, fe_f.body)
                  step_k = annotate_expr(ctx, env, body_k)
                  ok_f = unify::unify(ctx, seed_f.ut, step_k.ut)
                  !ok_f
                     | unify::add_error(ctx, 3084,
                       "Type mismatch in seeded cycle (@>) accumulator")
                  blk_exprs += tast::mk_typed_assign(acc_name, <->, <->, <->, <->,
                    step_k, unit_ut, unit_ti, unit_lay, 0, 0)
                  pop_ct_ints_to(saved_in)
               p_acc != "" && p_acc != "_"
                  |
                     prev_p0
                        | pp0 => type_env::bind_local(env, p_acc, pp0.ut, pp0.ti, pp0.is_mut)
                        | type_env::unbind_local(env, p_acc)
               type_env::unbind_local(env, acc_name)
               blk_exprs += tast::mk_typed_var(acc_name, 0, <+>,
                 seed_f.ut, seed_f.ti, seed_f.layout, 0, 0)
               <+ tast::mk_typed_block(blk_exprs, seed_f.ut, seed_f.ti,
                 seed_f.layout, 0, 0) +>
            | <-->
      | <-->

annotate_cycle_expr: unify::Ctx, type_env::TypeEnv, ast::CycleExpr => tast::TypedExpr
annotate_cycle_expr = ctx, env, c =>
   saved_disc = env.discard_result
   saved_cyc_exp = cur_expected_ut
   want_builder = cur_expected_ut
      | exp_ut =>
         c_exp = unify::canon(ctx, exp_ut)
         c_exp [Prim p_eb] (p_eb [Builder]) | <->
      | <->
   cur_expected_ut ::= <-->
   env.discard_result = <->
   is_members_iter = c.iterable
      [Member mi] !mi.is_module_access && mi.field_name == "#members"
      | <->
   is_members_iter
      |
         unify::add_error(ctx, 3084, "'#members' cannot be used with '@>'.")
         cur_expected_ut ::= saved_cyc_exp
         env.discard_result = saved_disc
         --| tast::mk_lit_unit(0, 0)
   res = c.iterable
      [Record rec]
         (!rec.is_repeat && ?rec.fields == 2)
            |
               f0 = rec.fields(0)!!
               f1 = rec.fields(1)!!
               (!f0.has_name && !f1.has_name)
                  |
                     ct_fold_opt = try_unroll_seeded_ct_range_fold(ctx, env, c, f0.val, f1.val)
                     ct_fold_opt
                        | cf_te => cf_te
                        |
                           seed_te = annotate_expr(ctx, env, f0.val)
                           rhs_te = annotate_expr(ctx, env, f1.val)
                           c_seed = unify::canon(ctx, seed_te.ut)
                           c_rhs = unify::canon(ctx, rhs_te.ut)
                           is_seed_builder = c_seed [Prim p_sb] (p_sb [Builder]) | <->
                           is_rhs_range = f1.val [Range]
                           is_rhs_coll = c_rhs [Array, Slice, Map]
                           is_rhs_str = (c_rhs [Prim p_s] (p_s [Str]) | <->) &&
                             (!(c_seed [Prim p_s0] (p_s0 [Str]) | <->) || c.is_rune)
                           is_rhs_bld = (c_rhs [Prim p_rb] (p_rb [Builder]) | <->) &&
                             (!is_seed_builder || c.is_rune)
                           is_rhs_rec = (c_rhs [Rec]) && !(c_seed [Rec])
                           is_rhs_int = c_rhs [Prim p_ri] (p_ri [Int]) | <->
                           can_rhs_iter = is_rhs_range || is_rhs_coll || is_rhs_str ||
                             is_rhs_bld || is_rhs_rec || is_rhs_int
                           is_multi_param = c.body_fn [Fn fe_chk] (?fe_chk.params > 1) | <->
                           is_non_fn = !(c.body_fn [Fn]) &&
                             is_pointfree_leaf(ctx, env, leftmost_feed_leaf(c.body_fn))
                           is_fold = is_seed_builder || is_rhs_range || is_rhs_coll ||
                             is_rhs_str || is_rhs_bld || is_rhs_rec ||
                             (can_rhs_iter && (is_multi_param || is_non_fn))
                           is_fold
                              |
                                 (is_seed_builder && !is_multi_param)
                                    | annotate_unseeded_cycle_expr(ctx, env, c, rhs_te,
                                      saved_disc, <+ seed_te +>, <+>)
                                    | annotate_seeded_cycle_expr(ctx, env, c, seed_te,
                                      rhs_te, saved_disc)
                              |
                                 tfields = tast::TypedFields()
                                 tfields += tast::TypedField("", seed_te, 0, seed_te.ut)
                                 tfields += tast::TypedField("", rhs_te, seed_te.layout.size, rhs_te.ut)
                                 uflds = unify::UFields()
                                 uflds += unify::UField("", seed_te.ut)
                                 uflds += unify::UField("", rhs_te.ut)
                                 rec_ut = unify::UType(Rec, uflds)
                                 rec_ti = unify::type_info_from_utype(ctx, rec_ut)
                                 rec_lay = layout::compute_layout(ctx, rec_ut)
                                 iter_te = tast::mk_typed_expr(tast::TypedExprKind(Record, tfields),
                                   rec_ut, rec_ti, rec_lay, 0, 0)
                                 annotate_unseeded_cycle_expr(ctx, env, c, iter_te,
                                   saved_disc, <-->, want_builder)
                  |
                     iter_te = annotate_expr(ctx, env, c.iterable)
                     annotate_unseeded_cycle_expr(ctx, env, c, iter_te,
                       saved_disc, <-->, want_builder)
            |
               iter_te = annotate_expr(ctx, env, c.iterable)
               annotate_unseeded_cycle_expr(ctx, env, c, iter_te,
                 saved_disc, <-->, want_builder)
      |
         iter_te = annotate_expr(ctx, env, c.iterable)
         annotate_unseeded_cycle_expr(ctx, env, c, iter_te,
           saved_disc, <-->, want_builder)
   env.discard_result = saved_disc
   cur_expected_ut ::= saved_cyc_exp
   res

apply_split: ast::Expr => (<>, String, ast::Expr, ast::Exprs)
apply_split = fn =>
   fn
      [Call c]
         (<+>, c.fn_name, c.fn_target, c.args)
      [Bin b]
         b.0
            [Feed]
               sub = apply_split(b.2)
               sub.0
                  |
                     args = ast::Exprs()
                     args += b.1
                     sub.3 @ arg_i =>
                        args += arg_i
                     (<+>, sub.1, sub.2, args)
                  |
                     callee = apply_callee_name(b.2)
                     args = ast::Exprs()
                     args += b.1
                     tgt = callee == "" | b.2 | ast::Expr(Var, "")
                     (<+>, callee, tgt, args)
            [Apply]
               sub = apply_split(b.1)
               sub.0
                  |
                     args = ast::Exprs()
                     sub.3 @ arg_i =>
                        args += arg_i
                     args += b.2
                     (<+>, sub.1, sub.2, args)
                  |
                     callee = apply_callee_name(b.1)
                     args = ast::Exprs()
                     args += b.2
                     tgt = callee == "" | b.1 | ast::Expr(Var, "")
                     (<+>, callee, tgt, args)
            | (<->, "", ast::Expr(Var, ""), ast::Exprs())
      | (<->, "", ast::Expr(Var, ""), ast::Exprs())

member_field_ti: type_env::TypeEnv, ast::TypeInfo, String => <ast::TypeInfo|>
member_field_ti = env, ti, name =>
   ti
      [Align a] member_field_ti(env, a.1, name)
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt
            | udef => member_field_ti(env, udef.ti, name)
            | <-->
      [Rec r]
         res' = <-->
         r.0 @ f =>
            f.name == name
               |
                  res' = <+ f.rec_type +>
                  -->
         !<>(res')
            |
               pos = unify::parse_field_digits(name, 0, 0)
               pos !< 0 && pos < ?r.0
                  | (res' = <+ r.0(pos)!!.rec_type +>)
         res'
      [Bitfield b]
         res' = <-->
         b.fields @ bf =>
            bf.name == name
               |
                  f_vt = bf.is_flag | ast::ValueType(Flag) | b.backing_type
                  res' = <+ ast::TypeInfo(Prim, f_vt) +>
                  -->
         res'
      [Prim p]
         is_err = p [Error]
         is_err
            |
               name
                  ["code", "line", "col"] <+ ast::TypeInfo(Prim, ast::ValueType(Int)) +>
                  ["msg", "file"] <+ ast::TypeInfo(Prim, ast::ValueType(Str)) +>
                  ["context"]
                     flds = ast::FieldTypes()
                     flds += ast::RecordFieldType("", ast::ValueType(Int),
                       ast::TypeInfo(Prim, ast::ValueType(Int)), <->, ast::Expr(Int, 0))
                     flds += ast::RecordFieldType("", ast::ValueType(Int),
                       ast::TypeInfo(Prim, ast::ValueType(Int)), <->, ast::Expr(Int, 0))
                     <+ ast::TypeInfo(Rec, (flds, <->, <->, ast::ValueType(Record), 2, <->)) +>
                  | <-->
            | <-->
      | <-->

wrap_functor_rhs: ast::Tag, ast::Expr => ast::Expr
wrap_functor_rhs = tag, rhs =>
   rhs
      [Fn fe]
         v_args = ast::Exprs()
         v_args += fe.body
         v_body = ast::Expr(Variant, ast::VariantExpr(tag, v_args))
         ast::Expr(Fn, ast::FnExpr(fe.params, fe.ct_params, v_body, fe.line, fe.col))
      |
         fed = ast::Expr(Bin, (ast::BinaryOp(Feed), ast::Expr(Var, "_"), rhs))
         v_args = ast::Exprs()
         v_args += fed
         ast::Expr(Variant, ast::VariantExpr(tag, v_args))

// --- Annotate Expressions --------------------------------------------------

/// Resolves an `Enum` `UEnum` to its full variant list when `variants` is shallow.
resolve_enum_ut = ctx, env, uenum_raw =>
   ?uenum_raw.variants == 0 && uenum_raw.name != ""
      |
         ut_opt = type_env::lookup_user_type(env, uenum_raw.name)
         ut_opt2 = <>(ut_opt) | ut_opt | lookup_user_type_any_mod(env, uenum_raw.name)
         ut_opt2
            | udef_e =>
               unify::canon(ctx, udef_e.ut)
                  [Enum ue_res] ue_res
                  | uenum_raw
            | uenum_raw
      | uenum_raw

/// Evaluates member access on a `#members` compile-time cursor variable (`m.idx`, `m.name`, `m.type`, `m.default`).
annotate_cursor_member: unify::Ctx, type_env::TypeEnv, ast::MemberExpr,
  CtCursorBind => tast::TypedExpr
annotate_cursor_member = ctx, env, m, cur =>
   m.field_name
      ["idx"] tast::mk_lit_int(cur.idx, m.line, m.col)
      ["name"] tast::mk_lit_str(cur.field_name, m.line, m.col)
      ["type", "Type"]
         tast::mk_typed_var("", 0, <->, unify::prim_type!, cur.field_ti,
           tast::layout_scalar(8, 8), m.line, m.col)
      ["default"]
         ram_ut = unify::ram_pn(cur.field_ut)
         ram_ti = unify::type_info_from_utype(ctx, ram_ut)
         ram_lay = layout::compute_layout(ctx, ram_ut)
         !cur.has_default
            |
               tast::mk_typed_ram_construct(unify::URamShape(RamPN), <->,
                 <-->, ram_ut, ram_ti, ram_lay, m.line, m.col)
            |
               saved_def_exp = cur_expected_ut
               cur_expected_ut ::= <+ cur.field_ut +>
               def_te = annotate_expr(ctx, env, cur.default_expr)
               cur_expected_ut ::= saved_def_exp
               unify::unify(ctx, cur.field_ut, def_te.ut)
               tast::mk_typed_ram_construct(unify::URamShape(RamPN), <+>,
                 <+ def_te +>, ram_ut, ram_ti, ram_lay, m.line, m.col)
      |
         unify::add_error(ctx, 3084,
           "Unknown reflection cursor property '${m.field_name}'.")
         tast::mk_lit_unit(m.line, m.col)

annotate_type_carrier_member: unify::Ctx, type_env::TypeEnv,
  ast::MemberExpr => <tast::TypedExpr|>
annotate_type_carrier_member = ctx, env, m =>
   rt = resolve_type_expr_ut_ti(ctx, env, "", m.target)
   !rt.2 | --| <-->
   t_vname = m.target [Var v] (lookup_ct_type(v) | ctb => "" | v) | ""
   target_te = tast::mk_typed_var(t_vname, 0, <->, unify::prim_type!,
     rt.1, tast::layout_scalar(8, 8), m.line, m.col)
   c_rt = unify::canon(ctx, rt.0)
   m.field_name
      ["#type_name"]
         <+ tast::mk_typed_member(target_te, m.field_name, -1, unify::prim_str!,
           ast::TypeInfo(Prim, ast::ValueType(Str)), tast::layout_scalar(16, 8),
           m.line, m.col) +>
      ["#type_size", "#type_align"]
         <+ tast::mk_typed_member(target_te, m.field_name, -1, unify::prim_int!,
           ast::TypeInfo(Prim, ast::ValueType(Int)), tast::layout_scalar(8, 8),
           m.line, m.col) +>
      ["#type_arity"]
         !(c_rt [Rec, Enum, Var])
            | unify::add_error(ctx, 3084, "'#arity' requires a record or enum type.")
         n_arity = c_rt
            [Rec flds] ?flds
            [Enum ue_raw] ?resolve_enum_ut(ctx, env, ue_raw).variants
            | -1
         n_arity !< 0
            | <+ tast::mk_lit_int(n_arity, m.line, m.col) +>
            | <+ tast::mk_typed_member(target_te, m.field_name, -1, unify::prim_int!,
              ast::TypeInfo(Prim, ast::ValueType(Int)), tast::layout_scalar(8, 8),
              m.line, m.col) +>
      ["#type_zero"]
         lay = layout::compute_layout(ctx, rt.0)
         <+ tast::mk_typed_member(target_te, m.field_name, -1, rt.0, rt.1,
           lay, m.line, m.col) +>
      [""]
         is_enum_rt = c_rt [Enum]
         vn = m.index_expr [Var v] v | ""
         idx_ct_opt = m.index_expr
            [Int iv] <+ iv +>
            [Var v] lookup_ct_int(v)
            | <-->
         cur_opt = vn != "" | lookup_ct_cursor(vn) | <-->
         cur_opt
            | cur_v =>
               c_lbl = cur_v.field_name != "" | cur_v.field_name | str::from_int(cur_v.idx)
               is_enum_rt
                  |
                     uenum_c = resolve_enum_ut(ctx, env,
                       c_rt [Enum ue] ue | unify::UEnum("", unify::UEnumVariants()))
                     (cur_v.idx !< 0 && cur_v.idx < ?uenum_c.variants)
                        |
                           vi_c = uenum_c.variants(cur_v.idx)!!
                           vi_c.has_payload
                              | unify::add_error(ctx, 3097,
                                "Enum '${bare_enum_label(uenum_c.name)}' variant '${vi_c.label}' requires a payload argument.")
                           lay_c = layout::compute_layout(ctx, rt.0)
                           --| <+ tast::mk_typed_enum_construct(vi_c.label, <-->, rt.0,
                             rt.1, lay_c, m.line, m.col) +>
                        | --| <+ tast::mk_lit_str(c_lbl, m.line, m.col) +>
                  | --| <+ tast::mk_lit_str(c_lbl, m.line, m.col) +>
         is_lit_var = is_enum_rt && !<>(idx_ct_opt) && vn != "" &&
           !<>(type_env::lookup_binding(env, vn)) && !<>(lookup_ct_val(vn))
         is_lit_var
            |
               uenum' = resolve_enum_ut(ctx, env,
                 c_rt [Enum ue] ue | unify::UEnum("", unify::UEnumVariants()))
               t_disp = t_vname != ""
                  | t_vname
                  | (m.target [SizeOf so] (so.rec_type [TypeVar tv] tv | "") | "")
               enum_disp = uenum'.name != ""
                  | bare_enum_label(uenum'.name)
                  | (t_disp != "" | bare_enum_label(t_disp) | "enum")
               found_idx' = -1
               has_pay' = <->
               uenum'.variants @ vi, si =>
                  vi.label == vn | (found_idx' = si; has_pay' = vi.has_payload; -->)
               found_idx' < 0
                  | unify::add_error(ctx, 3096, diag::enum_no_variant(enum_disp, vn))
                  | has_pay'
                     | unify::add_error(ctx, 3097,
                       "Enum '${enum_disp}' variant '${vn}' requires a payload argument.")
               lay = layout::compute_layout(ctx, rt.0)
               <+ tast::mk_typed_enum_construct(vn, <-->, rt.0, rt.1, lay,
                 m.line, m.col) +>
            |
               !(c_rt [Rec, Enum, Var])
                  | unify::add_error(ctx, 3084, "'#member' requires a record or enum type.")
               idx_te = annotate_expr(ctx, env, m.index_expr)
               unify::unify(ctx, idx_te.ut, unify::prim_int!)
               has_idx = <>(idx_ct_opt)
               idx_n = idx_ct_opt | _ | -1
               !has_idx
                  |
                     unify::add_error(ctx, 3170, diag::member_index_constant!)
                     --| <+ tast::mk_typed_member(target_te, "", idx_n, unify::prim_str!,
                       ast::TypeInfo(Prim, ast::ValueType(Str)), tast::layout_scalar(16, 8),
                       m.line, m.col) +>
               c_rt
                  [Rec flds]
                     idx_n < 0 || idx_n !< ?flds
                        |
                           unify::add_error(ctx, 3171,
                             "Record field index ${idx_n} out of range (0..${?flds - 1}).")
                           <+ tast::mk_lit_str("", m.line, m.col) +>
                        |
                           fnm = (flds(idx_n)!!).name
                           <+ tast::mk_lit_str(
                             (fnm != "" | fnm | str::from_int(idx_n)),
                             m.line, m.col) +>
                  [Enum ue_raw]
                     uenum_m = resolve_enum_ut(ctx, env, ue_raw)
                     n_ev = ?uenum_m.variants
                     idx_n < 0 || idx_n !< n_ev
                        |
                           unify::add_error(ctx, 3171,
                             "Enum variant index ${idx_n} out of range (0..${n_ev - 1}).")
                           <+ tast::mk_lit_str("", m.line, m.col) +>
                        | <+ tast::mk_lit_str((uenum_m.variants(idx_n)!!).label,
                          m.line, m.col) +>
                  |
                     <+ tast::mk_typed_member(target_te, "", idx_n, unify::prim_str!,
                       ast::TypeInfo(Prim, ast::ValueType(Str)), tast::layout_scalar(16, 8),
                       m.line, m.col) +>
      | <-->

/// Formats the ramification/flag shape of `u` for `E3149` return diagnostics.
ram_shape_disp: unify::Ctx, unify::UType => String
ram_shape_disp = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Prim p]
         is_f = p [Flag]
         is_f | "<>" | unify::show_utype(ctx, c)
      [Ram r]
         l_pay = r.pos.has_payload
         r_pay = r.neg.has_payload
         !l_pay && !r_pay
            | "<>"
            |
               is_pv = unify::canon(ctx, r.pos.ut) [Var]
               is_nv = unify::canon(ctx, r.neg.ut) [Var]
               l_s = l_pay | (is_pv | "..." | unify::show_utype(ctx, r.pos.ut)) | ""
               r_s = r_pay | (is_nv | "..." | unify::show_utype(ctx, r.neg.ut)) | ""
               l_pay && !r_pay
                  | "< " + l_s + " | >"
                  |
                     !l_pay && r_pay
                        | "< | " + r_s + " >"
                        | "< " + l_s + " | " + r_s + " >"
      | "Unknown"

/// Emits `E3149` when a `--|` return expression has an incompatible ramification shape.
check_return_ram_shape: unify::Ctx, unify::UType, unify::UType => <>
check_return_ram_shape = ctx, ret_ut, val_ut =>
   cur_fn_name == "" | --| <+>
   c_ret = unify::canon(ctx, ret_ut)
   c_val = unify::canon(ctx, val_ut)
   ret_is_flag = c_ret [Prim p] p [Flag] | <->
   ret_is_ram = c_ret [Ram]
   !(ret_is_flag || ret_is_ram) | --| <+>
   val_is_flag = c_val [Prim p] p [Flag] | <->
   val_is_ram = c_val [Ram]
   !(val_is_flag || val_is_ram) | --| <+>
   ret_pos = c_ret [Ram r] r.pos.has_payload | <->
   ret_neg = c_ret [Ram r] r.neg.has_payload | <->
   val_pos = c_val [Ram r] r.pos.has_payload | <->
   val_neg = c_val [Ram r] r.neg.has_payload | <->
   (ret_pos != val_pos || ret_neg != val_neg)
      |
         exp_s = ram_shape_disp(ctx, c_ret)
         act_s = ram_shape_disp(ctx, c_val)
         unify::add_error(ctx, 3149,
           "Function '${cur_fn_name}' declares return type ${exp_s}, " +
           "but return statement produces a ramification with shape ${act_s}.")
         --| <->
   <+>

annotate_expr: unify::Ctx, type_env::TypeEnv, ast::Expr => tast::TypedExpr
annotate_expr = ctx, env, expr =>
   cur_disc = env.discard_result
   env.discard_result = <->
   expr
      [Int n]
         tast::mk_lit_int(n, 0, 0)
      [Float f]
         tast::mk_lit_float(f, 0, 0)
      [Str s]
         tast::mk_lit_str(s, 0, 0)
      [Rune r]
         ut = unify::prim_rune!
         ti = ast::TypeInfo(Prim, ast::ValueType(Rune))
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_expr(tast::TypedExprKind(LitRune, r), ut, ti, lay, 0, 0)
      [Var name]
         lookup_ct_int(name)
            | ci => --| tast::mk_lit_int(ci, 0, 0)
         lookup_ct_val(name)
            | ctv => --| ctv.te
         bnd = type_env::lookup_binding(
            env, name)
         bnd
            |
               b = _
               resolved_name = b.depth == 0 | b.name | name
               is_user_fn = has_name_in(user_fns, resolved_name)
               is_user_fn && b.depth == 0
                  |
                     !has_name_in(value_used_fns, resolved_name)
                        | (value_used_fns += resolved_name)
               !env.in_lvalue && type_env::init_is_tracked(env, resolved_name) &&
                 (env.in_member_target | !type_env::init_is_ok(env, resolved_name) | !type_env::init_is_fully_init(env, resolved_name, b.ut))
                 |
                    unify::add_error(ctx, 3130,
                      diag::uninitialized_variable_prefix! + resolved_name + "'.")
               ti0 = unify::type_info_from_utype(
                  ctx, b.ut)
               keep_b_ti = b.ti [TypeVar tv] tv != "" |
                  (b.ti [Bitfield] <+> |
                  (b.ti [Rec r] r.5 | <->))
               ti = keep_b_ti | b.ti | ti0
               lay = layout::compute_layout(
                  ctx, b.ut)
               tast::mk_typed_var(resolved_name,
                 b.depth, b.is_mut, b.ut,
                 ti, lay, 0, 0)
            |
               gen_opt = type_env::lookup_generic(
                  env, name)
               gen_opt
                  | gen_ti =>
                     g_name = type_env::resolve_generic_name(env, name)
                     !has_name_in(value_used_fns, g_name) | (value_used_fns += g_name)
                     gen_ut =
                        instantiate_generic_ti(
                           ctx, env, type_env::decl_module(g_name, 0), gen_ti)
                     ti =
                        unify::type_info_from_utype(
                           ctx, gen_ut)
                     lay =
                        layout::compute_layout(
                           ctx, gen_ut)
                     tast::mk_typed_var(g_name,
                       0, <->, gen_ut, ti,
                       lay, 0, 0)
                  |
                     lookup_ct_type(name)
                        | ctb =>
                           --| (cur_is_call_arg || env.in_member_target)
                              | tast::mk_typed_var("", 0, <->, unify::prim_type!,
                                ctb.ti, tast::layout_void!, 0, 0)
                              | tast::mk_typed_member(
                                tast::mk_typed_var("", 0, <->, unify::prim_type!,
                                  ctb.ti, tast::layout_scalar(8, 8), 0, 0),
                                "#type_zero", -1, ctb.ut, ctb.ti,
                                layout::compute_layout(ctx, ctb.ut), 0, 0)
                     ut_opt = type_env::lookup_user_type(env, name)
                     ut_opt
                        | udef =>
                           type_ut = unify::prim_type!
                           type_ti = ast::TypeInfo(Prim,
                             ast::ValueType(Type))
                           type_lay = tast::layout_void!
                           tast::mk_typed_var(udef.name, 0, <->,
                             type_ut, type_ti, type_lay, 0, 0)
                        |
                           cast_opt = type_name_to_uprim(name)
                           cast_opt
                              | uprim =>
                                 type_ut = unify::prim_type!
                                 type_ti = ast::TypeInfo(Prim,
                                   ast::ValueType(Type))
                                 type_lay = tast::layout_void!
                                 tast::mk_typed_var(name, 0, <->,
                                   type_ut, type_ti, type_lay, 0, 0)
                              |
                                 name == "addr"
                                    |
                                       p_uts = unify::UTypes()
                                       p_uts += unify::fresh_var(ctx)
                                       a_ret = unify::UType(Prim,
                                         unify::UPrim(RawPtr))
                                       a_fn_ut = unify::mk_fn(
                                          p_uts, a_ret)
                                       a_ti = ast::TypeInfo(Prim,
                                         ast::ValueType(RawPtr))
                                       a_lay = tast::layout_scalar(8, 8)
                                       tast::mk_typed_var("addr",
                                         0, <->, a_fn_ut, a_ti,
                                         a_lay, 0, 0)
                                    |
                                       name == "default"
                                          |
                                             d_ut = unify::prim_unit!
                                             d_ti = unify::
                                                type_info_from_utype(
                                                   ctx, d_ut)
                                             d_lay = tast::layout_void!
                                             tast::mk_typed_var(
                                                "default", 0, <->,
                                                d_ut, d_ti, d_lay, 0, 0)
                                          |
                                             name ["#os", "#arch", "#target"]
                                                |
                                                   ct_s_ut = unify::prim_str!
                                                   ct_s_ti = ast::TypeInfo(Prim,
                                                     ast::ValueType(Str))
                                                   ct_s_lay = layout::compute_layout(
                                                      ctx, ct_s_ut)
                                                   tast::mk_typed_var(name, 0, <->,
                                                     ct_s_ut, ct_s_ti, ct_s_lay, 0, 0)
                                                |
                                                   is_intrinsic_name(name)
                                                      |
                                                         unify::add_error(ctx,
                                                           3100,
                                                           "Intrinsic '" +
                                                           name + "' must " +
                                                           "be called with " +
                                                           "arguments.")
                                                      |
                                                         unify::add_error(ctx,
                                                           3004,
                                                           "Undefined: " +
                                                           name + " in " +
                                                           env.current_module)
                                                   err_ut =
                                                      unify::poison_utype!
                                                   err_ti = ast::TypeInfo(
                                                      Prim,
                                                      ast::ValueType(Unknown))
                                                   err_lay =
                                                      tast::layout_scalar(
                                                         8, 8)
                                                   name != "" && !is_intrinsic_name(name)
                                                      |
                                                         type_env::bind_local(env, name, err_ut, err_ti, <->)
                                                         type_env::init_mark_whole(env, name)
                                                   tast::mk_typed_var(name,
                                                     0, <->, err_ut,
                                                     err_ti, err_lay,
                                                     0, 0)
      [Bin b]
         b.0
            [Bind]
               pos_body' = b.2
               is_fn = pos_body' [Fn]
               !is_fn
                  |
                     pos_body' = ast::Expr(Bin,
                       (ast::BinaryOp(Feed), ast::Expr(Var, "_"), pos_body'))
               b0 = ast::ChoiceBranch(ast::GuardKind(Bare), ast::Exprs(),
                 ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                 pos_body')
               lhs_te = annotate_expr(ctx, env, b.1)
               c_lhs = unify::canon(ctx, lhs_te.ut)
               lhs_is_ram = c_lhs [Ram]
               !lhs_is_ram
                  |
                     unify::add_error(ctx, 3091,
                       "LHS of '$>>' must be a RamPP or RamPN ramification")
               no_pos_pay = c_lhs [Ram r] !r.0.has_payload | <->
               no_pos_pay
                  |
                     unify::add_error(ctx, 3091,
                       "LHS of '$>>' must have a positive payload")
               has_neg_pay = c_lhs [Ram r] r.1.has_payload | <->
               neg_tag = has_neg_pay | ast::Tag(Negative) | ast::Tag(Noth)
               neg_args = ast::Exprs()
               has_neg_pay | neg_args += ast::Expr(Var, "_")
               neg_body = ast::Expr(Variant,
                 ast::VariantExpr(neg_tag, neg_args))
               b1 = ast::ChoiceBranch(ast::GuardKind(Bare), ast::Exprs(),
                 ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                 neg_body)
               branches = ast::Branches()
               branches += b0
               branches += b1
               ch_expr = ast::Expr(Choice, ast::ChoiceExpr(b.1, <+>,
                 branches))
               ch_te = annotate_expr(ctx, env, ch_expr)
               c_res = unify::canon(ctx, ch_te.ut)
               is_ram_res = c_res [Ram]
               !is_ram_res
                  |
                     unify::add_error(ctx, 3091,
                       "Continuation of '$>>' must return a ramification")
               ch_te
            [MapPos]
               lhs_te = annotate_expr(ctx, env, b.1)
               c_lhs = unify::canon(ctx, lhs_te.ut)
               lhs_is_ram = c_lhs [Ram]
               !lhs_is_ram
                  |
                     unify::add_error(ctx, 3091,
                       "LHS of '$+>' must be a RamPP or RamPN ramification")
               no_pos_pay = c_lhs [Ram r] !r.0.has_payload | <->
               no_pos_pay
                  |
                     unify::add_error(ctx, 3091,
                       "LHS of '$+>' must have a positive payload")
               has_neg_pay = c_lhs [Ram r] r.1.has_payload | <->
               pos_tag = has_neg_pay | ast::Tag(Positive) | ast::Tag(Some)
               pos_body = wrap_functor_rhs(pos_tag, b.2)
               b0 = ast::ChoiceBranch(ast::GuardKind(Bare), ast::Exprs(),
                 ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                 pos_body)
               neg_tag = has_neg_pay | ast::Tag(Negative) | ast::Tag(Noth)
               neg_args = ast::Exprs()
               has_neg_pay | neg_args += ast::Expr(Var, "_")
               neg_body = ast::Expr(Variant,
                 ast::VariantExpr(neg_tag, neg_args))
               b1 = ast::ChoiceBranch(ast::GuardKind(Bare), ast::Exprs(),
                 ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                 neg_body)
               branches = ast::Branches()
               branches += b0
               branches += b1
               ch_expr = ast::Expr(Choice, ast::ChoiceExpr(b.1, <+>,
                 branches))
               annotate_expr(ctx, env, ch_expr)
            [MapNeg]
               lhs_te = annotate_expr(ctx, env, b.1)
               c_lhs = unify::canon(ctx, lhs_te.ut)
               lhs_is_ram = c_lhs [Ram]
               !lhs_is_ram
                  |
                     unify::add_error(ctx, 3091,
                       "LHS of '$->' must be a RamPP or RamNP ramification")
               no_neg_pay = c_lhs [Ram r] !r.1.has_payload | <->
               no_neg_pay
                  |
                     unify::add_error(ctx, 3091,
                       "LHS of '$->' must have a negative payload")
               has_pos_pay = c_lhs [Ram r] r.0.has_payload | <->
               pos_tag = has_pos_pay | ast::Tag(Positive) | ast::Tag(Succ)
               pos_args = ast::Exprs()
               has_pos_pay | pos_args += ast::Expr(Var, "_")
               pos_body = ast::Expr(Variant,
                 ast::VariantExpr(pos_tag, pos_args))
               b0 = ast::ChoiceBranch(ast::GuardKind(Bare), ast::Exprs(),
                 ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                 pos_body)
               neg_tag = has_pos_pay | ast::Tag(Negative) | ast::Tag(Err)
               neg_body = wrap_functor_rhs(neg_tag, b.2)
               b1 = ast::ChoiceBranch(ast::GuardKind(Bare), ast::Exprs(),
                 ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                 neg_body)
               branches = ast::Branches()
               branches += b0
               branches += b1
               ch_expr = ast::Expr(Choice, ast::ChoiceExpr(b.1, <+>,
                 branches))
               annotate_expr(ctx, env, ch_expr)
            [Feed, Apply]
               is_feed = b.0 [Feed]
               is_sat_curried = is_feed && is_saturated_curried_call(ctx, env, b.2)
               split = is_sat_curried
                  |
                     sat_args = ast::Exprs()
                     sat_args += b.1
                     (<+>, "", b.2, sat_args)
                  | apply_split(expr)
               split.0
                  |
                     ce = ast::CallExpr(split.1, split.2, split.3, 0, 0)
                     is_inline_choice_fn = b.2 [Fn fe_cf] (fe_cf.body [Choice]) | (b.2 [Choice])
                     saved_feed_exp = cur_expected_ut
                     is_feed && is_inline_choice_fn | (cur_expected_ut ::= <-->)
                     call_te = annotate_call(ctx, env, ce)
                     cur_expected_ut ::= saved_feed_exp
                     c_call = unify::canon(ctx, call_te.ut)
                     is_comp_lhs = b.1
                        [Var v_comp] ?v_comp > 6 && v_comp(0..6) == "_comp_"
                        | <->
                     is_match_rhs = !is_comp_lhs && (b.2
                        [Choice, Var] <+>
                        [Fn fe_m] fe_m.body [Choice]
                        | <->)
                     is_match_dispatch = is_feed && is_match_rhs
                     is_match_dispatch
                        |
                           c_call
                              [Fn f_res]
                                 ?f_res.params == 1
                                    |
                                       arg_te = annotate_call_arg(ctx, env, b.1)
                                       p0 = f_res.params(0) | _ |
                                          unify::UType(None)
                                       saved_errs_n = ?ctx.errors
                                       ok_p = unify::unify(ctx, p0, arg_te.ut)
                                       !ok_p
                                          |
                                             trimmed_errs = unify::TypeErrors()
                                             saved_errs_n @ ei =>
                                                trimmed_errs += ctx.errors(ei)!!
                                             ctx.errors = trimmed_errs
                                       ok_p
                                          |
                                             cargs = tast::TypedExprs()
                                             cargs += arg_te
                                             ret_ti =
                                                unify::type_info_from_utype(
                                                   ctx, f_res.ret)
                                             ret_lay =
                                                layout::compute_layout(ctx,
                                                  f_res.ret)
                                             tast::mk_typed_call("",
                                               <+ call_te +>, cargs,
                                               f_res.ret, ret_ti, ret_lay,
                                               0, 0)
                                          | call_te
                                    | call_te
                              | call_te
                        | call_te
                  |
                     op1 = b.0
                     lhs1 = annotate_expr(ctx, env, b.1)
                     rhs1 = annotate_expr(ctx, env, b.2)
                     res_ut1 = annotate_bin_op(ctx, op1, lhs1.ut, rhs1.ut)
                     ti1 = unify::type_info_from_utype(ctx, res_ut1)
                     lay1 = layout::compute_layout(ctx, res_ut1)
                     tast::mk_typed_bin(op1, lhs1, rhs1, res_ut1, ti1,
                       lay1, 0, 0)
            |
               op2 = b.0
               is_type_eq = op2 [Eq, NotEq]
               is_type_eq
                  |
                     rt1 = resolve_type_expr_ut_ti(ctx, env, "", b.1)
                     rt2 = resolve_type_expr_ut_ti(ctx, env, "", b.2)
                     (rt1.2 && rt2.2)
                        |
                           eq_r = utype_eq(ctx, rt1.0, rt2.0)
                           res_f = op2 [Eq] eq_r | !eq_r
                           --| tast::mk_lit_flag(res_f, 0, 0)
               lhs2 = annotate_expr(ctx, env, b.1)
               rhs2 = annotate_expr(ctx, env, b.2)
               res_ut2 = annotate_bin_op(ctx, op2, lhs2.ut, rhs2.ut)
               ti2 = unify::type_info_from_utype(ctx, res_ut2)
               lay2 = layout::compute_layout(ctx, res_ut2)
               tast::mk_typed_bin(op2, lhs2, rhs2, res_ut2, ti2, lay2, 0, 0)
      [Block be]
         annotate_block(ctx, env, be, cur_disc)
      [Assign a]
         name = a.0
         is_reserved_type_name(name)
            |
               unify::add_error(ctx, 3050, "Cannot define '" + name +
                 diag::E3050_reserved_type_name_suffix!)
         is_mut = a.1 || name_is_primed(name)
         is_compound = a.2
         is_global = a.3 || type_env::is_marked_global(env, name)
         a.3 && !env.in_fn | type_env::mark_global_var(env, name)
         is_fwd = is_fwd_assign(a)
         val_expr = a.5
         is_view = !(val_expr [Fn]) && is_view_expr(val_expr)
         is_outer_mut = name != "" && !<>(type_env::lookup_local_exact(env, name)) &&
           <>(type_env::lookup_nonroot_exact(env, name))
         is_view
            |
               (is_global || (!env.in_fn && !is_fwd) || is_compound || a.4 || is_outer_mut)
                  |
                     unify::add_error(ctx, 3150, diag::E3150_view_escape_frame!)
                  |
                     add_view_name(name)
         init_expr = a.6
         declared_ti = resolve_ct_ti_aliases(env, a.8)
         is_fwd
            |
               decl_ut = utype_from_ti_env(env, declared_ti)
               is_global
                  | type_env::bind_global(env, name, decl_ut, declared_ti)
                  | type_env::bind_local(env, name, decl_ut, declared_ti,
                    is_mut)
               c_decl = unify::canon(ctx, decl_ut)
               is_fn = c_decl [Fn]
               is_bf = is_bitfield_ti_env(env, declared_ti)
               is_growable = is_growable_ti_env(env, declared_ti)
               is_bf || is_growable
                  | type_env::init_mark_whole(env, name)
                  |
                     !is_fn && !is_global
                        |
                           type_env::init_mark_tracked(env, name)
                           mark_bitfield_fields_whole(env, name, declared_ti)
               is_fn
                  | tast::mk_lit_unit(0, 0)
                  |
                     lay = layout::compute_layout(ctx, decl_ut)
                     fwd_kind = tast::TypedExprKind(Var, ("<fwd>", 0, <->))
                     fwd_val = tast::mk_typed_expr(fwd_kind,
                       decl_ut, declared_ti, lay, 0, 0)
                     as_kind = tast::TypedExprKind(Assign,
                       (name, is_mut, <->, <->, <->, fwd_val))
                     tast::mk_typed_expr(as_kind, decl_ut, declared_ti,
                       lay, 0, 0)
            |
               init_expr
                  [Member mm]
                     annotate_member_write(ctx, env, mm, val_expr,
                       is_compound)
                  [Call cc]
                     annotate_index_write(ctx, env, cc, val_expr)
                  [KeyAccess ka]
                     annotate_key_write(ctx, env, ka, val_expr)
                  [RawMemory rm]
                     annotate_raw_write(ctx, env, rm, val_expr)
                  |
                     is_prior = is_global || a.4 || is_compound
                     target_bnd = is_prior
                        | type_env::lookup_binding(env, name)
                        |
                           loc_bnd = type_env::lookup_local(env, name)
                           <>(loc_bnd)
                              | loc_bnd
                              | is_mut
                                 |
                                    outer_bnd = type_env::lookup_nonroot_exact(env, name)
                                    outer_bnd
                                       | ob =>
                                          ob.is_mut | <+ ob +> | <-->
                                       | <-->
                                 | <-->
                     rhs' = tast::mk_lit_unit(0, 0)
                     target_bnd
                        | tb =>
                           c_tb = unify::canon(ctx, tb.ut)
                           val_expr
                              [Fn fe]
                                 c_tb
                                    [Fn f]
                                       is_top = env.cur_depth == 0 &&
                                         !env.in_fn
                                       type_env::enter_scope(env)
                                       saved_in_fn = env.in_fn
                                       saved_fn_ret = env.cur_fn_ret
                                       saved_init = type_env::init_snapshot(
                                          env)
                                       env.in_fn = <+>
                                       env.cur_fn_ret = <+ f.ret +>
                                       env.init = type_env::new_init!
                                       param_uts = unify::UTypes()
                                       ?fe.params @ p_i =>
                                          pname = fe.params(p_i) | _ | ""
                                          put = f.params(p_i) | _ |
                                             unify::fresh_var(ctx)
                                          param_uts += put
                                          pname != ""
                                             |
                                                put_ti =
                                                   unify::type_info_from_utype(
                                                      ctx, put)
                                                type_env::bind_local(env,
                                                  pname, put, put_ti, <->)
                                                type_env::init_mark_whole(
                                                   env, pname)
                                       c_ret = unify::canon(ctx, f.ret)
                                       is_ret_unit' = <->
                                       c_ret
                                          [Prim p] (is_ret_unit' = p [Unit])
                                       env.discard_result = is_ret_unit'
                                       cached = is_top
                                          | type_env::lookup_fn_body(env, name)
                                          | <-->
                                       saved_assign_exp = cur_expected_ut
                                       saved_assign_fn = cur_fn_name
                                       !is_top && fn_captures_view(fe)
                                          | unify::add_error(ctx, 3150,
                                            diag::E3150_view_escape_frame!)
                                       saved_views = ++view_vars
                                       view_vars ::= ast::Names()
                                       cur_expected_ut ::= <+ f.ret +>
                                       is_top | (cur_fn_name ::= name)
                                       assign_fn_errs0 = unify::error_count(ctx)
                                       body_te = cached
                                          | _
                                          |
                                             check_no_closing_return(ctx, fe.body)
                                             annotate_expr(ctx, env, fe.body)
                                       assign_fn_errs1 = unify::error_count(ctx) > assign_fn_errs0
                                       cur_fn_name ::= saved_assign_fn
                                       cur_expected_ut ::= saved_assign_exp
                                       is_view_expr(fe.body)
                                          | unify::add_error(ctx, 3150,
                                            diag::E3150_view_escape_frame!)
                                       view_vars ::= saved_views
                                       type_env::init_restore(env, saved_init)
                                       env.in_fn = saved_in_fn
                                       env.cur_fn_ret = saved_fn_ret
                                       type_env::leave_scope(env)
                                       assign_fn_errs1
                                          | unify::canon(ctx, f.ret) [Var] unify::unify(ctx, f.ret, unify::poison_utype!)
                                          |
                                             ok_ret = is_ret_unit' || expr_is_jump(body_te) ||
                                               unify::unify(ctx, f.ret, body_te.ut)
                                             !ok_ret
                                                |
                                                   unify::add_error(ctx, 3084,
                                                     diag::return_type_mismatch_prefix! + name)
                                       ret_res_ut = assign_fn_errs1
                                          | unify::poison_utype!
                                          | (expr_is_jump(body_te) | f.ret | body_te.ut)
                                       fn_ut = unify::mk_fn(param_uts,
                                         ret_res_ut)
                                       ti = unify::type_info_from_utype(
                                          ctx, fn_ut)
                                       rhs' = mk_lambda_te_at(fe.params, body_te,
                                         fn_ut, ti, fe.line, fe.col)
                                    |
                                       saved_arr_exp1 = cur_expected_ut
                                       (is_compound && (c_tb [Array]))
                                          |
                                             c_tb [Array arr_exp] (cur_expected_ut ::= <+ arr_exp.elem +>)
                                       rhs' = annotate_expr(ctx, env, val_expr)
                                       cur_expected_ut ::= saved_arr_exp1
                              |
                                 saved_arr_exp2 = cur_expected_ut
                                 (is_compound && (c_tb [Array]))
                                    |
                                       c_tb [Array arr_exp] (cur_expected_ut ::= <+ arr_exp.elem +>)
                                 rhs' = annotate_expr(ctx, env, val_expr)
                                 cur_expected_ut ::= saved_arr_exp2
                           is_compound
                              |
                                 c_tb
                                    [Prim p]
                                       (p [Builder])
                                          |
                                             c_rhs = unify::canon(ctx, rhs'.ut)
                                             ok_rhs' = <->
                                             c_rhs
                                                [Prim pr]
                                                   ok_rhs' =
                                                      is_builder_append_prim(pr)
                                                [Rec r]
                                                   ok_rhs' =
                                                      is_builder_append_rec(ctx,
                                                        r, 0, ?r)
                                                [Var]
                                                   ok_rhs' = <+>
                                             !ok_rhs'
                                                |
                                                   unify::add_error(ctx, 3084,
                                                     diag::E3084_builder_append_type!)
                                          |
                                             ok = unify::unify(ctx, tb.ut,
                                               rhs'.ut)
                                             !ok
                                                |
                                                   unify::add_error(ctx, 3084,
                                                     "Type mismatch in " +
                                                     "compound assignment " +
                                                     "to: " + name)
                                    [Array arr]
                                       ok = unify::unify(ctx, arr.elem, rhs'.ut)
                                       !ok
                                          |
                                             unify::add_error(ctx, 3084,
                                               "Type mismatch in array " +
                                               "append to: " + name)
                                    |
                                       is_var = c_tb [Var]
                                       !is_var
                                          |
                                             unify::add_error(ctx, 3084,
                                               "Type does not support " +
                                               "compound assignment")
                              |
                                 is_bld' = <->
                                 c_tb
                                    [Prim p_bld]
                                       is_bld' = p_bld [Builder]
                                 is_fn_fe = val_expr [Fn]
                                 is_tb_fn = c_tb [Fn]
                                 is_both = is_fn_fe && is_tb_fn
                                 c_rhs_u = unify::canon(ctx, rhs'.ut)
                                 is_rhs_unit = c_rhs_u [Prim p_u] (p_u [Unit]) | <->
                                 is_rhs_unit
                                    |
                                       unify::add_error(ctx, 3032,
                                         diag::assign_void_variable(name))
                                 !is_both && !is_bld' && !a.4 && !is_global
                                    |
                                       rebind = !tb.is_mut && !is_mut &&
                                         (type_env::init_is_whole(env, name) ||
                                           is_tb_fn)
                                       rebind
                                          |
                                             unify::add_error(ctx, 3033,
                                               diag::reassign_immutable(name))
                                          |
                                             ok = unify::unify(ctx, tb.ut,
                                               rhs'.ut)
                                             !ok
                                                |
                                                   unify::add_error(ctx, 3084,
                                                     diag::assignment_type_mismatch_prefix! + name)
                                 is_global && !is_both && !is_bld' && !a.4
                                    |
                                       ok_g = unify::unify(ctx, tb.ut, rhs'.ut)
                                       !ok_g
                                          |
                                             unify::add_error(ctx, 3084,
                                               diag::assignment_type_mismatch_prefix! + name)
                        |
                           is_must_exist = is_global || a.4
                           is_must_exist
                              |
                                 unify::add_error(ctx, 3004,
                                   "Undefined variable: " + name)
                           rhs' = annotate_expr(ctx, env, val_expr)
                           c_rhs_u2 = unify::canon(ctx, rhs'.ut)
                           is_rhs_unit2 = c_rhs_u2 [Prim p_u2] (p_u2 [Unit]) | <->
                           is_rhs_unit2
                              |
                                 unify::add_error(ctx, 3032,
                                   diag::assign_void_variable(name))
                           is_global
                              |
                                 type_env::bind_global(env, name,
                                   rhs'.ut, rhs'.ti)
                              |
                                 type_env::bind_local(env, name,
                                   rhs'.ut, rhs'.ti, is_mut)
                     name != ""
                        | type_env::init_mark_whole(env, name)
                     val_expr
                        [Call ce_rhs]
                           ce_rhs.fn_name != "" && name != ""
                              |
                                 g_opt = type_env::lookup_generic(env,
                                   ce_rhs.fn_name)
                                 g_opt
                                    |
                                       type_env::mark_generic_binding(env,
                                         name)
                           name != ""
                              |
                                 ce_rhs.args @ ca =>
                                    ca
                                       [Var cvn]
                                          cvn != "" && has_name_in(user_fns, cvn)
                                             |
                                                fn_alias_vars += name
                                                fn_alias_tgts += cvn
                        [Var v_rhs]
                           is_gen_var = type_env::is_generic_binding(env,
                             v_rhs)
                           is_gen_var && name != ""
                              | type_env::mark_generic_binding(env, name)
                           v_rhs != "" && has_name_in(user_fns, v_rhs) && name != ""
                              |
                                 fn_alias_vars += name
                                 fn_alias_tgts += v_rhs
                        [Choice ch_rhs]
                           name != ""
                              |
                                 ch_rhs.branches @ cbr =>
                                    cbr.block
                                       [Var cbvn]
                                          cbvn != "" && has_name_in(user_fns, cbvn)
                                             |
                                                fn_alias_vars += name
                                                fn_alias_tgts += cbvn
                     tast::mk_typed_assign(name, is_mut,
                       is_compound, is_global,
                       a.4, rhs', unify::prim_unit!, ast::TypeInfo(Prim,
                         ast::ValueType(Unit)), tast::layout_void!, 0, 0)
      [Call ce]
         annotate_call(ctx, env, ce)
      [Fn fe]
         annotate_fn(ctx, env, fe, cur_disc)
      [Choice ch]
         annotate_choice(ctx, env, ch, cur_disc)
      [Record re]
         annotate_record(ctx, env, re)
      [MapLiteral ml]
         k_ut = unify::fresh_var(ctx)
         v_ut = unify::fresh_var(ctx)
         typed_pairs = tast::TypedMapPairs()
         ml @ pair =>
            kte = annotate_expr(ctx, env, pair.key)
            vte = annotate_expr(ctx, env, pair.value)
            unify::unify(ctx, k_ut, kte.ut)
            unify::unify(ctx, v_ut, vte.ut)
            typed_pairs += tast::TypedMapPair(kte, vte)
         !unify::is_map_key_utype(ctx, k_ut)
            |
               unify::add_error(ctx, 2090,
                 "Map key type must be String, Int, or Addr")
         map_ut = unify::mk_map(k_ut, v_ut)
         ti = unify::type_info_from_utype(ctx, map_ut)
         lay = layout::compute_layout(ctx, map_ut)
         tast::mk_typed_expr(tast::TypedExprKind(MapLiteral, typed_pairs),
           map_ut, ti, lay, 0, 0)
      [Unary u]
         op = u.0
         saved_un_exp = cur_expected_ut
         op [Freeze] (cur_expected_ut ::= <+ unify::prim_builder! +>)
         inner_te = annotate_expr(ctx, env, u.1)
         cur_expected_ut ::= saved_un_exp
         res_ut = annotate_unary_op(ctx, env, op, inner_te.ut, u.1)
         ti = unify::type_info_from_utype(ctx, res_ut)
         lay = layout::compute_layout(ctx, res_ut)
         tast::mk_typed_unary(op, inner_te, res_ut, ti, lay, 0, 0)
      [Member m]
         m.line > 0 | unify::set_pos(ctx, m.line, m.col)
         m.is_module_access
            |
               qn = module_qualified_name(
                  m.target, m.field_name)
               resolve_module_access(ctx, env, qn,
                 m.line, m.col)
            |
               m.field_name == "#members"
                  |
                     unify::add_error(ctx, 3084,
                       "'#members' must be followed by '@' in a cycle.")
                     --| tast::mk_lit_unit(m.line, m.col)
               cur_tgt_v = m.target [Var cv] cv | ""
               cur_hit = cur_tgt_v != "" | lookup_ct_cursor(cur_tgt_v) | <-->
               cur_hit | cur => --| annotate_cursor_member(ctx, env, m, cur)
               tc_opt = (m.field_name ["#type_name", "#type_zero", "#type_arity",
                 "#type_size", "#type_align"] || m.field_name == "")
                  | annotate_type_carrier_member(ctx, env, m)
                  | <-->
               tc_opt
                  | te => --| te
               saved_tgt = env.in_member_target
               env.in_member_target = <+>
               target_te = annotate_expr(
                  ctx, env, m.target)
               env.in_member_target = saved_tgt
               fname' = m.field_name
               ct_idx_opt = fname' == ""
                  | m.index_expr
                     [Int n] <+ n +>
                     [Var v]
                        lookup_ct_int(v)
                           | ci => <+ ci +>
                           | lookup_ct_cursor(v) | cur => <+ cur.idx +> | <-->
                     | <-->
                  | <-->
               c_tgt_pre = unify::canon(ctx, target_te.ut)
               c_tgt_pre [Poison]
                  --| tast::mk_typed_member(target_te, fname', -1,
                    unify::poison_utype!, ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                    tast::layout_scalar(8, 8), m.line, m.col)
               exact_idx' = ct_idx_opt | _ | -1
               direct_fld_ut' = <-->
               fname' == ""
                  |
                     ct_idx_opt
                        | idx_v =>
                           c_tgt_pre
                              [Rec r_pre]
                                 idx_v < 0 || idx_v !< ?r_pre
                                    | unify::add_error(ctx, 3171,
                                      "Record field index ${idx_v} out of range (0..${?r_pre - 1}).")
                                    |
                                       f_opt = r_pre(idx_v)!!
                                       fname' = f_opt.name != "" | f_opt.name | str::from_int(idx_v)
                                       direct_fld_ut' = <+ f_opt.ut +>
                              [Enum ue_raw]
                                 uenum_v = resolve_enum_ut(ctx, env, ue_raw)
                                 n_ev = ?uenum_v.variants
                                 idx_v < 0 || idx_v !< n_ev
                                    |
                                       unify::add_error(ctx, 3171,
                                         "Enum variant index ${idx_v} out of range (0..${n_ev - 1}).")
                                       --| tast::mk_lit_flag(<->, m.line, m.col)
                                    |
                                       vi = uenum_v.variants(idx_v)!!
                                       b0_vnames = ast::Names()
                                       b0_vnames += vi.label
                                       vi.has_payload
                                          |
                                             pay_ut = vi.payload_type
                                             pay_ti = unify::type_info_from_utype(ctx, pay_ut)
                                             pay_lay = layout::compute_layout(ctx, pay_ut)
                                             ram_ut = unify::ram_pn(pay_ut)
                                             ram_ti = unify::type_info_from_utype(ctx, ram_ut)
                                             ram_lay = layout::compute_layout(ctx, ram_ut)
                                             b0_vars = ast::Names()
                                             b0_vars += "_"
                                             pay_var = tast::mk_typed_var("_", 0, <->, pay_ut,
                                               pay_ti, pay_lay, m.line, m.col)
                                             b0_body = tast::mk_typed_ram_construct(
                                               unify::URamShape(RamPN), <+>, <+ pay_var +>,
                                               ram_ut, ram_ti, ram_lay, m.line, m.col)
                                             br0 = tast::TypedBranch(ast::GuardKind(Variant),
                                               tast::TypedExprs(), <-->, b0_vnames, b0_vars, b0_body)
                                             b1_body = tast::mk_typed_ram_construct(
                                               unify::URamShape(RamPN), <->, <-->,
                                               ram_ut, ram_ti, ram_lay, m.line, m.col)
                                             br1 = tast::TypedBranch(ast::GuardKind(Bare),
                                               tast::TypedExprs(), <-->, ast::Names(),
                                               ast::Names(), b1_body)
                                             brs = tast::TypedBranches()
                                             brs += br0
                                             brs += br1
                                             --| tast::mk_typed_expr(
                                               tast::TypedExprKind(Choice, (target_te, brs)),
                                               ram_ut, ram_ti, ram_lay, m.line, m.col)
                                          |
                                             ram_ut = unify::ram_pn(unify::prim_unit!)
                                             ram_ti = unify::type_info_from_utype(ctx, ram_ut)
                                             ram_lay = layout::compute_layout(ctx, ram_ut)
                                             b0_body = tast::mk_typed_ram_construct(
                                               unify::URamShape(RamPN), <+>, <-->,
                                               ram_ut, ram_ti, ram_lay, m.line, m.col)
                                             br0 = tast::TypedBranch(ast::GuardKind(Variant),
                                               tast::TypedExprs(), <-->, b0_vnames, ast::Names(), b0_body)
                                             b1_body = tast::mk_typed_ram_construct(
                                               unify::URamShape(RamPN), <->, <-->,
                                               ram_ut, ram_ti, ram_lay, m.line, m.col)
                                             br1 = tast::TypedBranch(ast::GuardKind(Bare),
                                               tast::TypedExprs(), <-->, ast::Names(),
                                               ast::Names(), b1_body)
                                             brs = tast::TypedBranches()
                                             brs += br0
                                             brs += br1
                                             --| tast::mk_typed_expr(
                                               tast::TypedExprKind(Choice, (target_te, brs)),
                                               ram_ut, ram_ti, ram_lay, m.line, m.col)
               root = member_root_str(m.target)
               root != "" && !env.in_lvalue && fname' != ""
                  |
                     root_var = member_root_name(m.target)
                     !member_has_module_access(m.target) &&
                       !type_env::is_marked_global(env, root_var) &&
                       type_env::init_is_tracked(env, root_var)
                       |
                          ipath = root + "." + fname'
                          ok = type_env::init_is_ok(
                             env, ipath)
                          !ok
                             |
                                eb = {80}
                                eb += ("Field '", fname', "' of '", root,
                                  "' read before init.")
                                unify::add_error(
                                   ctx, 3130, +eb)
               fld_ut = unify::fresh_var(ctx)
               c_tgt = unify::canon(ctx, target_te.ut)
               c_tgt
                  [Rec r_chk]
                     exact_idx' < 0 && fname' != ""
                        | exact_idx' = unify::find_field_idx(r_chk, fname')
               is_type_tgt = c_tgt [Prim p_t] (p_t [Type]) | <->
               type_prop_ti' = <-->
               is_type_tgt && fname' == "" && exact_idx' !< 0
                  |
                     rt_idx = resolve_type_expr_ut_ti(ctx, env, "", m.target)
                     rt_idx.2
                        |
                           rt_idx.0 [Rec, Enum] unify::unify(ctx, fld_ut, unify::prim_str!)
               is_type_prop = fname' ["#type_name", "#type_zero", "#type_arity",
                 "#type_size", "#type_align"]
               is_type_tgt && is_type_prop
                  |
                     fname'
                        ["#type_name"]
                           unify::unify(ctx, fld_ut, unify::prim_str!)
                        ["#type_size", "#type_align"]
                           unify::unify(ctx, fld_ut, unify::prim_int!)
                        ["#type_arity"]
                           rt_a = resolve_type_expr_ut_ti(ctx, env, "", m.target)
                           rt_a.2
                              |
                                 c_ra = unify::canon(ctx, rt_a.0)
                                 !(c_ra [Rec, Enum, Var])
                                    | unify::add_error(ctx, 3084,
                                      "'#arity' requires a record or enum type.")
                           unify::unify(ctx, fld_ut, unify::prim_int!)
                        |
                           rt_z = resolve_type_expr_ut_ti(ctx, env, "", m.target)
                           rt_z.2
                              |
                                 unify::unify(ctx, fld_ut, rt_z.0)
                                 type_prop_ti' = <+ rt_z.1 +>
               has_type_prefix = ?fname' !< 6 && fname'(0..6) == "#type_"
               !is_type_tgt && has_type_prefix
                  | unify::add_error(ctx, 3084,
                    "'#${fname'(6..)}' requires a type operand.")
               swz_status' = ((is_type_tgt && is_type_prop) || has_type_prefix) | 2 | 0
               c_tgt
                  [Rec r_swz]
                     exact_idx' < 0 && fname' != "" && env.swizzle_mode != "none"
                        | swz_status' = check_swizzle_pattern(ctx, env.swizzle_mode,
                          r_swz, fname')
               swz_status' == 1
                  |
                     c_tgt
                        [Rec r_ok]
                           elem_fld = r_ok(0) | _ | unify::UField("", unify::UType(None))
                           elem_ut = elem_fld.ut
                           flen = ?fname'
                           flen == 1
                              | (fld_ut = elem_ut)
                              |
                                 res_fields' = unify::UFields()
                                 flen @ res_fields' += unify::UField("", elem_ut)
                                 fld_ut = unify::UType(Rec, res_fields')
                  |
                     swz_status' == 0 && fname' != ""
                        |
                           direct_fld_ut'
                              | dut => unify::unify(ctx, fld_ut, dut)
                              | unify::solve_field(ctx, target_te.ut, fname', fld_ut)
               idx' = swz_status' == 1 | -2 | exact_idx'
               fname' == "" && idx' < 0
                  |
                     unify::add_error(ctx, 3170,
                       diag::member_index_constant!)
               fld_ti_opt = <>(type_prop_ti')
                  | type_prop_ti'
                  |
                     fname' != "" && swz_status' != 1
                        | member_field_ti(env, target_te.ti, fname')
                        | <-->
               ti = fld_ti_opt
                  | _
                  | unify::type_info_from_utype(ctx, fld_ut)
               lay = layout::compute_layout(ctx, fld_ut)
               tast::mk_typed_member(target_te, fname', idx', fld_ut, ti,
                 lay, m.line, m.col)
      [Cycle c]
         c.is_expr
            | annotate_cycle_expr(ctx, env, c)
            | annotate_cycle(ctx, env, c, <-->)
      [CycleEscape ce]
         ce.cycle
            [Cycle c2]
               annotate_cycle(ctx, env, c2, <+ ce.branch +>)
            |
               esc_te = annotate_expr(ctx, env, ce.branch)
               cyc_te = annotate_expr(ctx, env, ce.cycle)
               ram_ut = unify::ram_pn(esc_te.ut)
               ti = unify::type_info_from_utype(ctx, ram_ut)
               lay = layout::compute_layout(ctx, ram_ut)
               tast::mk_typed_cycle(cyc_te, tast::mk_lit_unit(0, 0),
                 <+ esc_te +>, <->, ram_ut, ti, lay, 0, 0)
      [CycleJump cj]
         tast::mk_typed_cycle_jump(cj.is_break, cj.level, 0, 0)
      [Copy cp]
         inner_te = annotate_expr(ctx, env, cp)
         ti = unify::type_info_from_utype(ctx, inner_te.ut)
         lay = layout::compute_layout(ctx, inner_te.ut)
         tast::mk_typed_copy(inner_te, inner_te.ut, ti, lay, 0, 0)
      [BuilderCreate bc]
         cap_te = annotate_expr(ctx, env, bc)
         ut = unify::prim_builder!
         ti = ast::TypeInfo(Prim, ast::ValueType(Builder))
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_builder_new(cap_te, ut, ti, lay, 0, 0)
      [ArrayCreate ac]
         elem_ut = utype_from_ti_env(env, ac.elem_type)
         elem_vt = unify::vt_from_utype(ctx, elem_ut)
         real_cap = ac.cap < 1 | 16 | ac.cap
         arr_ti = ast::TypeInfo(Array, (elem_vt, ac.elem_type, real_cap))
         arr_ut = unify::mk_array(elem_ut, real_cap)
         arr_lay = layout::compute_layout(ctx, arr_ut)
         tast::mk_typed_expr(tast::TypedExprKind(ArrayNew, ac),
           arr_ut, arr_ti, arr_lay, 0, 0)
      [NamedArg na]
         annotate_expr(ctx, env, na.val)
      [RawMemory rm]
         addr_te = annotate_expr(ctx, env, rm.addr)
         !is_int_or_ptr_ut(ctx, addr_te.ut)
            | unify::unify(ctx, addr_te.ut, unify::prim_rawptr!)
         is_unk = rm.load_type [Unknown]
         is_rec = rm.rec_name != ""
         is_rec
            |
               ti = ast::TypeInfo(TypeVar, rm.rec_name)
               ut = utype_from_ti_env(env, ti)
               lay = layout::compute_layout(ctx, ut)
               tast::mk_typed_raw_memory(addr_te, rm.load_type, ut, ti,
                 lay, 0, 0)
            |
               ut = is_unk | unify::prim_rawptr! |
                  unify::UType(Prim, unify::vt_to_uprim(rm.load_type))
               ti = is_unk | ast::TypeInfo(Prim, ast::ValueType(RawPtr)) |
                  ast::TypeInfo(Prim, rm.load_type)
               lay = layout::compute_layout(ctx, ut)
               tast::mk_typed_raw_memory(addr_te, rm.load_type, ut, ti,
                 lay, 0, 0)
      [Variant ve]
         is_pos = ve.tag_name [Positive]
         is_neg = ve.tag_name [Negative]
         is_some = ve.tag_name [Some]
         is_err = ve.tag_name [Err]
         is_succ = ve.tag_name [Succ]
         nargs = ?ve.args
         nargs == 0
            |
               (is_pos || is_neg)
                  |
                     flg_ut = unify::prim_flag!
                     flg_ti = ast::TypeInfo(Prim, ast::ValueType(Flag))
                     flg_lay = layout::compute_layout(ctx, flg_ut)
                     flg_val = is_pos
                     tast::mk_lit_flag(flg_val, 0, 0)
                  |
                     u_var = unify::fresh_var(ctx)
                     u_ut = is_succ | unify::ram_np(u_var) |
                        unify::ram_pn(u_var)
                     u_ti = unify::type_info_from_utype(ctx, u_ut)
                     u_lay = layout::compute_layout(ctx, u_ut)
                     rsh = is_succ | unify::URamShape(RamNP) |
                        unify::URamShape(RamPN)
                     tast::mk_typed_ram_construct(rsh, is_succ, <-->,
                       u_ut, u_ti, u_lay, 0, 0)
            |
               pay_te = annotate_expr(ctx, env, ve.args(0)!!)
               (is_pos || is_some)
                  |
                     p_ut = is_some | unify::ram_pn(pay_te.ut) |
                        unify::ram_pp(pay_te.ut, unify::fresh_var(ctx))
                     p_ti = unify::type_info_from_utype(ctx, p_ut)
                     p_lay = layout::compute_layout(ctx, p_ut)
                     rshape = is_some | unify::URamShape(RamPN) |
                        unify::URamShape(RamPP)
                     tast::mk_typed_ram_construct(rshape, <+>,
                       <+ pay_te +>, p_ut, p_ti, p_lay, 0, 0)
                  |
                     n_ut = is_err | unify::ram_np(pay_te.ut) |
                        unify::ram_pp(unify::fresh_var(ctx), pay_te.ut)
                     n_ti = unify::type_info_from_utype(ctx, n_ut)
                     n_lay = layout::compute_layout(ctx, n_ut)
                     rshape = is_err | unify::URamShape(RamNP) |
                        unify::URamShape(RamPP)
                     tast::mk_typed_ram_construct(rshape, <->,
                       <+ pay_te +>, n_ut, n_ti, n_lay, 0, 0)
      [KeyAccess ka]
         ka.line > 0 | unify::set_pos(ctx, ka.line, ka.col)
         target_te = annotate_expr(ctx, env, ka.target)
         key_te = annotate_expr(ctx, env, ka.key)
         c_tgt = unify::canon(ctx, target_te.ut)
         ka.is_membership || ka.is_delete
            |
               c_tgt
                  [Map m]
                     unify::unify(ctx, m.key, key_te.ut)
                  |
                     !unify::is_map_key_utype(ctx, key_te.ut)
                        |
                           unify::add_error(ctx, 2090,
                             "Map key type must be String, Int, or Addr")
                     var_map = unify::mk_map(key_te.ut, unify::fresh_var(ctx))
                     unify::unify(ctx, target_te.ut, var_map)
               flg_ut = unify::prim_flag!
               flg_ti = ast::TypeInfo(Prim, ast::ValueType(Flag))
               flg_lay = layout::compute_layout(ctx, flg_ut)
               tast::mk_typed_expr(tast::TypedExprKind(KeyAccess,
                 (target_te, key_te, ka.is_membership, ka.is_delete)),
                 flg_ut, flg_ti, flg_lay, ka.line, ka.col)
            |
               elem_ut' = unify::fresh_var(ctx)
               c_tgt
                  [Array arr]
                     unify::unify(ctx, key_te.ut, unify::prim_int!)
                     elem_ut' = arr.elem
                  [Slice sl]
                     unify::unify(ctx, key_te.ut, unify::prim_int!)
                     elem_ut' = sl
                  [Map m]
                     unify::unify(ctx, m.key, key_te.ut)
                     elem_ut' = m.val
                  |
                     !unify::is_map_key_utype(ctx, key_te.ut)
                        |
                           unify::add_error(ctx, 2090,
                             "Map key type must be String, Int, or Addr")
                     var_map2 = unify::mk_map(key_te.ut, elem_ut')
                     unify::unify(ctx, target_te.ut, var_map2)
               ram_ut = unify::ram_pp(elem_ut', unify::prim_error!)
               ti = unify::type_info_from_utype(ctx, ram_ut)
               lay = layout::compute_layout(ctx, ram_ut)
               tast::mk_typed_expr(tast::TypedExprKind(KeyAccess,
                 (target_te, key_te, <->, <->)), ram_ut, ti, lay,
                 ka.line, ka.col)
      [Range r]
         lhs_te = r.has_lhs | annotate_expr(ctx, env, r.lhs) |
            tast::mk_lit_int(0, 0, 0)
         rhs_raw = r.has_rhs | annotate_expr(ctx, env, r.rhs) |
            tast::mk_lit_unit(0, 0)
         inc_te = tast::mk_typed_bin(ast::BinaryOp(Add), rhs_raw,
           tast::mk_lit_int(1, 0, 0), rhs_raw.ut, rhs_raw.ti, rhs_raw.layout,
           0, 0)
         rhs_te = r.has_rhs && r.is_inclusive | inc_te | rhs_raw
         is_rune = is_rune_ut(ctx, lhs_te.ut) || is_rune_ut(ctx, rhs_te.ut)
         ut = is_rune | unify::prim_rune! | unify::prim_int!
         ti = is_rune | ast::TypeInfo(Prim, ast::ValueType(Rune)) |
            ast::TypeInfo(Prim, ast::ValueType(Int))
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_bin(ast::BinaryOp(Seq), lhs_te, rhs_te, ut, ti, lay,
           0, 0)
      [SizeOf so]
         ut = unify::prim_int!
         ti = ast::TypeInfo(Prim, ast::ValueType(Int))
         lay = layout::compute_layout(ctx, ut)
         sz = annotate_type_size(env, so.val_type, so.rec_type)
         tast::mk_lit_int(sz, 0, 0)
      [AlignOf ao]
         ut = unify::prim_int!
         ti = ast::TypeInfo(Prim, ast::ValueType(Int))
         lay = layout::compute_layout(ctx, ut)
         al = annotate_type_align(env, ao.val_type, ao.rec_type)
         tast::mk_lit_int(al, 0, 0)
      [TypeCast tc]
         inner_te = annotate_expr(ctx, env, tc.expr)
         ut = unify::UType(Prim, unify::vt_to_uprim(tc.target_type))
         ti = ast::TypeInfo(Prim, tc.target_type)
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_expr(tast::TypedExprKind(Copy, inner_te), ut, ti,
           lay, 0, 0)
      [Spawn se]
         call_te = annotate_call(ctx, env, se)
         ret_ram = unify::ram_pp(call_te.ut, unify::prim_error!)
         ti = unify::type_info_from_utype(ctx, ret_ram)
         lay = layout::compute_layout(ctx, ret_ram)
         tast::mk_typed_expr(tast::TypedExprKind(Spawn, se),
           ret_ram, ti, lay, se.line, se.col)
      [Join je]
         handle_te = annotate_expr(ctx, env, je)
         c_h = unify::canon(ctx, handle_te.ut)
         ret_ut' = handle_te.ut
         c_h
            [Ram r] (ret_ut' = handle_te.ut)
            |
               fresh_elem = unify::fresh_var(ctx)
               ret_ut' = unify::ram_pp(fresh_elem, unify::prim_error!)
               unify::unify(ctx, handle_te.ut, ret_ut')
         ti = unify::type_info_from_utype(ctx, ret_ut')
         lay = layout::compute_layout(ctx, ret_ut')
         tast::mk_typed_expr(tast::TypedExprKind(Join, je),
           ret_ut', ti, lay, 0, 0)
      [CompileTime ct]
         saved_in_ct = in_ct_expr
         in_ct_expr ::= <+>
         inner_te = annotate_expr(ctx, env, ct)
         in_ct_expr ::= saved_in_ct
         tast::mk_typed_expr(tast::TypedExprKind(CompileTime, ct),
           inner_te.ut, inner_te.ti, inner_te.layout, 0, 0)
      [NamedArg na]
         annotate_expr(ctx, env, na.val)
      [FastMathPragma]
         tast::mk_lit_unit(0, 0)
      [SwizzlePragma mode]
         env.swizzle_mode = mode
         tast::mk_lit_unit(0, 0)
      [Exit ex]
         ex_te = annotate_expr(ctx, env, ex)
         ut = unify::prim_unit!
         ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
         lay = tast::layout_void!
         tast::mk_typed_expr(tast::TypedExprKind(Exit, ex_te), ut, ti, lay,
           ex_te.line, ex_te.col)
      [Return r]
         r.line > 0 | unify::set_pos(ctx, r.line, r.col)
         r.has_val && is_view_expr(r.val)
            | unify::add_error(ctx, 3150, diag::E3150_view_escape_frame!)
         !env.in_fn
            |
               unify::add_error(ctx, 3173, diag::E3173_return_outside_fn!)
               val_opt = r.has_val | <+ annotate_expr(ctx, env, r.val) +> | <-->
               tast::mk_typed_return(val_opt, unify::prim_unit!,
                 ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!, r.line, r.col)
            |
               env.cur_fn_ret
                  | ret_ut =>
                     c_ret = unify::canon(ctx, ret_ut)
                     is_ret_unit' = c_ret [Prim p] (p [Unit]) | <->
                     is_ret_unit'
                        |
                           r.has_val
                              |
                                 unify::add_error(ctx, 3173,
                                   "Cannot return a value from a void function.")
                                 val_te = annotate_expr(ctx, env, r.val)
                                 tast::mk_typed_return(<+ val_te +>, unify::prim_unit!,
                                   ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!, r.line, r.col)
                              |
                                 tast::mk_typed_return(<-->, unify::prim_unit!,
                                   ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!, r.line, r.col)
                        |
                           !r.has_val
                              |
                                 unify::add_error(ctx, 3173,
                                   "Missing return value in function returning a value.")
                                 tast::mk_typed_return(<-->, unify::prim_unit!,
                                   ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!, r.line, r.col)
                              |
                                 val_te = annotate_expr(ctx, env, r.val)
                                 shape_ok = check_return_ram_shape(ctx, ret_ut, val_te.ut)
                                 shape_ok
                                    |
                                       ok = unify::unify(ctx, ret_ut, val_te.ut)
                                       !ok
                                          |
                                             unify::add_error(ctx, 3084,
                                               "Return expression type mismatch")
                                 tast::mk_typed_return(<+ val_te +>, unify::prim_unit!,
                                   ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!, r.line, r.col)
                  |
                     r.has_val
                        |
                           val_te = annotate_expr(ctx, env, r.val)
                           ret_v = unify::fresh_var(ctx)
                           env.cur_fn_ret = <+ ret_v +>
                           unify::unify(ctx, ret_v, val_te.ut)
                           tast::mk_typed_return(<+ val_te +>, unify::prim_unit!,
                             ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!, r.line, r.col)
                        |
                           tast::mk_typed_return(<-->, unify::prim_unit!,
                             ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!, r.line, r.col)
      [UserDiag diag]
         diag.line > 0 | unify::set_pos(ctx, diag.line, diag.col)
         annotate_expr(ctx, env, diag.msg)
         ut = diag.is_warn | unify::prim_unit! | unify::fresh_var(ctx)
         vt = diag.is_warn | ast::ValueType(Unit) | ast::ValueType(Unknown)
         ti = ast::TypeInfo(Prim, vt)
         lay = tast::layout_void!
         tast::mk_typed_expr(tast::TypedExprKind(UserDiag, diag),
           ut, ti, lay, diag.line, diag.col)
      |
         tast::mk_lit_unit(0, 0)

// Whether call argument `a` is exactly the placeholder `_` (positional or `name = _`).
is_placeholder_arg: ast::Expr => <>
is_placeholder_arg = a =>
   a
      [Var v] v == "_"
      [NamedArg na] is_placeholder_arg(na.val)
      | <->

// DVA-50 partial application: a call `f(a, _, b)` whose direct arguments include the
// placeholder `_`, appearing where `_` is not bound (no enclosing payload, cycle element,
// or `_ =>` parameter), desugars to the unary closure `_ => f(a, _, b)`. Used for
// higher-order call arguments and `[predicate]` choice guards. A bound `_` keeps its
// existing meaning, and `$>` / `$>>` / `( … )` consume a free `_` before annotation.
partial_app_closure: type_env::TypeEnv, ast::Expr => ast::Expr
partial_app_closure = env, e =>
   e
      [Call c]
         has_ph' = <->
         c.args @ a =>
            is_placeholder_arg(a) | has_ph' = <+>; -->
         c.fn_name != "_" && has_ph' && !<>(type_env::lookup_binding(env, "_"))
            |
               params = ast::Names()
               params += "_"
               ast::Expr(Fn, ast::FnExpr(params, ast::Names(), e))
            | e
      | e

annotate_call_arg: unify::Ctx, type_env::TypeEnv, ast::Expr => tast::TypedExpr
annotate_call_arg = ctx, env, a =>
   saved = cur_is_call_arg
   cur_is_call_arg ::= (a [Var, Unary])
   te = annotate_expr(ctx, env, partial_app_closure(env, a))
   cur_is_call_arg ::= saved
   te

annotate_call_args: unify::Ctx, type_env::TypeEnv, ast::Exprs => tast::TypedExprs
annotate_call_args = ctx, env, args =>
   typed = tast::TypedExprs()
   args @ a =>
      typed += annotate_call_arg(ctx, env, a)
   typed

annotate_unary_op: unify::Ctx, type_env::TypeEnv, ast::UnaryOp,
  unify::UType, ast::Expr => unify::UType
annotate_unary_op = ctx, env, op, t, operand_expr =>
   unify::is_poison(ctx, t) | --| unify::poison_utype!
   op
      [Length]
         check_length_operand(ctx, t)
         unify::prim_int!
      [RuneCount]
         ok = unify::unify(ctx, t, unify::prim_str!)
         !ok
            |
               unify::add_error(ctx, 3084,
                 "Codepoint count (??) requires String operand")
         unify::prim_int!
      [AddrOf]
         c = unify::canon(ctx, t)
         c
            [Prim p]
               p
                  [Builder, Str] unify::prim_rawptr!
                  [Int, I8, I16, I32, I64, U8, U16, U32, U64, Float, F32, Rune, Flag, RawPtr]
                     operand_expr
                        [Var]
                           !cur_is_call_arg
                              |
                                 unify::add_error(ctx, 3078,
                                   "Unary '&' on scalar variable is only valid in function call argument position.")
                        |
                           unify::add_error(ctx, 3078,
                             "Unary '&' on scalar requires a variable target.")
                     unify::prim_rawptr!
                  |
                     unify::add_error(ctx, 3078,
                       "Address operator '&' cannot be applied to '" + unify::show_utype(ctx, t) + "\.")
                     unify::prim_rawptr!
            [Rec] unify::prim_rawptr!
            [Array] unify::prim_rawptr!
            [Slice] unify::prim_rawptr!
            [Fn] unify::prim_rawptr!
            [Var] unify::prim_rawptr!
            |
               unify::add_error(ctx, 3078,
                 "Address operator '&' cannot be applied to '" + unify::show_utype(ctx, t) + "\.")
               unify::prim_rawptr!
      [Freeze]
         ok = unify::unify(ctx, t, unify::prim_builder!)
         !ok
            |
               unify::add_error(ctx, 3084,
                 "Unary '+' freeze requires Builder operand")
         unify::prim_str!
      [BitNot]
         ok = unify::unify(ctx, t, unify::prim_int!)
         !ok
            |
               unify::add_error(ctx, 3084,
                 "Bitwise NOT requires integer operand")
         unify::prim_int!
      [Neg]
         c = unify::canon(ctx, t)
         (is_integerish_ut(ctx, c) || is_float_ut(ctx, c) ||
           is_rune_ut(ctx, c) || is_numeric_rec(ctx, c) || (c [Var]))
           | c
           |
              unify::add_error(ctx, 3084,
                "Unary '-' requires numeric operand, got '" +
                  unify::show_utype(ctx, t) + "'")
              unify::prim_unknown!
      [Not]
         c = unify::canon(ctx, t)
         c
            [Prim p]
               p
                  [Flag] unify::prim_flag!
                  [Int, I8, I16, I32, I64, U8, U16, U32, U64]
                     unify::add_error(ctx, 3008, diag::E3008_not_integer!)
                     unify::prim_flag!
                  |
                     unify::add_error(ctx, 3008, diag::E3008_not_invalid_type!)
                     unify::prim_flag!
            [Var]
               unify::fresh_var(ctx)
            |
               unify::add_error(ctx, 3008, diag::E3008_not_invalid_type!)
               unify::prim_flag!
      [Unwrap]
         c = unify::canon(ctx, t)
         c
            [Ram r]
               r.pos.has_payload
                  | r.pos.ut
                  |
                     unify::add_error(ctx, 3091,
                       "Operand of '!!' must have a positive payload")
                     unify::prim_unknown!
            |
               unify::add_error(ctx, 3091,
                 "Operand of '!!' must be a RamPP or RamPN ramification")
               unify::prim_unknown!
      [Propagate]
         !env.in_fn
            |
               unify::add_error(ctx, 3173, diag::E3173_propagate_outside_fn!)
               unify::prim_unknown!
            |
               env.cur_fn_ret
                  | ret_ut =>
                     c_ret = unify::canon(ctx, ret_ut)
                     c_ret
                        [Ram r_ret]
                           c = unify::canon(ctx, t)
                           c
                              [Ram r]
                                 r_np = !r_ret.neg.has_payload
                                 o_np = !r.neg.has_payload
                                 compat_neg = (r_np && o_np) ||
                                   (!r_np && !o_np &&
                                     unify::unify(ctx,
                                       r_ret.neg.ut, r.neg.ut))
                                 !compat_neg
                                    |
                                       unify::add_error(ctx, 3173,
                                         "Cannot propagate " +
                                         "ramification: incompatible " +
                                         "ramification shape.")
                                       unify::prim_unknown!
                                    | (r.pos.has_payload | r.pos.ut | unify::prim_unit!)
                              |
                                 unify::add_error(ctx, 3091,
                                   diag::E3091_propagate_ram_operand!)
                                 unify::prim_unknown!
                        |
                           unify::add_error(ctx, 3173,
                             "Propagate operator '--!' is only valid " +
                             "inside a function returning a " +
                             "ramification.")
                           unify::prim_unknown!
                  |
                     c = unify::canon(ctx, t)
                     c
                        [Ram r]
                           r.pos.has_payload | r.pos.ut | unify::prim_unit!
                        |
                           unify::add_error(ctx, 3091,
                             diag::E3091_propagate_ram_operand!)
                           unify::prim_unknown!
      | unify::prim_unknown!

is_str_record_fields: unify::Ctx, unify::UFields, Int, Int => <>
is_str_record_fields = ctx, flds, i, n =>
   i == n
      | <+>
      |
         f = flds(i) | _ | unify::UField("", unify::UType(None))
         f_ut = unify::canon(ctx, f.ut)
         is_str = f_ut [Prim p] (p [Str]) | <->
         is_str
            | is_str_record_fields(ctx, flds, i + 1, n)
            | <->

is_str_record: unify::Ctx, unify::UType => <>
is_str_record = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         n = ?flds
         n > 0 | is_str_record_fields(ctx, flds, 0, n) | <->
      | <->

rec_fields_has_fn: unify::Ctx, unify::UFields, Int, Int, ast::Names => <>
rec_fields_has_fn = ctx, flds, i, n, visited =>
   i == n
      | <->
      |
         f = flds(i) | _ | unify::UField("", unify::UType(None))
         ut_has_fn(ctx, f.ut, visited)
            | <+>
            | rec_fields_has_fn(ctx, flds, i + 1, n, visited)

enum_variants_has_fn: unify::Ctx, unify::UEnumVariants, Int, Int, ast::Names => <>
enum_variants_has_fn = ctx, vars, i, n, visited =>
   i == n
      | <->
      |
         v = vars(i) | _ | unify::UEnumVariant("", <->, unify::UType(None))
         v.has_payload && ut_has_fn(ctx, v.payload_type, visited)
            | <+>
            | enum_variants_has_fn(ctx, vars, i + 1, n, visited)

ut_has_fn: unify::Ctx, unify::UType, ast::Names => <>
ut_has_fn = ctx, ut, visited =>
   c = unify::canon(ctx, ut)
   c
      [Fn] <+>
      [Rec flds] rec_fields_has_fn(ctx, flds, 0, ?flds, visited)
      [Array a] ut_has_fn(ctx, a.elem, visited)
      [Slice s] ut_has_fn(ctx, s, visited)
      [Enum e]
         has_name_in(visited, e.name)
            | <->
            |
               vis' = visited
               e.name != "" | (vis' += e.name)
               enum_variants_has_fn(ctx, e.variants, 0, ?e.variants, vis')
      | <->

cmp_binop_name: ast::BinaryOp => String
cmp_binop_name =
   [Gt] "Greater"
   [Lt] "Less"
   [Eq] "Equals"
   [NotGt] "NotGreater"
   [NotLt] "NotLess"
   [NotEq] "NotEqual"
   | ""

unify_cmp_op: unify::Ctx, ast::BinaryOp, unify::UType,
  unify::UType => unify::UType
unify_cmp_op = ctx, op, t1, t2 =>
   is_eq_neq = op [Eq, NotEq]
   c1_ord = unify::canon(ctx, t1)
   c2_ord = unify::canon(ctx, t2)
   is_enum_ord = !is_eq_neq && ((c1_ord [Enum]) || (c2_ord [Enum]))
   is_ram1 = c1_ord [Ram]
   is_ram2 = c2_ord [Ram]
   is_flg1 = c1_ord [Prim p1] (p1 [Flag]) | <->
   is_flg2 = c2_ord [Prim p2] (p2 [Flag]) | <->
   // Two bare Flags support equality (== is XNOR, != is XOR); ordering
   // stays E3127 and every other ram comparison stays E3027.
   is_flag_eq = is_eq_neq && is_flg1 && is_flg2
   is_ram_cmp = !is_flag_eq && (is_ram1 || is_ram2 || (is_flg1 && is_flg2))
   is_enum_ord
      |
         unify::add_error(ctx, 3127, "Operator '" + cmp_binop_name(op) +
           diag::E3127_enum_ordering_suffix!)
         unify::prim_flag!
      |
         is_ram_cmp
            |
               is_eq_neq
                  |
                     unify::add_error(ctx, 3027, "Operator '" +
                       cmp_binop_name(op) +
                       "' cannot be applied to ramifications")
                  |
                     unify::add_error(ctx, 3127, "Operator '" +
                       cmp_binop_name(op) +
                       diag::E3127_ram_ordering_suffix!)
               unify::prim_flag!
            |
               is_type1 = c1_ord [Prim p_t1] (p_t1 [Type]) | <->
               is_type2 = c2_ord [Prim p_t2] (p_t2 [Type]) | <->
               is_type_cmp = is_eq_neq &&
                 ((is_type1 && (is_type2 || is_str_ut(ctx, t2))) ||
                   (is_type2 && (is_type1 || is_str_ut(ctx, t1))))
               is_str_tuple = is_eq_neq &&
                 ((is_str_ut(ctx, t1) && is_str_record(ctx, t2)) ||
                   (is_str_record(ctx, t1) && is_str_ut(ctx, t2)))
               is_type_cmp || is_str_tuple
                  | unify::prim_flag!
                  |
                     has_fn = is_eq_neq &&
                       (ut_has_fn(ctx, t1, ast::Names()) || ut_has_fn(ctx, t2, ast::Names()))
                     has_fn
                        |
                           unify::add_error(ctx, 3084,
                             "Type containing function does not support equality")
                           unify::prim_flag!
                        | unify_cmp(ctx, t1, t2)

annotate_bin_op: unify::Ctx, ast::BinaryOp, unify::UType,
  unify::UType => unify::UType
annotate_bin_op = ctx, op, t1, t2 =>
   unify::is_poison(ctx, t1) || unify::is_poison(ctx, t2) | --| unify::poison_utype!
   op
      [Add] unify_add(ctx, t1, t2)
      [Sub] unify_sub(ctx, t1, t2)
      [Mul] unify_arith(ctx, t1, t2)
      [Div] unify_arith(ctx, t1, t2)
      [Mod] unify_arith(ctx, t1, t2)
      [Eq] unify_cmp_op(ctx, op, t1, t2)
      [NotEq] unify_cmp_op(ctx, op, t1, t2)
      [Lt] unify_cmp_op(ctx, op, t1, t2)
      [Gt] unify_cmp_op(ctx, op, t1, t2)
      [NotLt] unify_cmp_op(ctx, op, t1, t2)
      [NotGt] unify_cmp_op(ctx, op, t1, t2)
      [And] unify_logical(ctx, <+>, t1, t2)
      [Or] unify_logical(ctx, <->, t1, t2)
      [BitAnd] unify_bitwise(ctx, t1, t2)
      [BitOr] unify_bitwise(ctx, t1, t2)
      [BitXor] unify_bitwise(ctx, t1, t2)
      [Shl] unify_shift(ctx, t1, t2)
      [Shr] unify_shift(ctx, t1, t2)
      [Apply] unify_apply(ctx, t1, t2)
      [Feed] unify_feed(ctx, t1, t2)
      [Seq] t2
      | t1

int_bin_res: unify::UType, unify::UType => unify::UType
int_bin_res = t1, t2 =>
   same = t1 [Prim p1] (t2 [Prim p2] (p1 == p2) | <->) | <->
   same | t1 | unify::prim_int!

unify_add: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_add = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084, diag::E3084_record_size_mismatch!)
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify::unify(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify::unify(ctx, e1, t2)
               t1
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify::unify(ctx, t1, e2)
                     t2
                  |
                     bld_rhs = is_str_ut(ctx, t2) ||
                       is_integerish_ut(ctx, t2) || is_rune_ut(ctx, t2)
                     is_bld = is_builder_ut(ctx, t1) && bld_rhs
                     is_bld
                        | t1
                        |
                           s1 = is_str_ut(ctx, t1) && bld_rhs
                           s1
                              | unify::prim_str!
                              |
                                 p1 = is_ptr_ut(ctx, t1)
                                 p2 = is_ptr_ut(ctx, t2)
                                 int1 = is_integerish_ut(ctx, t1)
                                 int2 = is_integerish_ut(ctx, t2)
                                 fl1 = is_float_ut(ctx, t1)
                                 fl2 = is_float_ut(ctx, t2)
                                 p1 && int2
                                    | t1
                                    |
                                       int1 && p2
                                          | t2
                                          |
                                             is_rune_ut(ctx, t1) && int2
                                                | unify::prim_rune!
                                                |
                                                   fl1 && (int2 || fl2)
                                                      | t1
                                                      |
                                                         fl2 && (int1 || fl1)
                                                            | t2
                                                            |
                                                               int1 && int2
                                                                  |
                                                                     c1 = unify::canon(ctx, t1)
                                                                     c2 = unify::canon(ctx, t2)
                                                                     int_bin_res(c1, c2)
                                                                  |
                                                                     ok = unify::unify(ctx, t1, t2)
                                                                     !ok
                                                                        |
                                                                           unify::add_error(ctx, 3084,
                                                                             diag::E3084_arithmetic_type_mismatch!)
                                                                           t1
                                                                        | unify::canon(ctx, t1)

unify_sub: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_sub = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084, diag::E3084_record_size_mismatch!)
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify::unify(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify::unify(ctx, e1, t2)
               t1
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify::unify(ctx, t1, e2)
                     t2
                  |
                     p1 = is_ptr_ut(ctx, t1)
                     p2 = is_ptr_ut(ctx, t2)
                     int1 = is_integerish_ut(ctx, t1)
                     int2 = is_integerish_ut(ctx, t2)
                     fl1 = is_float_ut(ctx, t1)
                     fl2 = is_float_ut(ctx, t2)
                     p1 && int2
                        | t1
                        |
                           p1 && p2
                              | unify::prim_int!
                              |
                                 fl1 && (int2 || fl2)
                                    | t1
                                    |
                                       fl2 && (int1 || fl1)
                                          | t2
                                          |
                                             int1 && int2
                                                |
                                                   c1 = unify::canon(ctx, t1)
                                                   c2 = unify::canon(ctx, t2)
                                                   int_bin_res(c1, c2)
                                                |
                                                   ok = unify::unify(ctx, t1, t2)
                                                   !ok
                                                      |
                                                         unify::add_error(ctx, 3084,
                                                           diag::E3084_arithmetic_type_mismatch!)
                                                         t1
                                                      | unify::canon(ctx, t1)

unify_arith: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_arith = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084, diag::E3084_record_size_mismatch!)
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify::unify(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify::unify(ctx, e1, t2)
               t1
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify::unify(ctx, t1, e2)
                     t2
                  |
                     int1 = is_integerish_ut(ctx, t1)
                     int2 = is_integerish_ut(ctx, t2)
                     fl1 = is_float_ut(ctx, t1)
                     fl2 = is_float_ut(ctx, t2)
                     fl1 && (int2 || fl2)
                        | t1
                        |
                           fl2 && (int1 || fl1)
                              | t2
                              |
                                 int1 && int2
                                    |
                                       c1 = unify::canon(ctx, t1)
                                       c2 = unify::canon(ctx, t2)
                                       int_bin_res(c1, c2)
                                    |
                                       ok = unify::unify(ctx, t1, t2)
                                       !ok
                                          |
                                             unify::add_error(ctx, 3084,
                                               diag::E3084_arithmetic_type_mismatch!)
                                             t1
                                          | unify::canon(ctx, t1)

unify_cmp: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_cmp = ctx, t1, t2 =>
   r1 = is_cmp_rec(ctx, t1)
   r2 = is_cmp_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                 "Record size mismatch in comparison")
               unify::prim_flag!
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify_cmp(ctx, e1, e2)
               make_rec_of(cnt1, unify::prim_flag!)
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify_cmp(ctx, e1, t2)
               cnt1 = rec_count(ctx, t1)
               make_rec_of(cnt1, unify::prim_flag!)
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify_cmp(ctx, t1, e2)
                     cnt2 = rec_count(ctx, t2)
                     make_rec_of(cnt2, unify::prim_flag!)
                  |
                     fl1 = is_float_ut(ctx, t1)
                     fl2 = is_float_ut(ctx, t2)
                     is_int_fl = (is_integerish_ut(ctx, t1) && fl2) || (fl1 && is_integerish_ut(ctx, t2))
                     is_int_fl
                        |
                           unify::add_error(ctx, 3084,
                             "Type mismatch: cannot compare " +
                             unify::show_utype(ctx, t1) + " with " +
                             unify::show_utype(ctx, t2))
                           unify::prim_flag!
                        |
                           fl1 && fl2
                              | unify::prim_flag!
                              |
                                 int1 = is_integerish_ut(ctx, t1)
                                 int2 = is_integerish_ut(ctx, t2)
                                 int1 && int2
                                    | unify::prim_flag!
                                    |
                                       ip1 = is_int_or_ptr_ut(ctx, t1)
                                       ip2 = is_int_or_ptr_ut(ctx, t2)
                                       ip1 && ip2
                                          | unify::prim_flag!
                                          |
                                             ok = unify::unify(ctx, t1, t2)
                                             !ok
                                                |
                                                   unify::add_error(ctx, 3084,
                                                     "Comparison type mismatch")
                                             unify::prim_flag!

unify_apply: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_apply = ctx, fn_ut, arg_ut =>
   c = unify::canon(ctx, fn_ut)
   ret_ut' = unify::fresh_var(ctx)
   c
      [Fn f]
         n_params = ?f.params
         n_params > 0
            |
               p0 = f.params(0) | _ | unify::UType(None)
               unify::unify(ctx, p0, arg_ut)
               ret_ut' = f.ret
            | ret_ut' = f.ret
      [Prim]
         ret_ut' = fn_ut
      [Ram]
         unify::unify(ctx, fn_ut, arg_ut)
         ret_ut' = fn_ut
      [Enum]
         unify::unify(ctx, fn_ut, arg_ut)
         ret_ut' = fn_ut
      [Rec]
         unify::unify(ctx, fn_ut, arg_ut)
         ret_ut' = fn_ut
      |
         p_uts = unify::UTypes()
         p_uts += arg_ut
         expected = unify::mk_fn(p_uts, ret_ut')
         unify::unify(ctx, fn_ut, expected)
   ret_ut'

unify_feed: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_feed = ctx, arg_ut, fn_ut => unify_apply(ctx, fn_ut, arg_ut)

err_ram_circuit: unify::Ctx => ()
err_ram_circuit = ctx =>
   unify::add_error(ctx, 3089,
     "Ramification layouts cannot represent short-circuit winners")

err_ram_slot: unify::Ctx, String => ()
err_ram_slot = ctx, slot =>
   unify::add_error(ctx, 3089,
     "Incompatible ram payloads in " + slot + " slot")

err_flag_heap: unify::Ctx => ()
err_flag_heap = ctx =>
   unify::add_error(ctx, 3089,
     "A bare Flag and a heap ram cannot be combined with && or ||")

err_ram_nonram: unify::Ctx => ()
err_ram_nonram = ctx =>
   unify::add_error(ctx, 3089,
     "Cannot combine ramification and non-ramification in op")

unify_logical_and: unify::Ctx, unify::URam, unify::URam => unify::UType
unify_logical_and = ctx, r1, r2 =>
   diff = r1.neg.has_payload != r2.neg.has_payload
   diff
      |
         err_ram_circuit(ctx)
         unify::mk_ram(r2.pos, r2.neg)
      |
         r1.neg.has_payload
            |
               ok = unify::unify(ctx, r1.neg.ut, r2.neg.ut)
               !ok | err_ram_slot(ctx, "neg")
         unify::mk_ram(r2.pos, r2.neg)

unify_logical_or: unify::Ctx, unify::URam, unify::URam => unify::UType
unify_logical_or = ctx, r1, r2 =>
   diff = r1.pos.has_payload != r2.pos.has_payload
   diff
      |
         err_ram_circuit(ctx)
         unify::mk_ram(r2.pos, r2.neg)
      |
         r1.pos.has_payload
            |
               ok = unify::unify(ctx, r1.pos.ut, r2.pos.ut)
               !ok | err_ram_slot(ctx, "pos")
         unify::mk_ram(r2.pos, r2.neg)

unify_logical_heap: unify::Ctx, <>, unify::URam, unify::URam => unify::UType
unify_logical_heap = ctx, is_and, r1, r2 =>
   is_and
      | unify_logical_and(ctx, r1, r2)
      | unify_logical_or(ctx, r1, r2)

unify_logical_ram: unify::Ctx, <>, unify::URam, unify::URam => unify::UType
unify_logical_ram = ctx, is_and, r1, r2 =>
   s1 = unify::ram_shape(r1)
   s2 = unify::ram_shape(r2)
   is_bare1 = s1 == unify::URamShape(RamNN)
   is_bare2 = s2 == unify::URamShape(RamNN)
   is_bare1 && !is_bare2
      |
         err_flag_heap(ctx)
         unify::mk_ram(r2.pos, r2.neg)
      |
         !is_bare1 && is_bare2
            |
               err_flag_heap(ctx)
               unify::mk_ram(r1.pos, r1.neg)
            |
               is_bare1 && is_bare2
                  | unify::prim_flag!
                  | unify_logical_heap(ctx, is_and, r1, r2)

unify_logical: unify::Ctx, <>, unify::UType, unify::UType => unify::UType
unify_logical = ctx, is_and, t1, t2 =>
   r1 = is_cmp_rec(ctx, t1)
   r2 = is_cmp_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                 "Record size mismatch in logical op")
               unify::prim_flag!
            |
               unify::unify(ctx, rec_elem(ctx, t1), unify::prim_flag!)
               unify::unify(ctx, rec_elem(ctx, t2), unify::prim_flag!)
               make_rec_of(cnt1, unify::prim_flag!)
      |
         r1
            |
               unify::unify(ctx, rec_elem(ctx, t1), unify::prim_flag!)
               unify::unify(ctx, t2, unify::prim_flag!)
               cnt1 = rec_count(ctx, t1)
               make_rec_of(cnt1, unify::prim_flag!)
            |
               r2
                  |
                     unify::unify(ctx, t1, unify::prim_flag!)
                     unify::unify(ctx, rec_elem(ctx, t2), unify::prim_flag!)
                     cnt2 = rec_count(ctx, t2)
                     make_rec_of(cnt2, unify::prim_flag!)
                  |
                     c1 = unify::canon(ctx, t1)
                     c2 = unify::canon(ctx, t2)
                     c1
                        [Ram ram1]
                           c2
                              [Ram ram2]
                                 unify_logical_ram(ctx, is_and, ram1, ram2)
                              |
                                 is_flag_ut(ctx, c2)
                                    | err_flag_heap(ctx)
                                    | err_ram_nonram(ctx)
                                 t1
                        |
                           c2
                              [Ram]
                                 is_flag_ut(ctx, c1)
                                    | err_flag_heap(ctx)
                                    | err_ram_nonram(ctx)
                                 t2
                              |
                                 unify::unify(ctx, t1, unify::prim_flag!)
                                 unify::unify(ctx, t2, unify::prim_flag!)
                                 unify::prim_flag!

// Leave unresolved operands for call-site inference; never choose an integer
// type merely because an operand supports length or bitwise operations.
check_length_operand: unify::Ctx, unify::UType => ()
check_length_operand = ctx, t =>
   c = unify::canon(ctx, t)
   ok = c
      [Prim p] p [Str, Builder, Rune]
      | c [Rec, Array, Slice, Map, Var]
   !ok
      | unify::add_error(ctx, 3084, "Length operator requires a countable operand")

unify_bitwise: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_bitwise = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                 "Record size mismatch in bitwise op")
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify_bitwise(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify_bitwise(ctx, e1, t2)
               t1
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify_bitwise(ctx, t1, e2)
                     t2
                  |
                     c1 = unify::canon(ctx, t1)
                     c2 = unify::canon(ctx, t2)
                     int1 = is_integerish_ut(ctx, c1)
                     int2 = is_integerish_ut(ctx, c2)
                     int1 && int2
                        | int_bin_res(c1, c2)
                        |
                           var1 = c1 [Var]
                           var2 = c2 [Var]
                           ok1 = int1 || var1
                           ok2 = int2 || var2
                           ok1 && ok2
                              |
                                 unify::unify(ctx, t1, t2)
                                 unify::canon(ctx, t1)
                              |
                                 unify::unify(ctx, t1, t2)
                                 unify::add_error(ctx, 3084,
                                   "Bitwise operand mismatch: integer operands required")
                                 unify::prim_unknown!

unify_shift: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_shift = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                 "Record size mismatch in shift op")
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify_shift(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify_shift(ctx, e1, t2)
               t1
            |
               c1_pre = unify::canon(ctx, t1)
               c2_pre = unify::canon(ctx, t2)
               is_v1 = c1_pre [Var]
               is_v2 = c2_pre [Var]
               is_v1 || is_v2
                  |
                     int1_pre = is_integerish_ut(ctx, c1_pre)
                     int2_pre = is_integerish_ut(ctx, c2_pre)
                     is_v1
                        |
                           tgt1 = int2_pre | c2_pre | unify::prim_int!
                           unify::unify(ctx, c1_pre, tgt1)
                     is_v2
                        |
                           tgt2 = int1_pre | c1_pre | unify::prim_int!
                           unify::unify(ctx, c2_pre, tgt2)
               int1 = is_integerish_ut(ctx, t1)
               int2 = is_integerish_ut(ctx, t2)
               int1 && int2
                  | unify::canon(ctx, t1)
                  |
                     unify::add_error(ctx, 3057, "Shift operator requires integer operands.")
                     t1

is_upper_decl_name: String => <>
is_upper_decl_name = name =>
   m = type_env::decl_module(name, 0)
   raw = m == "" | name | name(?m + 2..)
   clean = (?raw > 0 && raw(0) == '#) | raw(1..) | raw
   ?clean > 0 && (clean(0) ['A...'Z])

is_verified_iface_assign: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
  String, ast::TypeInfo) => <>
is_verified_iface_assign = a =>
   a.6 [Var v] (v == "<iface>") | <->

find_assign_idx: ast::Exprs, String => Int

check_missing_block_fwd_defs: unify::Ctx, ast::Exprs => ()
check_missing_block_fwd_defs = ctx, exprs =>
   exprs @ e =>
      e
         [Assign a]
            is_fwd_assign(a) && a.0 != "" && !is_verified_iface_assign(a)
               |
                  a.8
                     [Fn f]
                        is_type_gen = ?f.4 > 0 && ?f.0 == 0 && is_upper_decl_name(a.0)
                        !is_type_gen && find_assign_idx(exprs, a.0) < 0
                           |
                              unify::add_error(ctx, 3004,
                                "Missing definition for declared function '${a.0}'")

annotate_block: unify::Ctx, type_env::TypeEnv, ast::Exprs, <> => tast::TypedExpr
annotate_block = ctx, env, exprs, is_disc =>
   check_missing_block_fwd_defs(ctx, exprs)
   type_env::enter_scope(env)
   tes = tast::TypedExprs()
   last_ut' = unify::prim_unit!
   n = ?exprs
   saved_block_exp = cur_expected_ut
   exprs @ e, i =>
      is_last = i == n - 1
      disc_val = is_last | is_disc | <+>
      env.discard_result = disc_val
      is_last
         | cur_expected_ut ::= saved_block_exp
         | cur_expected_ut ::= <-->
      te = annotate_expr(ctx, env, e)
      tes += te
      last_ut' = te.ut
   cur_expected_ut ::= saved_block_exp
   env.discard_result = is_disc
   type_env::leave_scope(env)
   block_ut = is_disc | unify::prim_unit! | last_ut'
   ti = unify::type_info_from_utype(ctx, block_ut)
   lay = layout::compute_layout(ctx, block_ut)
   tast::mk_typed_block(tes, block_ut, ti, lay, 0, 0)

is_range_expr: ast::Expr => <>
is_range_expr = [Range]

find_last_dot: String, Int => <Int|>
find_last_dot = s, i =>
   i < 0 | --| <-->
   (s(i) == 46) | <+ i +> | find_last_dot(s, i - 1)

dotted_to_expr: String => ast::Expr
dotted_to_expr = s =>
   dot = find_last_dot(s, ?s - 1) | _ | --| ast::Expr(Var, s)
   dot !> 0 | --| ast::Expr(Var, s)
   target_str = s(0..dot)
   dot_next = dot + 1
   s_len = ?s
   field_str = s(dot_next..s_len)
   me = ast::MemberExpr(dotted_to_expr(target_str),
     field_str, <->, ast::Expr(Int, 0), 0, 0)
   ast::Expr(Member, me)

first_rec_field_ut: unify::UFields => unify::UType
first_rec_field_ut = flds =>
   ?flds == 0
      | unify::prim_int!
      |
         f0 = flds(0) | _ | unify::UField("", unify::UType(None))
         f0.ut

is_intrinsic_name: String => <>
is_intrinsic_name = name =>
   ?name > 1 && name(0) == '%

is_known_intrinsic: String => <>
is_known_intrinsic = ["%min", "%max", "%clamp", "%abs", "%shuffle",
  "%all", "%any", "%sum", "%prod", "%dot",
  "%sqrt", "%fma", "%floor", "%ceil", "%trunc", "%round", "%copysign",
  "%popcount", "%clz", "%ctz", "%bswap", "%bitreverse",
  "%rotl", "%rotr",
  "%pow", "%sin", "%cos", "%exp2", "%log2", "%uadd_sat", "%usub_sat",
  "%fmuladd", "%memcpy", "%memmove", "%memset", "%ptrmask", "%bitcast",
  "%to_str"]

expected_intrinsic_nargs: String => Int
expected_intrinsic_nargs =
   ["%abs", "%all", "%any", "%sum", "%prod", "%sqrt",
     "%floor", "%ceil", "%trunc", "%round",
     "%popcount", "%clz", "%ctz", "%bswap", "%bitreverse",
     "%sin", "%cos", "%exp2", "%log2", "%to_str"] 1
   ["%min", "%max", "%dot", "%copysign", "%rotl", "%rotr",
     "%pow", "%uadd_sat", "%usub_sat", "%ptrmask", "%bitcast"] 2
   ["%clamp", "%fma", "%fmuladd", "%memcpy", "%memmove", "%memset"] 3
   ["%shuffle"] 0
   | -1

bitcast_prim_bits: unify::UPrim => Int
bitcast_prim_bits =
   [I8, U8] 8
   [I16, U16] 16
   [I32, U32, F32, Rune] 32
   [Int, I64, U64, Float] 64
   | 0

bitcast_type_bits: unify::Ctx, unify::UType => Int
bitcast_type_bits = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Var] -1
      [Prim p] bitcast_prim_bits(p)
      [Rec flds]
         !is_numeric_rec(ctx, ut)
            | 0
            |
               eb = bitcast_type_bits(ctx, rec_elem(ctx, ut))
               eb > 0 | ?flds * eb | 0
      | 0

check_bitcast_types: unify::Ctx, unify::UType, unify::UType => ()
check_bitcast_types = ctx, tgt_ut, src_ut =>
   b_tgt = bitcast_type_bits(ctx, tgt_ut)
   b_src = bitcast_type_bits(ctx, src_ut)
   b_tgt == 0 || b_src == 0
      |
         unify::add_error(ctx, 3084,
           "Invalid operand type for intrinsic '%bitcast'")
      |
         (b_tgt > 0 && b_src > 0 && b_tgt != b_src)
            |
               unify::add_error(ctx, 3084,
                 "Bitcast size mismatch in '%bitcast': cannot bitcast " +
                 str::from_int(b_src) + "-bit value to " +
                 str::from_int(b_tgt) + "-bit type.")

intrin_scalar_ut: unify::Ctx, unify::UType => unify::UType
intrin_scalar_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Rec] rec_elem(ctx, ut) | ut

is_flt_or_flt_rec_ut: unify::Ctx, unify::UType => <>
is_flt_or_flt_rec_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Var] <+> | is_float_ut(ctx, ut) ||
     (is_numeric_rec(ctx, ut) && is_float_ut(ctx, rec_elem(ctx, ut)))

is_int_or_int_rec_ut: unify::Ctx, unify::UType => <>
is_int_or_int_rec_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Var] <+> | is_integerish_ut(ctx, ut) ||
     (is_numeric_rec(ctx, ut) && is_integerish_ut(ctx, rec_elem(ctx, ut)))

is_num_or_num_rec_ut: unify::Ctx, unify::UType => <>
is_num_or_num_rec_ut = ctx, ut =>
   is_int_or_int_rec_ut(ctx, ut) || is_flt_or_flt_rec_ut(ctx, ut)

check_intrin_arg: unify::Ctx, String, <> => ()
check_intrin_arg = ctx, name, ok =>
   !ok
      |
         unify::add_error(ctx, 3084,
           "Invalid operand type for intrinsic '" + name + "'")

compute_intrinsic_ret_ut: unify::Ctx, String, tast::TypedExprs,
  tast::TypedExpr, tast::TypedExpr, tast::TypedExpr => unify::UType
compute_intrinsic_ret_ut = ctx, name, args, a0, a1, a2 =>
   name
      ["%to_str"] unify::prim_str!
      ["%ptrmask"]
         check_intrin_arg(ctx, name, is_int_or_ptr_ut(ctx, a0.ut))
         check_intrin_arg(ctx, name, is_integerish_ut(ctx, a1.ut))
         a0.ut
      ["%memcpy", "%memmove"]
         ok0 = is_int_or_ptr_ut(ctx, a0.ut) || is_str_ut(ctx, a0.ut) || is_builder_ut(ctx, a0.ut)
         ok1 = is_int_or_ptr_ut(ctx, a1.ut) || is_str_ut(ctx, a1.ut) || is_builder_ut(ctx, a1.ut)
         check_intrin_arg(ctx, name, ok0 && ok1 && is_integerish_ut(ctx, a2.ut))
         unify::prim_rawptr!
      ["%memset"]
         ok0 = is_int_or_ptr_ut(ctx, a0.ut) || is_builder_ut(ctx, a0.ut)
         check_intrin_arg(ctx, name, ok0 && is_integerish_ut(ctx, a1.ut) && is_integerish_ut(ctx, a2.ut))
         unify::prim_rawptr!
      ["%all", "%any"]
         ok_flg = is_cmp_rec(ctx, a0.ut) && is_flag_ut(ctx, rec_elem(ctx, a0.ut))
         check_intrin_arg(ctx, name, ok_flg)
         unify::prim_flag!
      ["%sum", "%prod"]
         check_intrin_arg(ctx, name, is_numeric_rec(ctx, a0.ut))
         c0 = unify::canon(ctx, a0.ut)
         c0
            [Rec flds] first_rec_field_ut(flds)
            | a0.ut
      ["%dot"]
         check_intrin_arg(ctx, name, is_numeric_rec(ctx, a0.ut) && is_numeric_rec(ctx, a1.ut))
         unify::unify(ctx, a0.ut, a1.ut)
         c0 = unify::canon(ctx, a0.ut)
         c0
            [Rec flds] first_rec_field_ut(flds)
            | a0.ut
      ["%shuffle"]
         mask_te = ?args == 3 | a2 | a1
         c_mask = unify::canon(ctx, mask_te.ut)
         c_v0 = unify::canon(ctx, a0.ut)
         elem_ut = c_v0
            [Rec vflds] first_rec_field_ut(vflds)
            | a0.ut
         mask_count = c_mask [Rec mflds] ?mflds | 0
         out_flds = unify::UFields()
         mask_count @
            out_flds += unify::UField("", elem_ut)
         unify::mk_rec(out_flds)
      ["%min", "%max"]
         check_intrin_arg(ctx, name, is_num_or_num_rec_ut(ctx, a0.ut) && is_num_or_num_rec_ut(ctx, a1.ut))
         unify::unify(ctx, intrin_scalar_ut(ctx, a0.ut), intrin_scalar_ut(ctx, a1.ut))
         c0 = unify::canon(ctx, a0.ut)
         c1 = unify::canon(ctx, a1.ut)
         c0 [Rec] a0.ut | (c1 [Rec] a1.ut | a0.ut)
      ["%pow", "%copysign"]
         check_intrin_arg(ctx, name, is_flt_or_flt_rec_ut(ctx, a0.ut) && is_flt_or_flt_rec_ut(ctx, a1.ut))
         unify::unify(ctx, intrin_scalar_ut(ctx, a0.ut), intrin_scalar_ut(ctx, a1.ut))
         c0 = unify::canon(ctx, a0.ut)
         c1 = unify::canon(ctx, a1.ut)
         c0 [Rec] a0.ut | (c1 [Rec] a1.ut | a0.ut)
      ["%uadd_sat", "%usub_sat", "%rotl", "%rotr"]
         check_intrin_arg(ctx, name, is_int_or_int_rec_ut(ctx, a0.ut) && is_int_or_int_rec_ut(ctx, a1.ut))
         unify::unify(ctx, intrin_scalar_ut(ctx, a0.ut), intrin_scalar_ut(ctx, a1.ut))
         c0 = unify::canon(ctx, a0.ut)
         c1 = unify::canon(ctx, a1.ut)
         c0 [Rec] a0.ut | (c1 [Rec] a1.ut | a0.ut)
      ["%clamp"]
         check_intrin_arg(ctx, name, is_num_or_num_rec_ut(ctx, a0.ut) &&
           is_num_or_num_rec_ut(ctx, a1.ut) && is_num_or_num_rec_ut(ctx, a2.ut))
         s0 = intrin_scalar_ut(ctx, a0.ut)
         unify::unify(ctx, s0, intrin_scalar_ut(ctx, a1.ut))
         unify::unify(ctx, s0, intrin_scalar_ut(ctx, a2.ut))
         c0 = unify::canon(ctx, a0.ut)
         c1 = unify::canon(ctx, a1.ut)
         c2 = unify::canon(ctx, a2.ut)
         c0 [Rec] a0.ut | (c1 [Rec] a1.ut | (c2 [Rec] a2.ut | a0.ut))
      ["%fma", "%fmuladd"]
         check_intrin_arg(ctx, name, is_flt_or_flt_rec_ut(ctx, a0.ut) &&
           is_flt_or_flt_rec_ut(ctx, a1.ut) && is_flt_or_flt_rec_ut(ctx, a2.ut))
         s0 = intrin_scalar_ut(ctx, a0.ut)
         unify::unify(ctx, s0, intrin_scalar_ut(ctx, a1.ut))
         unify::unify(ctx, s0, intrin_scalar_ut(ctx, a2.ut))
         c0 = unify::canon(ctx, a0.ut)
         c1 = unify::canon(ctx, a1.ut)
         c2 = unify::canon(ctx, a2.ut)
         c0 [Rec] a0.ut | (c1 [Rec] a1.ut | (c2 [Rec] a2.ut | a0.ut))
      ["%sqrt", "%floor", "%ceil", "%trunc", "%round", "%sin", "%cos", "%exp2", "%log2"]
         check_intrin_arg(ctx, name, is_flt_or_flt_rec_ut(ctx, a0.ut))
         a0.ut
      ["%popcount", "%clz", "%ctz", "%bswap", "%bitreverse"]
         check_intrin_arg(ctx, name, is_int_or_int_rec_ut(ctx, a0.ut))
         a0.ut
      ["%abs"]
         check_intrin_arg(ctx, name, is_num_or_num_rec_ut(ctx, a0.ut))
         a0.ut
      | a0.ut

annotate_intrinsic_call: unify::Ctx, type_env::TypeEnv,
  ast::CallExpr => tast::TypedExpr
annotate_intrinsic_call = ctx, env, ce =>
   typed_args = annotate_call_args(ctx, env, ce.args)
   name = ce.fn_name
   nargs = ?typed_args
   !is_known_intrinsic(name)
      |
         unify::add_error(ctx, 3100,
           "Unknown compiler intrinsic '" + name + "'.")
         ti_err = ast::TypeInfo(Prim, ast::ValueType(Unknown))
         tast::mk_typed_call(name, <-->, typed_args, unify::prim_unit!,
           ti_err, tast::layout_void!, ce.line, ce.col)
      |
         exp_n = expected_intrinsic_nargs(name)
         nargs_ok = exp_n == 0
            | nargs == 2 || nargs == 3
            | nargs == exp_n
         !nargs_ok
            |
               unify::add_error(ctx, 3100,
                 "Intrinsic '" + name + "' called with " +
                 str::from_int(nargs) + " arguments.")
               ti_err = ast::TypeInfo(Prim, ast::ValueType(Unknown))
               tast::mk_typed_call(name, <-->, typed_args,
                 unify::prim_unit!, ti_err, tast::layout_void!,
                 ce.line, ce.col)
            |
               def_unit = tast::mk_lit_unit(0, 0)
               arg0 = def_unit
               nargs > 0
                  |
                     t0 = typed_args(0)
                     arg0 = t0 | _ | def_unit
               arg1 = def_unit
               nargs > 1
                  |
                     t1 = typed_args(1)
                     arg1 = t1 | _ | def_unit
               arg2 = def_unit
               nargs > 2
                  |
                     t2 = typed_args(2)
                     arg2 = t2 | _ | def_unit
               name == "%to_str"
                  |
                     c_str_arg = unify::canon(ctx, arg0.ut)
                     is_ok = (c_str_arg [Var]) || is_str_ut(ctx, arg0.ut) || is_rune_ut(ctx, arg0.ut) ||
                       is_integerish_ut(ctx, arg0.ut) || is_float_ut(ctx, arg0.ut)
                     !is_ok |
                        unify::add_error(ctx, 3105,
                          "String interpolation does not support non-scalar type.")
               name == "%bitcast"
                  |
                     raw_ti = (ce.args(0)!!)
                        [SizeOf so] so.rec_type
                        | ast::TypeInfo(Prim, ast::ValueType(Unknown))
                     bc_ut = utype_from_ti_env(env, raw_ti)
                     check_bitcast_types(ctx, bc_ut, arg1.ut)
                     c_bc = unify::canon(ctx, bc_ut)
                     keep_raw_ti = (raw_ti [TypeVar tv] tv != "" | <->) && !(c_bc [Prim])
                     bc_ti = keep_raw_ti | raw_ti | unify::type_info_from_utype(ctx, bc_ut)
                     bc_lay = layout::compute_layout(ctx, bc_ut)
                     tast::mk_typed_call(name, <-->, typed_args, bc_ut, bc_ti,
                       bc_lay, ce.line, ce.col)
                  |
                     ret_ut = compute_intrinsic_ret_ut(ctx, name, typed_args,
                       arg0, arg1, arg2)
                     ti = unify::type_info_from_utype(ctx, ret_ut)
                     lay = layout::compute_layout(ctx, ret_ut)
                     tast::mk_typed_call(name, <-->, typed_args, ret_ut, ti,
                       lay, ce.line, ce.col)

try_eval_has_member: unify::Ctx, type_env::TypeEnv, ast::Expr, String => (<>, <>)
try_eval_has_member = ctx, env, tgt_e, mem_name =>
   cur_v = tgt_e [Var vn] vn | ""
   cur_opt = cur_v != "" | lookup_ct_cursor(cur_v) | <-->
   cur_opt
      | cur =>
         mem_name == "default"
            | --| (cur.has_default, <+>)
            |
               is_cur_prop = mem_name ["idx", "name", "type", "Type"]
               --| (is_cur_prop, <+>)
   is_self = cur_v == "self"
   rt = resolve_type_expr_ut_ti(ctx, env, "", tgt_e)
   tgt_ut = rt.2
      | rt.0
      |
         tgt_e
            [Var vn]
               type_env::lookup_binding(env, vn)
                  | b => b.ut
                  | unify::UType(None)
            | unify::UType(None)
   (tgt_ut [None]) && is_self
      |
         mod = env.current_module
         pub_qn = mod != "" | mod + "::" + mem_name | mem_name
         priv_qn = mod != "" | mod + "::#" + mem_name | mem_name
         found_mod = has_name_in(user_fns, pub_qn) || has_name_in(declared_fns, pub_qn) ||
           has_name_in(user_fns, priv_qn) || has_name_in(declared_fns, priv_qn) ||
           <>(type_env::lookup_binding(env, mem_name)) ||
           <>(type_env::lookup_user_type(env, mem_name))
         --| (found_mod, <+>)
   tgt_ut [None]
      | --| (<->, <->)
   c_ut = unify::canon(ctx, tgt_ut)
   c_ut
      [Rec flds]
         found' = <->
         flds @ f =>
            f.name == mem_name | (found' = <+>; -->)
         (found', <+>)
      [Enum uenum_raw]
         uenum' = uenum_raw
         ?uenum'.variants == 0 && uenum'.name != ""
            |
               type_env::lookup_user_type(env, uenum'.name)
                  | udef_e =>
                     unify::canon(ctx, udef_e.ut)
                        [Enum ue_res] (uenum' = ue_res)
         found' = <->
         uenum'.variants @ v =>
            v.label == mem_name | (found' = <+>; -->)
         (found', <+>)
      [Var] (<->, <->)
      | (<->, <+>)

annotate_hash_member3_call: unify::Ctx, type_env::TypeEnv,
  ast::CallExpr => tast::TypedExpr
annotate_hash_member3_call = ctx, env, ce =>
   ?ce.args != 3
      |
         unify::add_error(ctx, 3084,
           "'#member' 3-argument form expects (EnumType, Variant, payload).")
         --| tast::mk_lit_unit(ce.line, ce.col)
   arg0_e = ce.args(0)!!
   rt = resolve_type_expr_ut_ti(ctx, env, "", arg0_e)
   c_rt = rt.2 | unify::canon(ctx, rt.0) | unify::UType(None)
   !(rt.2 && (c_rt [Enum]))
      |
         unify::add_error(ctx, 3084,
           "'#member' 3-argument construction requires an enum type.")
         --| tast::mk_lit_unit(ce.line, ce.col)
   uenum' = c_rt [Enum ue] ue | unify::UEnum("", unify::UEnumVariants())
   ?uenum'.variants == 0 && uenum'.name != ""
      |
         type_env::lookup_user_type(env, uenum'.name)
            | udef_e =>
               unify::canon(ctx, udef_e.ut)
                  [Enum ue_res] (uenum' = ue_res)
   t_vname = arg0_e [Var v] v
      [SizeOf so] (so.rec_type [TypeVar tv] tv | "")
      | ""
   enum_disp = uenum'.name != ""
      | bare_enum_label(uenum'.name)
      | (t_vname != "" | bare_enum_label(t_vname) | "enum")
   lbl_e = ce.args(1)!!
   found_idx' = -1
   v_info' = unify::UEnumVariant("", <->, unify::UType(None))
   eff_lbl' = ++""
   lbl_idx_opt = lbl_e
      [Int idx] <+ idx +>
      [Var v]
         lookup_ct_int(v)
            | ci => <+ ci +>
            | lookup_ct_cursor(v) | cur => <+ cur.idx +> | <-->
      | <-->
   lbl_idx_opt
      | idx =>
         idx !< 0 && idx < ?uenum'.variants
            |
               found_idx' = idx
               v_info' = uenum'.variants(idx) | _ |
                  unify::UEnumVariant("", <->, unify::UType(None))
               eff_lbl' = v_info'.label
            |
               unify::add_error(ctx, 3171,
                 "Enum variant index ${idx} out of range (0..${?uenum'.variants - 1}).")
               --| tast::mk_lit_unit(ce.line, ce.col)
      |
         lbl_str = lbl_e [Str s] s [Var v] v | ""
         eff_lbl' = lbl_str
         lbl_str != ""
            |
               uenum'.variants @ vi, si =>
                  vi.label == lbl_str | (found_idx' = si; v_info' = vi; -->)
   found_idx' < 0
      | unify::add_error(ctx, 3096, diag::enum_no_variant(enum_disp, eff_lbl'))
      | !v_info'.has_payload
         | unify::add_error(ctx, 3098, diag::enum_unit_payload(enum_disp, eff_lbl'))
   saved_exp = cur_expected_ut
   v_info'.has_payload
      | (cur_expected_ut ::= <+ v_info'.payload_type +>)
   pay_te = annotate_call_arg(ctx, env, ce.args(2)!!)
   cur_expected_ut ::= saved_exp
   found_idx' !< 0 && v_info'.has_payload
      |
         ok_p = unify::unify(ctx, v_info'.payload_type, pay_te.ut)
         !ok_p
            |
               exp_name = unify::show_utype(ctx, v_info'.payload_type)
               got_name = unify::show_utype(ctx, pay_te.ut)
               unify::add_error(ctx, 3099,
                 diag::enum_payload_type(enum_disp, eff_lbl', exp_name, got_name))
   lay = layout::compute_layout(ctx, rt.0)
   tast::mk_typed_enum_construct(eff_lbl', <+ pay_te +>, rt.0, rt.1, lay,
     ce.line, ce.col)

/// Canonical primitive constructor/cast name for a `UPrim`.
uprim_to_cast_name: unify::UPrim => String
uprim_to_cast_name =
   [Int] "Int"
   [I8] "i8"
   [I16] "i16"
   [I32] "i32"
   [I64] "i64"
   [U8] "u8"
   [U16] "u16"
   [U32] "u32"
   [U64] "u64"
   [Flag] "<>"
   [Rune] "Rune"
   [Float] "Float"
   [F32] "f32"
   [Str] "String"
   [RawPtr] "Addr"
   [Builder] "Builder"
   [Error] "Error"
   [Unit] "void"
   [Type] "Type"
   | ""

/// Annotates a primitive type-cast call `cast_name(arg)`.
annotate_primitive_cast_call: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
  String, unify::UPrim => tast::TypedExpr
annotate_primitive_cast_call = ctx, env, ce, cast_name, uprim =>
   typed_args = annotate_call_args(ctx, env, ce.args)
   nargs_cast = ?typed_args
   nargs_cast != 1
      |
         unify::add_error(ctx, 3084,
           "Type cast '" + cast_name + "' requires 1 argument, got " +
           str::from_int(nargs_cast))
   nargs_cast == 1
      |
         arg0 = typed_args(0)!!
         c_a0 = unify::canon(ctx, arg0.ut)
         is_bf_src = is_bitfield_ti_env(env, arg0.ti)
         !(is_bf_src && is_uprim_int(uprim))
            | validate_primitive_cast(ctx, cast_name, uprim, c_a0)
   cast_ut = unify::UType(Prim, uprim)
   ti = unify::type_info_from_utype(ctx, cast_ut)
   lay = layout::compute_layout(ctx, cast_ut)
   tast::mk_typed_call(cast_name, <-->, typed_args, cast_ut, ti, lay,
     ce.line, ce.col)

annotate_error_ctor_call: unify::Ctx, type_env::TypeEnv, ast::CallExpr => tast::TypedExpr
annotate_error_ctor_call = ctx, env, ce =>
   typed_args = annotate_call_args(ctx, env, ce.args)
   nargs_err = ?typed_args
   nargs_err > 6
      |
         unify::add_error(ctx, 3084,
           "Constructor 'Error' takes at most 6 arguments, got " +
           str::from_int(nargs_err))
   nargs_err > 0 | unify::unify(ctx, (typed_args(0)!!).ut, unify::prim_int!)
   nargs_err > 1 | unify::unify(ctx, (typed_args(1)!!).ut, unify::prim_str!)
   nargs_err > 2 | unify::unify(ctx, (typed_args(2)!!).ut, unify::prim_str!)
   nargs_err > 3 | unify::unify(ctx, (typed_args(3)!!).ut, unify::prim_int!)
   nargs_err > 4 | unify::unify(ctx, (typed_args(4)!!).ut, unify::prim_int!)
   err_ut = unify::prim_error!
   err_ti = ast::TypeInfo(Prim, ast::ValueType(Error))
   err_lay = layout::compute_layout(ctx, err_ut)
   tast::mk_typed_call("Error", <-->, typed_args, err_ut, err_ti, err_lay,
     ce.line, ce.col)

annotate_call_udef: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
  type_env::UserTypeDef => tast::TypedExpr

annotate_call: unify::Ctx, type_env::TypeEnv, ast::CallExpr => tast::TypedExpr
annotate_call = ctx, env, ce =>
   ce.line > 0 | unify::set_pos(ctx, ce.line, ce.col)
   ce.fn_name == "#has_member"
      |
         ?ce.args != 2
            |
               unify::add_error(ctx, 3084,
                 "'#has_member' expects 2 arguments (Target, member).")
               --| tast::mk_lit_flag(<->, ce.line, ce.col)
         arg1 = ce.args(1)!!
         m_info = arg1
            [Str s] (s, <+>)
            [Var v] (v, <+>)
            | ("", <->)
         !m_info.1
            |
               unify::add_error(ctx, 3084,
                 "'#has_member' member name must be an identifier or string literal.")
               --| tast::mk_lit_flag(<->, ce.line, ce.col)
         hm = try_eval_has_member(ctx, env, ce.args(0)!!, m_info.0)
         hm.1 | --| tast::mk_lit_flag(hm.0, ce.line, ce.col)
         rt0 = resolve_type_expr_ut_ti(ctx, env, "", ce.args(0)!!)
         tgt_te = rt0.2
            | tast::mk_typed_var(ce.args(0)!! [Var v] v | "", 0, <->,
              unify::prim_type!, rt0.1, tast::layout_scalar(8, 8), ce.line, ce.col)
            | annotate_expr(ctx, env, ce.args(0)!!)
         typed_args = tast::TypedExprs()
         typed_args += tgt_te
         typed_args += tast::mk_lit_str(m_info.0, ce.line, ce.col)
         --| tast::mk_typed_call("#has_member", <-->, typed_args, unify::prim_flag!,
           ast::TypeInfo(Prim, ast::ValueType(Flag)), tast::layout_scalar(1, 1),
           ce.line, ce.col)
   ce.fn_name == "#member3"
      | --| annotate_hash_member3_call(ctx, env, ce)
   is_intrinsic = is_intrinsic_name(ce.fn_name)
   is_intrinsic
      | --| annotate_intrinsic_call(ctx, env, ce)
   ?ce.args == 1
      |
         pred_nm = ce.fn_name != ""
            | type_pred_name_from_str(ce.fn_name)
            | type_pred_name_from_expr(ce.fn_target)
         is_allowed_type_pred_call(env, ce, pred_nm)
            |
               rt_pred = resolve_type_expr_ut_ti(ctx, env, "", ce.args(0)!!)
               rt_pred.2
                  | --| tast::mk_lit_flag(eval_utype_predicate(ctx, pred_nm, rt_pred.0),
                    ce.line, ce.col)
   ce.fn_name != ""
      |
         !has_name_in(called_fns, ce.fn_name)
            | (called_fns += ce.fn_name)
         ?fn_alias_vars @
            ?fn_alias_vars @ ai =>
               avn = fn_alias_vars(ai) | _ | ""
               has_name_in(called_fns, avn)
                  |
                     tgt = fn_alias_tgts(ai) | _ | ""
                     tgt != "" && !has_name_in(called_fns, tgt)
                        | (called_fns += tgt)
   ct_opt = ce.fn_name != "" | lookup_ct_type(ce.fn_name) | <-->
   ct_opt
      | ctb =>
         c_ct = unify::canon(ctx, ctb.ut)
         c_ct
            [Prim up]
               up
                  [Builder]
                     unify::add_error(ctx, 3084,
                       "Type 'Builder' cannot be used as a function or constructor. " +
                       "Use '{cap}' to create a Builder.")
                     typed_args = annotate_call_args(ctx, env, ce.args)
                     b_ut = unify::prim_builder!
                     b_ti = ast::TypeInfo(Prim, ast::ValueType(Builder))
                     b_lay = layout::compute_layout(ctx, b_ut)
                     --| tast::mk_typed_call("Builder", <-->, typed_args, b_ut, b_ti,
                       b_lay, ce.line, ce.col)
                  [Unit, Type]
                     cname_u = uprim_to_cast_name(up)
                     unify::add_error(ctx, 3084,
                       "Type '${cname_u}' cannot be used as a function or constructor.")
                     typed_args = annotate_call_args(ctx, env, ce.args)
                     u_ut = unify::prim_unit!
                     u_ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
                     --| tast::mk_typed_call(cname_u, <-->, typed_args, u_ut, u_ti,
                       tast::layout_void!, ce.line, ce.col)
                  [Error] --| annotate_error_ctor_call(ctx, env, ce)
                  | --| annotate_primitive_cast_call(ctx, env, ce,
                    uprim_to_cast_name(up), up)
            |
               tname = ctb.dtype != "" | ctb.dtype |
                  (ctb.ti [TypeVar tv] tv | ce.fn_name)
               --| annotate_call_udef(ctx, env, ce,
                 type_env::UserTypeDef(tname, ctb.ti, ctb.ut))
   ce.fn_name
      ["Builder"]
         unify::add_error(ctx, 3084,
           "Type 'Builder' cannot be used as a function or constructor. " +
           "Use '{cap}' to create a Builder.")
         typed_args = annotate_call_args(ctx, env, ce.args)
         b_ut = unify::prim_builder!
         b_ti = ast::TypeInfo(Prim, ast::ValueType(Builder))
         b_lay = layout::compute_layout(ctx, b_ut)
         tast::mk_typed_call(ce.fn_name, <-->, typed_args, b_ut, b_ti,
           b_lay, ce.line, ce.col)
      ["Type", "void"]
         unify::add_error(ctx, 3084,
           "Type '" + ce.fn_name +
           "' cannot be used as a function or constructor.")
         typed_args = annotate_call_args(ctx, env, ce.args)
         u_ut = unify::prim_unit!
         u_ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
         u_lay = tast::layout_void!
         tast::mk_typed_call(ce.fn_name, <-->, typed_args, u_ut, u_ti,
           u_lay, ce.line, ce.col)
      ["Error"]
         annotate_error_ctor_call(ctx, env, ce)
      ["addr"]
         typed_args = annotate_call_args(ctx, env, ce.args)
         nargs_addr = ?typed_args
         nargs_addr != 1
            |
               unify::add_error(ctx, 3084,
                 "Function 'addr' requires 1 argument, got " +
                 str::from_int(nargs_addr))
         nargs_addr == 1
            |
               arg0 = typed_args(0)!!
               c_a0 = unify::canon(ctx, arg0.ut)
               validate_primitive_cast(ctx, ce.fn_name,
                 unify::UPrim(RawPtr), c_a0)
         cast_ut = unify::UType(Prim, unify::UPrim(RawPtr))
         ti = unify::type_info_from_utype(ctx, cast_ut)
         lay = layout::compute_layout(ctx, cast_ut)
         tast::mk_typed_call(ce.fn_name, <-->, typed_args, cast_ut, ti,
           lay, ce.line, ce.col)
      |
         cast_opt = cast_name_to_uprim(ce.fn_name)
         cast_opt
            | uprim => annotate_primitive_cast_call(ctx, env, ce, ce.fn_name, uprim)
            | annotate_call_normal(ctx, env, ce)

resolve_fn_ut: unify::Ctx, type_env::TypeEnv, String,
  unify::UType => unify::UType
resolve_fn_ut = ctx, env, name, ut =>
   is_gen = type_env::is_generic_binding(env, name)
   is_gen | instantiate_unbound_fn(ctx, ut) | ut

is_trivial_expr: ast::Expr => <>
is_trivial_expr = e =>
   is_lit = e [Int, Float, Str, Rune, Var]
   is_flg = e [Variant ve] ?ve.args == 0 | <->
   is_lit || is_flg

find_record_ctor_field_expr: ast::Exprs, ast::RecordFieldType,
  Int, Int, <> => < ast::Expr | >
find_record_ctor_field_expr = args, fld, j, nf, rest_have_defaults =>
   named_res' = <-->
   args @ arg_i =>
      arg_i [NamedArg na]
         na.name == fld.name | (named_res' = <+ na.val +>; -->)
   named_res'
      | val => <+ val +>
      |
         args_first = args(0)
         a0_is_rec = args_first | a0 => a0 [Record] | <->
         fld_is_rec = fld.rec_type [Rec]
         is_tuple_arg = ?args == 1 &&
           ((nf > 1 && !rest_have_defaults) || (a0_is_rec && !fld_is_rec))
         pos_res' = <-->
         !is_tuple_arg
            |
               arg_j_opt = args(j)
               arg_j_opt
                  | arg_j =>
                     !(arg_j [NamedArg, Range]) | pos_res' = <+ arg_j +>
         pos_res'
            | val => <+ val +>
            |
               tuple_res' = <-->
               is_tuple_arg
                  |
                     a0 = args(0)!!
                     !(a0 [NamedArg, Range])
                        |
                           a0
                              [Record rec_lit]
                                 rf_opt = rec_lit.fields(j)
                                 rf_opt
                                    | rf => (tuple_res' = <+ rf.val +>)
                              |
                                 idx_e = ast::Expr(Member,
                                   ast::MemberExpr(a0, "", <->,
                                     ast::Expr(Int, j), 0, 0))
                                 tuple_res' = <+ idx_e +>
               tuple_res'
                  | val => <+ val +>
                  |
                     splat_res' = <-->
                     args @ s_arg =>
                        s_arg [Range r]
                           !r.has_lhs && r.has_rhs
                              |
                                 is_def = r.rhs [Var v] (v == "default") | <->
                                 is_def
                                    |
                                       fld.has_default
                                          |
                                             splat_res' = <+ fld.default_expr +>
                                             -->
                                    |
                                       fld_access = ast::Expr(Member,
                                         ast::MemberExpr(r.rhs, fld.name,
                                           <->, ast::Expr(Var, ""), 0, 0))
                                       splat_res' = <+ fld_access +>
                                       -->
                     splat_res'
                        | val => <+ val +>
                        |
                           fld.has_default | <+ fld.default_expr +>

annotate_record_ctor_fields: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
  type_env::UserTypeDef, unify::UFields, ast::FieldTypes,
  Int, <>, ast::TypeInfo => tast::TypedExpr
annotate_record_ctor_fields = ctx, env, ce, udef, flds, fields, nf, is_bitfield, res_ti =>
   effective_args = ast::Exprs()
   a0_rec_opt = ce.args(0)
      | a0 =>
         a0 [Record r] <+ r +> | <-->
      | <-->
   fld0_is_rec = ?flds > 0
      | unify::canon(ctx, flds(0)!!.ut) [Rec]
      | (fields(0) | f0 => f0.rec_type [Rec] | <->)
   rest_have_defaults' = <+>
   nf @ fi =>
      fi > 0
         |
            f_i = fields(fi)!!
            !f_i.has_default | (rest_have_defaults' = <->)
   is_tuple_lit = ?ce.args == 1 && <>(a0_rec_opt) &&
     (!fld0_is_rec || (nf > 1 && !rest_have_defaults'))
   is_tuple_lit && ce.line > 0
      |
         unify::add_error(ctx, 3023,
           "Redundant double parentheses in record constructor '" + ce.fn_name +
           "': write '" + ce.fn_name + "(...)', not '" + ce.fn_name + "((...))'")
   is_tuple_lit
      |
         rec_lit = a0_rec_opt!!
         rec_lit.fields @ rf =>
            rf.has_name
               | effective_args += ast::Expr(NamedArg, ast::NamedArgExpr(rf.name, rf.val))
               | effective_args += rf.val
      |
         effective_args = ce.args
   seen_names = ast::Names()
   has_splat' = <->
   pos_count' = 0
   effective_args @ arg =>
      arg
         [NamedArg na]
            found_fld' = <->
            fields @ f =>
               f.name == na.name | (found_fld' = <+>; -->)
            !found_fld'
               |
                  unify::add_error(ctx, 3117,
                    "Record '" + ce.fn_name + "' has no field '" + na.name + "'")
            is_dup = <->
            seen_names @ s_nm =>
               s_nm == na.name | (is_dup = <+>; -->)
            is_dup
               |
                  unify::add_error(ctx, 3117,
                    "Duplicate argument '" + na.name + "' in constructor for '" + ce.fn_name + "'")
               |
                  seen_names += na.name
         [Range r] (has_splat' = <+>)
         |
            pos_count' = pos_count' + 1
   eff_a0_is_rec = effective_args(0) | a0 => a0 [Record] | <->
   is_tuple_arg = ?effective_args == 1 && ((nf > 1 && !rest_have_defaults') || (eff_a0_is_rec && !fld0_is_rec))
   !is_tuple_arg && !has_splat' && pos_count' > nf
      |
         unify::add_error(ctx, 3023,
           "Too many arguments to '" + ce.fn_name + "': expected at most " + str::from_int(nf) + ", got " + str::from_int(pos_count'))
   !is_tuple_arg
      |
         pos_idx' = 0
         effective_args @ arg =>
            !(arg [NamedArg, Range])
               |
                  pos_idx' < nf
                     |
                        f_at = fields(pos_idx')!!
                        f_at.name != ""
                           |
                              seen_names @ s_nm =>
                                 s_nm == f_at.name
                                    |
                                       unify::add_error(ctx, 3117,
                                         "Duplicate argument '" + f_at.name + "' in constructor for '" + ce.fn_name + "'")
                                       -->
                              seen_names += f_at.name
                  pos_idx' = pos_idx' + 1
   needs_reorder' = <->
   last_fi' = -1
   effective_args @ arg, ai =>
      arg
         [NamedArg na]
            fi' = -1
            fields @ f, fi =>
               f.name == na.name | (fi' = fi; -->)
            (fi' !< 0 && fi' < last_fi') | (needs_reorder' = <+>)
            fi' !< 0 | (last_fi' = fi')
         [Range r] (needs_reorder' = <+>)
         |
            (ai < last_fi') | (needs_reorder' = <+>)
            last_fi' = ai
   needs_eval_temps = needs_reorder' || (is_tuple_arg && !is_tuple_lit)
   pre_stmts = tast::TypedExprs()
   new_args = ast::Exprs()
   !needs_eval_temps
      | (new_args = effective_args)
      |
         effective_args @ arg, ai =>
            arg
               [NamedArg na]
                  is_triv = is_trivial_expr(na.val)
                  is_triv
                     | new_args += arg
                     |
                        f_idx = unify::find_field_idx(flds, na.name)
                        fld_ut_opt = (f_idx !< 0 && f_idx < ?flds | <+ (flds(f_idx) | _ | unify::UField("", unify::UType(None))).ut +> | <-->)
                        saved_ctor_exp = cur_expected_ut
                        cur_expected_ut ::= fld_ut_opt
                        val_te = annotate_expr(ctx, env, na.val)
                        cur_expected_ut ::= saved_ctor_exp
                        val_v = unify::fresh_var(ctx)
                        tmp_id = val_v [Var id] id | 0
                        tmp_name = "__ctor_arg_" + str::from_int(tmp_id)
                        type_env::bind_local(env, tmp_name, val_te.ut, val_te.ti, <->)
                        type_env::init_mark_whole(env, tmp_name)
                        as_kind = tast::TypedExprKind(Assign, (tmp_name, <->, <->, <->, <->, val_te))
                        as_te = tast::mk_typed_expr(as_kind, val_te.ut, val_te.ti, val_te.layout, 0, 0)
                        pre_stmts += as_te
                        new_args += ast::Expr(NamedArg, ast::NamedArgExpr(na.name, ast::Expr(Var, tmp_name)))
               [Range r]
                  !r.has_lhs && r.has_rhs
                     |
                        is_def = r.rhs [Var v] (v == "default") | <->
                        is_def || is_trivial_expr(r.rhs)
                           | new_args += arg
                           |
                              rhs_te = annotate_expr(ctx, env, r.rhs)
                              rhs_v = unify::fresh_var(ctx)
                              tmp_id = rhs_v [Var id] id | 0
                              tmp_name = "__ctor_arg_" + str::from_int(tmp_id)
                              type_env::bind_local(env, tmp_name, rhs_te.ut, rhs_te.ti, <->)
                              type_env::init_mark_whole(env, tmp_name)
                              as_kind = tast::TypedExprKind(Assign, (tmp_name, <->, <->, <->, <->, rhs_te))
                              as_te = tast::mk_typed_expr(as_kind, rhs_te.ut, rhs_te.ti, rhs_te.layout, 0, 0)
                              pre_stmts += as_te
                              new_r = ast::RangeExpr(r.has_lhs, r.has_rhs, r.lhs, ast::Expr(Var, tmp_name), r.is_inclusive)
                              new_args += ast::Expr(Range, new_r)
                     | new_args += arg
               |
                  is_triv = is_trivial_expr(arg)
                  is_triv
                     | new_args += arg
                     |
                        f_idx = ai < ?flds | ai | -1
                        fld_ut_opt = (f_idx !< 0 && f_idx < ?flds | <+ (flds(f_idx) | _ | unify::UField("", unify::UType(None))).ut +> | <-->)
                        saved_ctor_exp = cur_expected_ut
                        cur_expected_ut ::= fld_ut_opt
                        arg_te = annotate_expr(ctx, env, arg)
                        cur_expected_ut ::= saved_ctor_exp
                        arg_v = unify::fresh_var(ctx)
                        tmp_id = arg_v [Var id] id | 0
                        tmp_name = "__ctor_arg_" + str::from_int(tmp_id)
                        type_env::bind_local(env, tmp_name, arg_te.ut, arg_te.ti, <->)
                        type_env::init_mark_whole(env, tmp_name)
                        as_kind = tast::TypedExprKind(Assign, (tmp_name, <->, <->, <->, <->, arg_te))
                        as_te = tast::mk_typed_expr(as_kind, arg_te.ut, arg_te.ti, arg_te.layout, 0, 0)
                        pre_stmts += as_te
                        new_args += ast::Expr(Var, tmp_name)
   tf_list = tast::TypedFields()
   cur_off' = 0
   nf @ j =>
      fld = fields(j) | _ | ast::mk_rfield_type("",
        ast::ValueType(Unknown), ast::TypeInfo(Prim, ast::ValueType(Unknown)))
      val_expr_opt = find_record_ctor_field_expr(new_args, fld, j, nf, rest_have_defaults')
      has_val' = <->
      val_expr_opt | (has_val' = <+>)
      !has_val'
         |
            is_bitfield
               |
                  def_bf = (fld.val_type [Flag])
                     | ast::Expr(Variant, ast::VariantExpr(ast::Tag(Negative), ast::Exprs()))
                     | ast::Expr(Int, 0)
                  val_expr_opt = <+ def_bf +>
               |
                  unify::add_error(ctx, 3130,
                    diag::record_default_missing(fld.name, ce.fn_name))
      val_expr = val_expr_opt | _ | ast::Expr(Int, 0)
      idx = fld.name != "" | unify::find_field_idx(flds, fld.name) | j
      fld_ut_opt = (idx !< 0 && idx < ?flds | <+ (flds(idx) | _ | unify::UField("", unify::UType(None))).ut +> | <-->)
      saved_ctor_exp = cur_expected_ut
      cur_expected_ut ::= fld_ut_opt
      val_te = annotate_expr(ctx, env, val_expr)
      cur_expected_ut ::= saved_ctor_exp
      idx !< 0 && idx < ?flds
         |
            ufld = flds(idx) | _ | unify::UField("", unify::UType(None))
            unify::unify(ctx, ufld.ut, val_te.ut)
      flay = layout::compute_layout(ctx, val_te.ut)
      f_align = flay.align < 1 | 1 | flay.align
      cur_off' = layout::align_up(cur_off', f_align)
      tf = tast::TypedField(fld.name, val_te, cur_off', val_te.ut)
      cur_off' = cur_off' + flay.size
      tf_list += tf
   lay = layout::compute_layout(ctx, udef.ut)
   rec_te = tast::mk_typed_expr(tast::TypedExprKind(Record, tf_list),
     udef.ut, res_ti, lay, ce.line, ce.col)
   ?pre_stmts > 0
      |
         block_exprs = pre_stmts
         block_exprs += rec_te
         tast::mk_typed_expr(tast::TypedExprKind(Block, block_exprs),
           udef.ut, res_ti, lay, ce.line, ce.col)
      | rec_te

unwrap_align_ti: ast::TypeInfo => ast::TypeInfo
unwrap_align_ti = ti =>
   ti
      [Align a] unwrap_align_ti(a.1)
      | ti

annotate_record_ctor: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
  type_env::UserTypeDef, unify::UFields => tast::TypedExpr
annotate_record_ctor = ctx, env, ce, udef, flds =>
   resolved_ti' = udef.ti
   unwrap_align_ti(udef.ti)
      [TypeVar tv]
         inner_u = resolve_user_ti(env, ast::TypeInfo(TypeVar, tv))
         resolved_ti' = udef.ti
            [Align a] ast::TypeInfo(Align, (a.0, inner_u))
            | inner_u
   inner_ti = unwrap_align_ti(resolved_ti')
   bf_opt = inner_ti [Bitfield b] <+ b +> | <-->
   bf_fields = bf_opt
      | bfi =>
         bfs = ast::FieldTypes()
         bfi.fields @ bf =>
            f_vt = bf.is_flag | ast::ValueType(Flag) | bfi.backing_type
            bfs += ast::mk_rfield_type(bf.name, f_vt, ast::TypeInfo(Prim, f_vt))
         bfs
      | ast::FieldTypes()
   fields = <>(bf_opt) | bf_fields | (inner_ti [Rec rr] rr.0 | ast::FieldTypes())
   nf = ?fields
   is_raw_cast' = <->
   raw_te' = tast::mk_lit_unit(0, 0)
   ?ce.args == 1
      |
         a0 = ce.args(0)!!
         !(a0 [NamedArg, Range])
            |
               a0_te = annotate_expr(ctx, env, a0)
               c_a0 = unify::canon(ctx, a0_te.ut)
               c_a0
                  [Prim p]
                     p
                        [RawPtr]
                           is_raw_cast' = <+>
                           raw_te' = a0_te
                        [Int, I8, I16, I32, I64, U8, U16, U32, U64]
                           <>(bf_opt)
                              |
                                 is_raw_cast' = <+>
                                 raw_te' = a0_te
                  [Var]
                     <>(bf_opt) && nf > 1
                        |
                           unify::unify(ctx, a0_te.ut, unify::prim_int!)
                           is_raw_cast' = <+>
                           raw_te' = a0_te
   is_raw_cast'
      |
         call_args = tast::TypedExprs()
         call_args += raw_te'
         lay = layout::compute_layout(ctx, udef.ut)
         tast::mk_typed_call(ce.fn_name, <-->, call_args, udef.ut, resolved_ti',
           lay, ce.line, ce.col)
      | annotate_record_ctor_fields(ctx, env, ce, udef, flds, fields, nf, <>(bf_opt), resolved_ti')

is_splat_expr: ast::Expr => <ast::Expr|>
is_splat_expr = expr =>
   expr
      [Range r]
         !r.has_lhs && r.has_rhs | <+ r.rhs +> | <-->
      | <-->

call_has_named_arg: ast::Exprs => <>
call_has_named_arg = args =>
   found' = <->
   args @ a =>
      a [NamedArg] (found' = <+>; -->)
   found'

annotate_record_copy_update: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
  ast::Expr, unify::UType, ast::TypeInfo, unify::UFields => tast::TypedExpr
annotate_record_copy_update = ctx, env, ce, base_expr, base_ut, base_ti, rec =>
   upd_args = ast::Exprs()
   ce.args @ a => upd_args += a
   upd_args += ast::Expr(Range, ast::RangeExpr(<->, <+>, ast::Expr(Int, 0), base_expr, <->))
   tname_ti = base_ti [TypeVar tv] tv | ""
   udef_ti_opt = tname_ti != "" | type_env::lookup_user_type(env, tname_ti) | <-->
   rec_rn = ?rec > 0 | rec(0)!!.rec_name | ""
   udef_opt = udef_ti_opt
      | u => <+ u +>
      | (rec_rn != "" | type_env::lookup_user_type(env, rec_rn) | <-->)
   tname' = udef_opt | u => u.name | (rec_rn != "" | rec_rn | tname_ti)
   eff_ti = udef_opt
      | u => u.ti
      | (base_ti [Rec, Align, Bitfield] base_ti | unify::type_info_from_utype(ctx, base_ut))
   eff_udef = udef_opt
      | u => u
      | type_env::UserTypeDef(tname' != "" | tname' | ce.fn_name, eff_ti, base_ut)
   upd_ce = ast::CallExpr(eff_udef.name, ast::Expr(Var, ""), upd_args, ce.line, ce.col)
   annotate_record_ctor(ctx, env, upd_ce, eff_udef, rec)

rec_has_all_fields: unify::UFields, ast::Names => <>
rec_has_all_fields = flds, names =>
   ok' = <+>
   names @ n =>
      unify::find_field_idx(flds, n) < 0 | (ok' = <->; -->)
   ok'

find_unique_user_rec_for_fields: unify::Ctx, type_env::TypeEnv, ast::Names, <> => <type_env::UserTypeDef|>
find_unique_user_rec_for_fields = ctx, env, req_names, cur_mod_only =>
   seen = ast::Names()
   matches' = type_env::UserTypeDef{}
   ?env.user_types @ k =>
      i = (?env.user_types) - 1 - k
      u = env.user_types(i)!!
      !has_name_in(seen, u.name)
         |
            seen += u.name
            mod_ok = !cur_mod_only || type_env::decl_module(u.name, 0) == env.current_module
            mod_ok
               |
                  cu = unify::canon(ctx, u.ut)
                  cu
                     [Rec u_fs]
                        ?u_fs > 0 && u_fs(0)!!.rec_name == u.name && u_fs(0)!!.name != "" &&
                          rec_has_all_fields(u_fs, req_names)
                           | (matches' += u)
   ?matches' == 1 | <+ matches'(0)!! +> | <-->

maybe_resolve_copy_update_ut: unify::Ctx, type_env::TypeEnv, ast::Exprs, unify::UType => <type_env::UserTypeDef|>
maybe_resolve_copy_update_ut = ctx, env, args, base_ut =>
   !call_has_named_arg(args)
      | <-->
      |
         c_ut = unify::canon(ctx, base_ut)
         is_open_or_var = c_ut
            [Var] <+>
            [Rec r] (?r == 0 || r(0)!!.rec_name == "")
            | <->
         !is_open_or_var
            | <-->
            |
               req_names = ast::Names()
               args @ a =>
                  a [NamedArg na] (na.name != "" && !has_name_in(req_names, na.name) | (req_names += na.name))
               c_ut
                  [Rec r]
                     r @ rf =>
                        rf.name != "" && !has_name_in(req_names, rf.name) | (req_names += rf.name)
               ?req_names == 0
                  | <-->
                  |
                     m1 = env.current_module != ""
                        | find_unique_user_rec_for_fields(ctx, env, req_names, <+>)
                        | <-->
                     m1
                        | u => <+ u +>
                        | find_unique_user_rec_for_fields(ctx, env, req_names, <->)

desugar_array_lit_item: unify::Ctx, String, <>, ast::Expr => ast::Expr
desugar_array_lit_item = ctx, arr_var, elem_ut_is_fn, e =>
   ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   splat_opt = is_splat_expr(e)
   splat_opt
      | splat_rhs =>
         el_v = unify::fresh_var(ctx)
         el_id = el_v [Var id] id | 0
         el_var = "_splat_el_" + str::from_int(el_id)
         params = ast::Names()
         params += el_var
         app_e = ast::Expr(Assign, (arr_var, <->, <+>, <->, <->, ast::Expr(Var, el_var), ast::Expr(Var, ""), "", ti_unk))
         body_fn = ast::Expr(Fn, ast::FnExpr(params, ast::Names(), app_e))
         ast::Expr(Cycle, ast::CycleExpr(splat_rhs, body_fn, <->))
      |
         e
            [Fn fe]
               (?fe.params == 1 && (!elem_ut_is_fn || <>(is_splat_expr(fe.body))))
                  |
                     new_body = desugar_array_lit_item(ctx, arr_var, elem_ut_is_fn, fe.body)
                     ast::Expr(Fn, ast::FnExpr(fe.params, fe.ct_params, new_body, fe.line, fe.col))
                  |
                     ast::Expr(Assign, (arr_var, <->, <+>, <->, <->, e, ast::Expr(Var, ""), "", ti_unk))
            [Block exprs]
               ?exprs > 0
                  |
                     new_exprs = ast::Exprs()
                     (?exprs - 1) @ bi =>
                        new_exprs += exprs(bi)!!
                     last_e = exprs(?exprs - 1)!!
                     new_exprs += desugar_array_lit_item(ctx, arr_var, elem_ut_is_fn, last_e)
                     ast::Expr(Block, new_exprs)
                  |
                     ast::Expr(Assign, (arr_var, <->, <+>, <->, <->, e, ast::Expr(Var, ""), "", ti_unk))
            [Choice ch]
               new_branches = ast::Branches()
               ch.branches @ br =>
                  new_blk = desugar_array_lit_item(ctx, arr_var, elem_ut_is_fn, br.block)
                  new_branches += ast::ChoiceBranch(br.kind, br.case_values, br.pred_fn, br.variant_names, br.bind_vars, <->, new_blk)
               ast::Expr(Choice, ast::ChoiceExpr(ch.cond, ch.is_exhaustive, new_branches))
            |
               ast::Expr(Assign, (arr_var, <->, <+>, <->, <->, e, ast::Expr(Var, ""), "", ti_unk))

annotate_array_lit_call: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
  ast::Expr, <> => tast::TypedExpr
annotate_array_lit_call = ctx, env, ce, init_e, elem_is_fn =>
   ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   arr_v = unify::fresh_var(ctx)
   arr_id = arr_v [Var id] id | 0
   arr_var = "_arr_lit_" + str::from_int(arr_id)
   stmts = ast::Exprs()
   stmts += ast::Expr(Assign, (arr_var, <+>, <->, <->, <->, init_e, ast::Expr(Var, ""), "", ti_unk))
   ce.args @ arg =>
      stmts += desugar_array_lit_item(ctx, arr_var, elem_is_fn, arg)
   stmts += ast::Expr(Var, arr_var)
   annotate_expr(ctx, env, ast::Expr(Block, stmts))

annotate_call_udef = ctx, env, ce, udef =>
   c_udef = unify::canon(ctx, udef.ut)
   c_udef
      [Rec flds]
         annotate_record_ctor(ctx, env, ce, udef, flds)
      [Array arr]
         ?ce.args > 0
            |
               init_e = ast::Expr(Call, ast::CallExpr(udef.name, ast::Expr(Var, ""), ast::Exprs(), ce.line, ce.col))
               elem_c = unify::canon(ctx, arr.elem)
               elem_is_fn = elem_c [Fn]
               res_te = annotate_array_lit_call(ctx, env, ce, init_e, elem_is_fn)
               tast::TypedExpr(res_te.kind, udef.ut, udef.ti, res_te.layout, ce.line, ce.col)
            |
               lay = layout::compute_layout(ctx, udef.ut)
               tast::mk_typed_call(udef.name, <-->, tast::TypedExprs(), udef.ut, udef.ti, lay, ce.line, ce.col)
      [Enum uenum]
         n_args = ?ce.args
         ti = udef.ti
         lay = layout::compute_layout(ctx, udef.ut)
         typed_args = tast::TypedExprs()
         n_args == 0
            |
               unify::add_error(ctx, 3096,
                 diag::enum_no_variant(ce.fn_name, ""))
            |
               arg0_e = ce.args(0) | _ | ast::Expr(Var, "")
               lbl_str = arg0_e [Var v] v | ""
               idx' = -1
               uenum.variants @ v_info, si =>
                  v_info.label == lbl_str | (idx' = si; -->)
               idx' < 0
                  |
                     can_cast = n_args == 1 &&
                       (lbl_str == "" || <>(type_env::lookup_binding(env, lbl_str)))
                     can_cast
                        |
                           a0 = annotate_call_arg(ctx, env, arg0_e)
                           typed_args += a0
                           ok_cast = unify::unify(ctx, udef.ut, a0.ut)
                           !ok_cast
                              |
                                 unify::add_error(ctx, 3096,
                                   diag::enum_no_variant(ce.fn_name, lbl_str))
                        |
                           unify::add_error(ctx, 3096,
                             diag::enum_no_variant(ce.fn_name, lbl_str))
                  |
                     v_info = uenum.variants(idx') | _ |
                        unify::UEnumVariant("", <->, unify::UType(None))
                     typed_args += tast::mk_typed_var(lbl_str, 0, <->,
                       udef.ut, ti, lay, ce.line, ce.col)
                     ?ce.args @ ai =>
                        ai > 0
                           |
                              a_e = ce.args(ai) | _ | ast::Expr(Int, 0)
                              saved_enum_exp = cur_expected_ut
                              (ai == 1 && v_info.has_payload)
                                 | cur_expected_ut ::= <+ v_info.payload_type +>
                              a_te = annotate_call_arg(ctx, env, a_e)
                              cur_expected_ut ::= saved_enum_exp
                              typed_args += a_te
                     !v_info.has_payload && n_args > 1
                        |
                           unify::add_error(ctx, 3098,
                             diag::enum_unit_payload(ce.fn_name, lbl_str))
                     v_info.has_payload && n_args == 1
                        |
                           unify::add_error(ctx, 3097,
                             "Enum '" + ce.fn_name + "' variant '" +
                             lbl_str + "' requires a payload argument.")
                     v_info.has_payload && n_args > 2
                        |
                           unify::add_error(ctx, 3098,
                             "Enum '" + ce.fn_name + "' variant '" +
                             lbl_str + "' takes 1 payload argument, got " +
                             str::from_int(n_args - 1) + ".")
                     v_info.has_payload && n_args == 2
                        |
                           arg1 = typed_args(1) | _ | tast::mk_lit_unit(0, 0)
                           ok_p = unify::unify(ctx, v_info.payload_type, arg1.ut)
                           !ok_p
                              |
                                 exp_name = unify::show_utype(ctx, v_info.payload_type)
                                 got_name = unify::show_utype(ctx, arg1.ut)
                                 unify::add_error(ctx, 3099,
                                   diag::enum_payload_type(ce.fn_name,
                                     lbl_str, exp_name, got_name))
         tast::mk_typed_call(udef.name, <-->, typed_args, udef.ut, ti,
           lay, ce.line, ce.col)
      |
         typed_args = annotate_call_args(ctx, env, ce.args)
         n_args = ?typed_args
         c_udef
            [Ram r]
               n_args == 1
                  |
                     a0 = typed_args(0)!!
                     c_a0 = unify::canon(ctx, a0.ut)
                     c_a0
                        [Ram r_arg]
                           r_arg.pos.has_payload
                              | unify::unify(ctx, r.pos.ut, r_arg.pos.ut)
                           r_arg.neg.has_payload
                              | unify::unify(ctx, r.neg.ut, r_arg.neg.ut)
                        | unify::unify(ctx, udef.ut, a0.ut)
            [Prim p]
               n_args == 1
                  |
                     a0 = typed_args(0) | _ | tast::mk_lit_int(0, 0, 0)
                     unify::unify(ctx, udef.ut, a0.ut)
         ti = udef.ti
         lay = layout::compute_layout(ctx, udef.ut)
         tast::mk_typed_call(udef.name, <-->, typed_args, udef.ut, ti,
           lay, ce.line, ce.col)

annotate_call_normal: unify::Ctx, type_env::TypeEnv,
  ast::CallExpr => tast::TypedExpr
annotate_call_normal = ctx, env, ce =>
   udef_opt = ce.fn_name != "" | type_env::lookup_user_type(env, ce.fn_name) | <-->
   udef_opt
      | udef => annotate_call_udef(ctx, env, ce, udef)
      |
         is_inline_arr_lit = ce.fn_name == "" && ?ce.args > 0 && (ce.fn_target [ArrayCreate])
         is_inline_arr_lit
            |
               elem_is_fn = ce.fn_target [ArrayCreate ac] (ac.elem_type [Fn]) | <->
               --| annotate_array_lit_call(ctx, env, ce, ce.fn_target, elem_is_fn)
         target_val' = <-->
         fn_ut' = unify::UType(None)
         call_fn_name' = ce.fn_name
         is_var_index' = <->
         index_ret_ut' = unify::UType(None)
         typed_args = tast::TypedExprs()
         arg_uts = unify::UTypes()
         args_done' = <->
         has_dot = ce.fn_name != "" &&
           (find_last_dot(ce.fn_name, ?ce.fn_name - 1) | d => d > 0 | <->)
         !has_dot && ce.fn_name != ""
            |
               bnd = type_env::lookup_binding(env, ce.fn_name)
               bnd
                  | b =>
                     resolved_fn = b.depth == 0 | b.name | ce.fn_name
                     c_ut0 = unify::canon(ctx, b.ut)
                     cu_udef = maybe_resolve_copy_update_ut(ctx, env, ce.args, c_ut0)
                     cu_udef
                        | udef => unify::unify(ctx, b.ut, udef.ut)
                     cu_ti = cu_udef | udef => udef.ti | b.ti
                     c_ut = unify::canon(ctx, b.ut)
                     c_ut
                        [Fn]
                           fn_ut' = resolve_fn_ut(ctx, env, ce.fn_name, b.ut)
                        [Prim p]
                           p
                              [Str, Builder]
                                 is_var_index' = <+>
                                 first_a = ce.args(0) | _ | ast::Expr(Int, 0)
                                 is_rng = is_range_expr(first_a)
                                 index_ret_ut' = is_rng | unify::prim_str! |
                                    unify::prim_int!
                              |
                                 fn_ut' = resolve_fn_ut(ctx, env, ce.fn_name,
                                   b.ut)
                        [Array arr]
                           is_var_index' = <+>
                           is_rng = ce.args(0) | a => is_range_expr(a) | <->
                           sl_ut = unify::mk_slice(arr.elem)
                           err_ut = unify::prim_error!
                           elem_ut = unify::ram_pp(arr.elem, err_ut)
                           index_ret_ut' = is_rng | sl_ut | elem_ut
                        [Slice elem]
                           is_var_index' = <+>
                           is_rng = ce.args(0) | a => is_range_expr(a) | <->
                           sl_ut = unify::mk_slice(elem)
                           index_ret_ut' = is_rng | sl_ut | elem
                        [Rec rec]
                           call_has_named_arg(ce.args)
                              |
                                 --| annotate_record_copy_update(ctx, env, ce,
                                   ast::Expr(Var, resolved_fn), c_ut, cu_ti, rec)
                           ?ce.args == 1
                              |
                                 is_var_index' = <+>
                                 n_flds = ?rec
                                 n_flds > 0
                                    |
                                       !is_ufields_homogeneous(ctx, rec)
                                          |
                                             unify::add_error(ctx, 3051,
                                               diag::E3051_dynamic_index_hetero!)
                                       f0 = rec(0)!!
                                       is_rng = ce.args(0) | a => is_range_expr(a) | <->
                                       f0_ut = f0.ut
                                       sl_ut = unify::mk_slice(f0_ut)
                                       index_ret_ut' = is_rng | sl_ut | f0_ut
                                    | index_ret_ut' = unify::fresh_var(ctx)
                              |
                                 fn_ut' = resolve_fn_ut(ctx, env, ce.fn_name, b.ut)
                        |
                           fn_ut' = resolve_fn_ut(ctx, env, ce.fn_name, b.ut)
                     !is_var_index'
                        |
                           call_fn_name' = resolved_fn
                           !has_name_in(called_fns, call_fn_name')
                              | (called_fns += call_fn_name')
                     is_var_index'
                        |
                           b_ti = unify::type_info_from_utype(ctx, b.ut)
                           b_lay = layout::compute_layout(ctx, b.ut)
                           target_val' = <+ tast::mk_typed_var(resolved_fn,
                             b.depth, b.is_mut, b.ut, b_ti, b_lay,
                             ce.line, ce.col) +>
                  |
                     gen_opt = type_env::lookup_generic(env, ce.fn_name)
                     gen_opt
                        | gen_ti =>
                           g_name = type_env::resolve_generic_name(env, ce.fn_name)
                           call_fn_name' = g_name
                           !has_name_in(called_fns, g_name) | (called_fns += g_name)
                           fn_ut' = instantiate_generic_ti_call_named(ctx, env,
                             type_env::decl_module(g_name, 0), gen_ti, ce.args, g_name)
                        |
                           unify::add_error(ctx, 3004,
                             "Undefined function: " + ce.fn_name)
                           fn_ut' = unify::poison_utype!
            |
               tgt_expr = has_dot | dotted_to_expr(ce.fn_name) | ce.fn_target
               is_lit_rec = tgt_expr [Record]
               is_inline_fn = !has_dot && (tgt_expr [Fn])
               is_inline_fn
                  |
                     outer_exp = cur_expected_ut
                     ce.args @ a =>
                        cur_expected_ut ::= <-->
                        ta = annotate_call_arg(ctx, env, a)
                        cur_expected_ut ::= outer_exp
                        a
                           [Var v]
                              c = unify::canon(ctx, ta.ut)
                              c
                                 [Rec]
                                    full = type_env::init_is_fully_init(env, v, c)
                                    !full
                                       |
                                          unify::add_error(ctx, 3132,
                                            diag::partial_composite_argument(v))
                        typed_args += ta
                        arg_uts += ta.ut
                     args_done' = <+>
                     exp_ret = outer_exp | u => u | unify::fresh_var(ctx)
                     cur_expected_ut ::= <+ unify::mk_fn(arg_uts, exp_ret) +>
                     target_te = annotate_expr(ctx, env, tgt_expr)
                     cur_expected_ut ::= outer_exp
                     target_val' = <+ target_te +>
                     fn_ut' = instantiate_unbound_fn(ctx, target_te.ut)
                  |
                     target_te = annotate_expr(ctx, env, tgt_expr)
                     target_val' = <+ target_te +>
                     c_tgt0 = unify::canon(ctx, target_te.ut)
                     tgt_udef = is_lit_rec
                        | <-->
                        | maybe_resolve_copy_update_ut(ctx, env, ce.args, c_tgt0)
                     tgt_udef
                        | udef => unify::unify(ctx, target_te.ut, udef.ut)
                     c_tgt = unify::canon(ctx, target_te.ut)
                     c_tgt
                        [Prim p2]
                           p2
                              [Str, Builder]
                                 is_var_index' = <+>
                                 first_a2 = ce.args(0) | _ | ast::Expr(Int, 0)
                                 is_rng2 = is_range_expr(first_a2)
                                 index_ret_ut' = is_rng2 | unify::prim_str! |
                                    unify::prim_int!
                              | fn_ut' = instantiate_unbound_fn(ctx, target_te.ut)
                        [Array arr2]
                           is_var_index' = <+>
                           is_rng2 = ce.args(0) | a => is_range_expr(a) | <->
                           sl_ut2 = unify::mk_slice(arr2.elem)
                           err_ut2 = unify::prim_error!
                           elem_ut2 = unify::ram_pp(arr2.elem, err_ut2)
                           index_ret_ut' = is_rng2 | sl_ut2 | elem_ut2
                        [Slice elem2]
                           is_var_index' = <+>
                           is_rng2 = ce.args(0) | a => is_range_expr(a) | <->
                           sl_ut2 = unify::mk_slice(elem2)
                           index_ret_ut' = is_rng2 | sl_ut2 | elem2
                        [Rec rec2]
                           !is_lit_rec && call_has_named_arg(ce.args)
                              |
                                 eff_tgt_ti = tgt_udef | udef => udef.ti | target_te.ti
                                 eff_tgt_lay = <>(tgt_udef) | layout::compute_layout(ctx, target_te.ut) | target_te.layout
                                 upd_v = unify::fresh_var(ctx)
                                 tmp_id = upd_v [Var id] id | 0
                                 tmp_name = "__rec_upd_" + str::from_int(tmp_id)
                                 type_env::bind_local(env, tmp_name, target_te.ut, eff_tgt_ti, <->)
                                 type_env::init_mark_whole(env, tmp_name)
                                 as_kind = tast::TypedExprKind(Assign, (tmp_name, <->, <->, <->, <->, target_te))
                                 as_te = tast::mk_typed_expr(as_kind, target_te.ut, eff_tgt_ti, eff_tgt_lay, ce.line, ce.col)
                                 ctor_te = annotate_record_copy_update(ctx, env, ce,
                                   ast::Expr(Var, tmp_name), c_tgt, eff_tgt_ti, rec2)
                                 blk_es = tast::TypedExprs()
                                 blk_es += as_te
                                 blk_es += ctor_te
                                 --| tast::mk_typed_expr(tast::TypedExprKind(Block, blk_es),
                                   ctor_te.ut, ctor_te.ti, ctor_te.layout, ce.line, ce.col)
                           !is_lit_rec && ?ce.args == 1
                              |
                                 is_var_index' = <+>
                                 n_flds2 = ?rec2
                                 n_flds2 > 0
                                    |
                                       !is_ufields_homogeneous(ctx, rec2)
                                          |
                                             unify::add_error(ctx, 3051,
                                               diag::E3051_dynamic_index_hetero!)
                                       f02 = rec2(0)!!
                                       is_rng2 = ce.args(0) | a => is_range_expr(a) | <->
                                       f0_ut2 = f02.ut
                                       sl_ut2 = unify::mk_slice(f0_ut2)
                                       index_ret_ut' = is_rng2 | sl_ut2 | f0_ut2
                                    | index_ret_ut' = unify::fresh_var(ctx)
                              |
                                 fn_ut' = instantiate_unbound_fn(ctx, target_te.ut)
                        | fn_ut' = instantiate_unbound_fn(ctx, target_te.ut)

         is_poison_callee = unify::is_poison(ctx, fn_ut')
         !args_done'
            |
               c_callee = unify::canon(ctx, fn_ut')
               ce.args @ a, i =>
                  exp_arg' = is_poison_callee
                     | <+ unify::poison_utype! +>
                     |
                        c_callee
                           [Fn f_sig] (i < ?f_sig.params | <+ f_sig.params(i)!! +> | <-->)
                           | <-->
                  is_opt_val = i == 3 && (a [Fn]) && ?typed_args > 1 && (ce.fn_name == "cli::opt" || ce.fn_name == "opt")
                  is_opt_val
                     |
                        a1_e = ce.args(1)!!
                        a1_vname = a1_e [Var vn] vn | ""
                        a1_uprim = a1_vname != "" | type_name_to_uprim(a1_vname) | <-->
                        a1_ut = unify::canon(ctx, (typed_args(1)!!).ut)
                        a1_base_ut = a1_ut [Array ua] ua.elem | a1_ut
                        opt_v_ut = a1_uprim
                           | up => unify::UType(Prim, up)
                           | a1_base_ut
                        v_params = unify::UTypes()
                        v_params += opt_v_ut
                        v_fn_ut = unify::mk_fn(v_params, unify::ram_np(unify::prim_str!))
                        exp_arg' = <+ v_fn_ut +>
                  saved_exp = cur_expected_ut
                  cur_expected_ut ::= exp_arg'
                  ta = annotate_call_arg(ctx, env, a)
                  cur_expected_ut ::= saved_exp
                  // Earlier value arguments ground generic callback parameters
                  // before a later lambda adds field constraints to them.
                  exp_arg' | expected =>
                     is_fresh = expected [Var v] !unify::is_open_var(ctx, v) | <->
                     is_fresh | unify::unify(ctx, expected, ta.ut)
                  a
                     [Var v]
                        c = unify::canon(ctx, ta.ut)
                        c
                           [Rec]
                              full = type_env::init_is_fully_init(env, v, c)
                              !full
                                 |
                                    unify::add_error(ctx, 3132,
                                      diag::partial_composite_argument(v))
                  typed_args += ta
                  arg_uts += ta.ut

         is_var_index'
            |
               ?typed_args > 0
                  |
                     a0 = typed_args(0)!!
                     is_rng_ce = ce.args(0) | a => is_range_expr(a) | <->
                     !is_rng_ce | unify::unify(ctx, a0.ut, unify::prim_int!)
               ti = unify::type_info_from_utype(ctx, index_ret_ut')
               lay = layout::compute_layout(ctx, index_ret_ut')
               tast::mk_typed_call(ce.fn_name, target_val', typed_args,
                 index_ret_ut', ti, lay, ce.line, ce.col)
            |
               ret_ut = is_poison_callee | unify::poison_utype! | unify::fresh_var(ctx)
               c_fn = unify::canon(ctx, fn_ut')
               is_fn_var = c_fn [Var]
               !is_poison_callee
                  |
                     is_fn_var
                        | unify::add_call_constraint(ctx, fn_ut', arg_uts, ret_ut)
                        |
                           c_fn
                              [Fn f_sig]
                                 is_gen_fn = ce.fn_name != "" && <>(type_env::lookup_generic(env, ce.fn_name))
                                 is_gen_fn && ?arg_uts < ?f_sig.params
                                    |
                                       all_tail_vars' = <+>
                                       (?arg_uts..?f_sig.params) @ ti_k =>
                                          p_k = unify::canon(ctx, f_sig.params(ti_k)!!)
                                          !(p_k [Var]) | (all_tail_vars' = <->)
                                       all_tail_vars'
                                          |
                                             (?arg_uts..?f_sig.params) @ ti_m =>
                                                typed_args += tast::mk_lit_unit(ce.line, ce.col)
                                                arg_uts += unify::prim_unit!
                                 ?arg_uts @ ai =>
                                    ai < ?f_sig.params
                                       |
                                          p_exp = f_sig.params(ai) | _ | unify::UType(None)
                                          a_ut = arg_uts(ai) | _ | unify::UType(None)
                                          (is_integerish_ut(ctx, p_exp) && is_flag_ut(ctx, a_ut))
                                             |
                                                arg_uts(ai) = p_exp !| _
                           expected_fn = unify::mk_fn(arg_uts, ret_ut)
                           ok = unify::unify(ctx, fn_ut', expected_fn)
                           !ok
                              |
                                 decl_loc = find_decl_loc_str(cur_program_exprs, call_fn_name')
                                 decl_part = decl_loc != ""
                                    | " for '${call_fn_name'}' (declared at ${decl_loc})"
                                    | (call_fn_name' != "" | " for '${call_fn_name'}'" | "")
                                 unify::add_error(ctx, 3084,
                                   "Function call signature mismatch${decl_part}: expected ${unify::show_utype(ctx, fn_ut')}, got ${unify::show_utype(ctx, expected_fn)}")
                                 unify::canon(ctx, ret_ut) [Var]
                                    | unify::unify(ctx, ret_ut, unify::poison_utype!)
               ti = unify::type_info_from_utype(ctx, ret_ut)
               lay = layout::compute_layout(ctx, ret_ut)
               tast::mk_typed_call(call_fn_name', target_val', typed_args,
                 ret_ut, ti, lay, ce.line, ce.col)

annotate_fn: unify::Ctx, type_env::TypeEnv, ast::FnExpr, <> => tast::TypedExpr
annotate_fn = ctx, env, fe, is_disc =>
   saved_fn_line = ctx.cur_line
   saved_fn_col = ctx.cur_col
   fe.line > 0 | unify::set_pos(ctx, fe.line, fe.col)
   lam_line = fe.line > 0 | fe.line | ctx.cur_line
   lam_col = fe.col > 0 | fe.col | ctx.cur_col
   type_env::enter_scope(env)
   saved_in_fn = env.in_fn
   saved_fn_ret = env.cur_fn_ret
   saved_init = type_env::init_snapshot(env)
   env.in_fn = <+>
   is_exp_poison = cur_expected_ut | u => unify::is_poison(ctx, u) | <->
   exp_fn_opt = cur_expected_ut
      | u =>
         c = unify::canon(ctx, u)
         c [Fn exp_f] <+ exp_f +> | <-->
      | <-->
   exp_ret_ut = is_exp_poison
      | <+ unify::poison_utype! +>
      | (exp_fn_opt | ef => <+ ef.ret +> | <-->)
   ret_var = is_exp_poison
      | unify::poison_utype!
      |
         is_disc
            | unify::prim_unit!
            |
               v = unify::fresh_var(ctx)
               exp_ret_ut | er => unify::unify(ctx, v, er)
               v
   env.cur_fn_ret = <+ ret_var +>
   env.init = type_env::new_init!
   param_uts = unify::UTypes()
   ?fe.params @ i =>
      pname = fe.params(i) | _ | ""
      p_exp = exp_fn_opt
         | ef =>
            i < ?ef.params | <+ ef.params(i)!! +> | <-->
         | <-->
      p_var = is_exp_poison | unify::poison_utype! | unify::fresh_var(ctx)
      !is_exp_poison
         | (p_exp | pe => unify::unify(ctx, p_var, pe))
      param_uts += p_var
      ti_p = unify::type_info_from_utype(ctx, p_var)
      type_env::bind_local(env, pname, p_var, ti_p, <->)
      pname != "" | type_env::init_mark_whole(env, pname)
   env.discard_result = is_disc
   fn_captures_view(fe)
      | unify::add_error(ctx, 3150, diag::E3150_view_escape_frame!)
   saved_views = ++view_vars
   view_vars ::= ast::Names()
   saved_exp = cur_expected_ut
   cur_expected_ut ::= exp_ret_ut
   check_no_closing_return(ctx, fe.body)
   body_te = annotate_expr(ctx, env, fe.body)
   is_view_expr(fe.body)
      | unify::add_error(ctx, 3150, diag::E3150_view_escape_frame!)
   view_vars ::= saved_views
   cur_expected_ut ::= saved_exp
   type_env::init_restore(env, saved_init)
   env.in_fn = saved_in_fn
   env.cur_fn_ret = saved_fn_ret
   type_env::leave_scope(env)
   !is_disc && !expr_is_jump(body_te)
      | unify::unify(ctx, ret_var, body_te.ut)
   ret_ut = is_disc | unify::prim_unit! | ret_var
   fn_ut = unify::mk_fn(param_uts, ret_ut)
   ti = unify::type_info_from_utype(ctx, fn_ut)
   ctx.cur_line = saved_fn_line
   ctx.cur_col = saved_fn_col
   mk_lambda_te_at(fe.params, body_te, fn_ut, ti, lam_line, lam_col)

body_closing_return: ast::Expr => <ast::ReturnExpr|>
body_closing_return = e =>
   e
      [Return r] <+ r +>
      [Block b]
         n = ?b
         n > 0 | body_closing_return(b(n - 1)!!) | <-->
      [Bin t]
         t.0 [Seq] body_closing_return(t.2) | <-->
      | <-->

check_no_closing_return: unify::Ctx, ast::Expr => ()
check_no_closing_return = ctx, body =>
   body_closing_return(body) | r =>
      r.line > 0 | unify::set_pos(ctx, r.line, r.col)
      unify::add_error(ctx, 3173,
        "Closing '--|' at the end of a function is prohibited; '--|' is only for early return.")

expr_is_jump: tast::TypedExpr => <>
expr_is_jump = te =>
   te.kind
      [CycleJump] <+>
      [Return] <+>
      [Exit] <+>
      [Block b]
         n = ?b
         n > 0
            |
               last = b(n - 1) | _ | tast::mk_lit_unit(0, 0)
               expr_is_jump(last)
            | <->
      | <->

is_error_ut: unify::Ctx, unify::UType => <>
is_error_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Error]) | <->

is_ram_pn_ut: unify::Ctx, unify::UType => <unify::UType|>
is_ram_pn_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Ram r]
         (r.pos.has_payload && !r.neg.has_payload)
            | <+ r.pos.ut +>
            | <-->
      | <-->

choice_check_ram_pn: unify::Ctx, tast::TypedBranches => <unify::UType|>
choice_check_ram_pn = ctx, tb_list =>
   all_pn' = <+>
   has_non_jump' = <->
   cand_pos = unify::fresh_var(ctx)
   tb_list @ tb =>
      is_jump = expr_is_jump(tb.body) || is_error_ut(ctx, tb.body.ut)
      !is_jump
         |
            has_non_jump' = <+>
            pn_opt = is_ram_pn_ut(ctx, tb.body.ut)
            pn_opt
               | pay_ut =>
                  ok = unify::unify(ctx, cand_pos, pay_ut)
                  !ok
                     |
                        unify::add_error(ctx, 3084,
                          diag::E3084_choice_branch_mismatch!)
                        all_pn' = <->
                        -->
               |
                  all_pn' = <->
                  -->
   has_non_jump' && all_pn'
      | <+ cand_pos +>

is_ram_np_ut: unify::Ctx, unify::UType => <unify::UType|>
is_ram_np_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Ram r]
         (!r.pos.has_payload && r.neg.has_payload)
            | <+ r.neg.ut +>
            | <-->
      | <-->

choice_check_ram_np: unify::Ctx, tast::TypedBranches => <unify::UType|>
choice_check_ram_np = ctx, tb_list =>
   all_np' = <+>
   has_non_jump' = <->
   cand_neg = unify::fresh_var(ctx)
   tb_list @ tb =>
      is_jump = expr_is_jump(tb.body) || is_error_ut(ctx, tb.body.ut)
      !is_jump
         |
            has_non_jump' = <+>
            np_opt = is_ram_np_ut(ctx, tb.body.ut)
            np_opt
               | pay_ut =>
                  ok = unify::unify(ctx, cand_neg, pay_ut)
                  !ok
                     |
                        unify::add_error(ctx, 3084,
                          diag::E3084_choice_branch_mismatch!)
                        all_np' = <->
                        -->
               |
                  all_np' = <->
                  -->
   has_non_jump' && all_np'
      | <+ cand_neg +>

choice_branch_is_constant: ast::Expr => <>
choice_branch_is_constant = e =>
   e
      [Int] <+>
      [Float] <+>
      [Str] <+>
      [Rune] <+>
      [Variant v] ?v.args == 0
      [Block b]
         ?b == 1
            | choice_branch_is_constant(b(0)!!)
            | <->
      [Fn fe] choice_branch_is_constant(fe.body)
      | <->

choice_has_constant_branch: ast::ChoiceExpr => <>
choice_has_constant_branch = c =>
   has' = <->
   c.branches @ br =>
      choice_branch_is_constant(br.block) | (has' = <+>; -->)
   has'

bare_enum_label: String => String
bare_enum_label = s =>
   n = ?s
   res' = s
   n @ i =>
      (i + 1 < n && s(i) == ': && s(i + 1) == ':)
         | res' = s(i + 2..n)
   res'

enum_branches_has_bare: ast::Branches => <>
enum_branches_has_bare = branches =>
   has' = <->
   branches @ br =>
      br.kind [Bare] (has' = <+>; -->)
   has'

enum_branches_cover_label: ast::Branches, String => <>
enum_branches_cover_label = branches, label =>
   found' = <->
   branches @ br =>
      br.kind
         [Variant]
            br.variant_names @ vn_raw =>
               vn = bare_enum_label(vn_raw)
               vn == label | (found' = <+>; -->)
            found' | -->
   found'

enum_branches_missing: unify::UEnumVariants, ast::Branches => String
enum_branches_missing = variants, branches =>
   enum_branches_has_bare(branches)
      | ""
      |
         missing' = ++""
         variants @ v =>
            v.label != "" && !enum_branches_cover_label(branches, v.label)
               |
                  missing' = missing' == "" | ++v.label | missing' + ", " + v.label
         missing'

range_to_cmp_ast: ast::RangeExpr => ast::Expr
range_to_cmp_ast = r =>
   u = ast::Expr(Var, "_")
   rhs_op = r.is_inclusive | ast::BinaryOp(NotGt) | ast::BinaryOp(Lt)
   r.has_lhs && r.has_rhs
      |
         c1 = ast::Expr(Bin, (ast::BinaryOp(NotLt), u, r.lhs))
         c2 = ast::Expr(Bin, (rhs_op, u, r.rhs))
         ast::Expr(Bin, (ast::BinaryOp(And), c1, c2))
      |
         r.has_lhs
            | ast::Expr(Bin, (ast::BinaryOp(NotLt), u, r.lhs))
            |
               r.has_rhs
                  | ast::Expr(Bin, (rhs_op, u, r.rhs))
                  | ast::Expr(Variant, (ast::Tag(Positive), ast::Exprs()))

all_tb_unit: unify::Ctx, tast::TypedBranches => <>
all_tb_unit = ctx, tb_list =>
   all_u' = <+>
   tb_list @ tb =>
      is_jump = expr_is_jump(tb.body) || is_error_ut(ctx, tb.body.ut)
      !is_jump
         |
            c_b = unify::canon(ctx, tb.body.ut)
            is_u = c_b [Prim p] (p [Unit]) | <->
            !is_u | (all_u' = <->; -->)
   all_u'

choice_cond_has_member: ast::Expr => <>
choice_cond_has_member = e =>
   e
      [Call c] c.fn_name == "#has_member"
      [Unary u] choice_cond_has_member(u.1)
      [Bin b] choice_cond_has_member(b.1) || choice_cond_has_member(b.2)
      | <->

/// Evaluates a compile-time integer expression when statically known (e.g. loop index, `m.idx`, `#arity T`).
eval_static_int_expr: unify::Ctx, type_env::TypeEnv, ast::Expr => <Int|>
eval_static_int_expr = ctx, env, e =>
   e
      [Int n] <+ n +>
      [Var v]
         lookup_ct_int(v)
            | ci => <+ ci +>
            |
               lookup_ct_val(v)
                  | ctv =>
                     ctv.te.kind [LitInt n] <+ n +> | <-->
                  | <-->
      [Unary u]
         u.0 [Neg]
            (eval_static_int_expr(ctx, env, u.1) | x => <+ 0 - x +> | <-->)
            | <-->
      [Bin b]
         eval_static_int_expr(ctx, env, b.1)
            | l =>
               eval_static_int_expr(ctx, env, b.2)
                  | r =>
                     b.0
                        [Add] <+ l + r +>
                        [Sub] <+ l - r +>
                        [Mul] <+ l * r +>
                        [Div] (r != 0 | <+ l / r +> | <-->)
                        | <-->
                  | <-->
            | <-->
      [Member m]
         m.is_module_access
            | <-->
            |
               cur_v = m.target [Var cv] cv | ""
               m.field_name == "idx" && cur_v != ""
                  |
                     lookup_ct_cursor(cur_v) | cur => <+ cur.idx +> | <-->
                  |
                     m.field_name == "#type_arity"
                        |
                           rt = resolve_type_expr_ut_ti(ctx, env, "", m.target)
                           !rt.2 | --| <-->
                           c_rt = unify::canon(ctx, rt.0)
                           c_rt
                              [Rec flds] <+ ?flds +>
                              [Enum ue]
                                 ?ue.variants > 0
                                    | <+ ?ue.variants +>
                                    | ue.name != ""
                                       |
                                          type_env::lookup_user_type(env, ue.name)
                                             | ude =>
                                                c_ude = unify::canon(ctx, ude.ut)
                                                c_ude [Enum ur] <+ ?ur.variants +> | <-->
                                             | <-->
                                       | <-->
                              | <-->
                        | <-->
      | <-->

try_eval_static_choice_flag: unify::Ctx, type_env::TypeEnv, ast::Expr => (<>, <>)
try_eval_static_choice_flag = ctx, env, cond_e =>
   cond_e
      [Call ce]
         ce.fn_name == "#has_member" && ?ce.args == 2
            |
               m_info = ce.args(1)!!
                  [Str s] (s, <+>)
                  [Var v] (v, <+>)
                  | ("", <->)
               m_info.1
                  | try_eval_has_member(ctx, env, ce.args(0)!!, m_info.0)
                  | (<->, <->)
            |
               ?ce.args == 1
                  |
                     pred = ce.fn_name != ""
                        | type_pred_name_from_str(ce.fn_name)
                        | type_pred_name_from_expr(ce.fn_target)
                     is_allowed_type_pred_call(env, ce, pred)
                        |
                           rt = resolve_type_expr_ut_ti(ctx, env, "", ce.args(0)!!)
                           rt.2
                              | (eval_utype_predicate(ctx, pred, rt.0), <+>)
                              | (<->, <->)
                        | (<->, <->)
                  | (<->, <->)
      [Variant ve]
         ?ve.args == 0
            | ve.tag_name [Positive] (<+>, <+>) [Negative] (<->, <+>) | (<->, <->)
            | (<->, <->)
      [Unary u]
         u.0
            [Not]
               inner = try_eval_static_choice_flag(ctx, env, u.1)
               inner.1 | (!inner.0, <+>) | (<->, <->)
            | (<->, <->)
      [Bin b]
         b.0
            [And]
               lf = try_eval_static_choice_flag(ctx, env, b.1)
               !lf.1
                  | (<->, <->)
                  | !lf.0
                     | (<->, <+>)
                     | try_eval_static_choice_flag(ctx, env, b.2)
            [Or]
               lf = try_eval_static_choice_flag(ctx, env, b.1)
               !lf.1
                  | (<->, <->)
                  | lf.0
                     | (<+>, <+>)
                     | try_eval_static_choice_flag(ctx, env, b.2)
            [Eq, NotEq]
               rt1 = resolve_type_expr_ut_ti(ctx, env, "", b.1)
               rt2 = resolve_type_expr_ut_ti(ctx, env, "", b.2)
               (rt1.2 && rt2.2)
                  |
                     eq = utype_eq(ctx, rt1.0, rt2.0)
                     --| (b.0 [Eq] eq | !eq, <+>)
               eval_static_int_expr(ctx, env, b.1)
                  | l =>
                     eval_static_int_expr(ctx, env, b.2)
                        | r =>
                           eq_i = l == r
                           (b.0 [Eq] eq_i | !eq_i, <+>)
                        | (<->, <->)
                  | (<->, <->)
            [Lt, Gt, NotGt, NotLt]
               eval_static_int_expr(ctx, env, b.1)
                  | l =>
                     eval_static_int_expr(ctx, env, b.2)
                        | r =>
                           cmp = b.0
                              [Lt] l < r
                              [Gt] l > r
                              [NotGt] l !< r
                              [NotLt] l !> r
                              | <->
                           (cmp, <+>)
                        | (<->, <->)
                  | (<->, <->)
            | (<->, <->)
      | (<->, <->)

parse_pos_int_digits: String, Int, Int, Int => <Int|>
parse_pos_int_digits = s, i, end_i, acc =>
   i !< end_i
      | <+ acc +>
      |
         ch = s(i)
         ch ['0...'9]
            | parse_pos_int_digits(s, i + 1, end_i, acc * 10 + (ch - '0))
            | <-->

extract_child_ti = ctx, env, parent_ti, slot_idx, fallback_ut =>
   eff_ti = resolve_ct_ti_aliases(env, parent_ti)
   eff2 = eff_ti
      [TypeVar tv]
         type_env::lookup_user_type(env, tv)
            | u => u.ti
            | lookup_user_type_any_mod(env, tv) | u2 => u2.ti | eff_ti
      | eff_ti
   raw_ti = eff2
      [Ram r]
         slot_idx == 0 && r.0.has_payload
            | r.0.payload_record
            | r.1.has_payload
               | r.1.payload_record
               | unify::type_info_from_utype(ctx, fallback_ut)
      [Array a] a.1
      [Rec r]
         r.0(slot_idx)
            | f => f.rec_type
            | unify::type_info_from_utype(ctx, fallback_ut)
      [Map m]
         slot_idx == 0
            | ast::TypeInfo(Prim, m.0)
            | m.2
      | unify::type_info_from_utype(ctx, fallback_ut)
   is_unk = raw_ti
      [Prim p] p [Unknown]
      | <->
   is_unk
      | unify::type_info_from_utype(ctx, fallback_ut)
      | raw_ti

resolve_fixed_type_ut: type_env::TypeEnv, String => <unify::UType|>
resolve_fixed_type_ut = env, bname =>
   bname
      ["()", "Unit"] <+ unify::prim_unit! +>
      ["Flag", "Bool"] <+ unify::prim_flag! +>
      ["Char"] <+ unify::prim_rune! +>
      |
         cast_opt = type_name_to_uprim(bname)
         cast_opt
            | up => <+ unify::UType(Prim, up) +>
            |
               ut_opt = type_env::lookup_user_type(env, bname)
               ut_opt2 = <>(ut_opt) | ut_opt | lookup_user_type_any_mod(env, bname)
               ut_opt2
                  | udef => <+ udef.ut +>
                  | <-->

add_type_bind_opt: unify::Ctx, type_env::TypeEnv, ast::Names, Int,
  unify::UType, ast::TypeInfo, CtTypeBinds => <>
add_type_bind_opt = ctx, env, bind_vars, b_i, ut, parent_ti, out =>
   b_i !< ?bind_vars | --| <+>
   bn = bind_vars(b_i)!!
   bn == "" || bn == "_" | --| <+>
   fx_opt = resolve_fixed_type_ut(env, bn)
   fx_opt
      | fx_ut => utype_eq(ctx, ut, fx_ut)
      |
         cti = extract_child_ti(ctx, env, parent_ti, b_i, ut)
         out += CtTypeBind(bn, ut, cti, "")
         <+>

match_type_name_pattern: unify::Ctx, type_env::TypeEnv, unify::UType, String => <>
match_type_name_pattern = ctx, env, c_ut, vn =>
   pred = type_pred_name_from_str(vn)
   pred != "" | --| eval_utype_predicate(ctx, pred, c_ut)
   vn
      ["Record", "Rec"] c_ut [Rec]
      ["Enum"] c_ut [Enum]
      ["Array"] c_ut [Array]
      ["Slice"] c_ut [Slice]
      ["Map"] c_ut [Map]
      ["Fn"] c_ut [Fn]
      ["Flag", "Bool"]
         c_ut [Prim p] (p [Flag]) | <->
      ["Char"]
         c_ut [Prim p] (p [Rune]) | <->
      |
         rt = resolve_type_name_ut_ti(ctx, env, "", vn)
         rt.2 && utype_eq(ctx, c_ut, rt.0)

match_type_pat_tag: unify::Ctx, type_env::TypeEnv, unify::UType,
  ast::TypeInfo, String, ast::Names, CtTypeBinds => <>
match_type_pat_tag = ctx, env, c_ut, cond_ti, tag, bind_vars, out =>
   tag
      ["#type:()"]
         (c_ut [Rec f] ?f == 0 | <->) || (c_ut [Prim p] p [Unit] | <->)
      ["#type:(..)"]
         c_ut [Rec f] ?f > 0 | <->
      ["#type:(*..)"]
         c_ut
            [Rec flds]
               rec_all_fields_homogeneous(ctx, flds)
                  |
                     add_type_bind_opt(ctx, env, bind_vars, 0, flds(0)!!.ut,
                       cond_ti, out)
                  | <->
            | <->
      ["#type:<>"]
         (c_ut [Prim p] p [Flag] | <->) ||
           (c_ut [Ram r] (!r.pos.has_payload && !r.neg.has_payload) | <->)
      ["#type:<..>"]
         c_ut [Enum]
      ["#type:<P|>"]
         c_ut
            [Ram r]
               r.pos.has_payload && !r.neg.has_payload
                  |
                     add_type_bind_opt(ctx, env, bind_vars, 0, r.pos.ut,
                       cond_ti, out)
                  | <->
            | <->
      ["#type:<|N>"]
         c_ut
            [Ram r]
               !r.pos.has_payload && r.neg.has_payload
                  |
                     add_type_bind_opt(ctx, env, bind_vars, 0, r.neg.ut,
                       cond_ti, out)
                  | <->
            | <->
      ["#type:<P|N>"]
         c_ut
            [Ram r]
               r.pos.has_payload && r.neg.has_payload
                  |
                     add_type_bind_opt(ctx, env, bind_vars, 0, r.pos.ut,
                       cond_ti, out) &&
                       add_type_bind_opt(ctx, env, bind_vars, 1, r.neg.ut,
                         cond_ti, out)
                  | <->
            | <->
      ["#type:{}"]
         c_ut
            [Array a]
               add_type_bind_opt(ctx, env, bind_vars, 0, a.elem, cond_ti, out)
            | <->
      ["#type:[]"]
         c_ut
            [Slice s]
               add_type_bind_opt(ctx, env, bind_vars, 0, s, cond_ti, out)
            | <->
      ["#type:^"]
         c_ut
            [Map m]
               add_type_bind_opt(ctx, env, bind_vars, 0, m.key, cond_ti, out) &&
                 add_type_bind_opt(ctx, env, bind_vars, 1, m.val, cond_ti, out)
            | <->
      |
         ?tag > 9 && tag(0..8) == "#type:(*" && tag(?tag - 1) == ')
            |
               n_opt = parse_pos_int_digits(tag, 8, ?tag - 1, 0)
               n_opt
                  | exact_n =>
                     c_ut
                        [Rec flds]
                           ?flds == exact_n && exact_n > 0 &&
                             rec_all_fields_homogeneous(ctx, flds)
                              |
                                 add_type_bind_opt(ctx, env, bind_vars, 0,
                                   flds(0)!!.ut, cond_ti, out)
                              | <->
                        | <->
                  | <->
            | match_type_name_pattern(ctx, env, c_ut, tag)

match_type_choice_branch: unify::Ctx, type_env::TypeEnv, unify::UType,
  ast::TypeInfo, ast::ChoiceBranch => (<>, CtTypeBinds)
match_type_choice_branch = ctx, env, cond_ut, cond_ti, br =>
   c_ut = unify::canon(ctx, cond_ut)
   binds = CtTypeBinds()
   br.kind
      [Bare] (<+>, binds)
      [Variant]
         br.variant_names @ vn =>
            b_try = CtTypeBinds()
            match_type_pat_tag(ctx, env, c_ut, cond_ti, vn, br.bind_vars,
              b_try) | --| (<+>, b_try)
         (<->, binds)
      [Case]
         br.case_values @ cv =>
            pred = type_pred_name_from_expr(cv)
            pred != "" && eval_utype_predicate(ctx, pred, c_ut) | --| (<+>, binds)
            rt_cv = resolve_type_expr_ut_ti(ctx, env, "", cv)
            rt_cv.2 && utype_eq(ctx, c_ut, rt_cv.0) | --| (<+>, binds)
         ?br.case_values == 0
            |
               br.variant_names @ vn =>
                  match_type_name_pattern(ctx, env, c_ut, vn) | --| (<+>, binds)
         (<->, binds)
      [Predicate]
         pred = type_pred_name_from_expr(br.pred_fn)
         pred != "" && eval_utype_predicate(ctx, pred, c_ut) | (<+>, binds) | (<->, binds)
      | (<->, binds)

annotate_type_choice: unify::Ctx, type_env::TypeEnv, unify::UType,
  ast::TypeInfo, ast::ChoiceExpr, <>, <unify::UType|> => tast::TypedExpr
annotate_type_choice = ctx, env, cond_ut, cond_ti, ch, is_disc, saved_exp =>
   ch.branches @ br =>
      mres = match_type_choice_branch(ctx, env, cond_ut, cond_ti, br)
      mres.0
         |
            saved_ct_n = ?cur_ct_types
            mres.1 @ b => push_ct_type(b.name, b.ut, b.ti, b.dtype)
            cur_expected_ut ::= saved_exp
            env.discard_result = is_disc
            res_te = annotate_expr(ctx, env, br.block)
            pop_ct_types_to(saved_ct_n)
            --| res_te
   unify::add_error(ctx, 3084,
     "Non-exhaustive type choice for '" + unify::show_utype(ctx, cond_ut) + "'.")
   tast::mk_lit_unit(0, 0)

annotate_choice: unify::Ctx, type_env::TypeEnv,
  ast::ChoiceExpr, <> => tast::TypedExpr
annotate_choice = ctx, env, ch, is_disc =>
   saved_choice_exp = cur_expected_ut
   cur_expected_ut ::= <-->
   all_bare' = ?ch.branches == 1 || ?ch.branches == 2
   ch.branches @ br_b =>
      !(br_b.kind [Bare]) | (all_bare' = <->; -->)
   all_bare'
      |
         sf = try_eval_static_choice_flag(ctx, env, ch.cond)
         sf.1
            |
               ?ch.branches == 2
                  |
                     cur_expected_ut ::= saved_choice_exp
                     env.discard_result = is_disc
                     taken_br = ch.branches(sf.0 | 0 | 1)!!
                     --| annotate_expr(ctx, env, taken_br.block)
                  | is_disc || choice_cond_has_member(ch.cond)
                     |
                        cur_expected_ut ::= saved_choice_exp
                        env.discard_result = is_disc
                        --| sf.0
                           | annotate_expr(ctx, env, (ch.branches(0)!!).block)
                           | tast::mk_lit_unit(0, 0)
   is_disc && choice_has_constant_branch(ch)
      |
         unify::add_error(ctx, 3175, diag::E3175_choice_const_discarded!)
   ch.cond
      [Var v]
         bnd_opt = type_env::lookup_binding(env, "_")
         has_bnd = <>(bnd_opt)
         v == "_" && !has_bnd
            |
               unify::add_error(ctx, 3003, diag::E3003_choice_underscore_undefined!)
   !all_bare'
      |
         ct_scrut_opt = ch.cond
            [Var v]
               lookup_ct_type(v) | ctb => <+ (ctb.ut, ctb.ti) +> | <-->
            [Member m]
               !m.is_module_access && m.field_name == ""
                  |
                     rt_m = resolve_type_expr_ut_ti(ctx, env, "", ch.cond)
                     b0_is_str = ?ch.branches > 0
                        |
                           b0_cvs = ch.branches(0)!!.case_values
                           ?b0_cvs > 0 && (b0_cvs(0)!! [Str])
                        | <->
                     (rt_m.2 && !b0_is_str) | <+ (rt_m.0, rt_m.1) +> | <-->
                  |
                     cur_v_c = m.target [Var cv] cv | ""
                     (cur_v_c != "" && m.field_name ["type", "Type"])
                        | lookup_ct_cursor(cur_v_c) | cur => <+ (cur.field_ut, cur.field_ti) +> | <-->
                        | <-->
            | <-->
         ct_scrut_opt
            | cs => --| annotate_type_choice(ctx, env, cs.0, cs.1, ch, is_disc, saved_choice_exp)
   cond_te = annotate_expr(ctx, env, ch.cond)
   c_cond0 = unify::canon(ctx, cond_te.ut)
   is_type_scrut = c_cond0 [Prim p] p [Type] | <->
   is_type_scrut
      |
         rt_scrut = resolve_type_expr_ut_ti(ctx, env, "", ch.cond)
         has_ti_scrut = rt_scrut.2
            | (rt_scrut.0, rt_scrut.1, <+>)
            | !(cond_te.ti [Prim pt] pt [Type, Unknown] | <->)
               | (utype_from_ti_env(env, cond_te.ti), cond_te.ti, <+>)
               | (unify::UType(None), cond_te.ti, <->)
         has_ti_scrut.2
            | --| annotate_type_choice(ctx, env, has_ti_scrut.0, has_ti_scrut.1,
              ch, is_disc, saved_choice_exp)
   is_synth_extract = ?ch.branches == 1 && ch.is_exhaustive
   missing_enum_labels' = ++""
   is_exhaustive' = ch.is_exhaustive
   c_cond0
      [Enum uenum0_raw]
         uenum0' = uenum0_raw
         ?uenum0'.variants == 0 && uenum0'.name != ""
            |
               ut_opt0 = type_env::lookup_user_type(env, uenum0'.name)
               ut_opt0
                  | udef0 =>
                     c_udef0 = unify::canon(ctx, udef0.ut)
                     c_udef0
                        [Enum ue0_res] (uenum0' = ue0_res)
         !is_synth_extract
            |
               missing_enum_labels' = enum_branches_missing(uenum0'.variants, ch.branches)
               is_exhaustive' = missing_enum_labels' == ""
   tb_list = tast::TypedBranches()
   res_ut = unify::fresh_var(ctx)
   init_pre = type_env::init_snapshot(env)
   init_merged' = type_env::new_init!
   has_merged' = <->
   num_joins' = 0
   ch.branches @ br, i =>
      type_env::init_restore(env, type_env::init_snapshot_of(init_pre))
      c_cond = unify::canon(ctx, cond_te.ut)
      payload_ut' = unify::fresh_var(ctx)
      has_pay' = <->
      is_unit_slot' = <->
      br_kind' = br.kind
      c_cond
         [Ram r]
            i == 0
               |
                  r.0.has_payload
                     | (payload_ut' = r.0.ut; has_pay' = <+>)
                     | (is_unit_slot' = <+>)
               |
                  r.1.has_payload
                     | (payload_ut' = r.1.ut; has_pay' = <+>)
                     | (is_unit_slot' = <+>)
         [Enum uenum_raw]
            uenum' = uenum_raw
            ?uenum'.variants == 0 && uenum'.name != ""
               |
                  ut_opt_e = type_env::lookup_user_type(env, uenum'.name)
                  ut_opt_e
                     | udef_e =>
                        c_udef = unify::canon(ctx, udef_e.ut)
                        c_udef
                           [Enum ue_res] (uenum' = ue_res)
            enum_disp = uenum'.name != "" | bare_enum_label(uenum'.name) |
               (cond_te.ti [TypeVar tv] bare_enum_label(tv) | "enum")
            def_ev = unify::UEnumVariant("", <->, unify::UType(None))
            is_var_br = br.kind [Variant]
            is_var_br
               |
                  n_ev = ?uenum'.variants
                  n_ev == 0
                     |
                        nbv = ?br.bind_vars
                        has_pay' = nbv != 0
                     |
                        br.variant_names @ vn_raw, vn_i =>
                           vname = bare_enum_label(vn_raw)
                           found_v' = <->
                           uenum'.variants @ v =>
                              v.label == vname
                                 |
                                    found_v' = <+>
                                    vn_i == 0
                                       |
                                          v.has_payload
                                             | (payload_ut' = v.payload_type; has_pay' = <+>)
                                             | (is_unit_slot' = <+>)
                                    -->
                           !found_v'
                              |
                                 unify::add_error(ctx, 3096,
                                   diag::enum_no_variant(enum_disp, vname))
                        is_unit_slot'
                           |
                              br.bind_vars @ bv_chk =>
                                 bv_chk != "" && bv_chk != "_"
                                    |
                                       v0_lbl = bare_enum_label(br.variant_names(0) | _ | "")
                                       unify::add_error(ctx, 3098,
                                         diag::enum_unit_payload(enum_disp, v0_lbl))
                                       -->
               |
                  i == 0 && (br.kind [Bare])
                     |
                        unify::add_error(ctx, 3084,
                          "Bare '|' condition requires Flag or ramification, got " +
                          enum_disp)
                  is_unit_slot' = <+>
         |
            is_bare = br.kind [Bare]
            is_bare
               |
                  is_b0_bare = ?ch.branches > 0 && ((ch.branches(0)!!).kind [Bare])
                  is_b0_bare
                     |
                        i == 0
                           |
                              is_flg = c_cond [Prim p] (p [Flag, Unknown]) | (c_cond [Var])
                              !is_flg
                                 |
                                    unify::add_error(ctx, 3084,
                                      "Bare '|' condition requires Flag or ramification, got " +
                                      unify::show_utype(ctx, c_cond))
                        is_unit_slot' = <>(type_env::lookup_binding(env, "_"))
                        payload_ut' = cond_te.ut
                     |
                        payload_ut' = cond_te.ut
               |
                  is_unit_slot' = <+>
                  is_var_br = br.kind [Variant]
                  is_var_cond = c_cond [Var]
                  is_type_cond = c_cond [Prim p] (p [Type]) | <->
                  is_var_br && !is_var_cond && !is_type_cond
                     |
                        has_named_bind' = <->
                        br.bind_vars @ bv_chk =>
                           bv_chk != "" && bv_chk != "_" | (has_named_bind' = <+>)
                        has_named_bind'
                           |
                              unify::add_error(ctx, 3084,
                                "Variant pattern guard cannot be applied to non-enum type " +
                                unify::show_utype(ctx, c_cond))
                           | (br_kind' = ast::GuardKind(Case))
      typed_cvs = tast::TypedExprs()
      br.case_values @ cv =>
         cv
            [Range r]
               type_env::enter_scope(env)
               type_env::bind_local(env, "_", cond_te.ut, cond_te.ti, <->)
               type_env::init_mark_whole(env, "_")
               cmp_te = annotate_expr(ctx, env, range_to_cmp_ast(r))
               type_env::leave_scope(env)
               pnames = ast::Names()
               pnames += "_"
               put_list = unify::UTypes()
               put_list += cond_te.ut
               fn_ut = unify::UType(Fn, (put_list, unify::prim_flag!))
               fn_ti = unify::type_info_from_utype(ctx, fn_ut)
               typed_cvs += mk_lambda_te(pnames, cmp_te, fn_ut, fn_ti)
            |
               cv_te = annotate_expr(ctx, env, partial_app_closure(env, cv))
               typed_cvs += cv_te
               c_cv = unify::canon(ctx, cv_te.ut)
               c_cv
                  [Fn f_cv]
                     ?f_cv.params > 0
                        |
                           p0_cv = f_cv.params(0) | _ | unify::UType(None)
                           unify::unify(ctx, cond_te.ut, p0_cv)
                        | unify::unify(ctx, cond_te.ut, cv_te.ut)
                  | unify::unify(ctx, cond_te.ut, cv_te.ut)
      (?br.case_values == 0 && (br_kind' [Case]) && ?br.variant_names > 0)
         |
            br.variant_names @ vn_str =>
               cv_te = annotate_expr(ctx, env, ast::Expr(Var, vn_str))
               typed_cvs += cv_te
               unify::unify(ctx, cond_te.ut, cv_te.ut)
      is_pred = br_kind' [Predicate]
      pred_opt = is_pred
         |
            pred_te = annotate_expr(ctx, env, br.pred_fn)
            c_pred = unify::canon(ctx, pred_te.ut)
            c_pred
               [Fn f_pred]
                  ?f_pred.params > 0
                     |
                        p0 = f_pred.params(0) | _ | unify::UType(None)
                        unify::unify(ctx, cond_te.ut, p0)
            <+ pred_te +>
         | <-->
      type_env::enter_scope(env)
      cur_bind_vars = br.bind_vars
      pay_ti = unify::type_info_from_utype(ctx, payload_ut')
      !is_unit_slot'
         |
            type_env::bind_local(env, "_", payload_ut', pay_ti, <->)
      br.bind_vars @ bv =>
         bv != "" && bv != "_"
            |
               type_env::bind_local(env, bv, payload_ut', pay_ti, <->)
               type_env::init_mark_whole(env, bv)
      env.discard_result = is_disc
      cur_expected_ut ::= saved_choice_exp
      body_te = has_pay'
         |
            br.block
               [Fn fe]
                  ?fe.params < 2
                     |
                        pname = fe.params(0) | _ | "_"
                        pname != "" && pname != "_"
                           |
                              type_env::bind_local(env, pname, payload_ut',
                                pay_ti, <->)
                              type_env::init_mark_whole(env, pname)
                              cur_bind_vars += pname
                        env.discard_result = is_disc
                        annotate_expr(ctx, env, fe.body)
                     |
                        env.discard_result = is_disc
                        annotate_expr(ctx, env, br.block)
               |
                  vname = br.block [Var v] v | ""
                  is_var_bare = br_kind' [Bare, Case, Variant] && vname != "" && vname != "_"
                  bnd_opt = is_var_bare
                     | type_env::lookup_binding(env, vname)
                     | <-->
                  is_fn_bnd = bnd_opt
                     | b =>
                        cb = unify::canon(ctx, b.ut)
                        cb [Fn]
                     | <->
                  gen_opt = is_var_bare
                     | type_env::lookup_generic(env, vname)
                     | <-->
                  is_gen = <>(gen_opt)
                  is_var_fn = is_var_bare && (is_fn_bnd || is_gen)
                  is_var_fn
                     |
                        type_env::bind_local(env, "_", payload_ut',
                          pay_ti, <->)
                        type_env::init_mark_whole(env, "_")
                        cargs = ast::Exprs()
                        cargs += ast::Expr(Var, "_")
                        call_e = ast::Expr(Call,
                          ast::CallExpr(vname, ast::Expr(Var, ""), cargs,
                            0, 0))
                        annotate_expr(ctx, env, call_e)
                     | annotate_expr(ctx, env, br.block)
         |
            env.discard_result = is_disc
            annotate_expr(ctx, env, br.block)
      cur_expected_ut ::= <-->
      type_env::leave_scope(env)
      is_jump = expr_is_jump(body_te) || is_error_ut(ctx, body_te.ut)
      !is_jump
         |
            has_merged'
               | init_merged' = type_env::init_merge_two(init_merged', env.init)
               |
                  init_merged' = type_env::init_snapshot(env)
                  has_merged' = <+>
            num_joins' = num_joins' + 1
            is_exhaustive' && !is_disc
               |
                  ok = unify::unify(ctx, res_ut, body_te.ut)
                  !ok
                     |
                        unify::add_error(ctx, 3084,
                          diag::E3084_choice_branch_mismatch!)
      tbr = tast::TypedBranch(br_kind', typed_cvs, pred_opt,
        br.variant_names, cur_bind_vars, body_te)
      tb_list += tbr
   has_merged' | type_env::init_restore(env, init_merged')
   final_ut' = unify::prim_unit!
   is_exhaustive' && !is_disc && num_joins' > 0
      | (final_ut' = res_ut)
      |
         !is_exhaustive' && !is_disc && num_joins' > 0
            |
               pn_check = choice_check_ram_pn(ctx, tb_list)
               pn_check
                  | pos_ut =>
                     ram_pn_ut = unify::ram_pn(pos_ut)
                     nb_br = ?ch.branches
                     last_br = ch.branches(nb_br - 1)
                     is_last_bare = last_br | br => br.kind [Bare] | <->
                     already_has_fb = nb_br > 1 && is_last_bare
                     !already_has_fb
                        |
                           fb_ti = unify::type_info_from_utype(ctx, ram_pn_ut)
                           fb_lay = layout::compute_layout(ctx, ram_pn_ut)
                           fb_te = tast::mk_typed_ram_construct(
                              unify::URamShape(RamPN), <->, <-->,
                              ram_pn_ut, fb_ti, fb_lay, 0, 0)
                           tbr_fb = tast::TypedBranch(ast::GuardKind(Bare),
                             tast::TypedExprs(), <-->, ast::Names(),
                             ast::Names(), fb_te)
                           tb_list += tbr_fb
                           ch.branches += ast::ChoiceBranch(
                              ast::GuardKind(Bare), ast::Exprs(),
                              ast::Expr(Var, "_"), ast::Names(), ast::Names(),
                              <->, ast::Expr(Variant, (ast::Tag(Noth),
                                ast::Exprs())))
                     final_ut' = ram_pn_ut
                  |
                     np_check = choice_check_ram_np(ctx, tb_list)
                     np_check
                        | neg_ut =>
                           ram_np_ut = unify::ram_np(neg_ut)
                           nb_br = ?ch.branches
                           last_br = ch.branches(nb_br - 1)
                           is_last_bare = last_br | br => br.kind [Bare] | <->
                           already_has_fb = nb_br > 1 && is_last_bare
                           !already_has_fb
                              |
                                 fb_ti = unify::type_info_from_utype(ctx, ram_np_ut)
                                 fb_lay = layout::compute_layout(ctx, ram_np_ut)
                                 fb_te = tast::mk_typed_ram_construct(
                                    unify::URamShape(RamNP), <+>, <-->,
                                    ram_np_ut, fb_ti, fb_lay, 0, 0)
                                 tbr_fb = tast::TypedBranch(ast::GuardKind(Bare),
                                   tast::TypedExprs(), <-->, ast::Names(),
                                   ast::Names(), fb_te)
                                 tb_list += tbr_fb
                                 ch.branches += ast::ChoiceBranch(
                                    ast::GuardKind(Bare), ast::Exprs(),
                                    ast::Expr(Var, "_"), ast::Names(), ast::Names(),
                                    <->, ast::Expr(Variant, (ast::Tag(Succ),
                                      ast::Exprs())))
                           final_ut' = ram_np_ut
                        |
                           missing_enum_labels' != "" && !all_tb_unit(ctx, tb_list)
                              |
                                 tb_list @ tb_item =>
                                    is_j = expr_is_jump(tb_item.body) || is_error_ut(ctx, tb_item.body.ut)
                                    !is_j
                                       |
                                          ok_u = unify::unify(ctx, res_ut, tb_item.body.ut)
                                          !ok_u
                                             |
                                                unify::add_error(ctx, 3084,
                                                  diag::E3084_choice_branch_mismatch!)
                                 unify::add_error(ctx, 3102,
                                   "Choice over an enum does not cover variants: " +
                                   missing_enum_labels' +
                                   " — add a branch for each or a trailing '|' fallback.")
                                 final_ut' = res_ut
   cur_expected_ut ::= saved_choice_exp
   ti = unify::type_info_from_utype(ctx, final_ut')
   lay = layout::compute_layout(ctx, final_ut')
   tast::mk_typed_expr(tast::TypedExprKind(Choice, (cond_te, tb_list)),
     final_ut', ti, lay, 0, 0)

annotate_record: unify::Ctx, type_env::TypeEnv,
  ast::RecordExpr => tast::TypedExpr
annotate_record = ctx, env, re =>
   tf_list' = tast::TypedFields()
   uf_list' = unify::UFields()
   pre_stmts = tast::TypedExprs()
   cur_off' = 0
   saved_rec_exp = cur_expected_ut
   exp_rec_fields = saved_rec_exp
      | exp_u =>
         ec = unify::canon(ctx, exp_u)
         ec [Rec efs] <+ efs +> | <-->
      | <-->
   re.fields @ f, i =>
      splat_opt = is_splat_expr(f.val)
      splat_opt
         | splat_rhs =>
            cur_expected_ut ::= <-->
            s_te = annotate_expr(ctx, env, splat_rhs)
            cur_expected_ut ::= saved_rec_exp
            s_c = unify::canon(ctx, s_te.ut)
            s_c
               [Rec s_fields]
                  is_s_var = s_te.kind [Var]
                  var_s_te = is_s_var
                     | s_te
                     |
                        splat_v = unify::fresh_var(ctx)
                        tmp_id = splat_v [Var id] id | 0
                        tmp_name = "__splat_arg_" + str::from_int(tmp_id)
                        type_env::bind_local(env, tmp_name, s_te.ut, s_te.ti, <->)
                        type_env::init_mark_whole(env, tmp_name)
                        as_kind = tast::TypedExprKind(Assign, (tmp_name, <->, <->, <->, <->, s_te))
                        as_te = tast::mk_typed_expr(as_kind, s_te.ut, s_te.ti, s_te.layout, 0, 0)
                        pre_stmts += as_te
                        tast::mk_typed_expr(tast::TypedExprKind(Var, (tmp_name, 0, <->)), s_te.ut, s_te.ti, s_te.layout, 0, 0)
                  splat_root = splat_rhs [Var v] v | ""
                  ?s_fields @ j =>
                     sf = s_fields(j) | _ |
                        unify::UField("", unify::UType(None))
                     splat_root != "" && type_env::init_is_tracked(env, splat_root) &&
                       !type_env::init_is_ok(env, splat_root + "." + sf.name)
                       |
                          unify::add_error(ctx, 3130,
                            "Field '" + sf.name + "' of '" + splat_root + "' read before init.")
                     sf_ti = unify::type_info_from_utype(ctx, sf.ut)
                     sf_lay = layout::compute_layout(ctx, sf.ut)
                     val_j = s_te.kind
                        [Record lit_fields]
                           j < ?lit_fields
                              | (lit_fields(j) | _ | tast::TypedField("",
                                tast::mk_lit_unit(0, 0), 0,
                                unify::prim_unit!)).val
                              | tast::mk_typed_expr(tast::TypedExprKind(Member,
                                (var_s_te, sf.name, j)), sf.ut, sf_ti, sf_lay, 0, 0)
                        | tast::mk_typed_expr(tast::TypedExprKind(Member,
                          (var_s_te, sf.name, j)), sf.ut, sf_ti, sf_lay, 0, 0)
                     tf = tast::TypedField(sf.name, val_j, cur_off', sf.ut)
                     tf_list' += tf
                     uf = unify::UField(sf.name, sf.ut)
                     uf_list' += uf
                     flay = layout::compute_layout(ctx, sf.ut)
                     f_align = flay.align < 1 | 1 | flay.align
                     cur_off' = layout::align_up(cur_off', f_align) + flay.size
               |
                  unify::add_error(ctx, 3084,
                    "Splat operator '..' requires a record operand")
         |
            field_exp = exp_rec_fields
               | efs =>
                  f.name != ""
                     |
                        f_idx = unify::find_field_idx(efs, f.name)
                        f_idx !< 0 | <+ efs(f_idx)!!.ut +> | <-->
                     |
                        cur_f_idx = ?uf_list'
                        cur_f_idx < ?efs | <+ efs(cur_f_idx)!!.ut +> | <-->
               | <-->
            cur_expected_ut ::= field_exp
            f_te = annotate_expr(ctx, env, f.val)
            cur_expected_ut ::= saved_rec_exp
            c_fte = unify::canon(ctx, f_te.ut)
            is_unit_fld = c_fte [Prim p_u] (p_u [Unit]) | <->
            is_unit_lit = f.val [Record r_u] (?r_u.fields == 0) | <->
            is_unit_fld && !is_unit_lit
               |
                  unify::add_error(ctx, 3084,
                    "Record field cannot have Unit type (non-exhaustive conditional elements require a growable array constructor)")
            tf = tast::TypedField(f.name, f_te, cur_off', f_te.ut)
            tf_list' += tf
            uf = unify::UField(f.name, f_te.ut)
            uf_list' += uf
            flay = layout::compute_layout(ctx, f_te.ut)
            f_align = flay.align < 1 | 1 | flay.align
            cur_off' = layout::align_up(cur_off', f_align) + flay.size
   rec_ut = unify::mk_rec(uf_list')
   ti = unify::type_info_from_utype(ctx, rec_ut)
   lay = layout::compute_layout(ctx, rec_ut)
   rec_te = tast::mk_typed_expr(tast::TypedExprKind(Record, tf_list'),
     rec_ut, ti, lay, 0, 0)
   ?pre_stmts > 0
      |
         block_exprs = pre_stmts
         block_exprs += rec_te
         tast::mk_typed_expr(tast::TypedExprKind(Block, block_exprs),
           rec_ut, ti, lay, 0, 0)
      | rec_te

annotate_member_write: unify::Ctx, type_env::TypeEnv,
  ast::MemberExpr, ast::Expr, <> => tast::TypedExpr
annotate_member_write = ctx, env, mm, val_expr, is_compound =>
   is_view_expr(val_expr)
      | unify::add_error(ctx, 3150, diag::E3150_view_escape_frame!)
   saved_lvalue = env.in_lvalue
   env.in_lvalue = <+>
   target_te = annotate_expr(ctx, env, mm.target)
   env.in_lvalue = saved_lvalue
   rhs = annotate_expr(ctx, env, val_expr)
   fname' = mm.field_name
   resolved_idx' = -1
   c_tgt_w = unify::canon(ctx, target_te.ut)
   c_tgt_w [Poison]
      --| tast::mk_typed_expr(tast::TypedExprKind(MemberWrite,
        (target_te, fname', -1, rhs)),
        unify::prim_unit!, ast::TypeInfo(Prim, ast::ValueType(Unit)), tast::layout_void!,
        mm.line, mm.col)
   fname' == ""
      |
         idx_w_opt = mm.index_expr
            [Int n] <+ n +>
            [Var v]
               lookup_ct_int(v)
                  | ci => <+ ci +>
                  | lookup_ct_cursor(v) | cur => <+ cur.idx +> | <-->
            | <-->
         idx_w_opt
            | n =>
               resolved_idx' = n
               c_tgt_w
                  [Rec rw]
                     n < 0 || n !< ?rw
                        | unify::add_error(ctx, 3171,
                          "Record field index ${n} out of range (0..${?rw - 1}).")
                        |
                           fn_n = rw(n)!!.name
                           fname' = fn_n != "" | fn_n | str::from_int(n)
                  | unify::add_error(ctx, 3084,
                    "'#member' write target must be a record value.")
            | unify::add_error(ctx, 3170, diag::member_index_constant!)
   root = member_root_str(mm.target)
   root != "" && fname' != ""
      |
         fpath = "${root}.${fname'}"
         type_env::init_mark_written(env, fpath)
         root_var = member_root_name(mm.target)
         !member_has_module_access(mm.target) &&
           !type_env::is_marked_global(env, root_var)
           | type_env::init_mark_tracked(env, root_var)
   fld_ut = unify::fresh_var(ctx)
   did_idx_fld = (resolved_idx' !< 0) && (c_tgt_w [Rec r_w] (resolved_idx' < ?r_w && (r_w(resolved_idx')!!).name == "") | <->)
   did_idx_fld
      |
         c_tgt_w [Rec r_w2] unify::unify(ctx, fld_ut, (r_w2(resolved_idx')!!).ut)
      |
         fname' != "" | unify::solve_field(ctx, target_te.ut, fname', fld_ut)
   is_compound
      |
         c_fld = unify::canon(ctx, fld_ut)
         c_fld
            [Prim p]
               is_bld = p [Builder]
               is_bld
                  |
                     c_rhs = unify::canon(ctx, rhs.ut)
                     ok_rhs' = <->
                     c_rhs
                        [Prim pr]
                           ok_rhs' = is_builder_append_prim(pr)
                        [Rec r]
                           ok_rhs' = is_builder_append_rec(ctx, r, 0, ?r)
                        [Var]
                           ok_rhs' = <+>
                     !ok_rhs'
                        |
                           unify::add_error(ctx, 3084,
                             diag::E3084_builder_append_type!)
                  |
                     fld_flag_int = is_flag_ut(ctx, fld_ut) &&
                       is_integerish_ut(ctx, rhs.ut)
                     ok = fld_flag_int || unify::unify(ctx, fld_ut, rhs.ut)
                     !ok
                        |
                           fld_msg = diag::field_assignment_type_mismatch_prefix! +
                             fname'
                           unify::add_error(ctx, 3084, fld_msg)
            [Array arr]
               ok = unify::unify(ctx, arr.elem, rhs.ut)
               !ok
                  |
                     unify::add_error(ctx, 3084,
                       "Type mismatch in array append to field: ${fname'}")
            |
               fld_flag_int = is_flag_ut(ctx, fld_ut) &&
                 is_integerish_ut(ctx, rhs.ut)
               ok = fld_flag_int || unify::unify(ctx, fld_ut, rhs.ut)
               !ok
                  |
                     fld_msg = diag::field_assignment_type_mismatch_prefix! +
                       fname'
                     unify::add_error(ctx, 3084, fld_msg)
      |
         fld_flag_int = is_flag_ut(ctx, fld_ut) &&
           is_integerish_ut(ctx, rhs.ut)
         ok = fld_flag_int || unify::unify(ctx, fld_ut, rhs.ut)
         !ok
            |
               fld_msg = diag::field_assignment_type_mismatch_prefix! +
                 fname'
               unify::add_error(ctx, 3084, fld_msg)
   c_tgt = unify::canon(ctx, target_te.ut)
   idx' = resolved_idx'
   c_tgt
      [Rec r]
         fname' != "" | (idx' = unify::find_field_idx(r, fname'))
   ti = unify::type_info_from_utype(ctx, unify::prim_unit!)
   lay = tast::layout_void!
   tast::mk_typed_expr(tast::TypedExprKind(MemberWrite,
     (target_te, fname', idx', rhs)),
     unify::prim_unit!, ti, lay, mm.line, mm.col)

annotate_index_write: unify::Ctx, type_env::TypeEnv,
  ast::CallExpr, ast::Expr => tast::TypedExpr
annotate_index_write = ctx, env, cc, val_expr =>
   is_view_expr(val_expr)
      | unify::add_error(ctx, 3150, diag::E3150_view_escape_frame!)
   has_dot = cc.fn_name != "" &&
     (find_last_dot(cc.fn_name, ?cc.fn_name - 1) | d => d > 0 | <->)
   tgt_expr = has_dot | dotted_to_expr(cc.fn_name) |
      (cc.fn_name != "" | ast::Expr(Var, cc.fn_name) | cc.fn_target)
   target_te = annotate_expr(ctx, env, tgt_expr)
   first_arg = cc.args(0) | _ | ast::Expr(Int, 0)
   idx_te = annotate_expr(ctx, env, first_arg)
   rhs = annotate_expr(ctx, env, val_expr)
   c_tgt = unify::canon(ctx, target_te.ut)
   ret_ut' = unify::prim_unit!
   c_tgt
      [Prim p]
         p [Str, Builder]
            unify::add_error(ctx, 3067,
              diag::E3067_string_write_prefix! + cc.fn_name +
              diag::E3067_string_write_suffix!)
      [Array arr]
         cc.fn_name != "" && type_env::init_is_tracked(env, cc.fn_name) &&
           !type_env::init_is_whole(env, cc.fn_name)
           |
              unify::add_error(ctx, 3131,
                diag::whole_value_init(cc.fn_name))
         unify::unify(ctx, idx_te.ut, unify::prim_int!)
         ok_elem = unify::unify(ctx, arr.elem, rhs.ut)
         !ok_elem
            |
               unify::add_error(ctx, 3084,
                 "Type mismatch in array index assignment")
         ret_ut' = unify::ram_np(unify::prim_error!)
      [Slice elem]
         cc.fn_name != "" && type_env::init_is_tracked(env, cc.fn_name) &&
           !type_env::init_is_whole(env, cc.fn_name)
           |
              unify::add_error(ctx, 3049,
                diag::E3049_slice_write_prefix! + cc.fn_name + diag::E3049_slice_write_suffix!)
         unify::unify(ctx, idx_te.ut, unify::prim_int!)
         ok_elem = unify::unify(ctx, elem, rhs.ut)
         !ok_elem
            |
               unify::add_error(ctx, 3084,
                 "Type mismatch in slice index assignment")
      [Rec r]
         cc.fn_name != "" && type_env::init_is_tracked(env, cc.fn_name) &&
           !type_env::init_is_whole(env, cc.fn_name)
           |
              unify::add_error(ctx, 3131,
                diag::whole_value_init(cc.fn_name))
         !is_ufields_homogeneous(ctx, r)
            |
               unify::add_error(ctx, 3051, diag::E3051_dynamic_index_hetero!)
         unify::unify(ctx, idx_te.ut, unify::prim_int!)
         n_flds = ?r
         n_flds > 0
            |
               f0 = r(0) | _ |
                  unify::UField("", unify::UType(None))
               unify::unify(ctx, f0.ut, rhs.ut)
   ti = unify::type_info_from_utype(ctx, ret_ut')
   lay = layout::compute_layout(ctx, ret_ut')
   tast::mk_typed_expr(tast::TypedExprKind(IndexWrite,
     (target_te, idx_te, rhs)),
     ret_ut', ti, lay, cc.line, cc.col)

annotate_key_write: unify::Ctx, type_env::TypeEnv,
  ast::KeyAccessExpr, ast::Expr => tast::TypedExpr
annotate_key_write = ctx, env, ka, val_expr =>
   is_view_expr(val_expr)
      | unify::add_error(ctx, 3150, diag::E3150_view_escape_frame!)
   target_te = annotate_expr(ctx, env, ka.target)
   key_te = annotate_expr(ctx, env, ka.key)
   rhs = annotate_expr(ctx, env, val_expr)
   c_tgt = unify::canon(ctx, target_te.ut)
   !(c_tgt [Poison])
      |
         c_tgt
            [Map m]
               unify::unify(ctx, m.key, key_te.ut)
               unify::unify(ctx, m.val, rhs.ut)
            |
               !unify::is_map_key_utype(ctx, key_te.ut)
                  |
                     unify::add_error(ctx, 2090,
                       "Map key type must be String, Int, or Addr")
               var_map = unify::mk_map(key_te.ut, rhs.ut)
               unify::unify(ctx, target_te.ut, var_map)
   ut = unify::prim_unit!
   ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   lay = tast::layout_void!
   tast::mk_typed_expr(tast::TypedExprKind(IndexWrite,
     (target_te, key_te, rhs)), ut, ti, lay, ka.line, ka.col)

annotate_raw_write: unify::Ctx, type_env::TypeEnv,
  ast::RawMemoryExpr, ast::Expr => tast::TypedExpr
annotate_raw_write = ctx, env, rm, val_expr =>
   rm.load_type ![Unknown]
      |
         unify::add_error(ctx, 2093, diag::E2093_assign_typed_load!)
   addr_te = annotate_expr(ctx, env, rm.addr)
   !is_int_or_ptr_ut(ctx, addr_te.ut)
      | unify::unify(ctx, addr_te.ut, unify::prim_rawptr!)
   rhs = annotate_expr(ctx, env, val_expr)
   c_rhs = unify::canon(ctx, rhs.ut)
   ok_w = <->
   c_rhs
      [Prim p]
         p
            [Int, I8, I16, I32, I64, U8, U16, U32, U64, Float, F32, Rune, Str, RawPtr, Error]
               ok_w = <+>
   !ok_w
      |
         unify::add_error(ctx, 3142, diag::E3142_raw_write_type!)
   ut = unify::prim_unit!
   ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   lay = tast::layout_void!
   tast::mk_typed_expr(tast::TypedExprKind(RawMemoryWrite,
     (addr_te, rhs)), ut, ti, lay, 0, 0)

// --- SCC Elaboration Helpers (Phase 5) --------------------------------------

find_assign_idx = exprs, target_name =>
   idx' = -1
   exprs @ e, i =>
      e
         [Assign a]
            a.0 == target_name && !is_fwd_assign(a) && !a.2
               |
                  idx' = i
                  -->
   idx'

active_swizzle_mode_at: ast::Exprs, Int => String
active_swizzle_mode_at = exprs, up_to =>
   mode' = ++"none"
   up_to @ i =>
      e = exprs(i) | _ | ast::Expr(Int, 0)
      e
         [SwizzlePragma m] (mode' = ++m)
   mode'

prebind_scc: unify::Ctx, type_env::TypeEnv, ast::Exprs, String => ()
prebind_scc = ctx, env, exprs, name =>
   bnd = type_env::lookup_local(env, name)
   bnd
      !|
         idx = find_assign_idx(exprs, name)
         idx !< 0
            |
               e = exprs(idx) | _ | ast::Expr(Int, 0)
               e
                  [Assign a]
                     a.5
                        [Fn fe]
                           ?fe.ct_params == 0
                              |
                                 p_uts = ?fe.params @> _p_i => unify::fresh_var(ctx)
                                 ret_ut = unify::fresh_var(ctx)
                                 fn_ut = unify::mk_fn(p_uts, ret_ut)
                                 fn_ti = unify::type_info_from_utype(ctx,
                                   fn_ut)
                                 type_env::bind_local(env, name, fn_ut,
                                   fn_ti, a.1)

annotate_scc: unify::Ctx, type_env::TypeEnv, ast::Exprs, String, <> => ()
annotate_scc = ctx, env, exprs, name, is_recursive =>
   idx = find_assign_idx(exprs, name)
   idx !< 0
      |
         idx < ?cur_stmt_files
            |
               s_f = cur_stmt_files(idx) | _ | cur_source_file
               s_l = cur_stmt_lines(idx) | _ | 0
               s_c = cur_stmt_cols(idx) | _ | 0
               unify::set_location(ctx, s_f, s_l, s_c)
            |
               unify::set_file(ctx, cur_source_file)
         env.swizzle_mode = active_swizzle_mode_at(exprs, idx)
         e = exprs(idx) | _ | ast::Expr(Int, 0)
         e
            [Assign a]
               target_bnd = type_env::lookup_local(env, name)
               target_bnd
                  | tb =>
                     a.5
                        [Fn fe]
                           ?fe.ct_params == 0
                              |
                                 c_tb = unify::canon(ctx, tb.ut)
                                 c_tb
                                    [Fn f]
                                       can_cache = unify::is_ground(ctx,
                                         tb.ut)
                                       type_env::enter_scope(env)
                                       saved_in_fn = env.in_fn
                                       saved_fn_ret = env.cur_fn_ret
                                       saved_init = type_env::init_snapshot(
                                          env)
                                       env.in_fn = <+>
                                       env.cur_fn_ret = <+ f.ret +>
                                       env.init = type_env::new_init!
                                       ?fe.params @ p_i =>
                                          pname = fe.params(p_i) | _ | ""
                                          put = f.params(p_i) | _ |
                                             unify::UType(None)
                                          pname != ""
                                             |
                                                p_ti =
                                                   unify::type_info_from_utype(
                                                      ctx, put)
                                                type_env::bind_local(env,
                                                  pname, put, p_ti, <->)
                                                type_env::init_mark_whole(
                                                   env, pname)
                                       c_ret = unify::canon(ctx, f.ret)
                                       is_ret_unit' = <->
                                       c_ret
                                          [Prim p] (is_ret_unit' = p [Unit])
                                       env.discard_result = is_ret_unit'
                                       saved_decl_exp = cur_expected_ut
                                       saved_decl_fn = cur_fn_name
                                       saved_in_fn && fn_captures_view(fe)
                                          | unify::add_error(ctx, 3150,
                                            diag::E3150_view_escape_frame!)
                                       saved_views = ++view_vars
                                       view_vars ::= ast::Names()
                                       cur_expected_ut ::= <+ f.ret +>
                                       cur_fn_name ::= name
                                       scc_errs0 = unify::error_count(ctx)
                                       check_no_closing_return(ctx, fe.body)
                                       body_te = annotate_expr(ctx, env,
                                         fe.body)
                                       scc_had_err = unify::error_count(ctx) > scc_errs0
                                       cur_fn_name ::= saved_decl_fn
                                       cur_expected_ut ::= saved_decl_exp
                                       is_view_expr(fe.body)
                                          | unify::add_error(ctx, 3150,
                                            diag::E3150_view_escape_frame!)
                                       view_vars ::= saved_views
                                       scc_had_err
                                          |
                                             inv0 = invalid_scc_fns
                                             inv0 += name
                                             invalid_scc_fns ::= inv0
                                             unify::canon(ctx, f.ret) [Var] unify::unify(ctx, f.ret, unify::poison_utype!)
                                          |
                                             can_cache
                                                | type_env::cache_fn_body(env, name,
                                                  body_te)
                                       type_env::init_restore(env, saved_init)
                                       env.in_fn = saved_in_fn
                                       env.cur_fn_ret = saved_fn_ret
                                       type_env::leave_scope(env)
                                       !scc_had_err
                                          |
                                             ok_ret = is_ret_unit' || expr_is_jump(body_te) ||
                                               unify::unify(ctx, f.ret, body_te.ut)
                                             !ok_ret
                                                |
                                                   unify::add_error(ctx, 3084,
                                                     diag::return_type_mismatch_prefix! + name)
                                       type_env::init_mark_whole(env, name)
                                       !scc_had_err && is_recursive && !has_name_in(declared_fns, name)
                                          |
                                             c_ret_chk = unify::canon(ctx, f.ret)
                                             !unify::is_ground(ctx, c_ret_chk)
                                                |
                                                   unify::add_error(ctx, 3103,
                                                     "Return type of function '" +
                                                     name + "' could not be statically determined")

solve_unconstrained_rams: unify::Ctx, unify::UType => ()
solve_unconstrained_rams = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Ram r]
         r.pos.has_payload
            |
               c_pos = unify::canon(ctx, r.pos.ut)
               c_pos
                  [Var vid] unify::bind_var(ctx, vid, unify::prim_unit!)
                  | solve_unconstrained_rams(ctx, r.pos.ut)
         r.neg.has_payload
            |
               c_neg = unify::canon(ctx, r.neg.ut)
               c_neg
                  [Var vid2] unify::bind_var(ctx, vid2, unify::prim_unit!)
                  | solve_unconstrained_rams(ctx, r.neg.ut)
      [Rec r_flds]
         r_flds @ fld =>
            solve_unconstrained_rams(ctx, fld.ut)

check_ground: unify::Ctx, type_env::TypeEnv, ast::Exprs, String => ()
check_ground = ctx, env, exprs, name =>
   has_name_in(invalid_scc_fns, name) | --|
   target_bnd = type_env::lookup_local(env, name)
   target_bnd
      |
         tb = _
         solve_unconstrained_rams(ctx, tb.ut)
         c = unify::canon(ctx, tb.ut)
         idx = find_assign_idx(exprs, name)
         idx !< 0
            |
               idx < ?cur_stmt_files
                  |
                     s_f = cur_stmt_files(idx) | _ | cur_source_file
                     s_l = cur_stmt_lines(idx) | _ | 0
                     s_c = cur_stmt_cols(idx) | _ | 0
                     unify::set_location(ctx, s_f, s_l, s_c)
                  |
                     unify::set_file(ctx, cur_source_file)
               e = exprs(idx) | _ | ast::Expr(Int, 0)
               e
                  [Assign a]
                     a.5
                        [Fn fe]
                           c
                              [Fn f]
                                 ?fe.ct_params == 0
                                    |
                                       all_p_ok' = <+>
                                       f.params @ p =>
                                          !unify::is_ground(ctx, p)
                                             |
                                                all_p_ok' = <->
                                                -->
                                       !all_p_ok'
                                          |
                                             unify::add_error(ctx, 3128,
                                               "Unannotated function " +
                                               "parameter type cannot be " +
                                               "statically inferred for '" +
                                               name + "'")
                                       all_p_ok'
                                          |
                                             ret_ok = unify::is_ground(
                                                ctx, f.ret)
                                             !ret_ok
                                                |
                                                   unify::add_error(ctx,
                                                     3103,
                                                     diag::return_type_inference_prefix! +
                                                     name +
                                                     "'")
                              |
                                 c_fn_ok = unify::is_ground(ctx, c)
                                 !c_fn_ok
                                    |
                                       unify::add_error(ctx, 3103,
                                         diag::E3103_cannot_infer_type!)
                        |
                           c
                              [Fn f_val]
                                 ret_ok = unify::is_ground(ctx, f_val.ret)
                                 !ret_ok
                                    |
                                       unify::add_error(ctx, 3103,
                                         diag::return_type_inference_prefix! + name +
                                         "'")
                              |
                                 c_val_ok = unify::is_ground(ctx, c)
                                 !c_val_ok
                                    |
                                       unify::add_error(ctx, 3103,
                                         diag::E3103_cannot_infer_type!)

register_foreign_decl: type_env::TypeEnv, ast::ForeignFnDecl => ()
register_foreign_decl = env, f =>
   is_ret_rec = f.return_type [Record]
   is_ret_unit = f.return_type [Unit]
   ret_ut0 = is_ret_unit | unify::prim_unit! |
      unify::UType(Prim, unify::vt_to_uprim(f.return_type))
   ret_ut = is_ret_rec | utype_from_ti_env(env, f.ret_record_info) |
      ret_ut0
   ret_ti = is_ret_rec | f.ret_record_info |
      ast::TypeInfo(Prim, f.return_type)
   f.is_variable
      |
         type_env::bind_local(env, f.dva_name, ret_ut, ret_ti, <->)
         type_env::init_mark_whole(env, f.dva_name)
      |
         param_uts = ?f.params @> i =>
            p = f.params(i) | _ | ast::ForeignFnParam("",
              ast::ValueType(Unknown),
              ast::TypeInfo(Prim, ast::ValueType(Unknown)))
            is_rec = p.param_type [Record]
            is_rec | utype_from_ti_env(env, p.record_info) |
               unify::UType(Prim, unify::vt_to_uprim(p.param_type))
         fn_ut = unify::UType(Fn, unify::UFn(param_uts, ret_ut))
         type_env::bind_local(env, f.dva_name, fn_ut,
           ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

register_enum_variants: type_env::TypeEnv, String, unify::UType => ()
register_enum_variants = env, td_name, td_ut =>
   td_ti = ast::TypeInfo(TypeVar, td_name)
   td_mod = type_env::decl_module(td_name, 0)
   td_is_priv = td_mod != "" && ?td_name > ?td_mod + 2 &&
     td_name(?td_mod + 2) == '#
   td_ut
      [Enum uenum]
         uenum.variants @ v =>
            v.label != "" && !v.has_payload
               |
                  short_name = td_mod == ""
                     | v.label
                     | td_is_priv
                        | "${td_mod}::#${v.label}"
                        | "${td_mod}::${v.label}"
                  type_env::bind_local(env, short_name, td_ut, td_ti, <->)
                  type_env::bind_local(env, "${td_name}::${v.label}",
                    td_ut, td_ti, <->)

#type ElabStats (
   num_stmts: Int,
   num_nodes: Int,
   solved_vars: Int,
   total_layout_size: Int
)

count_target_nodes: <tast::TypedExpr|> => Int
count_target_nodes = opt =>
   opt | tgt => count_expr_nodes(tgt) | 0

count_expr_nodes: tast::TypedExpr => Int

count_expr_list: tast::TypedExprs => Int
count_expr_list = exprs =>
   (0, ?exprs) @> total, i =>
      e = exprs(i) | _ | tast::mk_lit_unit(0, 0)
      total + count_expr_nodes(e)

count_record_fields: tast::TypedFields => Int
count_record_fields = fields =>
   (0, ?fields) @> total, i =>
      f = fields(i) | _ | tast::TypedField("", tast::mk_lit_unit(0, 0),
        0, unify::UType(None))
      total + count_expr_nodes(f.val)

count_choice_branches: tast::TypedBranches => Int
count_choice_branches = branches =>
   total' = 0
   branches @ br =>
      total' = total' + count_expr_nodes(br.body)
   total'

count_expr_nodes = te =>
   count' = 1
   te.kind
      [Bin b]
         count' = count' + count_expr_nodes(b.1) + count_expr_nodes(b.2)
      [Unary u]
         count' = count' + count_expr_nodes(u.1)
      [Call c]
         count' = count' + count_target_nodes(c.1) + count_expr_list(c.2)
      [Record r]
         count' = count' + count_record_fields(r)
      [Member m]
         count' = count' + count_expr_nodes(m.0)
      [MemberWrite mw]
         count' = count' + count_expr_nodes(mw.0) + count_expr_nodes(mw.3)
      [Index idx]
         count' = count' + count_expr_nodes(idx.0) + count_expr_nodes(idx.1)
      [KeyAccess ka]
         count' = count' + count_expr_nodes(ka.0) + count_expr_nodes(ka.1)
      [IndexWrite iw]
         count' = count' + count_expr_nodes(iw.0) + count_expr_nodes(iw.1) +
           count_expr_nodes(iw.2)
      [Choice ch]
         count' = count' + count_expr_nodes(ch.0) + count_choice_branches(ch.1)
      [Lambda lm]
         count' = count' + count_expr_nodes(lm.1)
      [Block bk]
         count' = count' + count_expr_list(bk)
      [Assign a]
         count' = count' + count_expr_nodes(a.5)
      [Cycle cy]
         count' = count' + count_expr_nodes(cy.0) + count_expr_nodes(cy.1)
         count' = count' + count_target_nodes(cy.2)
      [BuilderNew bn]
         count' = count' + count_expr_nodes(bn)
      [Copy cp]
         count' = count' + count_expr_nodes(cp)
      [RawMemory rm]
         count' = count' + count_expr_nodes(rm.0)
      [RawMemoryWrite rmw]
         count' = count' + count_expr_nodes(rmw.0) + count_expr_nodes(rmw.1)
      [MapLiteral ml]
         ml @ pr =>
            count' = count' + count_expr_nodes(pr.key) +
              count_expr_nodes(pr.val)
      [Exit e]
         count' = count' + count_expr_nodes(e)
      [Return r]
         count' = count' + count_target_nodes(r)
   count'

count_program_nodes: tast::TypedProgram => Int
count_program_nodes = prog =>
   total' = 0
   prog @ st =>
      st
         [Expr te]
            total' = total' + count_expr_nodes(te)
         | total' = total' + 1
   total'

program_layout_size: tast::TypedProgram => Int
program_layout_size = prog =>
   total' = 0
   prog @ st =>
      st
         [Expr te]
            total' = total' + te.layout.size
   total'

print_elab_stats: ElabStats => ()
print_elab_stats = stats =>
   print $ "=== Typed AST Elaboration Statistics ==="
   print $ "  Statements:            " + str::from_int(stats.num_stmts)
   print $ "  Typed nodes:           " + str::from_int(stats.num_nodes)
   print $ "  Type variables solved: " + str::from_int(stats.solved_vars)
   print $ "  Total layout size:     " +
     str::from_int(stats.total_layout_size) + " bytes"

print_program_errors: unify::TypeErrors => ()
print_program_errors = errs =>
   ?errs @ i =>
      err_res = errs(i)
      err_res | err =>
         log::error $ unify::format_error(err)

#type ElabProgCtx (prog: tast::TypedProgram, ctx: unify::Ctx)
#type ElabSuccess (
   prog: tast::TypedProgram,
   stats: ElabStats,
   ctx: unify::Ctx
)
#type ElabProgResult < ElabSuccess | unify::TypeErrors >

refresh_typed_expr: unify::Ctx, tast::TypedExpr => tast::TypedExpr

refresh_target: unify::Ctx, <tast::TypedExpr|> => <tast::TypedExpr|>
refresh_target = ctx, opt =>
   opt
      | tgt => <+ refresh_typed_expr(ctx, tgt) +>

refresh_expr_list: unify::Ctx, tast::TypedExprs => tast::TypedExprs
refresh_expr_list = ctx, exprs =>
   res = tast::TypedExprs()
   exprs @ e =>
      res += refresh_typed_expr(ctx, e)
   res

refresh_record_fields: unify::Ctx, tast::TypedFields => tast::TypedFields
refresh_record_fields = ctx, fields =>
   res = tast::TypedFields()
   fields @ f =>
      ref_val = refresh_typed_expr(ctx, f.val)
      res += tast::TypedField(f.name, ref_val, f.offset, ref_val.ut)
   res

refresh_choice_branches: unify::Ctx, tast::TypedBranches => tast::TypedBranches
refresh_choice_branches = ctx, branches =>
   res = tast::TypedBranches()
   branches @ br =>
      ref_body = refresh_typed_expr(ctx, br.body)
      res += tast::TypedBranch(br.kind, br.case_values, br.pred_fn,
        br.variant_names, br.bind_vars, ref_body)
   res

refresh_map_pairs: unify::Ctx, tast::TypedMapPairs => tast::TypedMapPairs
refresh_map_pairs = ctx, pairs =>
   res = tast::TypedMapPairs()
   pairs @ pr =>
      res += tast::TypedMapPair(refresh_typed_expr(ctx, pr.key),
        refresh_typed_expr(ctx, pr.val))
   res

refresh_typed_expr = ctx, te =>
   c_ut = unify::canon(ctx, te.ut)
   is_named_ti = te.ti [TypeVar tv] tv != "" | <->
   is_bf_ti = te.ti [Bitfield]
   is_packed_ti = te.ti [Rec r] r.5 | (te.ti [Align a] (a.1 [Rec r] r.5 | <->) | <->)
   is_align_ti = te.ti [Align]
   is_type_carrier = (c_ut [Prim p] p [Type] | <->) &&
     !(te.ti [Prim pt] pt [Type, Unknown] | <->)
   keep_ti = is_named_ti || is_bf_ti || is_packed_ti || is_align_ti || is_type_carrier
   new_ti = keep_ti
      | te.ti
      | unify::type_info_from_utype(ctx, c_ut)
   new_lay = layout::compute_layout(ctx, c_ut)
   new_kind = te.kind
      [Bin b]
         b.0 [BitAnd, BitOr, BitXor] unify_bitwise(ctx, b.1.ut, b.2.ut)
         tast::TypedExprKind(Bin, (b.0, refresh_typed_expr(ctx, b.1),
           refresh_typed_expr(ctx, b.2)))
      [Unary u]
         u.0 [Length] check_length_operand(ctx, u.1.ut)
         tast::TypedExprKind(Unary, (u.0, refresh_typed_expr(ctx, u.1)))
      [Call c]
         ref_args = refresh_expr_list(ctx, c.2)
         c.0 == "%bitcast" && ?c.2 == 2
            |
               old_a1 = c.2(1) | _ | tast::mk_lit_unit(0, 0)
               (old_a1.ut [Var])
                  |
                     new_a1 = ref_args(1) | _ | tast::mk_lit_unit(0, 0)
                     te.line > 0 | unify::set_pos(ctx, te.line, te.col)
                     check_bitcast_types(ctx, c_ut, new_a1.ut)
         tast::TypedExprKind(Call, (c.0, refresh_target(ctx, c.1), ref_args))
      [Record r]
         tast::TypedExprKind(Record, refresh_record_fields(ctx, r))
      [Member m]
         tgt = refresh_typed_expr(ctx, m.0)
         c_tgt = unify::canon(ctx, tgt.ut)
         idx' = m.2
         need_idx = idx' < 0 || m.1 != ""
         need_idx
            |
               c_tgt
                  [Rec r]
                     ri = unify::find_field_idx(r, m.1)
                     ri !< 0 | (idx' = ri)
         tast::TypedExprKind(Member, (tgt, m.1, idx'))
      [MemberWrite mw]
         tgt = refresh_typed_expr(ctx, mw.0)
         c_tgt = unify::canon(ctx, tgt.ut)
         idx' = mw.2
         need_idx = idx' < 0 || mw.1 != ""
         need_idx
            |
               c_tgt
                  [Rec r]
                     ri = unify::find_field_idx(r, mw.1)
                     ri !< 0 | (idx' = ri)
         tast::TypedExprKind(MemberWrite, (tgt, mw.1, idx',
           refresh_typed_expr(ctx, mw.3)))
      [Index idx']
         tast::TypedExprKind(Index, (refresh_typed_expr(ctx, idx'.0),
           refresh_typed_expr(ctx, idx'.1)))
      [KeyAccess ka]
         tast::TypedExprKind(KeyAccess, (refresh_typed_expr(ctx, ka.0),
           refresh_typed_expr(ctx, ka.1), ka.2, ka.3))
      [IndexWrite iw]
         tast::TypedExprKind(IndexWrite, (refresh_typed_expr(ctx, iw.0),
           refresh_typed_expr(ctx, iw.1), refresh_typed_expr(ctx, iw.2)))
      [Choice ch]
         tast::TypedExprKind(Choice, (refresh_typed_expr(ctx, ch.0),
           refresh_choice_branches(ctx, ch.1)))
      [Lambda lm]
         tast::TypedExprKind(Lambda, (lm.0, refresh_typed_expr(ctx, lm.1),
           lm.2))
      [Block bk]
         tast::TypedExprKind(Block, refresh_expr_list(ctx, bk))
      [Assign a]
         tast::TypedExprKind(Assign, (a.0, a.1, a.2, a.3, a.4,
           refresh_typed_expr(ctx, a.5)))
      [Cycle cy]
         tast::TypedExprKind(Cycle, (refresh_typed_expr(ctx, cy.0),
           refresh_typed_expr(ctx, cy.1), refresh_target(ctx, cy.2), cy.3))
      [BuilderNew bn]
         tast::TypedExprKind(BuilderNew, refresh_typed_expr(ctx, bn))
      [ArrayNew an]
         new_elem_ti = new_ti [Array a] a.1 | an.elem_type
         tast::TypedExprKind(ArrayNew, ast::ArrayCreateExpr(new_elem_ti, an.cap))
      [Copy cp]
         tast::TypedExprKind(Copy, refresh_typed_expr(ctx, cp))
      [RawMemory rm]
         tast::TypedExprKind(RawMemory, (refresh_typed_expr(ctx, rm.0), rm.1))
      [RawMemoryWrite rmw]
         tast::TypedExprKind(RawMemoryWrite, (refresh_typed_expr(ctx, rmw.0),
           refresh_typed_expr(ctx, rmw.1)))
      [MapLiteral ml]
         tast::TypedExprKind(MapLiteral, refresh_map_pairs(ctx, ml))
      [RamConstruct rc]
         rc_tgt = refresh_target(ctx, rc.2)
         tast::TypedExprKind(RamConstruct, (rc.0, rc.1, rc_tgt))
      [EnumConstruct ec]
         ec_tgt = refresh_target(ctx, ec.1)
         tast::TypedExprKind(EnumConstruct, (ec.0, ec_tgt))
      [Exit e]
         tast::TypedExprKind(Exit, refresh_typed_expr(ctx, e))
      [Return r]
         tast::TypedExprKind(Return, (r | v => <+ refresh_typed_expr(ctx, v) +> | <-->))
      | te.kind
   tast::TypedExpr(new_kind, c_ut, new_ti, new_lay, te.line, te.col)

refresh_program_stmts: unify::Ctx, tast::TypedStmts => tast::TypedStmts
refresh_program_stmts = ctx, stmts =>
   final_stmts = tast::TypedStmts()
   stmts @ stmt =>
      stmt
         [Expr te]
            final_stmts += tast::TypedStmt(Expr, refresh_typed_expr(ctx, te))
         [Binding b]
            ref_e = refresh_typed_expr(ctx, b.2)
            final_stmts += tast::TypedStmt(Binding, (b.0, ref_e.ti, ref_e, b.3))
         [GlobalBinding gb]
            ref_e = refresh_typed_expr(ctx, gb.2)
            final_stmts += tast::TypedStmt(GlobalBinding,
              (gb.0, ref_e.ti, ref_e))
         | final_stmts += stmt
   final_stmts

set_stmt_loc_at: unify::Ctx, Int => ()
set_stmt_loc_at = ctx, idx =>
   idx < ?cur_stmt_files
      |
         s_f = cur_stmt_files(idx) | _ | cur_source_file
         s_l = cur_stmt_lines(idx) | _ | 0
         s_c = cur_stmt_cols(idx) | _ | 0
         unify::set_location(ctx, s_f, s_l, s_c)
      |
         unify::set_file(ctx, cur_source_file)

collect_body_records: ast::Expr, ast::Exprs => ()
collect_body_records = expr, out =>
   expr
      [Record]
         out += expr
      [Block bs]
         ?bs > 0 | collect_body_records(bs(?bs - 1)!!, out)
      [Return ret]
         ret.has_val | collect_body_records(ret.val, out)
      [Choice ch]
         ch.branches @ br =>
            collect_body_records(br.block, out)

resolve_local_fn_assign_name: ast::Exprs, String, String => String
resolve_local_fn_assign_name = exprs, cur_mod, target_fn =>
   target_fn == ""
      | ""
      |
         type_env::name_is_qualified(target_fn, 0)
            | (find_assign_idx(exprs, target_fn) !< 0 | target_fn | "")
            |
               c_pub = cur_mod != "" | "${cur_mod}::${target_fn}" | target_fn
               find_assign_idx(exprs, c_pub) !< 0
                  | c_pub
                  |
                     c_priv = cur_mod != "" | "${cur_mod}::#${target_fn}" | ""
                     c_priv != "" && find_assign_idx(exprs, c_priv) !< 0
                        | c_priv
                        | ""

check_missing_fwd_defs: unify::Ctx, ast::Exprs => ()
check_missing_fwd_defs = ctx, exprs =>
   exprs @ e_decl, i_decl =>
      e_decl
         [Assign a]
            is_fwd_assign(a) && a.0 != "" && !is_verified_iface_assign(a)
               |
                  a.8
                     [Fn f]
                        is_type_gen = ?f.4 > 0 && ?f.0 == 0 && is_upper_decl_name(a.0)
                        !is_type_gen && !has_name_in(user_fns, a.0) &&
                          find_assign_idx(exprs, a.0) < 0
                           |
                              set_stmt_loc_at(ctx, i_decl)
                              unify::add_error(ctx, 3004,
                              "Missing definition for declared function '${a.0}'")

// --- Pre-Codegen Monomorphization & Groundness Verification (Phase 6) --------

resolve_typed_arg_type: unify::Ctx, type_env::TypeEnv,
  tast::TypedExpr => (unify::UType, ast::TypeInfo, String, <>)
resolve_typed_arg_type = ctx, env, arg_te =>
   c_ut = unify::canon(ctx, arg_te.ut)
   is_type_c = c_ut [Prim p] p [Type] | <->
   arg_te.kind
      [LitUnit] (unify::prim_unit!, ast::TypeInfo(Prim, ast::ValueType(Unit)), "", <+>)
      [Var v]
         is_type_c && !(arg_te.ti [Prim pt] pt [Type, Unknown] | <->)
            |
               u = utype_from_ti_env(env, arg_te.ti)
               dt = arg_te.ti [TypeVar tv] tv | ""
               !(u [None]) | (u, arg_te.ti, dt, <+>)
               | (resolve_type_name_ut_ti(ctx, env, "", v.0).0,
                  resolve_type_name_ut_ti(ctx, env, "", v.0).1, v.0,
                  resolve_type_name_ut_ti(ctx, env, "", v.0).2)
            |
               v.0 != ""
                  |
                     rt = resolve_type_name_ut_ti(ctx, env, "", v.0)
                     dt = rt.1 [TypeVar tv] tv | ""
                     (rt.0, rt.1, dt, rt.2)
                  | (unify::UType(None), arg_te.ti, "", <->)
      |
         is_type_c && !(arg_te.ti [Prim pt] pt [Type, Unknown] | <->)
            |
               u = utype_from_ti_env(env, arg_te.ti)
               dt = arg_te.ti [TypeVar tv] tv | ""
               !(u [None]) | (u, arg_te.ti, dt, <+>)
               | (unify::UType(None), arg_te.ti, "", <->)
            | (unify::UType(None), arg_te.ti, "", <->)

find_immutable_ast_val_expr: ast::Exprs, String => <ast::Expr|>
find_immutable_ast_val_expr = exprs, name =>
   idx = find_assign_idx(exprs, name)
   idx < 0 | --| <-->
   e = exprs(idx)!!
   e
      [Assign a]
         !(a.1 || name_is_primed(a.0) || a.2 || is_fwd_assign(a))
            | <+ a.5 +>
            | <-->
      | <-->

eval_int_bin_ct: ast::BinaryOp, Int, Int => <tast::TypedExpr|>
eval_int_bin_ct = op, ln, rn =>
   op
      [Add] <+ tast::mk_lit_int(ln + rn, 0, 0) +>
      [Sub] <+ tast::mk_lit_int(ln - rn, 0, 0) +>
      [Mul] <+ tast::mk_lit_int(ln * rn, 0, 0) +>
      [Div] (rn != 0 | <+ tast::mk_lit_int(ln / rn, 0, 0) +> | <-->)
      [Mod] (rn != 0 | <+ tast::mk_lit_int(ln % rn, 0, 0) +> | <-->)
      [Eq] <+ tast::mk_lit_flag(ln == rn, 0, 0) +>
      [NotEq] <+ tast::mk_lit_flag(ln != rn, 0, 0) +>
      [Lt] <+ tast::mk_lit_flag(ln < rn, 0, 0) +>
      [Gt] <+ tast::mk_lit_flag(ln > rn, 0, 0) +>
      [NotGt] <+ tast::mk_lit_flag(ln !< rn, 0, 0) +>
      [NotLt] <+ tast::mk_lit_flag(ln !> rn, 0, 0) +>
      | <-->

eval_ast_ct_val: ast::Exprs, ast::Expr => <tast::TypedExpr|>
eval_ast_ct_val = exprs, e =>
   e
      [Int n] <+ tast::mk_lit_int(n, 0, 0) +>
      [Float f] <+ tast::mk_lit_float(f, 0, 0) +>
      [Str s] <+ tast::mk_lit_str(s, 0, 0) +>
      [Rune r]
         ut = unify::prim_rune!
         <+ tast::mk_typed_expr(tast::TypedExprKind(LitRune, r), ut,
           ast::TypeInfo(Prim, ast::ValueType(Rune)),
           tast::layout_scalar(4, 4), 0, 0) +>
      [Variant v]
         ?v.args == 0 && (v.tag_name [Positive, Negative])
            | <+ tast::mk_lit_flag(v.tag_name [Positive], 0, 0) +>
            | <-->
      [Var nm]
         lookup_ct_int(nm)
            | ci => <+ tast::mk_lit_int(ci, 0, 0) +>
            |
               lookup_ct_val(nm)
                  | ctv => <+ ctv.te +>
                  |
                     find_immutable_ast_val_expr(exprs, nm)
                        | ae => eval_ast_ct_val(exprs, ae)
                        | <-->
      [Unary u]
         eval_ast_ct_val(exprs, u.1)
            | iv =>
               u.0
                  [Neg]
                     iv.kind
                        [LitInt n] <+ tast::mk_lit_int(0 - n, 0, 0) +>
                        [LitFloat f] <+ tast::mk_lit_float(0.0 - f, 0, 0) +>
                        | <-->
                  [Not]
                     iv.kind [LitFlag fl] <+ tast::mk_lit_flag(!fl, 0, 0) +> | <-->
                  | <-->
            | <-->
      [Bin b]
         eval_ast_ct_val(exprs, b.1)
            | lv =>
               eval_ast_ct_val(exprs, b.2)
                  | rv =>
                     lv.kind
                        [LitInt ln]
                           rv.kind
                              [LitInt rn] eval_int_bin_ct(b.0, ln, rn)
                              | <-->
                        [LitStr ls]
                           rv.kind
                              [LitStr rs]
                                 b.0 [Add] <+ tast::mk_lit_str(ls + rs, 0, 0) +> | <-->
                              | <-->
                        | <-->
                  | <-->
            | <-->
      | <-->

eval_typed_ct_val: unify::Ctx, ast::Exprs, tast::TypedExpr => <tast::TypedExpr|>
eval_typed_ct_val = ctx, exprs, arg_te =>
   arg_te.kind
      [LitInt, LitFloat, LitStr, LitFlag, LitRune] <+ arg_te +>
      [Var v]
         v.2 | --| <-->
         lookup_ct_int(v.0)
            | ci => <+ tast::mk_lit_int(ci, arg_te.line, arg_te.col) +>
            |
               lookup_ct_val(v.0)
                  | ctv => <+ ctv.te +>
                  |
                     v.0 != ""
                        |
                           find_immutable_ast_val_expr(exprs, v.0)
                              | ae => eval_ast_ct_val(exprs, ae)
                              | <-->
                        | <-->
      [Unary u]
         eval_typed_ct_val(ctx, exprs, u.1)
            | iv =>
               u.0
                  [Neg]
                     iv.kind
                        [LitInt n] <+ tast::mk_lit_int(0 - n, arg_te.line, arg_te.col) +>
                        [LitFloat f] <+ tast::mk_lit_float(0.0 - f, arg_te.line, arg_te.col) +>
                        | <-->
                  [Not]
                     iv.kind [LitFlag fl] <+ tast::mk_lit_flag(!fl, arg_te.line, arg_te.col) +> | <-->
                  | <-->
            | <-->
      [Bin b]
         eval_typed_ct_val(ctx, exprs, b.1)
            | lv =>
               eval_typed_ct_val(ctx, exprs, b.2)
                  | rv =>
                     lv.kind
                        [LitInt ln]
                           rv.kind
                              [LitInt rn] eval_int_bin_ct(b.0, ln, rn)
                              | <-->
                        [LitStr ls]
                           rv.kind
                              [LitStr rs]
                                 b.0 [Add] <+ tast::mk_lit_str(ls + rs, 0, 0) +> | <-->
                              | <-->
                        | <-->
                  | <-->
            | <-->
      [Record r]
         all_ok' = <+>
         new_flds = tast::TypedFields()
         r @ rf =>
            eval_typed_ct_val(ctx, exprs, rf.val)
               | cv => new_flds += tast::TypedField(rf.name, cv, rf.offset, rf.ut)
               | (all_ok' = <->; -->)
         all_ok'
            | <+ tast::TypedExpr(tast::TypedExprKind(Record, new_flds),
              arg_te.ut, arg_te.ti, arg_te.layout, arg_te.line, arg_te.col) +>
            | <-->
      | <-->

match_sig_ti_param_ut: unify::Ctx, type_env::TypeEnv, ast::TypeInfo,
  unify::UType, String => <unify::UType|>
match_sig_ti_param_ut = ctx, env, pat_ti, actual_ut, target_tv =>
   ca = unify::canon(ctx, actual_ut)
   pat_ti
      [TypeVar tv]
         tv == target_tv | <+ ca +> | <-->
      [Align a]
         match_sig_ti_param_ut(ctx, env, a.1, ca, target_tv)
      [Array a]
         ca [Array ua] match_sig_ti_param_ut(ctx, env, a.1, ua.elem, target_tv) | <-->
      [Map m]
         ca [Map um] match_sig_ti_param_ut(ctx, env, m.2, um.val, target_tv) | <-->
      [Ram sr]
         ca
            [Ram ur]
               r0 = (sr.0.has_payload && ur.pos.has_payload)
                  | match_sig_ti_param_ut(ctx, env, sr.0.payload_record, ur.pos.ut, target_tv)
                  | <-->
               <>(r0)
                  | r0
                  | (sr.1.has_payload && ur.neg.has_payload)
                     | match_sig_ti_param_ut(ctx, env, sr.1.payload_record, ur.neg.ut, target_tv)
                     | <-->
            | <-->
      [Rec r]
         r.1
            |
               ?r.0 > 0
                  |
                     e_ti = r.0(0)!!.rec_type
                     ca
                        [Slice sl] match_sig_ti_param_ut(ctx, env, e_ti, sl, target_tv)
                        [Array ua] match_sig_ti_param_ut(ctx, env, e_ti, ua.elem, target_tv)
                        | <-->
                  | <-->
            |
               ca
                  [Rec flds]
                     ?r.0 @ i =>
                        i < ?flds
                           |
                              hit = match_sig_ti_param_ut(ctx, env, (r.0(i)!!).rec_type,
                                (flds(i)!!).ut, target_tv)
                              <>(hit) | --| hit
                     <-->
                  | <-->
      [Fn sf]
         ca
            [Fn uf]
               ?sf.1 @ i =>
                  i < ?uf.params
                     |
                        hit = match_sig_ti_param_ut(ctx, env, sf.1(i)!!,
                          uf.params(i)!!, target_tv)
                        <>(hit) | --| hit
               match_sig_ti_param_ut(ctx, env, sf.3, uf.ret, target_tv)
            | <-->
      [Enum slots]
         ca
            [Enum ue]
               ue2 = resolve_enum_ut(ctx, env, ue)
               ?slots @ i =>
                  i < ?ue2.variants && (slots(i)!!).has_payload && (ue2.variants(i)!!).has_payload
                     |
                        hit = match_sig_ti_param_ut(ctx, env, (slots(i)!!).payload_record,
                          (ue2.variants(i)!!).payload_type, target_tv)
                        <>(hit) | --| hit
               <-->
            | <-->
      | <-->

match_sig_ti_param_ti: type_env::TypeEnv, ast::TypeInfo, ast::TypeInfo,
  String => <ast::TypeInfo|>
match_sig_ti_param_ti = env, pat_ti, actual_ti, target_tv =>
   eff_ti = actual_ti
      [TypeVar tv]
         type_env::lookup_user_type(env, tv)
            | u =>
               is_tv = u.ti [TypeVar]
               is_tv | actual_ti | u.ti
            |
               lookup_user_type_any_mod(env, tv)
                  | u2 =>
                     is_tv2 = u2.ti [TypeVar]
                     is_tv2 | actual_ti | u2.ti
                  | actual_ti
      | actual_ti
   pat_ti
      [TypeVar tv]
         tv == target_tv | <+ actual_ti +> | <-->
      [Align a]
         match_sig_ti_param_ti(env, a.1, actual_ti, target_tv)
      [Array a]
         eff_ti
            [Array ua] match_sig_ti_param_ti(env, a.1, ua.1, target_tv)
            | <-->
      [Map m]
         eff_ti
            [Map um] match_sig_ti_param_ti(env, m.2, um.2, target_tv)
            | <-->
      [Ram sr]
         eff_ti
            [Ram ur]
               r0 = (sr.0.has_payload && ur.0.has_payload)
                  | match_sig_ti_param_ti(env, sr.0.payload_record, ur.0.payload_record, target_tv)
                  | <-->
               <>(r0)
                  | r0
                  | (sr.1.has_payload && ur.1.has_payload)
                     | match_sig_ti_param_ti(env, sr.1.payload_record, ur.1.payload_record, target_tv)
                     | <-->
            | <-->
      [Rec r]
         r.1
            |
               ?r.0 > 0
                  |
                     e_ti = r.0(0)!!.rec_type
                     eff_ti
                        [Rec er] (er.1 && ?er.0 > 0 | match_sig_ti_param_ti(env, e_ti, (er.0(0)!!).rec_type, target_tv) | <-->)
                        [Array ea] match_sig_ti_param_ti(env, e_ti, ea.1, target_tv)
                        | <-->
                  | <-->
            |
               eff_ti
                  [Rec er]
                     ?r.0 @ i =>
                        i < ?er.0
                           |
                              hit = match_sig_ti_param_ti(env, (r.0(i)!!).rec_type,
                                (er.0(i)!!).rec_type, target_tv)
                              <>(hit) | --| hit
                     <-->
                  | <-->
      [Fn sf]
         eff_ti
            [Fn ef]
               ?sf.1 @ i =>
                  i < ?ef.1
                     |
                        hit = match_sig_ti_param_ti(env, sf.1(i)!!, ef.1(i)!!, target_tv)
                        <>(hit) | --| hit
               match_sig_ti_param_ti(env, sf.3, ef.3, target_tv)
            | <-->
      | <-->

extract_ct_from_sig: unify::Ctx, type_env::TypeEnv, ast::VInfos,
  ast::TypeInfo, tast::TypedExprs, unify::UType, ast::TypeInfo,
  String => (unify::UType, ast::TypeInfo, String, <>)
extract_ct_from_sig = ctx, env, param_tis, ret_ti, rt_args, call_ret_ut, call_ret_ti, tv_name =>
   found_ut' = <-->
   found_ti' = <-->
   ?param_tis @ i =>
      i < ?rt_args
         |
            u_hit = match_sig_ti_param_ut(ctx, env, param_tis(i)!!, (rt_args(i)!!).ut, tv_name)
            <>(u_hit)
               |
                  found_ut' = u_hit
                  found_ti' = match_sig_ti_param_ti(env, param_tis(i)!!, (rt_args(i)!!).ti, tv_name)
                  -->
   !<>(found_ut')
      |
         found_ut' = match_sig_ti_param_ut(ctx, env, ret_ti, call_ret_ut, tv_name)
         found_ti' = match_sig_ti_param_ti(env, ret_ti, call_ret_ti, tv_name)
   found_ut'
      | u =>
         res_ti = found_ti' | _ | unify::type_info_from_utype(ctx, u)
         dt = res_ti [TypeVar tv] tv | ""
         (u, res_ti, dt, <+>)
      | (unify::UType(None), ast::TypeInfo(Prim, ast::ValueType(Unknown)), "", <->)

sanitize_mono_key_str: String => String
sanitize_mono_key_str = s =>
   b = {?s + 4}
   s @ c =>
      c ['a...'z, 'A...'Z, '0...'9, '_]
         | b += c
         | b += ('_, str::from_int(c))
   +b

has_user_type_ref: type_env::TypeEnv, String => <>
has_user_type_ref = env, tv =>
   <>(type_env::lookup_user_type(env, tv)) || <>(lookup_user_type_any_mod(env, tv))

utype_type_key: unify::Ctx, type_env::TypeEnv, unify::UType, ast::TypeInfo, String => String
utype_type_key = ctx, env, ut, ti, dtype =>
   c = unify::canon(ctx, ut)
   tvar_dt = ti
      [TypeVar tv]
         has_user_type_ref(env, tv) | tv | ""
      | ""
   eff_dt = dtype != "" | dtype | tvar_dt
   c
      [Prim p]
         p
            [Int] "Int"
            [I8] "i8"
            [I16] "i16"
            [I32] "i32"
            [I64] "i64"
            [U8] "u8"
            [U16] "u16"
            [U32] "u32"
            [U64] "u64"
            [Rune] "Rune"
            [Float] "Float"
            [F32] "f32"
            [Str] "String"
            [Builder] "Builder"
            [RawPtr] "Addr"
            [Flag] "Flag"
            [Error] "Error"
            [Unit] "Unit"
            [Type] "Type"
            | "Unknown"
      [Array a]
         e_ti = extract_child_ti(ctx, env, ti, 0, a.elem)
         "Array(" + utype_type_key(ctx, env, a.elem, e_ti, "") + ")"
      [Slice s]
         e_ti = extract_child_ti(ctx, env, ti, 0, s)
         "Slice(" + utype_type_key(ctx, env, s, e_ti, "") + ")"
      [Map m]
         k_ti = extract_child_ti(ctx, env, ti, 0, m.key)
         v_ti = extract_child_ti(ctx, env, ti, 1, m.val)
         "Map(" + utype_type_key(ctx, env, m.key, k_ti, "") + "," +
           utype_type_key(ctx, env, m.val, v_ti, "") + ")"
      [Ram r]
         l = r.pos.has_payload
            | utype_type_key(ctx, env, r.pos.ut, extract_child_ti(ctx, env, ti, 0, r.pos.ut), "")
            | "_"
         r_k = r.neg.has_payload
            | utype_type_key(ctx, env, r.neg.ut, extract_child_ti(ctx, env, ti, 1, r.neg.ut), "")
            | "_"
         "Ram(" + l + "|" + r_k + ")"
      [Rec flds]
         b = {64}
         fk = {32}
         flds @ el_, i =>
            i > 0 | fk += ',
            fld = el_
            fld.name != "" | fk += (fld.name, ':)
            f_ti = extract_child_ti(ctx, env, ti, i, fld.ut)
            fk += utype_type_key(ctx, env, fld.ut, f_ti, "")
         f_s = +fk
         eff_dt != "" && eff_dt(0) != '# && !(?eff_dt !< 9 && eff_dt(0..9) == "__fld_ti_")
            | b += ("Rec(", eff_dt, ":", f_s, ")")
            | b += ("Rec(", f_s, ")")
         +b
      [Enum ue]
         eff_dt != ""
            | eff_dt
            | (ue.name != "" | ue.name | "Enum")
      [Fn f]
         b = {48}
         b += "Fn("
         f.params @ el_, i =>
            i > 0 | b += ',
            b += utype_type_key(ctx, env, el_,
              ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
         b += "=>"
         b += utype_type_key(ctx, env, f.ret,
           ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
         b += ")"
         +b
      | (eff_dt != "" | eff_dt | "Unknown")

ct_val_mono_key: tast::TypedExpr => String
ct_val_mono_key = te =>
   te.kind
      [LitInt n] str::from_int(n)
      [LitFloat f] str::from_float(f)
      [LitStr s] sanitize_mono_key_str(s)
      [LitFlag fl]
         fl | "true" | "false"
      [LitRune r] "r" + str::from_int(r)
      | "val"

#type MonoWorkStacks unify::InstStack{}

#type MonoResult (
   stmts: tast::TypedStmts,
   files: ast::Names,
   lines: ast::Ints,
   cols: ast::Ints,
   stacks: MonoWorkStacks,
)

#type MonoCtx (
   ctx: unify::Ctx,
   env: type_env::TypeEnv,
   exprs: ast::Exprs,
   gen_names: ast::Names,
   mono_done: ast::Names,
   work: tast::TypedStmts,
   work_files: ast::Names,
   work_lines: ast::Ints,
   work_cols: ast::Ints,
   work_stacks: MonoWorkStacks,
)

clone_inst_stack: unify::InstStack => unify::InstStack
clone_inst_stack = src =>
   out = unify::InstStack()
   src @ fr => out += fr
   out

mono_rewrite_expr: MonoCtx, tast::TypedExpr => tast::TypedExpr
mono_rewrite_list: MonoCtx, tast::TypedExprs => tast::TypedExprs

slice_names_from: ast::Names, Int => ast::Names
slice_names_from = names, start =>
   out = ast::Names()
   (?names - start) @ i => out += names(start + i)!!
   out

mono_specialize_call: MonoCtx, tast::TypedExpr, String, tast::TypedExprs => tast::TypedExpr
mono_specialize_call = mctx, call_te, cname, args =>
   gen_ti_opt = type_env::lookup_generic(mctx.env, cname)
   assign_idx = find_assign_idx(mctx.exprs, cname)
   !<>(gen_ti_opt) || assign_idx < 0
      | --| tast::TypedExpr(tast::TypedExprKind(Call, (cname, <-->, args)),
        call_te.ut, call_te.ti, call_te.layout, call_te.line, call_te.col)
   fn_e = mctx.exprs(assign_idx)!!
   fe_opt = fn_e [Assign a] (a.5 [Fn fe] <+ fe +> | <-->) | <-->
   !<>(fe_opt)
      | --| tast::TypedExpr(tast::TypedExprKind(Call, (cname, <-->, args)),
        call_te.ut, call_te.ti, call_te.layout, call_te.line, call_te.col)
   fe = fe_opt!!
   sig_ti = gen_ti_opt!!
   sig_fn = sig_ti [Fn f] f |
      (ast::VTypes(), ast::VInfos(), ast::ValueType(Unknown),
        ast::TypeInfo(Prim, ast::ValueType(Unknown)), ast::CParams())
   has_explicit_sig = ?sig_fn.4 > 0 || !(sig_fn.3 [TypeVar tv] tv == "?Ret" | <->)
   cps = ?sig_fn.4 > 0
      | sig_fn.4
      | fe.ct_params @> cp_n => ast::CompileTimeParam(cp_n, ast::ValueType(Type),
        ast::TypeInfo(Prim, ast::ValueType(Type)))
   eff_params = (?fe.params == ?sig_fn.1 + ?cps && ?cps > 0)
      | slice_names_from(fe.params, ?cps)
      | fe.params
   n_cps = ?cps
   n_args = ?args
   ct_names = ast::Names()
   ct_is_val = ast::Ints()
   ct_res = ast::Ints()
   ct_uts = unify::UTypes()
   ct_tis = ast::VInfos()
   ct_dts = ast::Names()
   ct_vtes = tast::TypedExprs()
   arg_idx' = 0
   n_cps @ ci =>
      cp = cps(ci)!!
      ct_names += cp.name
      is_val = cp.val_type != ast::ValueType(Type)
      is_val
         |
            ct_is_val += 1
            ct_uts += unify::UType(None)
            ct_tis += cp.type_info
            ct_dts += ""
            arg_idx' < n_args
               |
                  raw_v = args(arg_idx')!!
                  arg_idx' = arg_idx' + 1
                  ev_ct = eval_typed_ct_val(mctx.ctx, mctx.exprs, raw_v)
                  ev_ct
                     | vte =>
                        ct_res += 1
                        ct_vtes += vte
                     |
                        call_te.line > 0 | unify::set_pos(mctx.ctx, call_te.line, call_te.col)
                        unify::add_error(mctx.ctx, 3130,
                          "Compile-time parameter '${cp.name}' is not compile-time evaluable.")
                        ct_res += 1
                        ct_vtes += tast::mk_lit_int(0, 0, 0)
               |
                  call_te.line > 0 | unify::set_pos(mctx.ctx, call_te.line, call_te.col)
                  unify::add_error(mctx.ctx, 3130,
                    "Compile-time parameter '${cp.name}' requires an argument.")
                  ct_res += 1
                  ct_vtes += tast::mk_lit_int(0, 0, 0)
         |
            ct_is_val += 0
            ct_vtes += tast::mk_lit_unit(0, 0)
            explicit_ok' = <->
            arg_idx' < n_args
               |
                  arg_t = args(arg_idx')!!
                  c_at = unify::canon(mctx.ctx, arg_t.ut)
                  is_tp = c_at [Prim p] p [Type] | <->
                  is_ul = arg_t.kind [LitUnit]
                  has_extra = (n_args - arg_idx') > ?eff_params
                  is_tp || (is_ul && has_extra)
                     |
                        rtv = resolve_typed_arg_type(mctx.ctx, mctx.env, arg_t)
                        rtv.3
                           |
                              explicit_ok' = <+>
                              ct_res += 1
                              ct_uts += rtv.0
                              ct_tis += rtv.1
                              ct_dts += rtv.2
                              arg_idx' = arg_idx' + 1
            !explicit_ok'
               |
                  ct_res += 0
                  ct_uts += unify::UType(None)
                  ct_tis += ast::TypeInfo(Prim, ast::ValueType(Unknown))
                  ct_dts += ""
   rt_args = tast::TypedExprs()
   (n_args - arg_idx') @ ri => rt_args += args(arg_idx' + ri)!!
   bkey = {64}
   bkey += cname
   all_ct_ground' = <+>
   n_cps @ ci =>
      bkey += '$
      ct_is_val(ci)!! == 1
         | bkey += ct_val_mono_key(ct_vtes(ci)!!)
         |
            ct_res(ci)!! == 1
               |
                  u_c = ct_uts(ci)!!
                  ti_c = ct_tis(ci)!!
                  dt_c = ct_dts(ci)!!
                  !unify::is_ground(mctx.ctx, u_c) | (all_ct_ground' = <->)
                  bkey += utype_type_key(mctx.ctx, mctx.env, u_c, ti_c, dt_c)
               |
                  has_explicit_sig
                     |
                        inf = extract_ct_from_sig(mctx.ctx, mctx.env, sig_fn.1, sig_fn.3,
                          rt_args, call_te.ut, call_te.ti, ct_names(ci)!!)
                        !inf.3 | (all_ct_ground' = <->)
                        !unify::is_ground(mctx.ctx, inf.0) | (all_ct_ground' = <->)
                        ct_res(ci) = 1 !| _
                        ct_uts(ci) = inf.0 !| _
                        ct_tis(ci) = inf.1 !| _
                        ct_dts(ci) = inf.2 !| _
                        bkey += utype_type_key(mctx.ctx, mctx.env, inf.0, inf.1, inf.2)
                     |
                        all_ct_ground' = <->
                        bkey += "Unknown"
   !all_ct_ground'
      | --| tast::TypedExpr(tast::TypedExprKind(Call, (cname, <-->, rt_args)),
        call_te.ut, call_te.ti, call_te.layout, call_te.line, call_te.col)
   has_poison_in' = <->
   n_cps @ ci_p =>
      ct_is_val(ci_p)!! == 0 && ct_res(ci_p)!! == 1 && unify::is_poison(mctx.ctx, ct_uts(ci_p)!!)
         | (has_poison_in' = <+>)
   rt_args @ ra_p =>
      unify::is_poison(mctx.ctx, ra_p.ut) | (has_poison_in' = <+>)
   has_poison_in'
      |
         unify::unify(mctx.ctx, call_te.ut, unify::poison_utype!)
         p_lay = layout::compute_layout(mctx.ctx, call_te.ut)
         --| tast::TypedExpr(tast::TypedExprKind(Call, (cname, <-->, rt_args)),
           call_te.ut, call_te.ti, p_lay, call_te.line, call_te.col)
   mono_name = +bkey
   !has_name_in(mctx.mono_done, mono_name)
      |
         done2 = mctx.mono_done
         done2 += mono_name
         mctx.mono_done = done2
         saved_file = mctx.ctx.cur_file
         saved_line = mctx.ctx.cur_line
         saved_col = mctx.ctx.cur_col
         saved_stack = clone_inst_stack(mctx.ctx.inst_stack)
         spec_errs0 = unify::error_count(mctx.ctx)
         call_line = call_te.line > 0 | call_te.line | saved_line
         call_col = call_te.col > 0 | call_te.col | saved_col
         decl_file = assign_idx < ?cur_stmt_files | (cur_stmt_files(assign_idx) | _ | cur_source_file) | cur_source_file
         decl_line = assign_idx < ?cur_stmt_lines | (cur_stmt_lines(assign_idx) | _ | 0) | 0
         decl_col = assign_idx < ?cur_stmt_cols | (cur_stmt_cols(assign_idx) | _ | 0) | 0
         saved_mod = mctx.env.current_module
         saved_fn_name = cur_fn_name
         saved_ct_t_n = ?cur_ct_types
         saved_ct_v_n = ?cur_ct_vals
         saved_ct_c_n = ?cur_ct_cursors
         saved_ct_i_n = ?cur_ct_ints
         saved_exp = cur_expected_ut
         saved_in_fn = mctx.env.in_fn
         saved_fn_ret = mctx.env.cur_fn_ret
         saved_disc = mctx.env.discard_result
         saved_swz = mctx.env.swizzle_mode
         saved_init = type_env::init_snapshot(mctx.env)
         saved_views = ++view_vars
         view_vars ::= ast::Names()
         type_env::set_current_module(mctx.env, type_env::decl_module(cname, 0))
         cur_fn_name ::= mono_name
         mctx.env.swizzle_mode = active_swizzle_mode_at(mctx.exprs, assign_idx)
         unify::push_inst_frame(mctx.ctx, unify::InstFrame(
           mono_name, cname, decl_file, decl_line, decl_col,
           saved_file, call_line, call_col))
         set_stmt_loc_at(mctx.ctx, assign_idx)
         n_cps @ ci =>
            ct_is_val(ci)!! == 1
               | push_ct_val(ct_names(ci)!!, ct_vtes(ci)!!, <+>)
               | push_ct_type(ct_names(ci)!!, ct_uts(ci)!!, ct_tis(ci)!!, ct_dts(ci)!!)
         type_env::enter_scope(mctx.env)
         mctx.env.in_fn = <+>
         mctx.env.init = type_env::new_init!
         p_uts = unify::UTypes()
         p_vts = ast::VTypes()
         p_tis = ast::VInfos()
         ?eff_params @ pi =>
            pname = eff_params(pi)!!
            has_decl_p = has_explicit_sig && pi < ?sig_fn.1 &&
              !(sig_fn.1(pi)!! [Prim vt] vt [Unknown] | <->)
            p_info = has_decl_p
               |
                  pti_raw = sig_fn.1(pi)!!
                  pti_res = resolve_ct_ti_aliases(mctx.env, pti_raw)
                  put_d0 = utype_from_ti_env(mctx.env, pti_raw)
                  put_d = put_d0 [None] utype_from_ti_env(mctx.env, pti_res) | put_d0
                  put_final = put_d [None] unify::fresh_var(mctx.ctx) | put_d
                  (put_final, pti_res)
               |
                  fv = unify::fresh_var(mctx.ctx)
                  pi < ?rt_args | unify::unify(mctx.ctx, fv, (rt_args(pi)!!).ut)
                  arg_ti_pi = pi < ?rt_args
                     | (rt_args(pi)!!).ti
                     | unify::type_info_from_utype(mctx.ctx, fv)
                  (fv, arg_ti_pi)
            p_uts += p_info.0
            p_vts += vt_of_resolved_ti(p_info.1)
            p_tis += p_info.1
            pname != ""
               |
                  type_env::bind_local(mctx.env, pname, p_info.0, p_info.1, <->)
                  type_env::init_mark_whole(mctx.env, pname)
         has_decl_ret = has_explicit_sig && !(sig_fn.3 [Prim vt] vt [Unknown] | <->) &&
           !(sig_fn.3 [TypeVar tv] tv == "?Ret" | <->)
         decl_ret_ti' = has_decl_ret
            | resolve_ct_ti_aliases(mctx.env, sig_fn.3)
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         ret_var = has_decl_ret
            |
               r_d0 = utype_from_ti_env(mctx.env, sig_fn.3)
               r_d = r_d0 [None] utype_from_ti_env(mctx.env, decl_ret_ti') | r_d0
               r_d [None] unify::fresh_var(mctx.ctx) | r_d
            | unify::fresh_var(mctx.ctx)
         c_ret_v = unify::canon(mctx.ctx, ret_var)
         is_ret_unit = c_ret_v [Prim p] p [Unit] | <->
         mctx.env.cur_fn_ret = <+ ret_var +>
         mctx.env.discard_result = is_ret_unit
         cur_expected_ut ::= has_decl_ret | <+ ret_var +> | <-->
         check_no_closing_return(mctx.ctx, fe.body)
         body_te = annotate_expr(mctx.ctx, mctx.env, fe.body)
         type_env::init_restore(mctx.env, saved_init)
         type_env::leave_scope(mctx.env)
         mctx.env.in_fn = saved_in_fn
         mctx.env.cur_fn_ret = saved_fn_ret
         mctx.env.discard_result = saved_disc
         mctx.env.swizzle_mode = saved_swz
         type_env::set_current_module(mctx.env, saved_mod)
         cur_expected_ut ::= saved_exp
         is_view_expr(fe.body)
            | unify::add_error(mctx.ctx, 3150, diag::E3150_view_escape_frame!)
         view_vars ::= saved_views
         pop_ct_types_to(saved_ct_t_n)
         pop_ct_vals_to(saved_ct_v_n)
         pop_ct_cursors_to(saved_ct_c_n)
         pop_ct_ints_to(saved_ct_i_n)
         cur_fn_name ::= saved_fn_name
         spec_body_err = unify::error_count(mctx.ctx) > spec_errs0
         !spec_body_err
            |
               ok_ret = is_ret_unit || expr_is_jump(body_te) ||
                 unify::unify(mctx.ctx, ret_var, body_te.ut)
               !ok_ret
                  | unify::add_error(mctx.ctx, 3084,
                    diag::return_type_mismatch_prefix! + mono_name)
         spec_had_err = unify::error_count(mctx.ctx) > spec_errs0
         spec_had_err
            |
               unify::unify(mctx.ctx, call_te.ut, unify::poison_utype!)
            |
               final_ret_ut = is_ret_unit
                  | unify::prim_unit!
                  | (expr_is_jump(body_te) | ret_var | body_te.ut)
               unify::unify(mctx.ctx, call_te.ut, final_ret_ut)
               final_ret_ti = has_decl_ret
                  | decl_ret_ti'
                  | unify::type_info_from_utype(mctx.ctx, final_ret_ut)
               final_ret_vt = vt_of_resolved_ti(final_ret_ti)
               mono_fn_ut = unify::mk_fn(p_uts, final_ret_ut)
               mono_fn_ti = ast::TypeInfo(Fn, (p_vts, p_tis, final_ret_vt,
                 final_ret_ti, ast::CParams()))
               mono_lam = mk_lambda_te_at(eff_params, body_te, mono_fn_ut, mono_fn_ti,
                 fe.line, fe.col)
               spec_stack = clone_inst_stack(mctx.ctx.inst_stack)
               w2 = mctx.work
               w2 += tast::TypedStmt(Binding, (mono_name, mono_fn_ti, mono_lam, <->))
               mctx.work = w2
               wf2 = mctx.work_files
               wf2 += decl_file
               mctx.work_files = wf2
               wl2 = mctx.work_lines
               wl2 += decl_line
               mctx.work_lines = wl2
               wc2 = mctx.work_cols
               wc2 += decl_col
               mctx.work_cols = wc2
               ws2 = mctx.work_stacks
               ws2 += spec_stack
               mctx.work_stacks = ws2
         mctx.ctx.inst_stack = saved_stack
         unify::set_location(mctx.ctx, saved_file, saved_line, saved_col)
   ret_ti2 = call_te.ti
   ret_lay2 = layout::compute_layout(mctx.ctx, call_te.ut)
   tast::TypedExpr(tast::TypedExprKind(Call, (mono_name, <-->, rt_args)),
     call_te.ut, ret_ti2, ret_lay2, call_te.line, call_te.col)

mono_rewrite_list = mctx, tes =>
   out = tast::TypedExprs()
   tes @ te => out += mono_rewrite_expr(mctx, te)
   out

mono_rewrite_expr = mctx, te =>
   new_kind = te.kind
      [Bin b]
         tast::TypedExprKind(Bin, (b.0, mono_rewrite_expr(mctx, b.1),
           mono_rewrite_expr(mctx, b.2)))
      [Unary u]
         tast::TypedExprKind(Unary, (u.0, mono_rewrite_expr(mctx, u.1)))
      [Call c]
         new_tgt = c.1 | t => <+ mono_rewrite_expr(mctx, t) +> | <-->
         new_args = mono_rewrite_list(mctx, c.2)
         is_gen = c.0 != "" && !<>(new_tgt) && has_name_in(mctx.gen_names, c.0)
         is_gen
            | --| mono_specialize_call(mctx, te, c.0, new_args)
            | tast::TypedExprKind(Call, (c.0, new_tgt, new_args))
      [Record r]
         new_r = tast::TypedFields()
         r @ rf => new_r += tast::TypedField(rf.name,
           mono_rewrite_expr(mctx, rf.val), rf.offset, rf.ut)
         tast::TypedExprKind(Record, new_r)
      [Member m]
         tast::TypedExprKind(Member, (mono_rewrite_expr(mctx, m.0), m.1, m.2))
      [MemberWrite mw]
         tast::TypedExprKind(MemberWrite, (mono_rewrite_expr(mctx, mw.0),
           mw.1, mw.2, mono_rewrite_expr(mctx, mw.3)))
      [Index idx]
         tast::TypedExprKind(Index, (mono_rewrite_expr(mctx, idx.0),
           mono_rewrite_expr(mctx, idx.1)))
      [KeyAccess ka]
         tast::TypedExprKind(KeyAccess, (mono_rewrite_expr(mctx, ka.0),
           mono_rewrite_expr(mctx, ka.1), ka.2, ka.3))
      [IndexWrite iw]
         tast::TypedExprKind(IndexWrite, (mono_rewrite_expr(mctx, iw.0),
           mono_rewrite_expr(mctx, iw.1), mono_rewrite_expr(mctx, iw.2)))
      [Choice ch]
         new_brs = tast::TypedBranches()
         ch.1 @ br =>
            new_cvs = mono_rewrite_list(mctx, br.case_values)
            new_pred = br.pred_fn | p => <+ mono_rewrite_expr(mctx, p) +> | <-->
            new_brs += tast::TypedBranch(br.kind, new_cvs, new_pred,
              br.variant_names, br.bind_vars, mono_rewrite_expr(mctx, br.body))
         tast::TypedExprKind(Choice, (mono_rewrite_expr(mctx, ch.0), new_brs))
      [Lambda lm]
         tast::TypedExprKind(Lambda, (lm.0, mono_rewrite_expr(mctx, lm.1), lm.2))
      [Block bk]
         tast::TypedExprKind(Block, mono_rewrite_list(mctx, bk))
      [Assign a]
         tast::TypedExprKind(Assign, (a.0, a.1, a.2, a.3, a.4,
           mono_rewrite_expr(mctx, a.5)))
      [Cycle cy]
         new_esc = cy.2 | es => <+ mono_rewrite_expr(mctx, es) +> | <-->
         tast::TypedExprKind(Cycle, (mono_rewrite_expr(mctx, cy.0),
           mono_rewrite_expr(mctx, cy.1), new_esc, cy.3))
      [BuilderNew bn]
         tast::TypedExprKind(BuilderNew, mono_rewrite_expr(mctx, bn))
      [Copy cp]
         tast::TypedExprKind(Copy, mono_rewrite_expr(mctx, cp))
      [RawMemory rm]
         tast::TypedExprKind(RawMemory, (mono_rewrite_expr(mctx, rm.0), rm.1))
      [RawMemoryWrite rmw]
         tast::TypedExprKind(RawMemoryWrite, (mono_rewrite_expr(mctx, rmw.0),
           mono_rewrite_expr(mctx, rmw.1)))
      [MapLiteral ml]
         new_ml = tast::TypedMapPairs()
         ml @ p => new_ml += tast::TypedMapPair(
           mono_rewrite_expr(mctx, p.key), mono_rewrite_expr(mctx, p.val))
         tast::TypedExprKind(MapLiteral, new_ml)
      [RamConstruct rc]
         new_pay = rc.2 | p => <+ mono_rewrite_expr(mctx, p) +> | <-->
         tast::TypedExprKind(RamConstruct, (rc.0, rc.1, new_pay))
      [EnumConstruct ec]
         new_pay = ec.1 | p => <+ mono_rewrite_expr(mctx, p) +> | <-->
         tast::TypedExprKind(EnumConstruct, (ec.0, new_pay))
      [Exit e]
         tast::TypedExprKind(Exit, mono_rewrite_expr(mctx, e))
      [Return r]
         new_r = r | v => <+ mono_rewrite_expr(mctx, v) +> | <-->
         tast::TypedExprKind(Return, new_r)
      | te.kind
   tast::TypedExpr(new_kind, te.ut, te.ti, te.layout, te.line, te.col)

monomorphize_program_stmts: unify::Ctx, type_env::TypeEnv, ast::Exprs,
  ast::Names, tast::TypedStmts, ast::Names, ast::Ints, ast::Ints => MonoResult
monomorphize_program_stmts = ctx, env, exprs, gen_names, stmts, st_files, st_lines, st_cols =>
   init_stacks = MonoWorkStacks()
   ?stmts @ init_stacks += unify::InstStack()
   mctx = MonoCtx(ctx, env, exprs, gen_names, ast::Names(), stmts,
     ++st_files, ++st_lines, ++st_cols, init_stacks)
   rewritten = tast::TypedStmts()
   i' = 0
   0.. @
      i' !< ?mctx.work | -->
      st = mctx.work(i')!!
      w_f = i' < ?mctx.work_files | mctx.work_files(i')!! | cur_source_file
      w_l = i' < ?mctx.work_lines | mctx.work_lines(i')!! | 0
      w_c = i' < ?mctx.work_cols | mctx.work_cols(i')!! | 0
      unify::set_location(mctx.ctx, w_f, w_l, w_c)
      w_stk = i' < ?mctx.work_stacks
         | clone_inst_stack(mctx.work_stacks(i')!!)
         | unify::InstStack()
      mctx.ctx.inst_stack = w_stk
      is_inv_bnd = st [Binding b] has_name_in(invalid_scc_fns, b.0) | <->
      st_out = is_inv_bnd
         | st
         |
            st
               [Expr te] tast::TypedStmt(Expr, mono_rewrite_expr(mctx, te))
               [Binding b] tast::TypedStmt(Binding,
                 (b.0, b.1, mono_rewrite_expr(mctx, b.2), b.3))
               [GlobalBinding gb] tast::TypedStmt(GlobalBinding,
                 (gb.0, gb.1, mono_rewrite_expr(mctx, gb.2)))
               | st
      rewritten += st_out
      i' = i' + 1
   mctx.ctx.inst_stack = unify::InstStack()
   MonoResult(rewritten, mctx.work_files, mctx.work_lines, mctx.work_cols, mctx.work_stacks)

solve_expr_unconstrained_rams: unify::Ctx, tast::TypedExpr => ()
solve_expr_list_rams: unify::Ctx, tast::TypedExprs => ()

solve_expr_list_rams = ctx, tes =>
   tes @ te => solve_expr_unconstrained_rams(ctx, te)

solve_expr_unconstrained_rams = ctx, te =>
   solve_unconstrained_rams(ctx, te.ut)
   te.kind
      [Bin b]
         solve_expr_unconstrained_rams(ctx, b.1)
         solve_expr_unconstrained_rams(ctx, b.2)
      [Unary u] solve_expr_unconstrained_rams(ctx, u.1)
      [Call c]
         c.1 | t => solve_expr_unconstrained_rams(ctx, t)
         solve_expr_list_rams(ctx, c.2)
      [Record r]
         r @ rf => solve_expr_unconstrained_rams(ctx, rf.val)
      [Member m] solve_expr_unconstrained_rams(ctx, m.0)
      [MemberWrite mw]
         solve_expr_unconstrained_rams(ctx, mw.0)
         solve_expr_unconstrained_rams(ctx, mw.3)
      [Index idx]
         solve_expr_unconstrained_rams(ctx, idx.0)
         solve_expr_unconstrained_rams(ctx, idx.1)
      [KeyAccess ka]
         solve_expr_unconstrained_rams(ctx, ka.0)
         solve_expr_unconstrained_rams(ctx, ka.1)
      [IndexWrite iw]
         solve_expr_unconstrained_rams(ctx, iw.0)
         solve_expr_unconstrained_rams(ctx, iw.1)
         solve_expr_unconstrained_rams(ctx, iw.2)
      [Choice ch]
         solve_expr_unconstrained_rams(ctx, ch.0)
         ch.1 @ br =>
            solve_expr_list_rams(ctx, br.case_values)
            br.pred_fn | p => solve_expr_unconstrained_rams(ctx, p)
            solve_expr_unconstrained_rams(ctx, br.body)
      [Lambda lm] solve_expr_unconstrained_rams(ctx, lm.1)
      [Block bk] solve_expr_list_rams(ctx, bk)
      [Assign a] solve_expr_unconstrained_rams(ctx, a.5)
      [Cycle cy]
         solve_expr_unconstrained_rams(ctx, cy.0)
         solve_expr_unconstrained_rams(ctx, cy.1)
         cy.2 | e => solve_expr_unconstrained_rams(ctx, e)
      [BuilderNew bn] solve_expr_unconstrained_rams(ctx, bn)
      [Copy cp] solve_expr_unconstrained_rams(ctx, cp)
      [RawMemory rm] solve_expr_unconstrained_rams(ctx, rm.0)
      [RawMemoryWrite rmw]
         solve_expr_unconstrained_rams(ctx, rmw.0)
         solve_expr_unconstrained_rams(ctx, rmw.1)
      [MapLiteral ml]
         ml @ p =>
            solve_expr_unconstrained_rams(ctx, p.key)
            solve_expr_unconstrained_rams(ctx, p.val)
      [RamConstruct rc]
         rc.2 | p => solve_expr_unconstrained_rams(ctx, p)
      [EnumConstruct ec]
         ec.1 | p => solve_expr_unconstrained_rams(ctx, p)
      [Exit e] solve_expr_unconstrained_rams(ctx, e)
      [Return r]
         r | v => solve_expr_unconstrained_rams(ctx, v)

solve_program_unconstrained_rams: unify::Ctx, tast::TypedStmts => ()
solve_program_unconstrained_rams = ctx, stmts =>
   stmts @ st =>
      st
         [Expr te] solve_expr_unconstrained_rams(ctx, te)
         [Binding b] solve_expr_unconstrained_rams(ctx, b.2)
         [GlobalBinding gb] solve_expr_unconstrained_rams(ctx, gb.2)

verify_typed_expr_ground: unify::Ctx, tast::TypedExpr => <>
verify_list_ground: unify::Ctx, tast::TypedExprs => <>

verify_list_ground = ctx, tes =>
   tes @ te =>
      !verify_typed_expr_ground(ctx, te) | --| <->
   <+>

/// Recursively checks that every reachable node in `te` has a ground type.
verify_typed_expr_ground = ctx, te =>
   te.kind [PoisonError] | --| <+>
   te.kind
      [CtUnrollCycle]
         te.line > 0 | unify::set_pos(ctx, te.line, te.col)
         unify::add_error(ctx, 3084, "'#members' cycle was not statically unrolled.")
         --| <->
      [Lambda lm]
         !unify::is_ground(ctx, te.ut)
            |
               te.line > 0 | unify::set_pos(ctx, te.line, te.col)
               unify::add_error(ctx, 3103,
                 "Lambda type could not be statically determined. (inferred signature: ${unify::show_utype(ctx, te.ut)})")
               --| <->
         --| verify_typed_expr_ground(ctx, lm.1)
      [Bin b]
         !verify_typed_expr_ground(ctx, b.1) | --| <->
         !verify_typed_expr_ground(ctx, b.2) | --| <->
      [Unary u]
         !verify_typed_expr_ground(ctx, u.1) | --| <->
      [Call c]
         c.1 | t => !verify_typed_expr_ground(ctx, t) | --| <->
         !verify_list_ground(ctx, c.2) | --| <->
      [Record r]
         r @ rf => !verify_typed_expr_ground(ctx, rf.val) | --| <->
      [Member m]
         !verify_typed_expr_ground(ctx, m.0) | --| <->
      [MemberWrite mw]
         !verify_typed_expr_ground(ctx, mw.0) | --| <->
         !verify_typed_expr_ground(ctx, mw.3) | --| <->
      [Index idx]
         !verify_typed_expr_ground(ctx, idx.0) | --| <->
         !verify_typed_expr_ground(ctx, idx.1) | --| <->
      [KeyAccess ka]
         !verify_typed_expr_ground(ctx, ka.0) | --| <->
         !verify_typed_expr_ground(ctx, ka.1) | --| <->
      [IndexWrite iw]
         !verify_typed_expr_ground(ctx, iw.0) | --| <->
         !verify_typed_expr_ground(ctx, iw.1) | --| <->
         !verify_typed_expr_ground(ctx, iw.2) | --| <->
      [Choice ch]
         !verify_typed_expr_ground(ctx, ch.0) | --| <->
         ch.1 @ br =>
            !verify_list_ground(ctx, br.case_values) | --| <->
            br.pred_fn | p => !verify_typed_expr_ground(ctx, p) | --| <->
            !verify_typed_expr_ground(ctx, br.body) | --| <->
      [Block bk]
         !verify_list_ground(ctx, bk) | --| <->
      [Assign a]
         !verify_typed_expr_ground(ctx, a.5) | --| <->
      [Cycle cy]
         !verify_typed_expr_ground(ctx, cy.0) | --| <->
         !verify_typed_expr_ground(ctx, cy.1) | --| <->
         cy.2 | e => !verify_typed_expr_ground(ctx, e) | --| <->
      [BuilderNew bn]
         !verify_typed_expr_ground(ctx, bn) | --| <->
      [Copy cp]
         !verify_typed_expr_ground(ctx, cp) | --| <->
      [RawMemory rm]
         !verify_typed_expr_ground(ctx, rm.0) | --| <->
      [RawMemoryWrite rmw]
         !verify_typed_expr_ground(ctx, rmw.0) | --| <->
         !verify_typed_expr_ground(ctx, rmw.1) | --| <->
      [MapLiteral ml]
         ml @ p =>
            !verify_typed_expr_ground(ctx, p.key) | --| <->
            !verify_typed_expr_ground(ctx, p.val) | --| <->
      [RamConstruct rc]
         rc.2 | p => !verify_typed_expr_ground(ctx, p) | --| <->
      [EnumConstruct ec]
         ec.1 | p => !verify_typed_expr_ground(ctx, p) | --| <->
      [Exit e]
         !verify_typed_expr_ground(ctx, e) | --| <->
      [Return r]
         r | v => !verify_typed_expr_ground(ctx, v) | --| <->
   !unify::is_ground(ctx, te.ut)
      |
         te.line > 0 | unify::set_pos(ctx, te.line, te.col)
         unify::add_error(ctx, 3103, diag::E3103_cannot_infer_type!)
         --| <->
   <+>

verify_program_ground: unify::Ctx, tast::TypedStmts, ast::Names, ast::Ints, ast::Ints, MonoWorkStacks => ()
verify_program_ground = ctx, stmts, files, lines, cols, stacks =>
   stmts @ st, si =>
      sf = si < ?files | files(si)!! | cur_source_file
      sl = si < ?lines | lines(si)!! | 0
      sc = si < ?cols | cols(si)!! | 0
      unify::set_location(ctx, sf, sl, sc)
      cur_stk = si < ?stacks | clone_inst_stack(stacks(si)!!) | unify::InstStack()
      ctx.inst_stack = cur_stk
      st
         [Expr te] verify_typed_expr_ground(ctx, te)
         [Binding b]
            !has_name_in(invalid_scc_fns, b.0)
               | verify_typed_expr_ground(ctx, b.2)
         [GlobalBinding gb] verify_typed_expr_ground(ctx, gb.2)
   ctx.inst_stack = unify::InstStack()

elaborate_program_with_ctx: ast::Exprs => < ElabProgCtx | unify::TypeErrors >
elaborate_program_with_ctx = exprs =>
   ctx = unify::new_ctx!
   unify::set_file(ctx, cur_source_file)
   cur_program_exprs ::= exprs
   invalid_scc_fns ::= ast::Names()
   env = type_env::new_env!
   view_vars ::= ast::Names()
   declared_fns ::= ast::Names()
   called_fns ::= ast::Names()
   user_fns ::= ast::Names()
   value_used_fns ::= ast::Names()
   fn_alias_vars ::= ast::Names()
   fn_alias_tgts ::= ast::Names()

   // 1a. Pre-register user type names (enables recursive & mutual types)
   exprs @ e_td0 =>
      e_td0
         [TypeDecl td0]
            td0_mod = type_env::decl_module(td0.name, 0)
            type_env::set_current_module(env, td0_mod)
            is_enum0 = td0.type_info [Enum]
            init_ut = is_enum0
               |
                  unify::UType(Enum, unify::UEnum(td0.name,
                    unify::UEnumVariants()))
               | unify::fresh_var(ctx)
            type_env::bind_user_type(env, td0.name, td0.type_info, init_ut)

   // 1b. Multi-pass type resolution for forward & mutually recursive types
   3 @ _pass =>
      exprs @ e_td =>
         e_td
            [TypeDecl td]
               type_env::set_current_module(env,
                 type_env::decl_module(td.name, 0))
               td_ut_raw = utype_from_ti_env(env, td.type_info)
               td_ut' = td_ut_raw
               td_ut_raw
                  [Enum ue]
                     td_ut' = unify::UType(Enum, unify::UEnum(td.name,
                       ue.variants))
                  [Rec flds]
                     is_alias = td.type_info [TypeVar]
                     !is_alias
                        |
                           named_flds = unify::UFields()
                           flds @ fld =>
                              named_flds += unify::UField(fld.name, fld.ut, td.name)
                           td_ut' = unify::UType(Rec, named_flds)
               old_def = type_env::lookup_user_type_exact(env, td.name)
               old_def
                  | od => unify::unify(ctx, od.ut, td_ut')
               type_env::bind_user_type(env, td.name, td.type_info, td_ut')

   // 1c. Register enum variants
   exprs @ e_ev =>
      e_ev
         [TypeDecl td_ev]
            ev_opt = type_env::lookup_user_type(env, td_ev.name)
            ev_opt
               | udef => register_enum_variants(env, td_ev.name, udef.ut)

   gen_names = ast::Names()
   exprs @ e_scan =>
      e_scan
         [Assign ascan]
            ascan.3 && ascan.0 != ""
               | type_env::mark_global_var(env, ascan.0)
            is_fe = ascan.5 [Fn fes] (?fes.ct_params > 0) | <->
            is_gen = is_generic_sig(ascan) || is_fe
            is_gen && ascan.0 != "" | gen_names += ascan.0

   // 1d. Forward declarations & #foreign bindings first (independent of file order)
   exprs @ e_decl, i_decl =>
      set_stmt_loc_at(ctx, i_decl)
      e_decl
         [Assign a]
            is_fwd_assign(a)
               |
                  type_env::set_current_module(env, type_env::decl_module(a.0, 0))
                  has_prior = a.0 != "" &&
                    (has_name_in(declared_fns, a.0) ||
                      has_name_in(user_fns, a.0) ||
                      <>(type_env::lookup_binding(env, a.0)))
                  has_prior
                     |
                        unify::add_error(ctx, 3033,
                          diag::reassign_immutable(a.0))
                  is_generic_sig(a)
                     |
                        a.0 != "" | declared_fns += a.0
                        type_env::bind_generic(env, a.0, a.8)
                     |
                        decl_ut = utype_from_ti_env(env, a.8)
                        is_g = a.3 || type_env::is_marked_global(env, a.0)
                        is_g
                           | type_env::bind_global(env, a.0, decl_ut, a.8)
                           | type_env::bind_local(env, a.0, decl_ut, a.8, a.1)
                        c_decl = unify::canon(ctx, decl_ut)
                        is_fn = c_decl [Fn]
                        is_fn && a.0 != "" | declared_fns += a.0
                        is_bf = is_bitfield_ti_env(env, a.8)
                        is_growable = is_growable_ti_env(env, a.8)
                        is_bf || is_growable
                           | type_env::init_mark_whole(env, a.0)
                           |
                              !is_fn && !is_g
                                 |
                                    type_env::init_mark_tracked(env, a.0)
                                    mark_bitfield_fields_whole(env, a.0, a.8)
         [Foreign f]
            f_mod = type_env::decl_module(f.dva_name, 0)
            type_env::set_current_module(env, f_mod)
            register_foreign_decl(env, f)

   // 1d.5. Propagate declared tuple/record function-field types to named target fns
   exprs @ e_rf =>
      e_rf
         [Assign a]
            !is_fwd_assign(a) && !a.2 && !a.4
               |
                  a.5
                     [Fn fe]
                        cur_mod = type_env::decl_module(a.0, 0)
                        type_env::set_current_module(env, cur_mod)
                        bnd_opt = type_env::lookup_local(env, a.0)
                        bnd_opt
                           | bnd =>
                              c_fn = unify::canon(ctx, bnd.ut)
                              c_fn
                                 [Fn exp_fn]
                                    c_ret = unify::canon(ctx, exp_fn.ret)
                                    c_ret
                                       [Rec exp_fs]
                                          rec_exprs = ast::Exprs()
                                          collect_body_records(fe.body, rec_exprs)
                                          rec_exprs @ re_e =>
                                             re_e
                                                [Record rec_e]
                                                   rec_e.fields @ rf, idx =>
                                                      exp_ut_opt = rf.name != ""
                                                         |
                                                            f_i = unify::find_field_idx(exp_fs, rf.name)
                                                            f_i !< 0 | <+ exp_fs(f_i)!!.ut +> | <-->
                                                         |
                                                            idx < ?exp_fs | <+ exp_fs(idx)!!.ut +> | <-->
                                                      exp_ut_opt
                                                         | exp_u =>
                                                            ef_ut = unify::canon(ctx, exp_u)
                                                            ef_ut
                                                               [Fn ef_fn]
                                                                  rf.val
                                                                     [Var target_fn]
                                                                        q_target = resolve_local_fn_assign_name(exprs, cur_mod, target_fn)
                                                                        q_target != "" && !has_name_in(declared_fns, q_target) && !<>(type_env::lookup_local_exact(env, q_target))
                                                                           |
                                                                              t_idx = find_assign_idx(exprs, q_target)
                                                                              t_idx !< 0
                                                                                 |
                                                                                    exprs(t_idx)!!
                                                                                       [Assign ta]
                                                                                          !ta.2 && !ta.4
                                                                                             |
                                                                                                ta.5
                                                                                                   [Fn tfe]
                                                                                                      ?tfe.ct_params == 0 && ?tfe.params == ?ef_fn.params
                                                                                                         |
                                                                                                            ef_ti = unify::type_info_from_utype(ctx, ef_ut)
                                                                                                            type_env::bind_local(env, q_target, ef_ut, ef_ti, <->)
                                                                                                            declared_fns += q_target

   // 1e. Function definitions & pre-bound literals/module values
   exprs @ e_def, i_def =>
      set_stmt_loc_at(ctx, i_def)
      e_def
         [Assign a]
            !is_fwd_assign(a) && !a.2 && !a.4
               |
                  type_env::set_current_module(env, type_env::decl_module(a.0, 0))
                  a.5
                     [Fn fe]
                        a.0 != "" && has_name_in(user_fns, a.0)
                           |
                              msg_rf = diag::reassign_immutable(a.0)
                              unify::add_error(ctx, 3033, msg_rf)
                           |
                              a.0 != "" | (user_fns += a.0)
                              is_comp_fn = ?fe.params == 1 &&
                                (fe.params(0) | p0 => ?p0 > 6 && p0(0..6) == "_comp_" | <->)
                              is_comp_fn && a.0 != "" && !has_name_in(declared_fns, a.0)
                                 | (declared_fns += a.0)
                              already_gen = type_env::lookup_generic(env, a.0)
                              has_already_gen = <>(already_gen)
                              ?fe.ct_params > 0 && !has_already_gen
                                 |
                                    check_no_closing_return(ctx, fe.body)
                                    p_vinfos = ast::VInfos()
                                    ?fe.params @ p_k =>
                                       p_ti = ast::TypeInfo(TypeVar, "T")
                                       p_vinfos += p_ti
                                    ti_ret =
                                       ast::TypeInfo(TypeVar, "?Ret")
                                    fn_ti = ast::TypeInfo(Fn,
                                      (ast::VTypes(), p_vinfos,
                                        ast::ValueType(Unknown),
                                        ti_ret, ast::CParams()))
                                    type_env::bind_generic(env,
                                      a.0, fn_ti)
                     |
                        is_g = a.3 || type_env::is_marked_global(env, a.0)
                        already = is_g
                           | type_env::lookup_binding(env, a.0)
                           | type_env::lookup_local(env, a.0)
                        has_already = <>(already)
                        is_coll = a.0 != "" && has_name_in(user_fns, a.0)
                        is_coll
                           |
                              msg_rc = diag::reassign_immutable(a.0)
                              unify::add_error(ctx, 3033, msg_rc)
                        is_lit = a.5
                           [Int, Float, Str, Rune] <+>
                           [TypeCast tc] (tc.expr [Int, Float, Str, Rune])
                           | <->
                        is_mod = type_env::name_is_qualified(a.0, 0)
                        can_pre = !has_already && !is_coll &&
                          (is_lit || is_mod) && a.0 != ""
                        can_pre
                           |
                              rhs = annotate_expr(ctx, env, a.5)
                              type_env::bind_local(env, a.0, rhs.ut,
                                rhs.ti, a.1)

   check_missing_fwd_defs(ctx, exprs)

   // 2. Build dependency graph and partition into SCCs
   graph = dep_graph::build_dep_graph(exprs)
   sccs = dep_graph::tarjan_scc(graph)

   // 3. Process SCCs in reverse topological order (leaf-first)
   sccs @ scc =>
      scc.names @ fname1 =>
         fname1 != "" && !dep_graph::has_name(gen_names, fname1)
            |
               m1 = type_env::decl_module(fname1, 0)
               type_env::set_current_module(env, m1)
               prebind_scc(ctx, env, exprs, fname1)
      scc.names @ fname2 =>
         fname2 != "" && !dep_graph::has_name(gen_names, fname2)
            |
               m2 = type_env::decl_module(fname2, 0)
               type_env::set_current_module(env, m2)
               annotate_scc(ctx, env, exprs, fname2, scc.is_recursive)

   // 4. Elaborate all program statements
   env.swizzle_mode = active_swizzle_mode_at(exprs, 0)
   typed_stmts = tast::TypedStmts()
   stmt_files = ast::Names()
   stmt_lines = ast::Ints()
   stmt_cols = ast::Ints()
   exprs @ e_stmt, i_stmt =>
      set_stmt_loc_at(ctx, i_stmt)
      st_f = i_stmt < ?cur_stmt_files | (cur_stmt_files(i_stmt) | _ | cur_source_file) | cur_source_file
      st_l = i_stmt < ?cur_stmt_lines | (cur_stmt_lines(i_stmt) | _ | 0) | 0
      st_c = i_stmt < ?cur_stmt_cols | (cur_stmt_cols(i_stmt) | _ | 0) | 0
      stmt_mod0 = i_stmt < ?cur_stmt_mods | (cur_stmt_mods(i_stmt) | _ | "") | ""
      is_skip' = <->
      e_stmt
         [Assign a_stmt]
            a_mod = a_stmt.0 != "" | type_env::decl_module(a_stmt.0, 0) | stmt_mod0
            type_env::set_current_module(env, a_mod)
            is_fwd = is_fwd_assign(a_stmt)
            is_gen = dep_graph::has_name(gen_names, a_stmt.0)
            (is_fwd || is_gen) | (is_skip' = <+>)
         [Foreign f_stmt]
            f_mod2 = type_env::decl_module(f_stmt.dva_name, 0)
            type_env::set_current_module(env, f_mod2)
            is_skip' = <+>
         [TypeDecl td_stmt]
            td_mod = type_env::decl_module(td_stmt.name, 0)
            type_env::set_current_module(env, td_mod)
            is_skip' = <+>
         | type_env::set_current_module(env, stmt_mod0)
      !is_skip'
         |
            env.discard_result = <+>
            te = annotate_expr(ctx, env, e_stmt)
            solve_unconstrained_rams(ctx, te.ut)
            (te.kind [UserDiag])
               | unify::unify(ctx, te.ut, unify::prim_unit!)
            ground_ok = unify::is_ground(ctx, te.ut)
            !ground_ok
               |
                  unify::add_error(ctx, 3103, diag::E3103_cannot_infer_type!)
            typed_stmts += tast::TypedStmt(Expr, te)
            stmt_files += st_f
            stmt_lines += st_l
            stmt_cols += st_c

   // 4.5. Solve deferred constraints (e.g. calls/indexing on type variables)
   unify::solve_constraints(ctx, ctx.constraints)

   // 5. Check that all function parameters in SCCs are ground
   sccs @ scc_k =>
      scc_k.names @ fname3 =>
         fname3 != "" && !dep_graph::has_name(gen_names, fname3)
            |
               m3 = type_env::decl_module(fname3, 0)
               type_env::set_current_module(env, m3)
               check_ground(ctx, env, exprs, fname3)
   ?fn_alias_vars @
      ?fn_alias_vars @ ai =>
         avn = fn_alias_vars(ai) | _ | ""
         has_name_in(called_fns, avn)
            |
               tgt = fn_alias_tgts(ai) | _ | ""
               tgt != "" && !has_name_in(called_fns, tgt)
                  | (called_fns += tgt)
   value_used_fns @ vfn =>
      vfn != "" && !has_name_in(declared_fns, vfn) && !has_name_in(called_fns, vfn)
         |
            unify::add_error(ctx, 3128,
              "Function '" + vfn + diag::E3128_function_value_signature_suffix! + vfn + ": T1, T2 => R'.")

   pre_refreshed = refresh_program_stmts(ctx, typed_stmts)
   mono_res = monomorphize_program_stmts(ctx, env, exprs, gen_names,
     pre_refreshed, stmt_files, stmt_lines, stmt_cols)
   solve_program_unconstrained_rams(ctx, mono_res.stmts)
   final_stmts = refresh_program_stmts(ctx, mono_res.stmts)
   verify_program_ground(ctx, final_stmts, mono_res.files, mono_res.lines,
     mono_res.cols, mono_res.stacks)

   unify::has_errors(ctx)
      | <- ctx.errors +>
      | <+ ElabProgCtx(final_stmts, ctx) ->

elaborate_program: ast::Exprs => < tast::TypedProgram | unify::TypeErrors >
elaborate_program = exprs =>
   res = elaborate_program_with_ctx(exprs)
   res
      | pair => <+ pair.prog ->
      | errs => <- errs +>

annotate_exprs: ast::Exprs => ElabProgResult
annotate_exprs = exprs =>
   res = elaborate_program_with_ctx(exprs)
   res
      | pair =>
         tp = pair.prog
         ctx = pair.ctx
         nodes = count_program_nodes(tp)
         sz = program_layout_size(tp)
         stats = ElabStats(?tp, nodes, ctx.next_var, sz)
         <+ ElabSuccess(tp, stats, ctx) ->
      | errs =>
         <- errs +>

annotate_program: ast::Expr => ElabProgResult
annotate_program = raw_prog =>
   prog = overloads::resolve(raw_prog)
   exprs' = ast::Exprs()
   prog
      [Block b]
         exprs' = b
      | exprs' += prog
   annotate_exprs(exprs')
