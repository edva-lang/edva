// src/pkg.dva — the Edva package manager: dependency-graph resolution,
// edva.lock.ccl writing, and the .edva/imports.ccl map the compiler consumes.
//
// Contract: process/packages.md §2, §4–§7, §13 (issues #97, #101). The
// compiler never fetches; this tool is the only component that touches git,
// archives, or the network. Sources are kept in a minimal content store
// (git mirrors, extracted trees); verification hardening is #102.

#use ./diag
#use ascii
#use ccl
#use cli
#use fs
#use libc
#use path
#use str
#use sys
#use unicode
#use ./version
#use log

#foreign "c"
   getpid: () => Int
   getenv: (name: String) => Addr

#public

#type Strings String{}
#type SMap String ^ String

// --- Package Schema Data Model (#97, #98) -----------------------------------

#type DepKind < Git, Path, Archive >

#type PackageDep (
   alias: String,
   kind: DepKind,
   git_url: String,
   git_rev: String,
   path: String,
   archive_url: String,
   archive_hash: String,
   target: String
)

#type PackageDeps PackageDep{}

#type BuildTarget (
   name: String,
   src: String,
   out: String,
   target: String,
   opt: String,
   cflags: Strings
)

#type BuildTargets BuildTarget{}

#type GenerateStep (
   name: String,
   cmd: String,
   src: String,
   out: String
)

#type GenerateSteps GenerateStep{}

#type PackageManifest (
   name: String,
   version: String,
   edva: String,
   deps: PackageDeps,
   native_libs: Strings,
   native_pkg_config: Strings,
   overrides: PackageDeps,
   generate: GenerateSteps,
   targets: BuildTargets
)

#type LockDep (
   alias: String,
   id: String
)

#type LockDeps LockDep{}

#type LockPackage (
   id: String,
   kind: DepKind,
   git_url: String,
   git_rev: String,
   git_commit: String,
   archive_url: String,
   archive_hash: String,
   path: String,
   deps: LockDeps,
   is_override: <>
)

#type LockPackages LockPackage{}

#type Lockfile (
   lock_version: Int,
   packages: LockPackages,
   root_deps: LockDeps
)

#type BuildKeyResult (
   key: String,
   meta_text: String
)

#type CacheCodegenFlags (
   is_module: <>,
   is_shared: <>,
   no_runtime: <>,
   no_main: <>,
   module_name: String
)

#type PkgOpts (
   root: String,
   locked: <>,
   offline: <>,
   store: String,
   git: String,
   cache: String,
   no_cache: <>,
   is_update: <>,
   update_alias: String,
   target_filter: String
)

#type AddOpts (
   alias: String,
   kind: DepKind,
   git_url: String,
   git_rev: String,
   path: String,
   archive_url: String,
   archive_hash: String,
   pkg_opts: PkgOpts
)

// One resolved package instance (a lockfile entry plus the data the import
// map needs: the package name and the on-disk source directory).
#type Inst (pkg: LockPackage, name: String, src: String, key: String, dir: String)
#type Insts Inst{}

// A dependency after applying root overrides: where its tree lives and how it
// is identified.
#type Fetched (
   name: String,
   dir: String,
   id: String,
   key: String,
   pkg: LockPackage,
   manifest: PackageManifest
)

#type Resolver (
   opts: PkgOpts,
   insts: Insts,
   done: SMap,
   stack: Strings,
   memo: SMap,
   hashes: SMap,
   fetched: SMap,
   overrides: SMap,
   libs: Strings,
   pkg_config: Strings,
   tmp_n: Int,
   vendor_pkgs: SMap,
   vendor_git: SMap,
   vendor_archive: SMap,
   vendor_paths: SMap
)

// The language version this compiler implements (`edva = X.Y` minimum, §9).
#public
   lang_version = version::VERSION

// --- small utilities ---------------------------------------------------------

#private
   clean_semver: String => String
   clean_semver = v =>
      b = {?v}
      ?v @ i =>
         c = v(i)
         c == '+ || c == '- | -->
         b += c
      +b

   out: String => ()
   out = s =>
      libc::write(1, s + "\n", ?s + 1)

   fail: Int, String => <>
   fail = code, msg =>
      log::error("E" + str::from_int(code) + ": " + msg)
      <->

   getenv_opt: String => < String | >
   getenv_opt = name =>
      sys::addr_opt(getenv(name))
         | p => <+ sys::c_str(p) +>
         | <-->

   env_or: String, String => String
   env_or = name, dflt =>
      v = getenv_opt(name) | s => s | ""
      v == "" | dflt | v

   file_exists: String => <>
   file_exists = path => fs::exists(path) && !fs::is_dir(path)

   dir_exists: String => <>
   dir_exists = path => fs::is_dir(path)

   path_join: String, String => String
   path_join = a, b => path::join(a, b)

   dirname: String => String
   dirname = p => path::dirname(p)

   canonical_path: String => String
   canonical_path = p => fs::resolve(p)

   mkdir_p: String => <>
   mkdir_p = path => fs::create_dir_all(path)

   read_text: String => < String | >
   read_text = path => fs::read_to_string(path)

   // Write via a sibling temp file + rename so readers never see a torn file.
   write_text: String, String => <>
   write_text = path, text =>
      tmp = path + ".tmp" + str::from_int(getpid!)
      ok = fs::write_file(tmp, text)
      !ok |
         fs::remove(tmp)
         --| <->
      fs::rename_path(tmp, path)

   trim: String => String
   trim = s =>
      start' = 0
      end' = ?s
      0.. @
         start' !< end' | -->
         c = s(start')
         c == '\s || c == '\t || c == '\n || c == '\r | start' = start' + 1 | -->
      0.. @
         end' !> start' | -->
         c = s(end' - 1)
         c == '\s || c == '\t || c == '\n || c == '\r | end' = end' - 1 | -->
      s(start'..end')

   starts_with: String, String => <>
   starts_with = s, p => ?s !< ?p && s(..?p) == p

   ends_with: String, String => <>
   ends_with = s, suf => ?s !< ?suf && s(?s - ?suf..) == suf

   basename: String => String
   basename = p => path::basename(p)

   clean_pkg_name: String => String
   clean_pkg_name = s =>
      b = {64}
      ?s @ i =>
         c = s(i)
         ascii::is_upper(c) | b += ascii::to_lower(c)
         ascii::is_lower(c) | b += c
         ascii::is_digit(c) | b += c
         c == '- || c == '_ | b += '_
      res = +b
      ?res == 0
         | "my_pkg"
         |
            c0 = res(0)
            !ascii::is_lower(c0) | "pkg_" + res | res

   is_valid_identifier: String => <>
   is_valid_identifier = s => unicode::is_uax31(s)

   is_sha_commit: String => <>
   is_sha_commit = s =>
      ?s != 40 |->
      ok' = <+>
      0..40 @ i =>
         c = s(i)
         !ascii::is_hex(c) | ok' = <->; -->
      ok'

   pkg_base_name: String => String
   pkg_base_name = id =>
      at_idx' = 0 - 1
      ?id @ i => id(i) == '@ | at_idx' = i; -->
      at_idx' < 0 | id | id(..at_idx')

   split_char: String, Int => Strings
   split_char = s, ch =>
      out: Strings
      cur = {32}
      ?s @ i =>
         c = s(i)
         c == ch
            | out += +cur
            | cur += c
      out += +cur
      out

   // Single-quote a string for /bin/sh.
   sq: String => String
   sq = s =>
      b = {?s + 8}
      b += 39
      ?s @ i =>
         c = s(i)
         c == 39
            | b += "'\\''"
            | b += c
      b += 39
      +b

   sh: String => Int
   sh = cmd =>
      st = libc::system(cmd)
      st < 0 | --| -1
      (st .>. 8) .&. 255

   // The path of `to` relative to directory `from` (both absolute).
   relpath: String, String => String
   relpath = from, to => path::rel(from, to)

   // FNV-1a-style hash of the bytes as 16 hex digits: stable store names.
   fnv_hex: String => String
   fnv_hex = s =>
      h' = 0x4bf29ce484222325
      ?s @ i =>
         c = Int(s(i))
         h' = h' .^. c
         h' = h' * 0x100000001b3
      b = {16}
      16 @ i =>
         nib = (h' .>. (60 - i * 4)) .&. 15
         b += ascii::hex_char_lower(nib)
      +b

   names_has: Strings, String => <>
   names_has = xs, x =>
      found' = <->
      xs @ y => y == x | found' = <+>; -->
      found'

   add_unique: Strings, String => Strings
   add_unique = xs, x =>
      out = ++xs
      !names_has(xs, x) | out += x
      out

   // Dotted-integer version comparison: a < b.
   version_lt: String, String => <>
   version_lt = a, b =>
      a_parts = split_char(a, '+)
      b_parts = split_char(b, '+)
      a_base = a_parts(0) | _ | a
      b_base = b_parts(0) | _ | b
      pa = split_char(a_base, '.)
      pb = split_char(b_base, '.)
      n = ?pa > ?pb | ?pa | ?pb
      res' = <->
      n @ i =>
         sa = pa(i) | _ | "0"
         sb = pb(i) | _ | "0"
         va = str::to_int(sa) | p => p.0 | 0 - 1
         vb = str::to_int(sb) | p => p.0 | 0 - 1
         va != vb
            |
               res' = va < vb
               -->
      res'

// --- resolver state ----------------------------------------------------------

#public
   is_valid_alias: String => <>
   is_valid_alias = alias =>
      n = ?alias
      n == 0 | <-> |
         first = alias(0)
         is_start = first ['a...'z, 'A...'Z, '_] || first > 0x7F
         !is_start | <-> |
            ok' = <+>
            1..n @ i =>
               c = alias(i)
               is_cont = c ['a...'z, 'A...'Z, '0...'9, '_] || c > 0x7F
               !is_cont | ok' = <->; -->
            ok'

   is_valid_package_name: String => <>
   is_valid_package_name = name =>
      n = ?name
      n == 0 | <-> |
         first = name(0)
         first !['a...'z] | <-> |
            ok' = <+>
            1..n @ i =>
               c = name(i)
               c !['a...'z, '0...'9, '_] | ok' = <->; -->
            ok'

   is_valid_version: String => <>
   is_valid_version = ver =>
      n = ?ver
      n == 0 | <-> |
         ok' = <+>
         seg_len' = 0
         dots' = 0
         0..n @ i =>
            c = ver(i)
            c == '.
               |
                  seg_len' == 0 | ok' = <->; -->
                  seg_len' = 0
                  dots' = dots' + 1
               |
                  c !['0...'9]
                     | ok' = <->; -->
                     | seg_len' = seg_len' + 1
         ok' && dots' > 0 && seg_len' > 0

   sort_deps: PackageDeps => PackageDeps
   sort_deps = deps =>
      n = ?deps
      n < 2 | deps |
         out: PackageDeps
         deps @ d => out += d
         1..n @ i =>
            key = out(i) | _ | PackageDep("", DepKind(Path), "", "", "", "", "", "")
            j' = i
            0.. @
               j' !> 0 | -->
               prev = out(j' - 1) | _ | PackageDep("", DepKind(Path), "", "", "", "", "", "")
               str::cmp(prev.alias, key.alias) > 0
                  |
                     out(j') = prev !| _
                     j' = j' - 1
                  | -->
            out(j') = key !| _
         out

   validate_dep: ccl::CclEntry, String => < PackageDep | Error >
   validate_dep = e, file =>
      alias = e.key
      !is_valid_alias(alias)
         | <- ccl::ccl_error(file, "edva.ccl: invalid dependency alias '" + alias + "'", e.line, e.col) +>
         |
            e.val
               [Block ddoc]
                  has_err' = <->
                  err_val' = ccl::ccl_error(file, ++"", 0, 0)
                  ddoc @ dde =>
                     !has_err' |
                        k = dde.key
                        is_known = k ["git", "rev", "path", "url", "hash", "target", "/"]
                        !is_known |
                           has_err' = <+>
                           k
                              ["submodule", "submodules"]
                                 err_val' = ccl::ccl_error(file,
                                    "edva.ccl: dependency '" + alias +
                                    "': git submodules are not supported",
                                    dde.line, dde.col)
                              ["subdir"]
                                 err_val' = ccl::ccl_error(file,
                                    "edva.ccl: dependency '" + alias +
                                    "': package subdirectory selection ('subdir') is not supported in v1",
                                    dde.line, dde.col)
                              |
                                 err_val' = ccl::ccl_error(file,
                                    "edva.ccl: unknown key 'dependencies." + alias + "." + k + "'",
                                    dde.line, dde.col)
                  has_err'
                     | <- err_val' +>
                     |
                        has_git = ccl::has(ddoc, "git")
                        has_path = ccl::has(ddoc, "path")
                        has_url = ccl::has(ddoc, "url")
                        dep_target = ccl::get(ddoc, "target") | _ | ""
                        count' = 0
                        has_git | count' = count' + 1
                        has_path | count' = count' + 1
                        has_url | count' = count' + 1

                        count' != 1
                           |
                              <- ccl::ccl_error(file,
                                 "edva.ccl: dependency '" + alias +
                                 "' must specify exactly one of: git, path, url",
                                 e.line, e.col) +>
                           |
                              has_git
                                 |
                                    g_url = ccl::get(ddoc, "git") | _ | ""
                                    opt_rev = ccl::get(ddoc, "rev")
                                    opt_rev
                                       | rev =>
                                          <+ PackageDep(alias, DepKind(Git), g_url, rev, "", "", "", dep_target) ->
                                       |
                                          <- ccl::ccl_error(file,
                                             "edva.ccl: dependency '" + alias + "' needs 'rev'",
                                             e.line, e.col) +>
                                 |
                                    has_path
                                       |
                                          p = ccl::get(ddoc, "path") | _ | ""
                                          <+ PackageDep(alias, DepKind(Path), "", "", p, "", "", dep_target) ->
                                       |
                                          u = ccl::get(ddoc, "url") | _ | ""
                                          opt_hash = ccl::get(ddoc, "hash")
                                          opt_hash
                                             | h =>
                                                <+ PackageDep(alias, DepKind(Archive),
                                                   "", "", "", u, h, dep_target) ->
                                             |
                                                <- ccl::ccl_error(file,
                                                   "edva.ccl: dependency '" + alias + "' needs 'hash'",
                                                   e.line, e.col) +>
               [Str]
                  <- ccl::ccl_error(file,
                     "edva.ccl: dependency '" + alias + "' must be a section", e.line, e.col) +>

   split_words_ccl: String => Strings
   split_words_ccl = s =>
      res: Strings
      n = ?s
      i' = 0
      0.. @
         i' = ccl::trim_left_idx(s, i')
         i' !< n | -->
         start = i'
         0.. @
            i' !< n || ccl::is_space(s(i')) | -->
            i' = i' + 1
         res += s(start..i')
      res

   validate_target: ccl::CclEntry, String => < BuildTarget | Error >
   validate_target = e, file =>
      tname = e.key
      !is_valid_alias(tname)
         | <- ccl::ccl_error(file, "edva.ccl: invalid target name '" + tname + "'", e.line, e.col) +>
         |
            e.val
               [Block tdoc]
                  has_err' = <->
                  err_val' = ccl::ccl_error(file, ++"", 0, 0)
                  tdoc @ te =>
                     !has_err' |
                        k = te.key
                        is_known = k ["src", "out", "target", "opt", "cflags", "/"]
                        !is_known |
                           has_err' = <+>
                           err_val' = ccl::ccl_error(file,
                              "edva.ccl: unknown key 'targets." + tname + "." + k + "'",
                              te.line, te.col)
                  has_err'
                     | <- err_val' +>
                     |
                        src = ccl::get(tdoc, "src") | s => s | ""
                        out_p = ccl::get(tdoc, "out") | s => s | ""
                        triple = ccl::get(tdoc, "target") | s => s | ""
                        opt = ccl::get(tdoc, "opt") | s => s | ""
                        cflags: Strings
                        ccl::get_list(tdoc, "cflags")
                           | clist => cflags = clist
                           |
                              ccl::get(tdoc, "cflags")
                                 | cstr => cflags = split_words_ccl(cstr)
                        <+ BuildTarget(tname, src, out_p, triple, opt, cflags) ->
               [Str]
                  <- ccl::ccl_error(file,
                     "edva.ccl: target '" + tname + "' must be a section", e.line, e.col) +>

   validate_generate: ccl::CclEntry, String => < GenerateStep | Error >
   validate_generate = e, file =>
      gname = e.key
      !is_valid_alias(gname)
         | <- ccl::ccl_error(file, "edva.ccl: invalid generate step name '" + gname + "'", e.line, e.col) +>
         |
            e.val
               [Block gdoc]
                  has_err' = <->
                  err_val' = ccl::ccl_error(file, ++"", 0, 0)
                  gdoc @ ge =>
                     !has_err' |
                        k = ge.key
                        is_known = k ["cmd", "src", "out", "/"]
                        !is_known |
                           has_err' = <+>
                           err_val' = ccl::ccl_error(file,
                              "edva.ccl: unknown key 'generate." + gname + "." + k + "'",
                              ge.line, ge.col)
                  has_err'
                     | <- err_val' +>
                     |
                        cmd = ccl::get(gdoc, "cmd") | s => s | ""
                        src = ccl::get(gdoc, "src") | s => s | ""
                        out_p = ccl::get(gdoc, "out") | s => s | ""
                        cmd == ""
                           | <- ccl::ccl_error(file,
                              "edva.ccl: generate '" + gname + "' needs 'cmd'",
                              e.line, e.col) +>
                           | <+ GenerateStep(gname, cmd, src, out_p) ->
               [Str]
                  <- ccl::ccl_error(file,
                     "edva.ccl: generate '" + gname + "' must be a section", e.line, e.col) +>

   validate_manifest: ccl::CclDoc, String => < PackageManifest | Error >
   validate_manifest = doc, file =>
      has_err' = <->
      err_val' = ccl::ccl_error(file, ++"", 0, 0)

      doc @ e =>
         k = e.key
         is_known = k ["name", "version", "edva", "dependencies", "native", "overrides", "generate", "targets", "/"]
         !is_known && !has_err'
            |
               has_err' = <+>
               err_val' = ccl::ccl_error(file, "edva.ccl: unknown key '" + k + "'", e.line, e.col)

      !has_err' && ccl::count(doc, "name") > 1
         |
            has_err' = <+>
            err_val' = ccl::ccl_error(file, "edva.ccl: duplicate key 'name'", 1, 1)
      !has_err' && ccl::count(doc, "version") > 1
         |
            has_err' = <+>
            err_val' = ccl::ccl_error(file, "edva.ccl: duplicate key 'version'", 1, 1)
      !has_err' && ccl::count(doc, "edva") > 1
         |
            has_err' = <+>
            err_val' = ccl::ccl_error(file, "edva.ccl: duplicate key 'edva'", 1, 1)

      pkg_name' = ++""
      pkg_ver' = ++""
      edva_ver' = ++""

      !has_err'
         |
            opt_name = ccl::get(doc, "name")
            opt_name
               | n =>
                  !is_valid_package_name(n)
                     |
                        has_err' = <+>
                        err_val' = ccl::ccl_error(file,
                           "edva.ccl: package name '" + n +
                           "' must be a lowercase snake_case identifier", 1, 1)
                     | pkg_name' = n
               |
                  has_err' = <+>
                  err_val' = ccl::ccl_error(file, "edva.ccl: missing required key 'name'", 1, 1)

      !has_err'
         |
            opt_ver = ccl::get(doc, "version")
            opt_ver
               | v =>
                  !is_valid_version(v)
                     |
                        has_err' = <+>
                        err_val' = ccl::ccl_error(file,
                           "edva.ccl: invalid version format: '" + v + "'", 1, 1)
                     | pkg_ver' = v
               |
                  has_err' = <+>
                  err_val' = ccl::ccl_error(file, "edva.ccl: missing required key 'version'", 1, 1)

      !has_err'
         |
            opt_edva = ccl::get(doc, "edva")
            opt_edva
               | ev => edva_ver' = ev
               | edva_ver' = ++""

      deps: PackageDeps
      !has_err'
         |
            opt_deps = ccl::get_section(doc, "dependencies")
            opt_deps
               | ddoc =>
                  ddoc @ de =>
                     de.key != "/" && !has_err'
                        |
                           dep_res = validate_dep(de, file)
                           dep_res
                              | pdep => deps += pdep
                              | e =>
                                 has_err' = <+>
                                 err_val' = e

      native_libs: Strings
      native_pkg_config: Strings
      !has_err'
         |
            opt_native = ccl::get_section(doc, "native")
            opt_native
               | ndoc =>
                  ndoc @ ne =>
                     k = ne.key
                     is_k = k ["libs", "pkg-config", "/"]
                     !is_k && !has_err'
                        |
                           has_err' = <+>
                           err_val' = ccl::ccl_error(file, "edva.ccl: unknown key 'native." + k + "'",
                              ne.line, ne.col)

                  !has_err'
                     |
                        nl = ccl::get_list(ndoc, "libs")
                        nl | l => native_libs = l
                        np = ccl::get_list(ndoc, "pkg-config")
                        np | p => native_pkg_config = p

      overrides: PackageDeps
      !has_err'
         |
            opt_ovr = ccl::get_section(doc, "overrides")
            opt_ovr
               | odoc =>
                  odoc @ oe =>
                     oe.key != "/" && !has_err'
                        |
                           oe.val
                              [Block oblock]
                                 path_opt = ccl::get(oblock, "path")
                                 path_opt
                                    | p =>
                                       overrides += PackageDep(oe.key, DepKind(Path),
                                          "", "", p, "", "", "")
                                    |
                                       has_err' = <+>
                                       err_val' = ccl::ccl_error(file,
                                          "edva.ccl: override '" + oe.key + "' needs 'path'",
                                          oe.line, oe.col)
                              [Str]
                                 has_err' = <+>
                                 err_val' = ccl::ccl_error(file,
                                    "edva.ccl: override '" + oe.key + "' must be a section",
                                    oe.line, oe.col)

      generate: GenerateSteps
      !has_err'
         |
            opt_gen = ccl::get_section(doc, "generate")
            opt_gen
               | gdoc =>
                  gdoc @ ge =>
                     ge.key != "/" && !has_err'
                        |
                           gres = validate_generate(ge, file)
                           gres
                              | gstep => generate += gstep
                              | e =>
                                 has_err' = <+>
                                 err_val' = e

      targets: BuildTargets
      !has_err'
         |
            opt_targets = ccl::get_section(doc, "targets")
            opt_targets
               | tdoc =>
                  tdoc @ te =>
                     te.key != "/" && !has_err'
                        |
                           tres = validate_target(te, file)
                           tres
                              | tgt => targets += tgt
                              | e =>
                                 has_err' = <+>
                                 err_val' = e

      has_err'
         | <- err_val' +>
         |
            <+ PackageManifest(
               pkg_name',
               pkg_ver',
               edva_ver',
               sort_deps(deps),
               ccl::sort_strings(native_libs),
               ccl::sort_strings(native_pkg_config),
               sort_deps(overrides),
               generate,
               targets
            ) ->

   manifest_to_ccl: PackageManifest => String
   manifest_to_ccl = m =>
      b = {512}
      b += "name = " + m.name + "\n"
      b += "version = " + m.version + "\n"
      m.edva != "" | b += "edva = " + m.edva + "\n"

      ?m.deps > 0
         |
            b += "\ndependencies =\n"
            sorted_deps = sort_deps(m.deps)
            sorted_deps @ d =>
               b += "  " + d.alias + " =\n"
               d.kind
                  [Git]
                     b += "    git = " + d.git_url + "\n"
                     b += "    rev = " + d.git_rev + "\n"
                  [Path]
                     b += "    path = " + d.path + "\n"
                  [Archive]
                     b += "    url = " + d.archive_url + "\n"
                     b += "    hash = " + d.archive_hash + "\n"
               d.target != "" | b += "    target = " + d.target + "\n"

      has_native = ?m.native_libs > 0 || ?m.native_pkg_config > 0
      has_native
         |
            b += "\nnative =\n"
            ?m.native_libs > 0
               |
                  b += "  libs =\n"
                  sorted_libs = ccl::sort_strings(m.native_libs)
                  sorted_libs @ lib =>
                     b += "    = " + lib + "\n"
            ?m.native_pkg_config > 0
               |
                  b += "  pkg-config =\n"
                  sorted_pkg = ccl::sort_strings(m.native_pkg_config)
                  sorted_pkg @ pkg =>
                     b += "    = " + pkg + "\n"

      ?m.overrides > 0
         |
            b += "\noverrides =\n"
            sorted_ovr = sort_deps(m.overrides)
            sorted_ovr @ o =>
               b += "  " + o.alias + " =\n"
               b += "    path = " + o.path + "\n"

      ?m.generate > 0
         |
            b += "\ngenerate =\n"
            m.generate @ g =>
               b += "  " + g.name + " =\n"
               g.cmd != "" | b += "    cmd = " + g.cmd + "\n"
               g.src != "" | b += "    src = " + g.src + "\n"
               g.out != "" | b += "    out = " + g.out + "\n"

      ?m.targets > 0
         |
            b += "\ntargets =\n"
            m.targets @ t =>
               b += "  " + t.name + " =\n"
               t.src != "" | b += "    src = " + t.src + "\n"
               t.out != "" | b += "    out = " + t.out + "\n"
               t.target != "" | b += "    target = " + t.target + "\n"
               t.opt != "" | b += "    opt = " + t.opt + "\n"
               ?t.cflags > 0
                  |
                     b += "    cflags =\n"
                     t.cflags @ cf =>
                        b += "      = " + cf + "\n"

      +b

   sort_lock_packages: LockPackages => LockPackages
   sort_lock_packages = pkgs =>
      n = ?pkgs
      n < 2 | pkgs |
         out: LockPackages
         pkgs @ p => out += p
         empty_deps: LockDeps
         1..n @ i =>
            key = out(i) | _ |
               LockPackage("", DepKind(Path), "", "", "", "", "", "", empty_deps, <->)
            j' = i
            0.. @
               j' !> 0 | -->
               prev = out(j' - 1) | _ |
                  LockPackage("", DepKind(Path), "", "", "", "", "", "", empty_deps, <->)
               str::cmp(prev.id, key.id) > 0
                  |
                     out(j') = prev !| _
                     j' = j' - 1
                  | -->
            out(j') = key !| _
         out

   sort_lock_deps: LockDeps => LockDeps
   sort_lock_deps = deps =>
      n = ?deps
      n < 2 | deps |
         out: LockDeps
         deps @ d => out += d
         1..n @ i =>
            key = out(i) | _ | LockDep("", "")
            j' = i
            0.. @
               j' !> 0 | -->
               prev = out(j' - 1) | _ | LockDep("", "")
               str::cmp(prev.alias, key.alias) > 0
                  |
                     out(j') = prev !| _
                     j' = j' - 1
                  | -->
            out(j') = key !| _
         out

   validate_lockfile: ccl::CclDoc, String => < Lockfile | Error >
   validate_lockfile = doc, file =>
      has_err' = <->
      err_val' = ccl::ccl_error(file, ++"", 0, 0)

      opt_ver_str = ccl::get(doc, "lock")
      ver' = 0
      opt_ver_str
         | vs =>
            d = str::to_int(vs)
            d
               | pair => ver' = pair.0
               |
                  has_err' = <+>
                  err_val' = ccl::ccl_error(file, "edva.lock.ccl: invalid lock version '" + vs + "'", 1, 1)
         |
            has_err' = <+>
            err_val' = ccl::ccl_error(file, "edva.lock.ccl: missing required key 'lock'", 1, 1)

      pkgs: LockPackages
      !has_err'
         |
            opt_pkgs_sec = ccl::get_section(doc, "packages")
            opt_pkgs_sec
               | psec =>
                  psec @ pe =>
                     pe.key != "/" && !has_err'
                        |
                           id = pe.key
                           pe.val
                              [Block pd]
                                 has_git = ccl::has(pd, "git")
                                 has_path = ccl::has(pd, "path")
                                 g_url = ccl::get(pd, "git") | _ | ""
                                 g_rev = ccl::get(pd, "rev") | _ | ""
                                 g_commit = ccl::get(pd, "commit") | _ | ""
                                 p_path = ccl::get(pd, "path") | _ | ""
                                 a_url = ccl::get(pd, "url") | _ | ""
                                 a_hash = ccl::get(pd, "hash") | _ | ""
                                 is_ovr = ccl::has(pd, "override")

                                 p_deps: LockDeps
                                 opt_deps_sec = ccl::get_section(pd, "deps")
                                 opt_deps_sec
                                    | ds =>
                                       ds @ dse =>
                                          dse.val [Str sid] p_deps += LockDep(dse.key, sid)

                                 k' = DepKind(Archive)
                                 has_path | k' = DepKind(Path)
                                 has_git | k' = DepKind(Git)
                                 pkgs += LockPackage(
                                    id, k', g_url, g_rev, g_commit,
                                    a_url, a_hash, p_path, sort_lock_deps(p_deps), is_ovr
                                 )
                              [Str]
                                 has_err' = <+>
                                 err_val' = ccl::ccl_error(file,
                                    "edva.lock.ccl: package '" + id + "' must be a section",
                                    pe.line, pe.col)

      root_deps: LockDeps
      !has_err'
         |
            opt_root_sec = ccl::get_section(doc, "root")
            opt_root_sec
               | rsec =>
                  rsec @ re =>
                     re.key != "/"
                        |
                           re.val [Str sid] root_deps += LockDep(re.key, sid)

      has_err'
         | <- err_val' +>
         | <+ Lockfile(ver', sort_lock_packages(pkgs), sort_lock_deps(root_deps)) ->

   lockfile_to_ccl: Lockfile => String
   lockfile_to_ccl = lock =>
      b = {1024}
      b += "lock = " + str::from_int(lock.lock_version) + "\n\n"

      b += "packages =\n"
      sorted_pkgs = sort_lock_packages(lock.packages)
      sorted_pkgs @ p =>
         b += "  " + p.id + " =\n"
         p.kind
            [Git]
               b += "    git = " + p.git_url + "\n"
               p.git_rev != "" | b += "    rev = " + p.git_rev + "\n"
               p.git_commit != "" | b += "    commit = " + p.git_commit + "\n"
               p.archive_hash != "" | b += "    hash = " + p.archive_hash + "\n"
            [Path]
               b += "    path = " + p.path + "\n"
               p.is_override | b += "    override = true\n"
            [Archive]
               b += "    url = " + p.archive_url + "\n"
               b += "    hash = " + p.archive_hash + "\n"

         ?p.deps > 0
            |
               b += "    deps =\n"
               sorted_deps = sort_lock_deps(p.deps)
               sorted_deps @ d =>
                  b += "      " + d.alias + " = " + d.id + "\n"

      b += "\nroot =\n"
      sorted_root = sort_lock_deps(lock.root_deps)
      sorted_root @ r =>
         b += "  " + r.alias + " = " + r.id + "\n"

      +b

#private
   empty_lock_pkg: () => LockPackage
   empty_lock_pkg = !=>
      deps: LockDeps
      LockPackage("", DepKind(Path), "", "", "", "", "", "", deps, <->)

   tmp_path: Resolver => String
   tmp_path = r =>
      r.tmp_n = r.tmp_n + 1
      dir = path_join(r.opts.store, "tmp")
      mkdir_p(dir)
      path_join(dir, str::from_int(getpid!) + "-" + str::from_int(r.tmp_n))

   capture: Resolver, String => < String | >
   capture = r, cmd =>
      out = tmp_path(r)
      rc = sh(cmd + " > " + sq(out) + " 2>/dev/null")
      txt = read_text(out)
      libc::unlink(out)
      rc != 0
         | <-->
         | txt
            | t => <+ trim(t) +>
            | <-->

   git_cmd: Resolver, String => String
   git_cmd = r, mirror =>
      "GIT_TERMINAL_PROMPT=0 " + sq(r.opts.git) + " -C " + sq(mirror) + " "

   mirror_dir: Resolver, String => String
   mirror_dir = r, url => path_join(path_join(r.opts.store, "git"), fnv_hex(url))

   load_manifest: String => < PackageManifest | >
   load_manifest = dir =>
      file = path_join(dir, "edva.ccl")
      ccl::parse_file(file)
         | doc =>
            validate_manifest(doc, file)
               | m => <+ m +>
               | e =>
                  fail(7001, e.msg + "\n  at " + e.file + ":" + str::from_int(e.line))
                  <-->
         | e =>
            fail(7001, e.msg)
            <-->

// --- git source --------------------------------------------------------------

#private
   ensure_mirror: Resolver, String, String => <>
   ensure_mirror = r, alias, url =>
      m = mirror_dir(r, url)
      dir_exists(m) | <+> |
         r.opts.offline
            | fail(7003, "offline: '" + alias + "' (" + url + ") is not in the store")
            |
               mkdir_p(dirname(m))
               tmp = tmp_path(r)
               rc = sh("GIT_TERMINAL_PROMPT=0 " + sq(r.opts.git) +
                  " clone --bare --quiet " + sq(url) + " " + sq(tmp) + " 2>/dev/null")
               rc != 0
                  |
                     sh("rm -rf " + sq(tmp))
                     fail(7011, "dependency '" + alias + "': cannot fetch " + url)
                  |
                     r.fetched ^ url = "1"
                     libc::rename(tmp, m) == 0 || dir_exists(m)

   // Refresh branches and (possibly moved) tags once per run.
   fetch_mirror: Resolver, String => ()
   fetch_mirror = r, url =>
      !r.opts.offline && !(r.fetched ^? url)
         |
            r.fetched ^ url = "1"
            sh(git_cmd(r, mirror_dir(r, url)) + "fetch --quiet --force " + sq(url) +
               " '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*' 2>/dev/null")

   has_commit: Resolver, String, String => <>
   has_commit = r, url, commit =>
      sh(git_cmd(r, mirror_dir(r, url)) + "cat-file -e " + sq(commit + "^{commit}") +
         " 2>/dev/null") == 0

   rev_parse: Resolver, String, String => < String | >
   rev_parse = r, url, rev =>
      capture(r, git_cmd(r, mirror_dir(r, url)) + "rev-parse --verify --quiet " +
         sq(rev + "^{commit}"))
         | c => <+ c +>
         |
            rev == "master"
               |
                  capture(r, git_cmd(r, mirror_dir(r, url)) + "rev-parse --verify --quiet " +
                     sq("main^{commit}"))
                     | c2 => <+ c2 +>
                     | capture(r, git_cmd(r, mirror_dir(r, url)) + "rev-parse --verify --quiet " +
                        sq("HEAD^{commit}"))
               | <-->

   // The locked commit for (url, rev) if the lock has one, else resolve the
   // moving reference against a freshly fetched mirror.
   resolve_commit: Resolver, String, String, String => < String | >
   resolve_commit = r, alias, url, rev =>
      key = url + "#" + rev
      v_dir' = ++ ""
      c_vend' = ++ ""
      r.memo ^? key
         |
            c_m = r.memo ^ key | _ | ""
            c_vend' = c_m
            v_dir' = r.vendor_git ^ (url + "#" + c_m) | _ | ""
      v_dir' == "" |
         v_dir' = r.vendor_git ^ (url + "#" + rev) | _ | ""
         c_vend' = rev
      v_dir' != "" && dir_exists(v_dir')
         | <+ c_vend' +>
         |
            !ensure_mirror(r, alias, url) | <--> |
               r.memo ^? key
                  |
                     c = r.memo ^ key | _ | ""
                     !has_commit(r, url, c) | fetch_mirror(r, url)
                     has_commit(r, url, c)
                        | <+ c +>
                        |
                           r.opts.offline
                              | fail(7003, "offline: '" + alias + "' (" + url + ") is not in the store")
                              | fail(7004, "dependency '" + alias + "': revision '" + c +
                                 "' not found in " + url)
                           <-->
                  |
                     r.opts.locked
                        |
                           fail(7007, diag::locked_manifest_stale_prefix! + alias + " changed)")
                           <-->
                        |
                           fetch_mirror(r, url)
                           rev_parse(r, url, rev)
                              | c =>
                                 r.memo ^ key = c
                                 <+ c +>
                              |
                                 fail(7004, "dependency '" + alias + "': revision '" + rev +
                                    "' not found in " + url)
                                 <-->

   check_tree_security: Resolver, String => <>
   check_tree_security = r, dir =>
      cmd = "(cd " + sq(dir) + " && root=\"$(pwd -P)\" && find . -mindepth 1 -type l | while IFS= read -r p; do " +
         "tgt=\"$(readlink \"$p\")\"; " +
         "case \"$tgt\" in /*) exit 2 ;; esac; " +
         "pdir=\"$(dirname \"$p\")\"; " +
         "tdir=\"$(cd \"$pdir\" && cd \"$(dirname \"$tgt\")\" 2>/dev/null && pwd -P)\"; " +
         "case \"$tdir\" in \"$root\"|\"$root\"/*) ;; *) exit 2 ;; esac; " +
         "done)"
      sh(cmd) == 0

   compute_tree_hash: Resolver, String => < String | >
   compute_tree_hash = r, dir =>
      tmp_l = tmp_path(r) + ".list"
      tmp_m = tmp_path(r) + ".manifest"
      cmd = "cd " + sq(dir) + " && find . -mindepth 1 \\( -name .git -o -name .edva -o -name .hg -o -name .svn \\) -prune -o \\( -type f -o -type l \\) -print | LC_ALL=C sort > " + sq(tmp_l) +
         " && while IFS= read -r p; do " +
         "rel=\"\${p#./}\"; " +
         "if [ -L \"$p\" ]; then " +
         "lnk=\"$(readlink \"$p\")\" || exit 1; " +
         "echo \"symlink $lnk $rel\"; " +
         "else " +
         "if [ -x \"$p\" ]; then mode=\"100755\"; else mode=\"100644\"; fi; " +
         "sum=\"$(sha256sum \"$p\")\" || exit 1; " +
         "echo \"\${sum%% *} $mode $rel\"; " +
         "fi; " +
         "done < " + sq(tmp_l) + " > " + sq(tmp_m) +
         " && out=\"$(sha256sum " + sq(tmp_m) + ")\" && echo \"\${out%% *}\""
      res = capture(r, cmd)
      libc::unlink(tmp_l)
      libc::unlink(tmp_m)
      res
         | h =>
            ?h == 64 | <+ "sha256-" + h +> | <-->
         | <-->

   checkout_git: Resolver, String, String, String, String => < (String, String) | >
   checkout_git = r, alias, url, commit, expected_hash =>
      v_dir = r.vendor_git ^ (url + "#" + commit) | _ | ""
      v_dir != "" && dir_exists(v_dir)
         |
            !check_tree_security(r, v_dir)
               |
                  fail(7019, "dependency '" + alias +
                     diag::repository_illegal_path_suffix!)
                  <-->
               |
                  compute_tree_hash(r, v_dir)
                     | tree_hash =>
                        expected_hash != "" && tree_hash != expected_hash
                           |
                              fail(7005, diag::vendor_tree_mismatch_prefix! + alias +
                                 "' (expected " + expected_hash + ", got " + tree_hash + ")")
                              <-->
                           | <+ (v_dir, (expected_hash != "" | expected_hash | tree_hash)) +>
                     | <-->
         |
            store_dir = expected_hash != "" | path_join(r.opts.store, expected_hash) | ""
            store_dir != "" && dir_exists(store_dir)
               | <+ (store_dir, expected_hash) +>
               |
                  r.opts.offline
                     |
                        fail(7003, "offline: '" + alias + "' (" + url + ") is not in the store")
                        <-->
                     |
                        tmp = tmp_path(r)
                        mkdir_p(tmp)
                        rc = sh(git_cmd(r, mirror_dir(r, url)) + "archive --format=tar " + sq(commit) +
                           " | tar -x -C " + sq(tmp) + " 2>/dev/null")
                        rc != 0
                           |
                              sh("rm -rf " + sq(tmp))
                              fail(7011, "dependency '" + alias + "': cannot check out " + url +
                                 " at " + commit)
                              <-->
                           |
                              !check_tree_security(r, tmp)
                                 |
                                    sh("rm -rf " + sq(tmp))
                                    fail(7019, "dependency '" + alias +
                                       diag::repository_illegal_path_suffix!)
                                    <-->
                                 |
                                    compute_tree_hash(r, tmp)
                                       | tree_hash =>
                                          expected_hash != "" && tree_hash != expected_hash
                                             |
                                                sh("rm -rf " + sq(tmp))
                                                fail(7005, "dependency '" + alias +
                                                   "': hash mismatch (expected " + expected_hash +
                                                   ", got " + tree_hash + ")")
                                                <-->
                                             |
                                                target = path_join(r.opts.store, tree_hash)
                                                mkdir_p(r.opts.store)
                                                dir_exists(target)
                                                   |
                                                      sh("rm -rf " + sq(tmp))
                                                      <+ (target, tree_hash) +>
                                                   |
                                                      ren_rc = libc::rename(tmp, target)
                                                      ren_rc == 0 || dir_exists(target)
                                                         | <+ (target, tree_hash) +>
                                                         |
                                                            sh("rm -rf " + sq(tmp))
                                                            fail(7011, "dependency '" + alias +
                                                               "': cannot publish tree to store")
                                                            <-->
                                       |
                                          sh("rm -rf " + sq(tmp))
                                          fail(7011, "dependency '" + alias +
                                             "': cannot hash tree for " + url)
                                          <-->

// --- archive source ----------------------------------------------------------

#private
   // An extracted archive's package root: the tree itself, or its single
   // top-level directory.
   archive_root: Resolver, String => String
   archive_root = r, dir =>
      file_exists(path_join(dir, "edva.ccl")) | dir |
         capture(r, "ls -A " + sq(dir))
            | listing =>
               entries = split_char(listing, '\n)
               only = entries(0) | _ | ""
               ?entries == 1 && dir_exists(path_join(dir, only))
                  | path_join(dir, only)
                  | dir
            | dir

   fetch_archive: Resolver, String, String, String => < String | >
   fetch_archive = r, alias, url, hash =>
      v_dir = r.vendor_archive ^ hash | _ | ""
      v_dir != "" && dir_exists(v_dir)
         |
            !check_tree_security(r, v_dir)
               |
                  fail(7019, "dependency '" + alias +
                     diag::archive_illegal_path_suffix!)
                  <-->
               |
                  compute_tree_hash(r, v_dir)
                     | tree_hash =>
                        expected_hash = r.hashes ^ hash | _ | ""
                        expected_hash != "" && tree_hash != expected_hash
                           |
                              fail(7005, diag::vendor_tree_mismatch_prefix! + alias +
                                 "' (expected " + expected_hash + ", got " + tree_hash + ")")
                              <-->
                           | <+ v_dir +>
                     | <+ v_dir +>
         |
            !starts_with(hash, "sha256-")
               |
                  fail(7005, "dependency '" + alias + "': unsupported hash '" + hash +
                     "' (expected sha256-<hex>)")
                  <-->
               |
                  store_dir = path_join(r.opts.store, hash)
                  dir_exists(store_dir) | <+ store_dir +> |
                     r.opts.offline
                        |
                           fail(7003, "offline: '" + alias + "' (" + url + ") is not in the store")
                           <-->
                        | download_archive(r, alias, url, hash, store_dir)

   download_archive: Resolver, String, String, String, String => < String | >
   download_archive = r, alias, url, hash, store_dir =>
      file = tmp_path(r) + ".tar.gz"
      is_local = !starts_with(url, "http://") && !starts_with(url, "https://") &&
         !starts_with(url, "file://")
      rc = is_local
         | sh("cp " + sq(url) + " " + sq(file) + " 2>/dev/null")
         | sh("curl -fsSL -o " + sq(file) + " " + sq(url) + " 2>/dev/null")
      rc != 0
         |
            libc::unlink(file)
            fail(7011, "dependency '" + alias + "': cannot fetch " + url)
            <-->
         |
            raw_h = capture(r, "out=\"$(sha256sum " + sq(file) + ")\" && echo \"\${out%% *}\"") | g => g | ""
            got = "sha256-" + raw_h
            ?raw_h != 64 || got != hash
               |
                  libc::unlink(file)
                  fail(7005, "dependency '" + alias + "': hash mismatch (expected " +
                     hash + ", got " + got + ")")
                  <-->
               |
                  has_traversal = sh("tar -tf " + sq(file) +
                     " 2>&1 | grep -E '(^/|/\\.\\./|\\.\\./|^\\.\\.$)' >/dev/null") == 0
                  has_traversal
                     |
                        libc::unlink(file)
                        fail(7019, "dependency '" + alias +
                           diag::archive_illegal_path_suffix!)
                        <-->
                     |
                        tmp = tmp_path(r)
                        mkdir_p(tmp)
                        xrc = sh("tar -xf " + sq(file) + " -C " + sq(tmp) + " 2>/dev/null")
                        libc::unlink(file)
                        xrc != 0
                           |
                              sh("rm -rf " + sq(tmp))
                              fail(7011, "dependency '" + alias + "': cannot extract " + url)
                              <-->
                           |
                              root = archive_root(r, tmp)
                              !check_tree_security(r, root)
                                 |
                                    sh("rm -rf " + sq(tmp))
                                    fail(7019, "dependency '" + alias +
                                       "': archive contains illegal path or escaping symlink")
                                    <-->
                                 |
                                    mkdir_p(r.opts.store)
                                    dir_exists(store_dir)
                                       |
                                          sh("rm -rf " + sq(tmp))
                                          <+ store_dir +>
                                       |
                                          ren_rc = root == tmp
                                             | libc::rename(tmp, store_dir)
                                             |
                                                mrc = libc::rename(root, store_dir)
                                                sh("rm -rf " + sq(tmp))
                                                mrc
                                          ren_rc == 0 || dir_exists(store_dir)
                                             | <+ store_dir +>
                                             |
                                                sh("rm -rf " + sq(tmp))
                                                fail(7011, "dependency '" + alias +
                                                   "': cannot publish archive to store")
                                                <-->

// --- graph resolution ----------------------------------------------------------

#private
   // The override key of a dependency's source, independent of revision:
   // an override replaces every instance of that source (§7).
   source_base: PackageDep, String => String
   source_base = d, base_dir =>
      d.kind
         [Git] "git " + d.git_url
         [Archive] "url " + d.archive_url
         [Path] "path " + canonical_path(path_join(base_dir, d.path))

   // Locate a dependency's tree on disk and read its manifest.
   fetch_dep: Resolver, PackageDep, String, <> => < Fetched | >
   fetch_dep = r, d, base_dir, parent_is_path =>
      base = source_base(d, base_dir)
      alias_key = "alias " + d.alias
      (r.overrides ^? base) || (r.overrides ^? alias_key)
         |
            r.fetched ^ ("ovr " + d.alias) = "1"
            (r.overrides ^? ("base_alias " + base))
               | r.fetched ^ ("ovr " + (r.overrides ^ ("base_alias " + base) | _ | "")) = "1"
            ovr = (r.overrides ^ base | s => s | (r.overrides ^ alias_key | s2 => s2 | ""))
            fetch_path(r, d.alias, ovr, <+>, "")
         |
            d.kind
               [Path]
                  v_dir' = ++ ""
                  v_dir' = r.vendor_paths ^ d.path | s => s | ""
                  v_dir' == "" |
                     v_dir' = r.vendor_paths ^ d.alias | s => s | ""
                  v_dir' != "" && dir_exists(v_dir')
                     | fetch_path(r, d.alias, v_dir', <->, d.path)
                     |
                        !parent_is_path
                           |
                              fail(7014, "dependency '" + d.alias +
                                 "': path sources are only allowed in path packages and the root")
                              <-->
                           | fetch_path(r, d.alias, canonical_path(path_join(base_dir, d.path)), <->, "")
               [Git]
                  resolve_commit(r, d.alias, d.git_url, d.git_rev)
                     | c =>
                        expected_hash = r.hashes ^ (d.git_url + "#" + d.git_rev) | _ | ""
                        checkout_git(r, d.alias, d.git_url, c, expected_hash)
                           | pair =>
                              dir = pair(0)
                              tree_hash = pair(1)
                              load_manifest(dir)
                                 | m =>
                                    pkg = empty_lock_pkg!
                                    pkg.kind = DepKind(Git)
                                    pkg.git_url = d.git_url
                                    pkg.git_rev = d.git_rev
                                    pkg.git_commit = c
                                    pkg.archive_hash = tree_hash
                                    id = m.name + "@" + c(..7)
                                    pkg.id = id
                                    <+ Fetched(m.name, dir, id, "git " + d.git_url + " " + c,
                                       pkg, m) +>
                                 | <-->
                           | <-->
                     | <-->
               [Archive]
                  fetch_archive(r, d.alias, d.archive_url, d.archive_hash)
                     | dir =>
                        load_manifest(dir)
                           | m =>
                              pkg = empty_lock_pkg!
                              pkg.kind = DepKind(Archive)
                              pkg.archive_url = d.archive_url
                              pkg.archive_hash = d.archive_hash
                              id = m.name + "@" + d.archive_hash(7..15)
                              pkg.id = id
                              <+ Fetched(m.name, dir, id, "url " + d.archive_url + " " +
                                 d.archive_hash, pkg, m) +>
                           | <-->
                     | <-->

   fetch_path: Resolver, String, String, <>, String => < Fetched | >
   fetch_path = r, alias, abs, is_override, orig_path =>
      !dir_exists(abs)
         |
            fail(7012, "dependency '" + alias + "': path '" + abs + "' not found")
            <-->
         | !file_exists(path_join(abs, "edva.ccl"))
            |
               fail(7012, "dependency '" + alias + "': no edva.ccl in '" + abs + "'")
               <-->
            |
               !check_tree_security(r, abs)
                  |
                     fail(7019, "dependency '" + alias +
                        diag::repository_illegal_path_suffix!)
                     <-->
                  |
                     load_manifest(abs)
                        | m =>
                           id = m.name + "@path"
                           expected_tree' = ++ ""
                           expected_tree' = r.hashes ^ id | s => s | ""
                           expected_tree' == "" && orig_path != "" |
                              expected_tree' = r.hashes ^ orig_path | s => s | ""
                           compute_tree_hash(r, abs)
                              | tree_hash =>
                                 expected_tree' != "" && tree_hash != expected_tree'
                                    |
                                       fail(7005, diag::vendor_tree_mismatch_prefix! + alias +
                                          "' (expected " + expected_tree' + ", got " + tree_hash + ")")
                                       <-->
                                    |
                                       pkg = empty_lock_pkg!
                                       orig_path != ""
                                          | pkg.path = orig_path
                                          | pkg.path = relpath(r.opts.root, abs)
                                       pkg.is_override = is_override
                                       pkg.id = id
                                       <+ Fetched(m.name, abs, id, "path " + abs, pkg, m) +>
                              | <-->
                        | <-->

   is_lib_file_path: String => <>
   is_lib_file_path = l =>
      ends_with(l, ".a") || ends_with(l, ".o") || ends_with(l, ".so") ||
         ends_with(l, ".dylib") || starts_with(l, "./") || starts_with(l, "../") ||
         starts_with(l, "/")

   check_manifest: Resolver, PackageManifest, String, <> => <>
   check_manifest = r, m, pkg_dir, is_root =>
      !is_root && ?m.overrides > 0
         | log::warn("warning: ignoring 'overrides' in dependency '" + m.name + "'")
      m.native_libs @ l =>
         eff_l = is_lib_file_path(l) && !starts_with(l, "/") && pkg_dir != ""
            | path_join(pkg_dir, l)
            | l
         r.libs = add_unique(r.libs, eff_l)
      m.native_pkg_config @ p => r.pkg_config = add_unique(r.pkg_config, p)
      m.edva != "" && version_lt(lang_version, m.edva)
         | fail(7009, "package '" + m.name + "' requires edva >= " + m.edva +
            " (this is " + lang_version + ")")
         | <+>

   cycle_chain: Strings, String => String
   cycle_chain = stack, id =>
      b = {64}
      on' = <->
      stack @ s =>
         s == id | on' = <+>
         on' |
            b += s
            b += " -> "
      b += id
      +b

   // Resolve one dependency edge to its instance id (dependency-first).
   resolve_dep: Resolver, PackageDep, String, <> => < String | >
   resolve_dep = r, d, base_dir, parent_is_path =>
      fetch_dep(r, d, base_dir, parent_is_path)
         | f =>
            names_has(r.stack, f.id)
               |
                  fail(7002, "dependency cycle: " + cycle_chain(r.stack, f.id))
                  <-->
               | r.done ^? f.id
                  |
                     prev_key = r.done ^ f.id | _ | ""
                     prev_key == f.key
                        | <+ f.id +>
                        |
                           fail(7013, "conflicting sources for package instance '" + f.id +
                              "': " + prev_key + " and " + f.key)
                           <-->
                  | resolve_node(r, f)
         | <-->

   dep_matches_target: String, String => <>
   dep_matches_target = dep_target, active_target =>
      dep_target == "" || active_target == "" |+>
      dep_target == active_target |+>
      parts = split_char(active_target, '-)
      names_has(parts, dep_target) |+>
      is_wasm_active = names_has(parts, "wasm") || names_has(parts, "wasm32") ||
         names_has(parts, "wasm64") || names_has(parts, "wasi") ||
         starts_with(active_target, "wasm")
      dep_target == "wasm" | --| is_wasm_active
      dep_target == "native" | --| !is_wasm_active
      <->

   resolve_node: Resolver, Fetched => < String | >
   resolve_node = r, f =>
      !check_manifest(r, f.manifest, f.dir, <->) || (?f.manifest.generate > 0 && run_generators(f.dir, r.opts, f.manifest.generate) != 0) | <--> |
         r.stack += f.id
         deps: LockDeps
         ok' = <+>
         is_path = f.pkg.kind [Path]
         f.manifest.deps @ d =>
            dep_matches_target(d.target, r.opts.target_filter) |
               resolve_dep(r, d, f.dir, is_path)
                  | id => deps += LockDep(d.alias, id)
                  |
                     ok' = <->
                     -->
         pop = Strings()
         0..?r.stack - 1 @ i => pop += (r.stack(i) | _ | "")
         r.stack = pop
         !ok' | <--> |
            f.pkg.deps = deps
            r.done ^ f.id = f.key
            r.insts += Inst(f.pkg, f.name, path_join(f.dir, "src"), f.key, f.dir)
            <+ f.id +>

// --- lock / import map ---------------------------------------------------------

#private
   lock_dep_id: LockDeps, String => String
   lock_dep_id = deps, alias =>
      res' = ++ ""
      deps @ d => d.alias == alias | res' = d.id; -->
      res'

   lock_has_pkg: LockPackages, String => <>
   lock_has_pkg = pkgs, id =>
      found' = <->
      pkgs @ p => p.id == id | found' = <+>; -->
      found'

   // Name what changed between two lockfiles, for the --locked diagnostic.
   lock_change: Lockfile, Lockfile => String
   lock_change = old, new =>
      what' = ++ ""
      new.root_deps @ d =>
         what' == "" && lock_dep_id(old.root_deps, d.alias) != d.id | what' = d.alias
      old.root_deps @ d =>
         what' == "" && lock_dep_id(new.root_deps, d.alias) == "" | what' = d.alias
      new.packages @ p =>
         what' == "" && !lock_has_pkg(old.packages, p.id) | what' = p.id
      old.packages @ p =>
         what' == "" && !lock_has_pkg(new.packages, p.id) | what' = p.id
      what' == "" | "lock" | what'

   inst_section: String, String, String, LockDeps => String
   inst_section = id, src, name, deps =>
      b = {256}
      b += "  " + id + " =\n"
      b += "    src = " + src + "\n"
      name != "" | b += "    name = " + name + "\n"
      ?deps > 0
         |
            b += "    aliases =\n"
            sort_lock_deps(deps) @ d => b += "      " + d.alias + " = " + d.id + "\n"
      +b

   import_map_text_for_target: Resolver, String, LockDeps, <> => String
   import_map_text_for_target = r, root_name, root_deps, is_wasm_target =>
      b = {1024}
      b += "imports = 1\n"
      b += "root = " + r.opts.root + "\n"
      b += "instances =\n"
      b += inst_section("root", path_join(r.opts.root, "src"), root_name, root_deps)
      sorted = sort_lock_packages(lock_pkgs(r))
      sorted @ p =>
         r.insts @ inst =>
            inst.pkg.id == p.id | b += inst_section(p.id, inst.src, inst.name, p.deps)
      has_native = !is_wasm_target && (?r.libs > 0 || ?r.pkg_config > 0)
      has_native
         |
            b += "native =\n"
            ?r.libs > 0
               |
                  b += "  libs =\n"
                  ccl::sort_strings(r.libs) @ l => b += "    = " + l + "\n"
            ?r.pkg_config > 0
               |
                  b += "  pkg-config =\n"
                  ccl::sort_strings(r.pkg_config) @ l => b += "    = " + l + "\n"
      +b

   import_map_text: Resolver, String, LockDeps => String
   import_map_text = r, root_name, root_deps =>
      is_wasm = !dep_matches_target("native", r.opts.target_filter)
      import_map_text_for_target(r, root_name, root_deps, is_wasm)

   lock_pkgs: Resolver => LockPackages
   lock_pkgs = r =>
      out: LockPackages
      r.insts @ i => out += i.pkg
      out

   read_lock: String => < Lockfile | Error >
   read_lock = file =>
      ccl::parse_file(file)
         | doc => validate_lockfile(doc, file)
         | e => <- e +>

// --- IR caching (Issue #104) --------------------------------------------------

#private
   tmp_seq: Int
   tmp_seq = 0
   cached_compiler_id: String
   cached_compiler_id = ""

#public
   default_cache: () => String
   default_cache = !=>
      xdg = env_or("XDG_CACHE_HOME", path_join(env_or("HOME", "/tmp"), ".cache"))
      env_or("EDVA_CACHE", path_join(xdg, "edva/ir"))

   hash_file: String => String
   hash_file = path =>
      tmp = "/tmp/edva_hf_" + str::from_int(getpid!) + "_" + str::from_int(tmp_seq) + ".tmp"
      tmp_seq ::= tmp_seq + 1
      cmd = "sha256sum " + sq(path) + " > " + sq(tmp) + " 2>/dev/null"
      rc = sh(cmd)
      txt = read_text(tmp)
      libc::unlink(tmp)
      rc == 0
         |
            t = txt | s => trim(s) | ""
            ?t !< 64 | t(..64) | ""
         | ""

   hash_string: String => String
   hash_string = s =>
      tmp = "/tmp/edva_hs_" + str::from_int(getpid!) + "_" + str::from_int(tmp_seq) + ".tmp"
      tmp_seq ::= tmp_seq + 1
      write_text(tmp, s)
      cmd = "sha256sum " + sq(tmp) + " > " + sq(tmp) + ".out 2>/dev/null"
      rc = sh(cmd)
      libc::unlink(tmp)
      txt = read_text(tmp + ".out")
      libc::unlink(tmp + ".out")
      rc == 0
         |
            t = txt | s2 => trim(s2) | ""
            ?t !< 64 | t(..64) | ""
         | ""

   compiler_build_id: () => String
   compiler_build_id = !=>
      cached_compiler_id != "" | --| cached_compiler_id
      env_override = env_or("EDVA_COMPILER_ID", "")
      env_override != ""
         |
            cached_compiler_id ::= env_override
            --| env_override
      exe = canonical_path("/proc/self/exe")
      pid_exe = "/proc/" + str::from_int(getpid!) + "/exe"
      // No /proc on macOS: fall back to argv[0], as the stdlib lookup does
      argv_exe = canonical_path(sys::argv_string(0))
      eff_exe = (exe != "/proc/self/exe" && file_exists(exe)) | exe |
         (file_exists(pid_exe) | pid_exe | (file_exists(argv_exe) | argv_exe | ""))
      h = eff_exe != "" | hash_file(eff_exe) | ""
      short_h = ?h > 16 | h(..16) | h
      commit = version::COMMIT_HASH
      id = short_h != ""
         | (commit != "" | commit + ":" + short_h | short_h)
         | (commit != "" | commit | version::VERSION)
      cached_compiler_id ::= id
      id

   compute_ir_cache_key: String, Strings, Strings, Strings, String, String,
      CacheCodegenFlags, String => BuildKeyResult
   compute_ir_cache_key = target, loaded_files, nat_libs, nat_pkg, triple, opt, flags, ast_summary =>
      b = {4096}
      b += "key_version = 2\n"
      b += "target = " + target + "\n"
      b += "triple = " + triple + "\n"
      b += "opt = " + opt + "\n"
      b += "compiler = " + version::VERSION + "\n"
      b += "compiler_commit = " + version::COMMIT_HASH + "\n"
      b += "compiler_build = " + compiler_build_id! + "\n"
      b += "compiler_id = " + compiler_build_id! + "\n"
      b += "llvm = 18\n"
      b += "flags =\n"
      b += "  is_module = " + (flags.is_module | "true" | "false") + "\n"
      b += "  is_shared = " + (flags.is_shared | "true" | "false") + "\n"
      b += "  no_runtime = " + (flags.no_runtime | "true" | "false") + "\n"
      b += "  no_main = " + (flags.no_main | "true" | "false") + "\n"
      flags.module_name != "" | b += "  module_name = " + flags.module_name + "\n"
      b += "sources =\n"
      seen = SMap()
      src_lines = Strings()
      loaded_files @ f =>
         ?f > 0 && !(seen ^? f) && file_exists(f)
            |
               seen ^ f = "1"
               h = hash_file(f)
               src_lines += f + ": " + h
      ccl::sort_strings(src_lines) @ line =>
         b += "  = " + line + "\n"
      has_nat = ?nat_libs > 0 || ?nat_pkg > 0
      has_nat
         |
            b += "native =\n"
            ?nat_libs > 0
               |
                  b += "  libs =\n"
                  ccl::sort_strings(nat_libs) @ l => b += "    = " + l + "\n"
            ?nat_pkg > 0
               |
                  b += "  pkg-config =\n"
                  ccl::sort_strings(nat_pkg) @ p => b += "    = " + p + "\n"
      ast_h = ast_summary == ""
         | "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
         | hash_string(ast_summary)
      b += "ast_hash = " + ast_h + "\n"
      meta = +b
      k = hash_string(meta)
      BuildKeyResult(k, meta)

   cache_lookup: String, String => < String | >
   cache_lookup = cache_dir, key =>
      key == "" || cache_dir == "" |-->
      entry_dir = path_join(path_join(cache_dir, "entries"), key)
      meta_file = path_join(entry_dir, "meta.ccl")
      ll_file = path_join(entry_dir, "output.ll")
      !file_exists(meta_file) || !file_exists(ll_file) |-->
      doc_res = ccl::parse_file(meta_file)
      doc_res
         | doc =>
            ll_text = read_text(ll_file)
            ll_text
               | txt =>
                  ?txt > 0 | <+ ll_file +> | <-->
               | <-->
         | err =>
            sh("rm -rf " + sq(entry_dir))
            <-->

   cache_store: String, String, String, String => <>
   cache_store = cache_dir, key, meta_text, output_ll =>
      key == "" || cache_dir == "" |->
      entries_dir = path_join(cache_dir, "entries")
      tmp_parent = path_join(cache_dir, "tmp")
      !mkdir_p(entries_dir) || !mkdir_p(tmp_parent) |->
      tmp_dir = path_join(tmp_parent, "e_" + str::from_int(getpid!) + "_" +
         str::from_int(tmp_seq))
      tmp_seq ::= tmp_seq + 1
      !mkdir_p(tmp_dir) |->
      ll_dest = path_join(tmp_dir, "output.ll")
      meta_dest = path_join(tmp_dir, "meta.ccl")
      ll_content = read_text(output_ll) | t => t | ""
      ok = write_text(ll_dest, ll_content) && write_text(meta_dest, meta_text)
      !ok
         |
            sh("rm -rf " + sq(tmp_dir))
            --| <->
      target_dir = path_join(entries_dir, key)
      ren_rc = libc::rename(tmp_dir, target_dir)
      ren_rc != 0 | sh("rm -rf " + sq(tmp_dir))
      <+>

// --- entry point ---------------------------------------------------------------

#private
   find_root: String => String
   find_root = start =>
      dir' = canonical_path(start)
      found' = ++ ""
      0..128 @
         file_exists(path_join(dir', "edva.ccl")) | found' = dir'; -->
         parent = dirname(dir')
         parent == "" || parent == dir' | -->
         dir' = parent
      found'

   default_store: () => String
   default_store = !=>
      xdg = env_or("XDG_CACHE_HOME", path_join(env_or("HOME", "/tmp"), ".cache"))
      env_or("EDVA_STORE", path_join(xdg, "edva/store"))

   opts_from_parsed: cli::Parsed, String => PkgOpts
   opts_from_parsed = p, root_arg =>
      eff_root = root_arg != "" | root_arg | "."
      locked = cli::flag(p, "locked")
      offline = cli::flag(p, "offline") || env_or("EDVA_OFFLINE", "") == "1"
      store_s = cli::str(p, "store")
      eff_store = store_s != "" | store_s | default_store!
      git_s = cli::str(p, "git-bin")
      eff_git = git_s != "" | git_s | env_or("EDVA_GIT", "git")
      cache_s = cli::str(p, "cache")
      eff_cache = cache_s != "" | cache_s | default_cache!
      no_cache = cli::flag(p, "no-cache") || env_or("EDVA_NO_CACHE", "") == "1"
      PkgOpts(eff_root, locked, offline, eff_store, eff_git, eff_cache, no_cache, <->, "", "")

   cmd_init: String, String, <> => Int
   cmd_init = dir_arg, name_arg, is_lib =>
      target_dir = dir_arg == "" | "." | dir_arg
      manifest_file = path_join(target_dir, "edva.ccl")
      file_exists(manifest_file)
         |
            fail(7020, "edva.ccl already exists in '" + target_dir + "'")
            1
         |
            !mkdir_p(target_dir)
               |
                  fail(7017, "cannot create directory '" + target_dir + "'")
                  1
               |
                  src_dir = path_join(target_dir, "src")
                  !mkdir_p(src_dir)
                     |
                        fail(7017, "cannot create directory '" + src_dir + "'")
                        1
                     |
                        pkg_name' = name_arg
                        pkg_name' == ""
                           |
                              raw_base = target_dir == "." | basename(canonical_path(".")) | basename(target_dir)
                              pkg_name' = clean_pkg_name(raw_base)
                        manifest_text = "name = " + pkg_name' + "\nversion = 0.1.0\nedva = " + clean_semver(lang_version) + "\n"
                        !write_text(manifest_file, manifest_text)
                           |
                              fail(7017, "cannot write " + manifest_file)
                              1
                           |
                              lib_file = path_join(src_dir, pkg_name' + ".dva")
                              !file_exists(lib_file)
                                 |
                                    lib_text = "#public\n\nhello: () => String\nhello = !=> \"Hello from " +
                                       pkg_name' + "!\"\n"
                                    write_text(lib_file, lib_text)
                              !is_lib
                                 |
                                    main_file = path_join(src_dir, "main.dva")
                                    !file_exists(main_file)
                                       |
                                          main_text = "#use io\n\nio::out $ \"Hello from " +
                                             pkg_name' + "!\"\n"
                                          write_text(main_file, main_text)
                              log::info("initialized package '" + pkg_name' + "' in " + target_dir)
                              0

   split_at_rev: String => (String, String)
   split_at_rev = spec =>
      // Split `<spec>@<rev>` when `@` is not part of `git@host:...`
      idx' = -1
      start_i = starts_with(spec, "git@") | 4 | 0
      start_i..?spec @ i =>
         spec(i) == '@ | idx' = i
      idx' > 0 && idx' + 1 < ?spec
         | (++ spec(..idx'), ++ spec(idx' + 1..))
         | (spec, "")

   infer_alias_from_git: String => String
   infer_alias_from_git = url =>
      base' = basename(url)
      ends_with(base', ".git") && ?base' > 4
         | base' = ++ base'(..?base' - 4)
      clean_pkg_name(base')

   infer_alias_from_path: String, String => String
   infer_alias_from_path = root_dir, rel_or_abs =>
      abs_p = starts_with(rel_or_abs, "/")
         | rel_or_abs
         | path_join(root_dir, rel_or_abs)
      fallback_name = clean_pkg_name(basename(canonical_path(abs_p)))
      m_file = path_join(abs_p, "edva.ccl")
      file_exists(m_file)
         |
            load_manifest(abs_p)
               | m =>
                  m.name != "" | m.name | fallback_name
               | fallback_name
         | fallback_name

   find_char_idx: String, Int => Int
   find_char_idx = s, ch =>
      idx' = -1
      ?s @ i =>
         s(i) == ch
            |
               idx' = i
               -->
      idx'

   is_domain_shorthand: String => <>
   is_domain_shorthand = s =>
      slash_idx = find_char_idx(s, '/)
      slash_idx !> 0
         | <->
         |
            host = s(..slash_idx)
            dot_idx = find_char_idx(host, '.)
            dot_idx > 0 && host != "." && host != ".."

   is_github_shorthand: String => <>
   is_github_shorthand = s =>
      slash_idx = find_char_idx(s, '/)
      slash_idx !> 0 || slash_idx + 1 !< ?s
         | <->
         |
            owner = s(..slash_idx)
            rest = s(slash_idx + 1..)
            owner != "." && owner != ".." && find_char_idx(rest, '/) < 0 &&
               find_char_idx(owner, '.) < 0 && find_char_idx(owner, ':) < 0

   classify_dep_spec: String, String => (DepKind, String, String, String)
   classify_dep_spec = raw_spec, root_dir =>
      parts = split_at_rev(raw_spec)
      base_spec = parts.0
      spec_rev = parts.1
      is_url = starts_with(base_spec, "git@") ||
         starts_with(base_spec, "https://") ||
         starts_with(base_spec, "http://") ||
         starts_with(base_spec, "ssh://") ||
         starts_with(base_spec, "git://") ||
         starts_with(base_spec, "file://") ||
         ends_with(base_spec, ".git")
      is_url
         | (DepKind(Git), base_spec, spec_rev, "")
         |
            is_Explicit_path = starts_with(base_spec, "./") ||
               starts_with(base_spec, "../") ||
               starts_with(base_spec, "/") ||
               starts_with(base_spec, "~/") ||
               base_spec == "." || base_spec == ".."
            is_Explicit_path
               | (DepKind(Path), "", "", base_spec)
               |
                  cand_local = path_join(root_dir, base_spec)
                  dir_exists(cand_local) || dir_exists(base_spec)
                     | (DepKind(Path), "", "", base_spec)
                     |
                        is_domain_shorthand(base_spec)
                           | (DepKind(Git), "https://" + base_spec + ".git", spec_rev, "")
                           |
                              is_github_shorthand(base_spec)
                                 | (DepKind(Git), "https://github.com/" + base_spec + ".git", spec_rev, "")
                                 | (DepKind(Path), "", "", base_spec)

   resolve_add_opts: cli::Parsed => < AddOpts | >
   resolve_add_opts = p =>
      opts = opts_from_parsed(p, ".")
      pos_args = cli::rest(p)
      as_alias = cli::str(p, "as")
      flag_path = cli::str(p, "path")
      flag_git = cli::str(p, "git")
      flag_rev = cli::str(p, "rev")
      flag_url = cli::str(p, "url")
      flag_hash = cli::str(p, "hash")

      has_explicit_flag = flag_path != "" || flag_git != "" || flag_url != ""
      alias' = as_alias
      kind' = DepKind(Path)
      git_url' = flag_git
      git_rev' = flag_rev
      path' = flag_path
      archive_url' = flag_url
      archive_hash' = flag_hash
      ok' = <+>

      has_explicit_flag
         |
            flag_path != "" | kind' = DepKind(Path)
            flag_git != "" | kind' = DepKind(Git)
            flag_url != "" | kind' = DepKind(Archive)
            ?pos_args !< 1 && alias' == ""
               | alias' = (pos_args(0) | s => s | "")
            ?pos_args !< 2
               | opts.root = (pos_args(1) | s => s | ".")
         |
            ?pos_args == 0
               | ok' = <->
               |
                  ?pos_args == 1
                     |
                        spec = pos_args(0) | s => s | ""
                        classified = classify_dep_spec(spec, opts.root)
                        kind' = classified.0
                        git_url' = classified.1
                        classified.2 != "" && git_rev' == "" | git_rev' = classified.2
                        path' = classified.3
                     |
                        // 2+ positional args: `<alias> <spec> [dir]`
                        first_arg = pos_args(0) | s => s | ""
                        second_arg = pos_args(1) | s => s | ""
                        alias' == "" | alias' = first_arg
                        classified = classify_dep_spec(second_arg, opts.root)
                        kind' = classified.0
                        git_url' = classified.1
                        classified.2 != "" && git_rev' == "" | git_rev' = classified.2
                        path' = classified.3
                        ?pos_args !< 3
                           | opts.root = (pos_args(2) | s => s | ".")

      alias' == "" && ok'
         |
            eff_root = find_root(opts.root)
            root_for_infer = eff_root != "" | eff_root | opts.root
            kind'
               [Path]
                  path' != "" | alias' = infer_alias_from_path(root_for_infer, path')
               [Git]
                  git_url' != "" | alias' = infer_alias_from_git(git_url')
               [Archive]
                  archive_url' != "" | alias' = infer_alias_from_git(archive_url')

      git_url' != "" && git_rev' == "" | git_rev' = ++ "master"
      has_source = path' != "" || git_url' != "" || archive_url' != ""
      ok' && alias' != "" && has_source
         | <+ AddOpts(alias', kind', git_url', git_rev', path', archive_url', archive_hash', opts) +>
         | <-->

   cmd_add: AddOpts => Int
   cmd_add = add_opts =>
      root = find_root(add_opts.pkg_opts.root)
      root == ""
         |
            fail(7015, "no edva.ccl found in '" + add_opts.pkg_opts.root + "' or any parent directory")
            --| 1
      add_opts.pkg_opts.root = root
      add_opts.pkg_opts.store = canonical_path(add_opts.pkg_opts.store)
      add_opts.alias == ""
         |
            fail(7002, "missing dependency alias")
            --| 1
      !is_valid_identifier(add_opts.alias)
         |
            fail(7002, "invalid dependency alias '" + add_opts.alias + "'")
            --| 1
      manifest_file = path_join(root, "edva.ccl")
      old_ccl_opt = read_text(manifest_file)
      old_ccl = old_ccl_opt | s => s | ""
      old_ccl == ""
         |
            fail(7015, "cannot read " + manifest_file)
            --| 1
      m_res = load_manifest(root)
      m_res
         | m =>
            new_dep = PackageDep(
               add_opts.alias,
               add_opts.kind,
               add_opts.git_url,
               add_opts.git_rev,
               add_opts.path,
               add_opts.archive_url,
               add_opts.archive_hash,
               ""
            )
            new_deps: PackageDeps
            found' = <->
            m.deps @ d =>
               d.alias == add_opts.alias
                  |
                     new_deps += new_dep
                     found' = <+>
                  |
                     new_deps += d
            !found' | new_deps += new_dep
            m.deps = new_deps
            new_ccl = manifest_to_ccl(m)
            !write_text(manifest_file, new_ccl)
               |
                  fail(7017, "cannot write " + manifest_file)
                  --| 1
            fetch_rc = run_fetch(add_opts.pkg_opts)
            fetch_rc != 0
               |
                  write_text(manifest_file, old_ccl)
                  fail(7021, "rolled back edva.ccl changes after resolution failure")
                  --| fetch_rc
            lock_file = path_join(root, "edva.lock.ccl")
            rev_info' = ++ ""
            lock_res = read_lock(lock_file)
            lock_res
               | l =>
                  target_id' = ++ ""
                  l.root_deps @ rd =>
                     rd.alias == add_opts.alias | target_id' = rd.id
                  l.packages @ p =>
                     p.id == target_id'
                        |
                           p.kind
                              [Git]
                                 p.git_commit != ""
                                    | rev_info' = p.git_commit
                                    | rev_info' = p.git_rev
                              [Path] rev_info' = p.path
                              [Archive] rev_info' = p.archive_hash
            rev_info' == ""
               |
                  add_opts.kind
                     [Git] rev_info' = add_opts.git_rev
                     [Path] rev_info' = add_opts.path
                     [Archive] rev_info' = add_opts.archive_hash
            log::info("added dependency '" + add_opts.alias + "' (" + rev_info' + ")")
            0
         | 1

   cmd_rm: PkgOpts, String => Int
   cmd_rm = opts, alias =>
      root = find_root(opts.root)
      root == ""
         |
            fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
            --| 1
      opts.root = root
      opts.store = canonical_path(opts.store)
      alias == ""
         |
            fail(7002, "missing dependency alias to remove")
            --| 1
      manifest_file = path_join(root, "edva.ccl")
      old_ccl = read_text(manifest_file) | s => s | ""
      old_ccl == ""
         |
            fail(7015, "cannot read " + manifest_file)
            --| 1
      m_res = load_manifest(root)
      m_res
         | m =>
            new_deps: PackageDeps
            found' = <->
            m.deps @ d =>
               d.alias == alias
                  | found' = <+>
                  | new_deps += d
            !found'
               |
                  fail(7004, "dependency '" + alias + "' not found in edva.ccl")
                  --| 1
            m.deps = new_deps
            new_ccl = manifest_to_ccl(m)
            !write_text(manifest_file, new_ccl)
               |
                  fail(7017, "cannot write " + manifest_file)
                  --| 1
            fetch_rc = run_fetch(opts)
            fetch_rc != 0
               |
                  write_text(manifest_file, old_ccl)
                  fail(7021, "rolled back edva.ccl changes after resolution failure")
                  --| fetch_rc
            log::info("removed dependency '" + alias + "'")
            0
         | 1

   // `edva fetch`: resolve the root's graph, write edva.lock.ccl when it
   // changed, and (re)write .edva/imports.ccl.
   cmd_fetch: PkgOpts => Int
   cmd_fetch = opts =>
      root = find_root(opts.root)
      root == ""
         |
            fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
            1
         |
            opts.root = root
            opts.store = canonical_path(opts.store)
            run_fetch(opts)

   is_dva_file_target: String => <>
   is_dva_file_target = target =>
      target != "" && (ends_with(target, ".dva") || (file_exists(target) && !dir_exists(target)))

   append_compiler_flags: String, String, String, Strings, PkgOpts => String
   append_compiler_flags = base_cmd, target_triple, opt_level, cflags, opts =>
      cmd' = base_cmd
      target_triple != "" | cmd' = cmd' + " -target " + sq(target_triple)
      opt_level != ""
         |
            opt_flag = opt_level(0) == '- | opt_level | "-" + opt_level
            cmd' = cmd' + " " + sq(opt_flag)
      cflags @ cf =>
         cmd' = cmd' + " -cflag " + sq(cf)
      opts.cache != "" | cmd' = cmd' + " --cache " + sq(opts.cache)
      opts.no_cache | cmd' = cmd' + " --no-cache"
      cmd'

   is_var_cont: Int => <>
   is_var_cont = c =>
      c ['a...'z, 'A...'Z, '0...'9, '_, '-]

   #type ExpandedGenCmd (
      ok: <>,
      cmd: String,
      max_tool_mtime: Int
   )

   max_src_mtime_ns: String => Int
   max_src_mtime_ns = dir =>
      !dir_exists(dir) | --| -1
      max_m' = -1
      entries = fs::read_dir(dir)
      entries @ e =>
         full = path_join(dir, e.name)
         e.is_dir
            |
               sub_m = max_src_mtime_ns(full)
               sub_m > max_m' | max_m' = sub_m
            |
               m = fs::mtime_ns(full)
               m > max_m' | max_m' = m
      max_m'

   cmd_build_ex: PkgOpts, String, String, String, Strings => Int

   resolve_dep_tool_bin: String, PkgOpts, String, String => < (String, Int) | >
   resolve_dep_tool_bin = root, opts, alias, target_name =>
      imp_file = path_join(path_join(root, ".edva"), "imports.ccl")
      !file_exists(imp_file)
         |
            f_opts = PkgOpts(..opts, root: root, store: canonical_path(opts.store))
            run_fetch(f_opts) != 0 | --| <-->
      ccl::parse_file(imp_file)
         | doc =>
            inst_sec = ccl::get_section(doc, "instances") | s => s | ccl::CclDoc()
            root_sec = ccl::get_section(inst_sec, "root") | s => s | ccl::CclDoc()
            aliases_sec = ccl::get_section(root_sec, "aliases") | s => s | ccl::CclDoc()
            inst_id = ccl::get(aliases_sec, alias) | s => s | ""
            inst_id == ""
               |
                  fail(7023, "generate: '@" + alias + "' is not a dependency in edva.ccl")
                  <-->
               |
                  dep_sec = ccl::get_section(inst_sec, inst_id) | s => s | ccl::CclDoc()
                  inst_src_raw = ccl::get(dep_sec, "src") | s => s | ""
                  inst_src = starts_with(inst_src_raw, "/")
                     | inst_src_raw
                     | path_join(root, inst_src_raw)
                  dep_root = dirname(inst_src)
                  load_manifest(dep_root)
                     | dep_m =>
                        out_rel' = ++ ""
                        found_tgt' = <->
                        target_name != ""
                           |
                              dep_m.targets @ t =>
                                 t.name == target_name
                                    |
                                       out_rel' = t.out != "" | t.out | t.name
                                       found_tgt' = <+>
                              !found_tgt'
                                 |
                                    fail(7023, "generate: dependency '@" + alias + "' has no target '" + target_name + "'")
                           |
                              ?dep_m.targets > 0
                                 |
                                    dep_m.targets @ t =>
                                       !found_tgt' && dep_matches_target("native", t.target != "" | t.target | "native")
                                          |
                                             out_rel' = t.out != "" | t.out | t.name
                                             found_tgt' = <+>
                                 |
                                    out_rel' = dep_m.name
                                    found_tgt' = <+>
                        !found_tgt' || out_rel' == ""
                           | <-->
                           |
                              is_path_dep = ends_with(inst_id, "@path")
                              eff_cache = opts.cache != "" | opts.cache | default_cache!
                              bin_dir = path_join(path_join(dirname(eff_cache), "bin"), inst_id)
                              bin_path = is_path_dep
                                 | (starts_with(out_rel', "/") | out_rel' | path_join(dep_root, out_rel'))
                                 | path_join(bin_dir, basename(out_rel'))
                              src_mtime = max_src_mtime_ns(inst_src)
                              ccl_mtime = fs::mtime_ns(path_join(dep_root, "edva.ccl"))
                              dep_max = ccl_mtime > src_mtime | ccl_mtime | src_mtime
                              bin_mtime = file_exists(bin_path) | fs::mtime_ns(bin_path) | -1
                              needs_build = !file_exists(bin_path) || (dep_max > 0 && bin_mtime < dep_max)
                              build_ok' = <+>
                              needs_build
                                 |
                                    !is_path_dep | mkdir_p(bin_dir)
                                    dep_opts = PkgOpts(..opts, root: dep_root, store: canonical_path(opts.store))
                                    out_ovr = is_path_dep | "" | bin_path
                                    cmd_build_ex(dep_opts, out_ovr, "", "", Strings()) != 0
                                       | build_ok' = <->
                              !build_ok' || !file_exists(bin_path)
                                 |
                                    fail(7023, "generate: failed to build tool '@" + alias + "'")
                                    <-->
                                 |
                                    <+ (bin_path, fs::mtime_ns(bin_path)) +>
                     | <-->
         |
            fail(7023, "generate: cannot read .edva/imports.ccl")
            <-->

   expand_generate_cmd: String, PkgOpts, String, String, String => ExpandedGenCmd
   expand_generate_cmd = root, opts, cmd, src, out_p =>
      b = {?cmd + 64}
      i' = 0
      n = ?cmd
      ok' = <+>
      max_tool_m' = -1
      0.. @
         i' !< n || !ok' | -->
         c = cmd(i')
         is_at_boundary = i' == 0 || (cmd(i' - 1) ['\s, '\t, ';, '&, '|, '(])
         c == '@ && is_at_boundary && i' + 1 < n && is_var_cont(cmd(i' + 1))
            |
               a_start = i' + 1
               j' = a_start
               0.. @
                  j' !< n || !is_var_cont(cmd(j')) | -->
                  j' = j' + 1
               alias = cmd(a_start..j')
               tgt_name' = ++ ""
               j' + 1 < n && cmd(j') == '/ && is_var_cont(cmd(j' + 1))
                  |
                     t_start = j' + 1
                     j' = t_start
                     0.. @
                        j' !< n || !is_var_cont(cmd(j')) | -->
                        j' = j' + 1
                     tgt_name' = cmd(t_start..j')
               resolve_dep_tool_bin(root, opts, alias, tgt_name')
                  | pair =>
                     b += sq(pair.0)
                     pair.1 > max_tool_m' | max_tool_m' = pair.1
                     i' = j'
                  |
                     ok' = <->
            |
               c == '$
                  |
                     rem = cmd(i'..)
                     is_b_src = starts_with(rem, "\${src}")
                     is_b_out = starts_with(rem, "\${out}")
                     is_s_src = starts_with(rem, "\$src") && (i' + 4 !< n || !is_var_cont(cmd(i' + 4)))
                     is_s_out = starts_with(rem, "\$out") && (i' + 4 !< n || !is_var_cont(cmd(i' + 4)))
                     is_b_src
                        |
                           b += sq(src)
                           i' = i' + 6
                        |
                           is_b_out
                              |
                                 b += sq(out_p)
                                 i' = i' + 6
                              |
                                 is_s_src
                                    |
                                       b += sq(src)
                                       i' = i' + 4
                                    |
                                       is_s_out
                                          |
                                             b += sq(out_p)
                                             i' = i' + 4
                                          |
                                             b += '$
                                             i' = i' + 1
                  |
                     b += c
                     i' = i' + 1
      ExpandedGenCmd(ok', +b, max_tool_m')

   run_generators: String, PkgOpts, GenerateSteps => Int
   run_generators = root, opts, steps =>
      ?steps == 0 | --| 0
      rc' = 0
      steps @ g =>
         rc' == 0 |
            src_abs = g.src != ""
               | (starts_with(g.src, "/") | g.src | path_join(root, g.src))
               | ""
            out_abs = g.out != ""
               | (starts_with(g.out, "/") | g.out | path_join(root, g.out))
               | ""
            g.src != "" && !fs::exists(src_abs)
               |
                  fail(7019, "generate '" + g.name + "': source '" + g.src + "' not found")
                  rc' = 1
               |
                  exp = expand_generate_cmd(root, opts, g.cmd, g.src, g.out)
                  !exp.ok
                     | rc' = 1
                     |
                        out_m = file_exists(out_abs) | fs::mtime_ns(out_abs) | -1
                        src_m = g.src != "" | fs::mtime_ns(src_abs) | -1
                        up_to_date = g.src != "" && g.out != "" && out_m !< 0 &&
                           src_m !< 0 && out_m !< src_m &&
                           (exp.max_tool_mtime < 0 || out_m !< exp.max_tool_mtime)
                        !up_to_date
                           |
                              out_abs != ""
                                 |
                                    out_dir = dirname(out_abs)
                                    out_dir != "" | mkdir_p(out_dir)
                              edva_bin = canonical_path(sys::argv_string(0))
                              full_cmd = "cd " + sq(root) + " && EDVA=" + sq(edva_bin) + " " + exp.cmd
                              step_rc = sh(full_cmd)
                              step_rc != 0
                                 |
                                    fail(7022, "generate '" + g.name + "' failed with exit code " + str::from_int(step_rc))
                                    rc' = 1
                                 |
                                    log::info("generated '" + (g.out != "" | g.out | g.name) + "'")
      rc'

   ensure_pkg_fetched_for_file: String, PkgOpts => Int
   ensure_pkg_fetched_for_file = file_path, opts =>
      file_dir = dirname(canonical_path(file_path))
      pkg_root = find_root(file_dir != "" | file_dir | ".")
      pkg_root == ""
         | 0
         |
            imp_map = path_join(path_join(pkg_root, ".edva"), "imports.ccl")
            fetch_rc' = 0
            !file_exists(imp_map)
               |
                  opts.root = pkg_root
                  opts.store = canonical_path(opts.store)
                  fetch_rc' = run_fetch(opts)
            fetch_rc' != 0
               | fetch_rc'
               |
                  load_manifest(pkg_root)
                     | m => run_generators(pkg_root, opts, m.generate)
                     | 1

   // `edva build [dir|file.dva]`: dual-mode package or single-file build.
   cmd_build_ex = opts, out_override, target_override, opt_override, cflags_override =>
      is_dva_file_target(opts.root)
         |
            src_file = opts.root
            !file_exists(src_file)
               |
                  fail(7019, "source file '" + src_file + "' not found")
                  --| 1
            fetch_rc = ensure_pkg_fetched_for_file(src_file, opts)
            fetch_rc != 0 | --| fetch_rc
            base_name = basename(src_file)
            stem = ends_with(base_name, ".dva") && ?base_name > 4
               | ++ base_name(..?base_name - 4)
               | base_name + ".out"
            out_path = out_override != "" | out_override | stem
            compiler = sys::argv_string(0)
            base_cmd = sq(compiler) + " " + sq(src_file) + " -o " + sq(out_path)
            cmd = append_compiler_flags(base_cmd, target_override, opt_override, cflags_override, opts)
            rc = sh(cmd)
            libc::unlink(out_path + ".ll")
            rc == 0 | 0 | 1
         |
            root = find_root(opts.root)
            root == ""
               |
                  fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
                  1
               |
                  opts.root = root
                  opts.store = canonical_path(opts.store)
                  fetch_rc = run_fetch(opts)
                  fetch_rc != 0
                     | fetch_rc
                     |
                        m_res = load_manifest(opts.root)
                        m_res
                           | m =>
                              gen_rc = run_generators(opts.root, opts, m.generate)
                              gen_rc != 0 | --| gen_rc
                              ?m.targets > 0
                                 |
                                    compiler = sys::argv_string(0)
                                    rc' = 0
                                    m.targets @ t =>
                                       rc' == 0 |
                                          src_rel = t.src != "" | t.src | "src/main.dva"
                                          out_rel = out_override != "" && ?m.targets == 1
                                             | out_override
                                             | (t.out != "" | t.out | t.name)
                                          src_path = path_join(opts.root, src_rel)
                                          out_path = starts_with(out_rel, "/")
                                             | out_rel
                                             | path_join(opts.root, out_rel)
                                          !file_exists(src_path)
                                             |
                                                fail(7019, "target '" + t.name + "': source file '" + src_rel + "' not found")
                                                rc' = 1
                                             |
                                                out_dir = dirname(out_path)
                                                out_dir != "" | mkdir_p(out_dir)
                                                eff_target = target_override != "" | target_override | t.target
                                                eff_opt = opt_override != "" | opt_override | t.opt
                                                eff_cflags: Strings
                                                t.cflags @ cf => eff_cflags += cf
                                                cflags_override @ cf => eff_cflags += cf
                                                base_cmd' = sq(compiler) + " " + sq(src_path) + " -o " + sq(out_path)
                                                scoped_map = path_join(path_join(opts.root, ".edva"),
                                                   "imports-target-" + t.name + ".ccl")
                                                target_override == "" && file_exists(scoped_map)
                                                   | base_cmd' = base_cmd' + " --import-map " + sq(scoped_map)
                                                cmd' = append_compiler_flags(base_cmd', eff_target, eff_opt, eff_cflags, opts)
                                                step_rc = sh(cmd')
                                                libc::unlink(out_path + ".ll")
                                                step_rc != 0 | rc' = 1
                                    rc'
                                 |
                                    main_src = path_join(path_join(opts.root, "src"), "main.dva")
                                    !file_exists(main_src)
                                       |
                                          log::info("no executable target src/main.dva (library package)")
                                          0
                                       |
                                          out_bin = out_override != ""
                                             | (starts_with(out_override, "/") | out_override | path_join(opts.root, out_override))
                                             | path_join(opts.root, m.name)
                                          compiler = sys::argv_string(0)
                                          base_cmd = sq(compiler) + " " + sq(main_src) + " -o " + sq(out_bin)
                                          cmd' = append_compiler_flags(base_cmd, target_override, opt_override, cflags_override, opts)
                                          rc = sh(cmd')
                                          libc::unlink(out_bin + ".ll")
                                          rc == 0 | 0 | 1
                           | 1

   cmd_build: PkgOpts => Int
   cmd_build = opts =>
      cmd_build_ex(opts, "", "", "", Strings())

   // `edva check [dir|file.dva]`: type-check and verify IR for package (all declared targets) or single file.
   cmd_check: PkgOpts, String => Int
   cmd_check = opts, target_override =>
      is_dva_file_target(opts.root)
         |
            src_file = opts.root
            !file_exists(src_file)
               |
                  fail(7019, "source file '" + src_file + "' not found")
                  --| 1
            fetch_rc = ensure_pkg_fetched_for_file(src_file, opts)
            fetch_rc != 0 | --| fetch_rc
            compiler = sys::argv_string(0)
            tmp_ll = "/tmp/edva_chk_" + str::from_int(getpid!) + ".ll"
            base_cmd = "EDVA_LOG=warn " + sq(compiler) + " " + sq(src_file) + " -ir --no-main -o " + sq(tmp_ll)
            cmd = append_compiler_flags(base_cmd, target_override, "", Strings(), opts)
            rc = sh(cmd)
            libc::unlink(tmp_ll)
            rc == 0 | 0 | 1
         |
            root = find_root(opts.root)
            root == ""
               |
                  fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
                  1
               |
                  opts.root = root
                  opts.store = canonical_path(opts.store)
                  fetch_rc = run_fetch(opts)
                  fetch_rc != 0
                     | fetch_rc
                     |
                        m_res = load_manifest(opts.root)
                        m_res
                           | m =>
                              gen_rc = run_generators(opts.root, opts, m.generate)
                              gen_rc != 0 | --| gen_rc
                              compiler = sys::argv_string(0)
                              ?m.targets > 0
                                 |
                                    rc' = 0
                                    m.targets @ t =>
                                       rc' == 0 |
                                          src_rel = t.src != "" | t.src | "src/main.dva"
                                          src_path = path_join(opts.root, src_rel)
                                          !file_exists(src_path)
                                             |
                                                fail(7019, "target '" + t.name + "': source file '" + src_rel + "' not found")
                                                rc' = 1
                                             |
                                                eff_target = target_override != "" | target_override | t.target
                                                tmp_ll = "/tmp/edva_chk_" + str::from_int(getpid!) + "_" + t.name + ".ll"
                                                base_cmd' = "EDVA_LOG=warn " + sq(compiler) + " " + sq(src_path) +
                                                   " -ir --no-main -o " + sq(tmp_ll)
                                                scoped_map = path_join(path_join(opts.root, ".edva"),
                                                   "imports-target-" + t.name + ".ccl")
                                                target_override == "" && file_exists(scoped_map)
                                                   | base_cmd' = base_cmd' + " --import-map " + sq(scoped_map)
                                                cmd' = append_compiler_flags(base_cmd', eff_target, "", Strings(), opts)
                                                step_rc = sh(cmd')
                                                libc::unlink(tmp_ll)
                                                step_rc != 0
                                                   | rc' = 1
                                                   |
                                                      tgt_label = eff_target != "" | " (" + eff_target + ")" | " (native)"
                                                      log::info("checked target '" + t.name + "'" + tgt_label)
                                    rc'
                                 |
                                    main_src = path_join(path_join(opts.root, "src"), "main.dva")
                                    lib_src = path_join(path_join(opts.root, "src"), m.name + ".dva")
                                    has_main = file_exists(main_src)
                                    check_src = has_main
                                       | main_src
                                       | (file_exists(lib_src) | lib_src | "")
                                    check_src == ""
                                       | 0
                                       |
                                          tmp_ll = "/tmp/edva_chk_" + str::from_int(getpid!) + "_" + m.name + ".ll"
                                          mode_flag = has_main | "--no-main" | ("--module " + sq(m.name))
                                          base_cmd = "EDVA_LOG=warn " + sq(compiler) + " " + sq(check_src) +
                                             " -ir " + mode_flag + " -o " + sq(tmp_ll)
                                          cmd' = append_compiler_flags(base_cmd, target_override, "", Strings(), opts)
                                          rc = sh(cmd')
                                          libc::unlink(tmp_ll)
                                          rc == 0
                                             |
                                                log::info("checked package '" + m.name + "'")
                                                0
                                             | 1
                           | 1

   // `edva run [dir|file.dva] [-- <args...>]`: build and execute binary or single file.
   cmd_run: PkgOpts, String, String, String, Strings, Strings => Int
   cmd_run = opts, out_override, target_override, opt_override, cflags_override, run_args =>
      is_dva_file_target(opts.root)
         |
            src_file = opts.root
            !file_exists(src_file)
               |
                  fail(7019, "source file '" + src_file + "' not found")
                  --| 1
            fetch_rc = ensure_pkg_fetched_for_file(src_file, opts)
            fetch_rc != 0 | --| fetch_rc
            base_name = basename(src_file)
            stem = ends_with(base_name, ".dva") && ?base_name > 4
               | ++ base_name(..?base_name - 4)
               | base_name
            tmp_bin = out_override != ""
               | out_override
               | "/tmp/edva_run_" + str::from_int(getpid!) + "_" + stem
            compiler = sys::argv_string(0)
            base_cmd = sq(compiler) + " " + sq(src_file) + " -o " + sq(tmp_bin)
            build_cmd = append_compiler_flags(base_cmd, target_override, opt_override, cflags_override, opts)
            b_rc = sh(build_cmd)
            libc::unlink(tmp_bin + ".ll")
            b_rc != 0
               |
                  out_override == "" | libc::unlink(tmp_bin)
                  1
               |
                  exec_cmd' = sq(tmp_bin)
                  run_args @ a => exec_cmd' = exec_cmd' + " " + sq(a)
                  r_rc = sh(exec_cmd')
                  out_override == "" | libc::unlink(tmp_bin)
                  r_rc == 0 | 0 | 1
         |
            target_dir = opts.root
            root = find_root(target_dir)
            root == ""
               |
                  fail(7015, "no edva.ccl found in '" + target_dir + "' or any parent directory")
                  --| 1
            opts.root = root
            b_rc = cmd_build_ex(opts, out_override, target_override, opt_override, cflags_override)
            b_rc != 0 | --| b_rc
            m_res = load_manifest(root)
            m_res
               | m =>
                  bin_path' = ++ ""
                  out_override != ""
                     |
                        bin_path' = starts_with(out_override, "/")
                           | out_override
                           | path_join(root, out_override)
                     |
                        ?m.targets > 0
                           |
                              t0 = m.targets(0) | t => t | BuildTarget("", "", "", "", "", Strings())
                              out_rel = t0.out != "" | t0.out | t0.name
                              bin_path' = path_join(root, out_rel)
                           |
                              bin_path' = path_join(root, m.name)
                  !file_exists(bin_path')
                     |
                        fail(7019, "no executable target found in package '" + m.name + "'")
                        1
                     |
                        exec_cmd' = sq(bin_path')
                        run_args @ a => exec_cmd' = exec_cmd' + " " + sq(a)
                        r_rc = sh(exec_cmd')
                        r_rc == 0 | 0 | 1
               | 1

   list_test_files: String => Strings
   list_test_files = dir =>
      files: Strings
      entries = fs::read_dir(dir)
      entries @ e =>
         !e.is_dir && ?e.name > 4 && e.name(?e.name - 4..) == ".dva" |
            files += e.name
      ccl::sort_strings(files)

   // `edva test [dir|file.dva]`: resolve the root's graph, then compile and run
   // tests/*.dva or a single test file.
   cmd_test: PkgOpts => Int
   cmd_test = opts =>
      is_dva_file_target(opts.root)
         |
            tpath = opts.root
            !file_exists(tpath)
               |
                  fail(7019, "test file '" + tpath + "' not found")
                  --| 1
            fetch_rc = ensure_pkg_fetched_for_file(tpath, opts)
            fetch_rc != 0 | --| fetch_rc
            tf = basename(tpath)
            stem = ends_with(tf, ".dva") && ?tf > 4 | tf(..-4) | tf
            compiler = sys::argv_string(0)
            tmp_bin = "/tmp/edva_test_" + str::from_int(getpid!) + "_" + stem
            cmd' = sq(compiler) + " " + sq(tpath) + " -o " +
               sq(tmp_bin) + " -r >/dev/null 2>&1"
            opts.cache != "" | cmd' = cmd' + " --cache " + sq(opts.cache)
            opts.no_cache | cmd' = cmd' + " --no-cache"
            rc = sh(cmd')
            libc::unlink(tmp_bin)
            libc::unlink(tmp_bin + ".ll")
            rc == 0
               |
                  out("test " + tf + " ... ok")
                  out("1 passed, 0 failed")
                  0
               |
                  out("test " + tf + " ... FAIL")
                  out("0 passed, 1 failed")
                  1
         |
            root = find_root(opts.root)
            root == ""
               |
                  fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
                  1
               |
                  opts.root = root
                  opts.store = canonical_path(opts.store)
                  fetch_rc = run_fetch(opts)
                  fetch_rc != 0
                     | fetch_rc
                     |
                        m_res = load_manifest(opts.root)
                        gen_rc = m_res
                           | m => run_generators(opts.root, opts, m.generate)
                           | 1
                        gen_rc != 0 | --| gen_rc
                        tests_dir = path_join(opts.root, "tests")
                        !dir_exists(tests_dir)
                           |
                              out("0 passed, 0 failed")
                              0
                           |
                              test_files = list_test_files(tests_dir)
                              ?test_files == 0
                                 |
                                    out("0 passed, 0 failed")
                                    0
                                 |
                                    passed' = 0
                                    failed' = 0
                                    compiler = sys::argv_string(0)
                                    test_files @ tf =>
                                       tpath = path_join(tests_dir, tf)
                                       tmp_bin = "/tmp/edva_test_" + str::from_int(getpid!) +
                                          "_" + tf(..-4)
                                       cmd' = sq(compiler) + " " + sq(tpath) + " -o " +
                                          sq(tmp_bin) + " -r >/dev/null 2>&1"
                                       opts.cache != "" | cmd' = cmd' + " --cache " + sq(opts.cache)
                                       opts.no_cache | cmd' = cmd' + " --no-cache"
                                       rc = sh(cmd')
                                       libc::unlink(tmp_bin)
                                       libc::unlink(tmp_bin + ".ll")
                                       rc == 0
                                          |
                                             out("test " + tf + " ... ok")
                                             passed' = passed' + 1
                                          |
                                             out("test " + tf + " ... FAIL")
                                             failed' = failed' + 1
                                    out(str::from_int(passed') + " passed, " +
                                       str::from_int(failed') + " failed")
                                    failed' == 0 | 0 | 1

   run_fetch: PkgOpts => Int
   run_fetch = opts =>
      lock_file = path_join(opts.root, "edva.lock.ccl")
      has_lock = file_exists(lock_file)
      opts.locked && !has_lock
         |
            fail(7006, "--locked: edva.lock.ccl not found")
            1
         |
            prior_res = has_lock
               | read_lock(lock_file)
               | <+ Lockfile(1, LockPackages(), LockDeps()) ->
            prior_res
               | prior => resolve_root(opts, prior, has_lock)
               | e =>
                  fail(7018, e.msg)
                  1

   has_root_dep: LockDeps, String, String => <>
   has_root_dep = root_deps, alias, id =>
      found' = <->
      root_deps @ rd =>
         rd.alias == alias && rd.id == id
            |
               found' = <+>
               -->
      found'

   has_dep_alias: PackageDeps, String => <>
   has_dep_alias = deps, alias =>
      found' = <->
      deps @ d =>
         d.alias == alias
            |
               found' = <+>
               -->
      found'

   load_vendor_map: Resolver => <>
   load_vendor_map = r =>
      v_file = path_join(r.opts.root, "vendor/vendor.ccl")
      !file_exists(v_file)
         | <+>
         |
            ccl::parse_file(v_file)
               | doc =>
                  ccl::get_section(doc, "packages")
                     | pkgs_doc =>
                        ok' = <+>
                        pkgs_doc @ e =>
                           ok' |
                              id = e.key
                              e.val [Block b]
                                 rel_dir = ccl::get(b, "dir") | _ | ""
                                 kind_str = ccl::get(b, "kind") | _ | ""
                                 url = ccl::get(b, "url") | _ | ""
                                 rev = ccl::get(b, "rev") | _ | ""
                                 commit = ccl::get(b, "commit") | _ | ""
                                 tree = ccl::get(b, "tree") | _ | ""
                                 path = ccl::get(b, "path") | _ | ""
                                 hash = ccl::get(b, "hash") | _ | ""
                                 abs_dir = path_join(r.opts.root, rel_dir)
                                 !dir_exists(abs_dir)
                                    |
                                       fail(7014, "vendored package '" + id +
                                          "' not found at '" + abs_dir + "'")
                                       ok' = <->
                                    |
                                       r.vendor_pkgs ^ id = abs_dir
                                       tree != "" | r.hashes ^ id = tree
                                       kind_str
                                          ["git"]
                                             commit != "" | r.vendor_git ^ (url + "#" + commit) = abs_dir
                                             rev != "" | r.vendor_git ^ (url + "#" + rev) = abs_dir
                                             rev != "" && commit != "" | r.memo ^ (url + "#" + rev) = commit
                                             tree != "" |
                                                r.hashes ^ (url + "#" + rev) = tree
                                                r.hashes ^ (url + "#" + commit) = tree
                                          ["archive"]
                                             hash != "" | r.vendor_archive ^ hash = abs_dir
                                             tree != "" | r.hashes ^ hash = tree
                                          ["path"]
                                             path != "" |
                                                r.vendor_paths ^ path = abs_dir
                                                tree != "" | r.hashes ^ path = tree
                                             r.vendor_paths ^ id = abs_dir
                        ok'
                     | <+>
               |
                  fail(7018, "invalid vendor/vendor.ccl")
                  <->

   resolve_root: PkgOpts, Lockfile, <> => Int
   resolve_root = opts, prior, has_lock =>
      r = Resolver(opts, Insts(), SMap(), Strings(), SMap(), SMap(), SMap(), SMap(),
         Strings(), Strings(), 0, SMap(), SMap(), SMap(), SMap())
      !load_vendor_map(r) | 1 |
         prior.packages @ p =>
            p.kind
               [Git]
                  skip_memo = opts.is_update && (
                     opts.update_alias == "" || has_root_dep(prior.root_deps, opts.update_alias, p.id)
                  )
                  !skip_memo
                     |
                        r.memo ^ (p.git_url + "#" + p.git_rev) = p.git_commit
                        p.archive_hash != "" | r.hashes ^ (p.git_url + "#" + p.git_rev) = p.archive_hash
               [Archive]
                  p.archive_hash != "" | r.hashes ^ p.archive_url = p.archive_hash
         load_manifest(opts.root)
            | m => resolve_with_root(r, m, prior, has_lock)
            | 1

   install_overrides: Resolver, PackageManifest => <>
   install_overrides = r, m =>
      ok' = <+>
      m.overrides @ o =>
         ok' |
            r.opts.locked
               |
                  fail(7008, "--locked: override for '" + o.alias + "' is not allowed")
                  ok' = <->
               |
                  abs_ovr = canonical_path(path_join(r.opts.root, o.path))
                  r.overrides ^ ("alias " + o.alias) = abs_ovr
                  m.deps @ d =>
                     d.alias == o.alias
                        |
                           base = source_base(d, r.opts.root)
                           r.overrides ^ base = abs_ovr
                           r.overrides ^ ("base_alias " + base) = o.alias
                           r.fetched ^ ("ovr " + o.alias) = "1"
      ok'

   resolve_with_root: Resolver, PackageManifest, Lockfile, <> => Int
   resolve_with_root = r, m, prior, has_lock =>
      !install_overrides(r, m) || !check_manifest(r, m, r.opts.root, <+>) | 1 |
         r.stack += m.name + "@path"
         root_deps: LockDeps
         ok' = <+>
         m.deps @ d =>
            ok' && dep_matches_target(d.target, r.opts.target_filter) |
               resolve_dep(r, d, r.opts.root, <+>)
                  | id => root_deps += LockDep(d.alias, id)
                  | ok' = <->
         m.overrides @ o =>
            ok' && !(r.fetched ^? ("ovr " + o.alias))
               |
                  fail(7016, "edva.ccl: override '" + o.alias +
                     "' does not name a dependency")
                  ok' = <->
         !ok' | 1 | write_outputs(r, m, prior, has_lock, root_deps)

   filter_root_deps_for_target: PackageDeps, LockDeps, String => LockDeps
   filter_root_deps_for_target = m_deps, root_deps, active_target =>
      filtered = LockDeps()
      root_deps @ rd =>
         matched' = <+>
         m_deps @ d =>
            d.alias == rd.alias
               |
                  matched' = dep_matches_target(d.target, active_target)
                  -->
         matched' | filtered += rd
      filtered

   write_outputs: Resolver, PackageManifest, Lockfile, <>, LockDeps => Int
   write_outputs = r, m, prior, has_lock, root_deps =>
      lock = Lockfile(1, lock_pkgs(r), root_deps)
      text = lockfile_to_ccl(lock)
      lock_file = path_join(r.opts.root, "edva.lock.ccl")
      old_text = read_text(lock_file) | t => t | ""
      changed = old_text != text
      r.opts.locked && changed
         |
            fail(7007, diag::locked_manifest_stale_prefix! + lock_change(prior, lock) +
               " changed)")
            1
         |
            lock_ok = !changed || write_text(lock_file, text)
            edva_dir = path_join(r.opts.root, ".edva")
            map_ok' = lock_ok && mkdir_p(edva_dir) &&
               write_text(path_join(edva_dir, "imports.ccl"),
                  import_map_text(r, m.name, root_deps))
            map_ok' && r.opts.target_filter == "" && ?m.targets > 0
               |
                  m.targets @ t =>
                     eff_tgt = t.target != "" | t.target | "native"
                     is_wasm_tgt = !dep_matches_target("native", eff_tgt)
                     t_deps = filter_root_deps_for_target(m.deps, root_deps, eff_tgt)
                     t_map_path = path_join(edva_dir, "imports-target-" + t.name + ".ccl")
                     t_map_txt = import_map_text_for_target(r, m.name, t_deps, is_wasm_tgt)
                     !write_text(t_map_path, t_map_txt) | map_ok' = <->
            !map_ok'
               |
                  fail(7017, "cannot write " + lock_file + " or .edva/imports.ccl")
                  1
               |
                  r.opts.is_update
                     |
                        updated_count' = 0
                        lock.packages @ np =>
                           prior.packages @ op =>
                              np.git_url != "" && np.git_url == op.git_url &&
                                 np.git_rev == op.git_rev && np.git_commit != op.git_commit
                                 |
                                    c_old = ?op.git_commit > 7 | op.git_commit(..7) | op.git_commit
                                    c_new = ?np.git_commit > 7 | np.git_commit(..7) | np.git_commit
                                    log::info("updated '" + pkg_base_name(np.id) + "' (" + c_old +
                                       " -> " + c_new + ")")
                                    updated_count' = updated_count' + 1
                        updated_count' == 0
                           | log::info("all dependencies up to date")
                        0
                     |
                        n = ?r.insts
                        log::info("locked " + str::from_int(n) + (n == 1 | " package" | " packages"))
                        0

   cmd_cache_action: String, String => Int
   cmd_cache_action = action, cache_override =>
      subcmd = action == "" | "dir" | action
      eff_cache = cache_override != "" | cache_override | default_cache!
      subcmd
         ["clean"]
            entries_dir = path_join(eff_cache, "entries")
            tmp_dir = path_join(eff_cache, "tmp")
            sh("rm -rf " + sq(entries_dir) + " " + sq(tmp_dir))
            log::info("cache cleaned (" + eff_cache + ")")
            0
         ["dir"]
            out(eff_cache)
            0
         ["ls", "list", "status"]
            entries_dir = path_join(eff_cache, "entries")
            !dir_exists(entries_dir)
               |
                  out("0 cached entries")
                  0
               |
                  count' = 0
                  entries = fs::read_dir(entries_dir)
                  entries @ e =>
                     e.is_dir |
                        kname = e.name
                        meta_f = path_join(path_join(entries_dir, kname),
                           "meta.ccl")
                        tgt' = ++ ""
                        file_exists(meta_f)
                           |
                              tgt' = ccl::parse_file(meta_f)
                                 | d =>
                                    ccl::get(d, "target")
                                       | s => s
                                       | ""
                                 | ""
                        out(kname + " (" + (tgt' != "" | tgt' | "unknown") + ")")
                        count' = count' + 1
                  out(str::from_int(count') + (count' == 1 | " entry" | " entries"))
                  0
         |
            out("usage: edva cache [dir|ls|clean]")
            2

   cmd_update: PkgOpts, String => Int
   cmd_update = opts, target_alias =>
      root = find_root(opts.root)
      root == ""
         |
            fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
            1
         |
            opts.root = root
            opts.store = canonical_path(opts.store)
            opts.is_update = <+>
            opts.update_alias = target_alias
            opts.locked
               |
                  fail(7008, "--locked: update cannot be run with --locked")
                  1
               |
                  m_res = load_manifest(opts.root)
                  m_res
                     | m =>
                        target_alias != "" && !has_dep_alias(m.deps, target_alias)
                           |
                              fail(7004, "dependency '" + target_alias + "' not found in edva.ccl")
                              1
                           |
                              run_fetch(opts)
                     | 1

   find_lock_pkg: LockPackages, String => < LockPackage | >
   find_lock_pkg = pkgs, id =>
      found' = <-->
      pkgs @ p =>
         p.id == id
            |
               found' = <+ p +>
               -->
      found'

   format_pkg_source: LockPackage => String
   format_pkg_source = p =>
      p.kind
         [Git]
            commit_short = ?p.git_commit > 7 | p.git_commit(..7) | p.git_commit
            rev_str = p.git_rev != "" | "#" + p.git_rev | ""
            "git " + p.git_url + rev_str + " (" + commit_short + ")"
         [Path]
            "path " + p.path
         [Archive]
            hash_short = ?p.archive_hash > 8 | p.archive_hash(..8) | p.archive_hash
            "url " + p.archive_url + " (" + hash_short + ")"

   print_dep_tree: LockPackages, LockDeps, String, SMap, SMap => ()
   print_dep_tree = pkgs, deps, indent, visited, dup_map =>
      n = ?deps
      0..n @ i =>
         dep = deps(i) | d => d | LockDep("", "")
         is_last = i == n - 1
         branch = is_last | "└── " | "├── "
         next_indent = indent + (is_last | "    " | "│   ")
         base = pkg_base_name(dep.id)
         is_dup = dup_map ^? base
         dup_tag = is_dup | " [duplicate version]" | ""
         pkg_opt = find_lock_pkg(pkgs, dep.id)
         pkg_opt
            | p =>
               desc = format_pkg_source(p)
               out(indent + branch + dep.alias + " -> " + dep.id + " (" + desc + ")" + dup_tag)
               is_visited = visited ^? dep.id
               is_visited
                  | out(next_indent + "└── ... (cycle)")
                  |
                     visited ^ dep.id = "1"
                     ?p.deps > 0
                        | print_dep_tree(pkgs, p.deps, next_indent, visited, dup_map)
            |
               out(indent + branch + dep.alias + " -> " + dep.id + " (missing)" + dup_tag)

   print_dependency_graph: PackageManifest, Lockfile, String => Int
   print_dependency_graph = m, lock, root_dir =>
      dup_map = SMap()
      pkg_ids = SMap()
      lock.packages @ p =>
         base = pkg_base_name(p.id)
         pkg_ids ^? base
            |
               prev_id = pkg_ids ^ base | _ | ""
               prev_id != p.id
                  |
                     dup_map ^ base = "dup"
                     pkg_ids ^ base = prev_id + ", " + p.id
            |
               pkg_ids ^ base = p.id
      out(m.name + " v" + m.version + " (" + root_dir + ")")
      visited = SMap()
      print_dep_tree(lock.packages, lock.root_deps, "", visited, dup_map)
      has_dups' = <->
      lock.packages @ p =>
         base = pkg_base_name(p.id)
         (dup_map ^? base) && !has_dups' | has_dups' = <+>
      has_dups'
         |
            out("")
            out("Duplicate versions detected:")
            reported = SMap()
            lock.packages @ p =>
               base = pkg_base_name(p.id)
               (dup_map ^? base) && !(reported ^? base)
                  |
                     reported ^ base = "1"
                     ids_str = pkg_ids ^ base | _ | ""
                     out("  " + base + ": " + ids_str)
      0

   cmd_graph: PkgOpts => Int
   cmd_graph = opts =>
      root = find_root(opts.root)
      root == ""
         |
            fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
            1
         |
            opts.root = root
            opts.store = canonical_path(opts.store)
            lock_file = path_join(opts.root, "edva.lock.ccl")
            !file_exists(lock_file)
               |
                  fetch_rc = run_fetch(opts)
                  fetch_rc != 0 | --| fetch_rc
            m_res = load_manifest(opts.root)
            m_res
               | m =>
                  lock_res = read_lock(lock_file)
                  lock_res
                     | lock => print_dependency_graph(m, lock, opts.root)
                     | e =>
                        fail(7018, e.msg)
                        1
               | 1

   cmd_vendor_materialize: PkgOpts, Lockfile => Int
   cmd_vendor_materialize = opts, lock =>
      vendor_dir = path_join(opts.root, "vendor")
      !mkdir_p(vendor_dir)
         |
            fail(7017, "cannot create vendor directory '" + vendor_dir + "'")
            1
         |
            r = Resolver(opts, Insts(), SMap(), Strings(), SMap(), SMap(), SMap(), SMap(),
               Strings(), Strings(), 0, SMap(), SMap(), SMap(), SMap())
            b = {4096}
            b += "vendor = 1\n\n"
            b += "packages =\n"
            ok' = <+>
            count' = 0
            sorted_pkgs = sort_lock_packages(lock.packages)
            sorted_pkgs @ p =>
               ok' |
                  dest_dir = path_join(vendor_dir, p.id)
                  src_dir' = ++ ""
                  p.kind
                     [Git]
                        src_dir' = path_join(opts.store, p.archive_hash)
                     [Archive]
                        src_dir' = path_join(opts.store, p.archive_hash)
                     [Path]
                        src_dir' = canonical_path(path_join(opts.root, p.path))
                  !dir_exists(src_dir')
                     |
                        fail(7014, "package source for '" + p.id + "' not found at '" + src_dir' + "'")
                        ok' = <->
                     |
                        cmd = "rm -rf " + sq(dest_dir) + " && mkdir -p " + sq(dest_dir) +
                           " && cp -R " + sq(src_dir') + "/. " + sq(dest_dir) +
                           " && rm -rf " + sq(path_join(dest_dir, ".git"))
                        sh(cmd) != 0
                           |
                              fail(7017, "cannot materialize vendor package '" + p.id + "'")
                              ok' = <->
                           |
                              tree_hash = compute_tree_hash(r, dest_dir) | th => th | ""
                              b += "  " + p.id + " =\n"
                              b += "    dir = vendor/" + p.id + "\n"
                              p.kind
                                 [Git]
                                    b += "    kind = git\n"
                                    b += "    url = " + p.git_url + "\n"
                                    p.git_rev != "" | b += "    rev = " + p.git_rev + "\n"
                                    p.git_commit != "" | b += "    commit = " + p.git_commit + "\n"
                                    tree_hash != "" | b += "    tree = " + tree_hash + "\n"
                                 [Archive]
                                    b += "    kind = archive\n"
                                    b += "    url = " + p.archive_url + "\n"
                                    b += "    hash = " + p.archive_hash + "\n"
                                    tree_hash != "" | b += "    tree = " + tree_hash + "\n"
                                 [Path]
                                    b += "    kind = path\n"
                                    b += "    path = " + p.path + "\n"
                                    tree_hash != "" | b += "    tree = " + tree_hash + "\n"
                              has_lic = file_exists(path_join(dest_dir, "LICENSE")) ||
                                 file_exists(path_join(dest_dir, "LICENSE.txt")) ||
                                 file_exists(path_join(dest_dir, "LICENSE.md")) ||
                                 file_exists(path_join(dest_dir, "COPYING"))
                              has_lic | b += "    license = retained\n"
                              count' = count' + 1
            !ok'
               | 1
               |
                  ccl_text = +b
                  v_ccl = path_join(vendor_dir, "vendor.ccl")
                  !write_text(v_ccl, ccl_text)
                     |
                        fail(7017, "cannot write " + v_ccl)
                        1
                     |
                        log::info("vendored " + str::from_int(count') +
                           (count' == 1 | " package" | " packages") + " in vendor/")
                        0

   cmd_vendor: PkgOpts => Int
   cmd_vendor = opts =>
      root = find_root(opts.root)
      root == ""
         |
            fail(7015, "no edva.ccl found in '" + opts.root + "' or any parent directory")
            1
         |
            opts.root = root
            opts.store = canonical_path(opts.store)
            fetch_rc = run_fetch(opts)
            fetch_rc != 0
               | --| fetch_rc
            lock_file = path_join(opts.root, "edva.lock.ccl")
            lock_res = read_lock(lock_file)
            lock_res
               | lock => cmd_vendor_materialize(opts, lock)
               | e =>
                  fail(7018, e.msg)
                  1

#public
   dispatch: String, cli::Parsed => Int
   dispatch = subcmd, p =>
      subcmd
         ["init"]
            dir_s = cli::str(p, "dir")
            name_s = cli::str(p, "name")
            is_lib = cli::flag(p, "lib")
            cmd_init(dir_s, name_s, is_lib)
         ["add"]
            resolve_add_opts(p)
               | add_opts => cmd_add(add_opts)
               |
                  fail(7002, "usage: edva add [<alias>] <spec> [--as <alias>] [--rev <rev>] [--path <dir>] [--git <url>]")
                  2
         ["rm", "remove"]
            alias_s = cli::str(p, "alias")
            dir_s = cli::str(p, "dir")
            opts = opts_from_parsed(p, dir_s)
            cmd_rm(opts, alias_s)
         ["fetch"]
            dir_s = cli::str(p, "dir")
            opts = opts_from_parsed(p, dir_s)
            opts.target_filter = cli::str(p, "target")
            cmd_fetch(opts)
         ["check"]
            target_s = cli::str(p, "target-path")
            opts = opts_from_parsed(p, target_s)
            triple_s = cli::str(p, "target")
            cmd_check(opts, triple_s)
         ["build"]
            target_s = cli::str(p, "target-path")
            opts = opts_from_parsed(p, target_s)
            out_s = cli::str(p, "output")
            triple_s = cli::str(p, "target")
            opt_s = cli::str(p, "opt")
            cflags = cli::strs(p, "cflag")
            cmd_build_ex(opts, out_s, triple_s, opt_s, cflags)
         ["run"]
            target_s = cli::str(p, "target-path")
            opts = opts_from_parsed(p, target_s)
            out_s = cli::str(p, "output")
            triple_s = cli::str(p, "target")
            opt_s = cli::str(p, "opt")
            cflags = cli::strs(p, "cflag")
            pass_args = cli::passthrough(p)
            cmd_run(opts, out_s, triple_s, opt_s, cflags, pass_args)
         ["test"]
            target_s = cli::str(p, "target-path")
            opts = opts_from_parsed(p, target_s)
            cmd_test(opts)
         ["update"]
            pos_args = cli::rest(p)
            alias' = ++ ""
            dir' = ++ "."
            pos_args @ a =>
               is_dir_target = file_exists(path_join(a, "edva.ccl")) ||
                  starts_with(a, "/") || starts_with(a, "./") ||
                  starts_with(a, "../") || a == "." || a == ".."
               is_dir_target
                  | dir' = a
                  |
                     alias' == ""
                        | alias' = a
                        | dir' = a
            opts = opts_from_parsed(p, dir')
            cmd_update(opts, alias')
         ["tree", "graph"]
            dir_s = cli::str(p, "dir")
            opts = opts_from_parsed(p, dir_s)
            cmd_graph(opts)
         ["vendor"]
            dir_s = cli::str(p, "dir")
            opts = opts_from_parsed(p, dir_s)
            opts.target_filter = cli::str(p, "target")
            cmd_vendor(opts)
         ["cache"]
            cache_s = cli::str(p, "cache")
            nested_sub = cli::sub(p)
               | sp => cli::subcmd(sp)
               | ""
            action_s = nested_sub != "" | nested_sub | cli::str(p, "action")
            cmd_cache_action(action_s, cache_s)
         |
            fail(7015, "unknown command '" + subcmd + "'")
            2
