                     "rec.fld")
                  fval_j = fvals(j)!!
                  fld_is_rec = types::is_record_vt(fvts'(j) | _ | ast::ValueType(Unknown))
                  fld_is_rec
                     |
                        fld_ty = ftypes(j)!!
                        inner_sz' = llvm::LLVMSizeOf(fld_ty)
                        llvm::LLVMBuildMemCpy(cg.builder, fgep', 1, fval_j, 1,
                           inner_sz', 0)
                     | llvm::LLVMBuildStore(cg.builder, fval_j, fgep')
