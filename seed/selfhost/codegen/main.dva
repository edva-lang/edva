                     fld_is_b = fvt [Builder]
                     ev_is_b = ev'.1 [Builder]
                     is_b_append = fld_is_b && !ev_is_b
                     fld_is_a = fvt [Array]
                     ev_is_a = ev'.1 [Array]
                     is_a_append = fld_is_a && !ev_is_a
                     is_b_append
                        |
                           b_val = llvm::LLVMBuildLoad2(cg.builder, i8p', fgep',
                              "b.fld.load")
                           is_s = ev'.1 [Str]
                           is_s
                              | codegen_builder_append_str(cg, b_val, ev'.0)
                              |
                                 types::is_rune_vt(ev'.1)
                                    | codegen_builder_append_rune(cg, b_val,
                                       ev'.0)
                                    | codegen_builder_append_byte(cg, b_val,
                                       ev'.0)
