                           el_owners = types::enum_label_owner_count(cg, bname, 0)
                           el_owners > 0
                              | types::codegen_eval_enum_label_val(cg, bname,
                                 el_owners)
                              |
                                 rf = types::resolve_fn_name(cg, v.0)
                                 fn_is_val = types::is_fn_name(cg, rf) ||
                                    (expr::fn_alias(cg, rv) != "") || types::has_fn_name(cg, rf) ||
                                    stmt::fn_has_signature(types::g.pstmts, rf, 0) || stmt::fn_has_signature(types::g.pstmts, v.0, 0)
                                 fn_is_val
