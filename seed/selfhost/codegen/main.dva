                  |
                     is_arr_e
                        |
                           new_arr = codegen_array_copy(cg, ev'.0, "a.copy")
                           (new_arr, ast::ValueType(Array))
                        |
                           tgt_vt = types::vt_from_ti(te.ti)
                           tgt_vt != ast::ValueType(Unknown) && tgt_vt != ev'.1
                              | expr::coerce_val(cg, ev'.0, ev'.1, tgt_vt)
                              | (ev'.0, ev'.1)
