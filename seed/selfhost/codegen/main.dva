                                    llvm::LLVMStructGetTypeAtIndex(st',
                                       lookup_idx)
                                 is_rec_ev = ev'.1 [Record]
                                 is_rec_ev
                                    |
                                       inner_sz' = llvm::LLVMSizeOf(target_ft)
                                       llvm::LLVMBuildMemCpy(cg.builder, fgep',
                                          1, ev'.0, 1, inner_sz', 0)
                                    |
