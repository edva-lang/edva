                                          types::is_int_vt(ev'.1)
                                       flag_int_ok
                                          |
                                             c_val = llvm::LLVMBuildICmp(
                                                cg.builder, 33, ev'.0,
                                                llvm::LLVMConstInt(
                                                   llvm::LLVMTypeOf(ev'.0),
                                                   0, 0), "flag.cast")
                                             llvm::LLVMBuildStore(cg.builder,
                                                c_val, fgep')
                                          |
                                             val_st = types::is_int_vt(fvt)
                                                | stmt::coerce_int(cg, ev'.0,
                                                   target_ft)
                                                | ev'.0
                                             llvm::LLVMBuildStore(cg.builder,
                                                val_st, fgep')
                     (ev'.0, ev'.1)
                  | (ev'.0, ev'.1)
      [Record r]
         nf = ?r
         ftypes = types::Addrs()
         fvals = types::Addrs()
         fnames' = ast::Names()
         fvts' = ast::VTypes()
         all_const' = <+>
         all_same_ty' = <+>
         first_ty' = Addr(0)
         nf @ i =>
            tf = r(i) | _ | tast::TypedField(("", tast::mk_lit_unit(0, 0), 0,
               unify::prim_unit()))
            fev = codegen_typed_eval(cg, tf.val)
            fev_is_rec = types::is_record_vt(fev.1)
            rm_f = fev_is_rec
               | runtime::record_meta_from_ti(cg, tf.val.ti)
               | (Addr(0), ast::Names())
            rec_t' = rm_f.0 != Addr(0) | rm_f.0 | cg.last_rt
            raw_fty = fev.0 != Addr(0)
               | llvm::LLVMTypeOf(fev.0)
               | types::llvm_type_of_vt(fev.1)
            fty_i = fev_is_rec | rec_t' | raw_fty
            fev_val = fev.0 != Addr(0) | fev.0 | llvm::LLVMConstNull(fty_i)
            is_c = (fev_val != Addr(0)) && (llvm::LLVMIsConstant(fev_val) != 0)
            !is_c | all_const' = <->
            i == 0
               | first_ty' = fty_i
               | (fty_i != first_ty' | all_same_ty' = <->)
            fvals += fev_val
            ftypes += fty_i
            fnames' += tf.name
            fvts' += fev.1
         st' = types::struct_type_n(cg, ftypes, nf)
         cg.last_rt = st'
         cg.last_fnames = fnames'
         cg.last_fvts = fvts'
         all_const' && all_same_ty' && nf > 0
            |
               buf = {nf * 8}
               esb = &buf
               nf @ k =>
                  @[esb + k * 8] = fvals(k)!!
               arr_ty = llvm::LLVMArrayType(first_ty', nf)
               const_arr = llvm::LLVMConstArray2(first_ty', esb, nf)
               gname = "$const_arr." + str::from_int(?cg.typedefs) + "." + str::from_int(types::g.tmpc)
               types::g.tmpc = types::g.tmpc + 1
               gv = llvm::LLVMAddGlobal(cg.module, arr_ty, gname)
               llvm::LLVMSetInitializer(gv, const_arr)
               llvm::LLVMSetGlobalConstant(gv, 1)
               llvm::LLVMSetUnnamedAddr(gv, 1)
               llvm::LLVMSetLinkage(gv, 8)
