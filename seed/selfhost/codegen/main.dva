                  | stmt::declare_external_var(cg, a.0, a.5.ti)
                  | <->
               (Addr(0), ast::ValueType(Unit))
            | stmt::codegen_typed_eval_assign(cg, a.0, a.1, a.2, a.3, a.4, a.5, te.ti)
      [Call c]
