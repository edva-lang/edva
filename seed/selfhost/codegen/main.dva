      [Choice c]
         match::codegen_typed_eval_choice(cg, c.0, c.1, te.ti)
      [Cycle c]
         stmt::codegen_typed_eval_cycle(cg, c.0, c.1, c.2, c.3, te.ti)
      [CycleJump j]
         stmt::codegen_typed_eval_cycle_jump(cg, j.0, j.1)
      [Index idx]
         expr::codegen_typed_eval_index(cg, idx.0, idx.1, te.ti)
      [IndexWrite iw]
         expr::codegen_typed_eval_index_write(cg, iw.0, iw.1, iw.2, te.ti)
      [KeyAccess ka]
         stmt::codegen_typed_eval_key_access(cg, ka.0, ka.1, ka.2, ka.3, te.ti)
      [BuilderNew b]
         bv = codegen_typed_eval(cg, b)
         (codegen_builder_create(cg, bv.0, "builder.new"),
            ast::ValueType(Builder))
      [RamConstruct rc]
         is_pos = rc.1
         niche = types::is_niche_ram_ti(cg, te.ti)
         niche.0
            | match::codegen_niche_ram_construct(cg, is_pos, niche.1, rc.2)
            |
               is_unboxed = types::is_unboxed_ram_ti(cg, te.ti)
               is_unboxed
