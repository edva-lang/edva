         tgt_ti = types::typed_member_target_ti(cg, mw.0)
         bf_opt = types::ti_get_bitfield(cg, tgt_ti)
         bf_opt
            | bfi =>
               bf_ptr = direct_vname != ""
                  | (types::var_slot(cg, direct_vname) | _ | tv.0)
                  | tv.0
               bf_fld = types::find_bitfield_field(bfi.fields, mw.1)
               bf_fld
                  | bf =>
                     bty = types::llvm_type_of_vt(bfi.backing_type)
                     curr = llvm::LLVMBuildLoad2(cg.builder, bty, bf_ptr,
                        "bf.cur")
                     fmask = (1 .<. bf.bit_width) - 1
                     shifted_mask = fmask .<. bf.bit_offset
                     cmask = .!. shifted_mask
                     cmask_val = llvm::LLVMConstInt(bty, cmask, 0)
                     cleared = llvm::LLVMBuildAnd(cg.builder, curr, cmask_val,
                        "bf.clr")
