                     (ev'.0, ev'.1)
                  | (ev'.0, ev'.1)
            |
               rm_tgt = runtime::record_meta_from_ti(cg, tgt_ti)
               rm' = rm_tgt.0 != Addr(0) | rm_tgt | runtime::record_meta_from_ti(cg, mw.0.ti)
               st_from_var = direct_vname != ""
                  | (types::var_rt(cg, direct_vname) | _ | Addr(0))
                  | Addr(0)
               st' = rm'.0 != Addr(0)
                  | rm'.0
                  | st_from_var
               v_fnames = direct_vname != ""
                  | types::var_fnames(cg, direct_vname)
                  | ast::Names()
               fnames_src = ?rm'.1 > 0
                  | rm'.1
                  | v_fnames
               lookup_idx = mw.1 != "" && ?fnames_src > 0
                  |
                     n_idx = types::member_index(fnames_src, mw.1)
                     n_idx !< 0 | n_idx | mw.2
                  | mw.2
               st_ok = st' != Addr(0) && llvm::LLVMGetTypeKind(st') == 10
               st_ok && tv.0 != Addr(0) && lookup_idx !< 0
                  |
                     fgep' = llvm::LLVMBuildStructGEP2(cg.builder, st', tv.0,
                        lookup_idx, "fld.gep")
                     ti_fvts = types::field_vts(cg, mw.0.ti)
                     fvts' = ?ti_fvts > 0
                        | ti_fvts
                        |
                           direct_vname != ""
                              | match::var_fvts(cg, direct_vname)
                              | ast::VTypes()
