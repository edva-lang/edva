         match::ctfe_lower(cg, ct_res.0, ct_res.1)
      | (Addr(0), ast::ValueType(Unknown))

codegen_typed_emit_stmts: types::Cg, tast::TypedStmts => ()
codegen_typed_emit_stmts = cg, stmts =>
   ?stmts @ i =>
      st = stmts(i) | _ | tast::TypedStmt(Expr, tast::mk_lit_unit(0, 0))
      cg.error | 0 | stmt::codegen_typed_emit_stmt(cg, st)

codegen_typed_program_opts: tast::TypedProgram, ast::Expr, String,
   ast::Names, String, types::CodegenOpts => Int
codegen_typed_program_opts = prog, raw, out_path, exports, src_file, opts =>
   types::g.is_typed_pipeline = <+>
   types::g.foreign_i32_params = ast::Names()
   types::g.view_var_names = ast::Names()
   types::g.fn_ret_recs = types::FnRetRecs()
   types::g.fn_ret_fn_names = ast::Names()
   types::g.fn_ret_fn_tgts = ast::Names()
   types::g.user_fn_seen = ast::Names()
   types::g.expected_fn_ti = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   types::g.ct_bind_names = ast::Names()
   types::g.ct_bind_tis = ast::VInfos()
   types::g.ct_val_names = ast::Names()
   types::g.ct_val_vals = types::CtVals()
   types::g.lambda_env_infos = types::LambdaEnvInfos()
   types::g.marked_globals = ast::Names()
   types::g.restore_scope_var_starts = types::IntArr()
   cg = types::codegen_init(opts)
   cg.source_file = src_file
   raw_exprs = raw
      [Block b] b.exprs
      |
         init_exprs = ast::Exprs()
         init_exprs += raw
         init_exprs
   types::g.pstmts = raw_exprs
   types::g.typed_program_stmts = prog.stmts
   types::g.pexports = exports
   ?raw_exprs @ i_mg =>
      e_mg = raw_exprs(i_mg) | _ | ast::Expr(Int, 0)
      e_mg
         [Assign amg]
            amg.3 && amg.0 != "" && !types::has_str(types::g.marked_globals, amg.0)
               | types::g.marked_globals += amg.0
   !cg.opts.no_runtime | runtime::codegen_emit_runtime(cg) | 0
   types::codegen_build_main(cg)
   stmt::codegen_collect_fns(cg, raw_exprs)
   runtime::codegen_register_types(cg, raw_exprs)
   runtime::codegen_register_forwards(cg, raw_exprs)
   types::codegen_scan_partial_escapes(cg, raw_exprs)
   stmt::codegen_scan_closure_args(cg, raw_exprs)
   stmt::codegen_scan_record_args(cg, raw_exprs)
   stmt::codegen_scan_array_args(cg, raw_exprs)
   stmt::codegen_scan_enum_variant_indices(cg, raw_exprs)
   cg.current_fn = cg.main_fn
   cg.in_fn = <->
   main_entry = llvm::LLVMGetEntryBasicBlock(cg.current_fn)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, main_entry)
   codegen_typed_emit_stmts(cg, prog.stmts)
   cg.opts.is_module
      |
         ?cg.fns @ i_mod_fn =>
            fd_i = cg.fns(i_mod_fn) | _ | empty_fndef
            types::name_is_in_current_module(cg, fd_i.name)
               | stmt::compile_typed_fn_lazy(cg, fd_i.name)
               | <->
      | 0
   cg.error | 0 | runtime::codegen_finish(cg, out_path)
   res = cg.error | 0 | 1
   codegen_destroy(cg)
   res

codegen_typed_program: tast::TypedProgram, ast::Expr, String,
   ast::Names, String => Int
codegen_typed_program = prog, raw_prog, out_path, exports, source_file =>
   codegen_typed_program_opts(prog, raw_prog, out_path, exports, source_file,
      types::default_codegen_opts!)
