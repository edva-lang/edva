                        ast::ValueType(Ram))
      [EnumConstruct ec]
         lbl = ec.0
         pay_opt = ec.1
         bare_lbl = types::decl_bare_name(lbl, 0)
         mod_name = types::decl_module(lbl, 0)
         td_ti = mod_name != "" | types::typedef_ti(cg, mod_name) |
            (te.ti [Enum _] te.ti | types::typedef_ti(cg, te.ti [TypeVar tv] tv | ""))
         slots = td_ti [Enum s] s | (match::enum_slots_for_label(cg, bare_lbl)).1
         ec_idx = types::enum_slot_index(slots, bare_lbl)
         u_val' = match::codegen_typed_build_union(cg, ec_idx, pay_opt, "enum.alloc")
         (u_val', ast::ValueType(Enum))
      [Copy cp]
         ev' = codegen_typed_eval(cg, cp)
         is_str_e = ev'.1 [Str]
         is_rec_e = ev'.1 [Record]
         is_arr_e = ev'.1 [Array]
         is_str_e
            | (expr::codegen_string_copy(cg, ev'.0), ast::ValueType(Str))
            |
               is_rec_e
                  |
                     vname' = cp.kind [Var v] v.0 | ""
                     rm' = runtime::record_meta_from_ti(cg, cp.ti)
                     rt_from_v = vname' != ""
                        |
                           types::var_rt(cg, vname')
                              | _
                              | cg.last_rt
                        | cg.last_rt
                     rec_t' = rm'.0 != Addr(0) | rm'.0 | rt_from_v
                     sz = llvm::LLVMSizeOf(rec_t')
                     new_p = expr::codegen_call_arena_alloc(cg, sz, "record.copy")
                     llvm::LLVMBuildMemCpy(cg.builder, new_p, 1, ev'.0, 1,
                        sz, 0)
                     cg.last_rt = rec_t'
                     ?rm'.1 > 0
                        | cg.last_fnames = rm'.1
                        |
                           vname' != ""
                              | cg.last_fnames = types::var_fnames(cg, vname')
                              | 0
