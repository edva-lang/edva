                                             types::is_user_type(cg, rt_name)
                                                | types::codegen_eval_type_value(cg, rt_name)
                                                | (Addr(0), types::var_type(cg, rv))
      [Bin b]
         expr::codegen_typed_eval_bin(cg, b.0, b.1, b.2, te.ut, te.ti)
      [Unary u]
         expr::codegen_typed_eval_unary(cg, u.0, u.1, te.ut, te.ti)
      [Member m]
         expr::codegen_typed_eval_member(cg, m.0, m.1, m.2, te.ti)
      [MemberWrite mw]
         vname' = stmt::typed_member_root_name(mw.0)
         vname' != "" && var_partial(cg, vname') && !types::alloc_rec_has(vname')
            |
               fvs_sz = ?match::var_fvts(cg, vname') * 8
               sz_c' = types::var_rt(cg, vname')
                  | vrt => llvm::LLVMSizeOf(vrt)
                  | llvm::LLVMConstInt(llvm::LLVMInt64Type!, fvs_sz, 0)
