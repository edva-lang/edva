// Self-hosted compiler driver, Phase 5 foundation.
//
// It loads a target file and file-backed local #use modules, prefixes module
// declarations, then sends one flattened program to the selfhost codegen.
// Directory modules, stdlib fallback, and CLI flags follow.

#use ./diag
#use ./annotate
#use ./dep_graph
#use ./overloads
#use ./ast
#use ./codegen
#use fs
#use path
#use libc
#use ./parser
#use ./show
#use str
#use sys
#use ./tast
#use ./unify
#use mem
#use ccl
#use ./pkg
#use ./formatter
#use ./lsp
#use ./version
#use ./poll
#use cli
#use log
#use time

#public

#foreign("LLVM-18")
   llvm_get_default_triple = LLVMGetDefaultTargetTriple: () => Addr
   llvm_dispose_message = LLVMDisposeMessage: (msg: Addr) => ()

#foreign("c")
   write: (fd: Int, buf: Addr, count: Int) => Int
   mkdir: (path: String, mode: Int) => Int
   chmod: (path: String, mode: i32) => i32
   signal: (sig: Int, handler: Addr) => Addr
   unlink: (path: String) => Int
   rmdir: (path: String) => Int
   getpid: () => Int
   __errno_location: () => Addr

#private
   print: String => Int
   print = s =>
      b = {?s + 1}
      b += s
      b += 10
      write(1, &b, ?b)

#public

#type ModuleLoad (exprs: ast::Exprs, loaded: ast::Names,
  exports: ast::Names, dynamic_mods: ast::Names, dynamic_paths: ast::Names,
  ok: <>, native_libs: ast::Names, native_pkg_config: ast::Names,
  out_files: ast::Names, out_lines: ast::Ints, out_cols: ast::Ints,
  out_mods: ast::Names, loaded_files: ast::Names)
#type SigResult (ti: ast::TypeInfo, ok: <>)
#type ImportMap String ^ String

#type PkgInstance (
   id: String,
   src: String,
   name: String,
   aliases: ImportMap
)

#type PkgInstances PkgInstance{}

#type ImportMapState (
   has_map: <>,
   map_path: String,
   root_dir: String,
   root_name: String,
   instances: PkgInstances,
   native_libs: ast::Names,
   native_pkg_config: ast::Names
)

#type ResolvedFile (path: String, canonical_id: String, is_pkg: <>)
#type ResolvedDir (path: String, canonical_id: String, is_pkg: <>)
#type ResolvedModule <File(ResolvedFile), Dir(ResolvedDir), None>

#type Loader (
   out_exprs: ast::Exprs,
   loaded: ast::Names,
   exports: ast::Names,
   dynamic_mods: ast::Names,
   dynamic_paths: ast::Names,
   is_modular: <>,
   is_dep: <>,
   import_map: ImportMapState,
   loading_stack: ast::Names,
   out_files: ast::Names,
   out_lines: ast::Ints,
   out_cols: ast::Ints,
   out_mods: ast::Names,
   loaded_files: ast::Names,
   functor_args: ast::Names,
   in_dir_module: <>,
   dir_prefix: String,
   dir_publics: ast::Names,
   dir_privates: ast::Names,
   dir_defined: ast::Names
)

#type ImportEntry (bound_name: String, canonical_id: String, is_import: <>)
#type ImportEntries ImportEntry{}
#type ReplSession (
   dir: String,
   src_path: String,
   ll_path: String,
   bin_path: String,
   history: ast::Names
)

dirname: String => String
dirname = p => path::dirname(p)

path_join: String, String => String
path_join = a, b => path::join(a, b)

canonical_path: String => String
canonical_path = p => fs::resolve(p)

compiler_std_dir: String
compiler_std_dir = "std"

compiler_exe_path: String
compiler_exe_path = ""

init_compiler_paths: () => ()
init_compiler_paths = !=>
   exe = canonical_path("/proc/self/exe")
   exe != "/proc/self/exe"
      | compiler_exe_path ::= exe
      | compiler_exe_path ::= canonical_path(sys::argv_string(0))
   exe_dir = dirname(compiler_exe_path)
   prefix_dir = dirname(exe_dir)
   cand_in_tree = path_join(exe_dir, "std")
   cand_lib = path_join(prefix_dir, "lib/edva/std")
   cand_share = path_join(prefix_dir, "share/edva/std")
   dir_exists(cand_in_tree)
      | compiler_std_dir ::= cand_in_tree
      |
         dir_exists(cand_lib)
            | compiler_std_dir ::= cand_lib
            |
               dir_exists(cand_share) | compiler_std_dir ::= cand_share

is_dva_file: String => <>
is_dva_file = name => path::ext(name) == ".dva"

sort_names: ast::Names => ()
sort_names = names =>
   n = ?names
   n @ i =>
      (n - 1) @ j =>
         a = names(j) | _ | ""
         b = names(j + 1) | _ | ""
         str::cmp(a, b) > 0
            |
               names(j) = b !| _
               names(j + 1) = a !| _

dir_dva_files: String => ast::Names
dir_dva_files = dir_path =>
   names = fs::read_dir(dir_path) @> e =>
      !e.is_dir && is_dva_file(e.name) | <+ e.name +>
   sort_names(names)
   names

loaded_has_step: ast::Names, String, Int => <>
loaded_has_step = names, name, i =>
   i !< ?names | --| <->
   (names(i) | _ | "") == name | --| <+>
   loaded_has_step(names, name, i + 1)

loaded_has: ast::Names, String => <>
loaded_has = names, name => loaded_has_step(names, name, 0)

loaded_add: ast::Names, String => ast::Names
loaded_add = names, name =>
   names += name
   names

append_names_to: ast::Names, ast::Names => ()
append_names_to = dest, src =>
   src @ s => dest += s

unmark_private_name: String => String
unmark_private_name = name =>
   ?name > 1 && name(0) == '# | name(1..) | name

unmark_private: ast::Expr => ast::Expr
unmark_private = e =>
   e
      [Assign t]
         ast::Expr(Assign, (unmark_private_name(t.0), t.1, t.2, t.3, t.4,
           t.5, t.6, t.7, t.8))
      [TypeDecl t]
         ast::Expr(TypeDecl, ast::TypeDeclExpr(unmark_private_name(t.name),
           t.type_info))
      [Foreign f]
         ast::Expr(Foreign, ast::ForeignFnDecl(f.c_name,
           unmark_private_name(f.dva_name), f.abi, f.params,
           f.return_type, f.ret_record_info, f.is_variable))
      [Block b]
         ast::Expr(Block, unmark_private_exprs(b))
      | e

unmark_private_exprs: ast::Exprs => ast::Exprs
unmark_private_exprs = exprs =>
   exprs @> unmark_private

has_dcolon_step: String, Int => <>
has_dcolon_step = s, i =>
   i + 1 !< ?s | --| <->
   s(i) == ': && s(i + 1) == ': | --| <+>
   has_dcolon_step(s, i + 1)

has_dcolon: String => <>
has_dcolon = s => has_dcolon_step(s, 0)

// Walk a Member chain to the root, prefix the root Var.
prefix_member_root: ast::Expr, String => ast::Expr
prefix_member_root = e, prefix =>
   e
      [Member m]
         new_target = prefix_member_root(m.target, prefix)
         ast::Expr(Member, ast::MemberExpr(new_target,
           m.field_name, m.is_module_access,
           m.index_expr, m.line, m.col))
      [Var v]
         has_dcolon(v)
            | ast::Expr(Var, v)
            | ast::Expr(Var, (prefix + "::" + v))
      | e

// Prefix the root of an assignment LHS (Member or Call).
prefix_lhs_expr: ast::Expr, String => ast::Expr
prefix_lhs_expr = lhs, prefix =>
   lhs
      [Member m]
         !m.is_module_access
            | prefix_member_root(lhs, prefix)
            | lhs
      [Call c]
         has_dcolon(c.fn_name)
            | lhs
            |
               ast::Expr(Call, ast::CallExpr(
                  prefix + "::" + c.fn_name,
                  c.fn_target, c.args,
                  c.line, c.col))
      | lhs

is_public_name: ast::Names, ast::Names, String => <>
is_public_name = publics, privates, name =>
   loaded_has(publics, name) && !loaded_has(privates, "#priv:${name}")

decl_clean_name: String => String
decl_clean_name = s =>
   (?s > 0 && s(0) == '#) | s(1..) | s

is_generic_fn: ast::Expr => <>
is_generic_fn = e =>
   e
      [Fn fe] (?fe.ct_params > 0)
      | <->

is_generic_assign: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
  String, ast::TypeInfo) => <>
is_generic_assign = t =>
   is_ct = ?t.7 > 4 && t.7(0..4) == "@ct0"
   is_ti = t.8 [Fn f] (?f.4 > 0) | <->
   is_fe = is_generic_fn(t.5)
   is_ct || is_ti || is_fe

acc_has_generic_sig: ast::Exprs, String => <>
acc_has_generic_sig = acc, qname =>
   found' = <->
   acc @ st =>
      st
         [Assign a]
            a.0 == qname && is_generic_assign(a)
               |
                  found' = <+>
                  -->
   found'

prefix_decl_name: String, String, ast::Names, ast::Names => String
prefix_decl_name = name, prefix, publics, privates =>
   has_hash = ?name > 0 && name(0) == '#
   clean = has_hash | name(1..) | name
   is_pub = is_public_name(publics, privates, clean)
   pfx = prefix + "::"
   is_pub | pfx + clean | pfx + "#" + clean

add_priv_dep_cand: String, String, ast::Names, ast::Names, ast::Names => ()
add_priv_dep_cand = raw, prefix, cands, needed, work =>
   raw == "" | --|
   pfx = prefix != "" | "${prefix}::" | ""
   no_mod = (pfx != "" && starts_with(raw, pfx)) | raw(?pfx..) | raw
   clean = decl_clean_name(no_mod)
   clean != "" && loaded_has(cands, clean) && !loaded_has(needed, clean)
      |
         needed += clean
         work += clean

collect_ti_priv_deps: ast::TypeInfo, String, ast::Names, ast::Names, ast::Names => ()
collect_ti_priv_deps = ti, prefix, cands, needed, work =>
   ti
      [TypeVar name] add_priv_dep_cand(name, prefix, cands, needed, work)
      [Align a] collect_ti_priv_deps(a.1, prefix, cands, needed, work)
      [Rec r]
         r.0 @ f => collect_ti_priv_deps(f.rec_type, prefix, cands, needed, work)
      [Fn f]
         f.1 @ p => collect_ti_priv_deps(p, prefix, cands, needed, work)
         collect_ti_priv_deps(f.3, prefix, cands, needed, work)
      [Ram r]
         r.0.has_payload | collect_ti_priv_deps(r.0.payload_record, prefix, cands, needed, work)
         r.1.has_payload | collect_ti_priv_deps(r.1.payload_record, prefix, cands, needed, work)
      [Enum es]
         es @ s =>
            s.has_payload | collect_ti_priv_deps(s.payload_record, prefix, cands, needed, work)
      [Array a] collect_ti_priv_deps(a.1, prefix, cands, needed, work)
      [Map m] collect_ti_priv_deps(m.2, prefix, cands, needed, work)
      [ThreadId t] collect_ti_priv_deps(t.1, prefix, cands, needed, work)

collect_expr_priv_deps_list: ast::Exprs, String, ast::Names, ast::Names, ast::Names => ()
collect_expr_priv_deps_list = es, prefix, cands, needed, work =>
   es @ item => collect_expr_priv_deps(item, prefix, cands, needed, work)

collect_expr_priv_deps: ast::Expr, String, ast::Names, ast::Names, ast::Names => ()
collect_expr_priv_deps = e, prefix, cands, needed, work =>
   e
      [Var v] add_priv_dep_cand(v, prefix, cands, needed, work)
      [Call c]
         add_priv_dep_cand(c.fn_name, prefix, cands, needed, work)
         collect_expr_priv_deps(c.fn_target, prefix, cands, needed, work)
         collect_expr_priv_deps_list(c.args, prefix, cands, needed, work)
      [Bin b]
         collect_expr_priv_deps(b.1, prefix, cands, needed, work)
         collect_expr_priv_deps(b.2, prefix, cands, needed, work)
      [Unary u] collect_expr_priv_deps(u.1, prefix, cands, needed, work)
      [Fn fe] collect_expr_priv_deps(fe.body, prefix, cands, needed, work)
      [Block b] collect_expr_priv_deps_list(b, prefix, cands, needed, work)
      [Choice ch]
         collect_expr_priv_deps(ch.cond, prefix, cands, needed, work)
         ch.branches @ br =>
            collect_expr_priv_deps_list(br.case_values, prefix, cands, needed, work)
            collect_expr_priv_deps(br.pred_fn, prefix, cands, needed, work)
            collect_expr_priv_deps(br.block, prefix, cands, needed, work)
            br.variant_names @ vn => add_priv_dep_cand(vn, prefix, cands, needed, work)
      [Assign a]
         collect_expr_priv_deps(a.5, prefix, cands, needed, work)
         collect_expr_priv_deps(a.6, prefix, cands, needed, work)
         add_priv_dep_cand(a.7, prefix, cands, needed, work)
         collect_ti_priv_deps(a.8, prefix, cands, needed, work)
      [TypeDecl td] collect_ti_priv_deps(td.type_info, prefix, cands, needed, work)
      [Foreign f]
         f.params @ fp => collect_ti_priv_deps(fp.record_info, prefix, cands, needed, work)
         collect_ti_priv_deps(f.ret_record_info, prefix, cands, needed, work)
      [Member m]
         collect_expr_priv_deps(m.target, prefix, cands, needed, work)
         collect_expr_priv_deps(m.index_expr, prefix, cands, needed, work)
      [Record re]
         re.fields @ fld => collect_expr_priv_deps(fld.val, prefix, cands, needed, work)
      [KeyAccess ka]
         collect_expr_priv_deps(ka.target, prefix, cands, needed, work)
         collect_expr_priv_deps(ka.key, prefix, cands, needed, work)
      [Cycle cy]
         collect_expr_priv_deps(cy.iterable, prefix, cands, needed, work)
         collect_expr_priv_deps(cy.body_fn, prefix, cands, needed, work)
      [CycleEscape ce]
         collect_expr_priv_deps(ce.cycle, prefix, cands, needed, work)
         collect_expr_priv_deps(ce.branch, prefix, cands, needed, work)
      [Range r]
         r.has_lhs | collect_expr_priv_deps(r.lhs, prefix, cands, needed, work)
         r.has_rhs | collect_expr_priv_deps(r.rhs, prefix, cands, needed, work)
      [NamedArg na] collect_expr_priv_deps(na.val, prefix, cands, needed, work)
      [Variant v] collect_expr_priv_deps_list(v.args, prefix, cands, needed, work)
      [TypeCast tc] collect_expr_priv_deps(tc.expr, prefix, cands, needed, work)
      [Spawn sp]
         add_priv_dep_cand(sp.fn_name, prefix, cands, needed, work)
         collect_expr_priv_deps(sp.fn_target, prefix, cands, needed, work)
         collect_expr_priv_deps_list(sp.args, prefix, cands, needed, work)
      [Join jn] collect_expr_priv_deps(jn, prefix, cands, needed, work)
      [Exit ex] collect_expr_priv_deps(ex, prefix, cands, needed, work)
      [Return r]
         r.has_val | collect_expr_priv_deps(r.val, prefix, cands, needed, work)
      [ArrayCreate ac] collect_ti_priv_deps(ac.elem_type, prefix, cands, needed, work)
      [UserDiag ud] collect_expr_priv_deps(ud.msg, prefix, cands, needed, work)
      [RawMemory rm]
         collect_expr_priv_deps(rm.addr, prefix, cands, needed, work)
         add_priv_dep_cand(rm.rec_name, prefix, cands, needed, work)
      [SizeOf so] collect_ti_priv_deps(so.rec_type, prefix, cands, needed, work)
      [AlignOf ao] collect_ti_priv_deps(ao.rec_type, prefix, cands, needed, work)
      [MapLiteral ml]
         ml @ p =>
            collect_expr_priv_deps(p.key, prefix, cands, needed, work)
            collect_expr_priv_deps(p.value, prefix, cands, needed, work)
      [CompileTime ct] collect_expr_priv_deps(ct, prefix, cands, needed, work)
      [Copy cp] collect_expr_priv_deps(cp, prefix, cands, needed, work)
      [BuilderCreate bc] collect_expr_priv_deps(bc, prefix, cands, needed, work)

collect_priv_candidates_step: ast::Exprs, ast::Names, ast::Names, ast::Names => ()
collect_priv_candidates_step = stmts, publics, privates, out =>
   stmts @ st =>
      st
         [Block b] collect_priv_candidates_step(b, publics, privates, out)
         [TypeDecl td]
            clean = decl_clean_name(td.name)
            clean != "" && !is_public_name(publics, privates, clean) && !loaded_has(out, clean)
               | (out += clean)
         [Foreign f]
            clean = decl_clean_name(f.dva_name)
            clean != "" && !is_public_name(publics, privates, clean) && !loaded_has(out, clean)
               | (out += clean)
         [Assign a]
            a.0 != ""
               |
                  clean = decl_clean_name(a.0)
                  clean != "" && !is_public_name(publics, privates, clean) && !loaded_has(out, clean)
                     | (out += clean)

scan_pub_generic_seeds: ast::Exprs, ast::Names, ast::Names, String, ast::Names, ast::Names, ast::Names, ast::Names => ()
scan_pub_generic_seeds = stmts, publics, privates, prefix, pub_gen_names, cands, needed, work =>
   stmts @ st =>
      st
         [Block b]
            scan_pub_generic_seeds(b, publics, privates, prefix, pub_gen_names, cands, needed, work)
         [TypeDecl td]
            clean = decl_clean_name(td.name)
            is_public_name(publics, privates, clean)
               | collect_ti_priv_deps(td.type_info, prefix, cands, needed, work)
         [Foreign f]
            clean = decl_clean_name(f.dva_name)
            is_public_name(publics, privates, clean)
               | collect_expr_priv_deps(st, prefix, cands, needed, work)
         [Assign a]
            a.0 != ""
               |
                  clean = decl_clean_name(a.0)
                  is_public_name(publics, privates, clean)
                     |
                        collect_ti_priv_deps(a.8, prefix, cands, needed, work)
                        loaded_has(pub_gen_names, clean)
                           | collect_expr_priv_deps(a.5, prefix, cands, needed, work)

expand_priv_dep_item: ast::Exprs, String, String, ast::Names, ast::Names, ast::Names => ()
expand_priv_dep_item = stmts, target_clean, prefix, cands, needed, work =>
   stmts @ st =>
      st
         [Block b] expand_priv_dep_item(b, target_clean, prefix, cands, needed, work)
         [TypeDecl td]
            decl_clean_name(td.name) == target_clean
               | collect_ti_priv_deps(td.type_info, prefix, cands, needed, work)
         [Foreign f]
            decl_clean_name(f.dva_name) == target_clean
               | collect_expr_priv_deps(st, prefix, cands, needed, work)
         [Assign a]
            a.0 != "" && decl_clean_name(a.0) == target_clean
               | collect_expr_priv_deps(st, prefix, cands, needed, work)

collect_pub_gen_names_step: ast::Exprs, ast::Names, ast::Names, ast::Names => ()
collect_pub_gen_names_step = stmts, publics, privates, pub_gen_names =>
   stmts @ st =>
      st
         [Block b]
            collect_pub_gen_names_step(b, publics, privates, pub_gen_names)
         [Assign a]
            a.0 != "" && is_generic_assign(a)
               |
                  clean = decl_clean_name(a.0)
                  is_public_name(publics, privates, clean) &&
                    !loaded_has(pub_gen_names, clean)
                     | (pub_gen_names += clean)

collect_pub_generic_priv_deps: ast::Exprs, ast::Names, ast::Names, String => ast::Names
collect_pub_generic_priv_deps = stmts, publics, privates, prefix =>
   cands = ast::Names()
   collect_priv_candidates_step(stmts, publics, privates, cands)
   ?cands == 0 | --| ast::Names()
   pub_gen_names = ast::Names()
   collect_pub_gen_names_step(stmts, publics, privates, pub_gen_names)
   needed = ast::Names()
   work = ast::Names()
   scan_pub_generic_seeds(stmts, publics, privates, prefix, pub_gen_names, cands, needed, work)
   w_idx' = 0
   0.. @
      w_idx' !< ?work | -->
      cur_w = work(w_idx').expect("missing work")
      w_idx' = w_idx' + 1
      expand_priv_dep_item(stmts, cur_w, prefix, cands, needed, work)
   needed

prefix_stmt_to_acc: ast::Expr, String, ast::Names, ast::Names, ast::Exprs, <>, ast::Names => ()
prefix_stmt_to_acc = e, prefix, publics, privates, acc, is_interface, priv_deps =>
   prefix == ""
      |
         e
            [Block b]
               b @ child =>
                  prefix_stmt_to_acc(child, "", publics, privates, acc, is_interface, priv_deps)
            |
               acc += unmark_private(e)
      |
         is_interface
            |
               e
                  [Block b]
                     b @ child =>
                        prefix_stmt_to_acc(child, prefix, publics, privates, acc, <+>, priv_deps)
                  [TypeDecl t]
                     clean = decl_clean_name(t.name)
                     is_pub = is_public_name(publics, privates, clean)
                     keep_priv = !is_pub && loaded_has(priv_deps, clean)
                     is_pub || keep_priv
                        |
                           new_td = is_pub | "${prefix}::${clean}" | "${prefix}::#${clean}"
                           acc += ast::Expr(TypeDecl, ast::TypeDeclExpr(new_td,
                             t.type_info))
                  [Foreign f]
                     clean = decl_clean_name(f.dva_name)
                     is_pub = is_public_name(publics, privates, clean)
                     keep_priv = !is_pub && loaded_has(priv_deps, clean)
                     is_pub || keep_priv
                        |
                           new_f = is_pub | "${prefix}::${clean}" | "${prefix}::#${clean}"
                           acc += ast::Expr(Foreign, ast::ForeignFnDecl(f.c_name,
                             new_f, f.abi, f.params,
                             f.return_type, f.ret_record_info, f.is_variable))
                  [Assign t]
                     t.0 != ""
                        |
                           clean = decl_clean_name(t.0)
                           is_pub = is_public_name(publics, privates, clean)
                           keep_priv = !is_pub && loaded_has(priv_deps, clean)
                           is_pub || keep_priv
                              |
                                 new_asgn = is_pub | "${prefix}::${clean}" | "${prefix}::#${clean}"
                                 is_fn = t.5 [Fn]
                                 should_add = keep_priv || !is_fn ||
                                   is_generic_assign(t) || acc_has_generic_sig(acc, new_asgn)
                                 should_add
                                    |
                                       acc += ast::Expr(Assign, (
                                          new_asgn, t.1, t.2,
                                          t.3, t.4, t.5, t.6, t.7, t.8))
            |
               e
                  [Assign t]
                     t.0 == ""
                        |
                           new_lhs = prefix_lhs_expr(t.6, prefix)
                           acc += ast::Expr(Assign, (t.0, t.1,
                             t.2, t.3, t.4, t.5, new_lhs,
                             t.7, t.8))
                        |
                           new_asgn = prefix_decl_name(t.0, prefix,
                             publics, privates)
                           acc += ast::Expr(Assign, (
                              new_asgn, t.1, t.2,
                              t.3, t.4, t.5, t.6, t.7, t.8))
                  [TypeDecl t]
                     new_td = prefix_decl_name(t.name, prefix, publics, privates)
                     acc += ast::Expr(TypeDecl, ast::TypeDeclExpr(new_td,
                       t.type_info))
                  [Foreign f]
                     new_f = prefix_decl_name(f.dva_name, prefix,
                       publics, privates)
                     acc += ast::Expr(Foreign, ast::ForeignFnDecl(f.c_name,
                       new_f, f.abi, f.params,
                       f.return_type, f.ret_record_info, f.is_variable))
                  [Block b]
                     b @ child =>
                        prefix_stmt_to_acc(child, prefix, publics, privates, acc, <->, priv_deps)
                  |
                     acc += e

file_exists: String => <>
file_exists = path => lsp::has_override(path) || (fs::exists(path) && !fs::is_dir(path))

loader_error: Int, String, String => ()
loader_error = code, path, msg =>
   diag::is_capturing!
      | diag::record_diag(code, path, 1, 1, msg, <->)
      | log::error(msg)

dir_exists: String => <>
dir_exists = path => fs::is_dir(path)

path_mtime: String => Int
path_mtime = path => fs::mtime_ns(path)

empty_pkg_instance: () => PkgInstance
empty_pkg_instance = !=>
   m = ImportMap()
   PkgInstance("", "", "", m)

empty_import_map_state: () => ImportMapState
empty_import_map_state = !=>
   insts = PkgInstances()
   nl = ast::Names()
   np = ast::Names()
   ImportMapState(<->, "", "", "", insts, nl, np)

find_instance: PkgInstances, String => < PkgInstance | >
find_instance = instances, id =>
   res' = <-->
   instances @ inst =>
      inst.id == id | (res' = <+ inst +>; -->)
   res'

find_char_idx: String, Int, Int => Int
find_char_idx = s, ch, i =>
   i < ?s
      | s(i) == ch | i | find_char_idx(s, ch, i + 1)
      | -1

starts_with: String, String => <>
starts_with = s, prefix =>
   lp = ?prefix
   ?s !< lp && s(0..lp) == prefix

ends_with: String, String => <>
ends_with = s, suffix =>
   ls = ?suffix
   ln = ?s
   ln !< ls && s(ln - ls..ln) == suffix

has_substr_step: String, String, Int => <>
has_substr_step = s, sub, i =>
   i + ?sub !> ?s
      |
         match' = <+>
         ?sub @ j =>
            s(i + j) != sub(j)
               |
                  match' = <->
                  -->
         match' | <+> | has_substr_step(s, sub, i + 1)
      | <->

has_substr: String, String => <>
has_substr = s, sub => has_substr_step(s, sub, 0)

string_contains: String, String => <>
string_contains = s, sub => has_substr(s, sub)

starts_with_path: String, String => <>
starts_with_path = p, prefix => path::has_prefix(p, prefix)

get_dir_instance: ImportMapState, String => PkgInstance
get_dir_instance = map, dir =>
   canon_dir = canonical_path(dir)
   found' = empty_pkg_instance!
   is_found' = <->
   map.instances @ inst =>
      !is_found' && inst.id != "root" && inst.src != ""
         |
            canon_src = canonical_path(inst.src)
            match = path::has_prefix(canon_dir, canon_src)
            match | (found' = inst; is_found' = <+>)
   !is_found' && map.root_dir != ""
      |
         canon_root = canonical_path(map.root_dir)
         match_root = path::has_prefix(canon_dir, canon_root)
         match_root
            |
               map.instances @ inst =>
                  inst.id == "root" | (found' = inst; is_found' = <+>)
   found'

compute_eff_root: String, String => String
compute_eff_root = map_root, map_dir =>
   map_root == "" || map_root == "."
      | map_dir
      | path::is_abs(map_root)
         | map_root
         | path_join(map_dir, map_root)

find_and_load_import_map: String, String => < ImportMapState | >
find_and_load_import_map = target_path, explicit_map_path =>
   map_path' = explicit_map_path
   root_dir' = ++ ""
   has_map_file' = <->
   explicit_map_path != ""
      |
         map_path' = explicit_map_path
         has_map_file' = file_exists(explicit_map_path)
      |
         target_full = canonical_path(target_path)
         start_dir = dir_exists(target_full) | target_full | dirname(target_full)
         curr_dir' = start_dir
         0..128 @
            curr_dir' == "" || curr_dir' == "/" | -->
            cand_ccl = path_join(curr_dir', "edva.ccl")
            file_exists(cand_ccl)
               |
                  root_dir' = curr_dir'
                  cand_map = path_join(curr_dir', ".edva/imports.ccl")
                  file_exists(cand_map)
                     |
                        map_path' = cand_map
                        has_map_file' = <+>
                  -->
            next_d = dirname(curr_dir')
            next_d == curr_dir' | -->
            curr_dir' = next_d
   !has_map_file'
      |
         empty_state = empty_import_map_state!
         empty_state.root_dir = root_dir'
         <+ empty_state +>
      |
         mtime_map = path_mtime(map_path')
         doc_res = ccl::parse_file(map_path')
         doc_res
            | doc =>
               map_root = ccl::get(doc, "root") | _ | ""
               map_dir = root_dir' != "" | root_dir' | dirname(dirname(map_path'))
               eff_root = compute_eff_root(map_root, map_dir)
               ccl_file = path_join(eff_root, "edva.ccl")
               ccl_stale = file_exists(ccl_file) && mtime_map < path_mtime(ccl_file)
               lock_file = path_join(eff_root, "edva.lock.ccl")
               lock_stale = file_exists(lock_file) && mtime_map < path_mtime(lock_file)
               ccl_stale || lock_stale
                  |
                     log::error $ "E5031: import map is older than edva.ccl — run 'edva fetch'"
                     <-->
                  |
                     inst_list = PkgInstances()
                     root_name' = ++ ""
                     file_exists(ccl_file)
                        |
                           ccl_doc_res = ccl::parse_file(ccl_file)
                           ccl_doc_res
                              | cdoc =>
                                 root_name' = ccl::get(cdoc, "name") | _ | ""
                     inst_sec_opt = ccl::get_section(doc, "instances")
                     inst_sec_opt
                        | sec =>
                           sec @ entry =>
                              inst_id = entry.key
                              entry.val
                                 [Block b]
                                    isrc_raw = ccl::get(b, "src") | _ | ""
                                    is_rel = isrc_raw != "" && path::is_rel(isrc_raw)
                                    isrc = is_rel | path_join(eff_root, isrc_raw) | isrc_raw
                                    iname_raw = ccl::get(b, "name") | _ | ""
                                    use_root_name = inst_id == "root" && iname_raw == ""
                                    iname = use_root_name | root_name' | iname_raw
                                    aliases_map = ImportMap()
                                    asec_opt = ccl::get_section(b, "aliases")
                                    asec_opt
                                       | asec =>
                                          asec @ ae =>
                                             ae.val
                                                [Str aval]
                                                   aliases_map ^ ae.key = aval
                                    inst_list += PkgInstance(inst_id, isrc, iname, aliases_map)
                     nat_libs' = ast::Names()
                     nat_pkg' = ast::Names()
                     nat_sec_opt = ccl::get_section(doc, "native")
                     nat_sec_opt
                        | nsec =>
                           libs_list_opt = ccl::get_list(nsec, "libs")
                           libs_list_opt
                              | llist =>
                                 llist @ s => nat_libs' += s
                           pkg_list_opt = ccl::get_list(nsec, "pkg-config")
                           pkg_list_opt
                              | plist =>
                                 plist @ s => nat_pkg' += s
                     <+ ImportMapState(<+>, map_path', eff_root, root_name', inst_list,
                       nat_libs', nat_pkg') +>
            |
               log::error $ "E5030: Could not parse import map '" + map_path' + "'"
               <-->

compute_local_cid: PkgInstance, String => String
compute_local_cid = curr_inst, mod_path =>
   seg = parser::last_segment(mod_path)
   curr_inst.id != "" && curr_inst.id != "root"
      | curr_inst.id + "::" + seg
      | seg

get_resolved_cid: ResolvedModule => String
get_resolved_cid = r =>
   r
      [File f] f.canonical_id
      [Dir d] d.canonical_id
      | ""

get_resolved_is_pkg: ResolvedModule => <>
get_resolved_is_pkg = r =>
   r
      [File f] f.is_pkg
      [Dir d] d.is_pkg
      | <->

find_name_idx: ast::Names, String => Int
find_name_idx = names, name =>
   idx' = -1
   0..?names @ i =>
      n = names(i) | _ | ""
      n == name | (idx' = i; -->)
   idx'

format_cycle_chain: ast::Names, Int, String => String
format_cycle_chain = stack, start_idx, target =>
   b = {128}
   start_idx..?stack @ i =>
      n = stack(i) | _ | ""
      i > start_idx | b += " -> "
      b += n
   b += " -> "
   b += target
   +b

pop_loading_stack: Loader => ()
pop_loading_stack = ldr =>
   n = ?ldr.loading_stack
   n > 0
      |
         stk = ast::Names()
         0..n - 1 @ i =>
            stk += (ldr.loading_stack(i) | _ | "")
         ldr.loading_stack = stk

// "<dir>/<mod_path>.dva" as a file module, else "<dir>/<mod_path>/" as a
// directory module, else None.
resolve_in_dir: String, String, String, <> => ResolvedModule
resolve_in_dir = dir, mod_path, cid, is_pkg =>
   f = path::normalize(path_join(dir, mod_path + ".dva"))
   d = path::normalize(path_join(dir, mod_path))
   file_exists(f)
      | ResolvedModule(File, ResolvedFile(f, cid, is_pkg))
      | dir_exists(d)
         | ResolvedModule(Dir, ResolvedDir(d, cid, is_pkg))
         | ResolvedModule(None)

is_resolved: ResolvedModule => <>
is_resolved = r =>
   r
      [None] <->
      | <+>

is_internal_path: String => <>
is_internal_path = p =>
   p == "internal" || starts_with(p, "internal/") ||
     string_contains(p, "/internal/") || ends_with(p, "/internal")

// "@alias" -> the root module src/<name>.dva of the aliased package instance.
resolve_pkg_root: String, String, PkgInstance => ResolvedModule
resolve_pkg_root = alias, inst_id, inst =>
   root_f = path_join(inst.src, inst.name + ".dva")
   file_exists(root_f)
      | ResolvedModule(File, ResolvedFile(root_f, inst_id + "::" + inst.name, <+>))
      |
         log::error $ "E5033: #use @" + alias + ": package '" + inst.name +
           "' has no root module src/" + inst.name + ".dva"
         ResolvedModule(None)

// "@alias/submod" -> a public (non-internal) module of the package instance.
resolve_pkg_sub: String, String, String, PkgInstance => ResolvedModule
resolve_pkg_sub = alias, submod, inst_id, inst =>
   use_path = "#use @" + alias + "/" + submod
   is_internal_path(submod)
      |
         log::error $ "E5035: " + use_path + ": module is internal to package '" +
           inst.name + "'"
         ResolvedModule(None)
      |
         r = resolve_in_dir(inst.src, submod, inst_id + "::" + submod, <+>)
         !is_resolved(r)
            | log::error $ "E5034: " + use_path + ": package '" + inst.name +
              "' has no module '" + submod + "'"
         r

// "@alias[/submod]": only a direct dependency of the importing package.
resolve_pkg_module: String, String, Loader => ResolvedModule
resolve_pkg_module = base, mod_path, ldr =>
   curr_inst = get_dir_instance(ldr.import_map, base)
   slash_idx = find_char_idx(mod_path, '/, 0)
   alias = slash_idx < 0 | mod_path(1..) | mod_path(1..slash_idx)
   submod = slash_idx < 0 | "" | mod_path(slash_idx + 1..)
   alias == curr_inst.name
      |
         log::error $ "E5037: #use @" + alias +
           ": a package cannot import itself; use a local #use"
         ResolvedModule(None)
      | !(curr_inst.aliases ^? alias)
         |
            log::error $ "E5032: #use @" + alias + ": '" + alias +
              "' is not a dependency of package '" + curr_inst.name + "'"
            ResolvedModule(None)
         |
            inst_id = curr_inst.aliases ^ alias | _ | ""
            find_instance(ldr.import_map.instances, inst_id)
               | inst =>
                  submod == ""
                     | resolve_pkg_root(alias, inst_id, inst)
                     | resolve_pkg_sub(alias, submod, inst_id, inst)
               | ResolvedModule(None)

// A local "#use ./name" or "#use ../name": strictly relative to the importer's directory.
resolve_local_module: String, String, Loader => ResolvedModule
resolve_local_module = base, mod_path, ldr =>
   curr_inst = ldr.import_map.has_map
      | get_dir_instance(ldr.import_map, base)
      | empty_pkg_instance!
   cid = compute_local_cid(curr_inst, mod_path)
   resolve_in_dir(base, mod_path, cid, <->)

resolve_std_module: String => ResolvedModule
resolve_std_module = mod_path =>
   seg = parser::last_segment(mod_path)
   std = resolve_in_dir(compiler_std_dir, mod_path, seg, <->)
   is_resolved(std) || compiler_std_dir == "std"
      | std
      | resolve_in_dir("std", mod_path, seg, <->)

is_rel_module_path: String => <>
is_rel_module_path = mod_path =>
   starts_with(mod_path, "./") || starts_with(mod_path, "../")

resolve_module: String, String, Loader => ResolvedModule
resolve_module = base, mod_path, ldr =>
   is_pkg_import = ?mod_path > 0 && mod_path(0) == '@
   is_pkg_import
      | !ldr.import_map.has_map
         |
            log::error $ "E5030: #use " + mod_path + ": no import map — run 'edva fetch'"
            ResolvedModule(None)
         | resolve_pkg_module(base, mod_path, ldr)
      | is_rel_module_path(mod_path)
         | resolve_local_module(base, mod_path, ldr)
         | resolve_std_module(mod_path)

read_fd_bytes_loop: Int, Builder, Int => <>
read_fd_bytes_loop = fd, b, rem =>
   rem == 0 | --| <+>
   chunk = rem < 65536 | rem | 65536
   n = mem::write_tail(b, chunk, (dst, avail => libc::read(fd, dst, avail)))
   n < 0
      |
         err = @[__errno_location! i32]
         err == 4 | read_fd_bytes_loop(fd, b, rem) | <->
      |
         n == 0 | <+> | read_fd_bytes_loop(fd, b, rem - n)

read_file_text: String => < String | >
read_file_text = path =>
   lsp::get_override_text(path)
      | txt => <+ txt +>
      |
         fd = libc::open(path, 0)
         fd < 0 | --| <-->
         sz = libc::lseek(fd, 0, 2)
         sz < 0 | libc::close(fd); --| <-->
         sz == 0 | libc::close(fd); --| <+ "" +>
         libc::lseek(fd, 0, 0)
         b = {sz}
         ok = read_fd_bytes_loop(fd, b, sz)
         libc::close(fd)
         ok | <+ +b +> | <-->

type_info_known: ast::Exprs, ast::TypeInfo, String, ast::Names => <>
type_info_known = exprs, ti, owner, seen =>
   ti
      [Align a] type_info_known(exprs, a.1, owner, seen)
      [TypeVar name]
         loaded_has(seen, name) | --| <+>
         visited = ++seen
         visited += name
         exprs @ e =>
            e [TypeDecl td]
               (td.name [name, owner + "::" + name, owner + "::#" + name])
                  | --| type_info_known(exprs, td.type_info,
                     dep_graph::decl_module(td.name, 0), visited)
         <->
      | <+>

module_record_fields: ast::Exprs, ast::TypeInfo, String, ast::Names => ast::Names
module_record_fields = exprs, ti, owner, seen =>
   fields = ast::Names()
   ti
      [Rec r]
         r.0 @ field =>
            fields += field.name
      [Bitfield bf]
         bf.fields @ field =>
            fields += field.name
      [Enum es]
         es @ slot =>
            fields += slot.label
      [Align a]
         --| module_record_fields(exprs, a.1, owner, seen)
      [TypeVar name]
         loaded_has(seen, name) | --| fields
         visited = ++seen
         visited += name
         exprs @ e =>
            e [TypeDecl td]
               (td.name [name, owner + "::" + name, owner + "::#" + name])
                  | --| module_record_fields(exprs, td.type_info,
                     dep_graph::decl_module(td.name, 0), visited)
      |
         noop_ = 0
   fields

collect_module_exports: ast::Exprs, String, String, <>, ImportMap, ImportMap => <>
collect_module_exports = exprs, bound_name, canonical_id, is_import, table, sources =>
   ok' = <+>
   pfx = canonical_id + "::"
   pfx_priv = canonical_id + "::#"
   lpfx = ?pfx
   lpfx_priv = ?pfx_priv
   alias_pfx = bound_name + "::"
   table ^ ("#module:" + bound_name) = "1"
   exprs @ e =>
      !ok' | -->
      e
         [Assign a]
            a.0 != ""
               |
                  is_match = ?a.0 > lpfx && a.0(0..lpfx) == pfx
                  is_priv = ?a.0 > lpfx_priv && a.0(0..lpfx_priv) == pfx_priv
                  is_match && !is_priv
                     |
                        bare = a.0(lpfx..)
                        table ^ (alias_pfx + bare) = a.0
                        is_import
                           |
                              has_prev = table ^? bare
                              has_prev
                                 |
                                    existing = table ^ bare | _ | ""
                                    existing != a.0
                                       |
                                          src = sources ^ bare | _ | ""
                                          log::error $ "E3033: Name clash: symbol '" +
                                            bare + "' imported from '" + bound_name +
                                            diag::imported_symbol_conflict_suffix! +
                                            src + "'"
                                          ok' = <->
                                 |
                                    table ^ bare = a.0
                                    sources ^ bare = bound_name
         [TypeDecl td]
            is_match = ?td.name > lpfx && td.name(0..lpfx) == pfx
            is_priv = ?td.name > lpfx_priv && td.name(0..lpfx_priv) == pfx_priv
            is_match && !is_priv
               |
                  bare = td.name(lpfx..)
                  table ^ (alias_pfx + bare) = td.name
                  ty_known = type_info_known(exprs, td.type_info, canonical_id,
                     ast::Names())
                  ty_known
                     |
                        table ^ ("#type_exists:" + alias_pfx + bare) = "1"
                        table ^ ("#type_exists:" + td.name) = "1"
                        is_import | table ^ ("#type_exists:" + bare) = "1"
                  fields = module_record_fields(exprs, td.type_info, canonical_id,
                     ast::Names())
                  fields @ field =>
                     table ^ ("#field:" + alias_pfx + bare + "." + field) = td.name
                     table ^ ("#field:" + td.name + "." + field) = td.name
                     is_import | table ^ ("#field:" + bare + "." + field) = td.name
                  is_import
                     |
                        has_prev = table ^? bare
                        has_prev
                           |
                              existing = table ^ bare | _ | ""
                              existing != td.name
                                 |
                                    src = sources ^ bare | _ | ""
                                    log::error $ "E3033: Name clash: type '" +
                                      bare + "' imported from '" + bound_name +
                                      "' conflicts with type already imported from '" +
                                      src + "'"
                                    ok' = <->
                           |
                              table ^ bare = td.name
                              sources ^ bare = bound_name
         [Foreign f]
            is_match = ?f.dva_name > lpfx && f.dva_name(0..lpfx) == pfx
            is_priv = ?f.dva_name > lpfx_priv && f.dva_name(0..lpfx_priv) == pfx_priv
            is_match && !is_priv
               |
                  bare = f.dva_name(lpfx..)
                  table ^ (alias_pfx + bare) = f.dva_name
                  is_import
                     |
                        has_prev = table ^? bare
                        has_prev
                           |
                              existing = table ^ bare | _ | ""
                              existing != f.dva_name
                                 |
                                    src = sources ^ bare | _ | ""
                                    log::error $ diag::E3033_foreign_function_clash_prefix! +
                                      bare + "' imported from '" + bound_name +
                                      diag::imported_symbol_conflict_suffix! +
                                      src + "'"
                                    ok' = <->
                           |
                              table ^ bare = f.dva_name
                              sources ^ bare = bound_name
   ok'

check_file_clash: ast::Exprs, ImportMap, ImportMap => <>
check_file_clash = stmts, table, sources =>
   ok' = <+>
   stmts @ st =>
      !ok' | -->
      st
         [Assign a]
            a.0 != ""
               |
                  bare = decl_clean_name(a.0)
                  table ^? bare
                     |
                        src = sources ^ bare | _ | ""
                        log::error $ "E3033: Name clash: symbol '" + bare +
                          diag::declared_symbol_conflict_suffix! +
                          src + "'"
                        ok' = <->
         [TypeDecl td]
            bare = decl_clean_name(td.name)
            table ^? bare
               |
                  src = sources ^ bare | _ | ""
                  log::error $ "E3033: Name clash: type '" + bare +
                    "' declared in module conflicts with type imported from '" +
                    src + "'"
                  ok' = <->
         [Foreign f]
            bare = decl_clean_name(f.dva_name)
            table ^? bare
               |
                  src = sources ^ bare | _ | ""
                  log::error $ diag::E3033_foreign_function_clash_prefix! + bare +
                    diag::declared_symbol_conflict_suffix! +
                    src + "'"
                  ok' = <->
   ok'

rewrite_import_exprs: ast::Exprs, ImportMap, ast::Names => ast::Exprs
rewrite_import_exprs = exprs, table, locals =>
   exprs @> e => rewrite_import_expr(e, table, locals)

rewrite_import_call: ast::CallExpr, ImportMap, ast::Names => ast::CallExpr
rewrite_import_call = c, table, locals =>
   fn_name = c.fn_name
   has_mod = fn_name != "" && !loaded_has(locals, fn_name) && (table ^? fn_name)
   new_fn = has_mod | (table ^ fn_name | _ | fn_name) | fn_name
   new_target = rewrite_import_expr(c.fn_target, table, locals)
   new_args = rewrite_import_exprs(c.args, table, locals)
   ast::CallExpr(new_fn, new_target, new_args, c.line, c.col)

rewrite_import_fparams: ast::FParams, ImportMap => ast::FParams
rewrite_import_fparams = params, table =>
   params @> p =>
      ast::ForeignFnParam(p.name, p.param_type, rewrite_import_type_info(p.record_info, table))

rewrite_import_type_info: ast::TypeInfo, ImportMap => ast::TypeInfo
rewrite_import_type_info = ti, table =>
   ti
      [TypeVar name]
         table ^? name
            | ast::TypeInfo(TypeVar, (table ^ name | _ | name))
            | ti
      [Align a]
         new_inner = rewrite_import_type_info(a.1, table)
         ast::TypeInfo(Align, (a.0, new_inner))
      [Rec r]
         new_fields = r.0 @> f =>
            new_fti = rewrite_import_type_info(f.rec_type, table)
            new_def = rewrite_import_expr(f.default_expr, table, ast::Names())
            ast::RecordFieldType(f.name, f.val_type, new_fti,
              f.has_default, new_def)
         ast::TypeInfo(Rec, (new_fields, r.1, r.2, r.3, r.4, r.5))
      [Fn f]
         new_p_tis = f.1 @> pti => rewrite_import_type_info(pti, table)
         new_ret_ti = rewrite_import_type_info(f.3, table)
         ast::TypeInfo(Fn, (f.0, new_p_tis, f.2, new_ret_ti, f.4))
      [Ram r]
         s0 = r.0
         s1 = r.1
         s0_ti = rewrite_import_type_info(s0.payload_record, table)
         s1_ti = rewrite_import_type_info(s1.payload_record, table)
         ast::TypeInfo(Ram, (
            ast::RamSlotInfo(s0.has_payload, s0.payload_type, s0_ti),
            ast::RamSlotInfo(s1.has_payload, s1.payload_type, s1_ti)))
      [Enum es]
         new_es = es @> s =>
            new_sti = rewrite_import_type_info(s.payload_record, table)
            ast::EnumSlotInfo(s.label, s.has_payload,
              s.payload_type, new_sti)
         ast::TypeInfo(Enum, new_es)
      [Array a]
         new_elem_ti = rewrite_import_type_info(a.1, table)
         ast::TypeInfo(Array, (a.0, new_elem_ti, a.2))
      [Map m]
         new_val_ti = rewrite_import_type_info(m.2, table)
         ast::TypeInfo(Map, (m.0, m.1, new_val_ti))
      [ThreadId t]
         new_t_ti = rewrite_import_type_info(t.1, table)
         ast::TypeInfo(ThreadId, (t.0, new_t_ti))
      | ti

member_chain_name: ast::Expr => String
member_chain_name = e =>
   e
      [Var v] v
      [Member t]
         b = member_chain_name(t.target)
         b == "" | "" | b + (t.is_module_access | "::" | ".") + t.field_name
      | ""

collect_assigned_locals: ast::Expr, ast::Names => ()
collect_assigned_locals = e, locals =>
   e
      [Assign ca] (ca.0 != "" | locals += ca.0)
      [Bin b]
         b.0
            [Seq]
               collect_assigned_locals(b.1, locals)
               collect_assigned_locals(b.2, locals)

has_ct_probe: ast::Expr => <>
has_ct_probe = e =>
   e
      [Call c] c.fn_name == "#has_member"
      [Unary u] has_ct_probe(u.1)
      [Bin b] has_ct_probe(b.1) || has_ct_probe(b.2)
      | <->

eval_ct_probe_bool: ast::Expr => < <> | >
eval_ct_probe_bool = e =>
   e
      [Variant v]
         v.tag_name
            [Positive] <+ <+> +>
            [Negative] <+ <-> +>
            | <-->
      [Unary u]
         u.0 [Not] (eval_ct_probe_bool(u.1) $+> (b => !b)) | <-->
      [Bin b]
         b.0
            [And]
               eval_ct_probe_bool(b.1)
                  | lb =>
                     !lb | <+ <-> +> | eval_ct_probe_bool(b.2)
                  | <-->
            [Or]
               eval_ct_probe_bool(b.1)
                  | lb =>
                     lb | <+ <+> +> | eval_ct_probe_bool(b.2)
                  | <-->
            | <-->
      | <-->

expr_root_var: ast::Expr => String
expr_root_var = e =>
   e
      [Var v] v
      [Member m] expr_root_var(m.target)
      | ""

try_lower_std_call: String, ast::Exprs => < ast::Expr | >
try_lower_std_call = canon, args =>
   ?args != 1 | --| <-->
   canon
      ["task::spawn"]
         args(0).expect("missing args") [Call inner] <+ ast::Expr(Spawn, inner) +> | <-->
      ["task::join"] <+ ast::Expr(Join, args(0).expect("missing args")) +>
      ["sys::exit"] <+ ast::Expr(Exit, args(0).expect("missing args")) +>
      | <-->

try_eval_has_member_static: ast::Expr, ast::Expr, ImportMap, ast::Names => < ast::Expr | >
try_eval_has_member_static = target, member_arg, table, locals =>
   troot = expr_root_var(target)
   troot != "" && loaded_has(locals, "#ct:" + troot) | --| <-->
   mname_opt = member_arg
      [Str s] <+ s +>
      [Var v] (loaded_has(locals, "#ct:" + v) | <--> | <+ v +>)
      | <-->
   ! <>(mname_opt) | --| <-->
   mname = mname_opt | s => s | ""
   tname = parser::member_chain_name(target)
   tname == "" | --| <-->
   table ^? ("#module:" + tname)
      |
         present = table ^? (tname + "::" + mname)
         tag = present | ast::Tag(Positive) | ast::Tag(Negative)
         --| <+ ast::Expr(Variant, (tag, ast::Exprs())) +>
   canon_t = table ^? tname | (table ^ tname | _ | tname) | tname
   has_type = (table ^? ("#type_exists:" + tname)) ||
      (table ^? ("#type_exists:" + canon_t))
   !has_type | --| <-->
   present = (table ^? ("#field:" + tname + "." + mname)) ||
      (table ^? ("#field:" + canon_t + "." + mname))
   tag = present | ast::Tag(Positive) | ast::Tag(Negative)
   <+ ast::Expr(Variant, (tag, ast::Exprs())) +>

rewrite_import_expr: ast::Expr, ImportMap, ast::Names => ast::Expr
rewrite_import_expr = e, table, locals =>
   e
      [Var v]
         !loaded_has(locals, v) && (table ^? v)
            | ast::Expr(Var, (table ^ v | _ | v))
            | e
      [Call c]
         c.fn_name == "#has_member" && ?c.args == 2
            |
               hm = try_eval_has_member_static(c.args(0).expect("missing args"), c.args(1).expect("missing args"),
                 table, locals)
               hm | res => --| res
               // Keep member arg identifier intact when deferring generic #has_member
               arg0 = rewrite_import_expr(c.args(0).expect("missing args"), table, locals)
               arg1 = c.args(1).expect("missing args") [Var] c.args(1).expect("missing args")
                  | rewrite_import_expr(c.args(1).expect("missing args"), table, locals)
               new_args = ast::Exprs()
               new_args += arg0
               new_args += arg1
               --| ast::Expr(Call, ast::CallExpr("#has_member", c.fn_target,
                 new_args, c.line, c.col))
         rc = rewrite_import_call(c, table, locals)
         !loaded_has(locals, c.fn_name) && (table ^? c.fn_name)
            |
               canon = table ^ c.fn_name | _ | ""
               try_lower_std_call(canon, rc.args) | lowered => --| lowered
         ast::Expr(Call, rc)
      [Bin b]
         b.0
            [Seq]
               seq_locals = ++locals
               r1 = rewrite_import_expr(b.1, table, seq_locals)
               collect_assigned_locals(b.1, seq_locals)
               r2 = rewrite_import_expr(b.2, table, seq_locals)
               ast::Expr(Bin, (b.0, r1, r2))
            [Apply]
               fname = member_chain_name(b.1)
               r1 = rewrite_import_expr(b.1, table, locals)
               r2 = rewrite_import_expr(b.2, table, locals)
               fname != "" && !loaded_has(locals, fname) && (table ^? fname)
                  |
                     canon = table ^ fname | _ | ""
                     one = ast::Exprs()
                     one += r2
                     try_lower_std_call(canon, one) | lowered => --| lowered
               ast::Expr(Bin, (b.0, r1, r2))
            [Feed]
               fname = member_chain_name(b.2)
               r1 = rewrite_import_expr(b.1, table, locals)
               r2 = rewrite_import_expr(b.2, table, locals)
               fname != "" && !loaded_has(locals, fname) && (table ^? fname)
                  |
                     canon = table ^ fname | _ | ""
                     one = ast::Exprs()
                     one += r1
                     try_lower_std_call(canon, one) | lowered => --| lowered
               ast::Expr(Bin, (b.0, r1, r2))
            |
               ast::Expr(Bin, (b.0,
                 rewrite_import_expr(b.1, table, locals),
                 rewrite_import_expr(b.2, table, locals)))
      [Unary u]
         ast::Expr(Unary, (u.0,
           rewrite_import_expr(u.1, table, locals)))
      [Fn fe]
         fn_locals = ++locals
         fe.params @ p => (p != "" | fn_locals += p)
         fe.ct_params @ cp =>
            cp != "" | (fn_locals += cp; fn_locals += "#ct:" + cp)
         new_body = rewrite_import_expr(fe.body, table, fn_locals)
         ast::Expr(Fn, ast::FnExpr(fe.params, fe.ct_params, new_body, fe.line, fe.col))
      [Block be]
         blk_locals = ++locals
         new_exprs = ast::Exprs()
         be @ child =>
            new_exprs += rewrite_import_expr(child, table, blk_locals)
            collect_assigned_locals(child, blk_locals)
         ast::Expr(Block, new_exprs)
      [Choice ch]
         new_cond = rewrite_import_expr(ch.cond, table, locals)
         is_probe = has_ct_probe(ch.cond)
         only_bare' = <+>
         ch.branches @ br => !(br.kind [Bare]) | only_bare' = <->
         probe_val = is_probe | eval_ct_probe_bool(new_cond) | <-->
         is_probe && only_bare' && ?ch.branches > 0
            |
               probe_val
                  | present =>
                     present
                        | --| rewrite_import_expr(ch.branches(0).expect("missing branches").block, table, locals)
                        |
                           ?ch.branches > 1
                              | --| rewrite_import_expr(ch.branches(1).expect("missing branches").block, table, locals)
                           --| ast::Expr(Block, ast::Exprs())
         new_branches = ast::Branches()
         ch.branches @ br =>
            br_locals = ++locals
            br.bind_vars @ bv => (bv != "" | br_locals += bv)
            new_cases = rewrite_import_exprs(br.case_values, table, br_locals)
            new_pred = rewrite_import_expr(br.pred_fn, table, br_locals)
            new_blk = rewrite_import_expr(br.block, table, br_locals)
            new_vnames = ast::Names()
            br.variant_names @ vn =>
               is_loc = loaded_has(br_locals, vn)
               new_vn = !is_loc && (table ^? vn) | (table ^ vn | _ | vn) | vn
               new_vnames += new_vn
            new_branches += ast::ChoiceBranch(br.kind, new_cases, new_pred,
              new_vnames, br.bind_vars, br.is_identity_extractor,
              new_blk)
         ast::Expr(Choice, ast::ChoiceExpr(new_cond, ch.is_exhaustive,
           new_branches))
      [Assign a]
         new_rhs = rewrite_import_expr(a.5, table, locals)
         new_lhs = rewrite_import_expr(a.6, table, locals)
         new_tname = table ^? a.7 | (table ^ a.7 | _ | a.7) | a.7
         new_ti = rewrite_import_type_info(a.8, table)
         ast::Expr(Assign, (a.0, a.1, a.2, a.3, a.4, new_rhs, new_lhs,
           new_tname, new_ti))
      [TypeDecl td]
         new_ti = rewrite_import_type_info(td.type_info, table)
         ast::Expr(TypeDecl, ast::TypeDeclExpr(td.name, new_ti))
      [Foreign f]
         new_params = rewrite_import_fparams(f.params, table)
         new_ret_ti = rewrite_import_type_info(f.ret_record_info, table)
         ast::Expr(Foreign, ast::ForeignFnDecl(f.c_name, f.dva_name,
           f.abi, new_params, f.return_type, new_ret_ti, f.is_variable))
      [Member m]
         m.is_module_access
            |
               qn = member_chain_name(e)
               table ^? qn
                  | ast::Expr(Var, (table ^ qn | _ | qn))
                  | e
            |
               new_target = rewrite_import_expr(m.target, table, locals)
               new_idx = rewrite_import_expr(m.index_expr, table, locals)
               ast::Expr(Member, ast::MemberExpr(new_target, m.field_name,
                 m.is_module_access, new_idx, m.line, m.col))
      [Record re]
         new_fields = re.fields @> fld =>
            ast::RecordField(fld.has_name, fld.name, rewrite_import_expr(fld.val, table, locals))
         ast::Expr(Record, ast::RecordExpr(new_fields, re.is_repeat))
      [KeyAccess ka]
         new_target = rewrite_import_expr(ka.target, table, locals)
         new_key = rewrite_import_expr(ka.key, table, locals)
         ast::Expr(KeyAccess, ast::KeyAccessExpr(new_target, new_key,
           ka.is_membership, ka.is_delete, ka.line, ka.col))
      [Cycle cy]
         new_iter = rewrite_import_expr(cy.iterable, table, locals)
         new_fn = rewrite_import_expr(cy.body_fn, table, locals)
         ast::Expr(Cycle, ast::CycleExpr(new_iter, new_fn, cy.is_rune, cy.is_expr))
      [CycleEscape ce]
         new_cy = rewrite_import_expr(ce.cycle, table, locals)
         new_br = rewrite_import_expr(ce.branch, table, locals)
         ast::Expr(CycleEscape, ast::CycleEscapeExpr(new_cy, new_br))
      [Range r]
         new_lhs = r.has_lhs | rewrite_import_expr(r.lhs, table, locals) | r.lhs
         new_rhs = r.has_rhs | rewrite_import_expr(r.rhs, table, locals) | r.rhs
         ast::Expr(Range, ast::RangeExpr(r.has_lhs, r.has_rhs, new_lhs,
           new_rhs, r.is_inclusive))
      [NamedArg na]
         new_val = rewrite_import_expr(na.val, table, locals)
         ast::Expr(NamedArg, ast::NamedArgExpr(na.name, new_val))
      [Variant v]
         new_args = rewrite_import_exprs(v.args, table, locals)
         ast::Expr(Variant, ast::VariantExpr(v.tag_name, new_args))
      [TypeCast tc]
         new_expr = rewrite_import_expr(tc.expr, table, locals)
         ast::Expr(TypeCast, ast::CastExpr(tc.target_type, new_expr))
      [Spawn sp]
         ast::Expr(Spawn, rewrite_import_call(sp, table, locals))
      [Join jn]
         ast::Expr(Join, rewrite_import_expr(jn, table, locals))
      [Exit ex]
         new_ex = rewrite_import_expr(ex, table, locals)
         ast::Expr(Exit, new_ex)
      [Return r]
         new_val = r.has_val | rewrite_import_expr(r.val, table, locals) | r.val
         ast::Expr(Return, ast::ReturnExpr(r.has_val, new_val, r.line, r.col))
      [ArrayCreate ac]
         new_elem = rewrite_import_type_info(ac.elem_type, table)
         ast::Expr(ArrayCreate, ast::ArrayCreateExpr(new_elem, ac.cap))
      [UserDiag ud]
         new_msg = rewrite_import_expr(ud.msg, table, locals)
         ast::Expr(UserDiag, ast::UserDiagExpr(ud.is_warn, new_msg,
           ud.line, ud.col))
      [RawMemory rm]
         new_addr = rewrite_import_expr(rm.addr, table, locals)
         ast::Expr(RawMemory, ast::RawMemoryExpr(new_addr, rm.load_type,
           rm.rec_name))
      [SizeOf so]
         new_sti = rewrite_import_type_info(so.rec_type, table)
         ast::Expr(SizeOf, ast::SizeOfExpr(so.val_type, new_sti))
      [AlignOf ao]
         new_ati = rewrite_import_type_info(ao.rec_type, table)
         ast::Expr(AlignOf, ast::AlignOfExpr(ao.val_type, new_ati))
      [MapLiteral ml]
         new_pairs = ml @> p =>
            ast::MapPair(rewrite_import_expr(p.key, table, locals),
              rewrite_import_expr(p.value, table, locals))
         ast::Expr(MapLiteral, new_pairs)
      [CompileTime ct]
         new_ce = rewrite_import_expr(ct, table, locals)
         ast::Expr(CompileTime, new_ce)
      [Copy cp]
         ast::Expr(Copy, rewrite_import_expr(cp, table, locals))
      [BuilderCreate bc]
         ast::Expr(BuilderCreate, rewrite_import_expr(bc, table, locals))
      | e

// --- ML-style module functors (DVA-61) -------------------------------------

// The canonical id of a functor instance: the functor's id plus its argument
// ids, `app[ui,index]`. Instantiation is applicative — the same functor
// applied to the same argument modules is one shared instance (and one copy
// of its module-level state); different arguments give distinct instances.
// '::' inside an argument id is flattened to '.' so the instance id has no
// inner module separator.
functor_instance_cid: String, ast::Names => String
functor_instance_cid = fcid, arg_cids =>
   b = {64}
   b += fcid
   b += '[
   arg_cids @ a, i =>
      i > 0 | b += ',
      b += str::replace(a, "::", ".")
   b += ']
   +b

join_names: ast::Names, String => String
join_names = names, sep =>
   b = {64}
   names @ n, i =>
      i > 0 | b += sep
      b += n
   +b

report_functor_arity: ast::Names, ast::Names, String, String => ()
report_functor_arity = params, args, prefix, path =>
   np = ?params
   na = ?args
   plist = join_names(params, ", ")
   na == 0
      |
         prefix == ""
            | loader_error(5050, path, "E5050: '#param " + plist + "' is only valid in a " +
              "functor module instantiated with '#use path(args)', not in the program " +
              "entry file '" + path + "'")
            | loader_error(5050, path, "E5050: Module '" + path + "' is a functor (#param " +
              plist + ") and must be instantiated with module arguments: " +
              "'#use <path>(" + plist + ")'")
      | np == 0
         | loader_error(5051, path, "E5051: Module '" + path + "' is not a functor (it " +
           "declares no #param) but " + str::from_int(na) + " module argument(s) were given")
         | loader_error(5051, path, "E5051: Functor module '" + path + "' expects " +
           str::from_int(np) + " module argument(s) (#param " + plist + ") but " +
           str::from_int(na) + " were given")

// '#use path(a, b)': resolve the argument names (a '#param' of the importing
// functor or a module bound by a plain '#use' in this file), then load the
// functor file once per distinct argument tuple under its instance id.
load_functor_import: ast::ImportStmt, String, Loader, String, ImportEntries,
  ImportMap, ImportMap => <>
load_functor_import = imp, base, ldr, path, import_entries, param_map, bound_map =>
   arg_cids = ast::Names()
   ok' = <+>
   imp.args @ a =>
      param_map ^? a
         | arg_cids += (param_map ^ a | _ | a)
         | bound_map ^? a
            | arg_cids += (bound_map ^ a | _ | a)
            |
               loader_error(5052, path, "E5052: Module argument '" + a + "' of '#use " +
                 imp.module_path + "(" + join_names(imp.args, ", ") +
                 ")' is not a module bound by '#use' or '#param' in this file")
               ok' = <->
   !ok' | --| <->
   resolved = resolve_module(base, imp.module_path, ldr)
   resolved
      [File f]
         inst_cid = functor_instance_cid(f.canonical_id, arg_cids)
         import_entries += ImportEntry(imp.module_name, inst_cid, imp.is_import)
         loaded_has(ldr.loaded, inst_cid) | --| <+>
         ldr.loaded += inst_cid
         saved_dep = ldr.is_dep
         ldr.is_dep = <+>
         ldr.functor_args = arg_cids
         res = load_single_file(f.path, inst_cid, f.is_pkg, imp.module_path, ldr)
         ldr.functor_args = ast::Names()
         ldr.is_dep = saved_dep
         res
      [Dir d]
         loader_error(5051, path, "E5051: '#use " + imp.module_path + "(...)': directory " +
           "module '" + d.path + "' cannot be a functor; module arguments need a single " +
           "file module")
         <->
      |
         !starts_with(imp.module_path, "@")
            | loader_error(5006, path, "E5006: Imported module '" + imp.module_name +
              "' not found at '" + imp.module_path + "'")
         <->

// Scan only dependency directives before parsing declarations. A constructor
// application needs the imported generator's signature during type parsing.
scan_module_dependencies: String, String => < ast::Exprs | >
scan_module_dependencies = src, path =>
   p = parser::parse_init(src)
   parser::parser_set_file(p, path)
   deps = ast::Exprs()
   ok' = <+>
   at_stmt_start' = <+>
   last_was_colon' = <->
   indent_depth' = 0
   0.. @
      p.curr.kind [Eof] | -->
      dep = p.curr.kind
         [UsePath] parser::parse_import(p, <->, <->)
         [UseDynamicPath] parser::parse_import(p, <+>, <->)
         [UseImportPath] parser::parse_import(p, <->, <+>)
         [UseDynamicImportPath] parser::parse_import(p, <+>, <+>)
         [ParamKw]
            indent_depth' == 0 && !last_was_colon' && at_stmt_start' &&
              parser::looks_like_mod_param(p)
               | parser::parse_mod_param(p)
               |
                  parser::parser_advance(p)
                  at_stmt_start' = <->
                  last_was_colon' = <->
                  <-->
         |
            is_brk = p.curr.kind [Newline, Semi, Indent, Dedent]
            is_ind = p.curr.kind [Indent]
            is_ded = p.curr.kind [Dedent]
            is_nl = p.curr.kind [Newline]
            is_colon = p.curr.text == ":"
            is_ind | indent_depth' = indent_depth' + 1
            is_ded && indent_depth' > 0 | indent_depth' = indent_depth' - 1
            !is_ind && !is_ded && !is_nl | last_was_colon' = is_colon
            parser::parser_advance(p)
            at_stmt_start' = is_brk
            <-->
      dep | d =>
         d
            [Block b] (b @ item => deps += item)
            | deps += d
         at_stmt_start' = p.curr.kind [Eof, Newline, Semi, Indent, Dedent]
         last_was_colon' = <->
      p.recovered_errors > 0 || lexer::lex_failed! | (ok' = <->; -->)
   ok' | <+ deps +> | <-->

// Seed aliases using the same export table that rewrites value imports.
// Canonical entries also resolve types referenced inside imported signatures.
seed_imported_types: parser::Parser, ast::Exprs, ImportMap, String => ()
seed_imported_types = p, exprs, table, cur_mod =>
   exprs @ e =>
      entry = e
         [TypeDecl td] <+ parser::TypeEntry(td.name, td.type_info) +>
         [Assign a]
            a.8
               [Fn f]
                  ?f.4 > 0 && ?f.0 == 0
                     | <+ parser::TypeEntry(a.0, a.8) +>
                     | <-->
               | <-->
         | <-->
      entry | te =>
         local_types = ImportMap()
         mod = dep_graph::decl_module(te.name, 0)
         bound = te.ti [Fn f] (f.4 @> cp => cp.name) | ast::Names()
         exprs @ decl =>
            name = decl [TypeDecl td] td.name [Assign a] a.0 | ""
            name != "" && dep_graph::decl_module(name, 0) == mod
               |
                  bare = mod == "" | name | name(?mod + 2..)
                  clean = starts_with(bare, "#") | bare(1..) | bare
                  !loaded_has(bound, clean) | local_types ^ clean = name
         sig = rewrite_import_type_info(te.ti, local_types)
         p.user_types = parser::add_type(p.user_types, te.name, sig)
         cur_mod != "" && mod == cur_mod
            |
               own_bare = te.name(?cur_mod + 2..)
               own_clean = starts_with(own_bare, "#") | own_bare(1..) | own_bare
               p.user_types = parser::add_type(p.user_types, own_clean, sig)
         table @ canonical, alias =>
            canonical == te.name
               | p.user_types = parser::add_type(p.user_types, alias, sig)

expr_is_import_or_modparam: ast::Expr => <>
expr_is_import_or_modparam = st =>
   st
      [Import, ModParam] <+>
      [Block b]
         ?b == 0 | --| <->
         ok' = <+>
         b @ item => !(item [Import, ModParam]) | ok' = <->
         ok'
      | <->

qualify_type_info_map: ast::TypeInfo, ImportMap => ast::TypeInfo
qualify_type_info_map = ti, table =>
   ti
      [TypeVar name]
         table ^? name
            | ast::TypeInfo(TypeVar, (table ^ name | _ | name))
            | ti
      [Align a]
         ast::TypeInfo(Align, (a.0, qualify_type_info_map(a.1, table)))
      [Rec r]
         new_fields = r.0 @> f =>
            ast::RecordFieldType(f.name, f.val_type,
              qualify_type_info_map(f.rec_type, table),
              f.has_default, f.default_expr)
         ast::TypeInfo(Rec, (new_fields, r.1, r.2, r.3, r.4, r.5))
      [Fn f]
         new_p_tis = f.1 @> pti => qualify_type_info_map(pti, table)
         new_ret_ti = qualify_type_info_map(f.3, table)
         ast::TypeInfo(Fn, (f.0, new_p_tis, f.2, new_ret_ti, f.4))
      [Ram r]
         s0 = r.0
         s1 = r.1
         ast::TypeInfo(Ram, (
            ast::RamSlotInfo(s0.has_payload, s0.payload_type,
              qualify_type_info_map(s0.payload_record, table)),
            ast::RamSlotInfo(s1.has_payload, s1.payload_type,
              qualify_type_info_map(s1.payload_record, table))))
      [Enum es]
         new_es = es @> s =>
            ast::EnumSlotInfo(s.label, s.has_payload, s.payload_type,
              qualify_type_info_map(s.payload_record, table))
         ast::TypeInfo(Enum, new_es)
      [Array a]
         ast::TypeInfo(Array, (a.0, qualify_type_info_map(a.1, table), a.2))
      [Map m]
         ast::TypeInfo(Map, (m.0, m.1, qualify_type_info_map(m.2, table)))
      [ThreadId t]
         ast::TypeInfo(ThreadId, (t.0, qualify_type_info_map(t.1, table)))
      | ti

qualify_fparams_type_infos: ast::FParams, ImportMap => ast::FParams
qualify_fparams_type_infos = params, table =>
   params @> p => ast::ForeignFnParam(p.name, p.param_type,
     qualify_type_info_map(p.record_info, table))

qualify_decl_type_infos: ast::Expr, ImportMap => ast::Expr
qualify_decl_type_infos = e, table =>
   e
      [Block b]
         new_bs = b @> child => qualify_decl_type_infos(child, table)
         ast::Expr(Block, new_bs)
      [TypeDecl td]
         ast::Expr(TypeDecl, ast::TypeDeclExpr(td.name,
           qualify_type_info_map(td.type_info, table)))
      [Assign a]
         ast::Expr(Assign, (a.0, a.1, a.2, a.3, a.4,
           qualify_decl_type_infos(a.5, table),
           qualify_decl_type_infos(a.6, table),
           a.7, qualify_type_info_map(a.8, table)))
      [Foreign f]
         ast::Expr(Foreign, ast::ForeignFnDecl(f.c_name, f.dva_name, f.abi,
           qualify_fparams_type_infos(f.params, table), f.return_type,
           qualify_type_info_map(f.ret_record_info, table), f.is_variable))
      [Fn fe]
         ast::Expr(Fn, ast::FnExpr(fe.params, fe.ct_params,
           qualify_decl_type_infos(fe.body, table), fe.line, fe.col))
      [Choice ch]
         new_branches = ch.branches @> br =>
            new_cases = br.case_values @> cv => qualify_decl_type_infos(cv, table)
            ast::ChoiceBranch(br.kind, new_cases,
              qualify_decl_type_infos(br.pred_fn, table),
              br.variant_names, br.bind_vars, br.is_identity_extractor,
              qualify_decl_type_infos(br.block, table))
         ast::Expr(Choice, ast::ChoiceExpr(
           qualify_decl_type_infos(ch.cond, table), ch.is_exhaustive,
           new_branches))
      [Call c]
         new_args = c.args @> arg => qualify_decl_type_infos(arg, table)
         ast::Expr(Call, ast::CallExpr(c.fn_name,
           qualify_decl_type_infos(c.fn_target, table),
           new_args, c.line, c.col))
      [Bin b]
         ast::Expr(Bin, (b.0, qualify_decl_type_infos(b.1, table),
           qualify_decl_type_infos(b.2, table)))
      [Unary u]
         ast::Expr(Unary, (u.0, qualify_decl_type_infos(u.1, table)))
      [ArrayCreate ac]
         ast::Expr(ArrayCreate, ast::ArrayCreateExpr(
           qualify_type_info_map(ac.elem_type, table), ac.cap))
      [SizeOf so]
         ast::Expr(SizeOf, ast::SizeOfExpr(so.val_type,
           qualify_type_info_map(so.rec_type, table)))
      [AlignOf ao]
         ast::Expr(AlignOf, ast::AlignOfExpr(ao.val_type,
           qualify_type_info_map(ao.rec_type, table)))
      [RawMemory rm]
         new_rname = table ^? rm.rec_name | (table ^ rm.rec_name | _ | rm.rec_name) | rm.rec_name
         ast::Expr(RawMemory, ast::RawMemoryExpr(
           qualify_decl_type_infos(rm.addr, table), rm.load_type, new_rname))
      | e

collect_self_type_map_exprs: ast::Exprs, String, ast::Names, ast::Names, ImportMap, ImportMap => ()
collect_self_type_map_exprs = exprs, prefix, publics, privates, shadowed, out =>
   exprs @ st =>
      st
         [Block b]
            collect_self_type_map_exprs(b, prefix, publics, privates, shadowed, out)
         [TypeDecl td]
            clean = decl_clean_name(td.name)
            clean != "" && !(shadowed ^? clean) && !(out ^? clean)
               | (out ^ clean = prefix_decl_name(td.name, prefix, publics, privates))

append_unique_names: ast::Names, ast::Names => ()
append_unique_names = dest, src =>
   src @ s =>
      !loaded_has(dest, s) | (dest += s)

is_fwd_assign_expr: ast::Expr => <>
is_fwd_assign_expr = e =>
   e [Var v] (v == "<fwd>") | <->

collect_defined_names_in_exprs: ast::Exprs, ast::Names => ()
collect_defined_names_in_exprs = exprs, out =>
   exprs @ st =>
      st
         [Assign t]
            t.0 != "" && !is_fwd_assign_expr(t.5)
               |
                  clean = decl_clean_name(t.0)
                  clean != "" && !loaded_has(out, clean) | (out += clean)
         [Block b]
            collect_defined_names_in_exprs(b, out)

mark_iface_defined_stubs: ast::Exprs, Int, String, ast::Names => ()
mark_iface_defined_stubs = exprs, start_idx, prefix, defined =>
   prefix == "" | --|
   pfx = "${prefix}::"
   start_idx..?exprs @ i =>
      exprs(i).expect("missing exprs")
         [Assign a]
            a.0 != "" && is_fwd_assign_expr(a.5) && starts_with(a.0, pfx)
               |
                  clean = decl_clean_name(a.0(?pfx..))
                  loaded_has(defined, clean)
                     |
                        exprs(i) = ast::Expr(Assign, (a.0, a.1, a.2, a.3, a.4,
                          a.5, ast::Expr(Var, "<iface>"), a.7, a.8)) !| _

find_visibility_conflict: ast::Names, ast::Names => String
find_visibility_conflict = pubs, privs =>
   pubs @ p =>
      loaded_has(privs, "#priv:${p}") | --| p
   ""

normalize_dir_module_visibility: Loader, Int, String, ast::Names, ast::Names, <> => ()
normalize_dir_module_visibility = ldr, start_idx, prefix, pubs, defs, is_iface =>
   prefix == "" | --|
   priv_pfx = "${prefix}::#"
   pub_pfx = "${prefix}::"
   pub_retype = ImportMap()
   pubs @ pn => (pub_retype ^ "${priv_pfx}${pn}" = "${pub_pfx}${pn}")
   start_idx..?ldr.out_exprs @ i =>
      cur_e = ldr.out_exprs(i).expect("missing out exprs")
      retyped_e = qualify_decl_type_infos(cur_e, pub_retype)
      final_e = retyped_e
         [Assign a]
            starts_with(a.0, priv_pfx)
               |
                  clean = a.0(?priv_pfx..)
                  loaded_has(pubs, clean)
                     |
                        ast::Expr(Assign, (
                          "${pub_pfx}${clean}", a.1, a.2, a.3, a.4, a.5, a.6,
                          a.7, a.8))
                     | retyped_e
               | retyped_e
         [TypeDecl td]
            starts_with(td.name, priv_pfx)
               |
                  clean = td.name(?priv_pfx..)
                  loaded_has(pubs, clean)
                     |
                        ast::Expr(TypeDecl, ast::TypeDeclExpr(
                          "${pub_pfx}${clean}", td.type_info))
                     | retyped_e
               | retyped_e
         [Foreign f]
            starts_with(f.dva_name, priv_pfx)
               |
                  clean = f.dva_name(?priv_pfx..)
                  loaded_has(pubs, clean)
                     |
                        ast::Expr(Foreign, ast::ForeignFnDecl(
                          f.c_name, "${pub_pfx}${clean}", f.abi, f.params,
                          f.return_type, f.ret_record_info, f.is_variable))
                     | retyped_e
               | retyped_e
         | retyped_e
      ldr.out_exprs(i) = final_e !| _
   is_iface | mark_iface_defined_stubs(ldr.out_exprs, start_idx, prefix, defs)

load_stmts: ast::Exprs, String, String, Loader, String, parser::Parser, <>, String => <>
load_stmts = deps, base, prefix, ldr, path, ppr, is_pkg, imp_path =>
   stmts = deps
   ok' = <+>
   import_entries = ImportEntries()
   has_imp_mods' = <->
   // Functor module parameters (DVA-61): the instance's module arguments are
   // handed over in ldr.functor_args; each '#param M: Module' binds M like an
   // import of the corresponding argument module, so 'M::x' rewrites to the
   // argument's qualified name below. Nested imports see no arguments.
   my_args = ldr.functor_args
   ldr.functor_args = ast::Names()
   params = ast::Names()
   stmts @ pst => pst [ModParam mp] (params += mp.name)
   param_map = ImportMap()
   bound_map = ImportMap()
   ?params != ?my_args
      |
         report_functor_arity(params, my_args, prefix, path)
         ok' = <->
      |
         ?params @ pi =>
            pname = params(pi).expect("missing params")
            acid = my_args(pi).expect("missing my args")
            param_map ^? pname
               |
                  loader_error(5049, path, "E5049: Duplicate '#param " + pname +
                    ": Module' in functor module '" + path + "'")
                  ok' = <->
            param_map ^ pname = acid
            import_entries += ImportEntry(pname, acid, <->)
            has_imp_mods' = <+>
   // Plain imports first, then functor instantiations ('#use ./app(ui)'): a
   // module argument must be loaded before the functor instance using it.
   stmts @ st =>
      !ok' | -->
      st
         [Import imp]
            ?imp.args > 0 | --^
            has_imp_mods' = <+>
            resolved = resolve_module(base, imp.module_path, ldr)
            resolved
               [None]
                  !starts_with(imp.module_path, "@")
                     |
                        hint = is_rel_module_path(imp.module_path)
                           | ""
                           | " in stdlib (use '#use ./" + imp.module_path + "' for a local module)"
                        loader_error(5006, path, "E5006: Imported module '" + imp.module_name +
                          "' not found at '" + imp.module_path + "'" + hint)
                  ok' = <->
               |
                  cid = get_resolved_cid(resolved)
                  import_entries += ImportEntry(imp.module_name, cid, imp.is_import)
                  bound_map ^ imp.module_name = cid
                  imp.is_dynamic
                     |
                        has_dyn = loaded_has(ldr.dynamic_mods, imp.module_name)
                        !has_dyn
                           |
                              dmods = ldr.dynamic_mods
                              dmods += imp.module_name
                              ldr.dynamic_mods = dmods
                              dpath = resolved [File f] f.path [Dir d] d.path | imp.module_path
                              dpaths = ldr.dynamic_paths
                              dpaths += canonical_path(dpath)
                              ldr.dynamic_paths = dpaths
                              decl_code = "#public\n" +
                                "reload_so: String => <>\n" +
                                "reload_so = p => <+>\n" +
                                "reload: () => <>\n" +
                                "reload = !=> <+>\n"
                              dppr = parser::parse_init(decl_code)
                              dprog = parser::parse_program(dppr)
                              dprog | dp =>
                                 dp [Block db]
                                    db @ de =>
                                       prev_dlen = ?ldr.out_exprs
                                       prefix_stmt_to_acc(de, cid,
                                         dppr.publics, dppr.privates,
                                         ldr.out_exprs, <->, ast::Names())
                                       added_d = ?ldr.out_exprs - prev_dlen
                                       added_d > 0
                                          |
                                             ldr_df = ldr.out_files
                                             ldr_dl = ldr.out_lines
                                             ldr_dc = ldr.out_cols
                                             ldr_dm = ldr.out_mods
                                             added_d @ _di =>
                                                ldr_df += path
                                                ldr_dl += 1
                                                ldr_dc += 1
                                                ldr_dm += cid
                                             ldr.out_files = ldr_df
                                             ldr.out_lines = ldr_dl
                                             ldr.out_cols = ldr_dc
                                             ldr.out_mods = ldr_dm
                  saved_dep = ldr.is_dep
                  ldr.is_dep = <+>
                  res = load_resolved(resolved, imp.module_path, ldr)
                  ldr.is_dep = saved_dep
                  !res | ok' = <->
   stmts @ fst =>
      !ok' | -->
      fst
         [Import fimp]
            ?fimp.args > 0
               |
                  has_imp_mods' = <+>
                  !load_functor_import(fimp, base, ldr, path, import_entries,
                    param_map, bound_map)
                     | ok' = <->
   !ok'
      | <->
      |
         import_table = ImportMap()
         import_source = ImportMap()
         import_entries @ ientry =>
            !ok' | -->
            cres = collect_module_exports(ldr.out_exprs, ientry.bound_name,
              ientry.canonical_id, ientry.is_import, import_table, import_source)
            !cres | ok' = <->
         !ok'
            | <->
            |
               seed_imported_types(ppr, ldr.out_exprs, import_table, prefix)
               lexer::lex_set_file(path)
               parsed = parser::parse_program(ppr)
               !<>(parsed) | --| <->
               body = parsed.expect("missing parsed")
               actual = body [Block b] b | ast::Exprs()
               publics = ppr.publics
               privates = ppr.privates
               lines = ppr.top_lines
               cols = ppr.top_cols
               in_this_dir = ldr.in_dir_module && ldr.dir_prefix == prefix
               in_this_dir
                  |
                     append_unique_names(ldr.dir_publics, publics)
                     append_unique_names(ldr.dir_privates, privates)
                     collect_defined_names_in_exprs(actual, ldr.dir_defined)
               !in_this_dir && is_pkg && ?publics == 0
                  |
                     log::error $ "E5036: #use ${imp_path}: module exports nothing (no #public)"
                     --| <->
               !ldr.is_dep
                  |
                     ppr.exports @ exp => ldr.exports += exp
               has_imp_mods'
                  |
                     fcres = check_file_clash(actual, import_table, import_source)
                     !fcres | ok' = <->
               !ok'
                  | <->
                  |
                     // Populate local type fields so #has_member works on types in this file
                     all_decls = ++ldr.out_exprs
                     actual @ ae => (ae [TypeDecl] (all_decls += ae))
                     actual @ st =>
                        st [TypeDecl td]
                           bare = decl_clean_name(td.name)
                           resolved_ti = rewrite_import_type_info(td.type_info, import_table)
                           type_info_known(all_decls, resolved_ti, prefix, ast::Names())
                              |
                                 import_table ^ ("#type_exists:" + td.name) = "1"
                                 import_table ^ ("#type_exists:" + bare) = "1"
                                 fields = module_record_fields(all_decls, resolved_ti,
                                    prefix, ast::Names())
                                 fields @ field =>
                                    import_table ^ ("#field:" + td.name + "." + field) = td.name
                                    import_table ^ ("#field:" + bare + "." + field) = td.name
                     self_type_table = ImportMap()
                     prefix != ""
                        |
                           pfx_d = "${prefix}::"
                           ldr.out_exprs @ oe =>
                              oe [TypeDecl otd]
                                 starts_with(otd.name, pfx_d)
                                    |
                                       bare_o = decl_clean_name(otd.name(?pfx_d..))
                                       bare_o != "" && !(import_table ^? bare_o) &&
                                         !(self_type_table ^? bare_o)
                                          | (self_type_table ^ bare_o = otd.name)
                           collect_self_type_map_exprs(actual, prefix, publics,
                             privates, import_table, self_type_table)
                     // A functor instance is compiled into its importer's unit.
                     is_iface = ldr.is_modular && ldr.is_dep && ?my_args == 0
                     rewritten_stmts = ast::Exprs()
                     rw_lines = ast::Ints()
                     rw_cols = ast::Ints()
                     st_idx' = 0
                     actual @ st2 =>
                        is_imp = expr_is_import_or_modparam(st2)
                        !is_imp
                           |
                              cur_st0 = rewrite_import_expr(st2, import_table,
                                ast::Names())
                              cur_st = prefix != ""
                                 | qualify_decl_type_infos(cur_st0, self_type_table)
                                 | cur_st0
                              rewritten_stmts += cur_st
                              rw_lines += (lines(st_idx') | _ | 1)
                              rw_cols += (cols(st_idx') | _ | 1)
                        st_idx' = st_idx' + 1
                     priv_deps = is_iface
                        | collect_pub_generic_priv_deps(rewritten_stmts, publics, privates, prefix)
                        | ast::Names()
                     file_start_idx = ?ldr.out_exprs
                     rewritten_stmts @ cur_st, rw_i =>
                        prev_len = ?ldr.out_exprs
                        prefix_stmt_to_acc(cur_st, prefix, publics,
                          privates, ldr.out_exprs, is_iface, priv_deps)
                        added = ?ldr.out_exprs - prev_len
                        added > 0
                           |
                              f_line = rw_lines(rw_i) | _ | 1
                              f_col = rw_cols(rw_i) | _ | 1
                              ldr_f = ldr.out_files
                              ldr_l = ldr.out_lines
                              ldr_c = ldr.out_cols
                              ldr_m = ldr.out_mods
                              added @ _ai =>
                                 ldr_f += path
                                 ldr_l += f_line
                                 ldr_c += f_col
                                 ldr_m += prefix
                              ldr.out_files = ldr_f
                              ldr.out_lines = ldr_l
                              ldr.out_cols = ldr_c
                              ldr.out_mods = ldr_m
                     is_iface
                        |
                           file_defs = ast::Names()
                           collect_defined_names_in_exprs(actual, file_defs)
                           mark_iface_defined_stubs(ldr.out_exprs, file_start_idx,
                             prefix, file_defs)
                     ok'

load_single_file: String, String, <>, String, Loader => <>
load_single_file = path, prefix, is_pkg, imp_path, ldr =>
   src_res = read_file_text(path)
   src_res
      | src =>
         ldr.loaded_files += path
         ?src == 0
            | <+>
            |
               ppr = parser::parse_init(src)
               parser::parser_set_file(ppr, path)
               lexer::lex_set_file(path)
               ppr.allow_module_refs = <+>
               scan_module_dependencies(src, path)
                  | deps => load_stmts(deps, dirname(path), prefix, ldr, path,
                    ppr, is_pkg, imp_path)
                  | <->
      |
         log::error $ "E5005: Could not read source file '" + path + "'"
         <->

load_file: String, String, <>, String, Loader => <>
load_file = path, prefix, is_pkg, imp_path, ldr =>
   prefix != "" && loaded_has(ldr.loaded, prefix) && loaded_has(ldr.loaded_files, path)
      | <+>
      |
         prefix != "" && !loaded_has(ldr.loaded, prefix)
            |
               loaded = ldr.loaded
               loaded += prefix
               ldr.loaded = loaded
         load_single_file(path, prefix, is_pkg, imp_path, ldr)

load_dir_files: ast::Names, String, String, <>, String, Loader => <>
load_dir_files = files, dir_path, prefix, is_pkg, imp_path, ldr =>
   prev_in_dir = ldr.in_dir_module
   prev_dir_prefix = ldr.dir_prefix
   prev_pubs = ldr.dir_publics
   prev_privs = ldr.dir_privates
   prev_defs = ldr.dir_defined
   start_idx = ?ldr.out_exprs
   is_iface_dir = ldr.is_modular && ldr.is_dep && ?ldr.functor_args == 0
   ldr.in_dir_module = <+>
   ldr.dir_prefix = prefix
   ldr.dir_publics = ast::Names()
   ldr.dir_privates = ast::Names()
   ldr.dir_defined = ast::Names()
   ok' = <+>
   files @ fname =>
      !ok' | -->
      child_path = path_join(dir_path, fname)
      res = load_single_file(child_path, prefix, is_pkg, imp_path, ldr)
      !res | ok' = <->
   pubs = ldr.dir_publics
   privs = ldr.dir_privates
   defs = ldr.dir_defined
   ldr.in_dir_module = prev_in_dir
   ldr.dir_prefix = prev_dir_prefix
   ldr.dir_publics = prev_pubs
   ldr.dir_privates = prev_privs
   ldr.dir_defined = prev_defs
   !ok' | --| <->
   conflict = find_visibility_conflict(pubs, privs)
   conflict != ""
      |
         loader_error(3033, dir_path,
           "E3033: Visibility conflict for '${conflict}': declared both #public and #private")
         --| <->
   is_pkg && ?pubs == 0
      |
         log::error $ "E5036: #use ${imp_path}: module exports nothing (no #public)"
         --| <->
   normalize_dir_module_visibility(ldr, start_idx, prefix, pubs, defs, is_iface_dir)
   <+>

load_resolved: ResolvedModule, String, Loader => <>
load_resolved = resolved, imp_path, ldr =>
   resolved
      [File f]
         stk_idx = f.is_pkg | find_name_idx(ldr.loading_stack, f.canonical_id) | 0 - 1
         stk_idx !< 0
            |
               chain = format_cycle_chain(ldr.loading_stack, stk_idx, f.canonical_id)
               log::error $ diag::E5038_package_import_cycle_prefix! + chain
               <->
            |
               loaded_has(ldr.loaded, f.canonical_id) && loaded_has(ldr.loaded_files, f.path)
                  | <+>
                  |
                     f.is_pkg
                        |
                           stk = ldr.loading_stack
                           stk += f.canonical_id
                           ldr.loading_stack = stk
                     res = load_file(f.path, f.canonical_id, f.is_pkg, imp_path, ldr)
                     f.is_pkg | pop_loading_stack(ldr)
                     res
      [Dir d]
         stk_idx = d.is_pkg | find_name_idx(ldr.loading_stack, d.canonical_id) | 0 - 1
         stk_idx !< 0
            |
               chain = format_cycle_chain(ldr.loading_stack, stk_idx, d.canonical_id)
               log::error $ diag::E5038_package_import_cycle_prefix! + chain
               <->
            |
               loaded_has(ldr.loaded, d.canonical_id)
                  | <+>
                  |
                     d.is_pkg
                        |
                           stk = ldr.loading_stack
                           stk += d.canonical_id
                           ldr.loading_stack = stk
                     ldr.loaded += d.canonical_id
                     files = dir_dva_files(d.path)
                     res = load_dir_files(files, d.path, d.canonical_id, d.is_pkg, imp_path, ldr)
                     d.is_pkg | pop_loading_stack(ldr)
                     res
      | <->

load_target: String, String, Loader => <>
load_target = path, prefix, ldr =>
   dir_exists(path)
      |
         main_cand = path_join(path, "main.dva")
         file_exists(main_cand)
            | load_file(main_cand, prefix, <->, "", ldr)
            |
               files = dir_dva_files(path)
               load_dir_files(files, path, prefix, <->, "", ldr)
      | load_file(path, prefix, <->, "", ldr)

load_all: String, String, <>, String => ModuleLoad
load_all = target, target_prefix, is_modular, import_map_arg =>
   map_res = find_and_load_import_map(target, import_map_arg)
   map_res
      | map =>
         ldr = Loader(ast::Exprs(), ast::Names(), ast::Names(),
           ast::Names(), ast::Names(), is_modular, <->,
           map, ast::Names(), ast::Names(), ast::Ints(), ast::Ints(),
           ast::Names(), ast::Names(), ast::Names(), <->, "",
           ast::Names(), ast::Names(), ast::Names())
         map.has_map && map.map_path != "" | ldr.loaded_files += map.map_path
         tres = load_target(target, target_prefix, ldr)
         folded_exprs = tres | parser::fold_program_consts(ldr.out_exprs) | ldr.out_exprs
         ModuleLoad(folded_exprs, ldr.loaded, ldr.exports,
           ldr.dynamic_mods, ldr.dynamic_paths, tres,
           map.native_libs, map.native_pkg_config,
           ldr.out_files, ldr.out_lines, ldr.out_cols,
           ldr.out_mods, ldr.loaded_files)
      |
         ModuleLoad(ast::Exprs(), ast::Names(), ast::Names(),
           ast::Names(), ast::Names(), <->,
           ast::Names(), ast::Names(),
           ast::Names(), ast::Ints(), ast::Ints(),
           ast::Names(), ast::Names())

strip_trailing_slash: String => String
strip_trailing_slash = s => path::strip_trailing_sep(s)

basename: String => String
basename = p => path::basename(p)

derive_base_name: String => String
derive_base_name = target_path =>
   b = path::basename(target_path)
   path::ext(b) == ".dva" | path::stem(b) | b

build_argv: mem::Arena, ast::Names, Int, Int, Addr => ()
build_argv = a, args, i, n, buf =>
   i < n
      |
         arg = args(i) | _ | ""
         len = ?arg
         cstr = mem::alloc(a, len + 1)
         mem::copy(cstr, &arg, len)
         @[cstr + len] = 0i8
         @[buf + i * 8] = cstr
         build_argv(a, args, i + 1, n, buf)

#foreign
   environ: Addr

waitpid_loop: Int, Addr => Int
waitpid_loop = pid, status_buf =>
   w = libc::waitpid(pid, status_buf, 0)
   w < 0
      |
         err = @[__errno_location! i32]
         err == 4
            | waitpid_loop(pid, status_buf)
            | 0 - 1
      | 0

run_cmd: ast::Names => Int
run_cmd = args =>
   n = ?args
   n == 0
      | 0 - 1
      |
         cmd_a = mem::arena(4096)
         argv_buf = mem::alloc(cmd_a, (n + 1) * 8)
         build_argv(cmd_a, args, 0, n, argv_buf)
         @[argv_buf + n * 8] = sys::addr_null
         pid_raw' = 0i32
         file = args(0) | _ | ""
         ret = libc::posix_spawnp(&pid_raw', file, sys::addr_null, sys::addr_null,
           argv_buf, environ)
         ret != 0
            |
               mem::destroy(cmd_a)
               0 - 1
            |
               pid = Int(pid_raw')
               status_raw' = 0i32
               wres = waitpid_loop(pid, &status_raw')
               wres < 0
                  |
                     mem::destroy(cmd_a)
                     0 - 1
                  |
                     status = Int(status_raw')
                     mem::destroy(cmd_a)
                     sig = status .&. 127
                     sig != 0
                        |
                           log::warn $ "Process terminated by signal " +
                             str::from_int(sig)
                           128 + sig
                        |
                           (status .>. 8) .&. 255

get_default_target_triple: Int => String
get_default_target_triple = ignored =>
   sys::addr_opt(llvm_get_default_triple!)
      | t =>
         s = sys::c_str(t)
         llvm_dispose_message(t)
         s
      |
         log::error $ "E5016: LLVM could not determine" +
           " a default target triple; pass one with -target"
         sys::exit(1)
         ""

has_name_step: ast::Names, String, Int => <>
has_name_step = names, name, i =>
   i < ?names
      |
         (names(i) | _ | "") == name
            | <+>
            | has_name_step(names, name, i + 1)
      | <->

has_name: ast::Names, String => <>
has_name = names, name => has_name_step(names, name, 0)

collect_link_libs_expr: ast::Expr, ast::Names => ast::Names
collect_link_libs_expr = e, libs =>
   e
      [Foreign f]
         f.abi != "c" && !has_name(libs, f.abi)
            |
               libs += f.abi
               libs
            | libs
      [Block b]
         collect_link_libs_step(b, libs)
      | libs

collect_link_libs_step: ast::Exprs, ast::Names => ast::Names
collect_link_libs_step = stmts, libs =>
   (libs, stmts) @> cur, child => collect_link_libs_expr(child, cur)

collect_link_libs: ast::Exprs => ast::Names
collect_link_libs = stmts =>
   libs = ast::Names()
   libs += "pthread"
   libs += "m"
   collect_link_libs_step(stmts, libs)

#type CliOpts (
   target: String,
   outpath: String,
   run_exec: <>,
   ir_only: <>,
   no_runtime: <>,
   no_main: <>,
   repl_mode: <>,
   opt: String,
   triple: String,
   help: <>,
   ast_dump: <>,
   ast_tree: <>,
   eval_src: String,
   typed_ast: <>,
   typed_codegen: <>,
   header_path: String,
   is_shared: <>,
   is_module: <>,
   module_name: String,
   import_map: String,
   cache_dir: String,
   no_cache: <>,
   cflags: ast::Names,
   fuzz_cov: <> = <->,
   timings: <> = <->,
   load_parse_ns: Int = 0,
   no_typed_opt: <> = <->,
   check_arena_escapes: <> = <->
)

init_opts: Int => CliOpts
init_opts = ignored =>
   CliOpts("", "", <->, <->, <->, <->, <->, "", "", <->, <->, <->, "",
     <->, <+>, "", <->, <->, "", "", "", <->, ast::Names(), <->, <->, 0)

find_char_at: String, Int, Int => Int
find_char_at = s, i, ch =>
   i < ?s
      | (s(i) == ch | i | find_char_at(s, i + 1, ch))
      | -1

c_guard_char: Int => Int
c_guard_char = ch =>
   ch [97...122]
      | ch - 32
      |
         ch [65...90, 48...57]
            | ch
            | 95

c_header_guard: String => String
c_header_guard = p =>
   base = path::basename(p)
   b = {?base + 8}
   base @ ch_ =>
      b += c_guard_char(ch_)
   s0 = +b
   s = (?s0 > 0 && s0(0) [48...57]) | "_" + s0 | s0
   has_h = ?s !< 2 && s(-2..) == "_H"
   res = has_h | s | s + "_H"
   ?s0 == 0 | "DVA_EXPORTS_H" | res

c_type_of_ti: ast::ValueType, ast::TypeInfo => String
c_type_of_ti = vt, ti =>
   ti
      [TypeVar name] codegen::decl_bare_name(name, 0)
      |
         vt
            [Int, I64] "int64_t"
            [I32] "int32_t"
            [I16] "int16_t"
            [I8] "int8_t"
            [U64] "uint64_t"
            [U32, Rune] "uint32_t"
            [U16] "uint16_t"
            [U8] "uint8_t"
            [Float] "double"
            [F32] "float"
            [RawPtr] "void*"
            [Str] "const char*"
            [Flag] "bool"
            [Unit] "void"
            | "void*"

find_assign_sig: ast::Exprs, String => SigResult
find_assign_sig = stmts, name =>
   found' = <->
   res' = ast::TypeInfo(Prim, ast::ValueType(Unit))
   stmts @ st =>
      st
         [Assign a]
            a.8
               [Fn fn_info]
                  a.0 == name || codegen::decl_bare_name(a.0, 0) == name
                     |
                        res' = ast::TypeInfo(Fn, fn_info)
                        found' = <+>
                        -->
   SigResult(res', found')

find_assign_params: ast::Exprs, String => ast::Names
find_assign_params = stmts, name =>
   params' = ast::Names()
   stmts @ st =>
      st
         [Assign a]
            a.5
               [Fn f]
                  a.0 == name || codegen::decl_bare_name(a.0, 0) == name
                     |
                        params' = f.params
                        -->
   params'

add_type_var_from_ti: ast::TypeInfo, ast::Names => ()
add_type_var_from_ti = ti, names =>
   n = ti [TypeVar name] name | ""
   n != ""
      |
         bare = codegen::decl_bare_name(n, 0)
         !loaded_has(names, bare) | names += bare

collect_used_record_types: ast::Exprs, ast::Names => ast::Names
collect_used_record_types = stmts, exports =>
   used = ast::Names()
   exports @ item =>
      eq_pos = find_char_at(item, 0, 61)
      dva_name = eq_pos > 0 | item(0..eq_pos) | item
      bare = codegen::decl_bare_name(dva_name, 0)
      sig_res' = find_assign_sig(stmts, dva_name)
      !sig_res'.ok | sig_res' = find_assign_sig(stmts, bare)
      sig_res'.ok
         |
            sig_ti = sig_res'.ti
            sig_ti
               [Fn fn_info]
                  add_type_var_from_ti(fn_info.3, used)
                  params_ti = fn_info.1
                  params_ti @ pti =>
                     add_type_var_from_ti(pti, used)
   0.. @
      prev_count = ?used
      stmts @ st =>
         st
            [TypeDecl td]
               bare_td = codegen::decl_bare_name(td.name, 0)
               loaded_has(used, bare_td)
                  |
                     td_ti = td.type_info [Align a] a.1 | td.type_info
                     td_ti
                        [Rec r]
                           flds = r.0
                           flds @ f =>
                              add_type_var_from_ti(f.rec_type, used)
      ?used == prev_count | -->
   used

format_record_c_struct: ast::TypeDeclExpr => String
format_record_c_struct = td =>
   b = {256}
   td_align = td.type_info [Align a] a.0 | 0
   td_ti = td.type_info [Align a] a.1 | td.type_info
   align_attr = td_align > 0 | " __attribute__((aligned(" + str::from_int(td_align) + ")))" | ""
   td_ti
      [Rec r]
         b += "typedef struct {\n"
         flds = r.0
         flds @ f, i =>
            f_type = c_type_of_ti(f.val_type, f.rec_type)
            f_name = f.name != "" | f.name | ("_" + str::from_int(i))
            b += "    " + f_type + " " + f_name + ";\n"
         b_name = codegen::decl_bare_name(td.name, 0)
         packed_attr = r.5 | " __attribute__((packed))" | ""
         b += "}" + packed_attr + align_attr + " " + b_name + ";\n\n"
         +b
      [Bitfield bf]
         b += "typedef struct {\n"
         f_type_bf = c_type_of_ti(bf.backing_type,
           ast::TypeInfo(Prim, bf.backing_type))
         bf.fields @ f_bf =>
            b += "    " + f_type_bf + " " + f_bf.name + " : " +
              str::from_int(f_bf.bit_width) + ";\n"
         b_name_bf = codegen::decl_bare_name(td.name, 0)
         b += "} __attribute__((packed))" + align_attr + " " + b_name_bf + ";\n\n"
         +b
      | ""

generate_c_header: ast::Expr, ast::Names, String => <>
generate_c_header = prog, exports, header_path =>
   stmts = prog [Block b] b | ast::Exprs()
   guard = c_header_guard(header_path)
   hdr = {4096}
   hdr += ("#ifndef " + guard + "\n",
     "#define " + guard + "\n\n",
     "#include <stdint.h>\n",
     "#include <stddef.h>\n",
     "#include <stdbool.h>\n\n",
     "#ifdef __cplusplus\n",
     "extern \"C\" {\n",
     "#endif\n\n")

   used_records = collect_used_record_types(stmts, exports)
   emitted_structs = ast::Names()
   stmts @ st =>
      st
         [TypeDecl td]
            b_name = codegen::decl_bare_name(td.name, 0)
            loaded_has(used_records, b_name)
               |
                  !loaded_has(emitted_structs, b_name)
                     |
                        td.type_info
                           [Rec, Bitfield]
                              hdr += format_record_c_struct(td)
                              emitted_structs += b_name
   has_error' = <->
   emitted_symbols = ast::Names()
   exports @ item =>
      eq_pos = find_char_at(item, 0, 61)
      dva_name = eq_pos > 0 | item(0..eq_pos) | item
      c_name0 = eq_pos > 0 | item(eq_pos + 1..?item) |
         codegen::decl_bare_name(item, 0)
      c_name = (?c_name0 > 0 && c_name0(0) == '#) | c_name0(1..) | c_name0
      !loaded_has(emitted_symbols, c_name)
         |
            bare = codegen::decl_bare_name(dva_name, 0)
            sig_res' = find_assign_sig(stmts, dva_name)
            !sig_res'.ok | sig_res' = find_assign_sig(stmts, bare)
            !sig_res'.ok
               |
                  log::error $ "E5020: Exported function '" + dva_name +
                    "' has no type signature."
                  has_error' = <+>
               |
                  sig_ti = sig_res'.ti
                  sig_ti
                     [Fn fn_info]
                        ret_c = c_type_of_ti(fn_info.2, fn_info.3)
                        pnames' = find_assign_params(stmts, dva_name)
                        ?pnames' == 0 |
                           pnames' = find_assign_params(stmts, bare)
                        params_vt = fn_info.0
                        params_ti = fn_info.1
                        proto = {128}
                        proto += ret_c + " " + c_name + "("
                        ?params_vt == 0
                           | proto += "void"
                           |
                              params_vt @ p_vt, j =>
                                 p_ti = params_ti(j).expect("missing params ti")
                                 p_type = c_type_of_ti(p_vt, p_ti)
                                 p_name' = j < ?pnames'
                                    | pnames'(j).expect("missing pnames")
                                    | ""
                                 p_name' == "" || p_name' == "_"
                                    | p_name' = "arg" + str::from_int(j)
                                 j > 0 | proto += ", "
                                 proto += p_type + " " + p_name'
                        proto += ");\n"
                        s_proto = +proto
                        hdr += s_proto
                        emitted_symbols += c_name
                     |
                        log::error $ "E5020: Exported symbol '" + dva_name +
                          "' is not a function."
                        has_error' = <+>

   hdr += ("\n#ifdef __cplusplus\n",
     "}\n",
     "#endif\n\n",
     "#endif // " + guard + "\n")

   has_error'
      | <->
      |
         ok = write_file(header_path, +hdr)
         !ok
            |
               log::error $ "E5021: Could not write header file '" +
                 header_path + "'"
               <->
            | <+>

is_wasm_triple: String => <>
is_wasm_triple = triple =>
   ast::triple_arch(triple) ["wasm32", "wasm"]

is_darwin_triple: String => <>
is_darwin_triple = triple =>
   ast::triple_os(triple) == "darwin"

print_program_errors: unify::TypeErrors => ()
print_program_errors = errs =>
   errs @ err =>
      log::error $ unify::format_error(err)

sq: String => String
sq = s =>
   b = {?s + 8}
   b += 39
   s @ c =>
      c == 39
         | b += "'\\''"
         | b += c
   b += 39
   +b

append_pkg_config_words: String, ast::Names => ()
append_pkg_config_words = text, args =>
   w' = {64}
   text @ c =>
      c == '\s || c == '\t || c == '\n || c == '\r
         |
            ?w' > 0
               |
                  args += +w'
                  w' = {64}
         | w' += c
   ?w' > 0 | args += +w'

resolve_pkg_config: String, ast::Names => <>
resolve_pkg_config = name, clang_args =>
   tmp_file = "/tmp/edva_pkg_config_" + str::from_int(getpid!) + "_" + name + ".tmp"
   cmd = "pkg-config --libs " + sq(name) + " > " + sq(tmp_file) + " 2>/dev/null"
   st = libc::system(cmd)
   rc = st < 0 | -1 | (st .>. 8) .&. 255
   rc != 0
      |
         unlink(tmp_file)
         <->
      |
         content_opt = read_file_text(tmp_file)
         unlink(tmp_file)
         content_opt
            | content =>
               append_pkg_config_words(content, clang_args)
               <+>
            | <->

copy_file: String, String => <>
copy_file = src, dst =>
   read_file_text(src)
      | txt =>
         tmp = "${dst}.tmp.${str::from_int(getpid!)}"
         !write_file(tmp, txt)
            |
               unlink(tmp)
               <->
            |
               rc = libc::rename(tmp, dst)
               rc != 0
                  |
                     unlink(tmp)
                     <->
                  | <+>
      | <->

is_dom_symbol: String => <>
is_dom_symbol = name =>
   starts_with(name, "dom::") || starts_with(name, "console::") ||
     starts_with(name, "edva_dom_")

export_internal_name: String => String
export_internal_name = item =>
   eq_pos = find_char_at(item, 0, 61)
   eq_pos > 0 | item(0..eq_pos) | item

dom_is_reachable: ast::Expr, ast::Names => <>
dom_is_reachable = prog, exports =>
   stmts = prog [Block b] b | ast::Exprs()
   graph = dep_graph::build_dep_graph(stmts)
   work = ast::Names()
   seen = dep_graph::NameSet()
   exports @ exp =>
      ename = export_internal_name(exp)
      ename != "" && !(seen ^? ename)
         |
            seen ^ ename = <+>
            work += ename
   stmts @ st =>
      st
         [Assign a]
            is_dom_var = starts_with(a.0, "dom::") || starts_with(a.0, "console::")
            is_fn = a.5 [Fn]
            a.0 == "main" || (!is_fn && !is_dom_var && !dep_graph::is_fwd_assign(a))
               |
                  a.0 != "" && !(seen ^? a.0)
                     |
                        seen ^ a.0 = <+>
                        work += a.0
                  refs = ast::Names()
                  dep_graph::collect_expr_refs(a.5, ast::Names(), refs)
                  refs @ r =>
                     r != "" && !(seen ^? r)
                        |
                           seen ^ r = <+>
                           work += r
      !(st [Assign, TypeDecl, Foreign])
         |
            refs = ast::Names()
            dep_graph::collect_expr_refs(st, ast::Names(), refs)
            refs @ r =>
               r != "" && !(seen ^? r)
                  |
                     seen ^ r = <+>
                     work += r
   wi' = 0
   found' = <->
   0.. @
      wi' !< ?work || found' | -->
      cur = work(wi').expect("missing work")
      wi' = wi' + 1
      is_dom_symbol(cur)
         | found' = <+>
         |
            graph.indices ^ cur
               | idx =>
                  nd = graph.nodes(idx).expect("missing nodes")
                  nd.deps @ dep =>
                     is_dom_symbol(dep)
                        | found' = <+>
                        |
                           dep != "" && !(seen ^? dep)
                              |
                                 seen ^ dep = <+>
                                 work += dep
   found'

build_cache_summary: CliOpts, ast::Names, ast::Names => String
build_cache_summary = opts, exports, dyn_mods =>
   b = {256}
   opts.fuzz_cov | b += "fuzz_cov=1\n"
   opts.no_typed_opt | b += "typed_opt=off\n"
   opts.check_arena_escapes | b += "check_arena_escapes=1\n"
   opts.cflags @ cf => b += "cflag=${cf}\n"
   exports @ ex => b += "export=${ex}\n"
   dyn_mods @ dm => b += "dyn=${dm}\n"
   +b

artifact_cache_name: <>, <>, <> => String
artifact_cache_name = is_wasm, is_module, is_shared =>
   is_wasm | "output.wasm" | (is_module | "output.o" | (is_shared | "output.so" | "output.bin"))

restore_cached_artifact: String, String, <>, <>, <>, <>, String => <>
restore_cached_artifact = cached_art, output_bin, is_wasm, is_module, is_shared, uses_dom, dom_source =>
   tmp_bin = "${output_bin}.tmp.${str::from_int(getpid!)}"
   !copy_file(cached_art, tmp_bin)
      |
         unlink(tmp_bin)
         --| <->
   (!is_wasm && !is_module)
      | chmod(tmp_bin, 493i32)
   libc::rename(tmp_bin, output_bin) != 0
      |
         unlink(tmp_bin)
         --| <->
   (is_wasm && uses_dom)
      |
         bridge = dirname(dom_source) + "/dom/bridge.js"
         base = ends_with(output_bin, ".wasm")
            | output_bin(0..?output_bin - 5)
            | output_bin
         !copy_file(bridge, base + ".dom.js") | --| <->
         chmod(base + ".dom.js", 420i32)
   <+>

json_escape_simple: String => String
json_escape_simple = s =>
   b = {?s + 8}
   s @ c =>
      c
         [34] b += "\\\""
         [92] b += "\\\\"
         [10] b += "\\n"
         [13] b += "\\r"
         [9]  b += "\\t"
         |    b += c
   +b

emit_phase_timings_json: String, String, <>, <>, <>, Int, Int, Int, Int, Int, Int => ()
emit_phase_timings_json = target, key, cache_en, ir_hit, art_hit, load_ns, type_ns, ana_ns, ir_ns, back_ns, link_ns =>
   tot_ns = load_ns + type_ns + ana_ns + ir_ns + back_ns + link_ns
   b = {512}
   b += "{\"target\":\""
   b += json_escape_simple(target)
   b += "\",\"cache_enabled\":"
   b += (cache_en | "true" | "false")
   b += ",\"cache_key\":\""
   b += json_escape_simple(key)
   b += "\",\"ir_cache_hit\":"
   b += (ir_hit | "true" | "false")
   b += ",\"artifact_cache_hit\":"
   b += (art_hit | "true" | "false")
   b += ",\"phases_ns\":{\"load_parse\":"
   b += str::from_int(load_ns)
   b += ",\"type_specialize\":"
   b += str::from_int(type_ns)
   b += ",\"analysis\":"
   b += str::from_int(ana_ns)
   b += ",\"ir_emit\":"
   b += str::from_int(ir_ns)
   b += ",\"backend_opt\":"
   b += str::from_int(back_ns)
   b += ",\"link\":"
   b += str::from_int(link_ns)
   b += ",\"total\":"
   b += str::from_int(tot_ns)
   b += "}}"
   print $ +b

// Shared compile pipeline: codegen AST -> LLVM IR -> clang binary.
// Used by both the batch driver and the REPL.
compile_ast_to_binary: ast::Expr, ast::Names, CliOpts, String,
  String, ast::Names, ast::Names, ast::Names, ast::Names, ast::Names => < | Int >
compile_ast_to_binary = raw, exports, opts, out_ll, out_bin, dmods, dpaths, nlibs, npkg, lfiles =>
   t_type_start = time::mono_ns!
   prog = overloads::resolve(raw)
   dom_source = canonical_path(compiler_std_dir + "/dom.dva")
   has_dom_file = loaded_has(lfiles, dom_source)
   uses_dom = has_dom_file && (is_wasm_triple(opts.triple) ||
     (?lfiles > 0 && lfiles(0).expect("missing lfiles") == dom_source) ||
     dom_is_reachable(prog, exports))
   actual_exports = ++exports
   uses_dom
      |
         !is_wasm_triple(opts.triple)
            |
               log::error $ "E5047: std/dom requires a browser WebAssembly target"
               --| <- 1 ->
         ("dom_invalidate", "dom_invalidate_kind", "dom_forget", "dom_commit",
           "dom_measure_result",
           "dom_dispatch", "dom_release_listener") @ name =>
           actual_exports += "dom::" + name + "=" + name
   prog_exprs_link = prog [Block b] b | ast::Exprs()
   extra_link_libs = collect_link_libs(prog_exprs_link)
   all_nat_libs = ++nlibs
   extra_link_libs @ elib =>
      !loaded_has(all_nat_libs, elib) | all_nat_libs += elib
   nat_libs = nlibs
   nat_pkg = npkg
   output_ll = out_ll
   output_bin = out_bin
   dynamic_mods = dmods
   dynamic_paths = dpaths
   is_eval_quiet = opts.eval_src != "" && !opts.ir_only && !opts.is_module && !opts.is_shared && opts.outpath == ""
   quiet = opts.repl_mode || is_eval_quiet
   want_timings = opts.timings
   cg_err = opts.repl_mode | 6002 | 5011
   clang_err = opts.repl_mode | 6003 | 5013
   cg_opts = codegen::CodegenOpts(opts.triple, opts.no_runtime, opts.no_main,
     dynamic_mods, dynamic_paths, opts.is_shared, compiler_exe_path,
     opts.is_module, opts.module_name, opts.fuzz_cov, opts.no_typed_opt,
     opts.opt != "-O0", opts.check_arena_escapes)
   src_f = opts.target != "" | opts.target | "<eval>"
   annotate::set_source_file(src_f)
   annotate::set_target_triple(opts.triple)
   el_res = annotate::annotate_program(prog)
   t_type_end = time::mono_ns!
   type_ns = t_type_end - t_type_start
   analysis_ns' = 0
   ir_emit_ns' = 0
   backend_ns' = 0
   link_ns' = 0
   cg_ok' = 0
   is_cached' = <->
   is_art_cached' = <->
   use_cache = !opts.no_cache
   eff_cache_dir = opts.cache_dir != "" | opts.cache_dir | pkg::default_cache!
   cache_key' = ++""
   el_res
      | succ =>
         !use_cache
            |
               cg_ok' = codegen::codegen_typed_program_opts(succ.prog, prog,
                 output_ll, actual_exports, opts.target, cg_opts)
               analysis_ns' = codegen::last_analysis_ns!
               ir_emit_ns' = codegen::last_ir_emit_ns!
            |
               cache_flags = pkg::CacheCodegenFlags(opts.is_module, opts.is_shared,
                 opts.no_runtime, opts.no_main, opts.module_name)
               ast_summary = build_cache_summary(opts, actual_exports, dynamic_mods)
               opt_str = opts.opt != "" | opts.opt | "-O2"
               target_triple = opts.triple != "" | opts.triple | get_default_target_triple(0)
               bkr = pkg::compute_ir_cache_key(opts.target, lfiles, all_nat_libs, nat_pkg,
                 target_triple, opt_str, cache_flags, ast_summary)
               cache_key' = bkr.key
               cached_hit = pkg::cache_lookup(eff_cache_dir, bkr.key)
               cached_hit
                  | cached_ll =>
                     copy_file(cached_ll, output_ll)
                        |
                           cg_ok' = 1
                           is_cached' = <+>
                           !quiet | log::info $ "cached LLVM IR: " + output_ll
                        |
                           cg_ok' = codegen::codegen_typed_program_opts(succ.prog, prog,
                             output_ll, actual_exports, opts.target, cg_opts)
                           analysis_ns' = codegen::last_analysis_ns!
                           ir_emit_ns' = codegen::last_ir_emit_ns!
                           cg_ok' != 0
                              | pkg::cache_store(eff_cache_dir, bkr.key, bkr.meta_text, output_ll)
                  |
                     cg_ok' = codegen::codegen_typed_program_opts(succ.prog, prog,
                       output_ll, actual_exports, opts.target, cg_opts)
                     analysis_ns' = codegen::last_analysis_ns!
                     ir_emit_ns' = codegen::last_ir_emit_ns!
                     cg_ok' != 0
                        | pkg::cache_store(eff_cache_dir, bkr.key, bkr.meta_text, output_ll)
      | errs =>
         print_program_errors(errs)
         cg_ok' = 0
   cg_ok' == 0
      |
         log::error $ "E" + str::from_int(cg_err) +
           ": Compilation aborted due to code generation errors."
         <- 1 ->
      |
         !quiet && !is_cached'
            |
               log::info $ "Successfully generated LLVM IR via LLVM C API: " +
                 output_ll
         opts.header_path != ""
            |
               hdr_ok = generate_c_header(prog, exports, opts.header_path)
               !hdr_ok | <- 1 ->
         opts.ir_only
            |
               want_timings
                  | emit_phase_timings_json(src_f, cache_key', use_cache, is_cached',
                    <->, opts.load_parse_ns, type_ns, analysis_ns', ir_emit_ns', 0, 0)
               <++>
            |
               target_triple = opts.triple != "" | opts.triple |
                  get_default_target_triple(0)
               is_wasm = is_wasm_triple(target_triple)
               art_name = artifact_cache_name(is_wasm, opts.is_module, opts.is_shared)
               // Try restoring cached object / binary artifact if IR hit the cache
               (use_cache && is_cached' && cache_key' != "")
                  |
                     pkg::cache_lookup_artifact(eff_cache_dir, cache_key', art_name)
                        | cached_art =>
                           restore_cached_artifact(cached_art, output_bin, is_wasm,
                             opts.is_module, opts.is_shared, uses_dom, dom_source)
                              |
                                 is_art_cached' = <+>
               is_art_cached'
                  |
                     opts.is_module && !opts.ir_only
                        | unlink(output_ll)
                     !quiet
                        |
                           mod_msg = "Successfully compiled module object: "
                           bin_msg = "Successfully compiled binary: "
                           msg = opts.is_module | mod_msg | bin_msg
                           log::info $ msg + output_bin
                     want_timings
                        | emit_phase_timings_json(src_f, cache_key', use_cache, is_cached',
                          <+>, opts.load_parse_ns, type_ns, analysis_ns', ir_emit_ns', 0, 0)
                     <++>
                  |
                     is_wasm
                        |
                           output_o = output_ll + ".o"
                           clang_args = ast::Names()
                           clang_args += "clang"
                           clang_args += "-Qunused-arguments"
                           clang_args += "-Wno-unused-command-line-argument"
                           clang_args += "-w"
                           clang_args += (opts.opt != "" | opts.opt | "-O2")
                           clang_args += "--target=" + target_triple
                           opts.cflags @ cf =>
                              clang_args += cf
                           clang_args += "-c"
                           clang_args += output_ll
                           clang_args += "-o"
                           clang_args += output_o
                           t_wb0 = time::mono_ns!
                           cres = run_cmd(clang_args)
                           t_wb1 = time::mono_ns!
                           backend_ns' = t_wb1 - t_wb0
                           cres != 0
                              |
                                 log::error $ "E" + str::from_int(clang_err) +
                                   diag::clang_compilation_failed_suffix! +
                                   str::from_int(cres)
                                 <- cres ->
                              |
                                 ld_args = ast::Names()
                                 ld_args += "wasm-ld"
                                 ld_args += "--no-entry"
                                 ld_args += "--export-all"
                                 ld_args += "--allow-undefined"
                                 ld_args += output_o
                                 ld_args += "-o"
                                 ld_args += output_bin
                                 t_wl0 = time::mono_ns!
                                 lres = run_cmd(ld_args)
                                 t_wl1 = time::mono_ns!
                                 link_ns' = t_wl1 - t_wl0
                                 rm_args = ast::Names()
                                 rm_args += "rm"
                                 rm_args += "-f"
                                 rm_args += output_o
                                 run_cmd(rm_args)
                                 lres != 0
                                    |
                                       log::error $ "E" + str::from_int(clang_err) +
                                         ": wasm-ld linking failed with exit code " +
                                         str::from_int(lres)
                                       <- lres ->
                                    |
                                       (use_cache && cache_key' != "")
                                          | pkg::cache_store_artifact(eff_cache_dir, cache_key', art_name, output_bin)
                                       uses_dom
                                          |
                                             bridge = dirname(dom_source) + "/dom/bridge.js"
                                             base = ends_with(output_bin, ".wasm")
                                                | output_bin(0..?output_bin - 5)
                                                | output_bin
                                             !copy_file(bridge, base + ".dom.js")
                                                |
                                                   log::error $ "E5048: Cannot emit " +
                                                     "std/dom browser adapter"
                                                   --| <- 1 ->
                                             chmod(base + ".dom.js", 420i32)
                                       !quiet
                                          |
                                             log::info $ "Successfully compiled binary: " +
                                               output_bin
                                       want_timings
                                          | emit_phase_timings_json(src_f, cache_key', use_cache, is_cached',
                                            <->, opts.load_parse_ns, type_ns, analysis_ns', ir_emit_ns',
                                            backend_ns', link_ns')
                                       <++>
                        |
                           clang_base = ast::Names()
                           clang_base += "clang"
                           clang_base += "-Qunused-arguments"
                           clang_base += "-Wno-unused-command-line-argument"
                           clang_base += "-w"
                           clang_base += (opts.opt != "" | opts.opt | "-O2")
                           clang_base += "--target=" + target_triple
                           opts.cflags @ cf =>
                              clang_base += cf
                           is_darwin = is_darwin_triple(target_triple)
                           opts.is_shared
                              |
                                 clang_base += "-shared"
                                 clang_base += "-fPIC"
                                 is_darwin
                                    |
                                       clang_base += "-Wl,-undefined,dynamic_lookup"
                           opts.is_module
                              |
                                 c_args = ++clang_base
                                 c_args += "-c"
                                 c_args += output_ll
                                 c_args += "-o"
                                 c_args += output_bin
                                 t_nb0 = time::mono_ns!
                                 cres = run_cmd(c_args)
                                 t_nb1 = time::mono_ns!
                                 backend_ns' = t_nb1 - t_nb0
                                 !opts.ir_only
                                    | unlink(output_ll)
                                 cres != 0
                                    |
                                       log::error $ "E" + str::from_int(clang_err) +
                                         diag::clang_compilation_failed_suffix! +
                                         str::from_int(cres)
                                       <- cres ->
                                    |
                                       (use_cache && cache_key' != "")
                                          | pkg::cache_store_artifact(eff_cache_dir, cache_key', art_name, output_bin)
                                       !quiet
                                          | log::info $ "Successfully compiled module object: " + output_bin
                                       want_timings
                                          | emit_phase_timings_json(src_f, cache_key', use_cache, is_cached',
                                            <->, opts.load_parse_ns, type_ns, analysis_ns', ir_emit_ns',
                                            backend_ns', 0)
                                       <++>
                              |
                                 pkg_err' = <->
                                 link_args = ++clang_base
                                 tmp_obj = "${output_ll}.tmp.${str::from_int(getpid!)}.o"
                                 comp_args = ++clang_base
                                 comp_args += "-c"
                                 comp_args += output_ll
                                 comp_args += "-o"
                                 comp_args += tmp_obj
                                 link_args += tmp_obj
                                 prog_exprs = prog [Block b] b | ast::Exprs()
                                 link_libs = collect_link_libs(prog_exprs)
                                 link_libs @ lib =>
                                    is_path_lib = find_char_at(lib, 0, 47) !< 0 ||
                                      ends_with(lib, ".a") || ends_with(lib, ".o") ||
                                      ends_with(lib, ".so") || ends_with(lib, ".dylib")
                                    link_args += (is_path_lib | lib | "-l" + lib)
                                 nat_libs @ lib =>
                                    is_path_lib = find_char_at(lib, 0, 47) !< 0 ||
                                      ends_with(lib, ".a") || ends_with(lib, ".o") ||
                                      ends_with(lib, ".so") || ends_with(lib, ".dylib")
                                    link_args += (is_path_lib | lib | "-l" + lib)
                                 nat_pkg @ pname =>
                                    !pkg_err'
                                       |
                                          ok = resolve_pkg_config(pname, link_args)
                                          !ok
                                             |
                                                log::error $ "E5039: missing native requirement: pkg-config '" +
                                                  pname + "' failed"
                                                pkg_err' = <+>
                                 ?dynamic_mods > 0
                                    |
                                       link_args += (is_darwin | "-Wl,-export_dynamic" | "-Wl,--export-dynamic")
                                       !is_darwin | link_args += "-ldl"
                                 link_args += "-o"
                                 link_args += output_bin
                                 pkg_err'
                                    | <- 1 ->
                                    |
                                       t_nb0 = time::mono_ns!
                                       cres = run_cmd(comp_args)
                                       t_nb1 = time::mono_ns!
                                       backend_ns' = t_nb1 - t_nb0
                                       cres != 0
                                          |
                                             unlink(tmp_obj)
                                             log::error $ "E" + str::from_int(clang_err) +
                                               diag::clang_compilation_failed_suffix! +
                                               str::from_int(cres)
                                             <- cres ->
                                          |
                                             t_nl0 = time::mono_ns!
                                             lres = run_cmd(link_args)
                                             t_nl1 = time::mono_ns!
                                             link_ns' = t_nl1 - t_nl0
                                             unlink(tmp_obj)
                                             lres != 0
                                                |
                                                   log::error $ "E" + str::from_int(clang_err) +
                                                     diag::clang_compilation_failed_suffix! +
                                                     str::from_int(lres)
                                                   <- lres ->
                                                |
                                                   (use_cache && cache_key' != "")
                                                      | pkg::cache_store_artifact(eff_cache_dir, cache_key', art_name, output_bin)
                                                   !quiet
                                                      | log::info $ "Successfully compiled binary: " + output_bin
                                                   want_timings
                                                      | emit_phase_timings_json(src_f, cache_key', use_cache, is_cached',
                                                        <->, opts.load_parse_ns, type_ns, analysis_ns', ir_emit_ns',
                                                        backend_ns', link_ns')
                                                   <++>

// --- REPL -------------------------------------------------------------------

// Read a single line from stdin (fd 0), up to max bytes.
// Returns < String | >: positive line on success, negative unit on EOF.
read_stdin_line: Int => < String | >
read_stdin_line = max =>
   buf = mem::zero_buf(max + 1)
   n' = 0
   max @ i =>
      rb = libc::read(0, &buf + i, 1)
      rb < 1
         | -->
         |
            n' = i + 1
            buf(i) == 10
               | -->
   n' == 0
      | <-->
      |
         len = (buf(n' - 1) == 10) | n' - 1 | n'
         mem::truncate(buf, len)
         <+ +buf +>

write_bytes_loop: Int, String, Int, Int => <>
write_bytes_loop = fd, content, offset, remaining =>
   remaining !> 0
      | <+>
      |
         w = libc::write_ptr(fd, &content + offset, remaining)
         w < 0
            |
               errno_ptr = libc::__errno_location!
               errno = @[errno_ptr i32]
               errno == 4
                  | write_bytes_loop(fd, content, offset, remaining)
                  | <->
            | w == 0
               | <->
               | write_bytes_loop(fd, content, offset + w, remaining - w)

// Write content to a file (create/truncate, owner-only 0600 mode).
// Returns <+> on success.
write_file: String, String => <>
write_file = path, content =>
   fd = libc::creat(path, 384)
   fd < 0
      | <->
      |
         n = ?content
         ok = n == 0 | <+> | write_bytes_loop(fd, content, 0, n)
         libc::close(fd)
         ok

is_decl_stmt: ast::Expr => <>
is_decl_stmt = [Assign, TypeDecl, Foreign, Import]

exprs_have_decl: ast::Exprs => <>
exprs_have_decl = exprs =>
   found' = <->
   exprs @ e =>
      is_decl_stmt(e) | (found' = <+>; -->)
   found'

line_is_empty: String => <>
line_is_empty = line =>
   i' = 0
   0.. @
      i' !< ?line | -->
      c = line(i')
      c == '\s || c == '\t || c == '\r || c == '\n
         | i' = i' + 1
         | -->
   i' !< ?line || (i' + 1 < ?line && line(i') == '/ && line(i' + 1) == '/)

line_has_decl: String => <>
line_has_decl = line =>
   p = parser::parse_init(line)
   prog_res = parser::parse_program(p)
   prog_res
      | prog =>
         prog
            [Block b] exprs_have_decl(b)
            | is_decl_stmt(prog)
      | <->

is_writer_line: String => <>
is_writer_line = line =>
   line(..6) == "print " ||
     line(..7) == "print\t" ||
     line(..7) == "print($" ||
     line(..6) == "print(" ||
     line(..9) == "print_int" ||
     line(..7) == "io::out" ||
     line(..7) == "writeln" ||
     line(..11) == "libc::write" ||
     line(..10) == "libc::puts"

last_non_binding_stmt: tast::TypedStmts => < tast::TypedStmt | >
last_non_binding_stmt = stmts =>
   n = ?stmts
   n @ k =>
      st = stmts(n - 1 - k).expect("missing stmts")
      is_b = st [Binding]
      !is_b | --| <+ st +>
   <-->

line_returns_unit: CliOpts, String, String, String => <>
line_returns_unit = opts, temp_src, session_src, line =>
   raw_src = session_src == "" | line | session_src + "\n" + line
   !write_file(temp_src, raw_src)
      | <->
      |
         lres = load_all(temp_src, "", <->, opts.import_map)
         !lres.ok || ?lres.exprs == 0
            | <->
            |
               prog = ast::Expr(Block, lres.exprs)
               el = annotate::annotate_program(prog)
               el
                  | succ =>
                     last_opt = last_non_binding_stmt(succ.prog)
                     last_opt
                        | last_st =>
                           last_st
                              [Expr te]
                                 c_ut = unify::canon(succ.ctx, te.ut)
                                 c_ut [Prim p] (p [Unit]) | <->
                              | <+>
                        | <+>
                  | <->

prog_is_non_unit_expr: ast::Expr => <>
prog_is_non_unit_expr = prog =>
   el = annotate::annotate_program(prog)
   el
      | succ =>
         last_opt = last_non_binding_stmt(succ.prog)
         last_opt
            | last_st =>
               last_st
                  [Expr te]
                     c_ut = unify::canon(succ.ctx, te.ut)
                     is_u = c_ut [Prim p] (p [Unit]) | <->
                     !is_u
                  | <->
            | <->
      | <->

active_repl_src: String
active_repl_src = ""
active_repl_ll: String
active_repl_ll = ""
active_repl_bin: String
active_repl_bin = ""
active_repl_dir: String
active_repl_dir = ""
// Saved terminal attributes (struct termios is ~60 bytes; 128 leaves headroom).
// A Builder gives a stable, writable buffer for tcgetattr/tcsetattr via &buf.
::orig_termios: Builder
::orig_termios = mem::zero_buf(128)
::raw_mode_active: <>
::raw_mode_active = <->

enable_raw_mode: () => <>
enable_raw_mode = !=>
   libc::isatty(0) == 0
      | <->
      |
         libc::tcgetattr(0, &orig_termios) != 0
            | <->
            |
               raw = mem::zero_buf(128)
               libc::memcpy(&raw, &orig_termios, 128)
               libc::cfmakeraw(&raw)
               res = libc::tcsetattr(0, 0, &raw)
               res == 0
                  |
                     raw_mode_active = <+>
                     <+>
                  | <->

disable_raw_mode: () => ()
disable_raw_mode = !=>
   raw_mode_active
      |
         libc::tcsetattr(0, 0, &orig_termios)
         raw_mode_active = <->

write_esc: String => ()
write_esc = seq =>
   b = {16}
   b += 27
   b += seq
   s = +b
   libc::write(1, s, ?s)

check_stdin_ready: () => <>
check_stdin_ready = !=>
   poll::stdin_ready(50)

refresh_line: String, Int => ()
refresh_line = line, pos =>
   libc::write(1, "\r", 1)
   libc::write(1, "dva> ", 5)
   ?line > 0 | libc::write(1, line, ?line)
   write_esc("[K")
   pos < ?line
      |
         back = str::from_int(?line - pos)
         write_esc("[" + back + "D")

repl_history_get: ast::Names, Int, String => String
repl_history_get = hist, idx, uncommitted =>
   idx == ?hist | uncommitted | (hist(idx) | _ | "")

repl_history_append: ReplSession, String => ()
repl_history_append = sess, line =>
   ?line > 0
      |
         hist = sess.history
         nh = ?hist
         nh == 0 || (hist(nh - 1) | _ | "") != line
            | hist += line

read_line_raw: ReplSession => < String | >
read_line_raw = sess =>
   line' = ++""
   pos' = 0
   uncommitted' = ++""
   nh = ?sess.history
   hist_idx' = nh
   eof' = <->
   c_byte' = 0u8
   seq_byte' = 0u8
   refresh_line(line', pos')
   0.. @
      rb = libc::read(0, &c_byte', 1)
      rb < 1
         |
            eof' = <+>
            -->
         |
            b0 = Int(c_byte')
            b0 == 10 || b0 == 13
               |
                  libc::write(1, "\r\n", 2)
                  -->
            b0 == 4
               |
                  ?line' == 0
                     |
                        libc::write(1, "\r\n", 2)
                        eof' = <+>
                        -->
                     |
                        pos' < ?line'
                           |
                              line' = line'(0..pos') + line'((pos' + 1)..)
                              refresh_line(line', pos')
            b0 == 3
               |
                  libc::write(1, "^C\r\n", 4)
                  line' = ++""
                  pos' = 0
                  uncommitted' = ++""
                  hist_idx' = ?sess.history
                  refresh_line(line', pos')
            b0 == 127 || b0 == 8
               |
                  pos' > 0
                     |
                        line' = line'(0..(pos' - 1)) + line'(pos'..)
                        pos' = pos' - 1
                        refresh_line(line', pos')
            b0 == 1
               |
                  pos' = 0
                  refresh_line(line', pos')
            b0 == 5
               |
                  pos' = ?line'
                  refresh_line(line', pos')
            b0 == 2
               |
                  pos' > 0 | pos' = pos' - 1
                  refresh_line(line', pos')
            b0 == 6
               |
                  pos' < ?line' | pos' = pos' + 1
                  refresh_line(line', pos')
            b0 == 21
               |
                  line' = ++""
                  pos' = 0
                  refresh_line(line', pos')
            b0 == 11
               |
                  line' = line'(0..pos')
                  refresh_line(line', pos')
            b0 == 12
               |
                  write_esc("[H")
                  write_esc("[2J")
                  refresh_line(line', pos')
            b0 == 16
               |
                  cur_nh = ?sess.history
                  cur_nh > 0 && hist_idx' > 0
                     |
                        hist_idx' == cur_nh | uncommitted' = ++line'
                        hist_idx' = hist_idx' - 1
                        line' = ++repl_history_get(sess.history, hist_idx',
                          uncommitted')
                        pos' = ?line'
                        refresh_line(line', pos')
            b0 == 14
               |
                  cur_nh = ?sess.history
                  hist_idx' < cur_nh
                     |
                        hist_idx' = hist_idx' + 1
                        line' = ++repl_history_get(sess.history, hist_idx',
                          uncommitted')
                        pos' = ?line'
                        refresh_line(line', pos')
            b0 == 27
               |
                  check_stdin_ready!
                     |
                        libc::read(0, &seq_byte', 1)
                        b1 = Int(seq_byte')
                        b1 == 91
                           |
                              check_stdin_ready!
                                 |
                                    libc::read(0, &seq_byte', 1)
                                    b2 = Int(seq_byte')
                                    b2 == 65
                                       |
                                          cur_nh = ?sess.history
                                          cur_nh > 0 && hist_idx' > 0
                                             |
                                                hist_idx' == cur_nh |
                                                   uncommitted' = ++line'
                                                hist_idx' = hist_idx' - 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 66
                                       |
                                          cur_nh = ?sess.history
                                          hist_idx' < cur_nh
                                             |
                                                hist_idx' = hist_idx' + 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 67
                                       |
                                          pos' < ?line' | pos' = pos' + 1
                                          refresh_line(line', pos')
                                    b2 == 68
                                       |
                                          pos' > 0 | pos' = pos' - 1
                                          refresh_line(line', pos')
                                    b2 == 72
                                       |
                                          pos' = 0
                                          refresh_line(line', pos')
                                    b2 == 70
                                       |
                                          pos' = ?line'
                                          refresh_line(line', pos')
                                    b2 == 51
                                       |
                                          check_stdin_ready! |
                                             libc::read(0, &seq_byte', 1)
                                          pos' < ?line'
                                             |
                                                line' = line'(0..pos') +
                                                  line'((pos' + 1)..)
                                                refresh_line(line', pos')
                                    b2 == 49 || b2 == 55
                                       |
                                          check_stdin_ready! |
                                             libc::read(0, &seq_byte', 1)
                                          pos' = 0
                                          refresh_line(line', pos')
                                    b2 == 52 || b2 == 56
                                       |
                                          check_stdin_ready! |
                                             libc::read(0, &seq_byte', 1)
                                          pos' = ?line'
                                          refresh_line(line', pos')
                        b1 == 79
                           |
                              check_stdin_ready!
                                 |
                                    libc::read(0, &seq_byte', 1)
                                    b2 = Int(seq_byte')
                                    b2 == 65
                                       |
                                          cur_nh = ?sess.history
                                          cur_nh > 0 && hist_idx' > 0
                                             |
                                                hist_idx' == cur_nh |
                                                   uncommitted' = ++line'
                                                hist_idx' = hist_idx' - 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 66
                                       |
                                          cur_nh = ?sess.history
                                          hist_idx' < cur_nh
                                             |
                                                hist_idx' = hist_idx' + 1
                                                line' = ++repl_history_get(
                                                   sess.history, hist_idx',
                                                   uncommitted')
                                                pos' = ?line'
                                                refresh_line(line', pos')
                                    b2 == 67
                                       |
                                          pos' < ?line' | pos' = pos' + 1
                                          refresh_line(line', pos')
                                    b2 == 68
                                       |
                                          pos' > 0 | pos' = pos' - 1
                                          refresh_line(line', pos')
                                    b2 == 72
                                       |
                                          pos' = 0
                                          refresh_line(line', pos')
                                    b2 == 70
                                       |
                                          pos' = ?line'
                                          refresh_line(line', pos')
            b0 == 9
               |
                  line' = line'(0..pos') + "   " + line'(pos'..)
                  pos' = pos' + 3
                  refresh_line(line', pos')
            b0 !< 32 && b0 != 127
               |
                  ch = str::from_byte(b0)
                  line' = line'(0..pos') + ch + line'(pos'..)
                  pos' = pos' + 1
                  refresh_line(line', pos')
   disable_raw_mode!
   eof' | <--> | <+ line' +>

readline_interactive: ReplSession => < String | >
readline_interactive = sess =>
   libc::isatty(0) == 0
      |
         libc::write(1, "dva> ", 5)
         read_stdin_line(4096)
      |
         enable_raw_mode!
            | read_line_raw(sess)
            |
               libc::write(1, "dva> ", 5)
               read_stdin_line(4096)

make_scratch_dir_loop: Int, Int => String
make_scratch_dir_loop = pid, seq =>
   seq > 100
      | ""
      |
         p_s = str::from_int(pid)
         cand = "/tmp/edva_repl_" + p_s + "_" + str::from_int(seq)
         res = mkdir(cand, 448)
         res == 0
            | cand
            | make_scratch_dir_loop(pid, seq + 1)

make_scratch_dir: () => String
make_scratch_dir = !=>
   pid = getpid!
   make_scratch_dir_loop(pid, 0)

repl_cleanup: ReplSession => ()
repl_cleanup = sess =>
   disable_raw_mode!
   ?sess.src_path > 0 | unlink(sess.src_path)
   ?sess.ll_path > 0 | unlink(sess.ll_path)
   ?sess.bin_path > 0 | unlink(sess.bin_path)
   ?sess.dir > 0 | rmdir(sess.dir)
   active_repl_src ::= ""
   active_repl_ll ::= ""
   active_repl_bin ::= ""
   active_repl_dir ::= ""

repl_step: CliOpts, String, String, ReplSession => String
repl_step = opts, session_src, line, sess =>
   disable_raw_mode!
   line_is_empty(line)
      | session_src
      |
         is_decl = line_has_decl(line)
         is_unit = !is_decl && !is_writer_line(line) &&
           line_returns_unit(opts, sess.src_path, session_src, line)
         candidate = is_decl || is_writer_line(line) || is_unit | line |
            "io::out(" + line + ")"
         full_src = session_src == "" | candidate |
            session_src + "\n" + candidate
         temp_src = sess.src_path
         !write_file(temp_src, full_src)
            |
               log::error $ "E6001: Could not write scratch source file"
               session_src
            |
               load_res = load_all(temp_src, "", <->, opts.import_map)
               !load_res.ok || ?load_res.exprs == 0
                  | session_src
                  |
                     prog = ast::Expr(Block, load_res.exprs)
                     comp = compile_ast_to_binary(prog, load_res.exports,
                       opts, sess.ll_path, sess.bin_path,
                       load_res.dynamic_mods, load_res.dynamic_paths,
                       load_res.native_libs, load_res.native_pkg_config,
                       load_res.loaded_files)
                     comp
                        |
                           run_args = ast::Names()
                           run_args += sess.bin_path
                           rres = run_cmd(run_args)
                           rres != 0
                              |
                                 log::error $ "E6004: Program exited with code " +
                                   str::from_int(rres)
                                 session_src
                              |
                                 is_decl
                                    |
                                       session_src == "" | line |
                                          session_src + "\n" + line
                                    | session_src
                        | session_src

repl_loop: CliOpts, String, ReplSession => ()
repl_loop = opts, session_src, sess =>
   readline_interactive(sess)
      | line =>
         ?line == 0
            | repl_loop(opts, session_src, sess)
            |
               !(line == ":q" || line == ":quit" || line == "exit")
                  |
                     repl_history_append(sess, line)
                     next_src = repl_step(opts, session_src, line, sess)
                     repl_loop(opts, next_src, sess)
      |
         print $ ""
         print $ "Goodbye!"

on_sigint: Int => Int
on_sigint = sig =>
   disable_raw_mode!
   ?active_repl_src > 0 | unlink(active_repl_src)
   ?active_repl_ll > 0 | unlink(active_repl_ll)
   ?active_repl_bin > 0 | unlink(active_repl_bin)
   ?active_repl_dir > 0 | rmdir(active_repl_dir)
   libc::write(1, "\nGoodbye!\n", 10)
   libc::exit(0)
   0

repl_run: CliOpts => ()
repl_run = opts =>
   print $ "========================================="
   print $ "           DVA INTERACTIVE REPL          "
   print $ "========================================="
   print $ "Type expressions or statements. Press Ctrl-D to quit."
   print $ ""
   init_compiler_paths!
   scratch_dir = make_scratch_dir!
   ?scratch_dir == 0
      |
         log::error $ "E6005: Could not create scratch directory for REPL"
      |
         session_src = path_join(scratch_dir, "session.dva")
         session_ll = path_join(scratch_dir, "session.ll")
         session_bin = path_join(scratch_dir, "session")
         active_repl_src ::= session_src
         active_repl_ll ::= session_ll
         active_repl_bin ::= session_bin
         active_repl_dir ::= scratch_dir
         signal(2, @[&on_sigint Addr])
         sess = ReplSession(scratch_dir, session_src, session_ll,
           session_bin, ast::Names())
         repl_opts = opts
         repl_opts.repl_mode = <+>
         repl_opts.no_cache = <+>
         repl_loop(repl_opts, "#use io", sess)
         repl_cleanup(sess)

format_version: () => String
format_version = !=> "edva " + version::VERSION

not_flag: String => < | String >
not_flag = s =>
   (?s > 0 && s(0) == '-) | <- "argument must not begin with '-'; got '" + s + "'" ->

valid_opt_level: String => < | String >
valid_opt_level = s =>
   s !["", "0", "1", "2", "3", "s", "z", "-O0", "-O1", "-O2", "-O3", "-Os", "-Oz"]
      | <- "invalid optimization level '" + s + "'" ->

compiler_cli_opts: () => cli::Opts
compiler_cli_opts = !=>
   cli::Opts(
      // Top-level subcommands
      cli::cmd("init", "Initialize a new Edva package", cli::Opts(
         cli::pos("dir", ".", "Target directory to initialize"),
         cli::opt("n:name", "", "Package name (defaults to directory basename)", not_flag),
         cli::opt("lib", <->, "Initialize a library package without src/main.dva")
      )),
      cli::cmd("add", "Add a dependency to edva.ccl and lock it", cli::Opts(
         cli::pos("spec", cli::Args(), "Dependency spec (<spec> or <alias> <spec>)"),
         cli::opt("as", "", "Explicit dependency alias", not_flag),
         cli::opt("rev", "", "Git revision, tag, or branch", not_flag),
         cli::opt("path", "", "Local directory path dependency", not_flag),
         cli::opt("git", "", "Git repository URL dependency", not_flag),
         cli::opt("url", "", "Archive URL dependency (.tar.gz)", not_flag),
         cli::opt("hash", "", "Expected SHA-256 hash for archive", not_flag),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("rm|remove", "Remove a dependency from edva.ccl", cli::Opts(
         cli::pos("alias", String, "Dependency alias to remove", not_flag),
         cli::pos("dir", ".", "Package root directory"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("build", "Build package or .dva source file", cli::Opts(
         cli::pos("target-path", ".", "Package directory or .dva source file"),
         cli::opt("o:output", "", "Output binary path", not_flag),
         cli::opt("t:target", "", "Target triple (e.g. x86_64-unknown-linux-gnu)", not_flag),
         cli::opt("O:opt", "", "Optimization level (0, 1, 2, 3, s, z)", valid_opt_level),
         cli::opt("cflag", cli::Args(), "Pass additional flag to clang"),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("run", "Build and run package or .dva source file", cli::Opts(
         cli::pos("target-path", ".", "Package directory or .dva source file"),
         cli::opt("o:output", "", "Output binary path", not_flag),
         cli::opt("t:target", "", "Target triple (e.g. x86_64-unknown-linux-gnu)", not_flag),
         cli::opt("O:opt", "", "Optimization level (0, 1, 2, 3, s, z)", valid_opt_level),
         cli::opt("cflag", cli::Args(), "Pass additional flag to clang"),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("check", "Type-check and verify package (all declared targets) or .dva source file", cli::Opts(
         cli::pos("target-path", ".", "Package directory or .dva source file"),
         cli::opt("t:target", "", "Target triple (e.g. wasm32-unknown-unknown)", not_flag),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("test", "Run package tests or a single test .dva file", cli::Opts(
         cli::pos("target-path", ".", "Package directory or test .dva file"),
         cli::opt("fuzz", <->, "Enable coverage-guided fuzzing mode"),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("fetch", "Resolve dependencies and write edva.lock.ccl", cli::Opts(
         cli::pos("dir", ".", "Package root directory"),
         cli::opt("t:target", "", "Filter target-scoped dependencies for target triple", not_flag),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("update", "Refresh pinned git dependencies in edva.lock.ccl", cli::Opts(
         cli::pos("args", cli::Args(), "Optional dependency alias and/or package directory"),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag),
         cli::opt("cache", "", "Compilation cache directory path", not_flag),
         cli::opt("no-cache", <->, "Disable compilation cache")
      )),
      cli::cmd("tree|graph", "Display resolved package dependency tree", cli::Opts(
         cli::pos("dir", ".", "Package root directory"),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag)
      )),
      cli::cmd("vendor", "Materialize all dependencies into vendor/", cli::Opts(
         cli::pos("dir", ".", "Package root directory"),
         cli::opt("t:target", "", "Filter target-scoped dependencies for target triple", not_flag),
         cli::opt("locked", <->, "Require edva.lock.ccl to be up to date"),
         cli::opt("offline", <->, "Resolve dependencies from local store/vendor only"),
         cli::opt("store", "", "Package content store directory", not_flag)
      )),
      cli::cmd("cache", "Manage compilation cache (dir, ls, clean)", cli::Opts(
         cli::cmd("dir", "Print active compilation cache directory", cli::Opts(
            cli::opt("cache", "", "Compilation cache directory path", not_flag)
         )),
         cli::cmd("ls|list|status", "List cached compilation entries", cli::Opts(
            cli::opt("cache", "", "Compilation cache directory path", not_flag)
         )),
         cli::cmd("clean", "Remove all cached compilation entries", cli::Opts(
            cli::opt("cache", "", "Compilation cache directory path", not_flag)
         )),
         cli::opt("cache", "", "Compilation cache directory path", not_flag)
      )),
      cli::cmd("fmt", "Format Edva source files", cli::Opts(
         cli::pos("files", cli::Args(), "Files or directories to format"),
         cli::opt("check", <->, "Check if files are formatted (exit 1 if changes needed)"),
         cli::opt("stdout", <->, "Write formatted output to stdout"),
         cli::opt("stdin", <->, "Read source from stdin and write to stdout")
      )),
      cli::cmd("lsp", "Start Edva Language Server (JSON-RPC over stdio)"),
      cli::cmd("version", "Print compiler version and exit"),
      // Direct compilation options
      cli::opt("o:output", "", "Output binary or object path", not_flag),
      cli::opt("r:run", <->, "Run binary immediately after linking"),
      cli::opt("ir", <->, "Emit LLVM IR (.ll) only; do not invoke clang"),
      cli::opt("c:compile-only", <->, "Compile to object file (.o) only"),
      cli::opt("shared", <->, "Build a shared library (.so)"),
      cli::opt("entry", <->, "Compile as program entry module"),
      cli::opt("m:module", "", "Compile as named module", not_flag),
      cli::opt("t:target", "", "Target triple (e.g. x86_64-unknown-linux-gnu)", not_flag),
      cli::opt("O:opt", "2", "Optimization level (0, 1, 2, 3, s, z)", valid_opt_level),
      cli::opt("H:header", "", "Generate C header from #export declarations", not_flag),
      cli::opt("e:eval", "", "Evaluate inline code string"),
      cli::opt("i:repl", <->, "Interactive REPL (reads from stdin)"),
      cli::opt("ast", <->, "Print AST of target program"),
      cli::opt("ast-tree", <->, "Print AST as an indented tree"),
      cli::opt("typed-ast", <->, "Elaborate and verify typed AST"),
      cli::opt("typed-ast-tree", <->, "Elaborate, verify, and dump typed AST tree"),
      cli::opt("no-main", <->, "Emit main with internal linkage"),
      cli::opt("no-runtime", <->, "Omit standard runtime emission"),
      cli::opt("no-typed-opt", <->, "Skip pre-LLVM typed rewrites"),
      cli::opt("check-arena-escapes", <->, "Check global stores for scoped-arena values"),
      cli::opt("import-map", "", "Path to package import map", not_flag),
      cli::opt("cache", "", "Compilation cache directory path"),
      cli::opt("no-cache", <->, "Disable compilation cache"),
      cli::opt("cflag", cli::Args(), "Pass additional flag to clang"),
      cli::opt("fuzz-cov", <->, "Instrument branches and functions with coverage bitmap for fuzzing"),
      cli::opt("timings", <->, "Emit machine-readable JSON phase timings"),
      // Direct compilation positional arguments
      cli::pos("input", "", "Input .dva file or directory"),
      cli::pos("output", "", "Output binary path")
   )

print_usage: Int => ()
print_usage = ignored =>
   print $ cli::format_help(
      compiler_cli_opts!,
      "edva",
      "Edva self-hosted compiler and package driver",
      version::VERSION
   )

parse_and_dispatch_cli: () => CliOpts
parse_and_dispatch_cli = !=>
   res = cli::parse(
      compiler_cli_opts!,
      "Edva self-hosted compiler and package driver",
      version::VERSION,
      <+>
   )
   sub = cli::subcmd(res)
   sub != ""
      |
         sub
            ["fmt"]
               rc = formatter::main(2)
               sys::exit(rc)
            ["lsp"]
               rc = lsp::main(compiler_std_dir, lsp_typecheck_doc)
               sys::exit(rc)
            ["version"]
               print $ format_version!
               sys::exit(0)
            |
               rc = pkg::dispatch(sub, res)
               sys::exit(rc)

   opts = init_opts(0)
   pos = cli::rest(res)
   ?pos > 0 | opts.target = (pos(0) | _ | "")
   ?pos > 1 | opts.outpath = (pos(1) | _ | "")

   out_flag = cli::str(res, "output")
   out_flag != "" | opts.outpath = out_flag

   opts.run_exec = cli::flag(res, "run")
   opts.ir_only = cli::flag(res, "ir")
   opts.no_runtime = cli::flag(res, "no-runtime")
   opts.no_typed_opt = cli::flag(res, "no-typed-opt")
   opts.check_arena_escapes = cli::flag(res, "check-arena-escapes")
   opts.no_main = cli::flag(res, "no-main")
   opts.repl_mode = cli::flag(res, "repl")

   ast_tree = cli::flag(res, "ast-tree")
   typed_tree = cli::flag(res, "typed-ast-tree")
   ast_dump = cli::flag(res, "ast") || ast_tree || typed_tree
   typed_ast = cli::flag(res, "typed-ast") || typed_tree
   opts.ast_tree = (ast_tree || typed_tree)
   opts.ast_dump = ast_dump
   opts.typed_ast = typed_ast

   opts.eval_src = cli::str(res, "eval")
   opts.triple = cli::str(res, "target")
   opts.header_path = cli::str(res, "header")
   opts.import_map = cli::str(res, "import-map")
   opts.cache_dir = cli::str(res, "cache")
   opts.no_cache = cli::flag(res, "no-cache")
   opts.cflags = cli::strs(res, "cflag")
   opts.fuzz_cov = cli::flag(res, "fuzz-cov")
   opts.timings = cli::flag(res, "timings")

   opt_lvl = cli::str(res, "opt")
   opt_flag = opt_lvl(..2) == "-O" | opt_lvl | "-O" + opt_lvl
   opts.opt = opt_flag

   cli::flag(res, "shared")
      |
         opts.is_shared = <+>
         opts.no_main = <+>
   cli::flag(res, "compile-only")
      |
         opts.is_module = <+>
         opts.no_main = <+>
   mod_name = cli::str(res, "module")
   mod_name != ""
      |
         opts.module_name = mod_name
         opts.is_module = <+>
         opts.no_main = <+>
   cli::flag(res, "entry")
      |
         opts.no_main = <->
         opts.module_name = ""
   opts

verify_typed_ast: ast::Expr, <>, <> => ()
verify_typed_ast = prog, dump_ast, as_tree =>
   el_res = annotate::annotate_program(prog)
   el_res
      | succ =>
         dump_ast | show::dump_typed_program(succ.ctx, succ.prog, as_tree)
         annotate::print_elab_stats(succ.stats)
         sys::exit(0)
      | errs =>
         print_program_errors(errs)
         sys::exit(1)

dump_program_ast: ast::Expr, <> => ()
dump_program_ast = prog, as_tree =>
   prog
      [Block b]
         b @ st =>
            as_tree
               | print $ show::show_tree(st, 0)
               | print $ show::show_expr(st)
      |
         as_tree
            | print $ show::show_tree(prog, 0)
            | print $ show::show_expr(prog)

eval_cleanup: String, String, String, String => ()
eval_cleanup = dir, src_f, ll_f, bin_f =>
   ?src_f > 0 | unlink(src_f)
   ?ll_f > 0 | unlink(ll_f)
   ?bin_f > 0 | unlink(bin_f)
   ?dir > 0 | rmdir(dir)

run_eval: CliOpts => ()
run_eval = opts =>
   opts.ast_dump && !opts.typed_ast
      |
         src = opts.eval_src + "\n"
         ppr = parser::parse_init(src)
         parser::parser_set_file(ppr, "<eval>")
         lexer::lex_set_file("<eval>")
         prog_res = parser::parse_program(ppr)
         prog_res
            | prog =>
               dump_program_ast(prog, opts.ast_tree)
               sys::exit(0)
            |
               sys::exit(1)
   eval_dir = make_scratch_dir!
   ?eval_dir == 0
      |
         log::error $ "E6005: Could not create scratch directory for -e"
         sys::exit(1)
   eval_file = path_join(eval_dir, "eval.dva")
   eval_ll = path_join(eval_dir, "eval.ll")
   eval_bin = path_join(eval_dir, "eval")
   !write_file(eval_file, opts.eval_src + "\n")
      |
         eval_cleanup(eval_dir, eval_file, "", "")
         log::error $ "E6001: Could not write scratch source file"
         sys::exit(1)
   eval_prefix = opts.is_module && opts.no_main | opts.module_name | ""
   t_ev_l0 = time::mono_ns!
   eval_load = load_all(eval_file, eval_prefix, opts.is_module, opts.import_map)
   t_ev_l1 = time::mono_ns!
   opts.load_parse_ns = t_ev_l1 - t_ev_l0
   !eval_load.ok
      |
         eval_cleanup(eval_dir, eval_file, "", "")
         sys::exit(1)
   annotate::set_source_file("<eval>")
   annotate::set_target_triple(opts.triple)
   annotate::set_program_locs(eval_load.out_files,
     eval_load.out_lines, eval_load.out_cols)
   annotate::set_program_mods(eval_load.out_mods)
   eval_prog' = ast::Expr(Block, eval_load.exprs)
   eval_exports' = eval_load.exports
   eval_dyn_mods' = eval_load.dynamic_mods
   eval_dyn_paths' = eval_load.dynamic_paths
   eval_nat_libs' = eval_load.native_libs
   eval_nat_pkg' = eval_load.native_pkg_config
   eval_files' = eval_load.loaded_files
   opts.typed_ast && !opts.run_exec && !opts.ir_only && (opts.outpath == "")
      |
         eval_cleanup(eval_dir, eval_file, "", "")
         verify_typed_ast(eval_prog', opts.ast_dump || opts.ast_tree,
           opts.ast_tree)
   eval_run_default = !opts.ir_only && !opts.is_module && !opts.is_shared && opts.outpath == ""
   should_wrap = eval_run_default && ?eval_load.exprs == 1 && !line_has_decl(opts.eval_src) && !is_writer_line(opts.eval_src) && prog_is_non_unit_expr(eval_prog')
   should_wrap
      |
         wrapped_src = "#use io\nio::out(" + opts.eval_src + ")\n"
         write_file(eval_file, wrapped_src)
            |
               w_load = load_all(eval_file, "", <->, opts.import_map)
               w_load.ok
                  |
                     w_prog = ast::Expr(Block, w_load.exprs)
                     eval_prog' = w_prog
                     eval_exports' = w_load.exports
                     eval_dyn_mods' = w_load.dynamic_mods
                     eval_dyn_paths' = w_load.dynamic_paths
                     eval_nat_libs' = w_load.native_libs
                     eval_nat_pkg' = w_load.native_pkg_config
                     eval_files' = w_load.loaded_files
                     annotate::set_program_locs(w_load.out_files,
                       w_load.out_lines, w_load.out_cols)
                     annotate::set_program_mods(w_load.out_mods)
   eval_opts = opts
   eval_run_default | eval_opts.no_cache = <+>
   def_triple = get_default_target_triple(0)
   eval_triple = opts.triple != "" | opts.triple | def_triple
   eval_wasm = is_wasm_triple(eval_triple)
   mod_suf = opts.is_module | ".o" | ""
   sh_suf = opts.is_shared | ".so" | mod_suf
   eval_suffix = eval_wasm | ".wasm" | sh_suf
   fb_bin = opts.outpath != "" | opts.outpath | "eval" + eval_suffix
   out_bin = eval_run_default | eval_bin | fb_bin
   mod_stem = opts.is_module | "eval" | opts.outpath
   ll_stem_e = opts.outpath != "" | mod_stem | "eval"
   has_ll_e = ?ll_stem_e !< 3 && ll_stem_e(?ll_stem_e - 3..) == ".ll"
   fb_ll = has_ll_e | ll_stem_e | ll_stem_e + ".ll"
   out_ll = eval_run_default | eval_ll | fb_ll
   rm_ll = eval_run_default | eval_ll | ""
   rm_bin = eval_run_default | eval_bin | ""
   comp_e = compile_ast_to_binary(eval_prog', eval_exports', eval_opts,
     out_ll, out_bin, eval_dyn_mods', eval_dyn_paths',
     eval_nat_libs', eval_nat_pkg', eval_files')
   comp_e !| code =>
      eval_cleanup(eval_dir, eval_file, rm_ll, rm_bin)
      sys::exit(code)
   eval_run_default || opts.run_exec
      |
         run_args = ast::Names()
         is_abs_e = path::is_abs(out_bin) || out_bin(..2) == "./"
         exec_e = is_abs_e | out_bin | "./" + out_bin
         run_args += exec_e
         rres = run_cmd(run_args)
         eval_cleanup(eval_dir, eval_file, rm_ll, rm_bin)
         rres != 0
            |
               log::error $ "E5014: Compiled program exited with code " +
                 str::from_int(rres)
               sys::exit(1)
         sys::exit(0)
      |
         eval_cleanup(eval_dir, eval_file, "", "")
         sys::exit(0)

lsp_typecheck_doc: String => ()
lsp_typecheck_doc = path =>
   ast::cell_var_reset!
   eff_triple = get_default_target_triple(0)
   parser::set_target_triple(eff_triple)
   annotate::set_target_triple(eff_triple)
   res = load_all(path, "", <+>, "")
   res.ok
      |
         annotate::set_source_file(path)
         annotate::set_program_locs(res.out_files, res.out_lines, res.out_cols)
         annotate::set_program_mods(res.out_mods)
         prog = ast::Expr(Block, res.exprs)
         el_res = annotate::annotate_program(prog)
         el_res
            | succ =>
               lsp::record_typecheck_ok(succ.ctx, succ.prog)
            | errs =>
               lsp::record_typecheck_errs(path, errs)

run_driver: Int => ()
run_driver = ignored =>
   log::set_fd(1)
   log::set_timestamps(<->)
   init_compiler_paths!
   ast::cell_var_reset!
   opts = parse_and_dispatch_cli!
   eff_triple = opts.triple != "" | opts.triple | get_default_target_triple(0)
   opts.triple = eff_triple
   parser::set_target_triple(eff_triple)
   annotate::set_target_triple(eff_triple)

   opts.repl_mode
      |
         repl_run(opts)
         sys::exit(0)

   opts.eval_src != ""
      |
         run_eval(opts)
         sys::exit(0)

   opts.ast_dump && !opts.typed_ast
      |
         opts.target == ""
            |
               print $ format_version!
               log::error $ diag::E5007_no_input!
               print_usage(0)
               sys::exit(1)
         target_prefix_dump = opts.is_module | opts.module_name | ""
         dump_load = load_all(opts.target, target_prefix_dump, opts.is_module,
           opts.import_map)
         !dump_load.ok
            | sys::exit(1)
            |
               dump_prog = ast::Expr(Block, dump_load.exprs)
               dump_program_ast(dump_prog, opts.ast_tree)
               sys::exit(0)

   opts.target == ""
      |
         print $ format_version!
         log::error $ diag::E5007_no_input!
         print_usage(0)
         sys::exit(1)

   is_dir = dir_exists(opts.target)
   !is_dir && !file_exists(opts.target)
      |
         log::error $ "E5009: Path '" + opts.target + "' does not exist"
         sys::exit(1)

   !is_dir && !is_dva_file(opts.target)
      |
         log::error $ "E5010: Input file must have a '.dva' extension, got '" +
           opts.target + "'"
         sys::exit(1)

   raw_base = derive_base_name(opts.target)
   base_name = is_dir && (raw_base == "src" || raw_base == ".")
      |
         clean_tgt = strip_trailing_slash(opts.target)
         cand_path = raw_base == "." | clean_tgt | path_join(clean_tgt, "..")
         proj_name = basename(canonical_path(cand_path))
         proj_name != "" && proj_name != "/" | proj_name | raw_base
      | raw_base

   ?base_name > 0 && base_name(0) == '-
      |
         log::error $ "E5018: Output name '" + base_name +
           "' begins with '-'; rename the input."
         sys::exit(1)
   opts.is_module && opts.no_main && opts.module_name == "" | opts.module_name = base_name
   target_triple = opts.triple != "" | opts.triple |
      get_default_target_triple(0)
   is_wasm = is_wasm_triple(target_triple)
   bin_suffix = is_wasm | ".wasm" | (opts.is_shared | ".so" | (opts.is_module | ".o" | ""))
   output_bin = opts.outpath != "" | opts.outpath | base_name + bin_suffix
   !opts.ir_only && dir_exists(output_bin)
      |
         log::error $ "E5022: Output name '" + output_bin +
           "' collides with an existing directory; pass -o <name> to set output name."
         sys::exit(1)
   ll_stem = opts.outpath != "" | (opts.is_module && opts.ir_only | base_name | opts.outpath) | base_name
   has_ll_ext = ?ll_stem !< 3 && ll_stem(?ll_stem - 3..) == ".ll"
   output_ll = has_ll_ext | ll_stem | ll_stem + ".ll"
   ir_only = opts.ir_only
   target_prefix = opts.is_module && opts.no_main | opts.module_name | ""
   t_ld0 = time::mono_ns!
   load_result = load_all(opts.target, target_prefix, opts.is_module, opts.import_map)
   t_ld1 = time::mono_ns!
   opts.load_parse_ns = t_ld1 - t_ld0
   !load_result.ok
      | sys::exit(1)
      |
         annotate::set_source_file(opts.target)
         annotate::set_target_triple(opts.triple)
         annotate::set_program_locs(load_result.out_files,
           load_result.out_lines, load_result.out_cols)
         annotate::set_program_mods(load_result.out_mods)
         program = ast::Expr(Block, load_result.exprs)
         should_verify_only = opts.typed_ast &&
           !opts.run_exec && !opts.ir_only && (opts.outpath == "")
         should_verify_only
            |
               verify_typed_ast(program, opts.ast_dump || opts.ast_tree,
                 opts.ast_tree)
            |
               res = compile_ast_to_binary(program, load_result.exports, opts,
                 output_ll, output_bin, load_result.dynamic_mods,
                 load_result.dynamic_paths, load_result.native_libs,
                 load_result.native_pkg_config, load_result.loaded_files)
               res !| code => sys::exit(code)

   opts.run_exec
      |
         log::info $ "--- Running Executable ---"
         exec_bin = path::is_abs(output_bin) ||
           output_bin(..2) == "./"
           | output_bin
           | "./" + output_bin
         is_wasm_exec = is_wasm_triple(target_triple) ||
           path::ext(output_bin) == ".wasm"
         run_args = ast::Names()
         is_wasm_exec
            |
               run_args += "node"
               run_args += "--disable-wasm-trap-handler"
               run_args += "-e"
               run_args += "const fs=require('fs')," +
                 "b=fs.readFileSync(process.argv[1]);" +
                 "WebAssembly.instantiate(b).then(m=>{" +
                 "const e=m.instance.exports;" +
                 "if(e._start)e._start();" +
                 "else if(e.main)process.exit(e.main());});"
               run_args += output_bin
            |
               run_args += exec_bin
         rres = run_cmd(run_args)
         rres != 0
            |
               log::error $ "E5014: Compiled program exited with code " +
                 str::from_int(rres)
               sys::exit(1)

run_driver(0)
