// selfhost/show.dva — debug serialization of the AST (the canonical show
// format the differential parser harness compares byte-for-byte). Split out of
// parser.dva so the harness can build it independently of the parser.

#use "ast"
#use "str"
#use "tast"
#use "unify"

#foreign "c"
   write: (fd: Int, buf: Addr, count: Int) => Int

#private
   print: String => Int
   print = s =>
      b = {?s + 1}
      b += s
      b += 10
      write(1, &b, ?b)

#public

show_expr: ast::Expr => String
show_expr = e =>
   e
      [Int n] "Int(" + str::from_int(n) + ")"
      [Rune n] "Rune(" + str::from_int(n) + ")"
      [Float f] "Float(" + str::from_float(f) + ")"
      [Str s] "Str(\"" + s + "\")"
      [Var v] "Var(" + v + ")"
      [Bin t] "Bin(" + show_op(t.0) + " " + show_expr(t.1) +
         " " + show_expr(t.2) + ")"
      [Unary t] "Unary(" + show_unop(t.0) + " " + show_expr(t.1) + ")"
      [Variant t] "Variant(" + show_tag(t.tag_name) +
         (0 < ?t.args | " " | "") + show_exprs(t.args) + ")"
      [CycleJump t] "CycleJump(" + (t.is_break | "break" | "cont") + " " +
         str::from_int(t.level) + ")"
      [Fn t] "Fn(" + show_expr(t.body) + ")"
      [Copy e] "Copy(" + show_expr(e) + ")"
      [BuilderCreate e] "Builder(" + show_expr(e) + ")"
      [Assign t] "Assign(" + t.0 + " " + (t.2 | "+= " | (t.1 | ":= " | "= ")) +
         show_fwd_rhs(t.5) + ")"
      [Choice t] "Choice(" + show_expr(t.cond) + " " +
         show_branches(t.branches) + ")"
      [Block t] "Block(" + show_exprs(t.exprs) + ")"
      [Call t] "Call(" +
         (t.fn_name == "" | show_expr(t.fn_target) | t.fn_name) +
         show_exprs(t.args) + ")"
      [Range t] "Range(" + (t.has_lhs | show_expr(t.lhs) | "_") + ".." +
         (t.has_rhs | show_expr(t.rhs) | "_") + ")"
      [Cycle t] "Cycle(" + show_expr(t.iterable) + " " +
         show_expr(t.body_fn) + ")"
      [CycleEscape t] "CycleEscape(" + show_expr(t.cycle) + " " +
         show_expr(t.branch) + ")"
      [Member t] "Member(" + show_expr(t.target) + show_member_suffix(t) + ")"
      [KeyAccess t] "Key(" + show_expr(t.target) + "^" + show_expr(t.key) + ")"
      [TypeCast t] "Cast(" + show_expr(t.expr) + ")"
      [Record t] "Record(" + show_fields(t.fields) + ")"
      [MapLiteral t] show_map_pairs(t.pairs)
      [RawMemory t] "Raw(" + show_expr(t.addr) + ")"
      [SizeOf t] "Size(" + show_vt(t.val_type) + ")"
      [NamedArg t] "NamedArg(" + t.name + " " + show_expr(t.val) + ")"
      // CompileTime / Spawn / Join have no native dump case — they serialize
      // as "?" (the native dump_expr's default), so the differential harness
      // compares them as opaque.
      [Import t] "Import(" + t.module_name + ")"
      [Foreign t] "Foreign(" + t.dva_name + ")"
      [TypeDecl t] "TypeDecl(" + t.name + ")"
      [FastMathPragma v] "Fp(" + (v ["all"] "all" | "none") + ")"
      [SwizzlePragma v] "Swizzle(" + v + ")"
      [UserDiag ud] (ud.is_warn | "Warn(" | "Error(") + show_expr(ud.msg) + ")"
      | "?"

// An Assign's RHS: a FORWARD-ANNOTATION marker ("Var(\"<fwd>...\")") serializes
// as the literal "<fwd>", matching the native dump (rhs = nil).
show_fwd_rhs: ast::Expr => String
show_fwd_rhs = e =>
   e
      [Var v] show_fwd_name(v, e)
      | show_expr(e)

// "<fwd>" (or "<fwd>~fields") collapses to the literal "<fwd>"; anything else
// is the normal serialization.
show_fwd_name: String, ast::Expr => String
show_fwd_name = v, e =>
   ?v > 4
      |
         v(0..5) == "<fwd>"
            | "<fwd>"
            | show_expr(e)
      | show_expr(e)

show_vt: ast::ValueType => String
show_vt = v =>
   v
      [Unknown] "?"
      [Int] "Int"
      [Str] "String"
      [Float] "Float"
      [Ram] "Ram"
      [Record] "Record"
      | "vt"

show_branches: ast::Branches => String
show_branches = bs =>
   out = {16}
   ?bs @ i =>
      b = bs(i) | _ | ast::ChoiceBranch((
         ast::GuardKind(Bare), ast::Exprs(), ast::Expr(Var, "?"),
         ast::Names(), ast::Names(), <->, ast::Expr(Var, "?")))
      out += (i > 0 | " | " | "")
      out += show_branch(b)
   +out

// The member-access suffix: ".field" (or "::field"), or ".(index)" for an
// index member. Mirrors the native parser_harness dump.
show_member_suffix: ast::MemberExpr => String
show_member_suffix = t =>
   t.index_expr
      [Var v]
         v == ""
            |
               (t.is_module_access | "::" | ".") + t.field_name
            |
               "." + show_expr(t.index_expr)
      | "." + show_expr(t.index_expr)

show_branch: ast::ChoiceBranch => String
show_branch = b =>
   g = b.kind
      [Variant] show_var(b)
      [Predicate] "pred"
      [Case] show_val(b)
      [Bare] "[]"
      | "[]"
   g + ":" + show_expr(b.block)

show_var: ast::ChoiceBranch => String
show_var = b =>
   b.variant_names(0) | _ | ""

show_val: ast::ChoiceBranch => String
show_val = b =>
   ?b.case_values > 1
      | show_exprs(b.case_values)
      | show_single(b.case_values)

// A single case value: an array read returns a `< elem | Error >` ram that
// must be unwrapped (the multi-element path unwraps via show_exprs).
show_single: ast::Exprs => String
show_single = xs =>
   show_expr(xs(0) | _ | ast::Expr(Var, "?"))

show_map_pairs: ast::MapPairs => String
show_map_pairs = ps =>
   out = {16}
   out += "Map("
   ?ps @ i =>
      pr = ps(i) | _ | ast::MapPair((ast::Expr(Var, "?"), ast::Expr(Var, "?")))
      out += (show_expr(pr.key), "^=", show_expr(pr.value), " ")
   out += ")"
   +out

show_fields: ast::Fields => String
show_fields = fs =>
   out = {16}
   ?fs @ i =>
      f = fs(i) | _ | ast::RecordField((<->, "", ast::Expr(Var, "?")))
      out += (i > 0 | ", " | "")
      out += (f.has_name | f.name + "=" | "") + show_expr(f.val)
   +out

show_exprs: ast::Exprs => String
show_exprs = xs =>
   out = {16}
   ?xs @ i =>
      out += (i > 0 | " " | "")
      out += show_expr(xs(i) | _ | ast::Expr(Var, "?"))
   +out

show_tag: ast::Tag => String
show_tag = g =>
   g
      [Positive] "Positive"
      [Negative] "Negative"
      [Some] "Some"
      [Err] "Err"
      [Succ] "Succ"
      [Noth] "Noth"
      | "?"

show_op: ast::BinaryOp => String
show_op = o =>
   o
      [Add] "+"
      [Sub] "-"
      [Mul] "*"
      [Div] "/"
      [Mod] "%"
      [Gt] ">"
      [Lt] "<"
      [Eq] "=="
      [NotEq] "!="
      [NotLt] "!<"
      [NotGt] "!>"
      [And] "&&"
      [Or] "||"
      [Feed] "$>"
      [Bind] "$>>"
      [Apply] "$"
      [BitAnd] ".&."
      [BitOr] ".|."
      [Shl] ".<."
      [Shr] ".>."
      [Seq] ";"
      | "?"

show_unop: ast::UnaryOp => String
show_unop = o =>
   o
      [Not] "!"
      [BitNot] ".!."
      [Length] "?"
      [AddrOf] "&"
      [Freeze] "+"
      [Unwrap] "!!"
      [Propagate] "--!"
      [RuneCount] "??"
      | "?"

show_indent: Int => String
show_indent = n =>
   n == 0 | "" | "  " + show_indent(n - 1)

show_names: ast::Names => String
show_names = ns =>
   out = {16}
   ?ns @ i =>
      n = ns(i) | _ | ""
      out += (i > 0 | ", " | "") + n
   +out

show_tree_exprs: ast::Exprs, Int => String
show_tree_exprs = xs, ind =>
   out = {16}
   ?xs @ i =>
      x = xs(i) | _ | ast::Expr(Var, "?")
      out += (i > 0 | "\n" | "") + show_tree(x, ind)
   +out

show_tree_branches: ast::Branches, Int => String
show_tree_branches = bs, ind =>
   out = {16}
   pad = show_indent(ind)
   ?bs @ i =>
      b = bs(i) | _ | ast::ChoiceBranch((
         ast::GuardKind(Bare), ast::Exprs(), ast::Expr(Var, "?"),
         ast::Names(), ast::Names(), <->, ast::Expr(Var, "?")))
      g = b.kind
         [Variant] show_var(b)
         [Predicate] "pred"
         [Case] show_val(b)
         [Bare] "[]"
         | "[]"
      out += (i > 0 | "\n" | "")
      out += (pad + "[" + g + "]\n", show_tree(b.block, ind + 1))
   +out

show_tree: ast::Expr, Int => String
show_tree = e, ind =>
   pad = show_indent(ind)
   e
      [Assign t]
         op = t.2 | "+=" | (t.1 | ":=" | "=")
         pad + "Assign(" + t.0 + " " + op + ")\n" +
            show_tree(t.5, ind + 1)
      [Fn t]
         pad + "Fn(" + show_names(t.params) + " =>)\n" +
            show_tree(t.body, ind + 1)
      [Bin t]
         pad + "Bin(" + show_op(t.0) + ")\n" +
            show_tree(t.1, ind + 1) + "\n" +
            show_tree(t.2, ind + 1)
      [Unary t]
         pad + "Unary(" + show_unop(t.0) + ")\n" +
            show_tree(t.1, ind + 1)
      [Var v]
         pad + "Var(" + v + ")"
      [Int n]
         pad + "Int(" + str::from_int(n) + ")"
      [Float f]
         pad + "Float(" + str::from_float(f) + ")"
      [Str s]
         pad + "Str(\"" + s + "\")"
      [Call t]
         tgt = t.fn_name == "" | show_expr(t.fn_target) | t.fn_name
         ?t.args == 0
            | pad + "Call(" + tgt + ")"
            |
               pad + "Call(" + tgt + ")\n" +
                  show_tree_exprs(t.args, ind + 1)
      [Block t]
         pad + "Block\n" + show_tree_exprs(t.exprs, ind + 1)
      [Choice t]
         pad + "Choice\n" +
            pad + "  Cond:\n" + show_tree(t.cond, ind + 2) + "\n" +
            pad + "  Branches:\n" +
            show_tree_branches(t.branches, ind + 2)
      | pad + show_expr(e)

// --- Typed AST Serialization -----------------------------------------------

show_typed_target: unify::Ctx, <tast::TypedExpr|> => String
show_typed_target = ctx, tgt =>
   tgt
      | te => show_typed_expr(ctx, te)
      | "?"

show_typed_exprs: unify::Ctx, tast::TypedExprs => String
show_typed_exprs = ctx, xs =>
   out = {16}
   ?xs @ i =>
      x = xs(i) | _ | tast::mk_lit_unit(0, 0)
      out += (i > 0 | " " | "") + show_typed_expr(ctx, x)
   +out

show_typed_fields: unify::Ctx, tast::TypedFields => String
show_typed_fields = ctx, fs =>
   out = {16}
   ?fs @ i =>
      f = fs(i) | _ | tast::TypedField(("", tast::mk_lit_unit(0, 0), 0,
         unify::UType(None)))
      out += (i > 0 | ", " | "")
      out += f.name + "=" + show_typed_expr(ctx, f.val)
   +out

show_typed_expr: unify::Ctx, tast::TypedExpr => String
show_typed_expr = ctx, te =>
   ty_str = ": " + unify::show_utype(ctx, te.ut)
   te.kind
      [LitInt n] "LitInt(" + str::from_int(n) + ")" + ty_str
      [LitFloat f] "LitFloat(" + str::from_float(f) + ")" + ty_str
      [LitStr s] "LitStr(\"" + s + "\")" + ty_str
      [LitRune n] "LitRune(" + str::from_int(n) + ")" + ty_str
      [LitFlag v] "LitFlag(" + (v | "<+>" | "<->") + ")" + ty_str
      [LitUnit] "LitUnit" + ty_str
      [Var t] "Var(" + t.0 + ")" + ty_str
      [Bin t] "Bin(" + show_op(t.0) + " " + show_typed_expr(ctx, t.1) +
         " " + show_typed_expr(ctx, t.2) + ")" + ty_str
      [Unary t] "Unary(" + show_unop(t.0) + " " +
         show_typed_expr(ctx, t.1) + ")" + ty_str
      [Call t]
         tgt = t.0 != "" | t.0 | show_typed_target(ctx, t.1)
         "Call(" + tgt + (0 < ?t.2 | " " | "") +
            show_typed_exprs(ctx, t.2) + ")" + ty_str
      [Record fs] "Record(" + show_typed_fields(ctx, fs) + ")" + ty_str
      [Member t] "Member(" + show_typed_expr(ctx, t.0) + "." + t.1 + ")" +
         ty_str
      [MemberWrite t] "MemberWrite(" + show_typed_expr(ctx, t.0) + "." +
         t.1 + " = " + show_typed_expr(ctx, t.3) + ")" + ty_str
      [Index t] "Index(" + show_typed_expr(ctx, t.0) + "(" +
         show_typed_expr(ctx, t.1) + "))" + ty_str
      [IndexWrite t] "IndexWrite(" + show_typed_expr(ctx, t.0) + "(" +
         show_typed_expr(ctx, t.1) + ") = " +
         show_typed_expr(ctx, t.2) + ")" + ty_str
      [Choice t] "Choice(" + show_typed_expr(ctx, t.0) + ")" + ty_str
      [Lambda t] "Lambda(" + show_names(t.0) + " => " +
         show_typed_expr(ctx, t.1) + ")" + ty_str
      [Block es] "Block(" + show_typed_exprs(ctx, es) + ")" + ty_str
      [Assign t] "Assign(" + t.0 + " " + (t.1 | ":= " | "= ") +
         show_typed_expr(ctx, t.5) + ")" + ty_str
      [Cycle t] "Cycle(" + show_typed_expr(ctx, t.0) + " " +
         show_typed_expr(ctx, t.1) + ")" + ty_str
      [CycleJump t] "CycleJump(" + (t.0 | "break" | "cont") + " " +
         str::from_int(t.1) + ")" + ty_str
      [RamConstruct t] "Ram(" + unify::show_ram_shape(t.0) + ")" + ty_str
      [EnumConstruct t] "Enum(" + t.0 + ")" + ty_str
      [BuilderNew e] "BuilderNew(" + show_typed_expr(ctx, e) + ")" + ty_str
      [Copy e] "Copy(" + show_typed_expr(ctx, e) + ")" + ty_str
      [RawMemory t] "Raw(" + show_typed_expr(ctx, t.0) + ")" + ty_str
      [PoisonError t] "PoisonError(" + str::from_int(t.0) + ", \"" +
         t.1 + "\")" + ty_str
      | "?" + ty_str

show_typed_tree_exprs: unify::Ctx, tast::TypedExprs, Int => String
show_typed_tree_exprs = ctx, xs, ind =>
   out = {16}
   ?xs @ i =>
      x = xs(i) | _ | tast::mk_lit_unit(0, 0)
      out += (i > 0 | "\n" | "") + show_typed_tree(ctx, x, ind)
   +out

show_typed_tree_branches: unify::Ctx, tast::TypedBranches, Int => String
show_typed_tree_branches = ctx, bs, ind =>
   out = {16}
   pad = show_indent(ind)
   ?bs @ i =>
      b = bs(i) | _ | tast::TypedBranch((ast::GuardKind(Bare),
         tast::TypedExprs(), <-->, ast::Names(), ast::Names(),
         tast::mk_lit_unit(0, 0)))
      g = b.kind
         [Variant] (b.variant_names(0) | _ | "")
         [Predicate] "pred"
         [Case] (0 < ?b.case_values | show_typed_exprs(ctx, b.case_values) | "")
         [Bare] "[]"
         | "[]"
      out += (i > 0 | "\n" | "")
      out += (pad + "[" + g + "]\n", show_typed_tree(ctx, b.body, ind + 1))
   +out

show_typed_tree: unify::Ctx, tast::TypedExpr, Int => String
show_typed_tree = ctx, te, ind =>
   pad = show_indent(ind)
   info = ": " + unify::show_utype(ctx, te.ut) + " [" +
      str::from_int(te.layout.size) + "B]"
   te.kind
      [Assign t]
         op = t.1 | ":=" | "="
         pad + "Assign(" + t.0 + " " + op + ")" + info + "\n" +
            show_typed_tree(ctx, t.5, ind + 1)
      [Lambda t]
         pad + "Lambda(" + show_names(t.0) + " =>)" + info + "\n" +
            show_typed_tree(ctx, t.1, ind + 1)
      [Bin t]
         pad + "Bin(" + show_op(t.0) + ")" + info + "\n" +
            show_typed_tree(ctx, t.1, ind + 1) + "\n" +
            show_typed_tree(ctx, t.2, ind + 1)
      [Unary t]
         pad + "Unary(" + show_unop(t.0) + ")" + info + "\n" +
            show_typed_tree(ctx, t.1, ind + 1)
      [Var t]
         pad + "Var(" + t.0 + ")" + info
      [LitInt n]
         pad + "LitInt(" + str::from_int(n) + ")" + info
      [LitFloat f]
         pad + "LitFloat(" + str::from_float(f) + ")" + info
      [LitStr s]
         pad + "LitStr(\"" + s + "\")" + info
      [LitRune n]
         pad + "LitRune(" + str::from_int(n) + ")" + info
      [LitFlag v]
         pad + "LitFlag(" + (v | "<+>" | "<->") + ")" + info
      [LitUnit]
         pad + "LitUnit" + info
      [Call t]
         tgt = t.0 != "" | t.0 | show_typed_target(ctx, t.1)
         ?t.2 == 0
            | pad + "Call(" + tgt + ")" + info
            |
               pad + "Call(" + tgt + ")" + info + "\n" +
                  show_typed_tree_exprs(ctx, t.2, ind + 1)
      [Block es]
         pad + "Block" + info + "\n" +
            show_typed_tree_exprs(ctx, es, ind + 1)
      [Choice t]
         pad + "Choice" + info + "\n" +
            pad + "  Cond:\n" + show_typed_tree(ctx, t.0, ind + 2) + "\n" +
            pad + "  Branches:\n" +
            show_typed_tree_branches(ctx, t.1, ind + 2)
      [Member t]
         pad + "Member(." + t.1 + ")" + info + "\n" +
            show_typed_tree(ctx, t.0, ind + 1)
      [MemberWrite t]
         pad + "MemberWrite(." + t.1 + ")" + info + "\n" +
            show_typed_tree(ctx, t.0, ind + 1) + "\n" +
            show_typed_tree(ctx, t.3, ind + 1)
      [Index t]
         pad + "Index" + info + "\n" +
            show_typed_tree(ctx, t.0, ind + 1) + "\n" +
            show_typed_tree(ctx, t.1, ind + 1)
      [IndexWrite t]
         pad + "IndexWrite" + info + "\n" +
            show_typed_tree(ctx, t.0, ind + 1) + "\n" +
            show_typed_tree(ctx, t.1, ind + 1) + "\n" +
            show_typed_tree(ctx, t.2, ind + 1)
      [Cycle t]
         pad + "Cycle" + info + "\n" +
            show_typed_tree(ctx, t.0, ind + 1) + "\n" +
            show_typed_tree(ctx, t.1, ind + 1)
      [CycleJump t]
         pad + "CycleJump(" + (t.0 | "break" | "cont") + " " +
            str::from_int(t.1) + ")" + info
      [Copy e]
         pad + "Copy" + info + "\n" +
            show_typed_tree(ctx, e, ind + 1)
      [BuilderNew e]
         pad + "BuilderNew" + info + "\n" +
            show_typed_tree(ctx, e, ind + 1)
      [RawMemory t]
         pad + "RawMemory" + info + "\n" +
            show_typed_tree(ctx, t.0, ind + 1)
      | pad + show_typed_expr(ctx, te)

show_typed_stmt: unify::Ctx, tast::TypedStmt => String
show_typed_stmt = ctx, stmt =>
   stmt
      [Expr te] show_typed_expr(ctx, te)
      [Binding b]
         b.0 + " = " + show_typed_expr(ctx, b.2)
      [GlobalBinding b]
         b.0 + " ::= " + show_typed_expr(ctx, b.2)
      [TypeDecl t]
         "type " + t.0
      | ""

show_typed_tree_stmt: unify::Ctx, tast::TypedStmt, Int => String
show_typed_tree_stmt = ctx, stmt, ind =>
   pad = show_indent(ind)
   stmt
      [Expr te] show_typed_tree(ctx, te, ind)
      [Binding b]
         pad + "Binding(" + b.0 + ")\n" + show_typed_tree(ctx, b.2, ind + 1)
      [GlobalBinding b]
         pad + "GlobalBinding(" + b.0 + ")\n" +
            show_typed_tree(ctx, b.2, ind + 1)
      [TypeDecl t]
         pad + "TypeDecl(" + t.0 + ")"
      | ""

dump_typed_program: unify::Ctx, tast::TypedProgram, <> => ()
dump_typed_program = ctx, prog, as_tree =>
   ?prog.stmts @ i =>
      st = prog.stmts(i) | _ | tast::TypedStmt(Expr, tast::mk_lit_unit(0, 0))
      as_tree
         | print $ show_typed_tree_stmt(ctx, st, 0)
         | print $ show_typed_stmt(ctx, st)