// selfhost/src/annotate.dva — AST type annotation and elaboration pass.
//
// Walks an untyped ast::Expr, generates type variables and constraints,
// solves them via the unify engine, enforces groundness (no defaulting to Int),
// and produces a verified tast::TypedExpr. Part of Milestone 2 (Phase 2).

#use "ast"
#use "unify"
#use "tast"
#use "type_env"
#use "layout"
#use "dep_graph"
#use "str"

#foreign "c"
   write: (fd: Int, buf: Addr, count: Int) => Int

#private
print: String => Int
print = s =>
   b = {?s + 1}
   b += s
   b += 10
   write(1, &b, ?b)

name_is_primed: String => <>
name_is_primed = name => ?name > 0 && name(-1..) == "'"

// --- Member Root Helper ----------------------------------------------------

member_root_str: ast::Expr => String
member_root_str = e =>
   e
      [Var name] name
      [Member m]
         sub = member_root_str(m.target)
         sub != "" | sub + "." + m.field_name | ""
      | ""

member_root_name: ast::Expr => String
member_root_name = e =>
   e
      [Var v] v
      [Member m] member_root_name(m.target)
      | ""

member_has_module_access: ast::Expr => <>
member_has_module_access = e =>
   e
      [Member m] m.is_module_access || member_has_module_access(m.target)
      | <->

module_qualified_name: ast::Expr, String => String
module_qualified_name = e, field =>
   e
      [Var name] name + "::" + field
      [Member m]
         sub = module_qualified_name(
            m.target, m.field_name)
         sub != "" | sub + "::" + field | ""
      | ""

resolve_module_access: unify::Ctx, type_env::TypeEnv,
   String, Int, Int => tast::TypedExpr
resolve_module_access = ctx, env, qn, line, col =>
   bnd = type_env::lookup_binding(env, qn)
   bnd
      |
         b = _
         ti = unify::type_info_from_utype(ctx, b.ut)
         lay = layout::compute_layout(ctx, b.ut)
         tast::mk_typed_var(qn, b.depth,
            b.is_mut, b.ut, ti, lay, line, col)
      |
         gen = type_env::lookup_generic(env, qn)
         gen
            | gen_ti =>
               gut = instantiate_generic_ti(
                  ctx, gen_ti)
               gti = unify::type_info_from_utype(
                  ctx, gut)
               glay = layout::compute_layout(
                  ctx, gut)
               tast::mk_typed_var(qn, 0, <->,
                  gut, gti, glay, line, col)
            |
               ut_opt = type_env::lookup_user_type(
                  env, qn)
               ut_opt
                  | udef =>
                     ulay = layout::compute_layout(
                        ctx, udef.ut)
                     tast::mk_typed_var(qn, 0, <->,
                        udef.ut, udef.ti, ulay,
                        line, col)
                  |
                     emsg = "Undefined identifier: " + qn
                     unify::add_error(ctx, 3004, emsg)
                     e_ut = unify::fresh_var(ctx)
                     e_ti = ast::TypeInfo(Prim,
                        ast::ValueType(Unknown))
                     e_lay = tast::layout_scalar(8, 8)
                     tast::mk_typed_var(qn, 0, <->,
                        e_ut, e_ti, e_lay,
                        line, col)

is_fwd_assign: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
   String, ast::TypeInfo) => <>
is_fwd_assign = a =>
   a.5 [Var v] (v == "<fwd>") | <->

is_generic_sig: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
   String, ast::TypeInfo) => <>
is_generic_sig = a =>
   is_ct = ?a.7 > 4 && a.7(0..4) == "@ct0"
   is_ti = a.8 [Fn f] (?f.4 > 0) | <->
   is_ct || is_ti

mk_lambda_te: ast::Names, tast::TypedExpr, unify::UType,
   ast::TypeInfo => tast::TypedExpr
mk_lambda_te = params, body_te, fn_ut, ti =>
   lay = tast::layout_closure()
   tast::mk_typed_expr(
      tast::TypedExprKind(Lambda, (params, body_te, tast::TypedCaptures())),
      fn_ut, ti, lay, 0, 0)

type_name_to_uprim: String => < unify::UPrim | >
type_name_to_uprim = name =>
   name
      ["Int", "i64"] <+ unify::UPrim(Int) ->
      ["i8"] <+ unify::UPrim(I8) ->
      ["i16"] <+ unify::UPrim(I16) ->
      ["i32"] <+ unify::UPrim(I32) ->
      ["u8"] <+ unify::UPrim(U8) ->
      ["u16"] <+ unify::UPrim(U16) ->
      ["u32"] <+ unify::UPrim(U32) ->
      ["u64"] <+ unify::UPrim(U64) ->
      ["i1", "<>"] <+ unify::UPrim(Flag) ->
      ["Rune"] <+ unify::UPrim(Rune) ->
      ["Float", "f64"] <+ unify::UPrim(Float) ->
      ["f32"] <+ unify::UPrim(F32) ->
      ["String"] <+ unify::UPrim(Str) ->
      ["void"] <+ unify::UPrim(Unit) ->
      ["Addr", "ptr"] <+ unify::UPrim(RawPtr) ->
      ["Builder"] <+ unify::UPrim(Builder) ->
      ["Error"] <+ unify::UPrim(Error) ->
      ["Type"] <+ unify::UPrim(Type) ->

#type TypeVarMapEntry (name: String, ut: unify::UType)
#type TypeVarMap (TypeVarMapEntry){}

tv_lookup: TypeVarMap, String => < unify::UType | >
tv_lookup = tvm, name =>
   res' = <-->
   ?tvm @ i =>
      e = tvm(i) | _ | TypeVarMapEntry(("", unify::UType(None)))
      e.name == name | (res' = <+ e.ut ->; -->)
   res'

tv_get_or_create: unify::Ctx, TypeVarMap, String => (TypeVarMap, unify::UType)
tv_get_or_create = ctx, tvm, name =>
   existing = tv_lookup(tvm, name)
   existing
      | ut => (tvm, ut)
      |
         fresh = unify::fresh_var(ctx)
         new_tvm = tvm
         new_tvm += TypeVarMapEntry((name, fresh))
         (new_tvm, fresh)

#type TiInstRes (tvm: TypeVarMap, ut: unify::UType)

instantiate_ti_step: unify::Ctx, TypeVarMap, ast::TypeInfo => TiInstRes
instantiate_ti_step = ctx, tvm, ti =>
   ti
      [Prim vt]
         TiInstRes((tvm, unify::UType(Prim, unify::vt_to_uprim(vt))))
      [TypeVar name]
         cast_opt = type_name_to_uprim(name)
         cast_opt
            | uprim => TiInstRes((tvm, unify::UType(Prim, uprim)))
            |
               res = tv_get_or_create(ctx, tvm, name)
               TiInstRes(res)
      [Fn f]
         cur_tvm' = tvm
         vinfos = f.1
         params = unify::UTypes()
         ?f.4 @ cp_i =>
            cp = f.4(cp_i) | _ | ast::CompileTimeParam(("",
               ast::ValueType(Unknown),
               ast::TypeInfo(Prim, ast::ValueType(Unknown))))
            cp.1 != ast::ValueType(Type)
               |
                  cp_res = instantiate_ti_step(ctx, cur_tvm', cp.2)
                  cur_tvm' = cp_res.tvm
                  params += cp_res.ut
         ?vinfos @ i =>
            pi = vinfos(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
            p_res = instantiate_ti_step(ctx, cur_tvm', pi)
            cur_tvm' = p_res.tvm
            params += p_res.ut
         ret_res = instantiate_ti_step(ctx, cur_tvm', f.3)
         cur_tvm' = ret_res.tvm
         TiInstRes((cur_tvm', unify::UType(Fn,
            unify::UFn((params, ret_res.ut)))))
      [Ram r]
         s0 = r.0
         s1 = r.1
         (!s0.has_payload && !s1.has_payload)
            | TiInstRes((tvm, unify::UType(Prim, unify::UPrim(Flag))))
            |
               cur_tvm2' = tvm
               p_ut' = unify::UType(None)
               s0.has_payload
                  |
                     res0 = instantiate_ti_step(ctx, cur_tvm2',
                        s0.payload_record)
                     cur_tvm2' = res0.tvm
                     p_ut' = res0.ut
               n_ut' = unify::UType(None)
               s1.has_payload
                  |
                     res1 = instantiate_ti_step(ctx, cur_tvm2',
                        s1.payload_record)
                     cur_tvm2' = res1.tvm
                     n_ut' = res1.ut
               slot0 = unify::URamSlot((s0.has_payload, p_ut'))
               slot1 = unify::URamSlot((s1.has_payload, n_ut'))
               TiInstRes((cur_tvm2', unify::UType(Ram,
                  unify::URam((slot0, slot1)))))
      [Rec r]
         r.1
            |
               fts = r.0
               n_fts = ?fts
               cur_tvm3' = tvm
               elem_ut' = unify::UType(None)
               n_fts > 0
                  |
                     f0 = fts(0) | _ | ast::RecordFieldType(("",
                        ast::ValueType(Unknown),
                        ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                        <->, ast::Expr(Int, 0)))
                     res0 = instantiate_ti_step(ctx, cur_tvm3', f0.rec_type)
                     cur_tvm3' = res0.tvm
                     elem_ut' = res0.ut
                  | elem_ut' = unify::UType(Prim, unify::vt_to_uprim(r.3))
               TiInstRes((cur_tvm3', unify::UType(Slice, elem_ut')))
            |
               fts = r.0
               cur_tvm4' = tvm
               flds = unify::UFields()
               ?fts @ i =>
                  ft = fts(i) | _ | ast::RecordFieldType(("",
                     ast::ValueType(Unknown),
                     ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                     <->, ast::Expr(Int, 0)))
                  res_i = instantiate_ti_step(ctx, cur_tvm4', ft.rec_type)
                  cur_tvm4' = res_i.tvm
                  flds += unify::UField((ft.name, res_i.ut))
               TiInstRes((cur_tvm4', unify::UType(Rec, flds)))
      [Bitfield b]
         flds = unify::UFields()
         ?b.fields @ i =>
            bf = b.fields(i) | _ | ast::BitfieldField(("", 0, 0))
            flds += unify::UField((bf.name, unify::UType(Prim,
               unify::vt_to_uprim(b.backing_type))))
         TiInstRes((tvm, unify::UType(Rec, flds)))
      [Array a]
         res_a = instantiate_ti_step(ctx, tvm, a.1)
         TiInstRes((res_a.tvm, unify::UType(Array,
            unify::UArray((res_a.ut, a.2)))))
      [Map m]
         k_ut = unify::UType(Prim, unify::vt_to_uprim(m.0))
         res_v = instantiate_ti_step(ctx, tvm, m.2)
         v_val = res_v.ut
         v_ut = v_val [None] unify::UType(Prim, unify::vt_to_uprim(m.1)) | v_val
         TiInstRes((res_v.tvm, unify::UType(Map, unify::UMap((k_ut, v_ut)))))
      |
         TiInstRes((tvm, unify::utype_from_type_info(ti)))

#type VarInstMapEntry (old_id: Int, new_ut: unify::UType)
#type VarInstMap (VarInstMapEntry){}
#type VarInstRes (vim: VarInstMap, ut: unify::UType)

vim_lookup: VarInstMap, Int => < unify::UType | >
vim_lookup = vim, id =>
   res' = <-->
   ?vim @ i =>
      e = vim(i) | _ | VarInstMapEntry((-1, unify::UType(None)))
      e.old_id == id | (res' = <+ e.new_ut ->; -->)
   res'

instantiate_unbound_step: unify::Ctx, VarInstMap, unify::UType => VarInstRes
instantiate_unbound_step = ctx, vim, ut =>
   c = unify::canon(ctx, ut)
   c
      [Var id]
         existing = vim_lookup(vim, id)
         existing
            | ex => VarInstRes((vim, ex))
            |
               fresh = unify::fresh_var(ctx)
               new_vim = vim
               new_vim += VarInstMapEntry((id, fresh))
               VarInstRes((new_vim, fresh))
      [Fn f]
         cur_vim' = vim
         new_params = unify::UTypes()
         ?f.params @ i =>
            p = f.params(i) | _ | unify::UType(None)
            p_res = instantiate_unbound_step(ctx, cur_vim', p)
            cur_vim' = p_res.vim
            new_params += p_res.ut
         ret_res = instantiate_unbound_step(ctx, cur_vim', f.ret)
         cur_vim' = ret_res.vim
         fn_ut = unify::UType(Fn, unify::UFn((new_params, ret_res.ut)))
         VarInstRes((cur_vim', fn_ut))
      | VarInstRes((vim, c))

instantiate_unbound_fn: unify::Ctx, unify::UType => unify::UType
instantiate_unbound_fn = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Fn _]
         res = instantiate_unbound_step(ctx, VarInstMap(), c)
         res.ut
      | ut

instantiate_generic_ti: unify::Ctx, ast::TypeInfo => unify::UType
instantiate_generic_ti = ctx, ti =>
   res = instantiate_ti_step(ctx, TypeVarMap(), ti)
   res.ut

utype_from_ti_env: type_env::TypeEnv, ast::TypeInfo => unify::UType
utype_from_ti_env = env, ti =>
   ti
      [TypeVar tv]
         cast_opt = type_name_to_uprim(tv)
         cast_opt
            | uprim => unify::UType(Prim, uprim)
            |
               ut_opt = type_env::lookup_user_type(env, tv)
               ut_opt
                  | udef => udef.ut
                  | unify::UType(None)
      [Ram r]
         s0 = r.0
         s1 = r.1
         (!s0.has_payload && !s1.has_payload)
            | unify::prim_flag()
            |
               p_ut = s0.has_payload
                  | utype_from_ti_env(env, s0.payload_record)
                  | unify::UType(None)
               n_ut = s1.has_payload
                  | utype_from_ti_env(env, s1.payload_record)
                  | unify::UType(None)
               slot0 = unify::URamSlot((s0.has_payload, p_ut))
               slot1 = unify::URamSlot((s1.has_payload, n_ut))
               unify::UType(Ram, unify::URam((slot0, slot1)))
      [Fn f]
         vinfos = f.1
         params = unify::UTypes()
         ?vinfos @ i =>
            pi = vinfos(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
            params += utype_from_ti_env(env, pi)
         ret = utype_from_ti_env(env, f.3)
         unify::UType(Fn, unify::UFn((params, ret)))
      [Rec r]
         r.1
            |
               fts = r.0
               n_fts = ?fts
               elem_ut' = unify::UType(None)
               n_fts > 0
                  |
                     f0 = fts(0) | _ | ast::RecordFieldType(("",
                        ast::ValueType(Unknown),
                        ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                        <->, ast::Expr(Int, 0)))
                     elem_ut' = utype_from_ti_env(env, f0.rec_type)
                  |
                     elem_ut' = unify::UType(Prim,
                        unify::vt_to_uprim(r.3))
               unify::UType(Slice, elem_ut')
            |
               fts = r.0
               flds = unify::UFields()
               ?fts @ i =>
                  ft = fts(i) | _ | ast::RecordFieldType(("",
                     ast::ValueType(Unknown),
                     ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                     <->, ast::Expr(Int, 0)))
                  flds += unify::UField((ft.name,
                     utype_from_ti_env(env, ft.rec_type)))
               unify::UType(Rec, flds)
      [Bitfield b]
         flds = unify::UFields()
         ?b.fields @ i =>
            bf = b.fields(i) | _ | ast::BitfieldField(("", 0, 0))
            flds += unify::UField((bf.name,
               unify::UType(Prim, unify::vt_to_uprim(b.backing_type))))
         unify::UType(Rec, flds)
      [Array a]
         unify::UType(Array, unify::UArray((utype_from_ti_env(env, a.1), a.2)))
      [Enum slots]
         vars = unify::UEnumVariants()
         ?slots @ i =>
            sl = slots(i) | _ | ast::EnumSlotInfo(("", <->,
               ast::ValueType(Unknown),
               ast::TypeInfo(Prim, ast::ValueType(Unknown))))
            p_ut = sl.has_payload
               | utype_from_ti_env(env, sl.payload_record)
               | unify::UType(None)
            vars += unify::UEnumVariant((sl.label, sl.has_payload, p_ut))
         unify::UType(Enum, unify::UEnum(("", vars)))
      [Map m]
         k_ut = unify::UType(Prim, unify::vt_to_uprim(m.0))
         v_val = utype_from_ti_env(env, m.2)
         v_ut = v_val [None] unify::UType(Prim, unify::vt_to_uprim(m.1)) | v_val
         unify::UType(Map, unify::UMap((k_ut, v_ut)))
      | unify::utype_from_type_info(ti)

is_bitfield_ti_env: type_env::TypeEnv, ast::TypeInfo => <>
is_bitfield_ti_env = env, ti =>
   ti
      [Bitfield _] <+>
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt | u => u.ti [Bitfield _] | <->
      | <->

is_growable_ti_env: type_env::TypeEnv, ast::TypeInfo => <>
is_growable_ti_env = env, ti =>
   ti
      [Array _] <+>
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt | u => is_growable_ti_env(env, u.ti) | <->
      | <->

mark_bitfield_fields_whole: type_env::TypeEnv, String, ast::TypeInfo => ()
mark_bitfield_fields_whole = env, prefix, ti =>
   eff_ti = ti
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt | u => u.ti | ti
      | ti
   eff_ti
      [Rec r]
         ?r.0 @ i =>
            fld = r.0(i) | _ | ast::RecordFieldType(("",
               ast::ValueType(Unknown),
               ast::TypeInfo(Prim, ast::ValueType(Unknown)),
               <->, ast::Expr(Int, 0)))
            fld.name != ""
               |
                  sub_path = prefix + "." + fld.name
                  is_sub_bf = is_bitfield_ti_env(env, fld.rec_type)
                  is_sub_bf
                     | type_env::init_mark_whole(env, sub_path)
                     | mark_bitfield_fields_whole(env, sub_path, fld.rec_type)
annotate_struct_size_packed: type_env::TypeEnv, ast::FieldTypes, Int, Int,
   Int => Int
annotate_struct_size_packed = env, fields, i, n, acc =>
   i == n
      | acc
      |
         f = fields(i) | _ | ast::RecordFieldType(("", ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->, ast::Expr(Int, 0)))
         fsz = annotate_type_size(env, f.val_type, f.rec_type)
         annotate_struct_size_packed(env, fields, i + 1, n, acc + fsz)

annotate_type_size: type_env::TypeEnv, ast::ValueType, ast::TypeInfo => Int
annotate_type_size = env, vt, ti =>
   eff_ti = ti
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt | u => u.ti | ti
      | ti
   eff_ti
      [Bitfield b] b.total_bits / 8
      [Rec r]
         r.5
            | annotate_struct_size_packed(env, r.0, 0, ?r.0, 0)
            |
               sz = annotate_struct_size_packed(env, r.0, 0, ?r.0, 0)
               sz < 16 | 16 | sz
      |
         vt
            [I8, U8, Flag] 1
            [I16, U16] 2
            [I32, U32, F32] 4
            | 8

is_integerish_ut: unify::Ctx, unify::UType => <>
is_integerish_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Int, Rune, I8, I16, I32, I64, U8, U16, U32, U64]) | <->

is_int_or_ptr_ut: unify::Ctx, unify::UType => <>
is_int_or_ptr_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Int, Rune, I8, I16, I32, I64,
      U8, U16, U32, U64, Addr, RawPtr]) | <->

is_ptr_ut: unify::Ctx, unify::UType => <>
is_ptr_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Addr, RawPtr]) | <->

is_builder_ut: unify::Ctx, unify::UType => <>
is_builder_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Builder]) | <->

is_str_ut: unify::Ctx, unify::UType => <>
is_str_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Str]) | <->

is_reserved_type_name: String => <>
is_reserved_type_name = name =>
   name ["Int", "i64", "i8", "i16", "i32", "u8", "u16", "u32", "u64",
      "i1", "<>", "Rune", "Float", "f64", "f32", "String", "void",
      "Addr", "ptr", "Builder", "Error", "Type"]

is_ufields_homogeneous: unify::Ctx, unify::UFields => <>
is_ufields_homogeneous = ctx, flds =>
   n = ?flds
   n < 2
      | <+>
      |
         f0 = flds(0) | _ | unify::UField(("", unify::UType(None)))
         homo' = <+>
         n @ i =>
            i > 0
               |
                  fi = flds(i) | _ | unify::UField(("", unify::UType(None)))
                  !unify::unify(ctx, f0.ut, fi.ut)
                     | (homo' = <->; -->)
         homo'

check_swizzle_pattern: unify::Ctx, String, unify::UFields, String => Int
check_swizzle_pattern = ctx, mode, flds, fname =>
   mode == "none"
      | 0
      |
         flen = ?fname
         flen < 1 || flen > 4
            | 0
            |
               !is_ufields_homogeneous(ctx, flds) || ?flds == 0
                  | 0
                  |
                     has_xyzw' = <->
                     has_rgba' = <->
                     all_match' = <+>
                     oob' = <->
                     bad_ch' = ++""
                     nf = ?flds
                     flen @ i =>
                        ch = fname(i)
                        ch_str = fname(i..i + 1)
                        f_idx = unify::find_field_idx(flds, ch_str)
                        f_idx !< 0
                           |
                              f_idx !< nf
                                 | (oob' = <+>; bad_ch' = ++ch_str)
                                 | 0
                           |
                              is_xyzw = ch == 'x' || ch == 'y' || ch == 'z' || ch == 'w'
                              is_rgba = ch == 'r' || ch == 'g' || ch == 'b' || ch == 'a'
                              allowed = mode == "all" | (is_xyzw || is_rgba) |
                                 (mode == "xyzw" | is_xyzw | (mode == "rgba" | is_rgba | <->))
                              !allowed
                                 | (all_match' = <->; -->)
                                 |
                                    is_xyzw | (has_xyzw' = <+>) | 0
                                    is_rgba | (has_rgba' = <+>) | 0
                                    p_idx = ch == 'x' || ch == 'r' | 0 |
                                       (ch == 'y' || ch == 'g' | 1 |
                                       (ch == 'z' || ch == 'b' | 2 | 3))
                                    p_idx !< nf
                                       | (oob' = <+>; bad_ch' = ++ch_str)
                                       | 0
                     !all_match'
                        | 0
                        |
                           mode == "all" && has_xyzw' && has_rgba'
                              |
                                 unify::add_error(ctx, 3043,
                                    "Cannot mix 'xyzw' and 'rgba' swizzle components in '" +
                                    fname + "'")
                                 2
                              |
                                 oob'
                                    |
                                       unify::add_error(ctx, 3043,
                                          "Swizzle component '" + bad_ch' +
                                          "' out of bounds for " +
                                          str::from_int(nf) + "-element vector")
                                       2
                                    | 1

view_vars = ast::Names()
declared_fns = ast::Names()
called_fns = ast::Names()
user_fns = ast::Names()
value_used_fns = ast::Names()
fn_alias_vars = ast::Names()
fn_alias_tgts = ast::Names()

has_name_in: ast::Names, String => <>
has_name_in = names, name =>
   found' = <->
   ?names @ i =>
      n = names(i) | _ | ""
      n == name | (found' = <+>; -->)
   found'

is_view_name: String => <>
is_view_name = name =>
   has_name_in(view_vars, name)

add_view_name: String => ()
add_view_name = name =>
   !is_view_name(name)
      | (view_vars += name)

is_view_expr: ast::Expr => <>
is_view_expr = e =>
   e
      [Var v] is_view_name(v)
      [RawMemory rm] rm.rec_name != ""
      [Block b]
         n = ?b.exprs
         n > 0 | is_view_expr(b.exprs(n - 1) | _ | ast::Expr(Int, 0)) | <->
      [Choice c]
         has' = <->
         ?c.branches @ bi =>
            br = c.branches(bi) | _ | ast::ChoiceBranch((ast::GuardKind(Bare),
               ast::Exprs(), ast::Expr(Int, 0), ast::Names(), ast::Names(), <->,
               ast::Expr(Int, 0)))
            is_view_expr(br.block) | (has' = <+>; -->)
         has'
      | <->

is_builder_append_prim: unify::UPrim => <>
is_builder_append_prim = p =>
   p [Int, Rune, Str, I8, I16, I32, I64, U8, U16, U32, U64]

is_builder_append_rec: unify::Ctx, unify::UFields, Int, Int => <>
is_builder_append_rec = ctx, fields, i, n =>
   i == n
      | <+>
      |
         fld = fields(i) | _ | unify::UField(("", unify::UType(None)))
         c_fld = unify::canon(ctx, fld.ut)
         ok = c_fld [Prim pr] is_builder_append_prim(pr) | (c_fld [Var _])
         ok
            | is_builder_append_rec(ctx, fields, i + 1, n)
            | <->

is_rune_ut: unify::Ctx, unify::UType => <>
is_rune_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Rune]) | <->

is_float_ut: unify::Ctx, unify::UType => <>
is_float_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Float, F32]) | <->

is_numeric_ut: unify::Ctx, unify::UType => <>
is_numeric_ut = ctx, ut =>
   is_integerish_ut(ctx, ut) || is_float_ut(ctx, ut)

is_flag_ut: unify::Ctx, unify::UType => <>
is_flag_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Flag]) | <->

make_rec_of: Int, unify::UType => unify::UType
make_rec_of = n, elem_ut =>
   flds = unify::UFields()
   n @ _ => flds += unify::UField(("", elem_ut))
   unify::UType(Rec, flds)

is_same_uprim: unify::UType, unify::UType => <>
is_same_uprim = u1, u2 =>
   u1 [Prim p1] (u2 [Prim p2] (p1 == p2) | <->) | <->

is_numeric_rec: unify::Ctx, unify::UType => <>
is_numeric_rec = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         n = ?flds
         n == 0
            | <->
            |
               f0 = flds(0) | _ | unify::UField(("", unify::UType(None)))
               e_ut = unify::canon(ctx, f0.ut)
               is_num = is_numeric_ut(ctx, e_ut)
               is_num
                  |
                     all_same' = <+>
                     ?flds @ i =>
                        fi = flds(i) | _ |
                           unify::UField(("", unify::UType(None)))
                        fi_ut = unify::canon(ctx, fi.ut)
                        same = is_same_uprim(e_ut, fi_ut)
                        !same | (all_same' = <->; -->)
                     all_same'
                  | <->
      | <->

rec_count: unify::Ctx, unify::UType => Int
rec_count = ctx, u =>
   c = unify::canon(ctx, u)
   c [Rec flds] ?flds | 0

rec_elem: unify::Ctx, unify::UType => unify::UType
rec_elem = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         ?flds > 0
            |
               f0 = flds(0) | _ | unify::UField(("", unify::UType(None)))
               f0.ut
            | unify::UType(None)
      | unify::UType(None)

is_cmp_rec: unify::Ctx, unify::UType => <>
is_cmp_rec = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         n = ?flds
         n == 0
            | <->
            |
               f0 = flds(0) | _ | unify::UField(("", unify::UType(None)))
               e_ut = unify::canon(ctx, f0.ut)
               is_ok = is_numeric_ut(ctx, e_ut) || is_flag_ut(ctx, e_ut)
               is_ok
                  |
                     all_same' = <+>
                     ?flds @ i =>
                        fi = flds(i) | _ |
                           unify::UField(("", unify::UType(None)))
                        fi_ut = unify::canon(ctx, fi.ut)
                        same = is_same_uprim(e_ut, fi_ut)
                        !same | (all_same' = <->; -->)
                     all_same'
                  | <->
      | <->

annotate_cycle: unify::Ctx, type_env::TypeEnv, ast::CycleExpr,
   <tast::TypedExpr|> => tast::TypedExpr
annotate_cycle = ctx, env, c, esc_opt =>
   iter_te = annotate_expr(ctx, env, c.iterable)
   c_iter = unify::canon(ctx, iter_te.ut)
   c.is_rune
      |
         is_s = is_str_ut(ctx, iter_te.ut)
         !is_s
            |
               unify::add_error(ctx, 3084,
                  "Codepoint cycle (@@) requires String iterable")
   iter_elem_info = c.is_rune
      | (<+>, unify::prim_rune())
      |
         c_iter
            [Array arr] (<+>, arr.elem)
            [Slice sl] (<+>, sl)
            [Map m] (<+>, m.val)
            [Prim p]
               p
                  [Str] (<+>, unify::prim_int())
                  [Rune] (<+>, unify::prim_rune())
                  [Int] (<->, unify::prim_int())
                  | (<->, unify::fresh_var(ctx))
            [Rec r]
               !is_ufields_homogeneous(ctx, r)
                  |
                     unify::add_error(ctx, 3051,
                        "Cycle iteration is only allowed on homogeneous records.")
               r_elem = ?r > 0
                  | (r(0) | _ | unify::UField(("", unify::UType(None)))).ut
                  | unify::fresh_var(ctx)
               (<+>, r_elem)
            | (<->, unify::fresh_var(ctx))
   has_elem = iter_elem_info.0
   elem_ut = iter_elem_info.1
   ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   body_te = c.body_fn
      [Fn fe]
         p0 = fe.params(0) | _ | ""
         p1 = fe.params(1) | _ | ""
         p0_coll = p0 != "" && p0 != "_" &&
            type_env::is_prelude_active(env, p0)
         p0_coll
            |
               unify::add_error(ctx, 3033,
                  "Cannot re-assign immutable binding '" + p0 +
                  "'. Use a prime suffix ('" + p0 +
                  "\'') for rebindable variables.")
         p1_coll = p1 != "" && p1 != "_" &&
            type_env::is_prelude_active(env, p1)
         p1_coll
            |
               unify::add_error(ctx, 3033,
                  "Cannot re-assign immutable binding '" + p1 +
                  "'. Use a prime suffix ('" + p1 +
                  "\'') for rebindable variables.")
         np = ?fe.params
         np > 2
            | unify::add_error(ctx, 3133,
               "Cycle body takes at most two parameters")
         has_elem
            |
               np == 1
                  |
                     p0 != "" && p0 != "_"
                        |
                           type_env::bind_local(env, p0, elem_ut, ti_unk, <->)
                           type_env::init_mark_whole(env, p0)
                  |
                     np > 1
                        |
                           c_iter
                              [Map m2]
                                 p0 != "" && p0 != "_"
                                    |
                                       type_env::bind_local(env, p0,
                                          m2.val, ti_unk, <->)
                                       type_env::init_mark_whole(env, p0)
                                 p1 != "" && p1 != "_"
                                    |
                                       type_env::bind_local(env, p1,
                                          m2.key, ti_unk, <->)
                                       type_env::init_mark_whole(env, p1)
                              |
                                 p0 != "" && p0 != "_"
                                    |
                                       type_env::bind_local(env, p0,
                                          elem_ut, ti_unk, <->)
                                       type_env::init_mark_whole(env, p0)
                                 p1 != "" && p1 != "_"
                                    |
                                       type_env::bind_local(env, p1,
                                          unify::prim_int(), ti_unk, <->)
                                       type_env::init_mark_whole(env, p1)
            |
               p0 != "" && p0 != "_"
                  |
                     type_env::bind_local(env, p0, unify::prim_int(),
                        ti_unk, <->)
                     type_env::init_mark_whole(env, p0)
               np > 1 && p1 != "" && p1 != "_"
                  |
                     type_env::bind_local(env, p1, unify::prim_int(),
                        ti_unk, <->)
                     type_env::init_mark_whole(env, p1)
         type_env::bind_local(env, "_i", unify::prim_int(), ti_unk, <->)
         type_env::bind_local(env, "_", elem_ut, ti_unk, <->)
         env.discard_result = <+>
         fe_body_te = annotate_expr(ctx, env, fe.body)
         param_uts = unify::UTypes()
         ?fe.params @ pi =>
            pname = fe.params(pi) | _ | ""
            bnd = type_env::lookup_local(env, pname)
            put = bnd
               | b => b.ut
               |
                  pi < 2
                     | unify::add_error(ctx, 3134,
                        "Cycle body parameter '" + pname +
                        "' has no inferred type")
                  unify::fresh_var(ctx)
            param_uts += put
         fn_ut = unify::mk_fn(param_uts, unify::prim_unit())
         ti_fn = unify::type_info_from_utype(ctx, fn_ut)
         mk_lambda_te(fe.params, fe_body_te, fn_ut, ti_fn)
      |
         type_env::bind_local(env, "_i", unify::prim_int(), ti_unk, <->)
         type_env::bind_local(env, "_", elem_ut, ti_unk, <->)
         env.discard_result = <+>
         callee = apply_callee_name(c.body_fn)
         callee != ""
            |
               u_expr = ast::Expr(Var, "_")
               call_args = ast::Exprs()
               call_args += u_expr
               fn_call = ast::CallExpr((callee, ast::Expr(Var, ""),
                  call_args, 0, 0))
               call_e = ast::Expr(Call, fn_call)
               pnames = ast::Names()
               pnames += "_"
               fe_body_te = annotate_expr(ctx, env, call_e)
               param_uts = unify::UTypes()
               param_uts += elem_ut
               fn_ut = unify::mk_fn(param_uts, unify::prim_unit())
               ti_fn = unify::type_info_from_utype(ctx, fn_ut)
               mk_lambda_te(pnames, fe_body_te, fn_ut, ti_fn)
            | annotate_expr(ctx, env, c.body_fn)
   esc_opt
      | esc_te =>
         ram_ut = unify::ram_pn(esc_te.ut)
         ti = unify::type_info_from_utype(ctx, ram_ut)
         lay = layout::compute_layout(ctx, ram_ut)
         tast::mk_typed_cycle(iter_te, body_te, <+ esc_te ->, c.is_rune,
            ram_ut, ti, lay, 0, 0)
      |
         ut = unify::prim_unit()
         ti = unify::type_info_from_utype(ctx, ut)
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_cycle(iter_te, body_te, <-->, c.is_rune, ut, ti, lay,
            0, 0)

module_member_name: ast::Expr => String
module_member_name = e =>
   e
      [Var v] v
      [Member m]
         m.is_module_access
            | module_member_name(m.target) + "::" + m.field_name
            | ""
      | ""

apply_callee_name: ast::Expr => String
apply_callee_name = e =>
   e
      [Var v] v
      [Member m]
         tgt = m.target [Var tv] tv | module_member_name(m.target)
         tgt != ""
            | tgt + (m.is_module_access | "::" | ".") + m.field_name
            | ""
      | ""

apply_split: ast::Expr => (<>, String, ast::Expr, ast::Exprs)
apply_split = fn =>
   fn
      [Call c]
         (<+>, c.fn_name, c.fn_target, c.args)
      [Bin b]
         b.0
            [Feed]
               sub = apply_split(b.2)
               sub.0
                  |
                     args = ast::Exprs()
                     args += b.1
                     ?sub.3 @ i =>
                        arg_i = sub.3(i) | _ | ast::Expr(Int, 0)
                        args += arg_i
                     (<+>, sub.1, sub.2, args)
                  |
                     callee = apply_callee_name(b.2)
                     args = ast::Exprs()
                     args += b.1
                     tgt = callee == "" | b.2 | ast::Expr(Var, "")
                     (<+>, callee, tgt, args)
            [Apply]
               sub = apply_split(b.1)
               sub.0
                  |
                     args = ast::Exprs()
                     ?sub.3 @ i =>
                        arg_i = sub.3(i) | _ | ast::Expr(Int, 0)
                        args += arg_i
                     args += b.2
                     (<+>, sub.1, sub.2, args)
                  |
                     callee = apply_callee_name(b.1)
                     args = ast::Exprs()
                     args += b.2
                     tgt = callee == "" | b.1 | ast::Expr(Var, "")
                     (<+>, callee, tgt, args)
            | (<->, "", ast::Expr(Var, ""), ast::Exprs())
      | (<->, "", ast::Expr(Var, ""), ast::Exprs())

member_field_ti: type_env::TypeEnv, ast::TypeInfo, String => <ast::TypeInfo|>
member_field_ti = env, ti, name =>
   ti
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt
            | udef => member_field_ti(env, udef.ti, name)
      [Rec r]
         res' = <-->
         ?r.0 @ i =>
            f = r.0(i) | _ | ast::RecordFieldType(("",
               ast::ValueType(Unknown),
               ast::TypeInfo(Prim, ast::ValueType(Unknown)),
               <->, ast::Expr(Int, 0)))
            f.name == name
               |
                  res' = <+ f.rec_type ->
                  -->
         res'
      [Bitfield b]
         res' = <-->
         ?b.fields @ i =>
            bf = b.fields(i) | _ | ast::BitfieldField(("", 0, 0))
            bf.name == name
               |
                  res' = <+ ast::TypeInfo(Prim, b.backing_type) ->
                  -->
         res'
      [Prim p]
         is_err = p [Error]
         is_err
            |
               name
                  ["code", "line", "col"] <+ ast::TypeInfo(Prim, ast::ValueType(Int)) ->
                  ["msg", "file"] <+ ast::TypeInfo(Prim, ast::ValueType(Str)) ->
                  ["context"]
                     flds = ast::FieldTypes()
                     flds += ast::RecordFieldType(("", ast::ValueType(Int),
                        ast::TypeInfo(Prim, ast::ValueType(Int)), <->, ast::Expr(Int, 0)))
                     flds += ast::RecordFieldType(("", ast::ValueType(Int),
                        ast::TypeInfo(Prim, ast::ValueType(Int)), <->, ast::Expr(Int, 0)))
                     <+ ast::TypeInfo(Rec, (flds, <->, <->, ast::ValueType(Record), 2, <->)) ->

// --- Annotate Expressions --------------------------------------------------

annotate_expr: unify::Ctx, type_env::TypeEnv, ast::Expr => tast::TypedExpr
annotate_expr = ctx, env, expr =>
   cur_disc = env.discard_result
   env.discard_result = <->
   expr
      [Int n]
         tast::mk_lit_int(n, 0, 0)
      [Float f]
         tast::mk_lit_float(f, 0, 0)
      [Str s]
         tast::mk_lit_str(s, 0, 0)
      [Rune r]
         ut = unify::prim_rune()
         ti = ast::TypeInfo(Prim, ast::ValueType(Rune))
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_expr(tast::TypedExprKind(LitRune, r), ut, ti, lay, 0, 0)
      [Var name]
         bnd = type_env::lookup_binding(
            env, name)
         bnd
            |
               b = _
               is_user_fn = has_name_in(user_fns, name)
               is_user_fn && b.depth == 0
                  |
                     !has_name_in(value_used_fns, name)
                        | (value_used_fns += name)
               !env.in_lvalue && type_env::init_is_tracked(env, name) &&
                  !type_env::init_is_ok(env, name)
                  |
                     unify::add_error(ctx, 3130,
                        "Use of uninitialized variable '" + name + "'.")
               ti0 = unify::type_info_from_utype(
                  ctx, b.ut)
               keep_b_ti = b.ti [TypeVar tv] tv != "" |
                  (b.ti [Bitfield _] <+> |
                  (b.ti [Rec r] r.5 | <->))
               ti = keep_b_ti | b.ti | ti0
               lay = layout::compute_layout(
                  ctx, b.ut)
               tast::mk_typed_var(name,
                  b.depth, b.is_mut, b.ut,
                  ti, lay, 0, 0)
            |
               name == "_"
                  |
                     wut = unify::fresh_var(ctx)
                     wti = ast::TypeInfo(Prim,
                        ast::ValueType(Unknown))
                     wlay = tast::layout_scalar(8, 8)
                     tast::mk_typed_var("_", 0, <->,
                        wut, wti, wlay, 0, 0)
                  |
                     gen_opt = type_env::lookup_generic(
                        env, name)
                     gen_opt
                        | gen_ti =>
                           gen_ut =
                              instantiate_generic_ti(
                                 ctx, gen_ti)
                           ti =
                              unify::type_info_from_utype(
                                 ctx, gen_ut)
                           lay =
                              layout::compute_layout(
                                 ctx, gen_ut)
                           tast::mk_typed_var(name,
                              0, <->, gen_ut, ti,
                              lay, 0, 0)
                        |
                           ut_opt = type_env::lookup_user_type(env, name)
                           ut_opt
                              | udef =>
                                 type_ut = unify::prim_type()
                                 type_ti = ast::TypeInfo(Prim,
                                    ast::ValueType(Type))
                                 type_lay = tast::layout_void()
                                 tast::mk_typed_var(name, 0, <->,
                                    type_ut, type_ti, type_lay, 0, 0)
                              |
                                 cast_opt = type_name_to_uprim(name)
                                 cast_opt
                                    | uprim =>
                                       type_ut = unify::prim_type()
                                       type_ti = ast::TypeInfo(Prim,
                                          ast::ValueType(Type))
                                       type_lay = tast::layout_void()
                                       tast::mk_typed_var(name, 0, <->,
                                          type_ut, type_ti, type_lay, 0, 0)
                                    |
                                       name == "addr"
                                          |
                                             p_uts = unify::UTypes()
                                             p_uts += unify::fresh_var(ctx)
                                             a_ret = unify::UType(Prim,
                                                unify::UPrim(RawPtr))
                                             a_fn_ut = unify::mk_fn(
                                                p_uts, a_ret)
                                             a_ti = ast::TypeInfo(Prim,
                                                ast::ValueType(RawPtr))
                                             a_lay = tast::layout_scalar(8, 8)
                                             tast::mk_typed_var("addr",
                                                0, <->, a_fn_ut, a_ti,
                                                a_lay, 0, 0)
                                          |
                                             name == "default"
                                                |
                                                   d_ut = unify::prim_unit()
                                                   d_ti = unify::
                                                      type_info_from_utype(
                                                         ctx, d_ut)
                                                   d_lay = tast::layout_void()
                                                   tast::mk_typed_var(
                                                      "default", 0, <->,
                                                      d_ut, d_ti, d_lay, 0, 0)
                                                |
                                                   is_intrinsic_name(name)
                                                      |
                                                         unify::add_error(ctx,
                                                            3100,
                                                            "Intrinsic '" +
                                                            name + "' must " +
                                                            "be called with " +
                                                            "arguments.")
                                                      |
                                                         unify::add_error(ctx,
                                                            3004,
                                                            "Undefined: " +
                                                            name + " in " +
                                                            env.current_module)
                                                   err_ut =
                                                      unify::fresh_var(ctx)
                                                   err_ti = ast::TypeInfo(
                                                      Prim,
                                                      ast::ValueType(Unknown))
                                                   err_lay =
                                                      tast::layout_scalar(
                                                         8, 8)
                                                   tast::mk_typed_var(name,
                                                      0, <->, err_ut,
                                                      err_ti, err_lay,
                                                      0, 0)
      [Bin b]
         b.0
            [Bind]
               pos_body' = b.2
               is_fn = pos_body' [Fn _]
               !is_fn
                  |
                     is_var = pos_body' [Var _]
                     fn_n = is_var | (pos_body' [Var v] v | "") | ""
                     fn_t = is_var | ast::Expr(Var, "") | pos_body'
                     args = ast::Exprs()
                     args += ast::Expr(Var, "_")
                     pos_body' = ast::Expr(Call,
                        ast::CallExpr((fn_n, fn_t, args, 0, 0)))
               b0 = ast::ChoiceBranch((ast::GuardKind(Bare), ast::Exprs(),
                  ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                  pos_body'))
               lhs_te = annotate_expr(ctx, env, b.1)
               c_lhs = unify::canon(ctx, lhs_te.ut)
               lhs_is_ram = c_lhs [Ram _]
               !lhs_is_ram
                  |
                     unify::add_error(ctx, 3091,
                        "LHS of '$>>' must be a RamPP or RamPN ramification")
               no_pos_pay = c_lhs [Ram r] !r.0.has_payload | <->
               no_pos_pay
                  |
                     unify::add_error(ctx, 3091,
                        "LHS of '$>>' must have a positive payload")
               has_neg_pay = c_lhs [Ram r] r.1.has_payload | <->
               neg_tag = has_neg_pay | ast::Tag(Negative) | ast::Tag(Noth)
               neg_args = ast::Exprs()
               has_neg_pay | neg_args += ast::Expr(Var, "_")
               neg_body = ast::Expr(Variant,
                  ast::VariantExpr((neg_tag, neg_args)))
               b1 = ast::ChoiceBranch((ast::GuardKind(Bare), ast::Exprs(),
                  ast::Expr(Var, "?"), ast::Names(), ast::Names(), <->,
                  neg_body))
               branches = ast::Branches()
               branches += b0
               branches += b1
               ch_expr = ast::Expr(Choice, ast::ChoiceExpr((b.1, <+>,
                  branches)))
               annotate_expr(ctx, env, ch_expr)
            [Feed, Apply]
               split = apply_split(expr)
               split.0
                  |
                     ce = ast::CallExpr((split.1, split.2, split.3, 0, 0))
                     call_te = annotate_call(ctx, env, ce)
                     is_feed = b.0 [Feed]
                     c_call = unify::canon(ctx, call_te.ut)
                     is_match_dispatch = is_feed
                     is_match_dispatch
                        |
                           c_call
                              [Fn f_res]
                                 ?f_res.params == 1
                                    |
                                       arg_te = annotate_expr(ctx, env, b.1)
                                       p0 = f_res.params(0) | _ |
                                          unify::UType(None)
                                       ok_p = unify::unify(ctx, p0, arg_te.ut)
                                       ok_p
                                          |
                                             cargs = tast::TypedExprs()
                                             cargs += arg_te
                                             ret_ti =
                                                unify::type_info_from_utype(
                                                   ctx, f_res.ret)
                                             ret_lay =
                                                layout::compute_layout(ctx,
                                                   f_res.ret)
                                             tast::mk_typed_call("",
                                                 <+ call_te ->, cargs,
                                                 f_res.ret, ret_ti, ret_lay,
                                                 0, 0)
                                          | call_te
                                    | call_te
                              | call_te
                        | call_te
                  |
                     op1 = b.0
                     lhs1 = annotate_expr(ctx, env, b.1)
                     rhs1 = annotate_expr(ctx, env, b.2)
                     res_ut1 = annotate_bin_op(ctx, op1, lhs1.ut, rhs1.ut)
                     ti1 = unify::type_info_from_utype(ctx, res_ut1)
                     lay1 = layout::compute_layout(ctx, res_ut1)
                     tast::mk_typed_bin(op1, lhs1, rhs1, res_ut1, ti1,
                        lay1, 0, 0)
            |
               op2 = b.0
               lhs2 = annotate_expr(ctx, env, b.1)
               rhs2 = annotate_expr(ctx, env, b.2)
               res_ut2 = annotate_bin_op(ctx, op2, lhs2.ut, rhs2.ut)
               ti2 = unify::type_info_from_utype(ctx, res_ut2)
               lay2 = layout::compute_layout(ctx, res_ut2)
               tast::mk_typed_bin(op2, lhs2, rhs2, res_ut2, ti2, lay2, 0, 0)
      [Block be]
         annotate_block(ctx, env, be.exprs, cur_disc)
      [Assign a]
         name = a.0
         is_reserved_type_name(name)
            |
               unify::add_error(ctx, 3050, "Cannot define '" + name +
                  "' — it is a built-in type name and is reserved for type coercion.")
         is_pre_redef = name != "" && env.in_fn &&
            type_env::is_prelude_active(env, name)
         is_pre_redef
            |
               unify::add_error(ctx, 3033,
                  "Cannot re-assign immutable binding '" + name +
                  "'. Use a prime suffix ('" + name +
                  "\'') for rebindable variables.")
         is_mut = a.1 || name_is_primed(name)
         is_compound = a.2
         is_global = a.3 || type_env::is_marked_global(env, name)
         a.3 && !env.in_fn | type_env::mark_global_var(env, name)
         is_fwd = is_fwd_assign(a)
         val_expr = a.5
         is_view = is_view_expr(val_expr)
         is_view
            |
               (is_global || (!env.in_fn && !is_fwd) || is_compound)
                  |
                     unify::add_error(ctx, 3150, "View cannot escape function frame")
                  |
                     add_view_name(name)
         init_expr = a.6
         declared_ti = a.8
         is_fwd
            |
               is_fwd_coll = name != "" && env.in_fn &&
                  type_env::is_prelude_active(env, name)
               is_fwd_coll
                  |
                     unify::add_error(ctx, 3033,
                        "Cannot re-assign immutable binding '" + name +
                        "'. Use a prime suffix ('" + name +
                        "\'') for rebindable variables.")
               decl_ut = utype_from_ti_env(env, declared_ti)
               is_global
                  | type_env::bind_global(env, name, decl_ut, declared_ti)
                  | type_env::bind_local(env, name, decl_ut, declared_ti,
                     is_mut)
               c_decl = unify::canon(ctx, decl_ut)
               is_fn = c_decl [Fn _]
               is_bf = is_bitfield_ti_env(env, declared_ti)
               is_growable = is_growable_ti_env(env, declared_ti)
               is_bf || is_growable
                  | type_env::init_mark_whole(env, name)
                  |
                     !is_fn && !is_global
                        |
                           type_env::init_mark_tracked(env, name)
                           mark_bitfield_fields_whole(env, name, declared_ti)
               is_fn
                  | tast::mk_lit_unit(0, 0)
                  |
                     lay = layout::compute_layout(ctx, decl_ut)
                     fwd_kind = tast::TypedExprKind(Var, ("<fwd>", 0, <->))
                     fwd_val = tast::mk_typed_expr(fwd_kind,
                        decl_ut, declared_ti, lay, 0, 0)
                     as_kind = tast::TypedExprKind(Assign,
                        (name, is_mut, <->, <->, <->, fwd_val))
                     tast::mk_typed_expr(as_kind, decl_ut, declared_ti,
                        lay, 0, 0)
            |
               init_expr
                  [Member mm]
                     annotate_member_write(ctx, env, mm, val_expr,
                        is_compound)
                  [Call cc]
                     annotate_index_write(ctx, env, cc, val_expr)
                  [KeyAccess ka]
                     annotate_key_write(ctx, env, ka, val_expr)
                  [RawMemory rm]
                     annotate_raw_write(ctx, env, rm, val_expr)
                  |
                     is_prior = is_global || a.4 || is_compound
                     target_bnd = is_prior
                        | type_env::lookup_binding(env, name)
                        | type_env::lookup_local(env, name)
                     rhs' = tast::mk_lit_unit(0, 0)
                     target_bnd
                        | tb =>
                           c_tb = unify::canon(ctx, tb.ut)
                           val_expr
                              [Fn fe]
                                 c_tb
                                    [Fn f]
                                       is_top = env.cur_depth == 0 &&
                                          !env.in_fn
                                       type_env::enter_scope(env)
                                       saved_in_fn = env.in_fn
                                       saved_fn_ret = env.cur_fn_ret
                                       saved_init = type_env::init_snapshot(
                                          env)
                                       env.in_fn = <+>
                                       env.cur_fn_ret = <+ f.ret ->
                                       env.init = type_env::new_init()
                                       param_uts = unify::UTypes()
                                       ?fe.params @ p_i =>
                                          pname = fe.params(p_i) | _ | ""
                                          is_coll = pname != "" &&
                                             pname != "_" &&
                                             type_env::is_prelude_active(
                                                env, pname)
                                          is_coll
                                             |
                                                msg_c = "Cannot re-assign " +
                                                   "immutable binding '" +
                                                   pname + "'. Use a " +
                                                   "prime suffix ('" +
                                                   pname + "\'') for " +
                                                   "rebindable variables."
                                                unify::add_error(ctx,
                                                   3033, msg_c)
                                          put = f.params(p_i) | _ |
                                             unify::fresh_var(ctx)
                                          param_uts += put
                                          pname != ""
                                             |
                                                put_ti =
                                                   unify::type_info_from_utype(
                                                      ctx, put)
                                                type_env::bind_local(env,
                                                   pname, put, put_ti, <->)
                                                type_env::init_mark_whole(
                                                   env, pname)
                                       c_ret = unify::canon(ctx, f.ret)
                                       is_ret_unit' = <->
                                       c_ret
                                          [Prim p] (is_ret_unit' = p [Unit])
                                       env.discard_result = is_ret_unit'
                                       cached = is_top
                                          | type_env::lookup_fn_body(env, name)
                                       body_te = cached
                                          | _
                                          | annotate_expr(ctx, env, fe.body)
                                       is_view_expr(fe.body)
                                          | unify::add_error(ctx, 3150,
                                             "View cannot escape function frame")
                                       type_env::init_restore(env, saved_init)
                                       env.in_fn = saved_in_fn
                                       env.cur_fn_ret = saved_fn_ret
                                       type_env::leave_scope(env)
                                       ok_ret = is_ret_unit' ||
                                          unify::unify(ctx, f.ret, body_te.ut)
                                       !ok_ret
                                          |
                                             unify::add_error(ctx, 3084,
                                                "Return type mismatch in " +
                                                "function: " + name)
                                       fn_ut = unify::mk_fn(param_uts,
                                          body_te.ut)
                                       ti = unify::type_info_from_utype(
                                          ctx, fn_ut)
                                       rhs' = mk_lambda_te(fe.params, body_te,
                                          fn_ut, ti)
                                    |
                                       rhs' = annotate_expr(ctx, env, val_expr)
                              |
                                 rhs' = annotate_expr(ctx, env, val_expr)
                           is_compound
                              |
                                 c_tb
                                    [Prim p]
                                       p [Builder]
                                          |
                                             c_rhs = unify::canon(ctx, rhs'.ut)
                                             ok_rhs' = <->
                                             c_rhs
                                                [Prim pr]
                                                   ok_rhs' =
                                                      is_builder_append_prim(pr)
                                                [Rec r]
                                                   ok_rhs' =
                                                      is_builder_append_rec(ctx,
                                                         r, 0, ?r)
                                                [Var _]
                                                   ok_rhs' = <+>
                                             !ok_rhs'
                                                |
                                                   unify::add_error(ctx, 3084,
                                                      "Builder append " +
                                                      "requires byte or " +
                                                      "String")
                                          |
                                             ok = unify::unify(ctx, tb.ut,
                                                rhs'.ut)
                                             !ok
                                                |
                                                   unify::add_error(ctx, 3084,
                                                      "Type mismatch in " +
                                                      "compound assignment " +
                                                      "to: " + name)
                                    [Array arr]
                                       ok = unify::unify(ctx, arr.elem, rhs'.ut)
                                       !ok
                                          |
                                             unify::add_error(ctx, 3084,
                                                "Type mismatch in array " +
                                                "append to: " + name)
                                    |
                                       is_var = c_tb [Var _]
                                       !is_var
                                          |
                                             unify::add_error(ctx, 3084,
                                                "Type does not support " +
                                                "compound assignment")
                              |
                                 is_bld' = <->
                                 c_tb
                                    [Prim p_bld]
                                       is_bld' = p_bld [Builder]
                                 is_fn_fe = val_expr [Fn _]
                                 is_tb_fn = c_tb [Fn _]
                                 is_both = is_fn_fe && is_tb_fn
                                 c_rhs_u = unify::canon(ctx, rhs'.ut)
                                 is_rhs_unit = c_rhs_u [Prim p_u] (p_u [Unit]) | <->
                                 is_rhs_unit
                                    |
                                       unify::add_error(ctx, 3032,
                                          "Cannot assign Void expression to variable '" +
                                          name + "'.")
                                 !is_both && !is_bld' && !a.4 && !is_global
                                    |
                                       rebind = !tb.is_mut && !is_mut &&
                                          (type_env::init_is_whole(env, name) ||
                                             is_tb_fn)
                                       rebind
                                          |
                                             unify::add_error(ctx, 3033,
                                                "Cannot re-assign immutable binding '" +
                                                name + "'. Use a prime suffix ('" +
                                                name + "''') for rebindable variables.")
                                          |
                                             ok = unify::unify(ctx, tb.ut,
                                                rhs'.ut)
                                             !ok
                                                |
                                                   unify::add_error(ctx, 3084,
                                                      "Type mismatch in " +
                                                      "assignment to: " + name)
                                 is_global && !is_both && !is_bld' && !a.4
                                    |
                                       ok_g = unify::unify(ctx, tb.ut, rhs'.ut)
                                       !ok_g
                                          |
                                             unify::add_error(ctx, 3084,
                                                "Type mismatch in " +
                                                "assignment to: " + name)
                        |
                           is_must_exist = is_global || a.4
                           is_must_exist
                              |
                                 unify::add_error(ctx, 3004,
                                    "Undefined variable: " + name)
                           rhs' = annotate_expr(ctx, env, val_expr)
                           c_rhs_u2 = unify::canon(ctx, rhs'.ut)
                           is_rhs_unit2 = c_rhs_u2 [Prim p_u2] (p_u2 [Unit]) | <->
                           is_rhs_unit2
                              |
                                 unify::add_error(ctx, 3032,
                                    "Cannot assign Void expression to variable '" +
                                    name + "'.")
                           is_global
                              |
                                 type_env::bind_global(env, name,
                                    rhs'.ut, rhs'.ti)
                              |
                                 type_env::bind_local(env, name,
                                    rhs'.ut, rhs'.ti, is_mut)
                     name != ""
                        | type_env::init_mark_whole(env, name)
                     val_expr
                        [Call ce_rhs]
                           ce_rhs.fn_name != "" && name != ""
                              |
                                 g_opt = type_env::lookup_generic(env,
                                    ce_rhs.fn_name)
                                 g_opt
                                    |
                                       type_env::mark_generic_binding(env,
                                          name)
                           name != ""
                              |
                                 ?ce_rhs.args @ ci =>
                                    ca = ce_rhs.args(ci) | _ | ast::Expr(Int, 0)
                                    ca
                                       [Var cvn]
                                          cvn != "" && has_name_in(user_fns, cvn)
                                             |
                                                fn_alias_vars += name
                                                fn_alias_tgts += cvn
                        [Var v_rhs]
                           is_gen_var = type_env::is_generic_binding(env,
                              v_rhs)
                           is_gen_var && name != ""
                              | type_env::mark_generic_binding(env, name)
                           v_rhs != "" && has_name_in(user_fns, v_rhs) && name != ""
                              |
                                 fn_alias_vars += name
                                 fn_alias_tgts += v_rhs
                        [Choice ch_rhs]
                           name != ""
                              |
                                 ?ch_rhs.branches @ cbi =>
                                    cbr = ch_rhs.branches(cbi) | _ | ast::ChoiceBranch((ast::GuardKind(Bare),
                                       ast::Exprs(), ast::Expr(Int, 0), ast::Names(), ast::Names(), <->,
                                       ast::Expr(Int, 0)))
                                    cbr.block
                                       [Var cbvn]
                                          cbvn != "" && has_name_in(user_fns, cbvn)
                                             |
                                                fn_alias_vars += name
                                                fn_alias_tgts += cbvn
                     tast::mk_typed_assign(name, is_mut,
                        is_compound, is_global,
                        a.4, rhs', unify::prim_unit(), ast::TypeInfo(Prim,
                           ast::ValueType(Unit)), tast::layout_void(), 0, 0)
      [Call ce]
         annotate_call(ctx, env, ce)
      [Fn fe]
         annotate_fn(ctx, env, fe, cur_disc)
      [Choice ch]
         annotate_choice(ctx, env, ch, cur_disc)
      [Record re]
         annotate_record(ctx, env, re)
      [MapLiteral ml]
         k_ut = unify::fresh_var(ctx)
         v_ut = unify::fresh_var(ctx)
         typed_pairs = tast::TypedMapPairs()
         ?ml.pairs @ i =>
            pair = ml.pairs(i) | _ | ast::MapPair((ast::Expr(Int, 0),
               ast::Expr(Int, 0)))
            kte = annotate_expr(ctx, env, pair.key)
            vte = annotate_expr(ctx, env, pair.value)
            unify::unify(ctx, k_ut, kte.ut)
            unify::unify(ctx, v_ut, vte.ut)
            typed_pairs += tast::TypedMapPair((kte, vte))
         map_ut = unify::mk_map(k_ut, v_ut)
         ti = unify::type_info_from_utype(ctx, map_ut)
         lay = layout::compute_layout(ctx, map_ut)
         tast::mk_typed_expr(tast::TypedExprKind(MapLiteral, typed_pairs),
            map_ut, ti, lay, 0, 0)
      [Unary u]
         op = u.0
         inner_te = annotate_expr(ctx, env, u.1)
         res_ut = annotate_unary_op(ctx, env, op, inner_te.ut)
         ti = unify::type_info_from_utype(ctx, res_ut)
         lay = layout::compute_layout(ctx, res_ut)
         tast::mk_typed_unary(op, inner_te, res_ut, ti, lay, 0, 0)
      [Member m]
         m.is_module_access
            |
               qn = module_qualified_name(
                  m.target, m.field_name)
               resolve_module_access(ctx, env, qn,
                  m.line, m.col)
            |
               target_te = annotate_expr(
                  ctx, env, m.target)
               fname' = m.field_name
               m.index_expr
                  [Int n]
                     fname' == ""
                        |
                           c_tgt_pre = unify::canon(ctx, target_te.ut)
                           c_tgt_pre
                              [Rec r_pre]
                                 f_opt = r_pre(n) | _ |
                                    unify::UField(("", unify::UType(None)))
                                 f_opt.name != "" | (fname' = f_opt.name)
                                 f_opt.name == "" | (fname' = str::from_int(n))
               root = member_root_str(m.target)
               root != "" && !env.in_lvalue && fname' != ""
                  |
                     root_var = member_root_name(m.target)
                     !member_has_module_access(m.target) &&
                        !type_env::is_marked_global(env, root_var) &&
                        type_env::init_is_tracked(env, root_var)
                        |
                           ipath = root + "." + fname'
                           ok = type_env::init_is_ok(
                              env, ipath)
                           !ok
                              |
                                 eb = {80}
                                 eb += ("Field '", fname', "' of '", root,
                                    "' read before init.")
                                 unify::add_error(
                                    ctx, 3130, +eb)
               fld_ut = unify::fresh_var(ctx)
               c_tgt = unify::canon(ctx, target_te.ut)
               exact_idx' = -1
               m.index_expr
                  [Int n] (exact_idx' = n)
               c_tgt
                  [Rec r_chk]
                     fname' != ""
                        | exact_idx' = unify::find_field_idx(r_chk, fname')
               swz_status' = 0
               c_tgt
                  [Rec r_swz]
                     exact_idx' < 0 && fname' != "" && env.swizzle_mode != "none"
                        | swz_status' = check_swizzle_pattern(ctx, env.swizzle_mode,
                             r_swz, fname')
               swz_status' == 1
                  |
                     c_tgt
                        [Rec r_ok]
                           elem_fld = r_ok(0) | _ | unify::UField(("", unify::UType(None)))
                           elem_ut = elem_fld.ut
                           flen = ?fname'
                           flen == 1
                              | (fld_ut = elem_ut)
                              |
                                 res_fields' = unify::UFields()
                                 flen @ _ => res_fields' += unify::UField(("", elem_ut))
                                 fld_ut = unify::UType(Rec, res_fields')
                  |
                     swz_status' == 0 && fname' != ""
                        | unify::solve_field(ctx, target_te.ut, fname', fld_ut)
               idx' = swz_status' == 1 | -2 | exact_idx'
               fname' == "" && idx' < 0
                  |
                     unify::add_error(ctx, 3170,
                        "Member index 'x.(i)' must be a compile-time " +
                        "constant (a per-field cycle index).")
               fld_ti_opt = fname' != "" && swz_status' != 1
                  | member_field_ti(env, target_te.ti, fname')
               ti = fld_ti_opt
                  | _
                  | unify::type_info_from_utype(ctx, fld_ut)
               lay = layout::compute_layout(ctx, fld_ut)
               tast::mk_typed_member(target_te, fname', idx', fld_ut, ti,
                  lay, m.line, m.col)
      [Cycle c]
         annotate_cycle(ctx, env, c, <-->)
      [CycleEscape ce]
         ce.cycle
            [Cycle c2]
               esc_te = annotate_expr(ctx, env, ce.branch)
               annotate_cycle(ctx, env, c2, <+ esc_te ->)
            |
               esc_te = annotate_expr(ctx, env, ce.branch)
               cyc_te = annotate_expr(ctx, env, ce.cycle)
               ram_ut = unify::ram_pn(esc_te.ut)
               ti = unify::type_info_from_utype(ctx, ram_ut)
               lay = layout::compute_layout(ctx, ram_ut)
               tast::mk_typed_cycle(cyc_te, tast::mk_lit_unit(0, 0),
                  <+ esc_te ->, <->, ram_ut, ti, lay, 0, 0)
      [CycleJump cj]
         tast::mk_typed_cycle_jump(cj.is_break, cj.level, 0, 0)
      [Copy cp]
         inner_te = annotate_expr(ctx, env, cp)
         ti = unify::type_info_from_utype(ctx, inner_te.ut)
         lay = layout::compute_layout(ctx, inner_te.ut)
         tast::mk_typed_copy(inner_te, inner_te.ut, ti, lay, 0, 0)
      [BuilderCreate bc]
         cap_te = annotate_expr(ctx, env, bc)
         ut = unify::prim_builder()
         ti = ast::TypeInfo(Prim, ast::ValueType(Builder))
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_builder_new(cap_te, ut, ti, lay, 0, 0)
      [NamedArg na]
         annotate_expr(ctx, env, na.val)
      [RawMemory rm]
         addr_te = annotate_expr(ctx, env, rm.addr)
         is_unk = rm.load_type [Unknown]
         is_rec = rm.rec_name != ""
         is_rec
            |
               ti = ast::TypeInfo(TypeVar, rm.rec_name)
               ut = utype_from_ti_env(env, ti)
               lay = layout::compute_layout(ctx, ut)
               tast::mk_typed_raw_memory(addr_te, rm.load_type, ut, ti,
                  lay, 0, 0)
            |
               ut = is_unk | unify::prim_rawptr() |
                  unify::UType(Prim, unify::vt_to_uprim(rm.load_type))
               ti = is_unk | ast::TypeInfo(Prim, ast::ValueType(RawPtr)) |
                  ast::TypeInfo(Prim, rm.load_type)
               lay = layout::compute_layout(ctx, ut)
               tast::mk_typed_raw_memory(addr_te, rm.load_type, ut, ti,
                  lay, 0, 0)
      [Variant ve]
         is_pos = ve.tag_name [Positive]
         is_neg = ve.tag_name [Negative]
         is_some = ve.tag_name [Some]
         is_err = ve.tag_name [Err]
         is_succ = ve.tag_name [Succ]
         nargs = ?ve.args
         nargs == 0
            |
               (is_pos || is_neg)
                  |
                     flg_ut = unify::prim_flag()
                     flg_ti = ast::TypeInfo(Prim, ast::ValueType(Flag))
                     flg_lay = layout::compute_layout(ctx, flg_ut)
                     flg_val = is_pos
                     tast::mk_lit_flag(flg_val, 0, 0)
                  |
                     u_var = unify::fresh_var(ctx)
                     u_ut = is_succ | unify::ram_np(u_var) |
                        unify::ram_pn(u_var)
                     u_ti = unify::type_info_from_utype(ctx, u_ut)
                     u_lay = layout::compute_layout(ctx, u_ut)
                     rsh = is_succ | unify::URamShape(RamNP) |
                        unify::URamShape(RamPN)
                     tast::mk_typed_ram_construct(rsh, is_succ, <-->,
                        u_ut, u_ti, u_lay, 0, 0)
            |
               pay_te = annotate_expr(ctx, env, ve.args(0)!!)
               (is_pos || is_some)
                  |
                     p_ut = is_some | unify::ram_pn(pay_te.ut) |
                        unify::ram_pp(pay_te.ut, unify::fresh_var(ctx))
                     p_ti = unify::type_info_from_utype(ctx, p_ut)
                     p_lay = layout::compute_layout(ctx, p_ut)
                     rshape = is_some | unify::URamShape(RamPN) |
                        unify::URamShape(RamPP)
                     tast::mk_typed_ram_construct(rshape, <+>,
                        <+ pay_te ->, p_ut, p_ti, p_lay, 0, 0)
                  |
                     n_ut = is_err | unify::ram_np(pay_te.ut) |
                        unify::ram_pp(unify::fresh_var(ctx), pay_te.ut)
                     n_ti = unify::type_info_from_utype(ctx, n_ut)
                     n_lay = layout::compute_layout(ctx, n_ut)
                     rshape = is_err | unify::URamShape(RamNP) |
                        unify::URamShape(RamPP)
                     tast::mk_typed_ram_construct(rshape, <->,
                        <+ pay_te ->, n_ut, n_ti, n_lay, 0, 0)
      [KeyAccess ka]
         target_te = annotate_expr(ctx, env, ka.target)
         key_te = annotate_expr(ctx, env, ka.key)
         ka.is_membership || ka.is_delete
            |
               flg_ut = unify::prim_flag()
               flg_ti = ast::TypeInfo(Prim, ast::ValueType(Flag))
               flg_lay = layout::compute_layout(ctx, flg_ut)
               tast::mk_typed_expr(tast::TypedExprKind(KeyAccess,
                  (target_te, key_te, ka.is_membership, ka.is_delete)),
                  flg_ut, flg_ti, flg_lay, ka.line, ka.col)
            |
               elem_ut' = unify::fresh_var(ctx)
               c_tgt = unify::canon(ctx, target_te.ut)
               c_tgt
                  [Array arr] (elem_ut' = arr.elem)
                  [Slice sl] (elem_ut' = sl)
                  [Map m]
                     unify::unify(ctx, m.key, key_te.ut)
                     elem_ut' = m.val
                  | (elem_ut' = unify::fresh_var(ctx))
               ram_ut = unify::ram_pp(elem_ut', unify::prim_error())
               ti = unify::type_info_from_utype(ctx, ram_ut)
               lay = layout::compute_layout(ctx, ram_ut)
               tast::mk_typed_expr(tast::TypedExprKind(KeyAccess,
                  (target_te, key_te, <->, <->)), ram_ut, ti, lay,
                  ka.line, ka.col)
      [Range r]
         lhs_te = r.has_lhs | annotate_expr(ctx, env, r.lhs) |
            tast::mk_lit_int(0, 0, 0)
         rhs_te = r.has_rhs | annotate_expr(ctx, env, r.rhs) |
            tast::mk_lit_unit(0, 0)
         is_rune = is_rune_ut(ctx, lhs_te.ut) || is_rune_ut(ctx, rhs_te.ut)
         ut = is_rune | unify::prim_rune() | unify::prim_int()
         ti = is_rune | ast::TypeInfo(Prim, ast::ValueType(Rune)) |
            ast::TypeInfo(Prim, ast::ValueType(Int))
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_bin(ast::BinaryOp(Seq), lhs_te, rhs_te, ut, ti, lay,
            0, 0)
      [SizeOf so]
         ut = unify::prim_int()
         ti = ast::TypeInfo(Prim, ast::ValueType(Int))
         lay = layout::compute_layout(ctx, ut)
         sz = annotate_type_size(env, so.val_type, so.rec_type)
         tast::mk_lit_int(sz, 0, 0)
      [TypeCast tc]
         inner_te = annotate_expr(ctx, env, tc.expr)
         ut = unify::UType(Prim, unify::vt_to_uprim(tc.target_type))
         ti = ast::TypeInfo(Prim, tc.target_type)
         lay = layout::compute_layout(ctx, ut)
         tast::mk_typed_expr(tast::TypedExprKind(Copy, inner_te), ut, ti,
            lay, 0, 0)
      [Spawn se]
         call_te = annotate_call(ctx, env, se.call)
         ret_ram = unify::ram_pp(call_te.ut, unify::prim_error())
         ti = unify::type_info_from_utype(ctx, ret_ram)
         lay = layout::compute_layout(ctx, ret_ram)
         tast::mk_typed_expr(tast::TypedExprKind(Spawn, se),
            ret_ram, ti, lay, se.call.line, se.call.col)
      [Join je]
         handle_te = annotate_expr(ctx, env, je.handle)
         c_h = unify::canon(ctx, handle_te.ut)
         ret_ut' = handle_te.ut
         c_h
            [Ram r] (ret_ut' = handle_te.ut)
            |
               fresh_elem = unify::fresh_var(ctx)
               ret_ut' = unify::ram_pp(fresh_elem, unify::prim_error())
               unify::unify(ctx, handle_te.ut, ret_ut')
         ti = unify::type_info_from_utype(ctx, ret_ut')
         lay = layout::compute_layout(ctx, ret_ut')
         tast::mk_typed_expr(tast::TypedExprKind(Join, je),
            ret_ut', ti, lay, 0, 0)
      [CompileTime ct]
         inner_te = annotate_expr(ctx, env, ct.expr)
         c_ut = unify::canon(ctx, inner_te.ut)
         is_flag = c_ut [Prim p] (p [Flag]) | <->
         res_ut = is_flag | unify::prim_int() | inner_te.ut
         res_ti = is_flag | ast::TypeInfo(Prim, ast::ValueType(Int)) | inner_te.ti
         res_lay = is_flag | layout::compute_layout(ctx, res_ut) | inner_te.layout
         tast::mk_typed_expr(tast::TypedExprKind(CompileTime, ct),
            res_ut, res_ti, res_lay, 0, 0)
      [NamedArg na]
         annotate_expr(ctx, env, na.val)
      [FastMathPragma _]
         tast::mk_lit_unit(0, 0)
      [SwizzlePragma mode]
         env.swizzle_mode = mode
         tast::mk_lit_unit(0, 0)
      [Exit ex]
         ex_te = annotate_expr(ctx, env, ex.code)
         ut = unify::prim_unit()
         ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
         lay = tast::layout_void()
         tast::mk_typed_expr(tast::TypedExprKind(Exit, ex_te), ut, ti, lay,
            ex_te.line, ex_te.col)
      [UserDiag diag]
         annotate_expr(ctx, env, diag.msg)
         ut = diag.is_warn | unify::prim_unit() | unify::fresh_var(ctx)
         vt = diag.is_warn | ast::ValueType(Unit) | ast::ValueType(Unknown)
         ti = ast::TypeInfo(Prim, vt)
         lay = tast::layout_void()
         tast::mk_typed_expr(tast::TypedExprKind(UserDiag, diag),
            ut, ti, lay, diag.line, diag.col)
      |
         tast::mk_lit_unit(0, 0)

annotate_unary_op: unify::Ctx, type_env::TypeEnv, ast::UnaryOp,
   unify::UType => unify::UType
annotate_unary_op = ctx, env, op, t =>
   op
      [Length]
         unify::prim_int()
      [RuneCount]
         ok = unify::unify(ctx, t, unify::prim_str())
         !ok
            |
               unify::add_error(ctx, 3084,
                  "Codepoint count (??) requires String operand")
         unify::prim_int()
      [AddrOf]
         c = unify::canon(ctx, t)
         c
            [Prim p]
               p
                  [Builder, Str] unify::prim_rawptr()
                  |
                     unify::add_error(ctx, 3078,
                        "Address operator '&' requires a Builder or String operand.")
                     unify::prim_rawptr()
            [Var _]
               unify::prim_rawptr()
            |
               unify::add_error(ctx, 3078,
                  "Address operator '&' requires a Builder or String operand.")
               unify::prim_rawptr()
      [Freeze]
         ok = unify::unify(ctx, t, unify::prim_builder())
         !ok
            |
               unify::add_error(ctx, 3084,
                  "Unary '+' freeze requires Builder operand")
         unify::prim_str()
      [BitNot]
         ok = unify::unify(ctx, t, unify::prim_int())
         !ok
            |
               unify::add_error(ctx, 3084,
                  "Bitwise NOT requires integer operand")
         unify::prim_int()
      [Not]
         c = unify::canon(ctx, t)
         c
            [Prim p]
               p
                  [Flag] unify::prim_flag()
                  [Int, I8, I16, I32, I64, U8, U16, U32, U64]
                     unify::add_error(ctx, 3008,
                        "Unary '!' cannot be applied to an integer. To create a Builder with capacity n, use the brace literal '{n}'.")
                     unify::prim_flag()
                  |
                     unify::add_error(ctx, 3008,
                        "Unary '!' cannot be applied to this type. Use Flag for logical NOT or '+' for Builder freeze.")
                     unify::prim_flag()
            [Var _]
               unify::fresh_var(ctx)
            |
               unify::add_error(ctx, 3008,
                  "Unary '!' cannot be applied to this type. Use Flag for logical NOT or '+' for Builder freeze.")
               unify::prim_flag()
      [Unwrap]
         c = unify::canon(ctx, t)
         c
            [Ram r]
               r.pos.has_payload
                  | r.pos.ut
                  |
                     unify::add_error(ctx, 3091,
                        "Operand of '!!' must have a positive payload")
                     unify::prim_unknown()
            |
               unify::add_error(ctx, 3091,
                  "Operand of '!!' must be a RamPP or RamPN ramification")
               unify::prim_unknown()
      [Propagate]
         !env.in_fn
            |
               unify::add_error(ctx, 3173,
                  "Propagate operator '--!' can only be used inside a function.")
               unify::prim_unknown()
            |
               env.cur_fn_ret
                  | ret_ut =>
                     c_ret = unify::canon(ctx, ret_ut)
                     c_ret
                        [Ram r_ret]
                           c = unify::canon(ctx, t)
                           c
                              [Ram r]
                                 r_np = !r_ret.neg.has_payload
                                 o_np = !r.neg.has_payload
                                 compat_neg = (r_np && o_np) ||
                                    (!r_np && !o_np &&
                                       unify::unify(ctx,
                                          r_ret.neg.ut, r.neg.ut))
                                 !compat_neg
                                    |
                                       unify::add_error(ctx, 3173,
                                          "Cannot propagate " +
                                          "ramification: incompatible " +
                                          "ramification shape.")
                                       unify::prim_unknown()
                                    | (r.pos.has_payload | r.pos.ut | unify::prim_unit!)
                              |
                                 unify::add_error(ctx, 3091,
                                    "Operand of '--!' must be a ramification")
                                 unify::prim_unknown()
                        |
                           unify::add_error(ctx, 3173,
                              "Propagate operator '--!' is only valid " +
                              "inside a function returning a " +
                              "ramification.")
                           unify::prim_unknown()
                  |
                     c = unify::canon(ctx, t)
                     c
                        [Ram r]
                           r.pos.has_payload | r.pos.ut | unify::prim_unit!
                        |
                           unify::add_error(ctx, 3091,
                              "Operand of '--!' must be a ramification")
                           unify::prim_unknown()


is_str_record_fields: unify::Ctx, unify::UFields, Int, Int => <>
is_str_record_fields = ctx, flds, i, n =>
   i == n
      | <+>
      |
         f = flds(i) | _ | unify::UField(("", unify::UType(None)))
         f_ut = unify::canon(ctx, f.ut)
         is_str = f_ut [Prim p] (p [Str]) | <->
         is_str
            | is_str_record_fields(ctx, flds, i + 1, n)
            | <->

is_str_record: unify::Ctx, unify::UType => <>
is_str_record = ctx, u =>
   c = unify::canon(ctx, u)
   c
      [Rec flds]
         n = ?flds
         n > 0 | is_str_record_fields(ctx, flds, 0, n) | <->
      | <->

rec_fields_has_fn: unify::Ctx, unify::UFields, Int, Int, ast::Names => <>
rec_fields_has_fn = ctx, flds, i, n, visited =>
   i == n
      | <->
      |
         f = flds(i) | _ | unify::UField(("", unify::UType(None)))
         ut_has_fn(ctx, f.ut, visited)
            | <+>
            | rec_fields_has_fn(ctx, flds, i + 1, n, visited)

enum_variants_has_fn: unify::Ctx, unify::UEnumVariants, Int, Int, ast::Names => <>
enum_variants_has_fn = ctx, vars, i, n, visited =>
   i == n
      | <->
      |
         v = vars(i) | _ | unify::UEnumVariant(("", <->, unify::UType(None)))
         v.has_payload && ut_has_fn(ctx, v.payload_type, visited)
            | <+>
            | enum_variants_has_fn(ctx, vars, i + 1, n, visited)

ut_has_fn: unify::Ctx, unify::UType, ast::Names => <>
ut_has_fn = ctx, ut, visited =>
   c = unify::canon(ctx, ut)
   c
      [Fn _] <+>
      [Rec flds] rec_fields_has_fn(ctx, flds, 0, ?flds, visited)
      [Array a] ut_has_fn(ctx, a.elem, visited)
      [Slice s] ut_has_fn(ctx, s, visited)
      [Enum e]
         has_name_in(visited, e.name)
            | <->
            |
               vis' = visited
               e.name != "" | (vis' += e.name) | 0
               enum_variants_has_fn(ctx, e.variants, 0, ?e.variants, vis')
      | <->

unify_cmp_op: unify::Ctx, ast::BinaryOp, unify::UType,
   unify::UType => unify::UType
unify_cmp_op = ctx, op, t1, t2 =>
   is_eq_neq = op [Eq, NotEq]
   is_str_tuple = is_eq_neq &&
      ((is_str_ut(ctx, t1) && is_str_record(ctx, t2)) ||
       (is_str_record(ctx, t1) && is_str_ut(ctx, t2)))
   is_str_tuple
      | unify::prim_flag()
      |
         has_fn = is_eq_neq &&
            (ut_has_fn(ctx, t1, ast::Names()) || ut_has_fn(ctx, t2, ast::Names()))
         has_fn
            |
               unify::add_error(ctx, 3084,
                  "Type containing function does not support equality")
               unify::prim_flag()
            | unify_cmp(ctx, t1, t2)

annotate_bin_op: unify::Ctx, ast::BinaryOp, unify::UType,
   unify::UType => unify::UType
annotate_bin_op = ctx, op, t1, t2 =>
   op
      [Add] unify_add(ctx, t1, t2)
      [Sub] unify_sub(ctx, t1, t2)
      [Mul] unify_arith(ctx, t1, t2)
      [Div] unify_arith(ctx, t1, t2)
      [Mod] unify_arith(ctx, t1, t2)
      [Eq] unify_cmp_op(ctx, op, t1, t2)
      [NotEq] unify_cmp_op(ctx, op, t1, t2)
      [Lt] unify_cmp_op(ctx, op, t1, t2)
      [Gt] unify_cmp_op(ctx, op, t1, t2)
      [NotLt] unify_cmp_op(ctx, op, t1, t2)
      [NotGt] unify_cmp_op(ctx, op, t1, t2)
      [And] unify_logical(ctx, <+>, t1, t2)
      [Or] unify_logical(ctx, <->, t1, t2)
      [BitAnd] unify_bitwise(ctx, t1, t2)
      [BitOr] unify_bitwise(ctx, t1, t2)
      [Shl] unify_bitwise(ctx, t1, t2)
      [Shr] unify_bitwise(ctx, t1, t2)
      [Apply] unify_apply(ctx, t1, t2)
      [Feed] unify_feed(ctx, t1, t2)
      [Seq] t2
      | t1

int_bin_res: unify::UType, unify::UType => unify::UType
int_bin_res = t1, t2 =>
   same = t1 [Prim p1] (t2 [Prim p2] (p1 == p2) | <->) | <->
   same | t1 | unify::prim_int()

unify_add: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_add = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                  "Record size mismatch in arithmetic")
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify::unify(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify::unify(ctx, e1, t2)
               t1
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify::unify(ctx, t1, e2)
                     t2
                  |
                     bld_rhs = is_str_ut(ctx, t2) ||
                        is_integerish_ut(ctx, t2) || is_rune_ut(ctx, t2)
                     is_bld = is_builder_ut(ctx, t1) && bld_rhs
                     is_bld
                        | t1
                        |
                           s1 = is_str_ut(ctx, t1) && bld_rhs
                           s1
                              | unify::prim_str()
                              |
                                 p1 = is_ptr_ut(ctx, t1)
                                 p2 = is_ptr_ut(ctx, t2)
                                 int1 = is_integerish_ut(ctx, t1)
                                 int2 = is_integerish_ut(ctx, t2)
                                 fl1 = is_float_ut(ctx, t1)
                                 fl2 = is_float_ut(ctx, t2)
                                 p1 && int2
                                    | t1
                                    |
                                       int1 && p2
                                          | t2
                                          |
                                             is_rune_ut(ctx, t1) && int2
                                                | unify::prim_rune()
                                                |
                                                   fl1 && (int2 || fl2)
                                                      | t1
                                                      |
                                                         fl2 && (int1 || fl1)
                                                            | t2
                                                            |
                                                               int1 && int2
                                                                  |
                                                                     c1 = unify::canon(ctx, t1)
                                                                     c2 = unify::canon(ctx, t2)
                                                                     int_bin_res(c1, c2)
                                                                  |
                                                                     ok = unify::unify(ctx, t1, t2)
                                                                     !ok
                                                                        |
                                                                           unify::add_error(ctx, 3084,
                                                                              "Arithmetic type mismatch")
                                                                           t1
                                                                        | unify::canon(ctx, t1)

unify_sub: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_sub = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                  "Record size mismatch in arithmetic")
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify::unify(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify::unify(ctx, e1, t2)
               t1
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify::unify(ctx, t1, e2)
                     t2
                  |
                     p1 = is_ptr_ut(ctx, t1)
                     p2 = is_ptr_ut(ctx, t2)
                     int1 = is_integerish_ut(ctx, t1)
                     int2 = is_integerish_ut(ctx, t2)
                     fl1 = is_float_ut(ctx, t1)
                     fl2 = is_float_ut(ctx, t2)
                     p1 && int2
                        | t1
                        |
                           p1 && p2
                              | unify::prim_int()
                              |
                                 fl1 && (int2 || fl2)
                                    | t1
                                    |
                                       fl2 && (int1 || fl1)
                                          | t2
                                          |
                                             int1 && int2
                                                |
                                                   c1 = unify::canon(ctx, t1)
                                                   c2 = unify::canon(ctx, t2)
                                                   int_bin_res(c1, c2)
                                                |
                                                   ok = unify::unify(ctx, t1, t2)
                                                   !ok
                                                      |
                                                         unify::add_error(ctx, 3084,
                                                            "Arithmetic type mismatch")
                                                         t1
                                                      | unify::canon(ctx, t1)

unify_arith: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_arith = ctx, t1, t2 =>
   r1 = is_numeric_rec(ctx, t1)
   r2 = is_numeric_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                  "Record size mismatch in arithmetic")
               t1
            |
               e1 = rec_elem(ctx, t1)
               e2 = rec_elem(ctx, t2)
               unify::unify(ctx, e1, e2)
               t1
      |
         r1
            |
               e1 = rec_elem(ctx, t1)
               unify::unify(ctx, e1, t2)
               t1
            |
               r2
                  |
                     e2 = rec_elem(ctx, t2)
                     unify::unify(ctx, t1, e2)
                     t2
                  |
                     int1 = is_integerish_ut(ctx, t1)
                     int2 = is_integerish_ut(ctx, t2)
                     fl1 = is_float_ut(ctx, t1)
                     fl2 = is_float_ut(ctx, t2)
                     fl1 && (int2 || fl2)
                        | t1
                        |
                           fl2 && (int1 || fl1)
                              | t2
                              |
                                 int1 && int2
                                    |
                                       c1 = unify::canon(ctx, t1)
                                       c2 = unify::canon(ctx, t2)
                                       int_bin_res(c1, c2)
                                    |
                                       ok = unify::unify(ctx, t1, t2)
                                       !ok
                                          |
                                             unify::add_error(ctx, 3084,
                                                "Arithmetic type mismatch")
                                             t1
                                          | unify::canon(ctx, t1)

unify_cmp: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_cmp = ctx, t1, t2 =>
   r1 = is_cmp_rec(ctx, t1)
   r2 = is_cmp_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                  "Record size mismatch in comparison")
               unify::prim_flag()
            | make_rec_of(cnt1, unify::prim_flag())
      |
         r1
            |
               cnt1 = rec_count(ctx, t1)
               make_rec_of(cnt1, unify::prim_flag())
            |
               r2
                  |
                     cnt2 = rec_count(ctx, t2)
                     make_rec_of(cnt2, unify::prim_flag())
                  |
                     num1 = is_numeric_ut(ctx, t1)
                     num2 = is_numeric_ut(ctx, t2)
                     num1 && num2
                        | unify::prim_flag()
                        |
                           ip1 = is_int_or_ptr_ut(ctx, t1)
                           ip2 = is_int_or_ptr_ut(ctx, t2)
                           ip1 && ip2
                              | unify::prim_flag()
                              |
                                 ok = unify::unify(ctx, t1, t2)
                                 !ok
                                    |
                                       unify::add_error(ctx, 3084,
                                          "Comparison type mismatch")
                                 unify::prim_flag()

unify_apply: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_apply = ctx, fn_ut, arg_ut =>
   c = unify::canon(ctx, fn_ut)
   ret_ut' = unify::fresh_var(ctx)
   c
      [Fn f]
         n_params = ?f.params
         n_params > 0
            |
               p0 = f.params(0) | _ | unify::UType(None)
               unify::unify(ctx, p0, arg_ut)
               ret_ut' = f.ret
            | ret_ut' = f.ret
      [Prim _]
         ret_ut' = fn_ut
      [Ram _]
         unify::unify(ctx, fn_ut, arg_ut)
         ret_ut' = fn_ut
      [Enum _]
         unify::unify(ctx, fn_ut, arg_ut)
         ret_ut' = fn_ut
      [Rec _]
         unify::unify(ctx, fn_ut, arg_ut)
         ret_ut' = fn_ut
      |
         p_uts = unify::UTypes()
         p_uts += arg_ut
         expected = unify::mk_fn(p_uts, ret_ut')
         unify::unify(ctx, fn_ut, expected)
   ret_ut'

unify_feed: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_feed = ctx, arg_ut, fn_ut => unify_apply(ctx, fn_ut, arg_ut)

err_ram_circuit: unify::Ctx => ()
err_ram_circuit = ctx =>
   unify::add_error(ctx, 3089,
      "Ramification layouts cannot represent short-circuit winners")

err_ram_slot: unify::Ctx, String => ()
err_ram_slot = ctx, slot =>
   unify::add_error(ctx, 3089,
      "Incompatible ram payloads in " + slot + " slot")

err_flag_heap: unify::Ctx => ()
err_flag_heap = ctx =>
   unify::add_error(ctx, 3089,
      "A bare Flag and a heap ram cannot be combined with && or ||")

err_ram_nonram: unify::Ctx => ()
err_ram_nonram = ctx =>
   unify::add_error(ctx, 3089,
      "Cannot combine ramification and non-ramification in op")

diff_payload: <>, <> => <>
diff_payload = a, b => a && !b || !a && b

unify_logical_and: unify::Ctx, unify::URam, unify::URam => unify::UType
unify_logical_and = ctx, r1, r2 =>
   diff = diff_payload(r1.neg.has_payload, r2.neg.has_payload)
   diff
      |
         err_ram_circuit(ctx)
         unify::mk_ram(r2.pos, r2.neg)
      |
         r1.neg.has_payload
            |
               ok = unify::unify(ctx, r1.neg.ut, r2.neg.ut)
               !ok | err_ram_slot(ctx, "neg")
         unify::mk_ram(r2.pos, r2.neg)

unify_logical_or: unify::Ctx, unify::URam, unify::URam => unify::UType
unify_logical_or = ctx, r1, r2 =>
   diff = diff_payload(r1.pos.has_payload, r2.pos.has_payload)
   diff
      |
         err_ram_circuit(ctx)
         unify::mk_ram(r2.pos, r2.neg)
      |
         r1.pos.has_payload
            |
               ok = unify::unify(ctx, r1.pos.ut, r2.pos.ut)
               !ok | err_ram_slot(ctx, "pos")
         unify::mk_ram(r2.pos, r2.neg)

unify_logical_heap: unify::Ctx, <>, unify::URam, unify::URam => unify::UType
unify_logical_heap = ctx, is_and, r1, r2 =>
   is_and
      | unify_logical_and(ctx, r1, r2)
      | unify_logical_or(ctx, r1, r2)

unify_logical_ram: unify::Ctx, <>, unify::URam, unify::URam => unify::UType
unify_logical_ram = ctx, is_and, r1, r2 =>
   s1 = unify::ram_shape(r1)
   s2 = unify::ram_shape(r2)
   is_bare1 = s1 == unify::URamShape(RamNN)
   is_bare2 = s2 == unify::URamShape(RamNN)
   is_bare1 && !is_bare2
      |
         err_flag_heap(ctx)
         unify::mk_ram(r2.pos, r2.neg)
      |
         !is_bare1 && is_bare2
            |
               err_flag_heap(ctx)
               unify::mk_ram(r1.pos, r1.neg)
            |
               is_bare1 && is_bare2
                  | unify::prim_flag()
                  | unify_logical_heap(ctx, is_and, r1, r2)

unify_logical: unify::Ctx, <>, unify::UType, unify::UType => unify::UType
unify_logical = ctx, is_and, t1, t2 =>
   r1 = is_cmp_rec(ctx, t1)
   r2 = is_cmp_rec(ctx, t2)
   r1 && r2
      |
         cnt1 = rec_count(ctx, t1)
         cnt2 = rec_count(ctx, t2)
         cnt1 != cnt2
            |
               unify::add_error(ctx, 3084,
                  "Record size mismatch in logical op")
               unify::prim_flag()
            | make_rec_of(cnt1, unify::prim_flag())
      |
         r1
            |
               cnt1 = rec_count(ctx, t1)
               make_rec_of(cnt1, unify::prim_flag())
            |
               r2
                  |
                     cnt2 = rec_count(ctx, t2)
                     make_rec_of(cnt2, unify::prim_flag())
                  |
                     c1 = unify::canon(ctx, t1)
                     c2 = unify::canon(ctx, t2)
                     c1
                        [Ram ram1]
                           c2
                              [Ram ram2]
                                 unify_logical_ram(ctx, is_and, ram1, ram2)
                              |
                                 err_ram_nonram(ctx)
                                 t1
                        |
                           c2
                              [Ram _]
                                 err_ram_nonram(ctx)
                                 t2
                              | unify::prim_flag()

unify_bitwise: unify::Ctx, unify::UType, unify::UType => unify::UType
unify_bitwise = ctx, t1, t2 =>
   int1 = is_integerish_ut(ctx, t1) || is_flag_ut(ctx, t1)
   int2 = is_integerish_ut(ctx, t2) || is_flag_ut(ctx, t2)
   int1 && int2
      |
         c1 = unify::canon(ctx, t1)
         c2 = unify::canon(ctx, t2)
         (is_flag_ut(ctx, t1) && is_flag_ut(ctx, t2))
            | unify::prim_flag()
            | int_bin_res(c1, c2)
      |
         ok = unify::unify(ctx, t1, t2)
         !ok
            | unify::add_error(ctx, 3084, "Bitwise operand mismatch")
         unify::prim_int()

annotate_block: unify::Ctx, type_env::TypeEnv, ast::Exprs, <> => tast::TypedExpr
annotate_block = ctx, env, exprs, is_disc =>
   type_env::enter_scope(env)
   tes = tast::TypedExprs()
   last_ut' = unify::prim_unit()
   n = ?exprs
   ?exprs @ i =>
      e = exprs(i) | _ | ast::Expr(Int, 0)
      is_last = i == n - 1
      disc_val = is_last | is_disc | <+>
      env.discard_result = disc_val
      te = annotate_expr(ctx, env, e)
      tes += te
      last_ut' = te.ut
   env.discard_result = is_disc
   type_env::leave_scope(env)
   block_ut = is_disc | unify::prim_unit() | last_ut'
   ti = unify::type_info_from_utype(ctx, block_ut)
   lay = layout::compute_layout(ctx, block_ut)
   tast::mk_typed_block(tes, block_ut, ti, lay, 0, 0)

is_range_expr: ast::Expr => <>
is_range_expr = e => e [Range _]

find_last_dot: String, Int => <Int|>
find_last_dot = s, i =>
   i < 0 | <--> |
      (s(i) == 46) | <+ i -> | find_last_dot(s, i - 1)

dotted_to_expr: String => ast::Expr
dotted_to_expr = s =>
   find_last_dot(s, ?s - 1)
      | dot =>
         dot !> 0
            | ast::Expr(Var, s)
            |
               target_str = s(0..dot)
               dot_next = dot + 1
               s_len = ?s
               field_str = s(dot_next..s_len)
               me = ast::MemberExpr((dotted_to_expr(target_str),
                  field_str, <->, ast::Expr(Int, 0), 0, 0))
               ast::Expr(Member, me)
      | ast::Expr(Var, s)

first_rec_field_ut: unify::UFields => unify::UType
first_rec_field_ut = flds =>
   ?flds == 0
      | unify::prim_int()
      |
         f0 = flds(0) | _ | unify::UField(("", unify::UType(None)))
         f0.ut

is_intrinsic_name: String => <>
is_intrinsic_name = name =>
   ?name > 1 && name(0) == '%'

is_known_intrinsic: String => <>
is_known_intrinsic = name =>
   name ["%min", "%max", "%clamp", "%abs", "%shuffle",
      "%all", "%any", "%sum", "%prod", "%dot",
      "%sqrt", "%fma", "%floor", "%ceil", "%trunc", "%round", "%copysign",
      "%popcount", "%clz", "%ctz", "%bswap", "%bitreverse",
      "%rotl", "%rotr",
      "%pow", "%sin", "%cos", "%exp2", "%log2", "%uadd_sat", "%usub_sat",
      "%fmuladd", "%memcpy", "%memmove", "%memset"]

expected_intrinsic_nargs: String => Int
expected_intrinsic_nargs = name =>
   name
      ["%abs", "%all", "%any", "%sum", "%prod", "%sqrt",
         "%floor", "%ceil", "%trunc", "%round",
         "%popcount", "%clz", "%ctz", "%bswap", "%bitreverse",
         "%sin", "%cos", "%exp2", "%log2"] 1
      ["%min", "%max", "%dot", "%copysign", "%rotl", "%rotr",
         "%pow", "%uadd_sat", "%usub_sat"] 2
      ["%clamp", "%fma", "%fmuladd", "%memcpy", "%memmove", "%memset"] 3
      ["%shuffle"] 0
      | -1

compute_intrinsic_ret_ut: unify::Ctx, String, tast::TypedExprs,
   tast::TypedExpr, tast::TypedExpr, tast::TypedExpr => unify::UType
compute_intrinsic_ret_ut = ctx, name, args, a0, a1, a2 =>
   name
      ["%memcpy", "%memmove", "%memset"] unify::prim_rawptr()
      ["%all", "%any"] unify::prim_flag()
      ["%sum", "%prod"]
         c0 = unify::canon(ctx, a0.ut)
         c0
            [Rec flds] first_rec_field_ut(flds)
            | a0.ut
      ["%dot"]
         unify::unify(ctx, a0.ut, a1.ut)
         c0 = unify::canon(ctx, a0.ut)
         c0
            [Rec flds] first_rec_field_ut(flds)
            | a0.ut
      ["%shuffle"]
         mask_te = ?args == 3 | a2 | a1
         c_mask = unify::canon(ctx, mask_te.ut)
         c_v0 = unify::canon(ctx, a0.ut)
         elem_ut = c_v0
            [Rec vflds] first_rec_field_ut(vflds)
            | a0.ut
         mask_count = c_mask [Rec mflds] ?mflds | 0
         out_flds = unify::UFields()
         mask_count @ _ =>
            out_flds += unify::UField(("", elem_ut))
         unify::mk_rec(out_flds)
      ["%min", "%max", "%pow", "%uadd_sat", "%usub_sat"]
         c0 = unify::canon(ctx, a0.ut)
         c1 = unify::canon(ctx, a1.ut)
         c0
            [Rec _] a0.ut
            |
               c1
                  [Rec _] a1.ut
                  |
                     unify::unify(ctx, a0.ut, a1.ut)
                     a0.ut
      ["%fma", "%fmuladd"]
         c0 = unify::canon(ctx, a0.ut)
         c1 = unify::canon(ctx, a1.ut)
         c2 = unify::canon(ctx, a2.ut)
         c0
            [Rec _] a0.ut
            |
               c1
                  [Rec _] a1.ut
                  |
                     c2
                        [Rec _] a2.ut
                        | a0.ut
      | a0.ut

annotate_intrinsic_call: unify::Ctx, type_env::TypeEnv,
   ast::CallExpr => tast::TypedExpr
annotate_intrinsic_call = ctx, env, ce =>
   typed_args = tast::TypedExprs()
   ?ce.args @ i =>
      a = ce.args(i) | _ | ast::Expr(Int, 0)
      typed_args += annotate_expr(ctx, env, a)
   name = ce.fn_name
   nargs = ?typed_args
   !is_known_intrinsic(name)
      |
         unify::add_error(ctx, 3100,
            "Unknown compiler intrinsic '" + name + "'.")
         ti_err = ast::TypeInfo(Prim, ast::ValueType(Unknown))
         tast::mk_typed_call(name, <-->, typed_args, unify::prim_unit(),
            ti_err, tast::layout_void(), ce.line, ce.col)
      |
         exp_n = expected_intrinsic_nargs(name)
         nargs_ok = exp_n == 0
            | nargs == 2 || nargs == 3
            | nargs == exp_n
         !nargs_ok
            |
               unify::add_error(ctx, 3100,
                  "Intrinsic '" + name + "' called with " +
                  str::from_int(nargs) + " arguments.")
               ti_err = ast::TypeInfo(Prim, ast::ValueType(Unknown))
               tast::mk_typed_call(name, <-->, typed_args,
                  unify::prim_unit(), ti_err, tast::layout_void(),
                  ce.line, ce.col)
            |
               def_unit = tast::mk_lit_unit(0, 0)
               arg0 = def_unit
               nargs > 0
                  |
                     t0 = typed_args(0)
                     arg0 = t0 | _ | def_unit
               arg1 = def_unit
               nargs > 1
                  |
                     t1 = typed_args(1)
                     arg1 = t1 | _ | def_unit
               arg2 = def_unit
               nargs > 2
                  |
                     t2 = typed_args(2)
                     arg2 = t2 | _ | def_unit
               ret_ut = compute_intrinsic_ret_ut(ctx, name, typed_args,
                  arg0, arg1, arg2)
               ti = unify::type_info_from_utype(ctx, ret_ut)
               lay = layout::compute_layout(ctx, ret_ut)
               tast::mk_typed_call(name, <-->, typed_args, ret_ut, ti,
                  lay, ce.line, ce.col)

annotate_call: unify::Ctx, type_env::TypeEnv, ast::CallExpr => tast::TypedExpr
annotate_call = ctx, env, ce =>
   is_intrinsic = is_intrinsic_name(ce.fn_name)
   is_intrinsic
      | annotate_intrinsic_call(ctx, env, ce)
      |
         ce.fn_name != ""
            |
               !has_name_in(called_fns, ce.fn_name)
                  | (called_fns += ce.fn_name)
               ?fn_alias_vars @ _ =>
                  ?fn_alias_vars @ ai =>
                     avn = fn_alias_vars(ai) | _ | ""
                     has_name_in(called_fns, avn)
                        |
                           tgt = fn_alias_tgts(ai) | _ | ""
                           tgt != "" && !has_name_in(called_fns, tgt)
                              | (called_fns += tgt)
         cast_opt = ce.fn_name != "" | type_name_to_uprim(ce.fn_name)
         cast_opt
            | uprim =>
               typed_args = tast::TypedExprs()
               ?ce.args @ i =>
                  a = ce.args(i) | _ | ast::Expr(Int, 0)
                  typed_args += annotate_expr(ctx, env, a)
               ce.fn_name == "String" && ?typed_args == 1
                  |
                     arg0 = typed_args(0) | _ | tast::mk_lit_unit(0, 0)
                     c_a0 = unify::canon(ctx, arg0.ut)
                     c_a0
                        [Prim p_str]
                           p_str [RawPtr]
                              unify::add_error(ctx, 3065,
                                 "Cannot construct a String from a RawPtr — " +
                                 "'String(ptr)' is rejected. Build with " +
                                 "literals, '+', '++', 's + n', or a Builder.")
               cast_ut = unify::UType(Prim, uprim)
               ti = unify::type_info_from_utype(ctx, cast_ut)
               lay = layout::compute_layout(ctx, cast_ut)
               tast::mk_typed_call(ce.fn_name, <-->, typed_args, cast_ut, ti,
                  lay, ce.line, ce.col)
            |
               ce.fn_name == "addr"
                  |
                     typed_args = tast::TypedExprs()
                     ?ce.args @ i =>
                        a = ce.args(i) | _ | ast::Expr(Int, 0)
                        typed_args += annotate_expr(ctx, env, a)
                     cast_ut = unify::UType(Prim, unify::UPrim(RawPtr))
                     ti = unify::type_info_from_utype(ctx, cast_ut)
                     lay = layout::compute_layout(ctx, cast_ut)
                     tast::mk_typed_call(ce.fn_name, <-->, typed_args, cast_ut,
                        ti, lay, ce.line, ce.col)
                  | annotate_call_normal(ctx, env, ce)

resolve_fn_ut: unify::Ctx, type_env::TypeEnv, String,
   unify::UType => unify::UType
resolve_fn_ut = ctx, env, name, ut =>
   is_gen = type_env::is_generic_binding(env, name)
   is_gen | instantiate_unbound_fn(ctx, ut) | ut

find_record_ctor_field_expr: ast::Exprs, ast::RecordFieldType,
   Int, Int => < ast::Expr | >
find_record_ctor_field_expr = args, fld, j, nf =>
   named_res' = <-->
   ?args @ i =>
      arg_i = args(i) | _ | ast::Expr(Int, 0)
      arg_i [NamedArg na]
         na.name == fld.name | (named_res' = <+ na.val ->; -->)
   named_res'
      | val => <+ val ->
      |
         a0_first = ?args > 0
            | (args(0) | _ | ast::Expr(Int, 0))
            | ast::Expr(Int, 0)
         a0_is_rec = a0_first [Record _]
         fld_is_rec = fld.rec_type [Rec _]
         is_tuple_arg = ?args == 1 &&
            (nf > 1 || (a0_is_rec && !fld_is_rec))
         pos_res' = <-->
         !is_tuple_arg && j < ?args
            |
               arg_j = args(j) | _ | ast::Expr(Int, 0)
               arg_j
                  [NamedArg _] 0
                  [Range _] 0
                  | (pos_res' = <+ arg_j ->)
         pos_res'
            | val => <+ val ->
            |
               tuple_res' = <-->
               ?args == 1
                  |
                     a0 = args(0) | _ | ast::Expr(Int, 0)
                     a0
                        [NamedArg _] 0
                        [Range _] 0
                        [Record rec_lit]
                           j < ?rec_lit.fields
                              |
                                 rf = rec_lit.fields(j) | _ |
                                    ast::RecordField((<->, "",
                                       ast::Expr(Int, 0)))
                                 tuple_res' = <+ rf.val ->
                        |
                           idx_e = ast::Expr(Member,
                              (ast::MemberExpr((a0, "", <->,
                                 ast::Expr(Int, j), 0, 0))))
                           tuple_res' = <+ idx_e ->
               tuple_res'
                  | val => <+ val ->
                  |
                     splat_res' = <-->
                     ?args @ k =>
                        s_arg = args(k) | _ | ast::Expr(Int, 0)
                        s_arg [Range r]
                           !r.has_lhs && r.has_rhs
                              |
                                 is_def = r.rhs [Var v] (v == "default") | <->
                                 is_def
                                    |
                                       fld.has_default
                                          |
                                             splat_res' = <+ fld.default_expr ->
                                             -->
                                    |
                                       fld_access = ast::Expr(Member,
                                          (ast::MemberExpr((r.rhs, fld.name,
                                             <->, ast::Expr(Var, ""), 0, 0))))
                                       splat_res' = <+ fld_access ->
                                       -->
                     splat_res'
                        | val => <+ val ->
                        |
                           fld.has_default | <+ fld.default_expr ->

annotate_record_ctor_fields: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
   type_env::UserTypeDef, unify::UFields, ast::FieldTypes,
   Int => tast::TypedExpr
annotate_record_ctor_fields = ctx, env, ce, udef, flds, fields, nf =>
   ?ce.args @ ai =>
      arg = ce.args(ai) | _ | ast::Expr(Int, 0)
      arg [NamedArg na]
         found_fld' = <->
         nf @ fi =>
            f = fields(fi) | _ | ast::mk_rfield_type("",
               ast::ValueType(Unknown), ast::TypeInfo(Prim, ast::ValueType(Unknown)))
            f.name == na.name | (found_fld' = <+>; -->)
         !found_fld'
            |
               unify::add_error(ctx, 3117,
                  "Record '" + ce.fn_name + "' has no field '" + na.name + "'")
   tf_list = tast::TypedFields()
   cur_off' = 0
   nf @ j =>
      fld = fields(j) | _ | ast::mk_rfield_type("",
         ast::ValueType(Unknown), ast::TypeInfo(Prim, ast::ValueType(Unknown)))
      val_expr_opt = find_record_ctor_field_expr(ce.args, fld, j, nf)
      val_expr_opt
         | _ => 0
         |
            unify::add_error(ctx, 3130, "Field '" + fld.name + "' of '" +
               ce.fn_name + "' has no default value and was not provided.")
      val_expr = val_expr_opt | _ | ast::Expr(Int, 0)
      val_te = annotate_expr(ctx, env, val_expr)
      idx = fld.name != "" | unify::find_field_idx(flds, fld.name) | j
      idx !< 0 && idx < ?flds
         |
            ufld = flds(idx) | _ | unify::UField(("", unify::UType(None)))
            unify::unify(ctx, ufld.ut, val_te.ut)
      flay = layout::compute_layout(ctx, val_te.ut)
      f_align = flay.align < 1 | 1 | flay.align
      cur_off' = layout::align_up(cur_off', f_align)
      tf = tast::TypedField((fld.name, val_te, cur_off', val_te.ut))
      cur_off' = cur_off' + flay.size
      tf_list += tf
   lay = layout::compute_layout(ctx, udef.ut)
   tast::mk_typed_expr(tast::TypedExprKind(Record, tf_list),
      udef.ut, udef.ti, lay, ce.line, ce.col)

annotate_record_ctor: unify::Ctx, type_env::TypeEnv, ast::CallExpr,
   type_env::UserTypeDef, unify::UFields => tast::TypedExpr
annotate_record_ctor = ctx, env, ce, udef, flds =>
   resolved_ti' = udef.ti
   udef.ti
      [TypeVar tv]
         u_opt = type_env::lookup_user_type(env, tv)
         u_opt
            | u => (resolved_ti' = u.ti)
   fields = resolved_ti' [Rec rr] rr.0 | ast::FieldTypes()
   nf = ?fields
   is_raw_cast' = <->
   raw_te' = tast::mk_lit_unit(0, 0)
   ?ce.args == 1
      |
         a0 = ce.args(0) | _ | ast::Expr(Int, 0)
         a0_te = annotate_expr(ctx, env, a0)
         c_a0 = unify::canon(ctx, a0_te.ut)
         c_a0
            [Prim p]
               p [RawPtr] (is_raw_cast' = <+>; raw_te' = a0_te)
   is_raw_cast'
      |
         call_args = tast::TypedExprs()
         call_args += raw_te'
         lay = layout::compute_layout(ctx, udef.ut)
         tast::mk_typed_call(ce.fn_name, <-->, call_args, udef.ut, udef.ti,
            lay, ce.line, ce.col)
      | annotate_record_ctor_fields(ctx, env, ce, udef, flds, fields, nf)

annotate_call_normal: unify::Ctx, type_env::TypeEnv,
   ast::CallExpr => tast::TypedExpr
annotate_call_normal = ctx, env, ce =>
   udef_opt = ce.fn_name != "" | type_env::lookup_user_type(env, ce.fn_name)
   udef_opt
      | udef =>
         c_udef = unify::canon(ctx, udef.ut)
         c_udef
            [Rec flds]
               annotate_record_ctor(ctx, env, ce, udef, flds)
            |
               typed_args = tast::TypedExprs()
               ?ce.args @ i =>
                  a = ce.args(i) | _ | ast::Expr(Int, 0)
                  typed_args += annotate_expr(ctx, env, a)
               n_args = ?typed_args
               c_udef
                  [Ram r]
                     n_args == 1
                        |
                           a0 = typed_args(0) | _ | tast::mk_lit_int(0, 0, 0)
                           c_a0 = unify::canon(ctx, a0.ut)
                           c_a0
                              [Ram r_arg]
                                 r_arg.pos.has_payload
                                    | unify::unify(ctx, r.pos.ut, r_arg.pos.ut)
                                 r_arg.neg.has_payload
                                    | unify::unify(ctx, r.neg.ut, r_arg.neg.ut)
                              | unify::unify(ctx, udef.ut, a0.ut)
               c_udef
                  [Enum uenum]
                     n_args = ?ce.args
                     arg0_e = n_args > 0 | (ce.args(0) | _ | ast::Expr(Var, "")) | ast::Expr(Var, "")
                     lbl_str = arg0_e [Var v] v | ""
                     idx' = -1
                     ?uenum.variants @ si =>
                        v_info = uenum.variants(si) | _ |
                           unify::UEnumVariant(("", <->, unify::UType(None)))
                        v_info.label == lbl_str | (idx' = si; -->)
                     idx' < 0
                        |
                           n_args == 1
                              |
                                 a0 = typed_args(0) | _ | tast::mk_lit_unit(0, 0)
                                 ok_cast = unify::unify(ctx, udef.ut, a0.ut)
                                 !ok_cast
                                    |
                                       unify::add_error(ctx, 3096,
                                          "Enum '" + ce.fn_name + "' has no variant labeled '" + lbl_str + "'.")
                              |
                                 unify::add_error(ctx, 3096,
                                    "Enum '" + ce.fn_name + "' has no variant labeled '" + lbl_str + "'.")
                        |
                           v_info = uenum.variants(idx') | _ |
                              unify::UEnumVariant(("", <->, unify::UType(None)))
                           !v_info.has_payload && n_args > 1
                              |
                                 unify::add_error(ctx, 3098,
                                    "Enum '" + ce.fn_name + "' variant '" + lbl_str + "' is a bare unit and takes no payload argument.")
                           v_info.has_payload && n_args > 1
                              |
                                 arg1 = typed_args(1) | _ | tast::mk_lit_unit(0, 0)
                                 ok_p = unify::unify(ctx, v_info.payload_type, arg1.ut)
                                 !ok_p
                                    |
                                       exp_name = unify::show_utype(ctx, v_info.payload_type)
                                       got_name = unify::show_utype(ctx, arg1.ut)
                                       unify::add_error(ctx, 3099,
                                          "Enum '" + ce.fn_name + "' variant '" + lbl_str + "' expects payload of type " + exp_name + ", got " + got_name + ".")
               ti = udef.ti
               lay = layout::compute_layout(ctx, udef.ut)
               tast::mk_typed_call(ce.fn_name, <-->, typed_args, udef.ut, ti,
                  lay, ce.line, ce.col)
      |
         target_val' = <-->
         fn_ut' = unify::UType(None)
         is_var_index' = <->
         index_ret_ut' = unify::UType(None)
         has_dot = ce.fn_name != "" &&
            (find_last_dot(ce.fn_name, ?ce.fn_name - 1) | d => d > 0 | <->)
         !has_dot && ce.fn_name != ""
            |
               bnd = type_env::lookup_binding(env, ce.fn_name)
               bnd
                  | b =>
                     c_ut = unify::canon(ctx, b.ut)
                     c_ut
                        [Fn _]
                           fn_ut' = resolve_fn_ut(ctx, env, ce.fn_name, b.ut)
                        [Prim p]
                           p
                              [Str]
                                 is_var_index' = <+>
                                 first_a = ce.args(0) | _ | ast::Expr(Int, 0)
                                 is_rng = is_range_expr(first_a)
                                 index_ret_ut' = is_rng | unify::prim_str() |
                                    unify::prim_int()
                              [Builder]
                                 is_var_index' = <+>
                                 index_ret_ut' = unify::prim_int()
                              |
                                 fn_ut' = resolve_fn_ut(ctx, env, ce.fn_name,
                                    b.ut)
                        [Array arr]
                           is_var_index' = <+>
                           first_a = ce.args(0) | _ | ast::Expr(Int, 0)
                           is_rng = is_range_expr(first_a)
                           sl_ut = unify::mk_slice(arr.elem)
                           err_ut = unify::prim_error()
                           elem_ut = unify::ram_pp(arr.elem, err_ut)
                           index_ret_ut' = is_rng | sl_ut | elem_ut
                        [Slice elem]
                           is_var_index' = <+>
                           first_a = ce.args(0) | _ | ast::Expr(Int, 0)
                           is_rng = is_range_expr(first_a)
                           sl_ut = unify::mk_slice(elem)
                           index_ret_ut' = is_rng | sl_ut | elem
                        [Rec rec]
                           is_var_index' = <+>
                           n_flds = ?rec
                           n_flds > 0
                              |
                                 !is_ufields_homogeneous(ctx, rec)
                                    |
                                       unify::add_error(ctx, 3051,
                                          "Dynamic indexing is only allowed on homogeneous records.")
                                 f0 = rec(0) | _ |
                                    unify::UField(("",
                                       unify::UType(None)))
                                 first_a = ce.args(0) | _ | ast::Expr(Int, 0)
                                 is_rng = is_range_expr(first_a)
                                 f0_ut = f0.ut
                                 sl_ut = unify::mk_slice(f0_ut)
                                 index_ret_ut' = is_rng | sl_ut | f0_ut
                              | index_ret_ut' = unify::fresh_var(ctx)
                        |
                           fn_ut' = resolve_fn_ut(ctx, env, ce.fn_name, b.ut)
                     is_var_index'
                        |
                           b_ti = unify::type_info_from_utype(ctx, b.ut)
                           b_lay = layout::compute_layout(ctx, b.ut)
                           target_val' = <+ tast::mk_typed_var(ce.fn_name,
                              b.depth, b.is_mut, b.ut, b_ti, b_lay,
                              ce.line, ce.col) ->
                  |
                     gen_opt = type_env::lookup_generic(env, ce.fn_name)
                     gen_opt
                        | gen_ti =>
                           fn_ut' = instantiate_generic_ti(ctx, gen_ti)
                        |
                           unify::add_error(ctx, 3004,
                              "Undefined function: " + ce.fn_name)
                           fn_ut' = unify::fresh_var(ctx)
            |
               tgt_expr = has_dot | dotted_to_expr(ce.fn_name) | ce.fn_target
               target_te = annotate_expr(ctx, env, tgt_expr)
               target_val' = <+ target_te ->
               c_tgt = unify::canon(ctx, target_te.ut)
               c_tgt
                  [Prim p2]
                     p2
                        [Str]
                           is_var_index' = <+>
                           first_a2 = ce.args(0) | _ | ast::Expr(Int, 0)
                           is_rng2 = is_range_expr(first_a2)
                           index_ret_ut' = is_rng2 | unify::prim_str() |
                              unify::prim_int()
                        [Builder]
                           is_var_index' = <+>
                           index_ret_ut' = unify::prim_int()
                        | fn_ut' = instantiate_unbound_fn(ctx, target_te.ut)
                  [Array arr2]
                     is_var_index' = <+>
                     first_a2 = ce.args(0) | _ | ast::Expr(Int, 0)
                     is_rng2 = is_range_expr(first_a2)
                     sl_ut2 = unify::mk_slice(arr2.elem)
                     err_ut2 = unify::prim_error()
                     elem_ut2 = unify::ram_pp(arr2.elem, err_ut2)
                     index_ret_ut' = is_rng2 | sl_ut2 | elem_ut2
                  [Slice elem2]
                     is_var_index' = <+>
                     first_a2 = ce.args(0) | _ | ast::Expr(Int, 0)
                     is_rng2 = is_range_expr(first_a2)
                     sl_ut2 = unify::mk_slice(elem2)
                     index_ret_ut' = is_rng2 | sl_ut2 | elem2
                  [Rec rec2]
                     is_var_index' = <+>
                     n_flds2 = ?rec2
                     n_flds2 > 0
                        |
                           f02 = rec2(0) | _ |
                              unify::UField(("",
                                 unify::UType(None)))
                           first_a2 = ce.args(0) | _ | ast::Expr(Int, 0)
                           is_rng2 = is_range_expr(first_a2)
                           f0_ut2 = f02.ut
                           sl_ut2 = unify::mk_slice(f0_ut2)
                           index_ret_ut' = is_rng2 | sl_ut2 | f0_ut2
                        | index_ret_ut' = unify::fresh_var(ctx)
                  | fn_ut' = instantiate_unbound_fn(ctx, target_te.ut)

         typed_args = tast::TypedExprs()
         arg_uts = unify::UTypes()
         ?ce.args @ i =>
            a = ce.args(i) | _ | ast::Expr(Int, 0)
            ta = annotate_expr(ctx, env, a)
            a
               [Var v]
                  c = unify::canon(ctx, ta.ut)
                  c
                     [Rec _]
                        full = type_env::init_is_fully_init(env, v, c)
                        !full
                           |
                              unify::add_error(ctx, 3132,
                                 "Passing a partially-initialized composite '" +
                                 v + "' to a function is disallowed.")
            typed_args += ta
            arg_uts += ta.ut

         is_var_index'
            |
               ti = unify::type_info_from_utype(ctx, index_ret_ut')
               lay = layout::compute_layout(ctx, index_ret_ut')
               tast::mk_typed_call(ce.fn_name, target_val', typed_args,
                  index_ret_ut', ti, lay, ce.line, ce.col)
            |
               ret_ut = unify::fresh_var(ctx)
               c_fn = unify::canon(ctx, fn_ut')
               is_fn_var = c_fn [Var _]
               is_fn_var
                  | unify::add_call_constraint(ctx, fn_ut', arg_uts, ret_ut)
                  |
                     c_fn
                        [Fn f_sig]
                           ?arg_uts @ ai =>
                              ai < ?f_sig.params
                                 |
                                    p_exp = f_sig.params(ai) | _ | unify::UType(None)
                                    a_ut = arg_uts(ai) | _ | unify::UType(None)
                                    (is_integerish_ut(ctx, p_exp) && is_flag_ut(ctx, a_ut))
                                       |
                                          arg_uts(ai) = p_exp !| _
                     expected_fn = unify::mk_fn(arg_uts, ret_ut)
                     ok = unify::unify(ctx, fn_ut', expected_fn)
                     !ok
                        | unify::add_error(ctx, 3084,
                           "Function call signature mismatch")
               ti = unify::type_info_from_utype(ctx, ret_ut)
               lay = layout::compute_layout(ctx, ret_ut)
               tast::mk_typed_call(ce.fn_name, target_val', typed_args,
                  ret_ut, ti, lay, ce.line, ce.col)

annotate_fn: unify::Ctx, type_env::TypeEnv, ast::FnExpr, <> => tast::TypedExpr
annotate_fn = ctx, env, fe, is_disc =>
   type_env::enter_scope(env)
   saved_in_fn = env.in_fn
   saved_fn_ret = env.cur_fn_ret
   saved_init = type_env::init_snapshot(env)
   env.in_fn = <+>
   env.cur_fn_ret = <-->
   env.init = type_env::new_init()
   param_uts = unify::UTypes()
   ?fe.params @ i =>
      pname = fe.params(i) | _ | ""
      is_coll = pname != "" && pname != "_" &&
         type_env::is_prelude_active(env, pname)
      is_coll
         |
            unify::add_error(ctx, 3033,
               "Cannot re-assign immutable binding '" + pname +
               "'. Use a prime suffix ('" + pname +
               "\'') for rebindable variables.")
      p_var = unify::fresh_var(ctx)
      param_uts += p_var
      ti_unk = ast::TypeInfo(Prim, ast::ValueType(Unknown))
      type_env::bind_local(env, pname, p_var, ti_unk, <->)
      pname != "" | type_env::init_mark_whole(env, pname)
   env.discard_result = is_disc
   body_te = annotate_expr(ctx, env, fe.body)
   type_env::init_restore(env, saved_init)
   env.in_fn = saved_in_fn
   env.cur_fn_ret = saved_fn_ret
   type_env::leave_scope(env)
   ret_ut = is_disc | unify::prim_unit() | body_te.ut
   fn_ut = unify::mk_fn(param_uts, ret_ut)
   ti = unify::type_info_from_utype(ctx, fn_ut)
   mk_lambda_te(fe.params, body_te, fn_ut, ti)

expr_is_jump: tast::TypedExpr => <>
expr_is_jump = te =>
   te.kind
      [CycleJump] <+>
      [Block b]
         n = ?b
         n > 0
            |
               last = b(n - 1) | _ | tast::mk_lit_unit(0, 0)
               expr_is_jump(last)
            | <->
      | <->

is_error_ut: unify::Ctx, unify::UType => <>
is_error_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c [Prim p] (p [Error]) | <->

is_ram_pn_ut: unify::Ctx, unify::UType => <unify::UType|>
is_ram_pn_ut = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Ram r]
         (r.pos.has_payload && !r.neg.has_payload)
            | <+ r.pos.ut ->

choice_check_ram_pn: unify::Ctx, tast::TypedBranches => <unify::UType|>
choice_check_ram_pn = ctx, tb_list =>
   all_pn' = <+>
   has_non_jump' = <->
   cand_pos = unify::fresh_var(ctx)
   ?tb_list @ i =>
      tb = tb_list(i) | _ | tast::TypedBranch((ast::GuardKind(Bare),
         tast::TypedExprs(), <-->, ast::Names(), ast::Names(),
         tast::mk_lit_unit(0, 0)))
      is_jump = expr_is_jump(tb.body) || is_error_ut(ctx, tb.body.ut)
      !is_jump
         |
            has_non_jump' = <+>
            pn_opt = is_ram_pn_ut(ctx, tb.body.ut)
            pn_opt
               | pay_ut =>
                  ok = unify::unify(ctx, cand_pos, pay_ut)
                  !ok
                     |
                        unify::add_error(ctx, 3084,
                           "Incompatible branch result types in choice")
                        all_pn' = <->
                        -->
               |
                  all_pn' = <->
                  -->
   has_non_jump' && all_pn'
      | <+ cand_pos ->

annotate_choice: unify::Ctx, type_env::TypeEnv,
   ast::ChoiceExpr, <> => tast::TypedExpr
annotate_choice = ctx, env, ch, is_disc =>
   ch.cond
      [Var v]
         bnd_opt = type_env::lookup_binding(env, "_")
         has_bnd = <>(bnd_opt)
         v == "_" && !has_bnd
            |
               unify::add_error(ctx, 3003,
                  "Omitting a Choice/pattern branch's leading condition is only allowed when '_' is already defined in the enclosing scope (e.g. inside a '=> '-omitted-param lambda, or a cycle body). '_' is not defined here.")
   cond_te = annotate_expr(ctx, env, ch.cond)
   tb_list = tast::TypedBranches()
   res_ut = unify::fresh_var(ctx)
   init_pre = type_env::init_snapshot(env)
   init_merged' = type_env::new_init()
   has_merged' = <->
   num_joins' = 0
   ?ch.branches @ i =>
      br = ch.branches(i) | _ | ast::ChoiceBranch((ast::GuardKind(Bare),
         ast::Exprs(), ast::Expr(Int, 0), ast::Names(), ast::Names(), <->,
         ast::Expr(Int, 0)))
      type_env::init_restore(env, type_env::init_snapshot_of(init_pre))
      c_cond = unify::canon(ctx, cond_te.ut)
      payload_ut' = unify::fresh_var(ctx)
      has_pay' = <->
      c_cond
         [Ram r]
            i == 0
               |
                  r.0.has_payload
                     | (payload_ut' = r.0.ut; has_pay' = <+>)
               |
                  r.1.has_payload
                     | (payload_ut' = r.1.ut; has_pay' = <+>)
         [Enum uenum]
            vname = br.variant_names(0) | _ | ""
            def_ev = unify::UEnumVariant(("", <->, unify::UType(None)))
            ?uenum.variants @ v_k =>
               v = uenum.variants(v_k) | _ | def_ev
               v.label == vname && v.has_payload
                  | (payload_ut' = v.payload_type; has_pay' = <+>; -->)
         |
            payload_ut' = cond_te.ut
            has_pay' = <->
      typed_cvs = tast::TypedExprs()
      ?br.case_values @ cv_i =>
         cv = br.case_values(cv_i) | _ | ast::Expr(Int, 0)
         cv_te = annotate_expr(ctx, env, cv)
         typed_cvs += cv_te
         c_cv = unify::canon(ctx, cv_te.ut)
         c_cv
            [Fn f_cv]
               ?f_cv.params > 0
                  |
                     p0_cv = f_cv.params(0) | _ | unify::UType(None)
                     unify::unify(ctx, cond_te.ut, p0_cv)
                  | unify::unify(ctx, cond_te.ut, cv_te.ut)
            | unify::unify(ctx, cond_te.ut, cv_te.ut)
      is_pred = br.kind [Predicate]
      pred_opt = is_pred
         |
            pred_te = annotate_expr(ctx, env, br.pred_fn)
            c_pred = unify::canon(ctx, pred_te.ut)
            c_pred
               [Fn f_pred]
                  ?f_pred.params > 0
                     |
                        p0 = f_pred.params(0) | _ | unify::UType(None)
                        unify::unify(ctx, cond_te.ut, p0)
            <+ pred_te ->
      type_env::enter_scope(env)
      pay_ti = unify::type_info_from_utype(ctx, payload_ut')
      type_env::bind_local(env, "_", payload_ut', pay_ti, <->)
      cur_bind_vars = br.bind_vars
      ?br.bind_vars @ bv_i =>
         bv = br.bind_vars(bv_i) | _ | ""
         bv != "" && bv != "_"
            |
               type_env::bind_local(env, bv, payload_ut', pay_ti, <->)
               type_env::init_mark_whole(env, bv)
      env.discard_result = is_disc
      body_te = has_pay'
         |
            br.block
               [Fn fe]
                  ?fe.params < 2
                     |
                        pname = fe.params(0) | _ | "_"
                        pname != "" && pname != "_"
                           |
                              type_env::bind_local(env, pname, payload_ut',
                                 pay_ti, <->)
                              type_env::init_mark_whole(env, pname)
                              cur_bind_vars += pname
                        env.discard_result = is_disc
                        annotate_expr(ctx, env, fe.body)
                     |
                        env.discard_result = is_disc
                        annotate_expr(ctx, env, br.block)
               |
                  vname = br.block [Var v] v | ""
                  is_var_bare = br.kind [Bare] && vname != "" && vname != "_"
                  bnd_opt = is_var_bare
                     | type_env::lookup_binding(env, vname)
                  is_fn_bnd = bnd_opt
                     | b =>
                        cb = unify::canon(ctx, b.ut)
                        cb [Fn _]
                     | <->
                  gen_opt = is_var_bare
                     | type_env::lookup_generic(env, vname)
                  is_gen = <>(gen_opt)
                  is_var_fn = is_var_bare && (is_fn_bnd || is_gen)
                  is_var_fn
                     |
                        type_env::bind_local(env, "_", payload_ut',
                           pay_ti, <->)
                        type_env::init_mark_whole(env, "_")
                        cargs = ast::Exprs()
                        cargs += ast::Expr(Var, "_")
                        call_e = ast::Expr(Call,
                           ast::CallExpr((vname, ast::Expr(Var, ""), cargs,
                              0, 0)))
                        annotate_expr(ctx, env, call_e)
                     | annotate_expr(ctx, env, br.block)
         |
            env.discard_result = is_disc
            annotate_expr(ctx, env, br.block)
      type_env::leave_scope(env)
      has_merged'
         | init_merged' = type_env::init_merge_two(init_merged', env.init)
         |
            init_merged' = type_env::init_snapshot(env)
            has_merged' = <+>
      is_jump = expr_is_jump(body_te) || is_error_ut(ctx, body_te.ut)
      !is_jump
         |
            num_joins' = num_joins' + 1
            ch.is_exhaustive && !is_disc
               |
                  ok = unify::unify(ctx, res_ut, body_te.ut)
                  !ok
                     |
                        unify::add_error(ctx, 3084,
                           "Incompatible branch result types in choice")
      tbr = tast::TypedBranch((br.kind, typed_cvs, pred_opt,
         br.variant_names, cur_bind_vars, body_te))
      tb_list += tbr
   has_merged' | type_env::init_restore(env, init_merged')
   final_ut' = unify::prim_unit()
   ch.is_exhaustive && !is_disc && num_joins' > 0
      | (final_ut' = res_ut)
      |
         !ch.is_exhaustive && !is_disc && num_joins' > 0
            |
               pn_check = choice_check_ram_pn(ctx, tb_list)
               pn_check
                  | pos_ut =>
                     ram_pn_ut = unify::ram_pn(pos_ut)
                     nb_br = ?ch.branches
                     last_br = nb_br > 0 | ch.branches(nb_br - 1)!! | ast::ChoiceBranch((
                        ast::GuardKind(Bare), ast::Exprs(), ast::Expr(Int, 0),
                        ast::Names(), ast::Names(), <->, ast::Expr(Int, 0)))
                     is_last_bare = last_br.kind [Bare]
                     already_has_fb = nb_br > 1 && is_last_bare
                     !already_has_fb
                        |
                           fb_ti = unify::type_info_from_utype(ctx, ram_pn_ut)
                           fb_lay = layout::compute_layout(ctx, ram_pn_ut)
                           fb_te = tast::mk_typed_ram_construct(
                              unify::URamShape(RamPN), <->, <-->,
                              ram_pn_ut, fb_ti, fb_lay, 0, 0)
                           tbr_fb = tast::TypedBranch((ast::GuardKind(Bare),
                              tast::TypedExprs(), <-->, ast::Names(),
                              ast::Names(), fb_te))
                           tb_list += tbr_fb
                           ch.branches += ast::ChoiceBranch((
                              ast::GuardKind(Bare), ast::Exprs(),
                              ast::Expr(Int, 0), ast::Names(), ast::Names(),
                              <->, ast::Expr(Variant, (ast::Tag(Noth),
                                 ast::Exprs()))))
                     final_ut' = ram_pn_ut
   ti = unify::type_info_from_utype(ctx, final_ut')
   lay = layout::compute_layout(ctx, final_ut')
   tast::mk_typed_expr(tast::TypedExprKind(Choice, (cond_te, tb_list)),
      final_ut', ti, lay, 0, 0)

is_splat_expr: ast::Expr => <ast::Expr|>
is_splat_expr = expr =>
   expr
      [Range r]
         !r.has_lhs && r.has_rhs | <+ r.rhs ->

annotate_record: unify::Ctx, type_env::TypeEnv,
   ast::RecordExpr => tast::TypedExpr
annotate_record = ctx, env, re =>
   tf_list' = tast::TypedFields()
   uf_list' = unify::UFields()
   cur_off' = 0
   ?re.fields @ i =>
      f = re.fields(i) | _ | ast::RecordField((<->, "", ast::Expr(Int, 0)))
      splat_opt = is_splat_expr(f.val)
      splat_opt
         | splat_rhs =>
            s_te = annotate_expr(ctx, env, splat_rhs)
            s_c = unify::canon(ctx, s_te.ut)
            s_c
               [Rec s_fields]
                  ?s_fields @ j =>
                     sf = s_fields(j) | _ |
                        unify::UField(("", unify::UType(None)))
                     sf_ti = unify::type_info_from_utype(ctx, sf.ut)
                     sf_lay = layout::compute_layout(ctx, sf.ut)
                     val_j = s_te.kind
                        [Record lit_fields]
                           j < ?lit_fields
                              | (lit_fields(j) | _ | tast::TypedField(("",
                                 tast::mk_lit_unit(0, 0), 0,
                                 unify::prim_unit()))).val
                              | tast::mk_typed_expr(tast::TypedExprKind(Member,
                                 (s_te, sf.name, j)), sf.ut, sf_ti, sf_lay, 0, 0)
                        | tast::mk_typed_expr(tast::TypedExprKind(Member,
                           (s_te, sf.name, j)), sf.ut, sf_ti, sf_lay, 0, 0)
                     tf = tast::TypedField((sf.name, val_j, cur_off', sf.ut))
                     tf_list' += tf
                     uf = unify::UField((sf.name, sf.ut))
                     uf_list' += uf
                     flay = layout::compute_layout(ctx, sf.ut)
                     f_align = flay.align < 1 | 1 | flay.align
                     cur_off' = layout::align_up(cur_off', f_align) + flay.size
               |
                  unify::add_error(ctx, 3084,
                     "Splat operator '..' requires a record operand")
         |
            f_te = annotate_expr(ctx, env, f.val)
            tf = tast::TypedField((f.name, f_te, cur_off', f_te.ut))
            tf_list' += tf
            uf = unify::UField((f.name, f_te.ut))
            uf_list' += uf
            flay = layout::compute_layout(ctx, f_te.ut)
            f_align = flay.align < 1 | 1 | flay.align
            cur_off' = layout::align_up(cur_off', f_align) + flay.size
   rec_ut = unify::mk_rec(uf_list')
   ti = unify::type_info_from_utype(ctx, rec_ut)
   lay = layout::compute_layout(ctx, rec_ut)
   tast::mk_typed_expr(tast::TypedExprKind(Record, tf_list'),
      rec_ut, ti, lay, 0, 0)

annotate_member_write: unify::Ctx, type_env::TypeEnv,
   ast::MemberExpr, ast::Expr, <> => tast::TypedExpr
annotate_member_write = ctx, env, mm, val_expr, is_compound =>
   saved_lvalue = env.in_lvalue
   env.in_lvalue = <+>
   target_te = annotate_expr(ctx, env, mm.target)
   env.in_lvalue = saved_lvalue
   rhs = annotate_expr(ctx, env, val_expr)
   root = member_root_str(mm.target)
   root != ""
      |
         fpath = root + "." + mm.field_name
         type_env::init_mark_written(env, fpath)
         root_var = member_root_name(mm.target)
         !member_has_module_access(mm.target) &&
            !type_env::is_marked_global(env, root_var)
            | type_env::init_mark_tracked(env, root_var)
   fld_ut = unify::fresh_var(ctx)
   unify::solve_field(ctx, target_te.ut, mm.field_name, fld_ut)
   is_compound
      |
         c_fld = unify::canon(ctx, fld_ut)
         c_fld
            [Prim p]
               is_bld = p [Builder]
               is_bld
                  |
                     c_rhs = unify::canon(ctx, rhs.ut)
                     ok_rhs' = <->
                     c_rhs
                        [Prim pr]
                           ok_rhs' = is_builder_append_prim(pr)
                        [Rec r]
                           ok_rhs' = is_builder_append_rec(ctx, r, 0, ?r)
                        [Var _]
                           ok_rhs' = <+>
                     !ok_rhs'
                        |
                           unify::add_error(ctx, 3084,
                              "Builder append requires byte or String")
                  |
                     fld_flag_int = is_flag_ut(ctx, fld_ut) &&
                        is_integerish_ut(ctx, rhs.ut)
                     ok = fld_flag_int || unify::unify(ctx, fld_ut, rhs.ut)
                     !ok
                        |
                           fld_msg = "Type mismatch in field assignment: " +
                              mm.field_name
                           unify::add_error(ctx, 3084, fld_msg)
            [Array arr]
               ok = unify::unify(ctx, arr.elem, rhs.ut)
               !ok
                  |
                     unify::add_error(ctx, 3084,
                        "Type mismatch in array append to field: " +
                        mm.field_name)
            |
               fld_flag_int = is_flag_ut(ctx, fld_ut) &&
                  is_integerish_ut(ctx, rhs.ut)
               ok = fld_flag_int || unify::unify(ctx, fld_ut, rhs.ut)
               !ok
                  |
                     fld_msg = "Type mismatch in field assignment: " +
                        mm.field_name
                     unify::add_error(ctx, 3084, fld_msg)
      |
         fld_flag_int = is_flag_ut(ctx, fld_ut) &&
            is_integerish_ut(ctx, rhs.ut)
         ok = fld_flag_int || unify::unify(ctx, fld_ut, rhs.ut)
         !ok
            |
               fld_msg = "Type mismatch in field assignment: " +
                  mm.field_name
               unify::add_error(ctx, 3084, fld_msg)
   c_tgt = unify::canon(ctx, target_te.ut)
   idx' = -1
   c_tgt
      [Rec r]
         idx' = unify::find_field_idx(r, mm.field_name)
   ti = unify::type_info_from_utype(ctx, unify::prim_unit())
   lay = tast::layout_void()
   tast::mk_typed_expr(tast::TypedExprKind(MemberWrite,
      (target_te, mm.field_name, idx', rhs)),
      unify::prim_unit(), ti, lay, mm.line, mm.col)

annotate_index_write: unify::Ctx, type_env::TypeEnv,
   ast::CallExpr, ast::Expr => tast::TypedExpr
annotate_index_write = ctx, env, cc, val_expr =>
   has_dot = cc.fn_name != "" &&
      (find_last_dot(cc.fn_name, ?cc.fn_name - 1) | d => d > 0 | <->)
   tgt_expr = has_dot | dotted_to_expr(cc.fn_name) |
      (cc.fn_name != "" | ast::Expr(Var, cc.fn_name) | cc.fn_target)
   target_te = annotate_expr(ctx, env, tgt_expr)
   first_arg = cc.args(0) | _ | ast::Expr(Int, 0)
   idx_te = annotate_expr(ctx, env, first_arg)
   rhs = annotate_expr(ctx, env, val_expr)
   c_tgt = unify::canon(ctx, target_te.ut)
   ret_ut' = unify::prim_unit()
   c_tgt
      [Prim p]
         p [Str, Builder]
            unify::add_error(ctx, 3067,
               "Cannot write through a String call-target '" + cc.fn_name +
               "(...)' — Strings are immutable and a Builder is written " +
               "with 'b + c'.")
      [Array arr]
         cc.fn_name != "" && type_env::init_is_tracked(env, cc.fn_name) &&
            !type_env::init_is_whole(env, cc.fn_name)
            |
               unify::add_error(ctx, 3131,
                  "Homogeneous record '" + cc.fn_name + "' requires whole-value initialization before element access.")
         unify::unify(ctx, idx_te.ut, unify::prim_int())
         ok_elem = unify::unify(ctx, arr.elem, rhs.ut)
         !ok_elem
            |
               unify::add_error(ctx, 3084,
                  "Type mismatch in array index assignment")
         ret_ut' = unify::ram_np(unify::prim_error())
      [Slice elem]
         cc.fn_name != "" && type_env::init_is_tracked(env, cc.fn_name) &&
            !type_env::init_is_whole(env, cc.fn_name)
            |
               unify::add_error(ctx, 3049,
                  "Cannot write element of forward-annotated slice '" + cc.fn_name + "' before whole-value initialization.")
         unify::unify(ctx, idx_te.ut, unify::prim_int())
         ok_elem = unify::unify(ctx, elem, rhs.ut)
         !ok_elem
            |
               unify::add_error(ctx, 3084,
                  "Type mismatch in slice index assignment")
      [Rec r]
         cc.fn_name != "" && type_env::init_is_tracked(env, cc.fn_name) &&
            !type_env::init_is_whole(env, cc.fn_name)
            |
               unify::add_error(ctx, 3131,
                  "Homogeneous record '" + cc.fn_name + "' requires whole-value initialization before element access.")
         !is_ufields_homogeneous(ctx, r)
            |
               unify::add_error(ctx, 3051,
                  "Dynamic indexing is only allowed on homogeneous records.")
         unify::unify(ctx, idx_te.ut, unify::prim_int())
         n_flds = ?r
         n_flds > 0
            |
               f0 = r(0) | _ |
                  unify::UField(("", unify::UType(None)))
               unify::unify(ctx, f0.ut, rhs.ut)
   ti = unify::type_info_from_utype(ctx, ret_ut')
   lay = layout::compute_layout(ctx, ret_ut')
   tast::mk_typed_expr(tast::TypedExprKind(IndexWrite,
      (target_te, idx_te, rhs)),
      ret_ut', ti, lay, cc.line, cc.col)

annotate_key_write: unify::Ctx, type_env::TypeEnv,
   ast::KeyAccessExpr, ast::Expr => tast::TypedExpr
annotate_key_write = ctx, env, ka, val_expr =>
   target_te = annotate_expr(ctx, env, ka.target)
   key_te = annotate_expr(ctx, env, ka.key)
   rhs = annotate_expr(ctx, env, val_expr)
   c_tgt = unify::canon(ctx, target_te.ut)
   c_tgt
      [Map m]
         unify::unify(ctx, m.key, key_te.ut)
         unify::unify(ctx, m.val, rhs.ut)
      |
         var_map = unify::mk_map(key_te.ut, rhs.ut)
         unify::unify(ctx, target_te.ut, var_map)
   ut = unify::prim_unit()
   ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   lay = tast::layout_void()
   tast::mk_typed_expr(tast::TypedExprKind(IndexWrite,
      (target_te, key_te, rhs)), ut, ti, lay, ka.line, ka.col)

annotate_raw_write: unify::Ctx, type_env::TypeEnv,
   ast::RawMemoryExpr, ast::Expr => tast::TypedExpr
annotate_raw_write = ctx, env, rm, val_expr =>
   rm.load_type
      [Unknown] 0
      |
         unify::add_error(ctx, 2093,
            "Cannot assign to a typed load; write through the untyped '@[addr]' form instead.")
   addr_te = annotate_expr(ctx, env, rm.addr)
   rhs = annotate_expr(ctx, env, val_expr)
   c_rhs = unify::canon(ctx, rhs.ut)
   ok_w = <->
   c_rhs
      [Prim p]
         p
            [Int, I8, I16, I32, U8, U16, U32, U64, Rune, Str, RawPtr, Error]
               ok_w = <+>
   !ok_w
      |
         unify::add_error(ctx, 3142,
            "Raw memory write '@[addr] = expr' requires an integerish or pointer value, got Float")
   ut = unify::prim_unit()
   ti = ast::TypeInfo(Prim, ast::ValueType(Unit))
   lay = tast::layout_void()
   tast::mk_typed_expr(tast::TypedExprKind(RawMemoryWrite,
      (addr_te, rhs)), ut, ti, lay, 0, 0)

// --- SCC Elaboration Helpers (Phase 5) --------------------------------------

find_assign_idx: ast::Exprs, String => Int
find_assign_idx = exprs, target_name =>
   idx' = -1
   ?exprs @ i =>
      e = exprs(i) | _ | ast::Expr(Int, 0)
      e
         [Assign a]
            a.0 == target_name && !is_fwd_assign(a) && !a.2
               |
                  idx' = i
                  -->
   idx'

active_swizzle_mode_at: ast::Exprs, Int => String
active_swizzle_mode_at = exprs, up_to =>
   mode' = ++"none"
   up_to @ i =>
      e = exprs(i) | _ | ast::Expr(Int, 0)
      e
         [SwizzlePragma m] (mode' = ++m)
   mode'

prebind_scc: unify::Ctx, type_env::TypeEnv, ast::Exprs, String => ()
prebind_scc = ctx, env, exprs, name =>
   bnd = type_env::lookup_local(env, name)
   bnd
      !|
         idx = find_assign_idx(exprs, name)
         idx !< 0
            |
               e = exprs(idx) | _ | ast::Expr(Int, 0)
               e
                  [Assign a]
                     a.5
                        [Fn fe]
                           ?fe.ct_params == 0
                              |
                                 p_uts = unify::UTypes()
                                 ?fe.params @ p_i =>
                                    p_uts += unify::fresh_var(ctx)
                                 ret_ut = unify::fresh_var(ctx)
                                 fn_ut = unify::mk_fn(p_uts, ret_ut)
                                 fn_ti = unify::type_info_from_utype(ctx,
                                    fn_ut)
                                 type_env::bind_local(env, name, fn_ut,
                                    fn_ti, a.1)

annotate_scc: unify::Ctx, type_env::TypeEnv, ast::Exprs, String, <> => ()
annotate_scc = ctx, env, exprs, name, is_recursive =>
   idx = find_assign_idx(exprs, name)
   idx !< 0
      |
         env.swizzle_mode = active_swizzle_mode_at(exprs, idx)
         e = exprs(idx) | _ | ast::Expr(Int, 0)
         e
            [Assign a]
               target_bnd = type_env::lookup_local(env, name)
               target_bnd
                  | tb =>
                     a.5
                        [Fn fe]
                           ?fe.ct_params == 0
                              |
                                 c_tb = unify::canon(ctx, tb.ut)
                                 c_tb
                                    [Fn f]
                                       can_cache = unify::is_ground(ctx,
                                          tb.ut)
                                       type_env::enter_scope(env)
                                       saved_in_fn = env.in_fn
                                       saved_fn_ret = env.cur_fn_ret
                                       saved_init = type_env::init_snapshot(
                                          env)
                                       env.in_fn = <+>
                                       env.cur_fn_ret = <+ f.ret ->
                                       env.init = type_env::new_init()
                                       ?fe.params @ p_i =>
                                          pname = fe.params(p_i) | _ | ""
                                          is_coll = pname != "" &&
                                             pname != "_" &&
                                             type_env::is_prelude_active(
                                                env, pname)
                                          is_coll
                                             |
                                                msg1 = "Cannot re-assign " +
                                                   "immutable binding '" +
                                                   pname + "'. Use a " +
                                                   "prime suffix ('" +
                                                   pname + "\'') for " +
                                                   "rebindable variables."
                                                unify::add_error(ctx,
                                                   3033, msg1)
                                          put = f.params(p_i) | _ |
                                             unify::UType(None)
                                          pname != ""
                                             |
                                                p_ti =
                                                   unify::type_info_from_utype(
                                                      ctx, put)
                                                type_env::bind_local(env,
                                                   pname, put, p_ti, <->)
                                                type_env::init_mark_whole(
                                                   env, pname)
                                       c_ret = unify::canon(ctx, f.ret)
                                       is_ret_unit' = <->
                                       c_ret
                                          [Prim p] (is_ret_unit' = p [Unit])
                                       env.discard_result = is_ret_unit'
                                       body_te = annotate_expr(ctx, env,
                                          fe.body)
                                       is_view_expr(fe.body)
                                          | unify::add_error(ctx, 3150,
                                             "View cannot escape function frame")
                                       can_cache
                                          | type_env::cache_fn_body(env, name,
                                               body_te)
                                       type_env::init_restore(env, saved_init)
                                       env.in_fn = saved_in_fn
                                       env.cur_fn_ret = saved_fn_ret
                                       type_env::leave_scope(env)
                                       ok_ret = is_ret_unit' ||
                                          unify::unify(ctx, f.ret, body_te.ut)
                                       !ok_ret
                                          |
                                             unify::add_error(ctx, 3084,
                                                "Return type mismatch in " +
                                                "function: " + name)
                                       type_env::init_mark_whole(env, name)
                                       is_recursive && !has_name_in(declared_fns, name)
                                          |
                                             c_ret_chk = unify::canon(ctx, f.ret)
                                             !unify::is_ground(ctx, c_ret_chk)
                                                |
                                                   unify::add_error(ctx, 3103,
                                                      "Return type of function '" +
                                                      name + "' could not be statically determined")

solve_unconstrained_rams: unify::Ctx, unify::UType => ()
solve_unconstrained_rams = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Ram r]
         r.pos.has_payload
            |
               c_pos = unify::canon(ctx, r.pos.ut)
               c_pos
                  [Var vid] unify::bind_var(ctx, vid, unify::prim_unit())
                  | solve_unconstrained_rams(ctx, r.pos.ut)
         r.neg.has_payload
            |
               c_neg = unify::canon(ctx, r.neg.ut)
               c_neg
                  [Var vid2] unify::bind_var(ctx, vid2, unify::prim_unit())
                  | solve_unconstrained_rams(ctx, r.neg.ut)
      [Rec r_flds]
         ?r_flds @ i =>
            fld = r_flds(i) | _ | unify::UField(("", unify::UType(None)))
            solve_unconstrained_rams(ctx, fld.ut)

check_ground: unify::Ctx, type_env::TypeEnv, ast::Exprs, String => ()
check_ground = ctx, env, exprs, name =>
   target_bnd = type_env::lookup_local(env, name)
   target_bnd
      |
         tb = _
         solve_unconstrained_rams(ctx, tb.ut)
         c = unify::canon(ctx, tb.ut)
         idx = find_assign_idx(exprs, name)
         idx !< 0
            |
               e = exprs(idx) | _ | ast::Expr(Int, 0)
               e
                  [Assign a]
                     a.5
                        [Fn fe]
                           c
                              [Fn f]
                                 ?fe.ct_params == 0
                                    |
                                       all_p_ok' = <+>
                                       ?f.params @ p_i =>
                                          p = f.params(p_i) | _ |
                                             unify::UType(None)
                                          !unify::is_ground(ctx, p)
                                             |
                                                all_p_ok' = <->
                                                -->
                                       !all_p_ok'
                                          |
                                             unify::add_error(ctx, 3128,
                                                "Unannotated function " +
                                                "parameter type cannot be " +
                                                "statically inferred for '" +
                                                name + "'")
                                       all_p_ok'
                                          |
                                             ret_ok = unify::is_ground(
                                                ctx, f.ret)
                                             !ret_ok
                                                |
                                                   unify::add_error(ctx,
                                                      3103,
                                                      "Cannot infer " +
                                                      "concrete return " +
                                                      "type for function '" +
                                                      name +
                                                      "' without RTTI")
                              |
                                 c_fn_ok = unify::is_ground(ctx, c)
                                 !c_fn_ok
                                    |
                                       unify::add_error(ctx, 3103,
                                          "Cannot infer concrete type for " +
                                          "expression without RTTI")
                        |
                           c
                              [Fn f_val]
                                 ret_ok = unify::is_ground(ctx, f_val.ret)
                                 !ret_ok
                                    |
                                       unify::add_error(ctx, 3103,
                                          "Cannot infer concrete return " +
                                          "type for function '" + name +
                                          "' without RTTI")
                              |
                                 c_val_ok = unify::is_ground(ctx, c)
                                 !c_val_ok
                                    |
                                       unify::add_error(ctx, 3103,
                                          "Cannot infer concrete type for " +
                                          "expression without RTTI")

register_foreign_decl: type_env::TypeEnv, ast::ForeignFnDecl => ()
register_foreign_decl = env, f =>
   is_ret_rec = f.return_type [Record]
   is_ret_unit = f.return_type [Unit]
   ret_ut0 = is_ret_unit | unify::prim_unit() |
      unify::UType(Prim, unify::vt_to_uprim(f.return_type))
   ret_ut = is_ret_rec | utype_from_ti_env(env, f.ret_record_info) |
      ret_ut0
   ret_ti = is_ret_rec | f.ret_record_info |
      ast::TypeInfo(Prim, f.return_type)
   f.is_variable
      |
         type_env::bind_local(env, f.dva_name, ret_ut, ret_ti, <->)
         type_env::init_mark_whole(env, f.dva_name)
      |
         param_uts = unify::UTypes()
         ?f.params @ i =>
            p = f.params(i) | _ | ast::ForeignFnParam(("",
               ast::ValueType(Unknown),
               ast::TypeInfo(Prim, ast::ValueType(Unknown))))
            is_rec = p.param_type [Record]
            p_ut = is_rec | utype_from_ti_env(env, p.record_info) |
               unify::UType(Prim, unify::vt_to_uprim(p.param_type))
            param_uts += p_ut
         fn_ut = unify::UType(Fn, unify::UFn((param_uts, ret_ut)))
         type_env::bind_local(env, f.dva_name, fn_ut,
            ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

register_enum_variants: type_env::TypeEnv, String, unify::UType => ()
register_enum_variants = env, td_name, td_ut =>
   td_ti = ast::TypeInfo(TypeVar, td_name)
   td_ut
      [Enum uenum]
         ?uenum.variants @ v_i =>
            v = uenum.variants(v_i) | _ |
               unify::UEnumVariant(("", <->, unify::UType(None)))
            v.label != ""
               |
                  v.has_payload
                     |
                        f_params = unify::UTypes()
                        f_params += v.payload_type
                        fn_ut = unify::mk_fn(f_params, td_ut)
                        type_env::bind_local(env, v.label, fn_ut, td_ti, <->)
                        type_env::bind_local(env, td_name + "::" + v.label,
                           fn_ut, td_ti, <->)
                     |
                        type_env::bind_local(env, v.label, td_ut, td_ti, <->)
                        type_env::bind_local(env, td_name + "::" + v.label,
                           td_ut, td_ti, <->)

#type ElabStats (
   num_stmts: Int,
   num_nodes: Int,
   solved_vars: Int,
   total_layout_size: Int
)

count_target_nodes: <tast::TypedExpr|> => Int
count_target_nodes = opt =>
   opt | tgt => count_expr_nodes(tgt) | 0

count_expr_nodes: tast::TypedExpr => Int

count_expr_list: tast::TypedExprs => Int
count_expr_list = exprs =>
   total' = 0
   ?exprs @ i =>
      e = exprs(i) | _ | tast::mk_lit_unit(0, 0)
      total' = total' + count_expr_nodes(e)
   total'

count_record_fields: tast::TypedFields => Int
count_record_fields = fields =>
   total' = 0
   ?fields @ i =>
      f = fields(i) | _ | tast::TypedField(("", tast::mk_lit_unit(0, 0),
         0, unify::UType(None)))
      total' = total' + count_expr_nodes(f.val)
   total'

count_choice_branches: tast::TypedBranches => Int
count_choice_branches = branches =>
   total' = 0
   ?branches @ i =>
      br = branches(i) | _ | tast::TypedBranch((ast::GuardKind(Bare),
         tast::TypedExprs(), <-->, ast::Names(), ast::Names(),
         tast::mk_lit_unit(0, 0)))
      total' = total' + count_expr_nodes(br.body)
   total'

count_expr_nodes = te =>
   count' = 1
   te.kind
      [Bin b]
         count' = count' + count_expr_nodes(b.1) + count_expr_nodes(b.2)
      [Unary u]
         count' = count' + count_expr_nodes(u.1)
      [Call c]
         count' = count' + count_target_nodes(c.1) + count_expr_list(c.2)
      [Record r]
         count' = count' + count_record_fields(r)
      [Member m]
         count' = count' + count_expr_nodes(m.0)
      [MemberWrite mw]
         count' = count' + count_expr_nodes(mw.0) + count_expr_nodes(mw.3)
      [Index idx]
         count' = count' + count_expr_nodes(idx.0) + count_expr_nodes(idx.1)
      [KeyAccess ka]
         count' = count' + count_expr_nodes(ka.0) + count_expr_nodes(ka.1)
      [IndexWrite iw]
         count' = count' + count_expr_nodes(iw.0) + count_expr_nodes(iw.1) +
            count_expr_nodes(iw.2)
      [Choice ch]
         count' = count' + count_expr_nodes(ch.0) + count_choice_branches(ch.1)
      [Lambda lm]
         count' = count' + count_expr_nodes(lm.1)
      [Block bk]
         count' = count' + count_expr_list(bk)
      [Assign a]
         count' = count' + count_expr_nodes(a.5)
      [Cycle cy]
         count' = count' + count_expr_nodes(cy.0) + count_expr_nodes(cy.1)
         count' = count' + count_target_nodes(cy.2)
      [BuilderNew bn]
         count' = count' + count_expr_nodes(bn)
      [Copy cp]
         count' = count' + count_expr_nodes(cp)
      [RawMemory rm]
         count' = count' + count_expr_nodes(rm.0)
      [RawMemoryWrite rmw]
         count' = count' + count_expr_nodes(rmw.0) + count_expr_nodes(rmw.1)
      [MapLiteral ml]
         ?ml @ i =>
            pr = ml(i) | _ | tast::TypedMapPair((tast::mk_lit_unit(0, 0),
               tast::mk_lit_unit(0, 0)))
            count' = count' + count_expr_nodes(pr.key) +
               count_expr_nodes(pr.val)
      [Exit e]
         count' = count' + count_expr_nodes(e)
   count'

count_program_nodes: tast::TypedProgram => Int
count_program_nodes = prog =>
   total' = 0
   ?prog.stmts @ i =>
      st = prog.stmts(i) | _ | tast::TypedStmt(Expr, tast::mk_lit_unit(0, 0))
      st
         [Expr te]
            total' = total' + count_expr_nodes(te)
         | total' = total' + 1
   total'

program_layout_size: tast::TypedProgram => Int
program_layout_size = prog =>
   total' = 0
   ?prog.stmts @ i =>
      st = prog.stmts(i) | _ | tast::TypedStmt(Expr, tast::mk_lit_unit(0, 0))
      st
         [Expr te]
            total' = total' + te.layout.size
   total'

print_elab_stats: ElabStats => ()
print_elab_stats = stats =>
   print $ "=== Typed AST Elaboration Statistics ==="
   print $ "  Statements:            " + str::from_int(stats.num_stmts)
   print $ "  Typed nodes:           " + str::from_int(stats.num_nodes)
   print $ "  Type variables solved: " + str::from_int(stats.solved_vars)
   print $ "  Total layout size:     " +
      str::from_int(stats.total_layout_size) + " bytes"

print_program_errors: unify::TypeErrors => ()
print_program_errors = errs =>
   ?errs @ i =>
      err_res = errs(i)
      err_res | err =>
         print $ unify::format_error(err)

#type ElabProgCtx (prog: tast::TypedProgram, ctx: unify::Ctx)
#type ElabSuccess (
   prog: tast::TypedProgram,
   stats: ElabStats,
   ctx: unify::Ctx
)
#type ElabProgResult < ElabSuccess | unify::TypeErrors >

refresh_typed_expr: unify::Ctx, tast::TypedExpr => tast::TypedExpr

refresh_target: unify::Ctx, <tast::TypedExpr|> => <tast::TypedExpr|>
refresh_target = ctx, opt =>
   opt
      | tgt => <+ refresh_typed_expr(ctx, tgt) ->

refresh_expr_list: unify::Ctx, tast::TypedExprs => tast::TypedExprs
refresh_expr_list = ctx, exprs =>
   res = tast::TypedExprs()
   ?exprs @ i =>
      e = exprs(i) | _ | tast::mk_lit_unit(0, 0)
      res += refresh_typed_expr(ctx, e)
   res

refresh_record_fields: unify::Ctx, tast::TypedFields => tast::TypedFields
refresh_record_fields = ctx, fields =>
   res = tast::TypedFields()
   ?fields @ i =>
      f = fields(i) | _ | tast::TypedField(("", tast::mk_lit_unit(0, 0),
         0, unify::UType(None)))
      ref_val = refresh_typed_expr(ctx, f.val)
      res += tast::TypedField((f.name, ref_val, f.offset, ref_val.ut))
   res

refresh_choice_branches: unify::Ctx, tast::TypedBranches => tast::TypedBranches
refresh_choice_branches = ctx, branches =>
   res = tast::TypedBranches()
   ?branches @ i =>
      br = branches(i) | _ | tast::TypedBranch((ast::GuardKind(Bare),
         tast::TypedExprs(), <-->, ast::Names(), ast::Names(),
         tast::mk_lit_unit(0, 0)))
      ref_body = refresh_typed_expr(ctx, br.body)
      res += tast::TypedBranch((br.kind, br.case_values, br.pred_fn,
         br.variant_names, br.bind_vars, ref_body))
   res

refresh_map_pairs: unify::Ctx, tast::TypedMapPairs => tast::TypedMapPairs
refresh_map_pairs = ctx, pairs =>
   res = tast::TypedMapPairs()
   ?pairs @ i =>
      pr = pairs(i) | _ | tast::TypedMapPair((tast::mk_lit_unit(0, 0),
         tast::mk_lit_unit(0, 0)))
      res += tast::TypedMapPair((refresh_typed_expr(ctx, pr.key),
         refresh_typed_expr(ctx, pr.val)))
   res

refresh_typed_expr = ctx, te =>
   c_ut = unify::canon(ctx, te.ut)
   is_named_ti = te.ti [TypeVar tv] tv != "" | <->
   is_bf_ti = te.ti [Bitfield _]
   is_packed_ti = te.ti [Rec r] r.5 | <->
   keep_ti = is_named_ti || is_bf_ti || is_packed_ti
   new_ti = keep_ti
      | te.ti
      | unify::type_info_from_utype(ctx, c_ut)
   new_lay = layout::compute_layout(ctx, c_ut)
   new_kind = te.kind
      [Bin b]
         tast::TypedExprKind(Bin, (b.0, refresh_typed_expr(ctx, b.1),
            refresh_typed_expr(ctx, b.2)))
      [Unary u]
         tast::TypedExprKind(Unary, (u.0, refresh_typed_expr(ctx, u.1)))
      [Call c]
         tast::TypedExprKind(Call, (c.0, refresh_target(ctx, c.1),
            refresh_expr_list(ctx, c.2)))
      [Record r]
         tast::TypedExprKind(Record, refresh_record_fields(ctx, r))
      [Member m]
         tgt = refresh_typed_expr(ctx, m.0)
         c_tgt = unify::canon(ctx, tgt.ut)
         idx' = m.2
         need_idx = idx' < 0 || m.1 != ""
         need_idx
            |
               c_tgt
                  [Rec r]
                     ri = unify::find_field_idx(r, m.1)
                     ri !< 0 | (idx' = ri)
         tast::TypedExprKind(Member, (tgt, m.1, idx'))
      [MemberWrite mw]
         tgt = refresh_typed_expr(ctx, mw.0)
         c_tgt = unify::canon(ctx, tgt.ut)
         idx' = mw.2
         need_idx = idx' < 0 || mw.1 != ""
         need_idx
            |
               c_tgt
                  [Rec r]
                     ri = unify::find_field_idx(r, mw.1)
                     ri !< 0 | (idx' = ri)
         tast::TypedExprKind(MemberWrite, (tgt, mw.1, idx',
            refresh_typed_expr(ctx, mw.3)))
      [Index idx']
         tast::TypedExprKind(Index, (refresh_typed_expr(ctx, idx'.0),
            refresh_typed_expr(ctx, idx'.1)))
      [KeyAccess ka]
         tast::TypedExprKind(KeyAccess, (refresh_typed_expr(ctx, ka.0),
            refresh_typed_expr(ctx, ka.1), ka.2, ka.3))
      [IndexWrite iw]
         tast::TypedExprKind(IndexWrite, (refresh_typed_expr(ctx, iw.0),
            refresh_typed_expr(ctx, iw.1), refresh_typed_expr(ctx, iw.2)))
      [Choice ch]
         tast::TypedExprKind(Choice, (refresh_typed_expr(ctx, ch.0),
            refresh_choice_branches(ctx, ch.1)))
      [Lambda lm]
         tast::TypedExprKind(Lambda, (lm.0, refresh_typed_expr(ctx, lm.1),
            lm.2))
      [Block bk]
         tast::TypedExprKind(Block, refresh_expr_list(ctx, bk))
      [Assign a]
         tast::TypedExprKind(Assign, (a.0, a.1, a.2, a.3, a.4,
            refresh_typed_expr(ctx, a.5)))
      [Cycle cy]
         tast::TypedExprKind(Cycle, (refresh_typed_expr(ctx, cy.0),
            refresh_typed_expr(ctx, cy.1), refresh_target(ctx, cy.2), cy.3))
      [BuilderNew bn]
         tast::TypedExprKind(BuilderNew, refresh_typed_expr(ctx, bn))
      [Copy cp]
         tast::TypedExprKind(Copy, refresh_typed_expr(ctx, cp))
      [RawMemory rm]
         tast::TypedExprKind(RawMemory, (refresh_typed_expr(ctx, rm.0), rm.1))
      [RawMemoryWrite rmw]
         tast::TypedExprKind(RawMemoryWrite, (refresh_typed_expr(ctx, rmw.0),
            refresh_typed_expr(ctx, rmw.1)))
      [MapLiteral ml]
         tast::TypedExprKind(MapLiteral, refresh_map_pairs(ctx, ml))
      [RamConstruct rc]
         rc_tgt = refresh_target(ctx, rc.2)
         tast::TypedExprKind(RamConstruct, (rc.0, rc.1, rc_tgt))
      [EnumConstruct ec]
         ec_tgt = refresh_target(ctx, ec.1)
         tast::TypedExprKind(EnumConstruct, (ec.0, ec_tgt))
      [Exit e]
         tast::TypedExprKind(Exit, refresh_typed_expr(ctx, e))
      | te.kind
   tast::TypedExpr((new_kind, c_ut, new_ti, new_lay, te.line, te.col))

refresh_program_stmts: unify::Ctx, tast::TypedStmts => tast::TypedStmts
refresh_program_stmts = ctx, stmts =>
   final_stmts = tast::TypedStmts()
   ?stmts @ i_fin =>
      stmt = stmts(i_fin) | _ | tast::TypedStmt(Expr,
         tast::mk_lit_unit(0, 0))
      stmt
         [Expr te]
            final_stmts += tast::TypedStmt(Expr, refresh_typed_expr(ctx, te))
         [Binding b]
            ref_e = refresh_typed_expr(ctx, b.2)
            final_stmts += tast::TypedStmt(Binding, (b.0, ref_e.ti, ref_e, b.3))
         [GlobalBinding gb]
            ref_e = refresh_typed_expr(ctx, gb.2)
            final_stmts += tast::TypedStmt(GlobalBinding,
               (gb.0, ref_e.ti, ref_e))
         | final_stmts += stmt
   final_stmts

elaborate_program_with_ctx: ast::Exprs => < ElabProgCtx | unify::TypeErrors >
elaborate_program_with_ctx = exprs =>
   ctx = unify::new_ctx()
   env = type_env::new_env()
   view_vars ::= ast::Names()
   declared_fns ::= ast::Names()
   called_fns ::= ast::Names()
   user_fns ::= ast::Names()
   value_used_fns ::= ast::Names()
   fn_alias_vars ::= ast::Names()
   fn_alias_tgts ::= ast::Names()

   // 1a. Pre-register user type names (enables recursive & mutual types)
   ?exprs @ i_td0 =>
      e_td0 = exprs(i_td0) | _ | ast::Expr(Int, 0)
      e_td0
         [TypeDecl td0]
            td0_mod = type_env::decl_module(td0.name, 0)
            type_env::set_current_module(env, td0_mod)
            is_enum0 = td0.type_info [Enum _]
            init_ut = is_enum0
               |
                  unify::UType(Enum, unify::UEnum((td0.name,
                     unify::UEnumVariants())))
               | unify::fresh_var(ctx)
            type_env::bind_user_type(env, td0.name, td0.type_info, init_ut)

   // 1b. Multi-pass type resolution for forward & mutually recursive types
   3 @ _pass =>
      ?exprs @ i_td =>
         e_td = exprs(i_td) | _ | ast::Expr(Int, 0)
         e_td
            [TypeDecl td]
               type_env::set_current_module(env,
                  type_env::decl_module(td.name, 0))
               td_ut_raw = utype_from_ti_env(env, td.type_info)
               td_ut' = td_ut_raw
               td_ut_raw
                  [Enum ue]
                     td_ut' = unify::UType(Enum, unify::UEnum((td.name,
                        ue.variants)))
               old_def = type_env::lookup_user_type_exact(env, td.name)
               old_def
                  | od => unify::unify(ctx, od.ut, td_ut')
               type_env::bind_user_type(env, td.name, td.type_info, td_ut')

   // 1c. Register enum variants
   ?exprs @ i_ev =>
      e_ev = exprs(i_ev) | _ | ast::Expr(Int, 0)
      e_ev
         [TypeDecl td_ev]
            ev_opt = type_env::lookup_user_type(env, td_ev.name)
            ev_opt
               | udef => register_enum_variants(env, td_ev.name, udef.ut)

   gen_names = ast::Names()
   ?exprs @ i_scan =>
      e_scan = exprs(i_scan) | _ | ast::Expr(Int, 0)
      e_scan
         [Assign ascan]
            ascan.3 && ascan.0 != ""
               | type_env::mark_global_var(env, ascan.0)
            is_fe = ascan.5 [Fn fes] (?fes.ct_params > 0) | <->
            is_gen = is_generic_sig(ascan) || is_fe
            is_gen && ascan.0 != "" | gen_names += ascan.0

   ?exprs @ i_decl =>
      e_decl = exprs(i_decl) | _ | ast::Expr(Int, 0)
      e_decl
         [Assign a]
            type_env::set_current_module(env, type_env::decl_module(a.0, 0))
            is_fwd_assign(a)
               |
                  has_prior = a.0 != "" &&
                     (has_name_in(declared_fns, a.0) ||
                      has_name_in(user_fns, a.0) ||
                      <>(type_env::lookup_binding(env, a.0)))
                  has_prior
                     |
                        unify::add_error(ctx, 3033,
                           "Cannot re-assign immutable binding '" + a.0 +
                           "'. Use a prime suffix ('" + a.0 +
                           "\'') for rebindable variables.")
                  is_generic_sig(a)
                     |
                        a.0 != "" | declared_fns += a.0
                        type_env::bind_generic(env, a.0, a.8)
                     |
                        decl_ut = utype_from_ti_env(env, a.8)
                        is_g = a.3 || type_env::is_marked_global(env, a.0)
                        is_g
                           | type_env::bind_global(env, a.0, decl_ut, a.8)
                           | type_env::bind_local(env, a.0, decl_ut, a.8, a.1)
                        c_decl = unify::canon(ctx, decl_ut)
                        is_fn = c_decl [Fn _]
                        is_fn && a.0 != "" | declared_fns += a.0
                        is_bf = is_bitfield_ti_env(env, a.8)
                        is_growable = is_growable_ti_env(env, a.8)
                        is_bf || is_growable
                           | type_env::init_mark_whole(env, a.0)
                           |
                              !is_fn && !is_g
                                 |
                                    type_env::init_mark_tracked(env, a.0)
                                    mark_bitfield_fields_whole(env, a.0, a.8)
               |
                  !a.2 && !a.4
                     |
                        a.5
                           [Fn fe]
                              a.0 != "" && has_name_in(user_fns, a.0)
                                 |
                                    msg_rf = "Cannot re-assign " +
                                       "immutable binding '" + a.0 +
                                       "'. Use a prime suffix ('" + a.0 +
                                       "\'') for rebindable variables."
                                    unify::add_error(ctx, 3033, msg_rf)
                                 |
                                    a.0 != "" | (user_fns += a.0)
                                    ?fe.ct_params > 0
                                       |
                                          p_vinfos = ast::VInfos()
                                          ?fe.params @ p_k =>
                                             p_ti = ast::TypeInfo(TypeVar, "T")
                                             p_vinfos += p_ti
                                          ti_ret =
                                             ast::TypeInfo(TypeVar, "?Ret")
                                          fn_ti = ast::TypeInfo(Fn,
                                             (ast::VTypes(), p_vinfos,
                                              ast::ValueType(Unknown),
                                              ti_ret, ast::CParams()))
                                          type_env::bind_generic(env,
                                             a.0, fn_ti)
                           |
                              already = type_env::lookup_local(env, a.0)
                              has_already = <>(already)
                              is_coll = a.0 != "" && has_name_in(user_fns, a.0)
                              is_coll
                                 |
                                    msg_rc = "Cannot re-assign " +
                                       "immutable binding '" + a.0 +
                                       "'. Use a prime suffix ('" + a.0 +
                                       "\'') for rebindable variables."
                                    unify::add_error(ctx, 3033, msg_rc)
                              is_lit = a.5 [Int, Float, Str, Rune]
                              is_mod = type_env::name_is_qualified(a.0, 0)
                              can_pre = !has_already && !is_coll &&
                                 (is_lit || is_mod) && a.0 != ""
                              can_pre
                                 |
                                    rhs = annotate_expr(ctx, env, a.5)
                                    type_env::bind_local(env, a.0, rhs.ut,
                                       rhs.ti, a.1)
         [Foreign f]
            f_mod = type_env::decl_module(f.dva_name, 0)
            type_env::set_current_module(env, f_mod)
            register_foreign_decl(env, f)

   // 2. Build dependency graph and partition into SCCs
   graph = dep_graph::build_dep_graph(exprs)
   sccs = dep_graph::tarjan_scc(graph)

   // 3. Process SCCs in reverse topological order (leaf-first)
   ?sccs @ s_i =>
      scc = sccs(s_i) | _ | dep_graph::SCC((ast::Names(), <->))
      ?scc.names @ n_i =>
         fname1 = scc.names(n_i) | _ | ""
         fname1 != "" && !dep_graph::has_name(gen_names, fname1)
            |
               m1 = type_env::decl_module(fname1, 0)
               type_env::set_current_module(env, m1)
               prebind_scc(ctx, env, exprs, fname1)
      ?scc.names @ n_j =>
         fname2 = scc.names(n_j) | _ | ""
         fname2 != "" && !dep_graph::has_name(gen_names, fname2)
            |
               m2 = type_env::decl_module(fname2, 0)
               type_env::set_current_module(env, m2)
               annotate_scc(ctx, env, exprs, fname2, scc.is_recursive)

   // 4. Elaborate all program statements
   env.swizzle_mode = active_swizzle_mode_at(exprs, 0)
   typed_stmts = tast::TypedStmts()
   ?exprs @ i_stmt =>
      e_stmt = exprs(i_stmt) | _ | ast::Expr(Int, 0)
      is_skip' = <->
      e_stmt
         [Assign a_stmt]
            a_mod = type_env::decl_module(a_stmt.0, 0)
            type_env::set_current_module(env, a_mod)
            is_fwd = is_fwd_assign(a_stmt)
            is_gen = dep_graph::has_name(gen_names, a_stmt.0)
            (is_fwd || is_gen) | (is_skip' = <+>)
         [Foreign f_stmt]
            f_mod2 = type_env::decl_module(f_stmt.dva_name, 0)
            type_env::set_current_module(env, f_mod2)
            is_skip' = <+>
         [TypeDecl td_stmt]
            td_mod = type_env::decl_module(td_stmt.name, 0)
            type_env::set_current_module(env, td_mod)
            is_skip' = <+>
      !is_skip'
         |
            env.discard_result = <+>
            te = annotate_expr(ctx, env, e_stmt)
            solve_unconstrained_rams(ctx, te.ut)
            te.kind [UserDiag _]
               | unify::unify(ctx, te.ut, unify::prim_unit())
            ground_ok = unify::is_ground(ctx, te.ut)
            !ground_ok
               |
                  unify::add_error(ctx, 3103,
                     "Cannot infer concrete type for expression without RTTI")
            typed_stmts += tast::TypedStmt(Expr, te)

   // 4.5. Solve deferred constraints (e.g. calls/indexing on type variables)
   unify::solve_constraints(ctx, ctx.constraints)

   // 5. Check that all function parameters in SCCs are ground
   ?sccs @ s_k =>
      scc_k = sccs(s_k) | _ | dep_graph::SCC((ast::Names(), <->))
      ?scc_k.names @ n_k =>
         fname3 = scc_k.names(n_k) | _ | ""
         fname3 != "" && !dep_graph::has_name(gen_names, fname3)
            |
               m3 = type_env::decl_module(fname3, 0)
               type_env::set_current_module(env, m3)
               check_ground(ctx, env, exprs, fname3)
   ?fn_alias_vars @ _ =>
      ?fn_alias_vars @ ai =>
         avn = fn_alias_vars(ai) | _ | ""
         has_name_in(called_fns, avn)
            |
               tgt = fn_alias_tgts(ai) | _ | ""
               tgt != "" && !has_name_in(called_fns, tgt)
                  | (called_fns += tgt)
   ?value_used_fns @ vi =>
      vfn = value_used_fns(vi) | _ | ""
      vfn != "" && !has_name_in(declared_fns, vfn) && !has_name_in(called_fns, vfn)
         |
            unify::add_error(ctx, 3128,
               "Function '" + vfn + "' is used as a value but its parameter types cannot be determined — no declared signature and no call site to infer from. Declare a signature: '" + vfn + ": T1, T2 => R'.")

   final_stmts = refresh_program_stmts(ctx, typed_stmts)

   unify::has_errors(ctx)
      | <- ctx.errors ->
      | <+ ElabProgCtx((tast::TypedProgram(final_stmts), ctx)) +>

elaborate_program: ast::Exprs => < tast::TypedProgram | unify::TypeErrors >
elaborate_program = exprs =>
   res = elaborate_program_with_ctx(exprs)
   res
      | pair => <+ pair.prog +>
      | errs => <- errs ->

annotate_exprs: ast::Exprs => ElabProgResult
annotate_exprs = exprs =>
   res = elaborate_program_with_ctx(exprs)
   res
      | pair =>
         tp = pair.prog
         ctx = pair.ctx
         nodes = count_program_nodes(tp)
         sz = program_layout_size(tp)
         stats = ElabStats((?tp.stmts, nodes, ctx.next_var, sz))
         <+ ElabSuccess((tp, stats, ctx)) +>
      | errs =>
         <- errs ->

annotate_program: ast::Expr => ElabProgResult
annotate_program = prog =>
   exprs' = ast::Exprs()
   prog
      [Block b]
         exprs' = b.exprs
      | exprs' += prog
   annotate_exprs(exprs')
