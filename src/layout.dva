// selfhost/src/layout.dva — Static type layout and size computation.
//
// Computes byte size, alignment, and field offsets for Dva types without
// relying on LLVM data layout calls. Part of Milestone 2 (Phase 2).

#use "ast"
#use "unify"
#use "tast"

#public

target_triple = ""

set_target_triple: String => ()
set_target_triple = t =>
   target_triple ::= t

is_32bit_triple: String => <>
is_32bit_triple = triple =>
   n = ?triple
   (n !< 5 && triple(..5) == "arm64")
      | <->
      |
         (n !< 6 && triple(..6) == "wasm32") ||
            (n !< 4 && triple(..4) == "wasm") ||
            (n !< 4 && triple(..4) == "i386") ||
            (n !< 4 && triple(..4) == "i486") ||
            (n !< 4 && triple(..4) == "i586") ||
            (n !< 4 && triple(..4) == "i686") ||
            (n !< 5 && triple(..5) == "armv7") ||
            (n !< 5 && triple(..5) == "armv6") ||
            (n !< 5 && triple(..5) == "thumb") ||
            (n !< 7 && triple(..7) == "riscv32") ||
            (n !< 3 && triple(..3) == "arm")

is_32bit_target: () => <>
is_32bit_target = !=>
   is_32bit_triple(target_triple)

align_up: Int, Int => Int
align_up = offset, align =>
   align !> 1
      | offset
      | (offset + align - 1) / align * align

compute_prim_layout: unify::UPrim => tast::TypedLayout
compute_prim_layout = p =>
   ptr_sz = is_32bit_target! | 4 | 8
   ptr_align = is_32bit_target! | 4 | 8
   p
      [Int] tast::layout_scalar(8, 8)
      [I8] tast::layout_scalar(1, 1)
      [I16] tast::layout_scalar(2, 2)
      [I32] tast::layout_scalar(4, 4)
      [I64] tast::layout_scalar(8, 8)
      [U8] tast::layout_scalar(1, 1)
      [U16] tast::layout_scalar(2, 2)
      [U32] tast::layout_scalar(4, 4)
      [U64] tast::layout_scalar(8, 8)
      [Float] tast::layout_scalar(8, 8)
      [F32] tast::layout_scalar(4, 4)
      [Str] tast::layout_scalar(ptr_sz * 2, ptr_align)
      [Rune] tast::layout_scalar(4, 4)
      [Flag] tast::layout_scalar(1, 1)
      [Unit] tast::layout_void()
      [RawPtr] tast::layout_scalar(ptr_sz, ptr_align)
      [Builder] tast::layout_scalar(ptr_sz * 3, ptr_align)
      [Error]
         is_32bit_target!
            | tast::layout_aggregate(48, 8)
            | tast::layout_aggregate(56, 8)
      | tast::layout_scalar(ptr_sz, ptr_align)

is_niche_utype: unify::Ctx, unify::UType => <>
is_niche_utype = ctx, ut =>
   c = unify::canon(ctx, ut)
   c
      [Prim p]
         p [Str, Error]
      [Rec r]
         ?r > 0
      | <->

compute_layout: unify::Ctx, unify::UType => tast::TypedLayout
compute_layout = ctx, ut =>
   ptr_sz = is_32bit_target! | 4 | 8
   ptr_align = is_32bit_target! | 4 | 8
   min_rec_sz = is_32bit_target! | 8 | 16
   c = unify::canon(ctx, ut)
   c
      [Prim p] compute_prim_layout(p)
      [Fn] tast::TypedLayout((ptr_sz * 2, ptr_align, tast::LayoutKind(FnClosure)))
      [Rec r]
         cur_off' = 0
         max_align' = 1
         r @ f =>
            flay = compute_layout(ctx, f.ut)
            f_align = %max(flay.align, 1)
            max_align' = %max(max_align', f_align)
            cur_off' = align_up(cur_off', f_align) + flay.size
         total_size = align_up(cur_off', max_align')
         fin_size = %max(total_size, min_rec_sz)
         tast::layout_aggregate(fin_size, max_align')
      [Ram r]
         has_p = r.pos.has_payload
         has_n = r.neg.has_payload
         has_p && !has_n
            |
               is_niche_utype(ctx, r.pos.ut)
                  | tast::layout_scalar(ptr_sz, ptr_align)
                  | tast::layout_ram(ptr_sz * 2, ptr_align)
            |
               !has_p && has_n
                  |
                     is_niche_utype(ctx, r.neg.ut)
                        | tast::layout_scalar(ptr_sz, ptr_align)
                        | tast::layout_ram(ptr_sz * 2, ptr_align)
                  |
                     has_p || has_n
                        | tast::layout_ram(ptr_sz * 2, ptr_align)
                        | tast::layout_scalar(1, 1)
      [Enum] tast::layout_aggregate(ptr_sz * 2, ptr_align)
      [Array]
         tast::TypedLayout((
            ptr_sz * 3, ptr_align, tast::LayoutKind(Array)
         ))
      [Slice] tast::TypedLayout((ptr_sz * 2, ptr_align, tast::LayoutKind(Slice)))
      | tast::layout_scalar(ptr_sz, ptr_align)

