// selfhost/src/dep_graph.dva — Dependency analysis and Tarjan's SCC.
//
// Maps function and variable definitions and their dependency edges, and
// partitions definitions into strongly connected components (SCCs) in
// reverse topological order (leaf-first dependency order).
// Part of Phase 5 (Roadmap §3.5, Issue #8).

#use "ast"

#public

#type DepNode (name: String, deps: ast::Names, stmt_idx: Int)
#type NameSet String ^ <>
#type NodeIndices String ^ Int
#type DepGraph (nodes: DepNode{}, indices: NodeIndices)

#type SCC (names: ast::Names, is_recursive: <>)

#type TarjanState (
   indices: Int{},
   lowlinks: Int{},
   on_stack: <>{},
   stack: Int{},
   stack_ptr: Int{},
   counter: Int{},
   sccs: SCC{}
)

is_fwd_assign: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
   String, ast::TypeInfo) => <>
is_fwd_assign = a =>
   a.5 [Var v] (v == "<fwd>") | <->

copy_names: ast::Names => ast::Names
copy_names = names => ++names

has_name_at: ast::Names, String, Int, Int => <>
has_name_at = names, s, i, n =>
   i == n
      | <->
      |
         (names(i) | _ | "") == s
            | <+>
            | has_name_at(names, s, i + 1, n)

has_name: ast::Names, String => <>
has_name = names, s => has_name_at(names, s, 0, ?names)

name_is_qualified: String, Int => <>
name_is_qualified = name, i =>
   i + 1 < ?name
      |
         (name(i) == ':') && (name(i + 1) == ':')
            | <+>
            | name_is_qualified(name, i + 1)
      | <->

decl_module_find: String, Int, Int => Int
decl_module_find = name, i, last =>
   i + 1 < ?name
      |
         (name(i) == ':') && (name(i + 1) == ':')
            | decl_module_find(name, i + 2, i)
            | decl_module_find(name, i + 1, last)
      | last

decl_module: String, Int => String
decl_module = name, ignored =>
   last = decl_module_find(name, 0, -1)
   last < 0 | "" | name(0..last)

resolve_dep_ref: NameSet, String, String => String
resolve_dep_ref = defs, mod, ref =>
   defs ^? ref
      | ref
      |
         mod != "" && !name_is_qualified(ref, 0)
            |
               defs ^? (mod + "::" + ref)
                  | mod + "::" + ref
                  |
                     defs ^? (mod + "::#" + ref)
                        | mod + "::#" + ref
                        | ""
            | ""

collect_expr_refs: ast::Expr, ast::Names, ast::Names => ()
collect_expr_refs = e, locals, refs =>
   e
      [Var v]
         v != "" && !has_name(locals, v) && !has_name(refs, v)
            | refs += v
      [Call c]
         c.fn_name != "" && !has_name(locals, c.fn_name) &&
            !has_name(refs, c.fn_name)
            | refs += c.fn_name
         collect_expr_refs(c.fn_target, locals, refs)
         c.args @ arg =>
            collect_expr_refs(arg, locals, refs)
      [Bin b]
         collect_expr_refs(b.1, locals, refs)
         collect_expr_refs(b.2, locals, refs)
      [Unary u]
         collect_expr_refs(u.1, locals, refs)
      [Fn fe]
         fn_locals = copy_names(locals)
         fe.params @ p =>
            p != "" | fn_locals += p
         collect_expr_refs(fe.body, fn_locals, refs)
      [Block be]
         blk_locals = copy_names(locals)
         be @ st =>
            st
               [Assign a]
                  collect_expr_refs(a.5, blk_locals, refs)
                  a.0 != "" | blk_locals += a.0
               | collect_expr_refs(st, blk_locals, refs)
      [Choice ch]
         collect_expr_refs(ch.cond, locals, refs)
         ch.branches @ br =>
            br_locals = copy_names(locals)
            br.bind_vars @ bv =>
               bv != "" | br_locals += bv
            collect_expr_refs(br.block, br_locals, refs)
            collect_expr_refs(br.pred_fn, br_locals, refs)
            br.case_values @ cv =>
               collect_expr_refs(cv, br_locals, refs)
      [Record re]
         re.fields @ fld =>
            collect_expr_refs(fld.val, locals, refs)
      [Member m]
         collect_expr_refs(m.target, locals, refs)
         collect_expr_refs(m.index_expr, locals, refs)
      [KeyAccess ka]
         collect_expr_refs(ka.target, locals, refs)
         collect_expr_refs(ka.key, locals, refs)
      [Assign a]
         collect_expr_refs(a.5, locals, refs)
         collect_expr_refs(a.6, locals, refs)
      [Cycle cy]
         collect_expr_refs(cy.iterable, locals, refs)
         collect_expr_refs(cy.body_fn, locals, refs)
      [CycleEscape ce]
         collect_expr_refs(ce.cycle, locals, refs)
         collect_expr_refs(ce.branch, locals, refs)
      [Range r]
         r.has_lhs | collect_expr_refs(r.lhs, locals, refs)
         r.has_rhs |
            r.rhs
               [Var v]
                  !(v == "default" && !r.has_lhs) |
                     collect_expr_refs(r.rhs, locals, refs)
               | collect_expr_refs(r.rhs, locals, refs)
      [NamedArg na]
         collect_expr_refs(na.val, locals, refs)
      [Variant v]
         v.args @ varg =>
            collect_expr_refs(varg, locals, refs)
      [Copy cp]
         collect_expr_refs(cp, locals, refs)
      [BuilderCreate bc]
         collect_expr_refs(bc, locals, refs)
      [TypeCast tc]
         collect_expr_refs(tc.expr, locals, refs)
      [CompileTime ct]
         collect_expr_refs(ct, locals, refs)
      [Spawn sp]
         collect_expr_refs(ast::Expr(Call, sp), locals, refs)
      [Join jn]
         collect_expr_refs(jn, locals, refs)
      [Exit ex]
         collect_expr_refs(ex, locals, refs)
      [UserDiag ud]
         collect_expr_refs(ud.msg, locals, refs)
      [Return r]
         r.has_val | collect_expr_refs(r.val, locals, refs)
      [MapLiteral m]
         m @ p =>
            collect_expr_refs(p.key, locals, refs)
            collect_expr_refs(p.value, locals, refs)
      [RawMemory rm]
         collect_expr_refs(rm.addr, locals, refs)

find_node_idx: DepGraph, String => Int
find_node_idx = graph, name =>
   indices = graph.indices
   indices ^? name
      |
         idx = indices ^ name | _ | _
         idx
      | -1

node_has_dep: DepNode, String => <>
node_has_dep = node, name =>
   has_name(node.deps, name)

is_generic_sig: (String, <>, <>, <>, <>, ast::Expr, ast::Expr,
   String, ast::TypeInfo) => <>
is_generic_sig = a =>
   is_ct = ?a.7 > 4 && a.7(0..4) == "@ct0"
   is_ti = a.8 [Fn f] (?f.4 > 0) | <->
   is_ct || is_ti

build_dep_graph: ast::Exprs => DepGraph
build_dep_graph = stmts =>
   nodes: DepNode{}
   graph = DepGraph(nodes, NodeIndices())
   gen_names = NameSet()
   stmts @ stk =>
      stk
         [Assign ak]
            is_fe = ak.5 [Fn fek] (?fek.ct_params > 0) | <->
            is_gen = is_generic_sig(ak) || is_fe
            is_gen && ak.0 != "" | gen_names ^ ak.0 = <+>
   def_names = NameSet()
   stmts @ st1 =>
      st1
          [Assign a1]
             is_fwd1 = is_fwd_assign(a1)
             is_gen1 = gen_names ^? a1.0
             name1 = a1.0
             !is_fwd1 && !is_gen1 && !a1.2 && !a1.4 && name1 != ""
                | def_names ^ name1 = <+>

   stmts @ st2, j =>
      st2
         [Assign a2]
            is_fwd2 = is_fwd_assign(a2)
            is_gen2 = gen_names ^? a2.0
            name2 = a2.0
            !is_fwd2 && !is_gen2 && !a2.2 && !a2.4 && name2 != ""
               |
                  raw_refs = ast::Names()
                  collect_expr_refs(a2.5, ast::Names(), raw_refs)
                  filtered_deps = ast::Names()
                  mod2 = decl_module(name2, 0)
                  raw_refs @ ref_name =>
                     target_ref = resolve_dep_ref(def_names, mod2, ref_name)
                     target_ref != "" && !has_name(filtered_deps, target_ref)
                        | filtered_deps += target_ref
                  node_indices = graph.indices
                  known = node_indices ^? name2
                  !known | node_indices ^ name2 = ?graph.nodes
                  graph.nodes += DepNode(name2, filtered_deps, j)
   graph

init_tarjan_state: Int => TarjanState
init_tarjan_state = n =>
   indices: Int{}
   lowlinks: Int{}
   on_stack: <>{}
   stack: Int{}
   stack_ptr: Int{}
   stack_ptr += 0
   counter: Int{}
   counter += 0
   sccs: SCC{}
   n @
      indices += -1
      lowlinks += 0
      on_stack += <->
   TarjanState(indices, lowlinks, on_stack, stack, stack_ptr, counter, sccs)

push_stack: TarjanState, Int => ()
push_stack = state, u =>
   s_ptr = state.stack_ptr
   sp = s_ptr(0)!!
   stk = state.stack
   sp < ?stk
      |
         stk(sp) = u !| _
      | stk += u
   s_ptr(0) = sp + 1 !| _

pop_stack: TarjanState => Int
pop_stack = state =>
   s_ptr = state.stack_ptr
   sp = s_ptr(0)!!
   new_sp = sp > 0 | sp - 1 | 0
   s_ptr(0) = new_sp !| _
   stk = state.stack
   stk(new_sp)!!

tarjan_dfs: DepGraph, TarjanState, Int => ()
tarjan_dfs = graph, state, u =>
   idxs = state.indices
   lows = state.lowlinks
   ons = state.on_stack
   s_cnt = state.counter
   cnt = s_cnt(0)!!
   idxs(u) = cnt !| _
   lows(u) = cnt !| _
   s_cnt(0) = cnt + 1 !| _
   push_stack(state, u)
   ons(u) = <+> !| _

   u_node = graph.nodes(u)!!
   u_node.deps @ d_name =>
      v = find_node_idx(graph, d_name)
      v !< 0
         |
            v_idx = idxs(v) | _ | -1
            v_idx < 0
               |
                  tarjan_dfs(graph, state, v)
                  lows(u) = %min(lows(u)!!, lows(v)!!) !| _
               |
                  v_on = ons(v) | _ | <->
                  v_on
                     |
                        lows(u) = %min(lows(u)!!, idxs(v)!!) !| _

   low_u = lows(u)!!
   idx_u = idxs(u)!!
   low_u == idx_u
      |
         scc_names = ast::Names()
         is_self_rec = node_has_dep(u_node, u_node.name)
         0.. @
            s_ptr = state.stack_ptr
            sp = s_ptr(0)!!
            sp == 0 | -->
            w = pop_stack(state)
            ons(w) = <-> !| _
            w_node = graph.nodes(w)!!
            scc_names += w_node.name
            w == u | -->
         is_rec = ?scc_names > 1 || is_self_rec
         state.sccs += SCC(scc_names, is_rec)

tarjan_scc: DepGraph => SCC{}
tarjan_scc = graph =>
   n = ?graph.nodes
   state = init_tarjan_state(n)
   n @ i =>
      idxs = state.indices
      idx = idxs(i) | _ | -1
      idx < 0 | tarjan_dfs(graph, state, i)
   state.sccs
