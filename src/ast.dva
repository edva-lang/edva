// src/ast.dva — the AST node types.
//
// Expr and TypeInfo are self-recursive enums; the field-grouping structs are records; lists are
// the named growable-array types below. Booleans are the built-in <> flag
// (<+>/<->), never a declared RamNN. Forward references make declaration
// order free: the records name Expr / TypeInfo before those enums are
// declared, and the enums reference the records back.

// --- leaf enums ------------------------------------------------------------

#public

#type ValueType <
   Unknown, Int, I8, I16, I32, I64, U8, U16, U32, U64,
   Rune, Float, F32, Str, Ram, Record, Unit, RawPtr, Fn, Type,
   Slice, Builder, Array, Map, Error, ThreadId, Flag, Enum
>

#type BinaryOp <
   Add, Sub, Mul, Div, Mod,
   Gt, Lt, Eq, NotGt, NotLt, NotEq,
   And, Or, Feed, Apply, Bind,
   BitAnd, BitOr, BitXor, Shl, Shr, Seq
>

#type UnaryOp <Not, BitNot, Length, AddrOf, Freeze, Unwrap, Propagate, RuneCount, Neg>

// The built-in ramification variant tags (Positive/Negative for the unit
// flags, Some/Err for payload rams, Succ/Noth for the unit upper variants).
#type Tag < Positive, Negative, Some, Err, Succ, Noth >

// --- named growable arrays -------------------------------------------------

#type Exprs Expr{}
#type Names String{}
#type Ints Int{}
#type Fields RecordField{}
#type Branches ChoiceBranch{}
#type FieldTypes RecordFieldType{}
#type EnumSlots EnumSlotInfo{}
#type CParams CompileTimeParam{}
#type FParams ForeignFnParam{}
#type VTypes ValueType{}
#type VInfos TypeInfo{}

// --- TypeInfo --------------------------------------------------------------

#type RecordFieldType (
   name: String, val_type: ValueType, rec_type: TypeInfo,
   has_default: <>, default_expr: Expr,
)

#type RamSlotInfo (
   has_payload: <>, payload_type: ValueType,
   payload_record: TypeInfo,
)

#type EnumSlotInfo (
   label: String, has_payload: <>, payload_type: ValueType,
   payload_record: TypeInfo,
)

#type CompileTimeParam (name: String, val_type: ValueType, type_info: TypeInfo)

#type BitfieldField (name: String, bit_width: Int, bit_offset: Int)
#type BitfieldFields BitfieldField{}
#type BitfieldInfo (
   fields: BitfieldFields,
   backing_type: ValueType,
   total_bits: Int,
)

// One variant per TypeInfoKind. Record and Slice share the Rec variant (the
// is_slice flag distinguishes); deferred_name/deferred_call (parser-internal
// cross-module resolution) are not yet represented.
#type TypeInfo <
   Prim(ValueType)
   TypeVar(String)
   Rec(FieldTypes, <>, <>, ValueType, Int, <>)
   Bitfield(BitfieldInfo)
   Ram(RamSlotInfo, RamSlotInfo)
   Enum(EnumSlots)
   Array(ValueType, TypeInfo, Int)
   Map(ValueType, ValueType, TypeInfo)
   Fn(VTypes, VInfos, ValueType, TypeInfo, CParams)
   ThreadId(ValueType, TypeInfo)
   Align(Int, TypeInfo)
>

// --- Expr sub-records ------------------------------------------------------

#type PatternKind < Wildcard, Bind, Lit, Variant, Record >

#type PatternRecord (
   kind: PatternKind,
   field_name: String,
   name: String,
   lit_val: Expr,
   subpatterns: Patterns,
)

#type Pattern <
   Node(PatternRecord)
   Empty
>

#type Patterns Pattern{}

#type GuardKind < Case, Predicate, Variant, Bare >

#type ChoiceBranch (
   kind: GuardKind,
   case_values: Exprs,
   pred_fn: Expr,
   variant_names: Names,
   bind_vars: Names,
   is_identity_extractor: <>,
   block: Expr,
)

#type ChoiceExpr (cond: Expr, is_exhaustive: <>, branches: Branches)

#type CallExpr (
   fn_name: String, fn_target: Expr, args: Exprs,
   line: Int, col: Int,
)

#type FnExpr (params: Names, ct_params: Names, body: Expr)

#type CycleExpr (iterable: Expr, body_fn: Expr, is_rune: <>)

#type CycleJumpExpr (is_break: <>, level: Int)

#type CycleEscapeExpr (cycle: Expr, branch: Expr)

#type RangeExpr (has_lhs: <>, has_rhs: <>, lhs: Expr, rhs: Expr)

#type NamedArgExpr (name: String, val: Expr)
#type RecordField (has_name: <>, name: String, val: Expr)

#type RecordExpr (fields: Fields, is_repeat: <>)

#type MemberExpr (target: Expr, field_name: String, is_module_access: <>, index_expr: Expr, line: Int, col: Int)

#type KeyAccessExpr (
   target: Expr, key: Expr, is_membership: <>, is_delete: <>,
   line: Int, col: Int,
)

#type VariantExpr (tag_name: Tag, args: Exprs)

#type TypeDeclExpr (name: String, type_info: TypeInfo)

#type CastExpr (target_type: ValueType, expr: Expr)

#type ImportStmt (module_name: String, module_path: String, is_dynamic: <>, is_import: <>)

#type ForeignFnParam (
   name: String, param_type: ValueType,
   record_info: TypeInfo,
)

#type ForeignFnDecl (
   c_name: String, dva_name: String, abi: String,
   params: FParams, return_type: ValueType, ret_record_info: TypeInfo,
   is_variable: <>,
)

#type RawMemoryExpr (addr: Expr, load_type: ValueType, rec_name: String)

#type SizeOfExpr (val_type: ValueType, rec_type: TypeInfo)
#type AlignOfExpr (val_type: ValueType, rec_type: TypeInfo)

#type ReturnExpr (has_val: <>, val: Expr, line: Int, col: Int)
#type UserDiagExpr (is_warn: <>, msg: Expr, line: Int, col: Int)

#type MapPair (key: Expr, value: Expr)
#type MapPairs MapPair{}
#type ArrayCreateExpr (elem_type: TypeInfo, cap: Int)

// --- Expr ------------------------------------------------------------------

// One variant per ExprKind. Multi-field nodes use tuple payloads (a variant
// payload is a single type); list children use the named array types above.
#type Expr <
   Int(Int)
   Float(Float)
   Str(String)
   Var(String)
   Rune(Int)
   Bin(BinaryOp, Expr, Expr)
   Assign(String, <>, <>, <>, <>, Expr, Expr, String, TypeInfo)
   Choice(ChoiceExpr)
   Block(Exprs)
   Call(CallExpr)
   CycleJump(CycleJumpExpr)
   CycleEscape(CycleEscapeExpr)
   Cycle(CycleExpr)
   Range(RangeExpr)
   Fn(FnExpr)
   Record(RecordExpr)
   Member(MemberExpr)
   KeyAccess(KeyAccessExpr)
   Variant(VariantExpr)
   RawMemory(RawMemoryExpr)
   Import(ImportStmt)
   Foreign(ForeignFnDecl)
   TypeCast(CastExpr)
   TypeDecl(TypeDeclExpr)
   Unary(UnaryOp, Expr)
   Copy(Expr)
   SizeOf(SizeOfExpr)
   BuilderCreate(Expr)
   ArrayCreate(ArrayCreateExpr)
   MapLiteral(MapPairs)
   CompileTime(Expr)
   Spawn(CallExpr)
   Join(Expr)
   Exit(Expr)
   FastMathPragma(String)
   SwizzlePragma(String)
   NamedArg(NamedArgExpr)
   Return(ReturnExpr)
   UserDiag(UserDiagExpr)
   AlignOf(AlignOfExpr)
>

mk_rfield_type: String, ValueType, TypeInfo => RecordFieldType
mk_rfield_type = name, vt, ti =>
   RecordFieldType(name, vt, ti, <->, Expr(Int, 0))

mk_rfield_type_default: String, ValueType, TypeInfo, Expr => RecordFieldType
mk_rfield_type_default = name, vt, ti, def_expr =>
   RecordFieldType(name, vt, ti, <+>, def_expr)

cell_var_names = Names()

has_cell_name_at: Names, String, Int, Int => <>
has_cell_name_at = arr, s, i, n =>
   i == n
      | <->
      |
         v = arr(i) | _ | ""
         v == s | <+> | has_cell_name_at(arr, s, i + 1, n)

has_cell_name: Names, String => <>
has_cell_name = arr, s => has_cell_name_at(arr, s, 0, ?arr)

cell_var_add: String => ()
cell_var_add = name =>
   !has_cell_name(cell_var_names, name)
      | cell_var_names += ++name

is_cell_var: String => <>
is_cell_var = name =>
   has_cell_name(cell_var_names, name)

cell_var_reset: () => ()
cell_var_reset = !=>
   cell_var_names ::= Names()

str_has_sub_at: String, String, Int, Int, Int => <>
str_has_sub_at = s, sub, i, n, m =>
   i + m > n
      | <->
      | s(i..i + m) == sub | <+> | str_has_sub_at(s, sub, i + 1, n, m)

str_has_sub: String, String => <>
str_has_sub = s, sub =>
   m = ?sub
   m == 0 | <+> | str_has_sub_at(s, sub, 0, ?s, m)

triple_os: String => String
triple_os = triple =>
   str_has_sub(triple, "darwin") || str_has_sub(triple, "macosx") || str_has_sub(triple, "apple")
      | "darwin"
      | str_has_sub(triple, "linux")
         | "linux"
         | str_has_sub(triple, "windows") || str_has_sub(triple, "msvc") || str_has_sub(triple, "mingw")
            | "windows"
            | str_has_sub(triple, "freebsd")
               | "freebsd"
               | str_has_sub(triple, "openbsd")
                  | "openbsd"
                  | str_has_sub(triple, "netbsd")
                     | "netbsd"
                     | str_has_sub(triple, "wasi")
                        | "wasi"
                        | str_has_sub(triple, "wasm")
                           | "wasm"
                           | "unknown"

triple_first_seg_at: String, Int, Int => String
triple_first_seg_at = s, i, n =>
   i == n
      | s
      | s(i) == 45
         | s(..i)
         | triple_first_seg_at(s, i + 1, n)

triple_arch: String => String
triple_arch = triple =>
   seg = triple_first_seg_at(triple, 0, ?triple)
   seg
      ["arm64", "aarch64"] "aarch64"
      ["x86_64", "amd64"] "x86_64"
      ["i386", "i486", "i586", "i686"] "x86"
      [""] "unknown"
      | seg
