// codegen/expr.dva

#use "../llvm"
#use "../ast"
#use "str"
#use "../tast"
#use "../unify"
#use "mem"
#use "types"
#use "runtime"
#use "match"
#use "stmt"
#use "main"

#foreign "c"
   write: (fd: Int, buf: Addr, count: Int) => Int
   dva_arena_current: () => Addr
   rename: (oldpath: String, newpath: String) => Int
   unlink: (path: String) => Int

#type Cg types::Cg
#type CodegenOpts types::CodegenOpts
#type CgVar types::CgVar
#type CgVars types::CgVars
#type TypeDef types::TypeDef
#type TypeDefs types::TypeDefs
#type TypeIndex types::TypeIndex
#type FnInfo types::FnInfo
#type FnInfos types::FnInfos
#type FnDef types::FnDef
#type FnDefs types::FnDefs
#type FnNameIndex types::FnNameIndex
#type BindingMut types::BindingMut
#type BindingMuts types::BindingMuts
#type BindingState types::BindingState
#type ParamRec types::ParamRec
#type ParamRecs types::ParamRecs
#type FnRetRec types::FnRetRec
#type FnRetRecs types::FnRetRecs
#type Addrs types::Addrs
#type IntArr types::IntArr
#type FieldInitState types::FieldInitState
#type ChoiceInitFrame types::ChoiceInitFrame
#type ChoiceInitFrames types::ChoiceInitFrames
#type LambdaEnvInfo types::LambdaEnvInfo
#type LambdaEnvInfos types::LambdaEnvInfos
#type Flags types::Flags
#type FnValueMeta types::FnValueMeta

c_str: Addr => String
c_str = raw => types::c_str(raw)

dbg: String => Int
dbg = s => types::dbg(s)

empty_fndef: FnDef
empty_fndef = FnDef(("", ast::Names(), ast::Expr(Var, "")))

#private
print: String => Int
print = s =>
   b = {?s + 1}
   b += s
   b += 10
   write(1, &b, ?b)

// --- Module Implementation -------------------------------------------------

codegen_arena_current: types::Cg, String => Addr
codegen_arena_current = cg, name =>
   atp = llvm::LLVMPointerType(runtime::arena_type(cg), 0)
   fty = types::fn_type0(atp)
   fn = llvm::LLVMGetNamedFunction(cg.module, "dva_arena_current")
   types::call0(cg, fty, fn, name)

// Allocate from the active arena. All heap-shaped language values use this
// funnel, which is what lets save/restore scopes reclaim their temporaries.
codegen_call_arena_alloc: types::Cg, Addr, String => Addr
codegen_call_arena_alloc = cg, size, name =>
   cg.opts.no_runtime
      |
         types::init_error(cg, "E3140", "arena allocation under --no-runtime. The " +
            "feature you used (a record, closure, String concat, Builder, " +
            "or heap ram/enum) needs the runtime arena, which --no-runtime " +
            "omits. Use only bare-metal features: Int arithmetic, String " +
            "literals, '?s', 's(i)', and raw '@[Addr(...)]' memory.", 0, 0)
         llvm::LLVMConstNull(llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0))
      |
         cg.in_restore_scope > 0
            | types::call1(cg, cg.malloc_t, cg.malloc_fn, size, name)
            | codegen_call_arena_alloc_live(cg, size, name)

codegen_call_arena_alloc_live: types::Cg, Addr, String => Addr
codegen_call_arena_alloc_live = cg, size, name =>
   atp = llvm::LLVMPointerType(runtime::arena_type(cg), 0)
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   fty = types::fn_type2(cg, i8p, atp, llvm::LLVMInt64Type!)
   args = {16}
   sb = &args
   @[sb] = codegen_arena_current(cg, "arena.cur")
   @[sb + 8] = size
   fn = llvm::LLVMGetNamedFunction(cg.module, "dva_arena_alloc")
   llvm::LLVMBuildCall2(cg.builder, fty, fn, sb, 2, name)

// Allocate in an explicitly selected arena. Thread hand-offs use this rather
// than the ambient TLS arena: spawn copies into the child arena and join copies
// back into the parent before destroying the child.
codegen_call_arena_alloc_in: types::Cg, Addr, Addr, String => Addr
codegen_call_arena_alloc_in = cg, arena, size, name =>
   atp = llvm::LLVMPointerType(runtime::arena_type(cg), 0)
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   fty = types::fn_type2(cg, i8p, atp, llvm::LLVMInt64Type!)
   args = {16}
   sb = &args
   @[sb] = arena
   @[sb + 8] = size
   fn = llvm::LLVMGetNamedFunction(cg.module, "dva_arena_alloc")
   llvm::LLVMBuildCall2(cg.builder, fty, fn, sb, 2, name)

codegen_call_arena_save: types::Cg, String => Addr
codegen_call_arena_save = cg, name =>
   atp = llvm::LLVMPointerType(runtime::arena_type(cg), 0)
   fty = types::fn_type1(llvm::LLVMInt64Type!, atp)
   args = {8}
   @[&args] = codegen_arena_current(cg, name)
   fn = llvm::LLVMGetNamedFunction(cg.module, "dva_arena_save")
   llvm::LLVMBuildCall2(cg.builder, fty, fn, &args, 1, name)

codegen_call_arena_restore: types::Cg, Addr => Addr
codegen_call_arena_restore = cg, mark =>
   atp = llvm::LLVMPointerType(runtime::arena_type(cg), 0)
   fty = types::fn_type2(cg, llvm::LLVMVoidType!, atp, llvm::LLVMInt64Type!)
   args = {16}
   sb = &args
   @[sb] = codegen_arena_current(cg, "arena.cur")
   @[sb + 8] = mark
   fn = llvm::LLVMGetNamedFunction(cg.module, "dva_arena_restore")
   llvm::LLVMBuildCall2(cg.builder, fty, fn, sb, 2, "")

// The arena generation is encoded in the top sixteen bits of mortal String
// lengths. Literal strings retain tag zero and are immortal.
codegen_arena_generation: types::Cg, String => Addr
codegen_arena_generation = cg, name =>
   cur = codegen_arena_current(cg, name)
   gp = llvm::LLVMBuildStructGEP2(cg.builder, runtime::arena_type(cg), cur, 4, name)
   llvm::LLVMBuildLoad2(cg.builder, llvm::LLVMInt64Type!, gp, name)

// Reads and validates the stored String length. A value stamped by a
// save/restore scope must still carry the current arena generation.
codegen_string_len: types::Cg, Addr, String => Addr
codegen_string_len = cg, val, name =>
   lgep = llvm::LLVMBuildStructGEP2(cg.builder, cg.str_t, val, 0, name)
   raw = llvm::LLVMBuildLoad2(cg.builder, llvm::LLVMInt64Type!, lgep, name)
   zero = llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0)
   mask = llvm::LLVMConstInt(llvm::LLVMInt64Type!, 281474976710655, 0)
   len = llvm::LLVMBuildAnd(cg.builder, raw, mask, name)
   cg.opts.no_runtime
      | len
      |
         tag = llvm::LLVMBuildLShr(cg.builder, raw,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 48, 0), "str.tag")
         immortal = llvm::LLVMBuildICmp(cg.builder, 32, tag, zero,
            "str.immortal")
         parent = llvm::LLVMGetBasicBlockParent(
            llvm::LLVMGetInsertBlock(cg.builder))
         check_bb = llvm::LLVMAppendBasicBlock(parent, "str_gen_check")
         ok_bb = llvm::LLVMAppendBasicBlock(parent, "str_ok")
         stale_bb = llvm::LLVMAppendBasicBlock(parent, "str_stale")
         llvm::LLVMBuildCondBr(cg.builder, immortal, ok_bb, check_bb)
         llvm::LLVMPositionBuilderAtEnd(cg.builder, check_bb)
         cur_gen = codegen_arena_generation(cg, "arena.gen")
         matches = llvm::LLVMBuildICmp(cg.builder, 32, tag, cur_gen,
            "str.tag.match")
         llvm::LLVMBuildCondBr(cg.builder, matches, ok_bb, stale_bb)
         llvm::LLVMPositionBuilderAtEnd(cg.builder, stale_bb)
         runtime::emit_abort_msg(cg, "E4010: stale String read after arena restore\n",
            "stale_str_msg")
         llvm::LLVMBuildBr(cg.builder, ok_bb)
         llvm::LLVMPositionBuilderAtEnd(cg.builder, ok_bb)
         len

tag_addr_with_arena_gen: types::Cg, Addr => Addr
tag_addr_with_arena_gen = cg, raw_p =>
   (!cg.opts.no_runtime && (cg.in_restore_scope > 0))
      |
         i64t = llvm::LLVMInt64Type!
         i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
         ty = llvm::LLVMTypeOf(raw_p)
         is_ptr = llvm::LLVMGetTypeKind(ty) == 12
         p_int = is_ptr
            | llvm::LLVMBuildPtrToInt(cg.builder, raw_p, i64t, "addr.tag.int")
            | stmt::coerce_int(cg, raw_p, i64t)
         gen = codegen_arena_generation(cg, "addr.tag.gen")
         shift = llvm::LLVMBuildShl(cg.builder, gen,
            llvm::LLVMConstInt(i64t, 48, 0), "addr.tag.shift")
         tagged_int = llvm::LLVMBuildOr(cg.builder, p_int, shift,
            "addr.tagged")
         is_ptr
            | llvm::LLVMBuildIntToPtr(cg.builder, tagged_int, i8p,
               "addr.tagged.ptr")
            | tagged_int
      | raw_p

validate_and_strip_addr_tag: types::Cg, Addr, Addr => Addr
validate_and_strip_addr_tag = cg, value, i8p =>
   value == Addr(0)
      | llvm::LLVMConstNull(i8p)
      |
         i64t = llvm::LLVMInt64Type!
         ty = llvm::LLVMTypeOf(value)
         is_ptr = llvm::LLVMGetTypeKind(ty) == 12
         p_int = is_ptr
            | llvm::LLVMBuildPtrToInt(cg.builder, value, i64t, "raw.int")
            | stmt::coerce_int(cg, value, i64t)
         mask = llvm::LLVMConstInt(i64t, 281474976710655, 0)
         clean_int = llvm::LLVMBuildAnd(cg.builder, p_int, mask,
            "raw.clean.int")
         clean_p = llvm::LLVMBuildIntToPtr(cg.builder, clean_int, i8p,
            "raw.clean.ptr")
         cg.opts.no_runtime
            | clean_p
            |
               zero = llvm::LLVMConstInt(i64t, 0, 0)
               tag = llvm::LLVMBuildLShr(cg.builder, p_int,
                  llvm::LLVMConstInt(i64t, 48, 0), "addr.tag")
               immortal = llvm::LLVMBuildICmp(cg.builder, 32, tag, zero,
                  "addr.immortal")
               parent = llvm::LLVMGetBasicBlockParent(
                  llvm::LLVMGetInsertBlock(cg.builder))
               check_bb = llvm::LLVMAppendBasicBlock(parent, "addr_gen_check")
               ok_bb = llvm::LLVMAppendBasicBlock(parent, "addr_ok")
               stale_bb = llvm::LLVMAppendBasicBlock(parent, "addr_stale")
               llvm::LLVMBuildCondBr(cg.builder, immortal, ok_bb, check_bb)
               llvm::LLVMPositionBuilderAtEnd(cg.builder, check_bb)
               cur_gen = codegen_arena_generation(cg, "arena.gen")
               matches = llvm::LLVMBuildICmp(cg.builder, 32, tag, cur_gen,
                  "addr.tag.match")
               llvm::LLVMBuildCondBr(cg.builder, matches, ok_bb, stale_bb)
               llvm::LLVMPositionBuilderAtEnd(cg.builder, stale_bb)
               runtime::emit_abort_msg(cg,
                  "E4011: stale Addr dereference after arena restore\n",
                  "stale_addr_msg")
               llvm::LLVMBuildBr(cg.builder, ok_bb)
               llvm::LLVMPositionBuilderAtEnd(cg.builder, ok_bb)
               clean_p

clean_untagged_addr: types::Cg, Addr => Addr
clean_untagged_addr = cg, ptr_val =>
   ptr_val == Addr(0)
      | llvm::LLVMConstNull(llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0))
      |
         i64t = llvm::LLVMInt64Type!
         i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
         ty = llvm::LLVMTypeOf(ptr_val)
         is_ptr = llvm::LLVMGetTypeKind(ty) == 12
         p_int = is_ptr
            | llvm::LLVMBuildPtrToInt(cg.builder, ptr_val, i64t, "addr.ffi.int")
            | stmt::coerce_int(cg, ptr_val, i64t)
         mask = llvm::LLVMConstInt(i64t, 281474976710655, 0)
         masked = llvm::LLVMBuildAnd(cg.builder, p_int, mask,
            "addr.ffi.masked")
         is_ptr
            | llvm::LLVMBuildIntToPtr(cg.builder, masked, i8p, "addr.ffi.clean")
            | masked


codegen_string_data: types::Cg, Addr, String => Addr
codegen_string_data = cg, val, name =>
   gp = llvm::LLVMBuildStructGEP2(cg.builder, cg.str_t, val, 1, name)
   llvm::LLVMBuildLoad2(cg.builder,
      llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0), gp, name)

codegen_ensure_nul_terminated: types::Cg, Addr, String => Addr
codegen_ensure_nul_terminated = cg, str_val, name =>
   data = codegen_string_data(cg, str_val, name)
   len = codegen_string_len(cg, str_val, name)
   i8t = llvm::LLVMInt8Type!
   i64t = llvm::LLVMInt64Type!
   i8p = llvm::LLVMPointerType(i8t, 0)
   byte_ptr = types::gep1(cg, i8t, data, len, "nulcheck.gep")
   byte_val = llvm::LLVMBuildLoad2(cg.builder, i8t, byte_ptr, "nulcheck.byte")
   zero_i8 = llvm::LLVMConstInt(i8t, 0, 0)
   is_nul = llvm::LLVMBuildICmp(cg.builder, 32, byte_val, zero_i8, "nulcheck")
   cur_bb = llvm::LLVMGetInsertBlock(cg.builder)
   parent = llvm::LLVMGetBasicBlockParent(cur_bb)
   pass_bb = llvm::LLVMAppendBasicBlock(parent, name)
   copy_bb = llvm::LLVMAppendBasicBlock(parent, "nulcopy")
   merge_bb = llvm::LLVMAppendBasicBlock(parent, "nulmerge")
   llvm::LLVMBuildCondBr(cg.builder, is_nul, pass_bb, copy_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, pass_bb)
   llvm::LLVMBuildBr(cg.builder, merge_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, copy_bb)
   one = llvm::LLVMConstInt(i64t, 1, 0)
   buf_len = stmt::codegen_add_checked_u64(cg, len, one, "nulcopy.len")
   buf_ptr = codegen_call_arena_alloc(cg, buf_len, "nulcopy.buf")
   llvm::LLVMBuildMemCpy(cg.builder, buf_ptr, 1, data, 1, len, 0)
   nul_gep = types::gep1(cg, i8t, buf_ptr, len, "nulcopy.nul")
   llvm::LLVMBuildStore(cg.builder, zero_i8, nul_gep)
   copy_ok_bb = llvm::LLVMGetInsertBlock(cg.builder)
   llvm::LLVMBuildBr(cg.builder, merge_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, merge_bb)
   phi = llvm::LLVMBuildPhi(cg.builder, i8p, name)
   stmt::llvm_add_incoming1(cg, phi, data, pass_bb)
   stmt::llvm_add_incoming1(cg, phi, buf_ptr, copy_ok_bb)
   phi

// Reads the { len, data } words of a String value (a pointer to the struct).
codegen_string_len_data: types::Cg, Addr, String => (Addr, Addr)
codegen_string_len_data = cg, val, name =>
   len_v = codegen_string_len(cg, val, name)
   dgep = llvm::LLVMBuildStructGEP2(cg.builder, cg.str_t, val, 1, name)
   data_v = llvm::LLVMBuildLoad2(cg.builder,
      llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0), dgep, name)
   (len_v, data_v)

// Allocates a { len, data } String struct in the active arena and fills it.
codegen_string_build: types::Cg, Addr, Addr, String => Addr
codegen_string_build = cg, len, data, name =>
   st = cg.str_t
   sp = codegen_call_arena_alloc(cg,
      llvm::LLVMConstInt(llvm::LLVMInt64Type!, 16, 0), name)
   lgep = llvm::LLVMBuildStructGEP2(cg.builder, st, sp, 0, "str.build.len.gep")
   store_len = cg.in_restore_scope > 0
      |
         gen = codegen_arena_generation(cg, "str.tag.gen")
         shift = llvm::LLVMBuildShl(cg.builder, gen,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 48, 0), "str.tag.shift")
         llvm::LLVMBuildOr(cg.builder, len, shift, "str.tagged.len")
      | len
   llvm::LLVMBuildStore(cg.builder, store_len, lgep)
   dgep = llvm::LLVMBuildStructGEP2(cg.builder, st, sp, 1, "str.build.data.gep")
   llvm::LLVMBuildStore(cg.builder, data, dgep)
   sp

// "++s" — a deep copy of a String into a fresh malloc'd String (survives
// arena restores; used for the definite-init path keys).
codegen_string_copy: types::Cg, Addr => Addr
codegen_string_copy = cg, val =>
   ld = codegen_string_len_data(cg, val, "copy.len")
   buf = codegen_call_arena_alloc(cg, ld.0, "copy.buf")
   llvm::LLVMBuildMemCpy(cg.builder, buf, 1, ld.1, 1, ld.0, 0)
   st = cg.str_t
   sp = codegen_call_arena_alloc(cg,
      llvm::LLVMConstInt(llvm::LLVMInt64Type!, 16, 0), "copy.str")
   lgep = llvm::LLVMBuildStructGEP2(cg.builder, st, sp, 0, "str.copy.len.gep")
   llvm::LLVMBuildStore(cg.builder, ld.0, lgep)
   dgep = llvm::LLVMBuildStructGEP2(cg.builder, st, sp, 1, "str.copy.data.gep")
   llvm::LLVMBuildStore(cg.builder, buf, dgep)
   sp

// --- closures (phase 4.4 #2) -------------------------------------------------

// The closure fat-pointer struct: { ptr fn_ptr, ptr env_ptr }.
codegen_named_fn_value: types::Cg, String => < (Addr, ast::ValueType) | >
codegen_named_fn_value = cg, name =>
   alias = fn_alias(cg, name)
   target = alias == "" | name | alias
   stmt::sig_ct0_name(types::g.pstmts, target, 0) != ""
      | codegen_generic_fn_value_error(cg, target)
      |
         types::has_fn_name(cg, target) && !types::is_fn_name(cg, target)
            |
               stmt::compile_fn_lazy(cg, target, ast::VTypes())
               0
            | 0
         meta = fn_value_meta(cg, target)
         meta.generic
            | codegen_generic_fn_value_error(cg, target)
            | !meta.value_safe
               | codegen_untyped_fn_value_error(cg, target)
               | codegen_named_fn_value_valid(cg, target)

codegen_named_fn_value_valid: types::Cg, String => < (Addr, ast::ValueType) | >
codegen_named_fn_value_valid = cg, target =>
   fi = stmt::fninfo_of(cg, target)
   gv = noncap_closure(cg, target, fi.0)
   cg.last_closure_fn = target
   <+ (gv, ast::ValueType(Fn)) ->

// A non-capturing named fn's closure value: the CONSTANT { fn_ptr, null }
// global (cached per fn — one clo.const<N> per function, matching the
// reference's noncap_closures).
noncap_closure: types::Cg, String, Addr => Addr
noncap_closure = cg, name, fn =>
   at = noncap_at(cg, name, 0)
   at !< 0
      | cg.noncap_globs(at)!!
      |
         clo_t = stmt::closure_struct_type(cg)
         gv = llvm::LLVMAddGlobal(cg.module, clo_t, "clo.const")
         i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
         vals = {16}
         vsb = &vals
         @[vsb] = llvm::LLVMConstPointerCast(fn, i8p)
         @[vsb + 8] = llvm::LLVMConstNull(i8p)
         llvm::LLVMSetInitializer(gv, llvm::LLVMConstStruct(vsb, 2, 0))
         llvm::LLVMSetGlobalConstant(gv, 1)
         llvm::LLVMSetLinkage(gv, 8)
         cg.noncap_names += name
         cg.noncap_globs += gv
         gv

noncap_at: types::Cg, String, Int => Int
noncap_at = cg, name, i =>
   i == ?cg.noncap_names
      | -1
      |
         (cg.noncap_names(i)!! == name)
            | i
            | noncap_at(cg, name, i + 1)



fn_value_meta_rev: types::Cg, String, Int => types::FnValueMeta
fn_value_meta_rev = cg, name, i =>
   i < 0
      | types::FnValueMeta((<->, <->, <->, <->))
      |
         fi = cg.fninfos(i)!!
         fi.name == name
            | types::FnValueMeta((<+>, fi.declared, fi.generic, fi.value_safe))
            | fn_value_meta_rev(cg, name, i - 1)

fn_value_meta: types::Cg, String => types::FnValueMeta
fn_value_meta = cg, name =>
   fn_value_meta_rev(cg, name, ?cg.fninfos - 1)

codegen_untyped_fn_value_error: types::Cg, String => < (Addr, ast::ValueType) | >
codegen_untyped_fn_value_error = cg, name =>
   types::init_error(cg, "E3128", "Function '" + name + "' is used as a value but " +
      "its parameter types cannot be determined — no declared signature and " +
      "no call site to infer from. Declare a signature: '" + name +
      ": T1, T2 => R'.", 0, 0)
   <-->

codegen_generic_fn_value_error: types::Cg, String => < (Addr, ast::ValueType) | >
codegen_generic_fn_value_error = cg, name =>
   types::init_error(cg, "E3142", "Cannot use the generic function '" + name +
      "' as a value — bind its type arguments at a call site first ('" +
      name + "(Int)', '#! T: Type' inference).", 0, 0)
   <-->

// The body expression of a named function (a Var placeholder if unknown).
fn_body_of: types::Cg, String => ast::Expr
fn_body_of = cg, name => fn_body_of_rev(cg, name, ?cg.fns - 1)

fn_body_of_rev: types::Cg, String, Int => ast::Expr
fn_body_of_rev = cg, name, i =>
   i < 0
      | ast::Expr(Var, "?")
      |
         fd = cg.fns(i)!!
         fd.name == name
            | fd.body
            | fn_body_of_rev(cg, name, i - 1)

fn_has_arena_alloc: types::Cg, String, Int => <>
fn_has_arena_alloc = cg, name, depth =>
   depth > 3
      | <->
      |
         rf = types::resolve_fn_name(cg, name)
         target = rf != "" | rf | name
         body = fn_body_of(cg, target)
         body
            [Var _] <->
            | expr_has_arena_alloc_d(cg, body, depth)

// Static approximation of the native arena-allocation walk. It decides
// whether a Block needs a save/restore pair before lowering mutates LLVM;
// the result is deliberately structural, never a runtime type descriptor.
expr_has_arena_alloc: types::Cg, ast::Expr => <>
expr_has_arena_alloc = cg, e => expr_has_arena_alloc_d(cg, e, 0)

expr_has_arena_alloc_d: types::Cg, ast::Expr, Int => <>
expr_has_arena_alloc_d = cg, e, depth =>
   e
      [Record _] <+>
      [Variant _] <+>
      [Fn _] <+>
      [MapLiteral _] <+>
      [BuilderCreate _] <+>
      [Bin t] expr_has_arena_alloc_bin_d(cg, t, depth)
      [Call c] types::is_user_type(cg, c.fn_name) ||
         (depth < 3 && fn_has_arena_alloc(cg, c.fn_name, depth + 1)) ||
         exprs_has_arena_alloc_d(cg, c.args, 0, depth)
      [Choice c] expr_has_arena_alloc_d(cg, c.cond, depth) ||
         branches_has_arena_alloc_d(cg, c.branches, 0, depth)
      [Block b] exprs_has_arena_alloc_d(cg, b.exprs, 0, depth)
      [Cycle c] expr_has_arena_alloc_d(cg, c.iterable, depth) ||
         expr_has_arena_alloc_d(cg, c.body_fn, depth)
      [CycleEscape c] expr_has_arena_alloc_d(cg, c.cycle, depth) ||
         expr_has_arena_alloc_d(cg, c.branch, depth)
      [Assign t] expr_has_arena_alloc_d(cg, t.5, depth) ||
         expr_has_arena_alloc_d(cg, t.6, depth)
      [TypeCast c] expr_has_arena_alloc_d(cg, c.expr, depth)
      [Unary t] expr_has_arena_alloc_d(cg, t.1, depth)
      [Copy _] <+>
      [Member m] expr_has_arena_alloc_d(cg, m.target, depth) ||
         expr_has_arena_alloc_d(cg, m.index_expr, depth)
      [RawMemory r] expr_has_arena_alloc_d(cg, r.addr, depth)
      [Range r] expr_has_arena_alloc_d(cg, r.lhs, depth) ||
         expr_has_arena_alloc_d(cg, r.rhs, depth)
      [Spawn s] exprs_has_arena_alloc_d(cg, s.call.args, 0, depth)
      [Join j] expr_has_arena_alloc_d(cg, j.handle, depth)
      [Exit x] expr_has_arena_alloc_d(cg, x.code, depth)
      | <->

expr_has_arena_alloc_bin: types::Cg, (ast::BinaryOp, ast::Expr, ast::Expr) => <>
expr_has_arena_alloc_bin = cg, t => expr_has_arena_alloc_bin_d(cg, t, 0)

expr_has_arena_alloc_bin_d: types::Cg, (ast::BinaryOp, ast::Expr, ast::Expr),
   Int => <>
expr_has_arena_alloc_bin_d = cg, t, depth =>
   string_add = t.0 [Add]
   lvt = types::static_expr_vt(cg, t.1)
   rvt = types::static_expr_vt(cg, t.2)
   pure_builder = string_add && types::is_builder_vt(lvt)
   string_concat = string_add && (types::is_str_vt(lvt) || types::is_str_vt(rvt))
   pure_builder || string_concat || expr_has_arena_alloc_d(cg, t.1, depth) ||
      expr_has_arena_alloc_d(cg, t.2, depth)

exprs_has_arena_alloc: types::Cg, ast::Exprs, Int => <>
exprs_has_arena_alloc = cg, es, at => exprs_has_arena_alloc_d(cg, es, at, 0)

exprs_has_arena_alloc_d: types::Cg, ast::Exprs, Int, Int => <>
exprs_has_arena_alloc_d = cg, es, at, depth =>
   at == ?es
      | <->
      | expr_has_arena_alloc_d(cg, es(at)!!, depth) ||
         exprs_has_arena_alloc_d(cg, es, at + 1, depth)

branches_has_arena_alloc: types::Cg, ast::Branches, Int => <>
branches_has_arena_alloc = cg, bs, at =>
   branches_has_arena_alloc_d(cg, bs, at, 0)

branches_has_arena_alloc_d: types::Cg, ast::Branches, Int, Int => <>
branches_has_arena_alloc_d = cg, bs, at, depth =>
   at == ?bs
      | <->
      |
         br = bs(at)!!
         exprs_has_arena_alloc_d(cg, br.case_values, 0, depth) ||
            expr_has_arena_alloc_d(cg, br.pred_fn, depth) ||
            expr_has_arena_alloc_d(cg, br.block, depth) ||
            branches_has_arena_alloc_d(cg, bs, at + 1, depth)

truncate_ints: types::IntArr, Int => types::IntArr
truncate_ints = arr, n =>
   res = types::IntArr()
   n @ i => res += arr(i)!!
   res

codegen_restore_scope_enter: types::Cg, <> => ()
codegen_restore_scope_enter = cg, has_alloc =>
   has_alloc
      |
         cg.in_restore_scope = cg.in_restore_scope + 1
         types::g.restore_scope_var_starts += ?cg.vars
      | cg.in_restore_scope = cg.in_restore_scope

codegen_restore_scope_leave: types::Cg, < Addr | > => ()
codegen_restore_scope_leave = cg, mark =>
   mark
      | m => codegen_restore_scope_leave_yes(cg, m)
      | cg.in_restore_scope = cg.in_restore_scope

codegen_restore_scope_leave_yes: types::Cg, Addr => ()
codegen_restore_scope_leave_yes = cg, mark =>
   !stmt::block_is_terminated(cg) | codegen_call_arena_restore(cg, mark)
   cg.in_restore_scope = cg.in_restore_scope - 1
   ?types::g.restore_scope_var_starts > 0
      | types::g.restore_scope_var_starts = truncate_ints(types::g.restore_scope_var_starts,
         ?types::g.restore_scope_var_starts - 1)

find_var_idx_rev: types::Cg, String, Int => Int
find_var_idx_rev = cg, name, i =>
   i < 0
      | -1
      |
         v = cg.vars(i)!!
         v.name == name
            | i
            | find_var_idx_rev(cg, name, i - 1)

var_index: types::Cg, String => Int
var_index = cg, name =>
   find_var_idx_rev(cg, types::resolve_var_name(cg, name), ?cg.vars - 1)

is_addr_arg_scoped: types::Cg, ast::Expr, Int => <>
is_addr_arg_scoped = cg, arg, threshold =>
   arg
      [Int _] <->
      [Rune _] <->
      | is_block_scoped_addr(cg, arg, threshold)

record_fields_has_block_scoped_addr: types::Cg, ast::Fields, Int, Int => <>
record_fields_has_block_scoped_addr = cg, flds, at, threshold =>
   at == ?flds
      | <->
      |
         fld = flds(at)!!
         is_block_scoped_addr(cg, fld.val, threshold) ||
            record_fields_has_block_scoped_addr(cg, flds, at + 1, threshold)

is_block_scoped_addr: types::Cg, ast::Expr, Int => <>
is_block_scoped_addr = cg, expr, threshold =>
   expr
      [Var v]
         idx = var_index(cg, v)
         idx !< threshold
      [Unary u]
         u.0
            [AddrOf] <+>
            | is_block_scoped_addr(cg, u.1, threshold)
      [Bin b]
         is_block_scoped_addr(cg, b.1, threshold) ||
            is_block_scoped_addr(cg, b.2, threshold)
      [Block _] <+>
      [RawMemory _] <+>
      [TypeCast tc] is_block_scoped_addr(cg, tc.expr, threshold)
      [Record r] record_fields_has_block_scoped_addr(cg, r.fields, 0, threshold)
      [Variant v] exprs_has_block_scoped_addr(cg, v.args, 0, threshold)
      [Call c]
         c.fn_name == "Addr"
            | ?c.args > 0
               | is_addr_arg_scoped(cg, c.args(0)!!, threshold)
               | <->
            | <+>
      | <->

exprs_has_block_scoped_addr: types::Cg, ast::Exprs, Int, Int => <>
exprs_has_block_scoped_addr = cg, exprs, at, threshold =>
   at == ?exprs
      | <->
      |
         is_block_scoped_addr(cg, exprs(at)!!, threshold) ||
            exprs_has_block_scoped_addr(cg, exprs, at + 1, threshold)

codegen_check_addr_escape: types::Cg,
   (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
codegen_check_addr_escape = cg, t =>
   cg.in_restore_scope > 0 && ?types::g.restore_scope_var_starts > 0
      |
         threshold = types::g.restore_scope_var_starts(?types::g.restore_scope_var_starts - 1)!!
         tgt_idx = var_index(cg, t.0)
         is_outer = (tgt_idx !< 0 && tgt_idx < threshold) || t.3 ||
            types::has_str(types::g.marked_globals, t.0)
         is_outer
            |
               is_addr = types::is_ptr_vt(types::var_type(cg, t.0)) ||
                  types::is_ptr_vt(types::static_expr_vt(cg, t.5)) || (t.7 == "Addr")
               is_addr && is_block_scoped_addr(cg, t.5, threshold)
                  | types::init_error(cg, "E3134", "Assignment of block-scoped Addr " +
                     "to outer-scope binding escapes arena lifecycle.", 0, 0)


codegen_block_arena_mark: types::Cg, <> => < Addr | >
codegen_block_arena_mark = cg, has_alloc =>
   has_alloc
      | <+ codegen_call_arena_save(cg, "blk.arena.mark") ->
      | <-->

block_is_binding: ast::BlockExpr => <>
block_is_binding = b =>
   nb = ?b.exprs
   nb > 1
      |
         last = b.exprs(nb - 1) | _ | ast::Expr(Int, 0)
         last
            [Record r]
               fields = r.fields
               ?fields == 2
                  |
                     dflt = ast::RecordField((<->, "", ast::Expr(Int, 0)))
                     f0 = fields(0) | _ | dflt
                     f1 = fields(1) | _ | dflt
                     f0.name == "get" && f1.name == "set"
                  | <->
            | <->
      | <->

block_has_arena_alloc: types::Cg, ast::BlockExpr => <>
block_has_arena_alloc = cg, b => exprs_has_arena_alloc(cg, b.exprs, 0)

codegen_eval_call_addr: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_call_addr = cg, call =>
   ?call.args == 0
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Int))
      |
         arg = call.args(0) | _ | ast::Expr(Var, "")
         var_name = arg [Var v] v | ""
         v_slot = var_name != "" | types::var_slot(cg, var_name) | <-->
         i64t = llvm::LLVMInt64Type!
         v_slot
            | slot =>
               res' = llvm::LLVMBuildPtrToInt(cg.builder, slot, i64t, "ptr.addr")
               (res', ast::ValueType(Int))
            |
               ev = codegen_eval(cg, arg)
               clean_p = clean_untagged_addr(cg, ev.0)
               res' = llvm::LLVMBuildPtrToInt(cg.builder, clean_p, i64t,
                  "ptr.addr")
               (res', ast::ValueType(Int))

call_has_target: ast::CallExpr => <>
call_has_target = call =>
   call.fn_name == ""
      | <+>
      |
         call.fn_target
            [Var v] v != ""
            | <+>

codegen_eval_call: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_call = cg, t =>
   call_pred = types::call_type_pred_name(t)
   call_pred != "" && ?t.args == 1
      |
         arg0 = t.args(0) | _ | ast::Expr(Int, 0)
         arg_ti = types::resolve_type_value(cg, arg0)
         arg_ti.1
            |
               matched = types::eval_type_predicate(cg, call_pred, arg_ti.0)
               flag_val = matched | 1 | 0
               i1t = llvm::LLVMInt1Type!
               (llvm::LLVMConstInt(i1t, flag_val, 0), ast::ValueType(Flag))
            | codegen_eval_call_default(cg, t)
      | codegen_eval_call_default(cg, t)

codegen_eval_call_default: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_call_default = cg, t =>
   call_has_target(t)
      | codegen_eval_call_target(cg, t)
      |
         t.fn_name == "addr"
            | codegen_eval_call_addr(cg, t)
            | codegen_eval_call_non_addr(cg, t)

codegen_eval_call_target: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_call_target = cg, t =>
   bv = codegen_eval(cg, t.fn_target)
   bv.1
      [Record] main::codegen_eval_evaluated_rec_access(cg, t, bv.0)
      [Slice] main::codegen_eval_evaluated_slice_access(cg, t, bv.0)
      [Array] main::codegen_eval_evaluated_array_access(cg, t, bv.0)
      [Str] main::codegen_eval_base_str_access(cg, t, bv.0)
      | codegen_eval_indirect_target_call(cg, t, bv.0, bv.1)

codegen_eval_call_non_addr: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_call_non_addr = cg, t =>
   is_intrinsic_name(t.fn_name)
      | codegen_eval_legacy_intrinsic(cg, t)
      |
         t.fn_name == "Error"
            | main::codegen_eval_error_construct(cg, t)
            |
               is_local_fn = types::has_local_var(cg, t.fn_name) ||
                  (stmt::param_clo_ty(cg, t.fn_name) != Addr(0))
               rf = is_local_fn | t.fn_name | types::resolve_fn_name(cg, t.fn_name)
               call = t
               call.fn_name = rf
               tn = types::type_name_to_vt(t.fn_name)
               tn.1
                  |
                     ?t.args == 0 && types::is_builder_vt(tn.0)
                        |
                           i64t = llvm::LLVMInt64Type!
                           b_cap = llvm::LLVMConstInt(i64t, 32, 0)
                           (main::codegen_builder_create(cg, b_cap, "builder.new"),
                              ast::ValueType(Builder))
                        |
                           arg = t.args(0)!!
                           codegen_eval_coerce(cg, tn.0, arg)
                  |
                     !is_local_fn && (types::is_fn_name(cg, rf) || types::has_fn_name(cg, rf))
                        | codegen_eval_fn_call(cg, call)
                        |
                           rt = types::resolve_type_name(cg, t.fn_name)
                           types::is_user_type(cg, rt)
                              |
                                 cg.last_type = rt
                                 types::codegen_eval_ctor(cg, types::typedef_ti(cg, rt), call)
                              | codegen_eval_call_var_dispatch(cg, call)

codegen_eval_call_var_dispatch: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_call_var_dispatch = cg, call =>
   vt = types::var_type(cg, call.fn_name)
   vt
      [Record]
         fvs = match::var_fvts(cg, call.fn_name)
         is_hetero = ?fvs > 1
            |
               types::var_rt(cg, call.fn_name)
                  | rt => !record_type_is_homogeneous(rt, fvs)
                  | <+>
            | <->
         is_hetero
            | stmt::codegen_dynamic_record_index_error(cg)
            | main::codegen_eval_record_index(cg, call)
      [Str] main::codegen_eval_str_index(cg, call)
      [Slice] main::slice_or_range(cg, call)
      [Array] main::codegen_eval_array_index(cg, call)
      |
         is_dotted_fn = types::find_dot(call.fn_name, 0) > 0
         is_dotted_fn && main::is_fn_vt(vt)
            |
               mv = types::dotted_var_val(cg, call.fn_name)
               ret_vt = types::dotted_fn_ret_vt(cg, call.fn_name)
               ret_vt == ast::ValueType(Unknown)
                  | codegen_indirect_fn_return_unknown(cg, call)
                  | codegen_closure_call_indirect_val(cg, call, mv.0, ret_vt)
            | codegen_eval_fn_call(cg, call)

ct_ti_resolve: types::Cg, ast::TypeInfo => (ast::TypeInfo, String)
ct_ti_resolve = cg, ti =>
   ti
      [TypeVar name] (types::typedef_ti(cg, name), name)
      | (ti, "")

codegen_materialize_prim: types::Cg, ast::ValueType => < (Addr, ast::ValueType) | >
codegen_materialize_prim = cg, vt =>
   types::is_int_vt(vt)
      |
         <+ (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
            ast::ValueType(Int)) ->
      |
         types::is_float_vt(vt)
            |
               <+ (llvm::LLVMConstReal(llvm::LLVMDoubleType!, 0.0),
                  ast::ValueType(Float)) ->
            |
               types::is_str_vt(vt)
                  | <+ (stmt::codegen_string_literal(cg, ""), ast::ValueType(Str)) ->
                  |
                     types::is_flag_vt(vt)
                        |
                           <+ (llvm::LLVMConstInt(llvm::LLVMInt1Type!, 0, 0),
                              ast::ValueType(Flag)) ->
                        | <-->

codegen_materialize_ti: types::Cg, ast::TypeInfo, String => < (Addr, ast::ValueType) | >
codegen_materialize_ti = cg, ti, tname =>
   ti
      [Array ae]
         u' = main::codegen_array_create(cg, "cttr.array")
         tname != "" | cg.last_type = tname | 0
         <+ (u', ast::ValueType(Array)) ->
      [Map mk]
         u' = runtime::codegen_map_create(cg, "cttr.map")
         tname != "" | cg.last_type = tname | 0
         <+ (u', ast::ValueType(Map)) ->
      [Prim p]
         codegen_materialize_prim(cg, p)
      | <-->

codegen_materialize_cttr: types::Cg, ast::TypeInfo => < (Addr, ast::ValueType) | >
codegen_materialize_cttr = cg, ti =>
   resolved = ct_ti_resolve(cg, ti)
   codegen_materialize_ti(cg, resolved.0, resolved.1)

// Evaluates an expression to an LLVM value + its ValueType.
codegen_eval: types::Cg, ast::Expr => (Addr, ast::ValueType)
codegen_eval = cg, expr =>
   expr
      [Int n] (llvm::LLVMConstInt(llvm::LLVMInt64Type!, n, 0), ast::ValueType(Int))
      [Rune n] (llvm::LLVMConstInt(llvm::LLVMInt64Type!, n, 0), ast::ValueType(Rune))
      [Float f] (llvm::LLVMConstReal(llvm::LLVMDoubleType!, f), ast::ValueType(Float))
      [Str s] (stmt::codegen_string_literal(cg, s), ast::ValueType(Str))
      [Var v]
         rv = types::resolve_var_name(cg, v)
         is_v = (v == "_") || types::var_has_storage(cg, v)
         is_v
            | types::codegen_load(cg, rv)
            |
               el_owners = types::enum_label_owner_count(cg, v, 0)
               el_owners > 0
                  | types::codegen_eval_enum_label_val(cg, v, el_owners)
                  |
                     rf = types::resolve_fn_name(cg, v)
                     fn_is_val = types::is_fn_name(cg, rf) ||
                        (fn_alias(cg, rv) != "") || types::has_fn_name(cg, rf)
                     fn_is_val
                        |
                           nfv = codegen_named_fn_value(cg, rf)
                           nfv | _ | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                              ast::ValueType(Unknown))
                        |
                           ct = types::ct_bind_find(v)
                           ct.1
                              |
                                 mat = codegen_materialize_cttr(cg, ct.0)
                                 mat | _ | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                                    ast::ValueType(Unknown))
                              |
                                 rt = types::resolve_type_name(cg, v)
                                 types::is_user_type(cg, rt)
                                    | types::codegen_eval_type_value(cg, rt)
                                    |
                                       tn = types::type_name_to_vt(v)
                                       tn.1
                                          | types::codegen_eval_type_value(cg, v)
                                          | types::codegen_load(cg, rv)
      [Assign t]
         runtime::codegen_emit_assign(cg, t)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      [Bin t] codegen_eval_bin(cg, t)
      [Unary t] codegen_eval_unary(cg, t)
      [TypeCast t] codegen_eval_cast(cg, t)
      [Call t] codegen_eval_call(cg, t)
      [Copy copy_e]
         ev = codegen_eval(cg, copy_e)
         is_str_e = ev.1 [Str]
         is_rec_e = ev.1 [Record]
         is_arr_e = ev.1 [Array]
         is_str_e
            | (codegen_string_copy(cg, ev.0), ast::ValueType(Str))
            |
               is_rec_e
                  |
                     vname' = copy_e [Var vn] vn | ""
                     rec_t = vname' != ""
                        |
                           types::var_rt(cg, vname')
                              | _
                              | cg.last_rt
                        | cg.last_rt
                     sz = llvm::LLVMSizeOf(rec_t)
                     new_p = codegen_call_arena_alloc(cg, sz, "record.copy")
                     llvm::LLVMBuildMemCpy(cg.builder, new_p, 1, ev.0, 1, sz, 0)
                     cg.last_rt = rec_t
                     vname' != "" | cg.last_fnames = types::var_fnames(cg, vname') | 0
                     vname' != "" | cg.last_fvts = match::var_fvts(cg, vname') | 0
                     vname' != "" | cg.last_type = types::var_dtype(cg, vname') | 0
                     (new_p, ast::ValueType(Record))
                  |
                     is_arr_e
                        |
                           vname' = copy_e [Var vn] vn | ""
                           dt = vname' != "" | types::var_dtype(cg, vname') | ""
                           dt != "" | cg.last_type = dt
                           new_arr = main::codegen_array_copy(cg, ev.0, "a.copy")
                           (new_arr, ast::ValueType(Array))
                        | (ev.0, ev.1)
      [Fn f]
         lr = stmt::compile_lambda(cg, f)
         cg.last_closure_fn = lr.1
         (lr.0, ast::ValueType(Fn))
      [Choice c] match::codegen_eval_choice(cg, c)
      [Variant t] types::codegen_eval_variant(cg, t)
      [Record r] types::codegen_eval_record(cg, r)
      [MapLiteral m] types::codegen_eval_map_literal(cg, m)
      [RawMemory rm] types::codegen_eval_raw_memory(cg, rm)
      [Member t] match::codegen_eval_member(cg, t)
      [KeyAccess t] runtime::codegen_eval_key_access(cg, t)
      [CompileTime t]
         ct_res = match::ctfe_eval(cg, t.expr, types::CtFrames(), 0)
         match::ctfe_lower(cg, ct_res.0, ct_res.1)
      [Cycle c] stmt::codegen_eval_cycle(cg, c)
      [CycleJump j] stmt::codegen_eval_cycle_jump(cg, j)
      [CycleEscape esc] stmt::codegen_eval_cycle_escape(cg, esc)
      [Spawn s] main::codegen_eval_spawn(cg, s)
      [Join j] main::codegen_eval_join(cg, j)
      [SizeOf so]
         so_sz = types::codegen_sizeof_bytes(cg, so)
         so_val = llvm::LLVMConstInt(llvm::LLVMInt64Type!, so_sz, 0)
         (so_val, ast::ValueType(Int))
      [BuilderCreate b]
         bv = codegen_eval(cg, b)
         (main::codegen_builder_create(cg, bv.0, "builder.create"), ast::ValueType(Builder))
      [Exit t]
         runtime::codegen_emit_exit(cg, t)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      [Block b]
         has_alloc = (block_has_arena_alloc(cg, b) && !cg.in_fn &&
            !block_is_binding(b))
         mark = codegen_block_arena_mark(cg, has_alloc)
         codegen_restore_scope_enter(cg, has_alloc)
         nb = ?b.exprs
         saved_discard = cg.discard_result
         last = codegen_eval_block_step(cg, b.exprs, 0, nb, saved_discard)
         cg.discard_result = saved_discard
         codegen_restore_scope_leave(cg, mark)
         has_alloc && types::is_ptr_vt(last.1)
            |
               types::init_error(cg, "E3133", "Cannot return Addr from an " +
                  "arena-restore scope. Copy data explicitly with '++' " +
                  "before boundary.", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            | last
      [FastMathPragma s]
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      [SwizzlePragma s]
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      [UserDiag ud] match::codegen_eval_user_diag(cg, ud)
      [Range r]
         types::init_error(cg, "E3008",
            "Range expression cannot be used as an independent value.", 0, 0)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_eval_block_step: types::Cg, ast::Exprs, Int, Int, <> => (Addr, ast::ValueType)
codegen_eval_block_step = cg, exprs, i, n, saved_discard =>
   i == n
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      |
         el = exprs(i)!!
         is_disc = saved_discard || (i < n - 1)
         cg.discard_result = is_disc
         v = codegen_eval(cg, el)
         i == n - 1
            | v
            | codegen_eval_block_step(cg, exprs, i + 1, n, saved_discard)

codegen_eval_bin: types::Cg, (ast::BinaryOp, ast::Expr, ast::Expr) => (Addr, ast::ValueType)
codegen_eval_bin = cg, t =>
   op = t.0
   op
      [Seq]
         saved_discard' = cg.discard_result
         cg.discard_result = <+>
         lr = codegen_eval(cg, t.1)
         cg.discard_result = saved_discard'
         codegen_eval(cg, t.2)
      |
         saved_discard' = cg.discard_result
         cg.discard_result = <->
         r = codegen_eval_bin_op(cg, op, t)
         cg.discard_result = saved_discard'
         r

codegen_eval_bin_op: types::Cg, ast::BinaryOp,
   (ast::BinaryOp, ast::Expr, ast::Expr) => (Addr, ast::ValueType)
codegen_eval_bin_op = cg, op, t =>
   op
      [And]
         match::codegen_emit_logical(cg, <+>, t)
      [Or]
         match::codegen_emit_logical(cg, <->, t)
      [Add, Sub, Mul, Div, Mod, BitAnd, BitOr, Shl, Shr]
         codegen_emit_arith(cg, op, t)
      [Gt, Lt, Eq, NotEq, NotGt, NotLt]
         match::codegen_emit_cmp(cg, op, t)
      [Feed, Apply]
         codegen_emit_apply_feed(cg, op, t)
      [Bind]
         b_res = codegen_emit_bind(cg, t)
         b_res | _ | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

// "$>>" — monadic bind over a ram with a positive payload slot (RamPP/RamPN).
// Lowered to a choice: the positive slot's payload feeds the continuation
// (which returns the same monad); a negative lhs propagates as a negative
// union (unit for RamPN). The result is always a ram.
ram_slot_has_payload: ast::RamSlotInfo => <>
ram_slot_has_payload = slot => slot.has_payload

codegen_emit_bind: types::Cg, (ast::BinaryOp, ast::Expr, ast::Expr) => < (Addr, ast::ValueType) | >
codegen_emit_bind = cg, t =>
   dtype = match::ram_expr_dtype(cg, t.1)
   slots = match::ram_slots_of(cg, dtype)
   ram_slot_has_payload(slots.0)
      | codegen_emit_bind_valid(cg, t, dtype)
      | codegen_emit_bind_slot_error(cg)

codegen_emit_bind_slot_error: types::Cg => < (Addr, ast::ValueType) | >
codegen_emit_bind_slot_error = cg =>
   types::init_error(cg, "E3091", "LHS of '$>>' must be a RamPP or RamPN " +
      "ramification (a positive payload slot is required), got a ram without " +
      "a positive payload slot.", 0, 0)
   <-->

codegen_emit_bind_valid: types::Cg, (ast::BinaryOp, ast::Expr, ast::Expr),
   String => < (Addr, ast::ValueType) | >
codegen_emit_bind_valid = cg, t, dtype =>
   // Keep $>> as syntax sugar, not a separate lowering.  The reference
   // expands it before codegen to `lhs | rhs(_) | <-->` for RamPN and to
   // `lhs | rhs(_) | <- _ ->` for RamPP.  Reusing the normal bare-choice
   // path preserves its payload binding, branch topology, and result phi.
   res = match::codegen_eval_choice(cg, bind_choice(cg, t, dtype))
   dtype != "" | cg.last_type = dtype | 0
   <+ res ->

bind_choice: types::Cg, (ast::BinaryOp, ast::Expr, ast::Expr), String => ast::ChoiceExpr
bind_choice = cg, t, dtype =>
   branches = ast::Branches()
   branches += bind_choice_branch(bind_positive_body(t.2))
   slots = match::ram_slots_of(cg, dtype)
   branches += bind_choice_branch(bind_negative_body(slots.1))
   ast::ChoiceExpr((t.1, <+>, branches))

bind_choice_branch: ast::Expr => ast::ChoiceBranch
bind_choice_branch = body =>
   ast::ChoiceBranch((ast::GuardKind(Bare), ast::Exprs(), ast::Expr(Var, "?"),
      ast::Names(), ast::Names(), <->, body))

bind_positive_body: ast::Expr => ast::Expr
bind_positive_body = rhs =>
   rhs
      [Fn f] rhs
      [Var name]
         args = ast::Exprs()
         args += ast::Expr(Var, "_")
         ast::Expr(Call, (ast::CallExpr((name, ast::Expr(Var, ""), args, 0, 0))))
      | rhs

bind_negative_body: ast::RamSlotInfo => ast::Expr
bind_negative_body = slot =>
   args = ast::Exprs()
   slot.has_payload | args += ast::Expr(Var, "_")
   tag = slot.has_payload | ast::Tag(Err) | ast::Tag(Noth)
   ast::Expr(Variant, (ast::VariantExpr((tag, args))))

// Calls a compiled closure with pre-evaluated args (the env is passed as the
// lambda's implicit first param when it captures).
call_lambda: types::Cg, (Addr, String), types::Addrs => (Addr, ast::ValueType)
call_lambda = cg, cl, args =>
   fidx = types::fninfo_index(cg, cl.1)
   fidx !< 0
      |
         fi = cg.fninfos(fidx)!!
         arg_vals = types::Addrs()
         arg_vals += stmt::closure_env_ptr(cg, cl.0, "clo.env")
         ?args @ i => arg_vals += args(i)!!
         n = ?arg_vals
         buf = {n * 8}
         sb = &buf
         n @ i =>
            @[sb + i * 8] = arg_vals(i)!!
         fptr = stmt::closure_fn_ptr(cg, cl.0, "clo.fn")
         typed = llvm::LLVMBuildBitCast(cg.builder, fptr,
            llvm::LLVMPointerType(fi.llvm_type, 0), "clo.typed")
         res_name = fi.ret_vt [Unit] "" | "clo.call"
         res = llvm::LLVMBuildCall2(cg.builder, fi.llvm_type, typed,
            sb, n, res_name)
         (res, fi.ret_vt)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

apply_callee_name: ast::Expr => String
apply_callee_name = e =>
   e
      [Var v] v
      [Member m]
         tgt = m.target [Var tv] tv | match::module_member_name(m.target)
         tgt != ""
            | tgt + (m.is_module_access | "::" | ".") + m.field_name
            | ""
      | ""

apply_split: ast::Expr => (<>, String, ast::Expr, ast::Exprs)
apply_split = fn =>
   fn
      [Call c]
         (<+>, c.fn_name, c.fn_target, c.args)
      [Bin b]
         b.0
            [Feed]
               sub' = apply_split(b.2)
               sub'.0
                  |
                     args' = ast::Exprs()
                     args' += b.1
                     ?sub'.3 @ i =>
                        arg_i' = sub'.3(i) | _ | ast::Expr(Int, 0)
                        args' += arg_i'
                     (<+>, sub'.1, sub'.2, args')
                  |
                     callee' = apply_callee_name(b.2)
                     args' = ast::Exprs()
                     args' += b.1
                     tgt' = callee' == "" | b.2 | ast::Expr(Var, "")
                     (<+>, callee', tgt', args')
            [Apply]
               sub' = apply_split(b.1)
               sub'.0
                  |
                     args' = ast::Exprs()
                     ?sub'.3 @ i =>
                        arg_i' = sub'.3(i) | _ | ast::Expr(Int, 0)
                        args' += arg_i'
                     args' += b.2
                     (<+>, sub'.1, sub'.2, args')
                  |
                     callee' = apply_callee_name(b.1)
                     args' = ast::Exprs()
                     args' += b.2
                     tgt' = callee' == "" | b.1 | ast::Expr(Var, "")
                     (<+>, callee', tgt', args')
            | (<->, "", ast::Expr(Var, ""), ast::Exprs())
      | (<->, "", ast::Expr(Var, ""), ast::Exprs())

// "$>" (feed, reverse application) / "$" (infix apply). The fn side is a bare
// name ("x $> f" == "f(x)", "f $ x" == "f(x)") or a call ("x $> f(a)" ==
// "f(x, a)", "f(a) $ b" == "f(a, b)") — the value side is prepended (feed) or
// appended (apply) to the call's args.
codegen_emit_apply_feed: types::Cg, ast::BinaryOp,
   (ast::BinaryOp, ast::Expr, ast::Expr) => (Addr, ast::ValueType)
codegen_emit_apply_feed = cg, op, t =>
   is_feed = op [Feed]
   vside = is_feed | t.1 | t.2
   fside = is_feed | t.2 | t.1
   is_feed && is_match_function_expr(cg, fside)
      | codegen_emit_match_feed(cg, vside, fside)
      |
         sp = apply_split(fside)
         sp.0
            |
               args' = ast::Exprs()
               is_feed | args' += vside | 0
               ?sp.3 @ i => args' += sp.3(i)!!
               is_feed | 0 | args' += vside
               call' = ast::CallExpr((sp.1, sp.2, args', 0, 0))
               codegen_eval_call(cg, call')
            |
               callee = apply_callee_name(fside)
               fn_name = callee
               fn_target = callee == "" | fside | ast::Expr(Var, "")
               args' = ast::Exprs()
               args' += vside
               call' = ast::CallExpr((fn_name, fn_target, args', 0, 0))
               codegen_eval_call(cg, call')


// A call to a named function with PRE-EVALUATED argument values.
call_named: types::Cg, String, types::Addrs => (Addr, ast::ValueType)
call_named = cg, name, args =>
   resolved = types::resolve_fn_name(cg, name)
   fname0 = fn_alias(cg, resolved)
   fname1 = fn_alias(cg, name)
   fname = fname0 != "" | fname0 | (fname1 != "" | fname1 | resolved)
   types::has_fn_name(cg, fname) && !types::is_fn_name(cg, fname)
      |
         stmt::compile_fn_lazy(cg, fname, ast::VTypes())
         0
      | 0
   idx = types::fninfo_index(cg, fname)
   use_idx0 = idx !< 0 | idx | types::fninfo_index(cg, name)
   use_idx = use_idx0 < 0
      |
         stmt::declare_external_fn(cg, fname)
         stmt::declare_external_fn(cg, name)
         idx2 = types::fninfo_index(cg, fname)
         idx2 < 0 | types::fninfo_index(cg, name) | idx2
      | use_idx0
   use_idx !< 0
      |
         fi = cg.fninfos(use_idx)!!
         n = ?args
         buf = {n * 8}
         sb = &buf
         n @ i =>
            @[sb + i * 8] = args(i)!!
         res_name = fi.ret_vt [Unit] "" | "call.res"
         res = llvm::LLVMBuildCall2(cg.builder, fi.llvm_type,
            fi.llvm_fn, sb, n, res_name)
         fn_to_call = idx !< 0 | fname | name
         stmt::apply_call_ret_meta(cg, fn_to_call)
         (res, fi.ret_vt)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

// --- arithmetic --------------------------------------------------------------

// Converts an Int operand to double (used when the other operand is float).
coerce_float: types::Cg, Addr, ast::ValueType => Addr
coerce_float = cg, v, vt =>
   types::is_int_vt(vt)
      | llvm::LLVMBuildSIToFP(cg.builder, v, llvm::LLVMDoubleType!, "sitofp")
      | v

fixed_record_is_homogeneous: ast::VTypes, ast::ValueType, Int => <>
fixed_record_is_homogeneous = fvs, elem, at =>
   at == ?fvs
      | <+>
      | ((fvs(at) | _ | ast::ValueType(Unknown)) == elem) &&
         fixed_record_is_homogeneous(fvs, elem, at + 1)

struct_fields_same_type_at: Addr, Addr, Int, Int => <>
struct_fields_same_type_at = st, elem_t, i, n =>
   i == n
      | <+>
      | (llvm::LLVMStructGetTypeAtIndex(st, i) == elem_t) &&
         struct_fields_same_type_at(st, elem_t, i + 1, n)

record_type_is_homogeneous: Addr, ast::VTypes => <>
record_type_is_homogeneous = rt, fvts =>
   n = ?fvts
   (n == 0) || (rt == Addr(0))
      | <->
      |
         first = (fvts(0) | _ | ast::ValueType(Unknown))
         elem_t = llvm::LLVMStructGetTypeAtIndex(rt, 0)
         fixed_record_is_homogeneous(fvts, first, 0) &&
            struct_fields_same_type_at(rt, elem_t, 1, n)

is_numeric_vt: ast::ValueType => <>
is_numeric_vt = vt => types::is_int_vt(vt) || types::is_float_vt(vt)

is_numeric_fixed_record: (Addr, ast::ValueType), Addr, ast::VTypes => <>
is_numeric_fixed_record = val, rt, fvts =>
   is_rec = val.1 [Record]
   n_ok = ?fvts > 0
   rt_ok = rt != Addr(0)
   val_ok = val.0 != Addr(0)
   val_ok && is_rec && n_ok && rt_ok &&
      record_type_is_homogeneous(rt, fvts) &&
      is_numeric_vt((fvts(0) | _ | ast::ValueType(Unknown)))

is_cmp_fixed_record: (Addr, ast::ValueType), Addr, ast::VTypes => <>
is_cmp_fixed_record = val, rt, fvts =>
   is_rec = val.1 [Record]
   n_ok = ?fvts > 0
   rt_ok = rt != Addr(0)
   val_ok = val.0 != Addr(0)
   val_ok && is_rec && n_ok && rt_ok &&
      record_type_is_homogeneous(rt, fvts) &&
      (is_numeric_vt((fvts(0) | _ | ast::ValueType(Unknown))) ||
         types::is_flag_vt((fvts(0) | _ | ast::ValueType(Unknown))))

is_flag_fixed_record: (Addr, ast::ValueType), Addr, ast::VTypes => <>
is_flag_fixed_record = val, rt, fvts =>
   is_rec = val.1 [Record]
   n_ok = ?fvts > 0
   rt_ok = rt != Addr(0)
   val_ok = val.0 != Addr(0)
   val_ok && is_rec && n_ok && rt_ok &&
      record_type_is_homogeneous(rt, fvts) &&
      types::is_flag_vt((fvts(0) | _ | ast::ValueType(Unknown)))

elem_byte_size: ast::ValueType => Int
elem_byte_size = vt =>
   types::is_float_vt(vt)
      | (vt [F32] 4 | 8)
      | (vt [I8, U8] 1 | (vt [I16, U16] 2 | (vt [I32, U32] 4 | 8)))

codegen_vector_type: Addr, Int => Addr
codegen_vector_type = elem_llvm, count =>
   zero_buf = {count * 8}
   zero_p = &zero_buf
   count @ i => @[zero_p + i * 8] = llvm::LLVMConstNull(elem_llvm)
   vec = llvm::LLVMConstVector(zero_p, count)
   llvm::LLVMTypeOf(vec)

codegen_build_splat: types::Cg, Addr, Addr, Int => Addr
codegen_build_splat = cg, scalar, elem_llvm, count =>
   zero_buf = {count * 8}
   zero_p = &zero_buf
   count @ i => @[zero_p + i * 8] = llvm::LLVMConstNull(elem_llvm)
   base_vec = llvm::LLVMConstVector(zero_p, count)
   zero32 = llvm::LLVMConstInt(llvm::LLVMInt32Type!, 0, 0)
   inserted = llvm::LLVMBuildInsertElement(cg.builder, base_vec, scalar,
      zero32, "arr.splat.ins")
   mask_buf = {count * 8}
   mask_p = &mask_buf
   count @ i => @[mask_p + i * 8] = zero32
   mask = llvm::LLVMConstVector(mask_p, count)
   llvm::LLVMBuildShuffleVector(cg.builder, inserted, base_vec, mask,
      "arr.splat")

codegen_array_vec_apply: types::Cg, ast::BinaryOp, Addr, Addr, Addr, ast::ValueType,
   Int => Addr
codegen_array_vec_apply = cg, op, l, r, elem_llvm, elem_vt, count =>
   r_val' = r
   is_float = types::is_float_vt(elem_vt)
   is_unsigned = types::is_unsigned_vt(elem_vt)
   vec_ty = llvm::LLVMTypeOf(l)
   is_float
      |
         op
            [Add] llvm::LLVMBuildFAdd(cg.builder, l, r_val', "arr.vec.add")
            [Sub] llvm::LLVMBuildFSub(cg.builder, l, r_val', "arr.vec.sub")
            [Mul] llvm::LLVMBuildFMul(cg.builder, l, r_val', "arr.vec.mul")
            [Div] llvm::LLVMBuildFDiv(cg.builder, l, r_val', "arr.vec.div")
            [Mod] llvm::LLVMBuildFRem(cg.builder, l, r_val', "arr.vec.rem")
            | llvm::LLVMConstNull(vec_ty)
      |
         !is_unsigned && (op [Div, Mod])
            |
               is_zero = llvm::LLVMBuildICmp(cg.builder, 32, r_val',
                  llvm::LLVMConstNull(vec_ty), "arr.div.iszero")
               one = llvm::LLVMConstInt(elem_llvm, 1, 0)
               one_vec = codegen_build_splat(cg, one, elem_llvm, count)
               r_val' = llvm::LLVMBuildSelect(cg.builder, is_zero, one_vec,
                  r_val', "arr.div.safe")
            | 0
         op
            [Add] llvm::LLVMBuildAdd(cg.builder, l, r_val', "arr.vec.add")
            [Sub] llvm::LLVMBuildSub(cg.builder, l, r_val', "arr.vec.sub")
            [Mul] llvm::LLVMBuildMul(cg.builder, l, r_val', "arr.vec.mul")
            [Div]
               is_unsigned
                  | llvm::LLVMBuildUDiv(cg.builder, l, r_val', "arr.vec.udiv")
                  | llvm::LLVMBuildSDiv(cg.builder, l, r_val', "arr.vec.sdiv")
            [Mod]
               is_unsigned
                  | llvm::LLVMBuildURem(cg.builder, l, r_val', "arr.vec.urem")
                  | llvm::LLVMBuildSRem(cg.builder, l, r_val', "arr.vec.srem")
            [BitAnd] llvm::LLVMBuildAnd(cg.builder, l, r_val', "arr.vec.and")
            [BitOr] llvm::LLVMBuildOr(cg.builder, l, r_val', "arr.vec.or")
            [Shl] llvm::LLVMBuildShl(cg.builder, l, r_val', "arr.vec.shl")
            [Shr] llvm::LLVMBuildLShr(cg.builder, l, r_val', "arr.vec.shr")
            | llvm::LLVMConstNull(vec_ty)

codegen_array_scalar_apply: types::Cg, ast::BinaryOp, Addr, Addr, Addr,
   ast::ValueType => Addr
codegen_array_scalar_apply = cg, op, l, r, elem_llvm, elem_vt =>
   r_val' = r
   is_float = types::is_float_vt(elem_vt)
   is_unsigned = types::is_unsigned_vt(elem_vt)
   is_float
      |
         op
            [Add] llvm::LLVMBuildFAdd(cg.builder, l, r_val', "arr.elem.add")
            [Sub] llvm::LLVMBuildFSub(cg.builder, l, r_val', "arr.elem.sub")
            [Mul] llvm::LLVMBuildFMul(cg.builder, l, r_val', "arr.elem.mul")
            [Div] llvm::LLVMBuildFDiv(cg.builder, l, r_val', "arr.elem.div")
            [Mod] llvm::LLVMBuildFRem(cg.builder, l, r_val', "arr.elem.rem")
            | llvm::LLVMConstNull(elem_llvm)
      |
         !is_unsigned && (op [Div, Mod])
            |
               is_zero = llvm::LLVMBuildICmp(cg.builder, 32, r_val',
                  llvm::LLVMConstNull(elem_llvm), "arr.div.iszero")
               one = llvm::LLVMConstInt(elem_llvm, 1, 0)
               r_val' = llvm::LLVMBuildSelect(cg.builder, is_zero, one,
                  r_val', "arr.div.safe")
            | 0
         op
            [Add] llvm::LLVMBuildAdd(cg.builder, l, r_val', "arr.elem.add")
            [Sub] llvm::LLVMBuildSub(cg.builder, l, r_val', "arr.elem.sub")
            [Mul] llvm::LLVMBuildMul(cg.builder, l, r_val', "arr.elem.mul")
            [Div]
               is_unsigned
                  | llvm::LLVMBuildUDiv(cg.builder, l, r_val', "arr.elem.udiv")
                  | llvm::LLVMBuildSDiv(cg.builder, l, r_val', "arr.elem.sdiv")
            [Mod]
               is_unsigned
                  | llvm::LLVMBuildURem(cg.builder, l, r_val', "arr.elem.urem")
                  | llvm::LLVMBuildSRem(cg.builder, l, r_val', "arr.elem.srem")
            [BitAnd] llvm::LLVMBuildAnd(cg.builder, l, r_val', "arr.elem.and")
            [BitOr] llvm::LLVMBuildOr(cg.builder, l, r_val', "arr.elem.or")
            [Shl] llvm::LLVMBuildShl(cg.builder, l, r_val', "arr.elem.shl")
            [Shr] llvm::LLVMBuildLShr(cg.builder, l, r_val', "arr.elem.shr")
            | llvm::LLVMConstNull(elem_llvm)

codegen_scalar_to_elem: types::Cg, (Addr, ast::ValueType), Addr, ast::ValueType => Addr
codegen_scalar_to_elem = cg, sv, elem_llvm, elem_vt =>
   types::is_float_vt(elem_vt)
      |
         types::is_int_vt(sv.1)
            | llvm::LLVMBuildSIToFP(cg.builder, sv.0, elem_llvm,
               "arr.scalar.sitofp")
            |
               llvm::LLVMTypeOf(sv.0) == elem_llvm
                  | sv.0
                  |
                     is_f32 = elem_vt [F32]
                     is_f32
                        | llvm::LLVMBuildFPTrunc(cg.builder, sv.0, elem_llvm,
                           "arr.scalar.fptrunc")
                        | llvm::LLVMBuildFPExt(cg.builder, sv.0, elem_llvm,
                           "arr.scalar.fpext")
      | stmt::coerce_int(cg, sv.0, elem_llvm)

codegen_array_vector_op: types::Cg, ast::BinaryOp, Addr, <>, Addr, <>,
   (Int, Int, ast::ValueType, Addr, Addr, ast::VTypes) => (Addr, ast::ValueType)
codegen_array_vector_op = cg, op, lhs_val, lhs_arr, rhs_val, rhs_arr, meta =>
   count = meta.0
   total_bytes = meta.1
   elem_vt = meta.2
   elem_llvm = meta.3
   arr_rt = meta.4
   arr_fvts = meta.5
   vec_ty = codegen_vector_type(elem_llvm, count)
   arr_ptr_ty = llvm::LLVMPointerType(vec_ty, 0)
   align = elem_byte_size(elem_vt)
   l_vec = lhs_arr
      |
         bc_l = llvm::LLVMBuildPointerCast(cg.builder, lhs_val, arr_ptr_ty,
            "arr.l.bc")
         ld_l = llvm::LLVMBuildLoad2(cg.builder, vec_ty, bc_l, "arr.l")
         llvm::LLVMSetAlignment(ld_l, align)
         ld_l
      | codegen_build_splat(cg, lhs_val, elem_llvm, count)
   r_vec = rhs_arr
      |
         bc_r = llvm::LLVMBuildPointerCast(cg.builder, rhs_val, arr_ptr_ty,
            "arr.r.bc")
         ld_r = llvm::LLVMBuildLoad2(cg.builder, vec_ty, bc_r, "arr.r")
         llvm::LLVMSetAlignment(ld_r, align)
         ld_r
      | codegen_build_splat(cg, rhs_val, elem_llvm, count)
   res = codegen_array_vec_apply(cg, op, l_vec, r_vec, elem_llvm, elem_vt,
      count)
   i64t = llvm::LLVMInt64Type!
   result_ptr = codegen_call_arena_alloc(cg,
      llvm::LLVMConstInt(i64t, total_bytes, 0), "arr.alloc")
   bc_res = llvm::LLVMBuildPointerCast(cg.builder, result_ptr, arr_ptr_ty,
      "arr.res.bc")
   st = llvm::LLVMBuildStore(cg.builder, res, bc_res)
   llvm::LLVMSetAlignment(st, align)
   cg.last_rt = arr_rt
   cg.last_fnames = ast::Names()
   cg.last_fvts = arr_fvts
   (result_ptr, ast::ValueType(Record))

codegen_array_loop_op: types::Cg, ast::BinaryOp, Addr, <>, Addr, <>,
   (Int, Int, ast::ValueType, Addr, Addr, ast::VTypes) => (Addr, ast::ValueType)
codegen_array_loop_op = cg, op, lhs_val, lhs_arr, rhs_val, rhs_arr, meta =>
   count = meta.0
   total_bytes = meta.1
   elem_vt = meta.2
   elem_llvm = meta.3
   arr_rt = meta.4
   arr_fvts = meta.5
   i64t = llvm::LLVMInt64Type!
   result_ptr = codegen_call_arena_alloc(cg,
      llvm::LLVMConstInt(i64t, total_bytes, 0), "arr.alloc")
   is_float = types::is_float_vt(elem_vt)
   is_unsigned = types::is_unsigned_vt(elem_vt)
   cur = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   parent = cg.current_fn
   header_bb = llvm::LLVMAppendBasicBlock(parent, "arr.loop.hdr." + cur)
   body_bb = llvm::LLVMAppendBasicBlock(parent, "arr.loop.body." + cur)
   latch_bb = llvm::LLVMAppendBasicBlock(parent, "arr.loop.latch." + cur)
   exit_bb = llvm::LLVMAppendBasicBlock(parent, "arr.loop.exit." + cur)
   entry_bb = llvm::LLVMGetInsertBlock(cg.builder)
   stmt::branch_to(cg, header_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, header_bb)
   counter_phi = llvm::LLVMBuildPhi(cg.builder, i64t, "arr.loop.i")
   zero = llvm::LLVMConstInt(i64t, 0, 0)
   one = llvm::LLVMConstInt(i64t, 1, 0)
   count_const = llvm::LLVMConstInt(i64t, count, 0)
   cond_val = llvm::LLVMBuildICmp(cg.builder, 40, counter_phi, count_const,
      "arr.loop.cond")
   llvm::LLVMBuildCondBr(cg.builder, cond_val, body_bb, exit_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, body_bb)
   l_elem = lhs_arr
      |
         typed_l = llvm::LLVMBuildPointerCast(cg.builder, lhs_val,
            llvm::LLVMPointerType(elem_llvm, 0), "arr.l.ptr")
         l_ptr = types::gep1(cg, elem_llvm, typed_l, counter_phi, "arr.l.gep")
         llvm::LLVMBuildLoad2(cg.builder, elem_llvm, l_ptr, "arr.l.elem")
      | lhs_val
   r_elem = rhs_arr
      |
         typed_r = llvm::LLVMBuildPointerCast(cg.builder, rhs_val,
            llvm::LLVMPointerType(elem_llvm, 0), "arr.r.ptr")
         r_ptr = types::gep1(cg, elem_llvm, typed_r, counter_phi, "arr.r.gep")
         llvm::LLVMBuildLoad2(cg.builder, elem_llvm, r_ptr, "arr.r.elem")
      | rhs_val
   op_val = codegen_array_scalar_apply(cg, op, l_elem, r_elem, elem_llvm,
      elem_vt)
   typed_res = llvm::LLVMBuildPointerCast(cg.builder, result_ptr,
      llvm::LLVMPointerType(elem_llvm, 0), "arr.res.ptr")
   res_ptr = types::gep1(cg, elem_llvm, typed_res, counter_phi, "arr.res.gep")
   llvm::LLVMBuildStore(cg.builder, op_val, res_ptr)
   stmt::branch_to(cg, latch_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, latch_bb)
   next_c = llvm::LLVMBuildAdd(cg.builder, counter_phi, one, "arr.loop.next")
   stmt::branch_to(cg, header_bb)
   stmt::llvm_add_incoming1(cg, counter_phi, zero, entry_bb)
   stmt::llvm_add_incoming1(cg, counter_phi, next_c, latch_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, exit_bb)
   cg.last_rt = arr_rt
   cg.last_fnames = ast::Names()
   cg.last_fvts = arr_fvts
   (result_ptr, ast::ValueType(Record))

codegen_emit_array_arith: types::Cg, ast::BinaryOp,
   (Addr, ast::ValueType, Addr, ast::VTypes, <>),
   (Addr, ast::ValueType, Addr, ast::VTypes, <>) => (Addr, ast::ValueType)
codegen_emit_array_arith = cg, op, linfo, rinfo =>
   lr = (linfo.0, linfo.1)
   l_rt = linfo.2
   l_fvts = linfo.3
   lhs_arr = linfo.4
   rr = (rinfo.0, rinfo.1)
   r_rt = rinfo.2
   r_fvts = rinfo.3
   rhs_arr = rinfo.4
   arr_rt = lhs_arr | l_rt | r_rt
   arr_fvts = lhs_arr | l_fvts | r_fvts
   count = lhs_arr | ?l_fvts | ?r_fvts
   elem_vt = ?arr_fvts > 0 | (arr_fvts(0) | _ | ast::ValueType(Unknown)) |
      ast::ValueType(Unknown)
   is_bit = op [BitAnd, BitOr, Shl, Shr]
   is_bit && types::is_float_vt(elem_vt)
      | codegen_emit_bitwise_error(cg)
      |
         lhs_arr && rhs_arr && (?l_fvts != ?r_fvts)
            |
               types::init_error(cg, "E3160", "Element-wise array arithmetic " +
                  "requires equal element counts, got " +
                  str::from_int(?l_fvts) + " and " +
                  str::from_int(?r_fvts) + ".", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               l_elem_vt = (l_fvts(0) | _ | ast::ValueType(Unknown))
               r_elem_vt = (r_fvts(0) | _ | ast::ValueType(Unknown))
               lhs_arr && rhs_arr && (l_elem_vt != r_elem_vt)
                  |
                     types::init_error(cg, "E3161", "Element-wise array arithmetic " +
                        "requires matching element types, got " +
                        types::value_type_name(l_elem_vt) + " and " +
                        types::value_type_name(r_elem_vt) + ".", 0, 0)
                     (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
                  |
                     scalar_vt = lhs_arr | rr.1 | lr.1
                     bad_scalar = !lhs_arr || !rhs_arr
                     bad_flt = bad_scalar && types::is_float_vt(elem_vt) &&
                        !types::is_float_vt(scalar_vt)
                     bad_flt
                        |
                           types::init_error(cg, "E3162", "Element-wise Float-" +
                              "array arithmetic requires a Float scalar, " +
                              "got " + types::value_type_name(scalar_vt) + ".", 0, 0)
                           (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                              ast::ValueType(Unknown))
                        |
                           bad_int = bad_scalar && types::is_int_vt(elem_vt) &&
                              !types::is_int_vt(scalar_vt)
                           bad_int
                              |
                                 types::init_error(cg, "E3162", "Element-wise " +
                                    "integer-array arithmetic requires an " +
                                    "integer scalar, got " +
                                    types::value_type_name(scalar_vt) + ".", 0, 0)
                                 (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                                    ast::ValueType(Unknown))
                              |
                                 elem_ll_type_raw = arr_rt != Addr(0)
                                    | llvm::LLVMStructGetTypeAtIndex(arr_rt, 0)
                                    | types::llvm_type_of_vt(elem_vt)
                                 elem_llvm = elem_ll_type_raw == Addr(0)
                                    | llvm::LLVMInt64Type!
                                    | elem_ll_type_raw
                                 elem_bytes = elem_byte_size(elem_vt)
                                 total_bytes = elem_bytes * count
                                 l_op = lhs_arr | lr.0 |
                                    codegen_scalar_to_elem(cg, lr, elem_llvm,
                                       elem_vt)
                                 r_op = rhs_arr | rr.0 |
                                    codegen_scalar_to_elem(cg, rr, elem_llvm,
                                       elem_vt)
                                 meta = (count, total_bytes, elem_vt,
                                    elem_llvm, arr_rt, arr_fvts)
                                 total_bytes < 129
                                    | codegen_array_vector_op(cg, op, l_op,
                                       lhs_arr, r_op, rhs_arr, meta)
                                    | codegen_array_loop_op(cg, op, l_op,
                                       lhs_arr, r_op, rhs_arr, meta)

make_flag_record_type: types::Cg, Int => Addr
make_flag_record_type = cg, count =>
   types = types::Addrs()
   i1t = llvm::LLVMInt1Type!
   count @ _ => types += i1t
   types::struct_type_n(cg, types, count)

make_flag_fvts: Int => ast::VTypes
make_flag_fvts = count =>
   fvts = ast::VTypes()
   count @ _ => fvts += ast::ValueType(Flag)
   fvts

load_flag_vector: types::Cg, Addr, Int => Addr
load_flag_vector = cg, ptr, count =>
   i1t = llvm::LLVMInt1Type!
   zero_buf = {count * 8}
   zero_p = &zero_buf
   count @ i => @[zero_p + i * 8] = llvm::LLVMConstNull(i1t)
   base_vec = llvm::LLVMConstVector(zero_p, count)
   load_flag_vector_step(cg, ptr, base_vec, count, 0)

load_flag_vector_step: types::Cg, Addr, Addr, Int, Int => Addr
load_flag_vector_step = cg, ptr, vec, count, i =>
   i == count
      | vec
      |
         i1t = llvm::LLVMInt1Type!
         i32t = llvm::LLVMInt32Type!
         i64t = llvm::LLVMInt64Type!
         idx64 = llvm::LLVMConstInt(i64t, i, 0)
         gep = types::gep1(cg, i1t, ptr, idx64, "mask.ld.gep")
         elem = llvm::LLVMBuildLoad2(cg.builder, i1t, gep, "mask.ld")
         llvm::LLVMSetAlignment(elem, 1)
         idx32 = llvm::LLVMConstInt(i32t, i, 0)
         next_vec = llvm::LLVMBuildInsertElement(cg.builder, vec, elem, idx32,
            "mask.ins")
         load_flag_vector_step(cg, ptr, next_vec, count, i + 1)

store_flag_vector: types::Cg, Addr, Addr, Int => ()
store_flag_vector = cg, result_ptr, vec, count =>
   i1t = llvm::LLVMInt1Type!
   i32t = llvm::LLVMInt32Type!
   i64t = llvm::LLVMInt64Type!
   count @ i =>
      idx32 = llvm::LLVMConstInt(i32t, i, 0)
      elem = llvm::LLVMBuildExtractElement(cg.builder, vec, idx32,
         "cmp.elem")
      idx64 = llvm::LLVMConstInt(i64t, i, 0)
      gep = types::gep1(cg, i1t, result_ptr, idx64, "cmp.elem.gep")
      llvm::LLVMBuildStore(cg.builder, elem, gep)

codegen_array_vector_cmp: types::Cg, ast::BinaryOp, Addr, <>, Addr, <>,
   (Int, Int, ast::ValueType, Addr, Addr, ast::VTypes) => (Addr, ast::ValueType)
codegen_array_vector_cmp = cg, op, lhs_val, lhs_arr, rhs_val, rhs_arr, meta =>
   count = meta.0
   elem_vt = meta.2
   elem_llvm = meta.3
   is_flag = types::is_flag_vt(elem_vt)
   i1t = llvm::LLVMInt1Type!
   l_flag_vec = lhs_arr
      | load_flag_vector(cg, lhs_val, count)
      | codegen_build_splat(cg, lhs_val, i1t, count)
   vec_ty = codegen_vector_type(elem_llvm, count)
   arr_ptr_ty = llvm::LLVMPointerType(vec_ty, 0)
   align = elem_byte_size(elem_vt)
   l_num_vec = lhs_arr
      |
         bc_l = llvm::LLVMBuildPointerCast(cg.builder, lhs_val,
            arr_ptr_ty, "arr.l.bc")
         ld_l = llvm::LLVMBuildLoad2(cg.builder, vec_ty, bc_l, "arr.l")
         llvm::LLVMSetAlignment(ld_l, align)
         ld_l
      | codegen_build_splat(cg, lhs_val, elem_llvm, count)
   l_vec = is_flag | l_flag_vec | l_num_vec
   r_flag_vec = rhs_arr
      | load_flag_vector(cg, rhs_val, count)
      | codegen_build_splat(cg, rhs_val, i1t, count)
   r_num_vec = rhs_arr
      |
         bc_r = llvm::LLVMBuildPointerCast(cg.builder, rhs_val,
            arr_ptr_ty, "arr.r.bc")
         ld_r = llvm::LLVMBuildLoad2(cg.builder, vec_ty, bc_r, "arr.r")
         llvm::LLVMSetAlignment(ld_r, align)
         ld_r
      | codegen_build_splat(cg, rhs_val, elem_llvm, count)
   r_vec = is_flag | r_flag_vec | r_num_vec
   is_float = types::is_float_vt(elem_vt)
   is_unsigned = types::is_unsigned_vt(elem_vt)
   res_vec = is_float
      | match::codegen_emit_fcmp(cg, op, l_vec, r_vec)
      | match::codegen_emit_icmp(cg, op, l_vec, r_vec, is_unsigned)
   res_rt = make_flag_record_type(cg, count)
   alloc_sz = llvm::LLVMSizeOf(res_rt)
   result_ptr = codegen_call_arena_alloc(cg, alloc_sz, "rec.cmp.alloc")
   store_flag_vector(cg, result_ptr, res_vec, count)
   cg.last_rt = res_rt
   cg.last_fnames = ast::Names()
   cg.last_fvts = make_flag_fvts(count)
   (result_ptr, ast::ValueType(Record))

codegen_array_loop_cmp: types::Cg, ast::BinaryOp, Addr, <>, Addr, <>,
   (Int, Int, ast::ValueType, Addr, Addr, ast::VTypes) => (Addr, ast::ValueType)
codegen_array_loop_cmp = cg, op, lhs_val, lhs_arr, rhs_val, rhs_arr, meta =>
   count = meta.0
   elem_vt = meta.2
   elem_llvm = meta.3
   i64t = llvm::LLVMInt64Type!
   i1t = llvm::LLVMInt1Type!
   res_rt = make_flag_record_type(cg, count)
   alloc_sz = llvm::LLVMSizeOf(res_rt)
   result_ptr = codegen_call_arena_alloc(cg, alloc_sz, "rec.cmp.alloc")
   is_float = types::is_float_vt(elem_vt)
   is_unsigned = types::is_unsigned_vt(elem_vt)
   cur = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   parent = cg.current_fn
   header_bb = llvm::LLVMAppendBasicBlock(parent, "arr.cmp.hdr." + cur)
   body_bb = llvm::LLVMAppendBasicBlock(parent, "arr.cmp.body." + cur)
   latch_bb = llvm::LLVMAppendBasicBlock(parent, "arr.cmp.latch." + cur)
   exit_bb = llvm::LLVMAppendBasicBlock(parent, "arr.cmp.exit." + cur)
   entry_bb = llvm::LLVMGetInsertBlock(cg.builder)
   stmt::branch_to(cg, header_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, header_bb)
   counter_phi = llvm::LLVMBuildPhi(cg.builder, i64t, "arr.cmp.i")
   zero = llvm::LLVMConstInt(i64t, 0, 0)
   one = llvm::LLVMConstInt(i64t, 1, 0)
   count_const = llvm::LLVMConstInt(i64t, count, 0)
   cond_val = llvm::LLVMBuildICmp(cg.builder, 40, counter_phi, count_const,
      "arr.cmp.cond")
   llvm::LLVMBuildCondBr(cg.builder, cond_val, body_bb, exit_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, body_bb)
   l_elem = lhs_arr
      |
         typed_l = llvm::LLVMBuildPointerCast(cg.builder, lhs_val,
            llvm::LLVMPointerType(elem_llvm, 0), "arr.l.ptr")
         l_ptr = types::gep1(cg, elem_llvm, typed_l, counter_phi, "arr.l.gep")
         llvm::LLVMBuildLoad2(cg.builder, elem_llvm, l_ptr, "arr.l.elem")
      | lhs_val
   r_elem = rhs_arr
      |
         typed_r = llvm::LLVMBuildPointerCast(cg.builder, rhs_val,
            llvm::LLVMPointerType(elem_llvm, 0), "arr.r.ptr")
         r_ptr = types::gep1(cg, elem_llvm, typed_r, counter_phi, "arr.r.gep")
         llvm::LLVMBuildLoad2(cg.builder, elem_llvm, r_ptr, "arr.r.elem")
      | rhs_val
   op_val = is_float
      | match::codegen_emit_fcmp(cg, op, l_elem, r_elem)
      | match::codegen_emit_icmp(cg, op, l_elem, r_elem, is_unsigned)
   res_ptr = types::gep1(cg, i1t, result_ptr, counter_phi, "arr.res.gep")
   llvm::LLVMBuildStore(cg.builder, op_val, res_ptr)
   stmt::branch_to(cg, latch_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, latch_bb)
   next_c = llvm::LLVMBuildAdd(cg.builder, counter_phi, one, "arr.cmp.next")
   stmt::branch_to(cg, header_bb)
   stmt::llvm_add_incoming1(cg, counter_phi, zero, entry_bb)
   stmt::llvm_add_incoming1(cg, counter_phi, next_c, latch_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, exit_bb)
   cg.last_rt = res_rt
   cg.last_fnames = ast::Names()
   cg.last_fvts = make_flag_fvts(count)
   (result_ptr, ast::ValueType(Record))

codegen_emit_array_cmp: types::Cg, ast::BinaryOp,
   (Addr, ast::ValueType, Addr, ast::VTypes, <>),
   (Addr, ast::ValueType, Addr, ast::VTypes, <>) => (Addr, ast::ValueType)
codegen_emit_array_cmp = cg, op, linfo, rinfo =>
   lr = (linfo.0, linfo.1)
   l_rt = linfo.2
   l_fvts = linfo.3
   lhs_arr = linfo.4
   rr = (rinfo.0, rinfo.1)
   r_rt = rinfo.2
   r_fvts = rinfo.3
   rhs_arr = rinfo.4
   arr_rt = lhs_arr | l_rt | r_rt
   arr_fvts = lhs_arr | l_fvts | r_fvts
   count = lhs_arr | ?l_fvts | ?r_fvts
   elem_vt = ?arr_fvts > 0 | (arr_fvts(0) | _ | ast::ValueType(Unknown)) |
      ast::ValueType(Unknown)
   is_flag = types::is_flag_vt(elem_vt)
   is_order = match::cmp_order_op(op)
   is_flag && is_order
      | match::codegen_emit_cmp_flag_ram_error(cg, op)
      |
         lhs_arr && rhs_arr && (?l_fvts != ?r_fvts)
            |
               types::init_error(cg, "E3160", "Element-wise array comparison " +
                  "requires equal element counts, got " +
                  str::from_int(?l_fvts) + " and " +
                  str::from_int(?r_fvts) + ".", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               l_elem_vt = (l_fvts(0) | _ | ast::ValueType(Unknown))
               r_elem_vt = (r_fvts(0) | _ | ast::ValueType(Unknown))
               lhs_arr && rhs_arr && (l_elem_vt != r_elem_vt)
                  |
                     types::init_error(cg, "E3161", "Element-wise array comparison " +
                        "requires matching element types, got " +
                        types::value_type_name(l_elem_vt) + " and " +
                        types::value_type_name(r_elem_vt) + ".", 0, 0)
                     (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
                  |
                     scalar_vt = lhs_arr | rr.1 | lr.1
                     bad_scalar = !lhs_arr || !rhs_arr
                     bad_flt = bad_scalar && types::is_float_vt(elem_vt) &&
                        !types::is_float_vt(scalar_vt)
                     bad_flt
                        |
                           types::init_error(cg, "E3162", "Element-wise Float-" +
                              "array comparison requires a Float scalar, " +
                              "got " + types::value_type_name(scalar_vt) + ".", 0, 0)
                           (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                              ast::ValueType(Unknown))
                        |
                           bad_int = bad_scalar && types::is_int_vt(elem_vt) &&
                              !types::is_int_vt(scalar_vt)
                           bad_int
                              |
                                 types::init_error(cg, "E3162", "Element-wise " +
                                    "integer-array comparison requires an " +
                                    "integer scalar, got " +
                                    types::value_type_name(scalar_vt) + ".", 0, 0)
                                 (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                                    ast::ValueType(Unknown))
                              |
                                 bad_flag = bad_scalar && is_flag &&
                                    !types::is_flag_vt(scalar_vt)
                                 bad_flag
                                    |
                                       types::init_error(cg, "E3162", "Element-wise " +
                                          "Flag-array comparison requires a " +
                                          "Flag scalar, got " +
                                          types::value_type_name(scalar_vt) + ".",
                                          0, 0)
                                       (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                                          ast::ValueType(Unknown))
                                    |
                                        raw_elem = arr_rt != Addr(0)
                                           |
                                              llvm::LLVMStructGetTypeAtIndex(
                                                 arr_rt, 0)
                                           | types::llvm_type_of_vt(elem_vt)
                                        elem_llvm = raw_elem == Addr(0)
                                           | llvm::LLVMInt64Type!
                                           | raw_elem
                                        elem_bytes = is_flag | 1 |
                                           elem_byte_size(elem_vt)
                                        total_bytes = elem_bytes * count
                                        l_op = lhs_arr | lr.0 |
                                           codegen_scalar_to_elem(cg, lr,
                                              elem_llvm, elem_vt)
                                        r_op = rhs_arr | rr.0 |
                                           codegen_scalar_to_elem(cg, rr,
                                              elem_llvm, elem_vt)
                                        meta = (count, total_bytes, elem_vt,
                                           elem_llvm, arr_rt, arr_fvts)
                                        total_bytes < 129
                                           | codegen_array_vector_cmp(cg, op,
                                              l_op, lhs_arr, r_op, rhs_arr,
                                              meta)
                                           | codegen_array_loop_cmp(cg, op,
                                              l_op, lhs_arr, r_op, rhs_arr,
                                              meta)

codegen_array_vector_logical: types::Cg, <>, Addr, <>, Addr, <>,
   Int => (Addr, ast::ValueType)
codegen_array_vector_logical = cg, is_and, lv, l_arr, rv, r_arr, n =>
   i1t = llvm::LLVMInt1Type!
   l_vec = l_arr
      | load_flag_vector(cg, lv, n)
      | codegen_build_splat(cg, lv, i1t, n)
   r_vec = r_arr
      | load_flag_vector(cg, rv, n)
      | codegen_build_splat(cg, rv, i1t, n)
   res_vec = is_and
      | llvm::LLVMBuildAnd(cg.builder, l_vec, r_vec, "arr.mask.and")
      | llvm::LLVMBuildOr(cg.builder, l_vec, r_vec, "arr.mask.or")
   res_rt = make_flag_record_type(cg, n)
   alloc_sz = llvm::LLVMSizeOf(res_rt)
   result_ptr = codegen_call_arena_alloc(cg, alloc_sz, "rec.mask.alloc")
   store_flag_vector(cg, result_ptr, res_vec, n)
   cg.last_rt = res_rt
   cg.last_fnames = ast::Names()
   cg.last_fvts = make_flag_fvts(n)
   (result_ptr, ast::ValueType(Record))

codegen_array_loop_logical: types::Cg, <>, Addr, <>, Addr, <>,
   Int => (Addr, ast::ValueType)
codegen_array_loop_logical = cg, is_and, lv, l_arr, rv, r_arr, n =>
   i64t = llvm::LLVMInt64Type!
   i1t = llvm::LLVMInt1Type!
   res_rt = make_flag_record_type(cg, n)
   alloc_sz = llvm::LLVMSizeOf(res_rt)
   result_ptr = codegen_call_arena_alloc(cg, alloc_sz, "rec.mask.alloc")
   cur = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   parent = cg.current_fn
   header_bb = llvm::LLVMAppendBasicBlock(parent, "arr.log.hdr." + cur)
   body_bb = llvm::LLVMAppendBasicBlock(parent, "arr.log.body." + cur)
   latch_bb = llvm::LLVMAppendBasicBlock(parent, "arr.log.latch." + cur)
   exit_bb = llvm::LLVMAppendBasicBlock(parent, "arr.log.exit." + cur)
   entry_bb = llvm::LLVMGetInsertBlock(cg.builder)
   stmt::branch_to(cg, header_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, header_bb)
   counter_phi = llvm::LLVMBuildPhi(cg.builder, i64t, "arr.log.i")
   zero = llvm::LLVMConstInt(i64t, 0, 0)
   one = llvm::LLVMConstInt(i64t, 1, 0)
   count_const = llvm::LLVMConstInt(i64t, n, 0)
   cond_val = llvm::LLVMBuildICmp(cg.builder, 40, counter_phi, count_const,
      "arr.log.cond")
   llvm::LLVMBuildCondBr(cg.builder, cond_val, body_bb, exit_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, body_bb)
   l_elem = l_arr
      |
         l_ptr = types::gep1(cg, i1t, lv, counter_phi, "arr.l.gep")
         llvm::LLVMBuildLoad2(cg.builder, i1t, l_ptr, "arr.l.elem")
      | lv
   r_elem = r_arr
      |
         r_ptr = types::gep1(cg, i1t, rv, counter_phi, "arr.r.gep")
         llvm::LLVMBuildLoad2(cg.builder, i1t, r_ptr, "arr.r.elem")
      | rv
   op_val = is_and
      | llvm::LLVMBuildAnd(cg.builder, l_elem, r_elem, "arr.mask.and")
      | llvm::LLVMBuildOr(cg.builder, l_elem, r_elem, "arr.mask.or")
   res_ptr = types::gep1(cg, i1t, result_ptr, counter_phi, "arr.res.gep")
   llvm::LLVMBuildStore(cg.builder, op_val, res_ptr)
   stmt::branch_to(cg, latch_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, latch_bb)
   next_c = llvm::LLVMBuildAdd(cg.builder, counter_phi, one, "arr.log.next")
   stmt::branch_to(cg, header_bb)
   stmt::llvm_add_incoming1(cg, counter_phi, zero, entry_bb)
   stmt::llvm_add_incoming1(cg, counter_phi, next_c, latch_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, exit_bb)
   cg.last_rt = res_rt
   cg.last_fnames = ast::Names()
   cg.last_fvts = make_flag_fvts(n)
   (result_ptr, ast::ValueType(Record))

codegen_emit_array_logical: types::Cg, <>,
   (Addr, ast::ValueType, Addr, ast::VTypes, <>),
   (Addr, ast::ValueType, Addr, ast::VTypes, <>) => (Addr, ast::ValueType)
codegen_emit_array_logical = cg, is_and, linfo, rinfo =>
   lr = (linfo.0, linfo.1)
   l_rt = linfo.2
   l_fvts = linfo.3
   lhs_arr = linfo.4
   rr = (rinfo.0, rinfo.1)
   r_rt = rinfo.2
   r_fvts = rinfo.3
   rhs_arr = rinfo.4
   arr_rt = lhs_arr | l_rt | r_rt
   arr_fvts = lhs_arr | l_fvts | r_fvts
   count = lhs_arr | ?l_fvts | ?r_fvts
   lhs_arr && rhs_arr && (?l_fvts != ?r_fvts)
      |
         types::init_error(cg, "E3160", "Element-wise array logical operation " +
            "requires equal element counts, got " +
            str::from_int(?l_fvts) + " and " +
            str::from_int(?r_fvts) + ".", 0, 0)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         scalar_vt = lhs_arr | rr.1 | lr.1
         bad_scalar = (!lhs_arr || !rhs_arr) && !types::is_flag_vt(scalar_vt)
         bad_scalar
            |
               types::init_error(cg, "E3162", "Element-wise Flag-array logical " +
                  "operation requires a Flag scalar, got " +
                  types::value_type_name(scalar_vt) + ".", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               i1t = llvm::LLVMInt1Type!
               l_op = lhs_arr | lr.0 | stmt::coerce_int(cg, lr.0, i1t)
               r_op = rhs_arr | rr.0 | stmt::coerce_int(cg, rr.0, i1t)
               count < 129
                  | codegen_array_vector_logical(cg, is_and, l_op, lhs_arr,
                     r_op, rhs_arr, count)
                  | codegen_array_loop_logical(cg, is_and, l_op, lhs_arr,
                     r_op, rhs_arr, count)

record_expr_all_flags: types::Cg, ast::Fields, Int => <>
record_expr_all_flags = cg, fields, i =>
   i == ?fields
      | <+>
      |
         f = fields(i)!!
         vt = types::static_expr_vt(cg, f.val)
         types::is_flag_vt(vt) && record_expr_all_flags(cg, fields, i + 1)

is_vector_cmp_op: ast::BinaryOp => <>
is_vector_cmp_op = op =>
   op [Gt, Lt, Eq, NotEq, NotGt, NotLt]

is_vector_logical_op: ast::BinaryOp => <>
is_vector_logical_op = op =>
   op [And, Or]

is_any_vector_expr: types::Cg, ast::Expr => <>
is_any_vector_expr = cg, e =>
   e
      [Var v] types::is_record_vt(types::var_type(cg, v))
      [Record r] ?r.fields > 0
      [Bin b] is_any_vector_expr(cg, b.1) || is_any_vector_expr(cg, b.2)
      | <->

is_flag_vector_var: types::Cg, String => <>
is_flag_vector_var = cg, name =>
   is_rec = types::is_record_vt(types::var_type(cg, name))
   fvts = match::var_fvts(cg, name)
   is_rec && (?fvts > 0) &&
      types::is_flag_vt((fvts(0) | _ | ast::ValueType(Unknown)))

is_flag_vector_expr: types::Cg, ast::Expr => <>
is_flag_vector_expr = cg, e =>
   e
      [Var v] is_flag_vector_var(cg, v)
      [Record r] ?r.fields > 0 && record_expr_all_flags(cg, r.fields, 0)
      [Bin b]
         is_vector_cmp_op(b.0) &&
            (is_any_vector_expr(cg, b.1) || is_any_vector_expr(cg, b.2)) ||
            (is_vector_logical_op(b.0) &&
               (is_flag_vector_expr(cg, b.1) || is_flag_vector_expr(cg, b.2)))
      | <->

codegen_emit_unassignable_binop_error: types::Cg => (Addr, ast::ValueType)
codegen_emit_unassignable_binop_error = cg =>
   msg = "Cannot perform binary operator on unassignable choice expression."
   types::init_error(cg, "E3022", msg, 0, 0)
   (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_emit_arith: types::Cg, ast::BinaryOp,
   (ast::BinaryOp, ast::Expr, ast::Expr) => (Addr, ast::ValueType)
codegen_emit_arith = cg, op, t =>
   lr = codegen_eval(cg, t.1)
   l_rt = cg.last_rt
   l_fvts = cg.last_fvts
   rr = codegen_eval(cg, t.2)
   r_rt = cg.last_rt
   r_fvts = cg.last_fvts
   l_un = lr.1 [Unit]
   r_un = rr.1 [Unit]
   is_bad = l_un || r_un
   is_bad
      | codegen_emit_unassignable_binop_error(cg)
      | codegen_emit_arith_operands(cg, op, lr, l_rt, l_fvts, rr, r_rt, r_fvts)

codegen_emit_arith_operands: types::Cg, ast::BinaryOp, (Addr, ast::ValueType),
   Addr, ast::VTypes, (Addr, ast::ValueType), Addr, ast::VTypes => (Addr, ast::ValueType)
codegen_emit_arith_operands = cg, op, lr, l_rt, l_fvts, rr, r_rt, r_fvts =>
   lhs_arr = is_numeric_fixed_record(lr, l_rt, l_fvts)
   rhs_arr = is_numeric_fixed_record(rr, r_rt, r_fvts)
   lhs_arr || rhs_arr
      | codegen_emit_array_arith(cg, op,
         (lr.0, lr.1, l_rt, l_fvts, lhs_arr),
         (rr.0, rr.1, r_rt, r_fvts, rhs_arr))
      |
         is_bit = op [BitAnd, BitOr, Shl, Shr]
         is_bit
            |
               ok_l = types::is_int_vt(lr.1) || types::is_flag_vt(lr.1)
               ok_r = types::is_int_vt(rr.1) || types::is_flag_vt(rr.1)
               !ok_l || !ok_r
                  | codegen_emit_bitwise_error(cg)
                  |
                     i64t = llvm::LLVMInt64Type!
                     lv = stmt::coerce_int(cg, lr.0, i64t)
                     rv = stmt::coerce_int(cg, rr.0, i64t)
                     codegen_emit_bitwise_valid(cg, op, lv, rv)
            |
               requires_int = op [Mul, Div, Mod]
               any_float = types::is_float_vt(lr.1) || types::is_float_vt(rr.1)
               bad_int = !types::is_int_vt(lr.1) || !types::is_int_vt(rr.1)
               bad_int_op = requires_int && !any_float && bad_int
               bad_int_op
                  | codegen_emit_integer_arith_error(cg)
                  | codegen_emit_arith_valid(cg, op, lr, rr)

codegen_emit_integer_arith_error: types::Cg => (Addr, ast::ValueType)
codegen_emit_integer_arith_error = cg =>
   types::init_error(cg, "E3087", "Operator requires integer operands.", 0, 0)
   (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_emit_arith_valid: types::Cg, ast::BinaryOp, (Addr, ast::ValueType),
   (Addr, ast::ValueType) => (Addr, ast::ValueType)
codegen_emit_arith_valid = cg, op, lr, rr =>
   lr.0 == Addr(0) || rr.0 == Addr(0)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         op
            [Add]
               types::is_str_vt(lr.1)
                  |
                     types::is_str_vt(rr.1)
                        | (stmt::codegen_string_concat(cg, lr.0, rr.0),
                           ast::ValueType(Str))
                        |
                           types::is_rune_vt(rr.1)
                              | (stmt::codegen_string_append_rune(cg, lr.0, rr.0),
                                 ast::ValueType(Str))
                              | (stmt::codegen_string_append_byte(cg, lr.0, rr.0),
                                 ast::ValueType(Str))
                  |
                     types::is_builder_vt(lr.1)
                        | main::codegen_builder_pure_append(cg, lr.0, rr.0, rr.1)
                        | codegen_emit_arith_fallback(cg, op, lr, rr)
            | codegen_emit_arith_fallback(cg, op, lr, rr)

codegen_emit_arith_fallback: types::Cg, ast::BinaryOp, (Addr, ast::ValueType),
   (Addr, ast::ValueType) => (Addr, ast::ValueType)
codegen_emit_arith_fallback = cg, op, lr, rr =>
   both_str = types::is_str_vt(lr.1) && types::is_str_vt(rr.1)
   both_str
      | (stmt::codegen_string_concat(cg, lr.0, rr.0), ast::ValueType(Str))
      |
         is_float = types::is_float_vt(lr.1) || types::is_float_vt(rr.1)
         is_float
            | (codegen_eval_float_arith(cg, op,
               coerce_float(cg, lr.0, lr.1),
               coerce_float(cg, rr.0, rr.1)),
               ast::ValueType(Float))
            |
               l_is_ptr = types::is_ptr_vt(lr.1) ||
                  llvm::LLVMGetTypeKind(
                     llvm::LLVMTypeOf(lr.0)) == 12
               r_is_ptr = types::is_ptr_vt(rr.1) ||
                  llvm::LLVMGetTypeKind(
                     llvm::LLVMTypeOf(rr.0)) == 12
               l_is_ptr || r_is_ptr
                  | codegen_eval_ptr_arith(cg, op, lr.0, rr.0,
                     l_is_ptr, r_is_ptr)
                  |
                     i64t = llvm::LLVMInt64Type!
                     u_l = types::is_unsigned_vt(lr.1)
                     u_r = types::is_unsigned_vt(rr.1)
                     lv = stmt::coerce_int_ext(cg, lr.0, i64t, u_l)
                     rv = stmt::coerce_int_ext(cg, rr.0, i64t, u_r)
                     is_u = u_l || u_r
                     (codegen_eval_int_arith(cg, op, lv, rv,
                        is_u), ast::ValueType(Int))

codegen_eval_ptr_arith: types::Cg, ast::BinaryOp, Addr, Addr, <>,
   <> => (Addr, ast::ValueType)
codegen_eval_ptr_arith = cg, op, l, r, l_is_ptr, r_is_ptr =>
   i64t = llvm::LLVMInt64Type!
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   l_val = l_is_ptr
      | llvm::LLVMBuildPtrToInt(cg.builder, l, i64t, "ptr.int.l")
      | stmt::coerce_int(cg, l, i64t)
   r_val = r_is_ptr
      | llvm::LLVMBuildPtrToInt(cg.builder, r, i64t, "ptr.int.r")
      | stmt::coerce_int(cg, r, i64t)
   op
      [Add]
         sum = llvm::LLVMBuildAdd(cg.builder, l_val, r_val, "addtmp")
         res_ptr' = llvm::LLVMBuildIntToPtr(cg.builder, sum, i8p, "ptr.res")
         (res_ptr', ast::ValueType(RawPtr))
      [Sub]
         !l_is_ptr
            | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               diff = llvm::LLVMBuildSub(cg.builder, l_val, r_val, "subtmp")
               r_is_ptr
                  | (diff, ast::ValueType(Int))
                  |
                     res_ptr' = llvm::LLVMBuildIntToPtr(cg.builder, diff, i8p,
                        "ptr.res")
                     (res_ptr', ast::ValueType(RawPtr))
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_eval_float_arith: types::Cg, ast::BinaryOp, Addr, Addr => Addr
codegen_eval_float_arith = cg, op, l, r =>
   op
      [Add] llvm::LLVMBuildFAdd(cg.builder, l, r, "faddtmp")
      [Sub] llvm::LLVMBuildFSub(cg.builder, l, r, "fsubtmp")
      [Mul] llvm::LLVMBuildFMul(cg.builder, l, r, "fmultmp")
      [Div] llvm::LLVMBuildFDiv(cg.builder, l, r, "fdivtmp")
      [Mod] llvm::LLVMBuildFRem(cg.builder, l, r, "fremtmp")
      | llvm::LLVMConstReal(llvm::LLVMDoubleType!, 0.0)

codegen_emit_div_guard: types::Cg, Addr, Addr, <> => ()
codegen_emit_div_guard = cg, l_val, r_val, is_signed =>
   i64t = llvm::LLVMInt64Type!
   zero = llvm::LLVMConstInt(i64t, 0, 0)
   is_zero = llvm::LLVMBuildICmp(cg.builder, 32, r_val, zero, "div.is.zero")
   cur_bb = llvm::LLVMGetInsertBlock(cg.builder)
   parent = llvm::LLVMGetBasicBlockParent(cur_bb)
   not_zero_bb = llvm::LLVMAppendBasicBlock(parent, "div.not_zero")
   zero_abort_bb = llvm::LLVMAppendBasicBlock(parent, "div.zero_abort")
   llvm::LLVMBuildCondBr(cg.builder, is_zero, zero_abort_bb, not_zero_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, zero_abort_bb)
   runtime::emit_abort_msg(cg, "E4012: integer division by zero\n", "div_zero_msg")
   llvm::LLVMBuildBr(cg.builder, not_zero_bb)
   is_signed
      |
         llvm::LLVMPositionBuilderAtEnd(cg.builder, not_zero_bb)
         int_min = llvm::LLVMConstInt(i64t, -9223372036854775807 - 1, 0)
         minus_one = llvm::LLVMConstInt(i64t, -1, 1)
         is_min = llvm::LLVMBuildICmp(cg.builder, 32, l_val, int_min,
            "div.is.min")
         is_neg_one = llvm::LLVMBuildICmp(cg.builder, 32, r_val, minus_one,
            "div.is.negone")
         is_ovf = llvm::LLVMBuildAnd(cg.builder, is_min, is_neg_one,
            "div.is.ovf")
         ok_bb = llvm::LLVMAppendBasicBlock(parent, "div.ok")
         ovf_abort_bb = llvm::LLVMAppendBasicBlock(parent, "div.ovf_abort")
         llvm::LLVMBuildCondBr(cg.builder, is_ovf, ovf_abort_bb, ok_bb)
         llvm::LLVMPositionBuilderAtEnd(cg.builder, ovf_abort_bb)
         runtime::emit_abort_msg(cg,
            "E4013: signed integer division overflow (INT_MIN / -1)\n",
            "div_ovf_msg")
         llvm::LLVMBuildBr(cg.builder, ok_bb)
         llvm::LLVMPositionBuilderAtEnd(cg.builder, ok_bb)
      |
         llvm::LLVMPositionBuilderAtEnd(cg.builder, not_zero_bb)

codegen_eval_int_arith: types::Cg, ast::BinaryOp, Addr, Addr, <> => Addr
codegen_eval_int_arith = cg, op, l, r, is_u =>
   is_div = op [Div, Mod]
   is_div | codegen_emit_div_guard(cg, l, r, !is_u) | 0
   op
      [Add] llvm::LLVMBuildAdd(cg.builder, l, r, "addtmp")
      [Sub] llvm::LLVMBuildSub(cg.builder, l, r, "subtmp")
      [Mul] llvm::LLVMBuildMul(cg.builder, l, r, "multmp")
      [Div]
         is_u
            | llvm::LLVMBuildUDiv(cg.builder, l, r, "divtmp")
            | llvm::LLVMBuildSDiv(cg.builder, l, r, "divtmp")
      [Mod]
         is_u
            | llvm::LLVMBuildURem(cg.builder, l, r, "modtmp")
            | llvm::LLVMBuildSRem(cg.builder, l, r, "modtmp")
      | llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0)

// --- comparisons -------------------------------------------------------------

codegen_emit_bitwise: types::Cg, ast::BinaryOp,
   (ast::BinaryOp, ast::Expr, ast::Expr) => (Addr, ast::ValueType)
codegen_emit_bitwise = cg, op, t =>
   lr = codegen_eval(cg, t.1)
   rr = codegen_eval(cg, t.2)
   ok_l = types::is_int_vt(lr.1) || types::is_flag_vt(lr.1)
   ok_r = types::is_int_vt(rr.1) || types::is_flag_vt(rr.1)
   !ok_l || !ok_r
      | codegen_emit_bitwise_error(cg)
      |
         i64t = llvm::LLVMInt64Type!
         lv = stmt::coerce_int_ext(cg, lr.0, i64t, types::is_unsigned_vt(lr.1))
         rv = stmt::coerce_int_ext(cg, rr.0, i64t, types::is_unsigned_vt(rr.1))
         codegen_emit_bitwise_valid(cg, op, lv, rv)

codegen_emit_bitwise_error: types::Cg => (Addr, ast::ValueType)
codegen_emit_bitwise_error = cg =>
   types::init_error(cg, "E3057", "Bitwise operator requires integer operands.", 0, 0)
   (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_emit_bitwise_valid: types::Cg, ast::BinaryOp, Addr, Addr => (Addr, ast::ValueType)
codegen_emit_bitwise_valid = cg, op, lv, rv =>
   op
      [BitAnd] (llvm::LLVMBuildAnd(cg.builder, lv, rv, "bandtmp"), ast::ValueType(Int))
      [BitOr] (llvm::LLVMBuildOr(cg.builder, lv, rv, "bortmp"), ast::ValueType(Int))
      [Shl] (llvm::LLVMBuildShl(cg.builder, lv, rv, "shltmp"), ast::ValueType(Int))
      [Shr] (llvm::LLVMBuildLShr(cg.builder, lv, rv, "shrtmp"), ast::ValueType(Int))
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

// --- logical && / || (flag case) ----------------------------------------------

// Short-circuit: && stops on a false lhs (result = lhs), evaluates rhs in the
// then block; || stops on a true lhs (result = lhs), evaluates rhs in the
// else block. A phi at the exit merges the two candidates.
codegen_eval_unary_len: types::Cg, Addr, ast::ValueType => (Addr, ast::ValueType)
codegen_eval_unary_len = cg, val, vt =>
   vt
      [Str] (codegen_string_len(cg, val, "str.len.query"), ast::ValueType(Int))
      [Builder] (main::builder_len(cg, val, "b.len"), ast::ValueType(Int))
      [Map] (llvm::LLVMBuildLoad2(cg.builder, llvm::LLVMInt64Type!,
         llvm::LLVMBuildStructGEP2(cg.builder, runtime::map_struct_type(cg), val, 0,
            "m.count.query"), "m.count.query"), ast::ValueType(Int))
      [Array] (main::builder_len(cg, val, "a.len.query"), ast::ValueType(Int))
      [Slice] (main::slice_len(cg, val, "slice.len"), ast::ValueType(Int))
      [Record]
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, ?cg.last_fvts, 0),
            ast::ValueType(Int))
      [Rune]
         r_val = stmt::coerce_int(cg, val, llvm::LLVMInt64Type!)
         c1 = llvm::LLVMBuildICmp(cg.builder, 40, r_val,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0x80, 0), "r.cmp1")
         c2 = llvm::LLVMBuildICmp(cg.builder, 40, r_val,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0x800, 0), "r.cmp2")
         c3 = llvm::LLVMBuildICmp(cg.builder, 40, r_val,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0x10000, 0), "r.cmp3")
         w3 = llvm::LLVMBuildSelect(cg.builder, c3,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 3, 0),
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 4, 0), "r.w3")
         w2 = llvm::LLVMBuildSelect(cg.builder, c2,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 2, 0), w3, "r.w2")
         w1 = llvm::LLVMBuildSelect(cg.builder, c1,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, 1, 0), w2, "r.width")
         (w1, ast::ValueType(Int))
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

ti_rec_or_enum_len: ast::TypeInfo => Int
ti_rec_or_enum_len = ti =>
   ti
      [Rec r] ?r.0
      [Enum s] ?s
      | -1

codegen_eval_unary: types::Cg, (ast::UnaryOp, ast::Expr) => (Addr, ast::ValueType)
codegen_eval_unary = cg, t =>
   saved_discard = cg.discard_result
   cg.discard_result = <->
   ev = codegen_eval(cg, t.1)
   cg.discard_result = saved_discard
   t.0
      [Not]
         ev.1
            [Flag]
               (llvm::LLVMBuildNot(cg.builder, ev.0, "nottmp"),
                  ast::ValueType(Flag))
            [Ram, Enum]
               types::init_error(cg, "E3008", "Logical NOT (!) operator can only be " +
                  "applied to boolean flags (<>), not other ramifications.",
                  0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            | codegen_not_invalid(cg, ev.1)
      [BitNot]
         types::is_int_vt(ev.1)
            | (llvm::LLVMBuildNot(cg.builder, ev.0, "bitnottmp"), ast::ValueType(Int))
            |
               types::init_error(cg, "E3058", "Bitwise NOT requires an integer operand.", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      [Length]
         t.1
            [Var v]
               ct = types::ct_bind_find(v)
               ct.1
                  |
                     count' = ti_rec_or_enum_len(ct.0)
                     count' !< 0
                        | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, count', 0),
                           ast::ValueType(Int))
                        | codegen_eval_unary_len(cg, ev.0, ev.1)
                  |
                     types::is_user_type(cg, v)
                        |
                           ti = types::typedef_ti(cg, v)
                           count' = ti_rec_or_enum_len(ti)
                           count' !< 0
                              | (llvm::LLVMConstInt(llvm::LLVMInt64Type!,
                                 count', 0), ast::ValueType(Int))
                              | codegen_eval_unary_len(cg, ev.0, ev.1)
                        |
                           is_rec = types::var_type(cg, v) [Record]
                           is_rec
                              |
                                 fvs = match::var_fvts(cg, v)
                                 (llvm::LLVMConstInt(llvm::LLVMInt64Type!,
                                    ?fvs, 0), ast::ValueType(Int))
                              | codegen_eval_unary_len(cg, ev.0, ev.1)
            | codegen_eval_unary_len(cg, ev.0, ev.1)
      [Freeze]
         (main::codegen_builder_freeze(cg, ev.0, "builder.freeze"),
            ast::ValueType(Str))
      [AddrOf]
         ptr_raw = ev.1
            [Builder] main::builder_data(cg, ev.0, "b.ptr")
            [Str] codegen_string_data(cg, ev.0, "s.ptr")
            | Addr(0)
         ptr_raw == Addr(0)
            | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            | (tag_addr_with_arena_gen(cg, ptr_raw), ast::ValueType(RawPtr))
      [Unwrap] codegen_eval_unary_unwrap(cg, ev.0, ev.1, t.1)
      [Propagate] codegen_eval_unary_propagate(cg, ev.0, ev.1, t.1)
      [RuneCount] stmt::codegen_eval_string_rune_count(cg, ev.0)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

unwrap_pay_value: types::Cg, Addr, ast::ValueType => Addr
unwrap_pay_value = cg, pay_ptr, pay_type =>
   types::is_int_vt(pay_type)
      | llvm::LLVMBuildLoad2(cg.builder, llvm::LLVMInt64Type!, pay_ptr,
         "unwrap.int")
      |
         types::is_float_vt(pay_type)
            | llvm::LLVMBuildLoad2(cg.builder, llvm::LLVMDoubleType!, pay_ptr,
               "unwrap.float")
            |
               match::is_flag_pay_vt(cg, pay_type)
                  | match::load_flag_pay(cg, pay_ptr)
                  | pay_ptr

codegen_eval_unary_unwrap: types::Cg, Addr, ast::ValueType,
   ast::Expr => (Addr, ast::ValueType)
codegen_eval_unary_unwrap = cg, val, vt, target =>
   i1t = llvm::LLVMInt1Type!
   is_heap = val != Addr(0) && llvm::LLVMTypeOf(val) != i1t &&
      llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(val)) == 12
   vt != ast::ValueType(Ram) || !is_heap
      |
         types::init_error(cg, "E3091", "Operand of '!!' must be a RamPP or " +
            "RamPN ramification, got " +
            (vt [Flag] "Flag" | types::value_type_name(vt)), 0, 0)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         dtype0 = target [Var v] types::var_dtype(cg, v) | ""
         dtype = dtype0 != "" | dtype0 | cg.last_type
         ti = types::typedef_ti(cg, dtype)
         pos_slot = ti [Ram s] s.0 | ast::RamSlotInfo((<->,
            ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown))))
         neg_slot = ti [Ram s] s.1 | ast::RamSlotInfo((<->,
            ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown))))
         is_scalar_ram = dtype == "Int" || dtype == "Float" ||
            dtype == "String" || dtype == "Str"
         pos_has_payload = pos_slot.has_payload || is_scalar_ram
         !pos_has_payload
            |
               types::init_error(cg, "E3091", "Operand of '!!' must be a RamPP or " +
                  "RamPN ramification (a positive payload slot is required)",
                  0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               pos_vt0 = pos_slot.payload_type
               pos_rec = pos_slot.payload_record
               pos_vt = pos_vt0 == ast::ValueType(Unknown)
                  |
                     dtype == "Int"
                        | ast::ValueType(Int)
                        |
                           dtype == "Float"
                              | ast::ValueType(Float)
                              | ast::ValueType(Str)
                  | pos_vt0
               t0 = types::g.tmpc
               types::g.tmpc = types::g.tmpc + 1
               pos_bb = llvm::LLVMAppendBasicBlock(cg.current_fn,
                  "unwrap.pos." + str::from_int(t0))
               abort_bb = llvm::LLVMAppendBasicBlock(cg.current_fn,
                  "unwrap.abort." + str::from_int(t0))
               tag_gep = llvm::LLVMBuildStructGEP2(cg.builder, cg.union_t,
                  val, 0, "unwrap.tag.gep")
               tag = llvm::LLVMBuildLoad2(cg.builder,
                  llvm::LLVMInt64Type!, tag_gep, "unwrap.tag")
               one = llvm::LLVMConstInt(llvm::LLVMInt64Type!, 1, 0)
               is_pos = llvm::LLVMBuildICmp(cg.builder, 32, tag, one,
                  "unwrap.is_pos")
               llvm::LLVMBuildCondBr(cg.builder, is_pos, pos_bb, abort_bb)

               llvm::LLVMPositionBuilderAtEnd(cg.builder, abort_bb)
               neg_is_err = neg_slot.has_payload &&
                  neg_slot.payload_type == ast::ValueType(Error)
               neg_is_err
                  |
                     pay_ptr = match::union_pay_ptr(cg, val)
                     main::codegen_emit_error_panic(cg, pay_ptr)
                  |
                     runtime::emit_abort_msg(cg,
                        "E4007: unwrap on empty or error ramification\n",
                        "unwrap_abort_msg")
                     llvm::LLVMBuildUnreachable(cg.builder)

               llvm::LLVMPositionBuilderAtEnd(cg.builder, pos_bb)
               pay_val = match::union_pay_ptr(cg, val)
               res_val = unwrap_pay_value(cg, pay_val, pos_vt)
               pos_is_rec = pos_vt [Record]
               pos_is_rec
                  |
                     pos_rm = runtime::record_meta_from_ti(cg, pos_rec)
                     pos_rm.0 != Addr(0)
                        |
                           cg.last_rt = pos_rm.0
                           cg.last_fnames = pos_rm.1
                           cg.last_fvts = types::field_vts(cg, pos_rec)
                           pdt = pos_rec [TypeVar n] n | ""
                           cg.last_type = pdt
                        | 0
                  |
                     pos_is_fn = pos_vt [Fn]
                     pos_is_fn
                        |
                           sname = types::fn_ret_sig_with_ti(cg, pos_rec)
                           sname != "" | cg.last_closure_fn = sname | 0
                           p_ret_vt = types::ti_fn_ret_vt(cg, pos_rec)
                           p_ret_vt != ast::ValueType(Unknown)
                              | cg.last_type = types::value_type_name(p_ret_vt)
                              | 0
                        |
                           pdt2 = pos_rec [TypeVar n] n | ""
                           pdt2 != "" | cg.last_type = pdt2 | 0
               (res_val, pos_vt)

codegen_eval_unary_propagate: types::Cg, Addr, ast::ValueType,
   ast::Expr => (Addr, ast::ValueType)
codegen_eval_unary_propagate = cg, val, vt, target =>
   !cg.in_fn
      |
         types::init_error(cg, "E3173", "Propagate operator '--!' can only be used " +
            "inside a function.", 0, 0)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         ret_ti_res = stmt::resolve_ti(cg, types::g.expected_fn_ti)
         ret_is_ram = ret_ti_res [Ram _]
         !ret_is_ram
            |
               types::init_error(cg, "E3173", "Propagate operator '--!' is only " +
                  "valid inside a function returning a ramification, got " +
                  ram_shape_str(cg, ret_ti_res) + ".", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               i1t = llvm::LLVMInt1Type!
               is_heap = val != Addr(0) && llvm::LLVMTypeOf(val) != i1t &&
                  llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(val)) == 12
               vt != ast::ValueType(Ram) || !is_heap
                  |
                     types::init_error(cg, "E3091", "Operand of '--!' must be a " +
                        "RamPP or RamPN ramification, got " +
                        (vt [Flag] "Flag" | types::value_type_name(vt)), 0, 0)
                     (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
                  |
                     op_ti0 = codegen_ram_type_of_expr(cg, target)
                     dtype0 = target [Var v] types::var_dtype(cg, v) | ""
                     dtype = dtype0 != "" | dtype0 | cg.last_type
                     is_ram_ti = op_ti0 [Ram _]
                     ti = is_ram_ti
                        | op_ti0
                        |
                           dtype != ""
                              | types::typedef_ti(cg, dtype)
                              | op_ti0
                     pos_slot = ti [Ram s] s.0 | ast::RamSlotInfo((<->,
                        ast::ValueType(Unknown),
                        ast::TypeInfo(Prim, ast::ValueType(Unknown))))
                     neg_slot = ti [Ram s] s.1 | ast::RamSlotInfo((<->,
                        ast::ValueType(Unknown),
                        ast::TypeInfo(Prim, ast::ValueType(Unknown))))
                     is_scalar_ram = dtype == "Int" || dtype == "Float" ||
                        dtype == "String" || dtype == "Str"
                     pos_has_payload = pos_slot.has_payload || is_scalar_ram
                     !pos_has_payload
                        |
                           types::init_error(cg, "E3091", "Operand of '--!' must be " +
                              "a RamPP or RamPN ramification (a positive " +
                              "payload slot is required)", 0, 0)
                           (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                              ast::ValueType(Unknown))
                        |
                           fn_neg = ret_ti_res [Ram s] s.1 | neg_slot
                           compat = ram_slot_compatible(cg, neg_slot, fn_neg)
                           !compat
                              |
                                 types::init_error(cg, "E3149", "Cannot propagate " +
                                    "ramification of shape " +
                                    ram_shape_str(cg, ti) +
                                    " into function returning " +
                                    ram_shape_str(cg, ret_ti_res) + ".", 0, 0)
                                 (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                                    ast::ValueType(Unknown))
                              |
                                 pos_vt0 = pos_slot.payload_type
                                 pos_rec = pos_slot.payload_record
                                 pos_vt = pos_vt0 == ast::ValueType(Unknown)
                                    |
                                       dtype == "Int"
                                          | ast::ValueType(Int)
                                          |
                                             dtype == "Float"
                                                | ast::ValueType(Float)
                                                | ast::ValueType(Str)
                                    | pos_vt0
                                 t0 = types::g.tmpc
                                 types::g.tmpc = types::g.tmpc + 1
                                 s_t0 = str::from_int(t0)
                                 pos_bb = llvm::LLVMAppendBasicBlock(
                                    cg.current_fn, "prop.pos." + s_t0)
                                 ret_bb = llvm::LLVMAppendBasicBlock(
                                    cg.current_fn, "prop.ret." + s_t0)
                                 tag_gep = llvm::LLVMBuildStructGEP2(
                                    cg.builder, cg.union_t, val, 0,
                                    "prop.tag.gep")
                                 tag = llvm::LLVMBuildLoad2(cg.builder,
                                    llvm::LLVMInt64Type!, tag_gep, "prop.tag")
                                 one = llvm::LLVMConstInt(
                                    llvm::LLVMInt64Type!, 1, 0)
                                 is_pos = llvm::LLVMBuildICmp(cg.builder,
                                    32, tag, one, "prop.is_pos")
                                 llvm::LLVMBuildCondBr(cg.builder, is_pos,
                                    pos_bb, ret_bb)

                                 llvm::LLVMPositionBuilderAtEnd(cg.builder,
                                    ret_bb)
                                 llvm::LLVMBuildRet(cg.builder, val)

                                 llvm::LLVMPositionBuilderAtEnd(cg.builder,
                                    pos_bb)
                                 pay_val = match::union_pay_ptr(cg, val)
                                 res_val = unwrap_pay_value(cg, pay_val,
                                    pos_vt)
                                 pos_is_rec = pos_vt [Record]
                                 pos_is_rec
                                    |
                                       pos_rm = runtime::record_meta_from_ti(cg, pos_rec)
                                       pos_rm.0 != Addr(0)
                                          |
                                             cg.last_rt = pos_rm.0
                                             cg.last_fnames = pos_rm.1
                                             cg.last_fvts = types::field_vts(cg,
                                                pos_rec)
                                             pdt = pos_rec [TypeVar n] n | ""
                                             cg.last_type = pdt
                                          | 0
                                    |
                                       pos_is_fn = pos_vt [Fn]
                                       pos_is_fn
                                          |
                                             sname = types::fn_ret_sig_with_ti(cg,
                                                pos_rec)
                                             sname != ""
                                                | cg.last_closure_fn = sname
                                                | 0
                                             p_ret_vt = types::ti_fn_ret_vt(cg,
                                                pos_rec)
                                             p_ret_vt != ast::ValueType(Unknown)
                                                |
                                                   cg.last_type =
                                                      types::value_type_name(p_ret_vt)
                                                | 0
                                          |
                                             pdt2 = pos_rec [TypeVar n] n | ""
                                             pdt2 != "" | cg.last_type = pdt2 | 0
                                 (res_val, pos_vt)

codegen_not_invalid: types::Cg, ast::ValueType => (Addr, ast::ValueType)
codegen_not_invalid = cg, vt =>
   types::is_int_vt(vt)
      |
         types::init_error(cg, "E3008", "Unary '!' cannot be applied to an integer. " +
            "To create a Builder with capacity n, use the brace literal '{n}'.", 0, 0)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         types::init_error(cg, "E3008", "Unary '!' cannot be applied to this type. " +
            "Use Flag for logical NOT or '+' for Builder freeze.", 0, 0)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_eval_cast: types::Cg, ast::CastExpr => (Addr, ast::ValueType)
codegen_eval_cast = cg, t => codegen_eval_coerce(cg, t.0, t.1)

coerce_val: types::Cg, Addr, ast::ValueType, ast::ValueType => (Addr, ast::ValueType)
coerce_val = cg, v, v_vt, target =>
   target
      [Flag]
         (stmt::codegen_cond_value(cg, v, v_vt), ast::ValueType(Flag))
      [Float]
         types::is_int_vt(v_vt)
            |
               (llvm::LLVMBuildSIToFP(cg.builder, v, llvm::LLVMDoubleType!,
                  "cast.sitofp"), ast::ValueType(Float))
            |
               is_f32 = v_vt [F32]
               is_f32
                  |
                     (llvm::LLVMBuildFPExt(cg.builder, v,
                        llvm::LLVMDoubleType!, "cast.fpext"),
                        ast::ValueType(Float))
                  | (v, ast::ValueType(Float))
      [F32]
         types::is_int_vt(v_vt)
            |
               (llvm::LLVMBuildSIToFP(cg.builder, v, llvm::LLVMFloatType!,
                  "cast.sitofp"), ast::ValueType(F32))
            |
               is_f64 = v_vt [Float]
               is_f64
                  |
                     (llvm::LLVMBuildFPTrunc(cg.builder, v,
                        llvm::LLVMFloatType!, "cast.fptrunc"),
                        ast::ValueType(F32))
                  | (v, ast::ValueType(F32))
      [Int]
         types::is_float_vt(v_vt)
            |
               (llvm::LLVMBuildFPToSI(cg.builder, v, llvm::LLVMInt64Type!,
                  "cast.fptosi"), ast::ValueType(Int))
            | (stmt::coerce_int(cg, v, llvm::LLVMInt64Type!), ast::ValueType(Int))
      [RawPtr]
         types::is_int_vt(v_vt)
            |
               (llvm::LLVMBuildIntToPtr(cg.builder, v,
                  llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0),
                  "cast.int2ptr"), ast::ValueType(RawPtr))
            | (v, ast::ValueType(RawPtr))
      [Str]
         types::is_str_vt(v_vt)
            | (v, ast::ValueType(Str))
            |
               types::init_error(cg, "E3065",
                  "Cannot construct a String from a RawPtr — " +
                  "'String(ptr)' is rejected. Build with literals, '+', " +
                  "'++', 's + n', or a Builder.", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         types::is_int_vt(target)
            |
               t_ll = types::llvm_type_of_vt(target)
               (stmt::coerce_int(cg, v, t_ll), target)
            | (v, target)

// Coerces an argument expression to a target ValueType ("Float(x)", "Int(x)"
// and the other recognized type-name calls, which parse as calls).
codegen_eval_coerce: types::Cg, ast::ValueType, ast::Expr => (Addr, ast::ValueType)
codegen_eval_coerce = cg, target, arg =>
   ev = codegen_eval(cg, arg)
   coerce_val(cg, ev.0, ev.1, target)

// Coerce a choice branch value into the phi type/target ValueType.
coerce_phi_incoming: types::Cg, Addr, ast::ValueType, Addr, ast::ValueType => Addr
coerce_phi_incoming = cg, val_raw, val_vt, phi_ty, target_vt =>
   (llvm::LLVMTypeOf(val_raw) == phi_ty)
      | val_raw
      |
         coerced = coerce_val(cg, val_raw, val_vt, target_vt)
         (llvm::LLVMTypeOf(coerced.0) == phi_ty)
            | coerced.0
            |
               v_ty = llvm::LLVMTypeOf(coerced.0)
               v_kind = llvm::LLVMGetTypeKind(v_ty)
               phi_kind = llvm::LLVMGetTypeKind(phi_ty)
               (phi_kind == 12 && v_kind == 8)
                  | llvm::LLVMBuildIntToPtr(cg.builder, coerced.0, phi_ty,
                     "phi.inttoptr")
                  |
                     (phi_kind == 8 && v_kind == 12)
                        | llvm::LLVMBuildPtrToInt(cg.builder, coerced.0,
                           phi_ty, "phi.ptrtoint")
                        |
                           (phi_kind == 10 && v_kind == 12)
                              | llvm::LLVMBuildLoad2(cg.builder, phi_ty,
                                 coerced.0, "phi.load.struct")
                              | stmt::coerce_int_ext(cg, coerced.0, phi_ty,
                                 types::is_unsigned_vt(coerced.1))

// A recognized type name (the value-producing half of parse_dva_type_name).
e_str_lit: ast::Expr => <>
e_str_lit = e => e [Str _]

e_flt_lit: ast::Expr => <>
e_flt_lit = e => e [Float _]

// A named call "f(a, b)" to a compiled user function.
codegen_eval_fn_call: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_fn_call = cg, t =>
   foreign_bad = known_foreign_call_mismatch(cg, t, 0)
   foreign_bad !< 0
      | codegen_known_foreign_arg_error(cg, t, foreign_bad)
      | codegen_eval_fn_call_no_foreign(cg, t)

codegen_eval_fn_call_no_foreign: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_fn_call_no_foreign = cg, t =>
   pty = stmt::param_clo_ty(cg, t.fn_name)
   pty != Addr(0)
      | codegen_eval_param_call(cg, t, pty)
      |
         cfn = closure_fn_of(cg, t.fn_name)
         cfn == "<mixed>"
            | codegen_indirect_fn_return_unknown(cg, t)
            |
               cfn == ""
                  | codegen_eval_unaliased_call(cg, t)
                  | codegen_eval_closure_call(cg, t, cfn)

// Foreign functions remain externally erased at runtime, but the few ABI
// declarations the selfhost can lower carry static parameter facts. Keep the
// raw buffer pointer contract explicit; String is never a RawPtr substitute.
known_foreign_call_mismatch: types::Cg, ast::CallExpr, Int => Int
known_foreign_call_mismatch = cg, call, at =>
   at == ?call.args
      | -1
      |
         expected = known_foreign_param_type(call.fn_name, at)
         actual = types::static_expr_vt(cg, call.args(at)!!)
         expected.1 && actual != ast::ValueType(Unknown) && actual != expected.0
            | at
            | known_foreign_call_mismatch(cg, call, at + 1)

known_foreign_param_type: String, Int => (ast::ValueType, <>)
known_foreign_param_type = name, at =>
   name == "libc::recv" && at == 1
      | (ast::ValueType(RawPtr), <+>)
      | (ast::ValueType(Unknown), <->)

codegen_known_foreign_arg_error: types::Cg, ast::CallExpr, Int => (Addr, ast::ValueType)
codegen_known_foreign_arg_error = cg, call, at =>
   types::init_error(cg, "E3038", "Type mismatch for argument " +
      str::from_int(at + 1) + " of function '" + call.fn_name +
      "': Expected RawPtr, got " + types::value_type_name(types::static_expr_vt(cg,
         call.args(at)!!)), call.line, call.col)
   (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_indirect_fn_return_unknown: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_indirect_fn_return_unknown = cg, call =>
   types::init_error(cg, "E3103", "Return type of indirect function call could not " +
      "be statically determined (fn_name=\"" + call.fn_name +
      "\" fn_target=false ret=Unknown).", call.line, call.col)
   (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_eval_unaliased_call: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_unaliased_call = cg, call =>
   rname = types::resolve_fn_name(cg, call.fn_name)
   is_known = types::is_fn_name(cg, rname) | <+> | types::has_fn_name(cg, rname)
   is_known
      |
         res = codegen_eval_named_call(cg, call)
         res | _ | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         vt = types::var_type(cg, call.fn_name)
         has_slot = <>(types::var_slot(cg, call.fn_name))
         is_var = types::has_local_var(cg, call.fn_name) | <+> | has_slot
         is_fn_var = is_var | main::is_fn_vt(vt) | <->
         cfn = closure_fn_of(cg, call.fn_name)
         fret = cfn != "" | fn_ret_vt_of(cg, cfn) | ast::ValueType(Unknown)
         ret0 = fret != ast::ValueType(Unknown) | fret |
            cg.last_type != "" | types::type_name_to_vt(cg.last_type).0 |
               ast::ValueType(Unknown)
         v_dt = types::var_dtype(cg, call.fn_name)
         ret = ret0 != ast::ValueType(Unknown) | ret0 |
            v_dt != "" | types::type_name_to_vt(v_dt).0 | ast::ValueType(Unknown)
         is_fn_var
            |
               ret == ast::ValueType(Unknown)
                  | codegen_indirect_fn_return_unknown(cg, call)
                  | codegen_closure_call_indirect(cg, call, ret)
            |
               is_data = vt [Fn, Record, Array, Slice]
               non_fn = call.fn_name != "_"
                  | (has_slot | !is_data | <->)
                  | <->
               non_fn
                  | codegen_non_function_call_error(cg, call, vt)
                  |
                     res = codegen_eval_named_call(cg, call)
                     res | _ | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                        ast::ValueType(Unknown))

codegen_non_function_call_error: types::Cg, ast::CallExpr, ast::ValueType => (Addr, ast::ValueType)
codegen_non_function_call_error = cg, call, vt =>
   types::init_error(cg, "E3147", "Cannot call '" + call.fn_name + "' — it holds a " +
      types::value_type_name(vt) + ", not a function.", call.line, call.col)
   (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

str_index_of_comma: String, Int => Int
str_index_of_comma = s, i =>
   i < ?s
      |
         s(i) == ',' | i | str_index_of_comma(s, i + 1)
      | -1

split_comma_names_step: String, Int, Int, ast::Names => ast::Names
split_comma_names_step = s, start, i, acc =>
   i == ?s
      |
         start < i | (acc += s(start..i)) | 0
         acc
      |
         s(i) == ','
            |
               acc += s(start..i)
               split_comma_names_step(s, i + 1, i + 1, acc)
            | split_comma_names_step(s, start, i + 1, acc)

split_comma_names: String => ast::Names
split_comma_names = s =>
   ?s == 0 | ast::Names() | split_comma_names_step(s, 0, 0, ast::Names())

ram_slot_has_ct: ast::RamSlotInfo, String => <>
ram_slot_has_ct = slot, ct_name =>
   slot.has_payload &&
      (slot.payload_record [TypeVar n] n == ct_name | <->)


rec_has_ct_name: ast::FieldTypes, String, Int => <>
rec_has_ct_name = fts, ct_name, i =>
   i == ?fts
      | <->
      |
         ft = (fts(i) | _ | ast::RecordFieldType(("", ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown)),
            <->, ast::Expr(Int, 0))))
         ti_has_ct_name(ft.rec_type, ct_name)
            | <+>
            | rec_has_ct_name(fts, ct_name, i + 1)

ti_has_ct_name: ast::TypeInfo, String => <>
ti_has_ct_name = ti, ct_name =>
   ti
      [TypeVar name] name == ct_name
      [Ram s]
         ram_slot_has_ct(s.0, ct_name) || ram_slot_has_ct(s.1, ct_name)
      [Rec r]
         rec_has_ct_name(r.0, ct_name, 0)
      [Array a]
         ti_has_ct_name(a.1, ct_name)
      [Fn f]
         find_ct_param_index_at(f.1, ct_name, 0, ?f.1) !< 0 ||
            ti_has_ct_name(f.3, ct_name)
      | <->

find_ct_param_index_at: ast::VInfos, String, Int, Int => Int
find_ct_param_index_at = tis, ct_name, i, n =>
   i == n
      | -1
      |
         ti = tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         is_match = ti_has_ct_name(ti, ct_name)
         is_match
            | i
            | find_ct_param_index_at(tis, ct_name, i + 1, n)

find_ct_param_index: ast::VInfos, String => Int
find_ct_param_index = tis, ct_name =>
   find_ct_param_index_at(tis, ct_name, 0, ?tis)

fn_p0_vt: types::Cg, String => ast::ValueType
fn_p0_vt = cg, fn_name =>
   fpts = stmt::fn_signature_param_types(cg, types::g.pstmts, fn_name, 0)
   fpts(0) | _ | ast::ValueType(Unknown)

fn_p0_ti: String => ast::TypeInfo
fn_p0_ti = fn_name =>
   ftis = stmt::fn_signature_param_tis(types::g.pstmts, fn_name)
   ftis(0) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))

arg_to_fn_name: types::Cg, ast::Expr => String
arg_to_fn_name = cg, arg =>
   arg
      [Var v] types::resolve_fn_name(cg, v)
      [Member m]
         m.is_module_access
            |
               m.target
                  [Var mod_name] mod_name + "::" + m.field_name
                  | ""
            | ""
      | ""

infer_ct_fn_match: types::Cg, ast::TypeInfo, ast::Expr, String => (ast::ValueType, ast::TypeInfo, String)
infer_ct_fn_match = cg, ti, arg, ct_name =>
   ti
      [Fn f]
         ret_match = f.3 [TypeVar n] n == ct_name | <->
         f1_0 = ?f.1 > 0
            | f.1(0) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         p0_match = ?f.1 > 0 && (f1_0 [TypeVar n] n == ct_name | <->)
         fn_name = arg_to_fn_name(cg, arg)
         hit = (ret_match || p0_match) && fn_name != ""
         hit
            |
               ret_match
                  | (stmt::fn_signature_return(cg, types::g.pstmts, fn_name, 0),
                     stmt::fn_signature_return_ti(cg, types::g.pstmts, fn_name, 0), "")
                  | (fn_p0_vt(cg, fn_name), fn_p0_ti(fn_name), "")
            |
               p0_match
                  |
                     arg
                        [Fn lam]
                           caps = stmt::lambda_captures(cg, lam)
                           nc = ?caps
                           cnames = ast::Names()
                           cvts = ast::VTypes()
                           nc @ ci =>
                              cn = caps(ci) | _ | ""
                              cnames += cn
                              cvts += types::var_type(cg, cn)
                           pts = stmt::infer_param_types_env(types::FnDef(("", lam.params,
                              lam.body)), ast::VTypes(), cnames, cvts)
                           p0_vt = pts(0) | _ | ast::ValueType(Unknown)
                           (p0_vt, ast::TypeInfo(Prim, p0_vt), "")
                        |
                           (ast::ValueType(Unknown),
                              ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
                  |
                     (ast::ValueType(Unknown),
                        ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
      | (ast::ValueType(Unknown),
         ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")

infer_ct_fn_ret: types::Cg, ast::VInfos, ast::Exprs, String,
   Int => (ast::ValueType, ast::TypeInfo, String)
infer_ct_fn_ret = cg, tis, args, ct_name, i =>
   i == ?tis
      | (ast::ValueType(Unknown),
         ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
      |
         ti = tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         arg = args(i) | _ | ast::Expr(Var, "")
         m = infer_ct_fn_match(cg, ti, arg, ct_name)
         m.0 != ast::ValueType(Unknown)
            | m
            | infer_ct_fn_ret(cg, tis, args, ct_name, i + 1)

infer_ct_from_ram_arg: types::Cg, ast::Expr => (ast::ValueType, ast::TypeInfo, String)
infer_ct_from_ram_arg = cg, arg =>
   arg
      [Variant v]
         ?v.args > 0
            |
               parg = v.args(0) | _ | ast::Expr(Var, "")
               pvt = stmt::infer_expr_type(cg, parg)
               pdt = parg [Var vn] types::var_dtype(cg, vn) | ""
               pti = pdt != "" && types::is_user_type(cg, pdt)
                  | types::typedef_ti(cg, pdt)
                  | ast::TypeInfo(Prim, pvt)
               (pvt, pti, pdt)
            |
               (ast::ValueType(Unknown),
                  ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
      |
         (ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")

synth_variant_ram_ti: types::Cg, ast::VariantExpr => ast::TypeInfo
synth_variant_ram_ti = cg, v =>
   empty_slot = ast::RamSlotInfo((<->, ast::ValueType(Unknown),
      ast::TypeInfo(Prim, ast::ValueType(Unknown))))
   slot_unk = ast::RamSlotInfo((<+>, ast::ValueType(Unknown),
      ast::TypeInfo(Prim, ast::ValueType(Unknown))))
   ?v.args > 0
      |
         parg = v.args(0) | _ | ast::Expr(Var, "")
         pvt = stmt::infer_expr_type(cg, parg)
         pdt = parg [Var vn] types::var_dtype(cg, vn) | ""
         pti = pdt != "" && types::is_user_type(cg, pdt)
            | types::typedef_ti(cg, pdt)
            | ast::TypeInfo(Prim, pvt)
         slot_info = ast::RamSlotInfo((<+>, pvt, pti))
         v.tag_name
            [Positive] ast::TypeInfo(Ram, (slot_info, slot_unk))
            [Negative] ast::TypeInfo(Ram, (slot_unk, slot_info))
            [Some] ast::TypeInfo(Ram, (slot_info, empty_slot))
            [Err] ast::TypeInfo(Ram, (empty_slot, slot_info))
            | ast::TypeInfo(Ram, (empty_slot, empty_slot))
      |
         v.tag_name
            [Succ] ast::TypeInfo(Ram, (empty_slot, slot_unk))
            [Noth] ast::TypeInfo(Ram, (slot_unk, empty_slot))
            | ast::TypeInfo(Ram, (empty_slot, empty_slot))

codegen_ram_type_of_expr: types::Cg, ast::Expr => ast::TypeInfo
codegen_ram_type_of_expr = cg, expr =>
   expr
      [Var vn]
         vti = var_ti(cg, vn)
         vti [Ram _] vti | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      [Call c]
         real_name = types::resolve_fn_name(cg, c.fn_name)
         fname = fn_alias(cg, real_name)
         eff_name = fname != "" | fname | real_name
         sig_ti = stmt::fn_signature_return_ti(cg, types::g.pstmts, eff_name, 0)
         stmt::resolve_ti(cg, sig_ti)
      [Variant v] synth_variant_ram_ti(cg, v)
      [Block b]
         nb = ?b.exprs
         nb > 0
            | codegen_ram_type_of_expr(cg, b.exprs(nb - 1)!!)
            | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      [Fn f] codegen_ram_type_of_expr(cg, f.body)
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))

ram_pn_str: ast::ValueType => String
ram_pn_str = vt =>
   vt == ast::ValueType(Unknown)
      | "< ... | >"
      | "< " + types::value_type_name(vt) + " | >"

ram_np_str: ast::ValueType => String
ram_np_str = vt =>
   vt == ast::ValueType(Unknown)
      | "< | ... >"
      | "< | " + types::value_type_name(vt) + " >"

ram_pp_str: ast::ValueType, ast::ValueType => String
ram_pp_str = l_vt, r_vt =>
   l_str = l_vt == ast::ValueType(Unknown) | "..." | types::value_type_name(l_vt)
   r_str = r_vt == ast::ValueType(Unknown) | "..." | types::value_type_name(r_vt)
   "< " + l_str + " | " + r_str + " >"

ram_shape_slots_str: types::Cg, ast::RamSlotInfo, ast::RamSlotInfo => String
ram_shape_slots_str = cg, s0, s1 =>
   l_pay = s0.has_payload
   r_pay = s1.has_payload
   s0_vt = types::slot_payload_type(cg, s0)
   s1_vt = types::slot_payload_type(cg, s1)
   !l_pay && !r_pay
      | "<>"
      |
         l_pay && !r_pay
            | ram_pn_str(s0_vt)
            |
               !l_pay && r_pay
                  | ram_np_str(s1_vt)
                  | ram_pp_str(s0_vt, s1_vt)

prim_ram_str: ast::ValueType => String
prim_ram_str = vt => vt [Flag] "<>" | types::value_type_name(vt)

ram_shape_str: types::Cg, ast::TypeInfo => String
ram_shape_str = cg, ti =>
   ti
      [Prim vt] prim_ram_str(vt)
      [TypeVar name] ram_shape_str(cg, types::typedef_ti(cg, name))
      [Ram slots] ram_shape_slots_str(cg, slots.0, slots.1)
      | "Unknown"

ram_slot_compatible: types::Cg, ast::RamSlotInfo, ast::RamSlotInfo => <>
ram_slot_compatible = cg, a, b =>
   a.has_payload
      |
         b.has_payload
            |
               a_vt = types::slot_payload_type(cg, a)
               b_vt = types::slot_payload_type(cg, b)
               a_vt == ast::ValueType(Unknown) ||
                  b_vt == ast::ValueType(Unknown) ||
                  a_vt == b_vt
            | <->
      |
         b.has_payload
            | <->
            | <+>

ram_b_slots_compatible: types::Cg, ast::RamSlotInfo, ast::RamSlotInfo,
   ast::TypeInfo => <>
ram_b_slots_compatible = cg, a0, a1, b_ti =>
   b_ti
      [Ram bs]
         ram_slot_compatible(cg, a0, bs.0) &&
            ram_slot_compatible(cg, a1, bs.1)
      | <->

ram_b_flag_compatible: ast::TypeInfo => <>
ram_b_flag_compatible = b_ti =>
   b_ti
      [Prim vt_b] vt_b == ast::ValueType(Flag)
      | <->

ram_shape_compatible: types::Cg, ast::TypeInfo, ast::TypeInfo => <>
ram_shape_compatible = cg, a, b =>
   a_ti = stmt::resolve_ti(cg, a)
   b_ti = stmt::resolve_ti(cg, b)
   a_ti
      [Prim vt_a]
         vt_a == ast::ValueType(Flag)
            | ram_b_flag_compatible(b_ti)
            | <->
      [Ram as] ram_b_slots_compatible(cg, as.0, as.1, b_ti)
      | <->


var_forward_ti: types::Cg, ast::Exprs, String => ast::TypeInfo
var_forward_ti = cg, stmts, name =>
   var_forward_ti_rev(cg, stmts, name, ?stmts - 1)

var_forward_ti_rev: types::Cg, ast::Exprs, String, Int => ast::TypeInfo
var_forward_ti_rev = cg, stmts, name, at =>
   at < 0
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      |
         e = stmts(at)!!
         e
            [Assign t]
               (t.0 == name) && t.1
                  | t.8
                  | var_forward_ti_rev(cg, stmts, name, at - 1)
            | var_forward_ti_rev(cg, stmts, name, at - 1)

var_ti: types::Cg, String => ast::TypeInfo
var_ti = cg, name =>
   ti = var_forward_ti(cg, types::g.pstmts, name)
   ti [Prim vt]
      vt [Unknown]
         dt = types::var_dtype(cg, name)
         dt != "" && types::has_type_name(cg, dt)
            | types::typedef_ti(cg, dt)
            | ti
      | ti
   | ti

infer_slice_arg_elem: types::Cg, ast::Expr => (ast::ValueType, ast::TypeInfo, String)
infer_slice_arg_elem = cg, arg =>
   arg
      [Call c]
         ?c.args > 0 && (c.args(0)!! [Range _])
            |
               target = c.fn_name
               tvt' = types::var_type(cg, target)
               tvt'
                  [Record]
                     fvs' = match::var_fvts(cg, target)
                     vt' = ?fvs' > 0 | (fvs'(0) | _ | ast::ValueType(Unknown)) |
                        ast::ValueType(Unknown)
                     (vt', ast::TypeInfo(Prim, vt'), types::var_dtype(cg, target))
                  [Array]
                     vt' = main::array_elem_vt(cg, target)
                     (vt', ast::TypeInfo(Prim, vt'), types::var_dtype(cg, target))
                  [Str]
                     (ast::ValueType(Int),
                        ast::TypeInfo(Prim, ast::ValueType(Int)), "")
                  |
                     (ast::ValueType(Unknown),
                        ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
            |
               (ast::ValueType(Unknown),
                  ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
      [Var v]
         tvt' = types::var_type(cg, v)
         tvt'
            [Slice]
               fvs' = match::var_fvts(cg, v)
               vt' = ?fvs' > 0 | (fvs'(0) | _ | ast::ValueType(Unknown)) |
                  ast::ValueType(Unknown)
               (vt', ast::TypeInfo(Prim, vt'), types::var_dtype(cg, v))
            [Array]
               vt' = main::array_elem_vt(cg, v)
               (vt', ast::TypeInfo(Prim, vt'), types::var_dtype(cg, v))
            |
               (ast::ValueType(Unknown),
                  ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
      |
         (ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")


synth_rec_ti_from_fvts: types::Cg, ast::Names, ast::VTypes => ast::TypeInfo
synth_rec_ti_from_fvts = cg, fnames, fvts =>
   nf = ?fvts
   nf == 0
      | ast::TypeInfo(Prim, ast::ValueType(Record))
      |
         fts = ast::FieldTypes()
         nf @ i =>
            fname = ?fnames > i | (fnames(i) | _ | "") | ""
            fvt = (fvts(i) | _ | ast::ValueType(Unknown))
            fts += ast::RecordFieldType((fname, fvt,
               ast::TypeInfo(Prim, fvt), <->, ast::Expr(Int, 0)))
         ast::TypeInfo(Rec, (fts, <->, <->, ast::ValueType(Record), nf, <->))

synth_rec_ti_from_var: types::Cg, String => ast::TypeInfo
synth_rec_ti_from_var = cg, v =>
   dt = types::var_dtype(cg, v)
   dt != "" && types::is_user_type(cg, dt)
      | types::typedef_ti(cg, dt)
      |
         fvts = match::var_fvts(cg, v)
         fnames = types::var_fnames(cg, v)
         synth_rec_ti_from_fvts(cg, fnames, fvts)

infer_expr_type_and_info: types::Cg, ast::Expr => (ast::ValueType, ast::TypeInfo)
infer_expr_type_and_info = cg, e =>
   e
      [Int _] (ast::ValueType(Int), ast::TypeInfo(Prim, ast::ValueType(Int)))
      [Float _] (ast::ValueType(Float), ast::TypeInfo(Prim, ast::ValueType(Float)))
      [Str _] (ast::ValueType(Str), ast::TypeInfo(Prim, ast::ValueType(Str)))
      [Rune _] (ast::ValueType(Rune), ast::TypeInfo(Prim, ast::ValueType(Rune)))
      [Variant v]
         is_flag = v.tag_name [Positive, Negative] && ?v.args == 0
         is_flag
            | (ast::ValueType(Flag), ast::TypeInfo(Prim, ast::ValueType(Flag)))
            | (ast::ValueType(Ram), synth_variant_ram_ti(cg, v))
      [Record r]
         ti' = synth_rec_ti_from_record_expr(cg, r)
         (ast::ValueType(Record), ti')
      [Var v]
         vt' = types::var_type(cg, v)
         dt = types::var_dtype(cg, v)
         rec_ti = vt' [Record] synth_rec_ti_from_var(cg, v) |
            ast::TypeInfo(Prim, vt')
         ti' = dt != "" && types::is_user_type(cg, dt)
            | types::typedef_ti(cg, dt)
            | rec_ti
         (vt', ti')
      [Call c] stmt::infer_call_expr_type(cg, c)
      [Member m] stmt::infer_member_type(cg, m)
      |
         vt' = stmt::infer_expr_type(cg, e)
         (vt', ast::TypeInfo(Prim, vt'))

synth_rec_ti_from_record_expr: types::Cg, ast::RecordExpr => ast::TypeInfo
synth_rec_ti_from_record_expr = cg, r =>
   fts = ast::FieldTypes()
   ?r.fields @ i =>
      f = r.fields(i)!!
      fname = f.has_name | f.name | ""
      finf = infer_expr_type_and_info(cg, f.val)
      fts += ast::RecordFieldType((fname, finf.0, finf.1,
         <->, ast::Expr(Int, 0)))
   ast::TypeInfo(Rec, (fts, <->, <->, ast::ValueType(Record), ?r.fields, <->))

synth_rec_ti: types::Cg, ast::Expr => ast::TypeInfo
synth_rec_ti = cg, arg =>
   arg
      [Record r] synth_rec_ti_from_record_expr(cg, r)
      [Var v] synth_rec_ti_from_var(cg, v)
      |
         ?cg.last_fvts > 0
            | synth_rec_ti_from_fvts(cg, cg.last_fnames, cg.last_fvts)
            | ast::TypeInfo(Prim, ast::ValueType(Record))

infer_arg_ti: types::Cg, ast::Expr, ast::ValueType, String => ast::TypeInfo
infer_arg_ti = cg, arg, vt, dt =>
   dt != "" && types::is_user_type(cg, dt)
      | types::typedef_ti(cg, dt)
      |
         arg
            [Variant v]
               is_flag = v.tag_name [Positive, Negative] && ?v.args == 0
               is_flag
                  | ast::TypeInfo(Prim, ast::ValueType(Flag))
                  | synth_variant_ram_ti(cg, v)
            |
               vt [Record] synth_rec_ti(cg, arg)
                  | ast::TypeInfo(Prim, vt)

infer_ct_from_any_container: types::Cg, ast::Exprs, Int => (ast::ValueType,
   ast::TypeInfo, String)
infer_ct_from_any_container = cg, args, i =>
   i == ?args
      | (ast::ValueType(Unknown),
         ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
      |
         arg = (args(i) | _ | ast::Expr(Var, ""))
         sl = infer_slice_arg_elem(cg, arg)
         sl.0 != ast::ValueType(Unknown)
            | sl
            | infer_ct_from_any_container(cg, args, i + 1)

unwrap_user_ti: types::Cg, ast::TypeInfo => ast::TypeInfo
unwrap_user_ti = cg, ti =>
   ti [TypeVar tv] (types::is_user_type(cg, tv) | types::typedef_ti(cg, tv) | ti) | ti


extract_ct_from_arr: types::Cg, ast::TypeInfo, ast::TypeInfo,
   String => < (ast::ValueType, ast::TypeInfo, String) | >
extract_ct_from_arr = cg, p_elem, arg_ti, ct_name =>
   res' = <-->
   ti_has_ct_name(p_elem, ct_name)
      |
         a_raw = unwrap_user_ti(cg, arg_ti)
         a_raw
            [Array a_arr]
               res' = extract_ct_binding(cg, p_elem, a_arr.1, ct_name)
   res'

extract_ct_from_fn: types::Cg, ast::TypeInfo, ast::TypeInfo,
   String => < (ast::ValueType, ast::TypeInfo, String) | >
extract_ct_from_fn = cg, p_ti, arg_ti, ct_name =>
   res' = <-->
   found' = <->
   p_ti
      [Fn p_fn]
         a_raw = unwrap_user_ti(cg, arg_ti)
         a_raw
            [Fn a_fn]
               pis = p_fn.1
               ais = a_fn.1
               ?pis @ m =>
                  pi = pis(m) | _ |
                     ast::TypeInfo(Prim, ast::ValueType(Unknown))
                  m < ?ais && ti_has_ct_name(pi, ct_name)
                     |
                        ai = ais(m) | _ |
                           ast::TypeInfo(Prim, ast::ValueType(Unknown))
                        b = extract_ct_binding(cg, pi, ai, ct_name)
                        b | (res' = b; found' = <+>; -->)
               !found' && ti_has_ct_name(p_fn.3, ct_name)
                  | res' = extract_ct_binding(cg, p_fn.3, a_fn.3, ct_name)
   res'

extract_ct_from_ram: types::Cg, ast::TypeInfo, ast::TypeInfo,
   String => < (ast::ValueType, ast::TypeInfo, String) | >
extract_ct_from_ram = cg, p_ti, arg_ti, ct_name =>
   res' = <-->
   found' = <->
   p_ti
      [Ram p_ram]
         a_raw = unwrap_user_ti(cg, arg_ti)
         a_raw
            [Ram a_ram]
               c0 = p_ram.0.has_payload && a_ram.0.has_payload &&
                  ram_slot_has_ct(p_ram.0, ct_name)
               c0
                  |
                     res' = extract_ct_binding(cg,
                        p_ram.0.payload_record,
                        a_ram.0.payload_record, ct_name)
                     found' = <+>
               !found'
                  |
                     c1 = p_ram.1.has_payload && a_ram.1.has_payload &&
                        ram_slot_has_ct(p_ram.1, ct_name)
                     c1
                        | res' = extract_ct_binding(cg,
                             p_ram.1.payload_record,
                             a_ram.1.payload_record, ct_name)
   res'

extract_ct_from_rec: types::Cg, ast::TypeInfo, ast::TypeInfo,
   String => < (ast::ValueType, ast::TypeInfo, String) | >
extract_ct_from_rec = cg, p_ti, arg_ti, ct_name =>
   res' = <-->
   p_ti
      [Rec p_rec]
         a_raw = unwrap_user_ti(cg, arg_ti)
         a_raw
            [Rec a_rec]
               pfts = p_rec.0
               afts = a_rec.0
               d_ft = ast::RecordFieldType(("", ast::ValueType(Unknown),
                  ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                  <->, ast::Expr(Int, 0)))
               ?pfts @ m =>
                  pf = pfts(m) | _ | d_ft
                  m < ?afts && ti_has_ct_name(pf.rec_type, ct_name)
                     |
                        af = afts(m) | _ | d_ft
                        b = extract_ct_binding(cg, pf.rec_type,
                           af.rec_type, ct_name)
                        b | (res' = b; -->)
   res'

extract_ct_binding: types::Cg, ast::TypeInfo, ast::TypeInfo,
   String => < (ast::ValueType, ast::TypeInfo, String) | >
extract_ct_binding = cg, param_ti, arg_ti, ct_name =>
   param_ti
      [TypeVar name]
         name == ct_name
            |
               raw_ti = arg_ti
               tv_name = raw_ti [TypeVar tv] tv | ""
               is_ut = tv_name != "" && types::is_user_type(cg, tv_name)
               real_ti = is_ut | types::typedef_ti(cg, tv_name) | raw_ti
               real_vt = types::vt_from_ti(real_ti)
               real_dt = tv_name != "" | tv_name | ""
               <+ (real_vt, real_ti, real_dt) ->
            | <-->
      [Array p_arr] extract_ct_from_arr(cg, p_arr.1, arg_ti, ct_name)
      [Fn _] extract_ct_from_fn(cg, param_ti, arg_ti, ct_name)
      [Ram _] extract_ct_from_ram(cg, param_ti, arg_ti, ct_name)
      [Rec _] extract_ct_from_rec(cg, param_ti, arg_ti, ct_name)
      | <-->

extract_ct_from_tis: types::Cg, ast::VInfos, ast::VInfos,
   String => < (ast::ValueType, ast::TypeInfo, String) | >
extract_ct_from_tis = cg, tis, catis, ct_name =>
   res' = <-->
   d_ti = ast::TypeInfo(Prim, ast::ValueType(Unknown))
   ?tis @ j =>
      ti_j = tis(j) | _ | d_ti
      j < ?catis && ti_has_ct_name(ti_j, ct_name)
         |
            ca_j = catis(j) | _ | d_ti
            b = extract_ct_binding(cg, ti_j, ca_j, ct_name)
            b | (res' = b; -->)
   res'

infer_ct_param: types::Cg, ast::VInfos, ast::Exprs, ast::VTypes, ast::Names,
   String => (ast::ValueType, ast::TypeInfo, String)
infer_ct_param = cg, tis, args, cavts, cadts, ct_name =>
   pidx = find_ct_param_index(tis, ct_name)
   pidx !< 0
      |
         ti_param = tis(pidx) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         ti_param
            [Ram _]
               arg' = args(pidx) | _ | ast::Expr(Var, "")
               ram_inf = infer_ct_from_ram_arg(cg, arg')
               ram_inf.0 != ast::ValueType(Unknown)
                  | ram_inf
                  |
                     rem_idx = find_ct_param_index_at(tis, ct_name, pidx + 1, ?tis)
                     rem_idx !< 0
                        |
                           arg_rem = args(rem_idx) | _ | ast::Expr(Var, "")
                           vt' = cavts(rem_idx) | _ | ast::ValueType(Unknown)
                           dt' = cadts(rem_idx) | _ | ""
                           ti' = infer_arg_ti(cg, arg_rem, vt', dt')
                           (vt', ti', dt')
                        |
                           (ast::ValueType(Unknown),
                              ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")
            [Rec r]
               r.1
                  |
                     arg' = args(pidx) | _ | ast::Expr(Var, "")
                     sl_inf = infer_slice_arg_elem(cg, arg')
                     sl_inf.0 != ast::ValueType(Unknown)
                        | sl_inf
                        |
                           vt' = cavts(pidx) | _ | ast::ValueType(Unknown)
                           (vt', ast::TypeInfo(Prim, vt'), "")
                  |
                     arg' = args(pidx) | _ | ast::Expr(Var, "")
                     vt' = cavts(pidx) | _ | ast::ValueType(Unknown)
                     dt' = cadts(pidx) | _ | ""
                     ti' = infer_arg_ti(cg, arg', vt', dt')
                     (vt', ti', dt')
            |
               arg' = args(pidx) | _ | ast::Expr(Var, "")
               vt' = cavts(pidx) | _ | ast::ValueType(Unknown)
               dt' = cadts(pidx) | _ | ""
               ti' = infer_arg_ti(cg, arg', vt', dt')
               (vt', ti', dt')
      |
         ret_m = infer_ct_fn_ret(cg, tis, args, ct_name, 0)
         ret_m.0 != ast::ValueType(Unknown)
            | ret_m
            |
               elem_m = infer_ct_from_any_container(cg, args, 0)
               elem_m.0 != ast::ValueType(Unknown)
                  | elem_m
                  |
                     ?cavts > 0
                        |
                           arg0 = (args(0) | _ | ast::Expr(Var, ""))
                           vt' = (cavts(0) | _ | ast::ValueType(Unknown))
                           dt' = (cadts(0) | _ | "")
                           ti' = infer_arg_ti(cg, arg0, vt', dt')
                           (vt', ti', dt')
                        |
                           (ast::ValueType(Unknown),
                              ast::TypeInfo(Prim, ast::ValueType(Unknown)), "")

vt_to_type_key: types::Cg, ast::ValueType, String => String
vt_to_type_key = cg, vt, dtype =>
   dtype != "" && types::is_user_type(cg, dtype)
      | dtype
      |
         vt
            [Int] "Int"
            [Rune] "Rune"
            [Float] "Float"
            [F32] "f32"
            [Str] "String"
            [Builder] "Builder"
            [RawPtr] "Addr"
            [Flag] "Flag"
            [Ram] "Ram"
            [Enum] "Enum"
            [Record] "Record"
            [Slice] "Slice"
            [Array] "Array"
            [Fn] "Fn"
            | "Unknown"


rec_ti_to_type_key: types::Cg, ast::FieldTypes, Int, Int, Builder => String
rec_ti_to_type_key = cg, fts, i, n, b =>
   i == n
      | +b
      |
         i > 0 | b += ','
         rf = fts(i)!!
         b += ti_to_type_key(cg, rf.rec_type, rf.val_type, "")
         rec_ti_to_type_key(cg, fts, i + 1, n, b)

ti_to_type_key: types::Cg, ast::TypeInfo, ast::ValueType, String => String
ti_to_type_key = cg, ti, vt, dtype =>
   can_ti = types::ctfe_canonical_ti(cg, ti)
   can_ti
      [Prim pvt]
         vt_to_type_key(cg, pvt, "")
      [Ram s]
         l = s.0.has_payload | vt_to_type_key(cg, s.0.payload_type, "") | "_"
         r = s.1.has_payload | vt_to_type_key(cg, s.1.payload_type, "") | "_"
         "Ram(" + l + "|" + r + ")"
      [Rec r]
         r.1
            | "Slice(" + vt_to_type_key(cg, r.3, "") + ")"
            |
               b = {64}
               k = rec_ti_to_type_key(cg, r.0, 0, ?r.0, {32})
               b += ("Rec(", k, ")")
               +b
      [Array a]
         "Array(" + ti_to_type_key(cg, a.1, a.0, "") + ")"
      [Map m]
         "Map(" + vt_to_type_key(cg, m.0, "") + "," +
            vt_to_type_key(cg, m.1, "") + ")"
      [Enum _]
         dtype != "" | dtype | "Enum"
      |
         dtype != "" && types::is_user_type(cg, dtype)
            | dtype
            | vt_to_type_key(cg, vt, dtype)

subst_mono_vts: ast::VTypes, ast::VInfos, String, ast::ValueType, Int,
   ast::VTypes => ast::VTypes
subst_mono_vts = vts, tis, ct_name, bound_vt, i, acc =>
   i == ?vts
      | acc
      |
         ti = tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         is_ct = ti [TypeVar name] name == ct_name | <->
         acc += is_ct | bound_vt | (vts(i) | _ | ast::ValueType(Unknown))
         subst_mono_vts(vts, tis, ct_name, bound_vt, i + 1, acc)

subst_mono_ram_slot: ast::RamSlotInfo, String, ast::TypeInfo, ast::ValueType => ast::RamSlotInfo
subst_mono_ram_slot = slot, ct_name, bound_ti, bound_vt =>
   slot.has_payload
      |
         sub_rec = subst_mono_ti(slot.payload_record, ct_name,
            bound_ti, bound_vt)
         is_match = slot.payload_record [TypeVar name] name == ct_name | <->
         sub_vt = is_match | bound_vt | slot.payload_type
         ast::RamSlotInfo((<+>, sub_vt, sub_rec))
      | slot


subst_mono_fields: ast::FieldTypes, String, ast::TypeInfo, ast::ValueType,
   Int, ast::FieldTypes => ast::FieldTypes
subst_mono_fields = fts, ct_name, bound_ti, bound_vt, i, acc =>
   i == ?fts
      | acc
      |
         ft = (fts(i) | _ | ast::RecordFieldType(("", ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown)),
            <->, ast::Expr(Int, 0))))
         is_match = ft.rec_type [TypeVar n] n == ct_name | <->
         new_vt = is_match | bound_vt | ft.val_type
         new_ti = subst_mono_ti(ft.rec_type, ct_name, bound_ti, bound_vt)
         acc += ast::RecordFieldType((ft.name, new_vt, new_ti,
            ft.has_default, ft.default_expr))
         subst_mono_fields(fts, ct_name, bound_ti, bound_vt, i + 1, acc)

subst_mono_ti: ast::TypeInfo, String, ast::TypeInfo,
   ast::ValueType => ast::TypeInfo
subst_mono_ti = ti, ct_name, bound_ti, bound_vt =>
   ti
      [TypeVar name]
         name == ct_name | bound_ti | ti
      [Ram s]
         new_l = subst_mono_ram_slot(s.0, ct_name, bound_ti, bound_vt)
         new_r = subst_mono_ram_slot(s.1, ct_name, bound_ti, bound_vt)
         ast::TypeInfo(Ram, (new_l, new_r))
      [Rec r]
         new_fields = subst_mono_fields(r.0, ct_name, bound_ti, bound_vt, 0,
            ast::FieldTypes())
         ast::TypeInfo(Rec, (new_fields, r.1, r.2, bound_vt, r.4, r.5))
      [Bitfield b] ast::TypeInfo(Bitfield, b)
      [Array a]
         new_elem_ti = subst_mono_ti(a.1, ct_name, bound_ti, bound_vt)
         is_match = a.1 [TypeVar name] name == ct_name | <->
         new_elem_vt = is_match | bound_vt | a.0
         ast::TypeInfo(Array, (new_elem_vt, new_elem_ti, a.2))
      [Fn f]
         nf0 = subst_mono_vts(f.0, f.1, ct_name, bound_vt, 0, ast::VTypes())
         nf1 = subst_mono_tis(f.1, ct_name, bound_ti, bound_vt, 0,
            ast::VInfos())
         nf2 = subst_mono_ret_vt(f.2, f.3, ct_name, bound_vt)
         nf3 = subst_mono_ti(f.3, ct_name, bound_ti, bound_vt)
         ast::TypeInfo(Fn, (nf0, nf1, nf2, nf3, f.4))
      | ti

subst_mono_tis: ast::VInfos, String, ast::TypeInfo, ast::ValueType, Int,
   ast::VInfos => ast::VInfos
subst_mono_tis = tis, ct_name, bound_ti, bound_vt, i, acc =>
   i == ?tis
      | acc
      |
         ti = tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         acc += subst_mono_ti(ti, ct_name, bound_ti, bound_vt)
         subst_mono_tis(tis, ct_name, bound_ti, bound_vt, i + 1, acc)

subst_mono_dtypes: ast::Names, ast::VInfos, String, String, Int,
   ast::Names => ast::Names
subst_mono_dtypes = dtypes, tis, ct_name, bound_dtype, i, acc =>
   i == ?tis
      | acc
      |
         ti = tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown))
         dt = dtypes(i) | _ | ""
         is_ct = (dt == ct_name) || (ti [TypeVar name] name == ct_name | <->)
         acc += is_ct | bound_dtype | dt
         subst_mono_dtypes(dtypes, tis, ct_name, bound_dtype, i + 1, acc)

subst_mono_ret_vt: ast::ValueType, ast::TypeInfo, String,
   ast::ValueType => ast::ValueType
subst_mono_ret_vt = ret_vt, ret_ti, ct_name, bound_vt =>
   is_ct = ret_ti [TypeVar name] name == ct_name | <->
   is_ct | bound_vt | ret_vt

hex_char: Int => Int
hex_char = n =>
   n < 10 | 48 + n | 97 + (n - 10)

sanitize_mono_str: String, Int, Builder => String
sanitize_mono_str = s, i, b =>
   i == ?s
      | +b
      |
         c = s(i)
         is_alnum = (c !< 48 && c !> 57) || (c !< 65 && c !> 90) ||
            (c !< 97 && c !> 122) || c == 95
         is_alnum
            | b += c
            |
               hi = c .>. 4 .&. 15
               lo = c .&. 15
               b += ('_', hex_char(hi), hex_char(lo))
         sanitize_mono_str(s, i + 1, b)

slice_exprs_from_at: ast::Exprs, Int, Int, ast::Exprs => ast::Exprs
slice_exprs_from_at = es, i, n, acc =>
   i !< n
      | acc
      |
         e = es(i)!!
         next = acc
         next += e
         slice_exprs_from_at(es, i + 1, n, next)

slice_exprs_from: ast::Exprs, Int => ast::Exprs
slice_exprs_from = es, start =>
   slice_exprs_from_at(es, start, ?es, ast::Exprs())

typed_expr_to_ast: tast::TypedExpr => ast::Expr
typed_expr_to_ast = te =>
   te.kind
      [LitInt n] ast::Expr(Int, n)
      [LitStr s] ast::Expr(Str, s)
      [LitFloat f] ast::Expr(Float, f)
      [LitRune r] ast::Expr(Rune, r)
      [Var v] ast::Expr(Var, v.0)
      [Bin b]
         ast::Expr(Bin, (b.0, typed_expr_to_ast(b.1), typed_expr_to_ast(b.2)))
      [Unary u]
         ast::Expr(Unary, (u.0, typed_expr_to_ast(u.1)))
      | ast::Expr(Var, "")

typed_expr_to_ct_val: types::Cg, tast::TypedExpr => types::CtVal
typed_expr_to_ct_val = cg, te =>
   te.kind
      [LitInt n] types::CtVal(Int, n)
      [LitStr s] types::CtVal(Str, s)
      [LitFloat f] types::CtVal(Float, f)
      [LitRune r] types::CtVal(Int, r)
      [Var v]
         ct = types::ct_val_bind_find(v.0)
         ct.1
            | ct.0
            |
               ast_e' = typed_expr_to_ast(te)
               res' = match::ctfe_eval(cg, ast_e', types::CtFrames(), 0)
               res'.0
      |
         ast_e' = typed_expr_to_ast(te)
         res' = match::ctfe_eval(cg, ast_e', types::CtFrames(), 0)
         res'.0

compile_mono_fn: types::Cg, String, String, ast::Names, ast::VTypes,
   ast::VInfos, ast::Names, types::CtVals => <>
compile_mono_fn = cg, orig, mono, ct_names, b_vts, b_tis, b_dts, b_ct_vals =>
   types::is_fn_name(cg, mono)
      | <+>
      |
         fd = stmt::fndef_of(cg.fns, orig, 0)
         fd.name == ""
            | <->
            |
               mono_fd = types::FnDef((mono, fd.params, fd.body))
               types::add_fn_def(cg, mono_fd)
               saved_module = cg.current_module
               cg.current_module = types::decl_module(orig, 0)
               ptis' = stmt::fn_signature_param_tis(types::g.pstmts, orig)
               ptypes' = stmt::fn_signature_param_types(cg, types::g.pstmts, orig, 0)
               dtypes' = stmt::fn_signature_param_dtypes(types::g.pstmts, orig)
               ret' = stmt::fn_signature_return(cg, types::g.pstmts, orig, 0)
               ret_ti' = stmt::fn_signature_return_ti(cg, types::g.pstmts, orig, 0)
               saved_ct_n = ?types::g.ct_bind_names
               saved_ct_v_n = ?types::g.ct_val_names
               saved_cg_vars = ?cg.vars
               ?ct_names @ k =>
                  ct = ct_names(k) | _ | ""
                  ct_val = b_ct_vals(k) | _ | types::CtVal(None)
                  ct_val
                     [None]
                        b_vt = b_vts(k) | _ | ast::ValueType(Unknown)
                        b_ti = b_tis(k) | _
                           | ast::TypeInfo(Prim, ast::ValueType(Unknown))
                        b_dt = b_dts(k) | _ | ""
                        ptypes' = subst_mono_vts(ptypes', ptis', ct, b_vt, 0,
                           ast::VTypes())
                        dtypes' = subst_mono_dtypes(dtypes', ptis', ct, b_dt, 0,
                           ast::Names())
                        ptis' = subst_mono_tis(ptis', ct, b_ti, b_vt, 0,
                           ast::VInfos())
                        ret' = subst_mono_ret_vt(ret', ret_ti', ct, b_vt)
                        ret_ti' = subst_mono_ti(ret_ti', ct, b_ti, b_vt)
                        types::ct_bind_push(ct, b_ti)
                     [Int n]
                        types::ct_val_bind_push(ct, ct_val)
                        direct' = llvm::LLVMConstInt(llvm::LLVMInt64Type!, n, 0)
                        cg.vars += types::CgVar((ct, ast::ValueType(Int), <->, "",
                           Addr(0), ast::Names(), Addr(0), <->, <->,
                           ast::VTypes(), direct'))
                     [Str s]
                        types::ct_val_bind_push(ct, ct_val)
                        direct' = stmt::codegen_string_literal(cg, s)
                        cg.vars += types::CgVar((ct, ast::ValueType(Str), <->, "",
                           Addr(0), ast::Names(), Addr(0), <->, <->,
                           ast::VTypes(), direct'))
                     [Float fl]
                        types::ct_val_bind_push(ct, ct_val)
                        direct' = llvm::LLVMConstReal(
                           llvm::LLVMDoubleType!, fl)
                        cg.vars += types::CgVar((ct, ast::ValueType(Float), <->, "",
                           Addr(0), ast::Names(), Addr(0), <->, <->,
                           ast::VTypes(), direct'))
                     [Rec r]
                        types::ct_val_bind_push(ct, ct_val)
                        rec_res = match::ctfe_lower_record(cg, r)
                        cg.vars += types::CgVar((ct, ast::ValueType(Record), <->, "",
                           Addr(0), r.1, Addr(0), <->, <->,
                           cg.last_fvts, rec_res.0))
                     [Map m]
                        types::ct_val_bind_push(ct, ct_val)
                        map_res = match::ctfe_lower_map(cg, m)
                        cg.vars += types::CgVar((ct, ast::ValueType(Map), <->, "",
                           Addr(0), ast::Names(), Addr(0), <->, <->,
                           ast::VTypes(), map_res.0))
               ret_rm = runtime::record_meta_from_ti(cg, ret_ti')
               ret_fvts = types::field_vts(cg, ret_ti')
               ret_dtype0 = ret_ti' [TypeVar tname] tname | ""
               is_rec_ret = ret_ti' [Rec _]
               is_anon_rec = ret_dtype0 == "" && is_rec_ret
               ret_dtype = is_anon_rec
                  |
                     ret_tname = "#ret_" + mono
                     types::has_type_name(cg, ret_tname) | 0 |
                        runtime::add_type_rec(cg, ret_tname, ret_ti', ret_rm.0, ret_rm.1)
                     ret_tname
                  | ret_dtype0
               has_ret_meta = ret_rm.0 != Addr(0) || ret_dtype != ""
               has_ret_meta
                  | stmt::fn_ret_rec_add(cg, mono, ret_rm.0, ret_rm.1,
                     ret_fvts, ret_dtype)
                  | 0
               stmt::codegen_compile_fn(cg, mono_fd, ptypes', dtypes', ptis',
                  ret', ret_ti', <+>, <->, <+>, types::g.pexports)
               cg.vars = stmt::truncate_vars(cg.vars, saved_cg_vars)
               types::ct_bind_pop_to(saved_ct_n)
               types::ct_val_bind_pop_to(saved_ct_v_n)
               cg.current_module = saved_module
               <+>

// A named call (resolved through the fn alias table, then the fninfos).
codegen_eval_named_call: types::Cg, ast::CallExpr => < (Addr, ast::ValueType) | >
codegen_eval_named_call = cg, t =>
   resolved = types::resolve_fn_name(cg, t.fn_name)
   fname' = fn_alias(cg, resolved)
   fname' == "" | fname' = resolved
   ct_name0 = stmt::sig_ct0_name(types::g.pstmts, fname', 0)
   ct_names = split_comma_names(ct_name0)
   ?ct_names > 0
      |
         cps = stmt::fn_signature_cparams(types::g.pstmts, fname')
         val_param_count = stmt::cparams_val_count(cps)
         ct_vals = types::CtVals()
         val_param_count @ v_i =>
            arg_v = t.args(v_i)!!
            ct_res = match::ctfe_eval(cg, arg_v, types::CtFrames(), 0)
            ct_vals += ct_res.0
         cargs' = types::Addrs()
         cavts' = ast::VTypes()
         cadts = ast::Names()
         saved_discard' = cg.discard_result
         cg.discard_result = <->
         n_call_args = ?t.args
         (n_call_args - val_param_count) @ r_i =>
            j = r_i + val_param_count
            av' = t.args(j)!!
            types::init_check_escape(cg, av', t.line, t.col)
            cg.last_type = ""
            aev' = codegen_eval(cg, av')
            cargs' += aev'.0
            cavts' += aev'.1
            dt = types::is_user_type(cg, cg.last_type) | cg.last_type | ""
            cadts += dt
         cg.discard_result = saved_discard'
         runtime_args = slice_exprs_from(t.args, val_param_count)
         tis = stmt::fn_signature_param_tis(types::g.pstmts, fname')
         b_vts = ast::VTypes()
         b_tis = ast::VInfos()
         b_dts = ast::Names()
         b_ct_vals = types::CtVals()
         bkey = {64}
         bkey += fname'
         ?ct_names @ k =>
            ct = ct_names(k) | _ | ""
            cp = stmt::find_cparam(cps, ct)
            is_val_cp = (cp.name != "") &&
               (cp.val_type != ast::ValueType(Type))
            is_val_cp
               |
                  v_idx = stmt::cparam_val_index(cps, ct)
                  ct_val = ct_vals(v_idx) | _ | types::CtVal(None)
                  b_ct_vals += ct_val
                  b_vts += cp.val_type
                  b_tis += cp.type_info
                  b_dts += ""
                  bkey += '$'
                  ct_val
                     [Int n] bkey += str::from_int(n)
                     [Str s] bkey += sanitize_mono_str(s, 0, {16})
                     [Float f] bkey += str::from_float(f)
                     |
                        types::init_error(cg, "E3130", "Compile-time parameter '" +
                           ct + "' is not compile-time evaluable",
                           t.line, t.col)
               |
                  inf = infer_ct_param(cg, tis, runtime_args, cavts',
                     cadts, ct)
                  b_vts += inf.0
                  b_tis += inf.1
                  b_dts += inf.2
                  b_ct_vals += types::CtVal(None)
                  bkey += ('$', ti_to_type_key(cg, inf.1, inf.0, inf.2))
         key = +bkey
         kidx = types::fninfo_index(cg, key)
         kidx < 0
            | compile_mono_fn(cg, fname', key, ct_names, b_vts, b_tis, b_dts,
               b_ct_vals)
            | <+>
         kidx2 = types::fninfo_index(cg, key)
         kidx2 !< 0
            |
               kfi = cg.fninfos(kidx2)!!
               <+ named_call_emit_pre(cg, key, kfi.llvm_fn, kfi.llvm_type,
                  kfi.ret_vt, cargs', cavts') ->
            | <-->
      |
         fidx0 = types::fninfo_index(cg, fname')
         fidx = fidx0 < 0
            |
               stmt::declare_external_fn(cg, fname')
               types::fninfo_index(cg, fname')
            | fidx0
         fidx !< 0
            |
               fi = cg.fninfos(fidx)!!
               codegen_eval_named_call_checked(cg, t, fname', fi.llvm_fn,
                  fi.llvm_type, fi.ret_vt, fi.param_types)
            |
               types::has_fn_name(cg, fname')
                  |
                     cargs' = types::Addrs()
                     cavts' = ast::VTypes()
                     saved_discard' = cg.discard_result
                     cg.discard_result = <->
                     ?t.args @ i =>
                        av' = t.args(i)!!
                        types::init_check_escape(cg, av', t.line, t.col)
                        aev' = codegen_eval(cg, av')
                        cargs' += aev'.0
                        cavts' += aev'.1
                     cg.discard_result = saved_discard'
                     codegen_eval_named_call_lazy(cg, t, fname', cargs', cavts')
                  | codegen_unknown_open_call(cg, t)

// The callee was not compiled yet (lazy model): the args are evaluated and
// their types collected BEFORE compiling the callee, then the call emits
// with the pre-evaluated args (the reference's arg-types-then-compile order).
codegen_eval_named_call_lazy: types::Cg, ast::CallExpr, String, types::Addrs,
   ast::VTypes => < (Addr, ast::ValueType) | >
codegen_eval_named_call_lazy = cg, t, fname, cargs, cavts =>
   stmt::compile_fn_lazy(cg, fname, cavts)
   cg.error
      | <-->
      |
         lidx0 = types::fninfo_index(cg, fname)
         lidx = lidx0 < 0
            |
               stmt::declare_external_fn(cg, fname)
               types::fninfo_index(cg, fname)
            | lidx0
         lidx !< 0
            |
               lfi = cg.fninfos(lidx)!!
               ok_arity = codegen_check_call_arity(cg, t, fname,
                  ?lfi.param_types)
               !ok_arity
                  | <-->
                  |
                     mismatch = codegen_call_mismatch_at(cg, t, fname,
                        lfi.param_types, 0)
                     mismatch < 0
                        | <+ named_call_emit_pre(cg, fname, lfi.llvm_fn,
                           lfi.llvm_type, lfi.ret_vt, cargs, cavts) ->
                        | codegen_named_call_arg_error(cg, t, fname,
                           lfi.param_types, mismatch)
            | <-->

coerce_arg_ptr_int: types::Cg, Addr, Addr, <> => Addr
coerce_arg_ptr_int = cg, av_val, pty, has_fn =>
   pty_k = pty != Addr(0) | llvm::LLVMGetTypeKind(pty) | 0
   av_k = av_val != Addr(0) | llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(av_val)) | 0
   has_fn && (pty_k == 12) && (av_k == 8)
      | llvm::LLVMBuildIntToPtr(cg.builder, av_val, pty, "arg.i2p")
      |
         has_fn && (pty_k == 8) && (av_k == 12)
            | llvm::LLVMBuildPtrToInt(cg.builder, av_val, pty, "arg.p2i")
            | av_val

coerce_ret_ptr_int: types::Cg, Addr, Addr, ast::ValueType => Addr
coerce_ret_ptr_int = cg, bv_val, ret_ll, vt =>
   ret_k = llvm::LLVMGetTypeKind(ret_ll)
   bv_k = llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(bv_val))
   ret_c = ret_k == 8 && bv_k == 8
      | stmt::coerce_int_ext(cg, bv_val, ret_ll, types::is_unsigned_vt(vt))
      | bv_val
   ret_k == 12 && bv_k == 8
      | llvm::LLVMBuildIntToPtr(cg.builder, ret_c, ret_ll, "ret.i2p")
      |
         ret_k == 8 && bv_k == 12
            | llvm::LLVMBuildPtrToInt(cg.builder, ret_c, ret_ll, "ret.p2i")
            | ret_c

named_call_emit_pre: types::Cg, String, Addr, Addr, ast::ValueType, types::Addrs,
   ast::VTypes => (Addr, ast::ValueType)
named_call_emit_pre = cg, fname, fn, fty, ret, args, arg_vts =>
   n = ?args
   buf = {n * 8}
   sb = &buf
   n @ i =>
      a = args(i)!!
      has_fn = fn != Addr(0) && i < llvm::LLVMCountParams(fn)
      pty = has_fn | llvm::LLVMTypeOf(llvm::LLVMGetParam(fn, i)) | Addr(0)
      is_int_p = pty != Addr(0) && (llvm::LLVMGetTypeKind(pty) == 8)
      avt = (arg_vts(i) | _ | ast::ValueType(Unknown))
      av = is_int_p | stmt::coerce_int_ext(cg, a, pty, types::is_unsigned_vt(avt)) | a
      av_null = pty != Addr(0) | llvm::LLVMConstNull(pty) |
         llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0)
      av_val = av != Addr(0) | av | av_null
      a_fin = coerce_arg_ptr_int(cg, av_val, pty, has_fn)
      @[sb + i * 8] = a_fin
   res_name = ret [Unit] "" | "call.res"
   call_target = stmt::is_module_dynamic(cg, fname)
      |
         gptr = stmt::get_or_create_dyn_fn_ptr(cg, fname, fn)
         i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
         llvm::LLVMBuildLoad2(cg.builder, i8p, gptr, "dyn_fn_load")
      | fn
   res = llvm::LLVMBuildCall2(cg.builder, fty, call_target, sb, n, res_name)
   out = ret [Fn] llvm::LLVMBuildIntToPtr(cg.builder, res,
      llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0), "res.ptr") | res
   stmt::apply_call_ret_meta(cg, fname)
   (out, ret)

codegen_unknown_open_call: types::Cg, ast::CallExpr => < (Addr, ast::ValueType) | >
codegen_unknown_open_call = cg, call =>
   types::init_error(cg, "E3040", "Unknown function '" + call.fn_name + "'", 0, 0)
   <-->

codegen_check_call_arity: types::Cg, ast::CallExpr, String, Int => <>
codegen_check_call_arity = cg, t, fname, expected =>
   ?t.args < expected
      |
         types::init_error(cg, "E3023", "Too few arguments to '" + fname +
            "': expected " + str::from_int(expected) + ", got " +
            str::from_int(?t.args), t.line, t.col)
         <->
      |
         ?t.args > expected
            |
               types::init_error(cg, "E3023", "Too many arguments to '" + fname +
                  "': expected " + str::from_int(expected) + ", got " +
                  str::from_int(?t.args), t.line, t.col)
               <->
            | <+>

codegen_eval_named_call_checked: types::Cg, ast::CallExpr, String, Addr, Addr,
   ast::ValueType, ast::VTypes => < (Addr, ast::ValueType) | >
codegen_eval_named_call_checked = cg, t, fname, fn, fty, ret, ptypes =>
   ok_arity = codegen_check_call_arity(cg, t, fname, ?ptypes)
   !ok_arity
      | <-->
      |
         mismatch = codegen_call_mismatch_at(cg, t, fname, ptypes, 0)
         mismatch < 0
            | <+ codegen_eval_named_call_emit(cg, t, fname, fn, fty, ret, ptypes) ->
            | codegen_named_call_arg_error(cg, t, fname, ptypes, mismatch)

eval_named_args_step: types::Cg, ast::CallExpr, String, Addr, <>, ast::VTypes,
   Int, types::Addrs => types::Addrs
eval_named_args_step = cg, t, fname, fn, is_for, ptypes, i, args =>
   i < ?ptypes
      |
         i !< ?t.args
            |
               types::init_error(cg, "E3023", "Too few arguments to '" + fname +
                  "': expected " + str::from_int(?ptypes) + ", got " +
                  str::from_int(?t.args), t.line, t.col)
               args
            |
               pt = (ptypes(i) | _ | ast::ValueType(Unknown))
               av = t.args(i)!!
               types::init_check_escape(cg, av, t.line, t.col)
               saved_discard = cg.discard_result
               cg.discard_result = <->
               ev = codegen_eval(cg, av)
               cg.discard_result = saved_discard
               is_str = is_for && types::is_str_vt(pt)
               is_ptr = is_for && (types::is_ptr_vt(pt) || types::is_ptr_vt(ev.1))
               a1 = is_str
                  | codegen_ensure_nul_terminated(cg, ev.0, "arg.str.ptr")
                  | (is_ptr | clean_untagged_addr(cg, ev.0) | ev.0)
               has_fn = fn != Addr(0) && i < llvm::LLVMCountParams(fn)
               pty = has_fn
                  | llvm::LLVMTypeOf(llvm::LLVMGetParam(fn, i))
                  | Addr(0)
               is_int_p = pty != Addr(0) && (llvm::LLVMGetTypeKind(pty) == 8)
               a2 = is_int_p
                  | stmt::coerce_int_ext(cg, a1, pty, types::is_unsigned_vt(ev.1))
                  | a1
               args += a2
               eval_named_args_step(cg, t, fname, fn, is_for, ptypes,
                  i + 1, args)
      | args

codegen_eval_named_call_emit: types::Cg, ast::CallExpr, String, Addr, Addr,
   ast::ValueType, ast::VTypes => (Addr, ast::ValueType)
codegen_eval_named_call_emit = cg, t, fname, fn, fty, ret, ptypes =>
   is_for = stmt::is_foreign_fn(fname)
   args = eval_named_args_step(cg, t, fname, fn, is_for, ptypes, 0, types::Addrs())
   n = ?args
   buf = {n * 8}
   sb = &buf
   n @ i => @[sb + i * 8] = args(i)!!
   res_name = ret [Unit] "" | "call.res"
   res = llvm::LLVMBuildCall2(cg.builder, fty, fn, sb, n, res_name)
   is_void = ret [Unit]
   is_void
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ret)
      |
         res_w = llvm::LLVMGetIntTypeWidth(llvm::LLVMTypeOf(res))
         needs_sext = is_for && types::is_int_vt(ret) && (res_w < 64)
         sres = needs_sext
            | llvm::LLVMBuildSExt(cg.builder, res, llvm::LLVMInt64Type!,
               "res.i64")
            | res
         out = ret [Fn] llvm::LLVMBuildIntToPtr(cg.builder, sres,
            llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0), "res.ptr") | sres
         stmt::apply_call_ret_meta(cg, fname)
         (out, ret)

is_ram_arg_mismatch: types::Cg, ast::TypeInfo, ast::Expr => <>
is_ram_arg_mismatch = cg, param_ti, arg_expr =>
   param_ti
      [Ram _]
         arg_ti = codegen_ram_type_of_expr(cg, arg_expr)
         arg_ti
            [Ram _] !ram_shape_compatible(cg, param_ti, arg_ti)
            | <->
      | <->

codegen_call_mismatch_at: types::Cg, ast::CallExpr, String, ast::VTypes, Int => Int
codegen_call_mismatch_at = cg, call, fname, ptypes, at =>
   at == ?call.args
      | -1
      |
         ptis = stmt::fn_signature_param_tis(types::g.pstmts, fname)
         param_ti = at < ?ptis | stmt::resolve_ti(cg, ptis(at)!!) |
            ast::TypeInfo(Prim, ast::ValueType(Unknown))
         ram_mismatch = is_ram_arg_mismatch(cg, param_ti,
            call.args(at)!!)
         ram_mismatch
            | at
            |
               actual = types::static_expr_vt(cg, call.args(at)!!)
               expected = (ptypes(at) | _ | ast::ValueType(Unknown))
               is_fn_arg = actual [Fn]
               pn = is_fn_arg | fi_param_name(cg, fname, at) | ""
               has_pn = pn != "" | stmt::param_clo_ty(cg, pn) != Addr(0) | <->
               clo_param = is_fn_arg | has_pn | <->
               clo_param
                  | codegen_call_mismatch_at(cg, call, fname, ptypes, at + 1)
                  |
                     compat = actual == expected ||
                        (types::is_int_vt(actual) && types::is_int_vt(expected)) ||
                        (types::is_int_vt(expected) &&
                           (types::is_ram_vt(actual) || types::is_flag_vt(actual)))
                     mismatch = actual != ast::ValueType(Unknown) &&
                        !types::is_record_vt(actual) &&
                        expected != ast::ValueType(Unknown) && !compat
                     mismatch
                        | at
                        | codegen_call_mismatch_at(cg, call, fname, ptypes,
                           at + 1)

codegen_named_call_arg_error: types::Cg, ast::CallExpr, String, ast::VTypes,
   Int => < (Addr, ast::ValueType) | >
codegen_named_call_arg_error = cg, call, name, ptypes, at =>
   ptis = stmt::fn_signature_param_tis(types::g.pstmts, name)
   param_ti = at < ?ptis | stmt::resolve_ti(cg, ptis(at)!!) |
      ast::TypeInfo(Prim, ast::ValueType(Unknown))
   ram_mismatch = is_ram_arg_mismatch(cg, param_ti,
      call.args(at)!!)
   ram_mismatch
      |
         arg_ti = codegen_ram_type_of_expr(cg, call.args(at)!!)
         types::init_error(cg, "E3148", "Argument " + str::from_int(at + 1) + " to '" +
            name + "' must be a ramification of shape " +
            ram_shape_str(cg, param_ti) + ", got " +
            ram_shape_str(cg, arg_ti) + ".", call.line, call.col)
      |
         expected = (ptypes(at) | _ | ast::ValueType(Unknown))
         actual = types::static_expr_vt(cg, call.args(at)!!)
         meta = fn_value_meta(cg, name)
         meta.declared
            |
               types::init_error(cg, "E3094", "Argument " +
                  str::from_int(at + 1) + " to '" + name + "' must be " +
                  types::value_type_name(expected) + ", got " +
                  types::value_type_name(actual) + ".", call.line, call.col)
            |
               types::init_error(cg, "E3038", "Type mismatch for argument " +
                  str::from_int(at + 1) + " of function '" + name +
                  "': Expected " + types::value_type_name(expected) + ", got " +
                  types::value_type_name(actual), call.line, call.col)
   <-->

// A call through a closure-valued variable ("add5(10)" where add5 holds the
// closure returned by "make_adder(5)"): load the closure's fn_ptr + env_ptr,
// pass the env as the lambda's implicit first param, then the args.
codegen_eval_closure_call: types::Cg, ast::CallExpr, String => (Addr, ast::ValueType)
codegen_eval_closure_call = cg, t, cfn =>
   idx = types::fninfo_index(cg, cfn)
   idx !< 0
      |
         fi = cg.fninfos(idx)!!
         fi.no_capture
            | codegen_closure_call_plain(cg, t, fi.llvm_type, fi.ret_vt, cfn)
            | codegen_closure_call_indirect(cg, t, fi.ret_vt)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

// A closure value is statically just {fn_ptr, env_ptr}; it intentionally
// carries no signature at runtime.  Its env pointer nevertheless determines
// which of the two ABI-compatible static calls is valid: a capturing lambda
// receives env as its first argument, while a named/non-capturing function
// does not.  Keep both call signatures entirely in the generated IR.
codegen_closure_call_indirect_val: types::Cg, ast::CallExpr, Addr,
   ast::ValueType => (Addr, ast::ValueType)
codegen_closure_call_indirect_val = cg, t, clo_val, ret =>
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   clo_t = stmt::closure_struct_type(cg)
   clo_is_ptr = llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(clo_val)) == 12
   clo = clo_is_ptr
      | llvm::LLVMBuildBitCast(cg.builder, clo_val,
         llvm::LLVMPointerType(clo_t, 0), "clo.cast")
      | llvm::LLVMBuildIntToPtr(cg.builder, clo_val,
         llvm::LLVMPointerType(clo_t, 0), "clo.inttoptr")
   fn_gep = llvm::LLVMBuildStructGEP2(cg.builder, clo_t, clo, 0, "clo.fn.gep")
   env_gep = llvm::LLVMBuildStructGEP2(cg.builder, clo_t, clo, 1, "clo.env.gep")
   fptr = llvm::LLVMBuildLoad2(cg.builder, i8p, fn_gep, "clo.fn.load")
   envp = llvm::LLVMBuildLoad2(cg.builder, i8p, env_gep, "clo.env.load")
   saved_discard = cg.discard_result
   cg.discard_result = <->
   arg_vals = types::Addrs()
   ?t.args @ i =>
      av = t.args(i)!!
      arg_vals += codegen_eval(cg, av).0
   cg.discard_result = saved_discard

   n = ?arg_vals
   ret_ll = ret [Fn] i8p | types::llvm_type_of_vt(ret)
   plain_tys = types::Addrs()
   n @ i => plain_tys += llvm::LLVMTypeOf(arg_vals(i)!!)
   plain_ty = stmt::fn_type_n(cg, ret_ll, plain_tys, n)
   cap_tys = types::Addrs()
   cap_tys += i8p
   n @ i => cap_tys += plain_tys(i)!!
   cap_ty = stmt::fn_type_n(cg, ret_ll, cap_tys, n + 1)

   cap_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "clo.cap")
   plain_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "clo.plain")
   merge_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "clo.merge")
   is_cap = llvm::LLVMBuildICmp(cg.builder, 33, envp,
      llvm::LLVMConstNull(i8p), "clo.is_cap")
   llvm::LLVMBuildCondBr(cg.builder, is_cap, cap_bb, plain_bb)

   llvm::LLVMPositionBuilderAtEnd(cg.builder, cap_bb)
   cap_args = types::Addrs()
   cap_args += envp
   n @ i => cap_args += arg_vals(i)!!
   cap_buf = {8 * (n + 1)}
   csb = &cap_buf
   n + 1 @ i => @[csb + i * 8] = cap_args(i)!!
   is_void = ret [Unit]
   cap_name = is_void | "" | "clo.cap.res"
   cap_res = llvm::LLVMBuildCall2(cg.builder, cap_ty, fptr, csb,
      n + 1, cap_name)
   llvm::LLVMBuildBr(cg.builder, merge_bb)

   llvm::LLVMPositionBuilderAtEnd(cg.builder, plain_bb)
   p_sz = n == 0 | 8 | 8 * n
   plain_buf = {p_sz}
   psb = &plain_buf
   n @ i => @[psb + i * 8] = arg_vals(i)!!
   plain_name = is_void | "" | "clo.plain.res"
   plain_res = llvm::LLVMBuildCall2(cg.builder, plain_ty, fptr, psb,
      n, plain_name)
   llvm::LLVMBuildBr(cg.builder, merge_bb)

   llvm::LLVMPositionBuilderAtEnd(cg.builder, merge_bb)
   res = is_void
      | llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0)
      |
         phi = llvm::LLVMBuildPhi(cg.builder, ret_ll, "clo.res")
         stmt::llvm_add_incoming1(cg, phi, cap_res, cap_bb)
         stmt::llvm_add_incoming1(cg, phi, plain_res, plain_bb)
         phi
   stmt::apply_call_ret_meta(cg, cg.last_closure_fn)
   (res, ret)

codegen_closure_call_indirect: types::Cg, ast::CallExpr, ast::ValueType => (Addr, ast::ValueType)
codegen_closure_call_indirect = cg, t, ret =>
   cv = codegen_eval(cg, ast::Expr(Var, t.fn_name))
   codegen_closure_call_indirect_val(cg, t, cv.0, ret)

fn_ret_vt_of_rev: types::Cg, String, Int => ast::ValueType
fn_ret_vt_of_rev = cg, name, i =>
   i < 0
      | ast::ValueType(Unknown)
      |
         fi = cg.fninfos(i)!!
         fi.name == name
            | fi.ret_vt
            | fn_ret_vt_of_rev(cg, name, i - 1)

fn_ret_vt_of: types::Cg, String => ast::ValueType
fn_ret_vt_of = cg, name =>
   fn_ret_vt_of_rev(cg, name, ?cg.fninfos - 1)

codegen_eval_indirect_target_call: types::Cg, ast::CallExpr, Addr,
   ast::ValueType => (Addr, ast::ValueType)
codegen_eval_indirect_target_call = cg, t, base_val, base_vt =>
   fret = cg.last_closure_fn != "" | fn_ret_vt_of(cg, cg.last_closure_fn) |
      ast::ValueType(Unknown)
   ret = fret != ast::ValueType(Unknown)
      | fret
      |
         cg.last_type != ""
            | types::type_name_to_vt(cg.last_type).0
            | ast::ValueType(Unknown)
   t_target = t.fn_target
   target_ret = t_target
      [Call tc]
         (tc.fn_name == "compose" || tc.fn_name == "fp::compose") && ?tc.args > 0
            |
               first_arg = tc.args(0)!!
               fn_name_of_arg = first_arg [Var vn] vn | ""
               fn_name_of_arg != ""
                  | stmt::fn_signature_return(cg, types::g.pstmts, fn_name_of_arg, 0)
                  | ast::ValueType(Unknown)
            |
               (tc.fn_name == "const" || tc.fn_name == "fp::const") && ?tc.args > 0
                  | types::static_expr_vt(cg, tc.args(0)!!)
                  | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)
   ret2 = ret != ast::ValueType(Unknown) | ret | target_ret
   ret2 == ast::ValueType(Unknown)
      | codegen_indirect_fn_return_unknown(cg, t)
      | codegen_closure_call_indirect_val(cg, t, base_val, ret2)

// A call through a NON-CAPTURING closure (a named fn value): the env is
// provably null, so only field 0 is read and the fn is called plainly with
// just the args (the reference's clo.plain shape).
codegen_closure_call_plain: types::Cg, ast::CallExpr, Addr, ast::ValueType,
   String => (Addr, ast::ValueType)
codegen_closure_call_plain = cg, t, fty, ret, cfn =>
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   cv = codegen_eval(cg, ast::Expr(Var, t.fn_name))
   clo_t = stmt::closure_struct_type(cg)
   clo = llvm::LLVMBuildBitCast(cg.builder, cv.0,
      llvm::LLVMPointerType(clo_t, 0), "clo.cast")
   fn_gep = llvm::LLVMBuildStructGEP2(cg.builder, clo_t, clo, 0, "clo.fn.gep")
   fn_ptr = llvm::LLVMBuildLoad2(cg.builder, i8p, fn_gep, "clo.fn.load")
   saved_discard = cg.discard_result
   cg.discard_result = <->
   arg_vals = types::Addrs()
   ?t.args @ i =>
      av = t.args(i)!!
      ev = codegen_eval(cg, av)
      arg_vals += ev.0
   cg.discard_result = saved_discard
   n = ?t.args
   buf = {n * 8}
   sb = &buf
   n @ i => @[sb + i * 8] = arg_vals(i)!!
   typed = llvm::LLVMBuildBitCast(cg.builder, fn_ptr,
      llvm::LLVMPointerType(fty, 0), "clo.plain.fn")
   res_name = ret [Unit] "" | "clo.plain.res"
   res = llvm::LLVMBuildCall2(cg.builder, fty, typed, sb, n, res_name)
   out = ret [Fn] llvm::LLVMBuildIntToPtr(cg.builder, res, i8p, "res.ptr") | res
   stmt::apply_call_ret_meta(cg, cfn)
   (out, ret)

codegen_closure_call_env: types::Cg, ast::CallExpr, Addr, ast::ValueType => (Addr, ast::ValueType)
codegen_closure_call_env = cg, t, fty, ret =>
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   cv = codegen_eval(cg, ast::Expr(Var, t.fn_name))
   clo = llvm::LLVMBuildBitCast(cg.builder, cv.0,
      llvm::LLVMPointerType(stmt::closure_struct_type(cg), 0), "clo.cast")
   fptr = stmt::closure_fn_ptr(cg, clo, "clo.fn.load")
   envp = stmt::closure_env_ptr(cg, clo, "clo.env.load")
   saved_discard = cg.discard_result
   cg.discard_result = <->
   arg_vals = types::Addrs()
   arg_vals += envp
   ?t.args @ i =>
      av = t.args(i)!!
      ev = codegen_eval(cg, av)
      arg_vals += ev.0
   cg.discard_result = saved_discard
   n = ?t.args
   total = n + 1
   buf = {total * 8}
   sb = &buf
   total @ i =>
      @[sb + i * 8] = arg_vals(i)!!
   typed = llvm::LLVMBuildBitCast(cg.builder, fptr,
      llvm::LLVMPointerType(fty, 0), "clo.fn.typed")
   res_name = ret [Unit] "" | "clo.call"
   res = llvm::LLVMBuildCall2(cg.builder, fty, typed, sb, total, res_name)
   cfn = closure_fn_of(cg, t.fn_name)
   cfn != "" | stmt::apply_call_ret_meta(cg, cfn) | 0
   (res, ret)

fn_body_is_choice: ast::FnExpr => <>
fn_body_is_choice = f => f.body [Choice _]

is_match_function_name: types::Cg, String => <>
is_match_function_name = cg, v =>
   fd = stmt::fndef_of(cg.fns, types::resolve_fn_name(cg, v), 0)
   fd.name != "" &&
      fn_body_is_choice(ast::FnExpr((fd.params, ast::Names(), fd.body)))

is_match_function_expr: types::Cg, ast::Expr => <>
is_match_function_expr = cg, e =>
   e
      [Fn f] fn_body_is_choice(f)
      [Var v] is_match_function_name(cg, v)
      | <->

match_feed_choice_ret_vt: types::Cg, ast::ChoiceExpr => ast::ValueType
match_feed_choice_ret_vt = cg, c =>
   ?c.branches > 0
      |
         b0 = c.branches(0)!!
         b_name = stmt::expr_var_name(b0.block)
         b_name != ""
            |
               rf = types::resolve_fn_name(cg, b_name)
               ret = stmt::fn_signature_return(cg, types::g.pstmts, rf, 0)
               ret != ast::ValueType(Unknown) | ret | fn_ret_vt_of(cg, rf)
            | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)

match_feed_return_type: types::Cg, ast::Expr => ast::ValueType
match_feed_return_type = cg, fn_expr =>
   fn_expr
      [Fn f]
         f.body [Choice c] match_feed_choice_ret_vt(cg, c) |
            ast::ValueType(Unknown)
      [Var v]
         fd = stmt::fndef_of(cg.fns, types::resolve_fn_name(cg, v), 0)
         fd.body [Choice c] match_feed_choice_ret_vt(cg, c) |
            ast::ValueType(Unknown)
      | ast::ValueType(Unknown)

codegen_emit_match_feed: types::Cg, ast::Expr, ast::Expr => (Addr, ast::ValueType)
codegen_emit_match_feed = cg, arg_expr, fn_expr =>
   arg_val = codegen_eval(cg, arg_expr)
   tmp_name = "__feed_" + str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   arg_ll = types::llvm_type_of_vt(arg_val.1)
   slot = types::create_slot(cg, tmp_name, arg_ll, cg.in_fn)
   llvm::LLVMBuildStore(cg.builder, arg_val.0, slot)
   cg.vars += types::CgVar((tmp_name, arg_val.1, <->, "", Addr(0), ast::Names(),
      slot, cg.in_fn, <->, ast::VTypes(), Addr(0)))
   tmp_var = ast::Expr(Var, tmp_name)
   callee = apply_callee_name(fn_expr)
   fn_target = callee == "" | fn_expr | ast::Expr(Var, "")
   args1 = ast::Exprs()
   args1 += tmp_var
   c_expr1 = ast::CallExpr((callee, fn_target, args1, 0, 0))
   fn_res = codegen_eval_call(cg, c_expr1)
   !main::is_fn_vt(fn_res.1)
      | fn_res
      |
         args2 = ast::Exprs()
         args2 += tmp_var
         call2 = ast::CallExpr(("", tmp_var, args2, 0, 0))
         ret_vt = match_feed_return_type(cg, fn_expr)
         codegen_closure_call_indirect_val(cg, call2, fn_res.0, ret_vt)

// A call through a higher-order PARAMETER whose closure fn type was inferred
// from the call site: load the param's closure and call via indirect closure
// dispatch (supporting both capturing and non-capturing closures).
codegen_eval_param_call: types::Cg, ast::CallExpr, Addr => (Addr, ast::ValueType)
codegen_eval_param_call = cg, t, fty =>
   pv = codegen_eval(cg, ast::Expr(Var, t.fn_name))
   ret_vt = stmt::param_clo_ret(cg, t.fn_name)
   codegen_closure_call_indirect_val(cg, t, pv.0, ret_vt)

// The i-th parameter name of the named function (from its FnDef).
fi_param_name: types::Cg, String, Int => String
fi_param_name = cg, name, i =>
   fi_param_name_at(cg, name, i, 0)

fi_param_name_at: types::Cg, String, Int, Int => String
fi_param_name_at = cg, name, i, j =>
   n = ?cg.fns
   j == n
      | ""
      |
         fd = cg.fns(j)!!
         fd.name == name
            | fd.params(i)!!
            | fi_param_name_at(cg, name, i, j + 1)

// Whether an expression is a function VALUE (a lambda literal, or a call that
// returns a closure — e.g. "make_adder(5)").
is_fnv_t: ast::Expr => <>
is_fnv_t = e => e [Fn _]

// The compiled lambda's fn name bound to `name` (a closure-valued variable),
// or "".
closure_fn_of: types::Cg, String => String
closure_fn_of = cg, name =>
   closure_fn_of_rev(cg, name, ?cg.closure_vars - 1)

closure_fn_of_rev: types::Cg, String, Int => String
closure_fn_of_rev = cg, name, i =>
   i < 0
      | ""
      |
         cg.closure_vars(i)!! == name
            | cg.closure_tgts(i)!!
            | closure_fn_of_rev(cg, name, i - 1)

// Records a static function-value alias: `name` is a var/param that holds the
// function `target`.
fn_alias_add: types::Cg, String, String => ()
fn_alias_add = cg, name, target =>
   cg.fn_alias_names += name
   cg.fn_alias_tgts += target

// Resolves `name` through the static fn aliases (empty string = not an alias).
fn_alias: types::Cg, String => String
fn_alias = cg, name =>
   fn_alias_at(cg, name, 0)

fn_alias_at: types::Cg, String, Int => String
fn_alias_at = cg, name, i =>
   n = ?cg.fn_alias_names
   i == n
      | ""
      |
         cg.fn_alias_names(i)!! == name
            | cg.fn_alias_tgts(i)!!
            | fn_alias_at(cg, name, i + 1)

// --- runtime skeleton (slice 18) ---------------------------------------------

// The chunked arena struct: { i64 cap, i64 num_chunks, i64 off,
// [4096 x i8*] chunks, i64 gen }.

codegen_typed_eval_logical_evaled: types::Cg, <>, (Addr, ast::ValueType),
   ast::TypeInfo, tast::TypedExpr, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_logical_evaled = cg, is_and, lv, lhs_ti, rhs, ti =>
   lv.0 == Addr(0)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         t0 = types::g.tmpc
         types::g.tmpc = types::g.tmpc + 1
         sc = str::from_int(t0)
         pre = is_and | "and." + sc | "or." + sc
         eff_ti = ti [Unknown, Unit] rhs.ti | ti
         res_vt0 = types::vt_from_ti(eff_ti)
         res_vt = res_vt0 [Unknown, Unit] lv.1 | res_vt0
         res_lt0 = types::is_unboxed_ram_ti(cg, eff_ti)
            | match::unboxed_ram_struct_t(cg)
            | types::llvm_type_of_vt(res_vt)
         res_lt = res_lt0 != Addr(0) | res_lt0 | llvm::LLVMInt1Type!
         then_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, pre + ".then")
         else_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, pre + ".else")
         exit_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, pre + ".exit")
         cond_val = types::codegen_cond_value_with_ti(cg, lv.0, lv.1, lhs_ti)
         llvm::LLVMBuildCondBr(cg.builder, cond_val, then_bb, else_bb)

         llvm::LLVMPositionBuilderAtEnd(cg.builder, then_bb)
         then_val0 = is_and | main::codegen_typed_eval(cg, rhs) | lv
         tv_c = types::is_ram_vt(then_val0.1)
            | match::coerce_ram_repr(cg, then_val0.0, eff_ti)
            | stmt::coerce_int(cg, then_val0.0, res_lt)
         t_end = llvm::LLVMGetInsertBlock(cg.builder)
         t_term = stmt::block_is_terminated(cg)
         !t_term | stmt::branch_to(cg, exit_bb)

         llvm::LLVMPositionBuilderAtEnd(cg.builder, else_bb)
         else_val0 = is_and | lv | main::codegen_typed_eval(cg, rhs)
         ev_c = types::is_ram_vt(else_val0.1)
            | match::coerce_ram_repr(cg, else_val0.0, eff_ti)
            | stmt::coerce_int(cg, else_val0.0, res_lt)
         e_end = llvm::LLVMGetInsertBlock(cg.builder)
         e_term = stmt::block_is_terminated(cg)
         !e_term | stmt::branch_to(cg, exit_bb)

         llvm::LLVMPositionBuilderAtEnd(cg.builder, exit_bb)
         phi = llvm::LLVMBuildPhi(cg.builder, res_lt, pre + ".phi")
         !t_term | stmt::llvm_add_incoming1(cg, phi, tv_c, t_end)
         !e_term | stmt::llvm_add_incoming1(cg, phi, ev_c, e_end)
         (phi, res_vt)

codegen_typed_eval_logical: types::Cg, <>, tast::TypedExpr, tast::TypedExpr,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_logical = cg, is_and, lhs, rhs, ti =>
   codegen_typed_eval_logical_evaled(cg, is_and, main::codegen_typed_eval(cg, lhs),
      lhs.ti, rhs, ti)

resolve_typed_type_value: types::Cg, tast::TypedExpr => (ast::TypeInfo, <>)
resolve_typed_type_value = cg, te =>
   te.kind
      [Var v]
         types::resolve_type_value(cg, ast::Expr(Var, v.0))
      [Member m]
         m.1 == "Type"
            | resolve_typed_type_value(cg, m.0)
            |
               tgt = resolve_typed_type_value(cg, m.0)
               tgt.1
                  |
                     can_ti = types::ctfe_canonical_ti(cg, tgt.0)
                     can_ti
                        [Rec r]
                           idx = m.2
                           idx !< 0 && idx < ?r.0
                              |
                                 fld = r.0(idx)!!
                                 (types::field_type_info(fld), <+>)
                              |
                                 (ast::TypeInfo(Prim,
                                    ast::ValueType(Unknown)), <->)
                        | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                  | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)

codegen_str_tuple_cmp: types::Cg, <>, (Addr, ast::ValueType), tast::TypedExpr,
   (Addr, ast::ValueType), Addr, ast::VTypes => (Addr, ast::ValueType)
codegen_str_tuple_cmp = cg, eq, s_val, rec_te, rec_val, rec_rt, rec_fvts =>
   i64t = llvm::LLVMInt64Type!
   i8t = llvm::LLVMInt8Type!
   i1t = llvm::LLVMInt1Type!
   zero = llvm::LLVMConstInt(i64t, 0, 0)
   parts' = types::Addrs()
   lens' = types::Addrs()
   rec_te.kind
      [Record r_fields]
         ?r_fields @ i =>
            f = r_fields(i) | _ | tast::TypedField(("",
               tast::mk_lit_unit(0, 0), 0, unify::prim_unit()))
            fev = main::codegen_typed_eval(cg, f.val)
            flen = codegen_string_len(cg, fev.0, "seg.len")
            parts' += fev.0
            lens' += flen
      |
         nf = ?rec_fvts
         rec_rt != Addr(0) && nf > 0 |
            nf @ j =>
               fgep = llvm::LLVMBuildStructGEP2(cg.builder, rec_rt,
                  rec_val.0, j, "rec.fld")
               fstr = llvm::LLVMBuildLoad2(cg.builder,
                  llvm::LLVMPointerType(i8t, 0), fgep, "seg.val")
               flen = codegen_string_len(cg, fstr, "seg.len")
               parts' += fstr
               lens' += flen
   nparts = ?parts'
   offsets' = types::Addrs()
   total_len' = zero
   nparts @ k =>
      offsets' += total_len'
      pk_len = lens'(k) | _ | zero
      total_len' = llvm::LLVMBuildAdd(cg.builder, total_len', pk_len,
         "stcmp.tot")
   s_len = codegen_string_len(cg, s_val.0, "stcmp.slen")
   s_data = codegen_string_data(cg, s_val.0, "stcmp.sdata")
   parent = llvm::LLVMGetBasicBlockParent(llvm::LLVMGetInsertBlock(cg.builder))
   len_eq = llvm::LLVMBuildICmp(cg.builder, 32, s_len, total_len',
      "stcmp.len.eq")
   fail_bb = llvm::LLVMAppendBasicBlock(parent, "stcmp.fail")
   succ_bb = llvm::LLVMAppendBasicBlock(parent, "stcmp.succ")
   done_bb = llvm::LLVMAppendBasicBlock(parent, "stcmp.done")
   nparts == 0
      |
         llvm::LLVMBuildCondBr(cg.builder, len_eq, succ_bb, fail_bb)
      |
         seg_bbs = types::Addrs()
         nparts @ s_i =>
            seg_bbs += llvm::LLVMAppendBasicBlock(parent,
               "stcmp.seg." + str::from_int(s_i))
         first_bb = seg_bbs(0) | _ | succ_bb
         llvm::LLVMBuildCondBr(cg.builder, len_eq, first_bb, fail_bb)
         nparts @ s_j =>
            cur_seg_bb = seg_bbs(s_j) | _ | succ_bb
            llvm::LLVMPositionBuilderAtEnd(cg.builder, cur_seg_bb)
            seg_p = parts'(s_j) | _ | Addr(0)
            seg_l = lens'(s_j) | _ | zero
            seg_off = offsets'(s_j) | _ | zero
            s_ptr = types::gep1(cg, i8t, s_data, seg_off, "stcmp.sptr")
            p_data = codegen_string_data(cg, seg_p, "stcmp.pdata")
            cmp_res = types::call3(cg, cg.memcmp_t, cg.memcmp_fn, s_ptr, p_data,
               seg_l, "stcmp.mc")
            is_match = llvm::LLVMBuildICmp(cg.builder, 32, cmp_res,
               llvm::LLVMConstInt(llvm::LLVMInt32Type!, 0, 0), "stcmp.match")
            next_target = s_j + 1 < nparts
               | (seg_bbs(s_j + 1) | _ | succ_bb)
               | succ_bb
            llvm::LLVMBuildCondBr(cg.builder, is_match, next_target, fail_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, fail_bb)
   llvm::LLVMBuildBr(cg.builder, done_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, succ_bb)
   llvm::LLVMBuildBr(cg.builder, done_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, done_bb)
   phi = llvm::LLVMBuildPhi(cg.builder, i1t, "stcmp.res")
   val_succ = eq | llvm::LLVMConstInt(i1t, 1, 0) |
      llvm::LLVMConstInt(i1t, 0, 0)
   val_fail = eq | llvm::LLVMConstInt(i1t, 0, 0) |
      llvm::LLVMConstInt(i1t, 1, 0)
   stmt::llvm_add_incoming1(cg, phi, val_succ, succ_bb)
   stmt::llvm_add_incoming1(cg, phi, val_fail, fail_bb)
   (phi, ast::ValueType(Flag))

codegen_typed_eval_bin: types::Cg, ast::BinaryOp, tast::TypedExpr, tast::TypedExpr,
   unify::UType, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_bin = cg, op, lhs, rhs, ut, ti =>
   is_logical = op [And, Or]
   is_logical
      |
         lv' = main::codegen_typed_eval(cg, lhs)
         l_rt' = cg.last_rt
         l_fvts' = cg.last_fvts
         lhs_arr = is_flag_fixed_record(lv', l_rt', l_fvts')
         lhs_arr
            |
               rv' = main::codegen_typed_eval(cg, rhs)
               r_rt' = cg.last_rt
               r_fvts' = cg.last_fvts
               rhs_arr = is_flag_fixed_record(rv', r_rt', r_fvts')
               codegen_emit_array_logical(cg, op [And],
                  (lv'.0, lv'.1, l_rt', l_fvts', lhs_arr),
                  (rv'.0, rv'.1, r_rt', r_fvts', rhs_arr))
            |
               codegen_typed_eval_logical_evaled(cg, op [And], lv', lhs.ti,
                  rhs, ti)
      |
         is_eq_neq = op [Eq, NotEq]
         lt_res = is_eq_neq
            | resolve_typed_type_value(cg, lhs)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
         rt_res = is_eq_neq && lt_res.1
            | resolve_typed_type_value(cg, rhs)
            | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
         lt_res.1 && rt_res.1
            |
               eq = types::type_info_equal(types::ctfe_canonical_ti(cg, lt_res.0),
                  types::ctfe_canonical_ti(cg, rt_res.0))
               is_ne = op [NotEq]
               flag = is_ne | !eq | eq
               c_flag = llvm::LLVMConstInt(llvm::LLVMInt1Type!,
                  (flag | 1 | 0), 0)
               (c_flag, ast::ValueType(Flag))
            |
               lv' = main::codegen_typed_eval(cg, lhs)
               l_rt' = cg.last_rt
               l_fvts' = cg.last_fvts
               rv' = main::codegen_typed_eval(cg, rhs)
               r_rt' = cg.last_rt
               r_fvts' = cg.last_fvts
               lhs_cmp = is_cmp_fixed_record(lv', l_rt', l_fvts')
               rhs_cmp = is_cmp_fixed_record(rv', r_rt', r_fvts')
               is_cmp_op = op [Lt, Gt, Eq, NotEq, NotLt, NotGt]
               is_eq_op = op [Eq, NotEq]
               l_is_str = types::is_str_vt(lv'.1)
               r_is_str = types::is_str_vt(rv'.1)
               l_is_rec = (lv'.1 [Record]) || (<>(lhs.ti [Rec _]))
               r_is_rec = (rv'.1 [Record]) || (<>(rhs.ti [Rec _]))
               is_str_tuple_lr = is_eq_op && l_is_str && r_is_rec
               is_str_tuple_rl = is_eq_op && r_is_str && l_is_rec
               is_str_tuple_lr
                  | codegen_str_tuple_cmp(cg, op [Eq], lv', rhs, rv',
                     r_rt', r_fvts')
                  |
                     is_str_tuple_rl
                        | codegen_str_tuple_cmp(cg, op [Eq], rv', lhs,
                           lv', l_rt', l_fvts')
                        |
                           is_arr_cmp = is_cmp_op && (lhs_cmp || rhs_cmp)
                           is_arr_cmp
                              | codegen_emit_array_cmp(cg, op,
                                 (lv'.0, lv'.1, l_rt', l_fvts', lhs_cmp),
                                 (rv'.0, rv'.1, r_rt', r_fvts', rhs_cmp))
                              |
                                 lhs_num = is_numeric_fixed_record(lv', l_rt',
                                    l_fvts')
                                 rhs_num = is_numeric_fixed_record(rv', r_rt',
                                    r_fvts')
                                 is_arr_arith = (lhs_num || rhs_num) &&
                                    !is_cmp_op
                                 is_arr_arith
                                    | codegen_emit_array_arith(cg, op,
                                       (lv'.0, lv'.1, l_rt', l_fvts', lhs_num),
                                       (rv'.0, rv'.1, r_rt', r_fvts', rhs_num))
                                    | codegen_typed_eval_bin_arith_evaled(cg,
                                       op, lv', rv', ut, ti)

codegen_typed_eval_bin_arith = cg, op, lhs, rhs, ut, ti =>
   lv = main::codegen_typed_eval(cg, lhs)
   rv = main::codegen_typed_eval(cg, rhs)
   codegen_typed_eval_bin_arith_evaled(cg, op, lv, rv, ut, ti)

codegen_typed_eval_bin_arith_evaled: types::Cg, ast::BinaryOp, (Addr, ast::ValueType),
   (Addr, ast::ValueType), unify::UType, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_bin_arith_evaled = cg, op, lv, rv, ut, ti =>
   lv.0 == Addr(0) || rv.0 == Addr(0)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         op
            [Seq] (rv.0, rv.1)
            [Lt, Gt, Eq, NotEq, NotLt, NotGt]
               match::codegen_emit_cmp_nonmixed(cg, op, lv, rv)
            |
               is_flt = types::is_float_vt(lv.1) || types::is_float_vt(rv.1)
               is_flt
                  |
                     fl_val = coerce_float(cg, lv.0, lv.1)
                     fr_val = coerce_float(cg, rv.0, rv.1)
                     is_l_f32 = lv.1 [F32]
                     is_r_f32 = rv.1 [F32]
                     is_f32 = is_l_f32 && is_r_f32
                     flt_res_vt = is_f32 | ast::ValueType(F32) |
                        ast::ValueType(Float)
                     res_f = codegen_eval_float_arith(cg, op, fl_val, fr_val)
                     (res_f, flt_res_vt)
                  |
                     op
                        [Add]
                           types::is_str_vt(lv.1)
                              |
                                 types::is_str_vt(rv.1)
                                    | (stmt::codegen_string_concat(cg, lv.0, rv.0),
                                       ast::ValueType(Str))
                                    |
                                       types::is_rune_vt(rv.1)
                                          | (stmt::codegen_string_append_rune(cg,
                                             lv.0, rv.0), ast::ValueType(Str))
                                          | (stmt::codegen_string_append_byte(cg,
                                             lv.0, rv.0), ast::ValueType(Str))
                              |
                                 types::is_builder_vt(lv.1)
                                    | main::codegen_builder_pure_append(cg, lv.0,
                                       rv.0, rv.1)
                                    | codegen_typed_eval_bin_arith_default(
                                       cg, op, lv, rv, ti)
                        |
                           codegen_typed_eval_bin_arith_default(cg, op, lv,
                              rv, ti)

codegen_typed_eval_bin_arith_default: types::Cg, ast::BinaryOp,
   (Addr, ast::ValueType), (Addr, ast::ValueType),
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_bin_arith_default = cg, op, lv, rv, ti =>
   is_bit = op [BitAnd, BitOr, Shl, Shr]
   is_bit
      |
         i64t = llvm::LLVMInt64Type!
         ext_l' = stmt::coerce_int_ext(cg, lv.0, i64t, types::is_unsigned_vt(lv.1))
         ext_r' = stmt::coerce_int_ext(cg, rv.0, i64t, types::is_unsigned_vt(rv.1))
         codegen_emit_bitwise_valid(cg, op, ext_l', ext_r')
      |
         l_is_ptr = types::is_ptr_vt(lv.1) || (lv.0 != Addr(0) &&
            llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(lv.0)) == 12)
         r_is_ptr = types::is_ptr_vt(rv.1) || (rv.0 != Addr(0) &&
            llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(rv.0)) == 12)
         l_is_ptr || r_is_ptr
            |
               codegen_eval_ptr_arith(cg, op, lv.0, rv.0, l_is_ptr, r_is_ptr)
            |
               is_u = types::is_unsigned_vt(lv.1) || types::is_unsigned_vt(rv.1)
               res_ty = types::is_ptr_vt(lv.1) | lv.1 |
                  (types::is_ptr_vt(rv.1) | rv.1 | lv.1)
               ret_vt = types::vt_from_ti(ti)
               tgt_vt = ret_vt [Unknown, Unit] res_ty | ret_vt
               tgt_ty0 = types::llvm_type_of_vt(tgt_vt)
               tgt_ty = tgt_ty0 != Addr(0) | tgt_ty0 | llvm::LLVMInt64Type!
               ext_l' = stmt::coerce_int_ext(cg, lv.0, tgt_ty, types::is_unsigned_vt(lv.1))
               ext_r' = stmt::coerce_int_ext(cg, rv.0, tgt_ty, types::is_unsigned_vt(rv.1))
               res_val = codegen_eval_int_arith(cg, op, ext_l', ext_r', is_u)
               (res_val, tgt_vt)

codegen_typed_eval_unary: types::Cg, ast::UnaryOp, tast::TypedExpr, unify::UType,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_unary = cg, op, operand, ut, ti =>
   ev = main::codegen_typed_eval(cg, operand)
   ev.0 == Addr(0)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         op
            [Not]
               (llvm::LLVMBuildNot(cg.builder, ev.0, "nottmp"),
                  ast::ValueType(Flag))
            [BitNot]
               (llvm::LLVMBuildNot(cg.builder, ev.0, "bitnottmp"), ev.1)
            [Length]
               operand.ti
                  [Rec r]
                     r.1
                        |
                           codegen_eval_unary_len(cg, ev.0,
                              ast::ValueType(Slice))
                        |
                           (llvm::LLVMConstInt(llvm::LLVMInt64Type!, ?r.0, 0),
                              ast::ValueType(Int))
                  | codegen_eval_unary_len(cg, ev.0, ev.1)
            [RuneCount] stmt::codegen_eval_string_rune_count(cg, ev.0)
            [Freeze]
               (main::codegen_builder_freeze(cg, ev.0, "builder.freeze"),
                  ast::ValueType(Str))
            [AddrOf]
               ptr_raw = ev.1
                  [Builder] main::builder_data(cg, ev.0, "b.ptr")
                  [Str] codegen_string_data(cg, ev.0, "s.ptr")
                  | Addr(0)
               ptr_raw == Addr(0)
                  | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
                  | (tag_addr_with_arena_gen(cg, ptr_raw),
                     ast::ValueType(RawPtr))
            [Unwrap]
               ret_vt' = types::vt_from_ti_cg(cg, ti)
               niche' = types::is_niche_ram_ti(cg, operand.ti)
               is_niche' = niche'.0
               is_unboxed' = !is_niche' && types::is_unboxed_ram_ti(cg, operand.ti)
               i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
               t0' = types::g.tmpc
               types::g.tmpc = types::g.tmpc + 1
               sc' = str::from_int(t0')
               pos_bb' = llvm::LLVMAppendBasicBlock(cg.current_fn,
                  "unwrap.pos." + sc')
               abort_bb = llvm::LLVMAppendBasicBlock(cg.current_fn,
                  "unwrap.abort." + sc')
               is_pos' = is_niche'
                  |
                     llvm::LLVMBuildICmp(cg.builder, 33, ev.0,
                        llvm::LLVMConstNull(llvm::LLVMTypeOf(ev.0)),
                        "unwrap.is_pos")
                  |
                     is_unboxed'
                        | llvm::LLVMBuildExtractValue(cg.builder, ev.0, 0,
                           "unwrap.is_pos")
                        |
                           tag_gep' = llvm::LLVMBuildStructGEP2(cg.builder,
                              cg.union_t, ev.0, 0, "unwrap.tag.gep")
                           tag = llvm::LLVMBuildLoad2(cg.builder,
                              llvm::LLVMInt64Type!, tag_gep', "unwrap.tag")
                           one' = llvm::LLVMConstInt(llvm::LLVMInt64Type!, 1, 0)
                           llvm::LLVMBuildICmp(cg.builder, 32, tag, one',
                              "unwrap.is_pos")
               llvm::LLVMBuildCondBr(cg.builder, is_pos', pos_bb', abort_bb)
               llvm::LLVMPositionBuilderAtEnd(cg.builder, abort_bb)
               is_niche'
                  |
                     runtime::emit_abort_msg(cg,
                        "E4007: unwrap on empty or error ramification\n",
                        "unwrap_abort_msg")
                     llvm::LLVMBuildUnreachable(cg.builder)
                  |
                     is_unboxed'
                        |
                           err_raw = llvm::LLVMBuildExtractValue(cg.builder,
                              ev.0, 1, "unwrap.pay.abort")
                           err_p = llvm::LLVMBuildIntToPtr(cg.builder,
                              err_raw, i8p, "err.ptr")
                           main::codegen_emit_error_panic(cg, err_p)
                        |
                           main::codegen_emit_error_panic(cg, match::union_pay_ptr(cg, ev.0))
               llvm::LLVMPositionBuilderAtEnd(cg.builder, pos_bb')
               res_val' = is_niche'
                  | ev.0
                  |
                     is_unboxed'
                        | match::convert_unboxed_pay(cg, llvm::LLVMBuildExtractValue(
                           cg.builder, ev.0, 1, "unwrap.pay.pos"), ret_vt')
                        | unwrap_pay_value(cg, match::union_pay_ptr(cg, ev.0), ret_vt')
               (res_val', ret_vt')
            [Propagate]
               ret_vt' = types::vt_from_ti_cg(cg, ti)
               niche' = types::is_niche_ram_ti(cg, operand.ti)
               is_niche' = niche'.0
               is_unboxed' = !is_niche' && types::is_unboxed_ram_ti(cg, operand.ti)
               t0' = types::g.tmpc
               types::g.tmpc = types::g.tmpc + 1
               sc' = str::from_int(t0')
               pos_bb' = llvm::LLVMAppendBasicBlock(cg.current_fn,
                  "prop.pos." + sc')
               ret_bb = llvm::LLVMAppendBasicBlock(cg.current_fn,
                  "prop.ret." + sc')
               is_pos' = is_niche'
                  |
                     llvm::LLVMBuildICmp(cg.builder, 33, ev.0,
                        llvm::LLVMConstNull(llvm::LLVMTypeOf(ev.0)),
                        "prop.is_pos")
                  |
                     is_unboxed'
                        | llvm::LLVMBuildExtractValue(cg.builder, ev.0, 0,
                           "prop.is_pos")
                        |
                           tag_gep' = llvm::LLVMBuildStructGEP2(cg.builder,
                              cg.union_t, ev.0, 0, "prop.tag.gep")
                           tag = llvm::LLVMBuildLoad2(cg.builder,
                              llvm::LLVMInt64Type!, tag_gep', "prop.tag")
                           one' = llvm::LLVMConstInt(llvm::LLVMInt64Type!, 1, 0)
                           llvm::LLVMBuildICmp(cg.builder, 32, tag, one',
                              "prop.is_pos")
               llvm::LLVMBuildCondBr(cg.builder, is_pos', pos_bb', ret_bb)
               llvm::LLVMPositionBuilderAtEnd(cg.builder, ret_bb)
               llvm::LLVMBuildRet(cg.builder, ev.0)
               llvm::LLVMPositionBuilderAtEnd(cg.builder, pos_bb')
               res_val' = is_niche'
                  | ev.0
                  |
                     is_unboxed'
                        | match::convert_unboxed_pay(cg, llvm::LLVMBuildExtractValue(
                           cg.builder, ev.0, 1, "prop.pay.pos"), ret_vt')
                        | unwrap_pay_value(cg, match::union_pay_ptr(cg, ev.0), ret_vt')
               (res_val', ret_vt')
            | (ev.0, ev.1)

codegen_typed_eval_member: types::Cg, tast::TypedExpr, String, Int,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_member = cg, target, fname, idx, ti =>
   idx == -2
      | codegen_eval_swizzle(cg, target, fname, ti)
      | codegen_typed_eval_member_normal(cg, target, fname, idx, ti)

codegen_typed_eval_member_normal: types::Cg, tast::TypedExpr, String, Int,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_member_normal = cg, target, fname, idx, ti =>
   is_v = target.kind [Var _]
   vname = is_v | (target.kind [Var v] v.0 | "") | ""
   has_var = vname != "" && (<>(types::var_slot(cg, vname)) || <>(types::var_direct(cg, vname)))
   ct = !has_var && vname != ""
      | types::ct_bind_find(vname)
      | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
   is_ut = !has_var && vname != "" && types::is_user_type(cg, vname)
   is_type_ref = (ct.1 || is_ut) && fname == "" && idx !< 0
   is_type_ref
      |
         tname = ct.1
            |
               ct.0 [TypeVar tvar] tvar | ""
            | ""
         ct_ti = tname != "" && types::is_user_type(cg, tname)
            | types::typedef_ti(cg, tname)
            |
               ct.1
                  | ct.0
                  | types::typedef_ti(cg, vname)
         can_ti = types::ctfe_canonical_ti(cg, ct_ti)
         can_ti
            [Rec r]
               idx !< 0 && idx < ?r.0
                  |
                     f = r.0(idx)!!
                     lbl = f.name != "" | f.name | str::from_int(idx)
                     (stmt::codegen_string_literal(cg, lbl), ast::ValueType(Str))
                  | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            [Enum slots]
               idx !< 0 && idx < ?slots
                  |
                     lbl = match::ti_enum_slot_label(can_ti, idx)
                     (stmt::codegen_string_literal(cg, lbl), ast::ValueType(Str))
                  | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         tv = main::codegen_typed_eval(cg, target)
         tv.0 == Addr(0)
            | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               tgt_ti = types::typed_member_target_ti(cg, target)
               bf_opt = types::ti_get_bitfield(cg, tgt_ti)
               bf_opt
                  | bfi =>
                     bf_fld = types::find_bitfield_field(bfi.fields, fname)
                     bf_fld
                        | bf =>
                           bty = types::llvm_type_of_vt(bfi.backing_type)
                           bf_ptr = vname != ""
                              | (types::var_slot(cg, vname) | _ | tv.0)
                              | tv.0
                           raw_val = llvm::LLVMBuildLoad2(cg.builder, bty,
                              bf_ptr, "bf.load")
                           sh = bf.bit_offset > 0
                              | llvm::LLVMBuildLShr(cg.builder, raw_val,
                                 llvm::LLVMConstInt(bty, bf.bit_offset, 0),
                                 "bf.shr")
                              | raw_val
                           fmask = (1 .<. bf.bit_width) - 1
                           masked = llvm::LLVMBuildAnd(cg.builder, sh,
                              llvm::LLVMConstInt(bty, fmask, 0), "bf.mask")
                           ext = llvm::LLVMBuildZExt(cg.builder, masked,
                              llvm::LLVMInt64Type!, "bf.ext")
                           (ext, ast::ValueType(Int))
                        | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
                  |
                     rm = runtime::record_meta_from_ti(cg, tgt_ti)
                     rm0 = rm.0 != Addr(0) | rm | runtime::record_meta_from_ti(cg, target.ti)
                     is_m = target.kind [Member _]
                     st_from_var = vname != ""
                        | (types::var_rt(cg, vname) | _ | Addr(0))
                        | Addr(0)
                     st0 = is_m && cg.last_rt != Addr(0) | cg.last_rt | st_from_var
                     st = rm0.0 != Addr(0) | rm0.0 | st0
                     fn_src0 = is_m && ?cg.last_fnames > 0
                        | cg.last_fnames
                        | (vname != "" | types::var_fnames(cg, vname) | ast::Names())
                     fn_src = ?rm0.1 > 0 | rm0.1 | fn_src0
                     lookup_idx = fname != "" && ?fn_src > 0
                        |
                           n_idx = types::member_index(fn_src, fname)
                           n_idx !< 0 | n_idx | idx
                        | idx
                     st != Addr(0) && llvm::LLVMGetTypeKind(st) == 10
                        |
                           fgep = llvm::LLVMBuildStructGEP2(cg.builder, st, tv.0,
                              lookup_idx, "fld.gep")
                           fld_ti = types::record_field_ti_by_name(cg, tgt_ti, fname)
                           eff_ti = fld_ti [Prim p_unk]
                              p_unk [Unknown] ti | fld_ti
                           | fld_ti
                           vt = types::vt_from_ti_cg(cg, eff_ti)
                           bf_sub = types::ti_get_bitfield(cg, eff_ti)
                           is_rec = (vt [Record]) || <>(bf_sub)
                           is_rec
                              |
                                 sub_st = llvm::LLVMStructGetTypeAtIndex(st,
                                    lookup_idx)
                                 cg.last_rt = sub_st
                                 bf_sub
                                    | bfi_s =>
                                       cg.last_fnames = runtime::record_meta_from_ti(
                                          cg, eff_ti).1
                                       (fgep, vt)
                                    |
                                       td_name = types::typedef_name_of_rt(cg, sub_st)
                                       td_fn' = ast::Names()
                                       td_name != ""
                                          | td_fn' = types::td_record_meta_by_name(cg, td_name).1
                                          | 0
                                       sub_m = runtime::record_meta_from_ti(cg, ti)
                                       fn_to_use = ?td_fn' > 0 | td_fn' | sub_m.1
                                       ?fn_to_use > 0
                                          | cg.last_fnames = fn_to_use
                                          | cg.last_fnames = ast::Names()
                                       (fgep, vt)
                              |
                                 ty = types::llvm_type_of_vt(vt)
                                 val = llvm::LLVMBuildLoad2(
                                    cg.builder, ty, fgep, "fld.load")
                                 (val, vt)
                        | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

builder_append_rec_flds: types::Cg, Addr, Addr, Addr => ()
builder_append_rec_flds = cg, b_val, base_ptr, vrt =>
   nf = llvm::LLVMCountStructElementTypes(vrt)
   nf @ vi =>
      elem_ty = llvm::LLVMStructGetTypeAtIndex(vrt, vi)
      fgep = llvm::LLVMBuildStructGEP2(cg.builder, vrt, base_ptr, vi,
         "b.rec.fld")
      elem_val = llvm::LLVMBuildLoad2(cg.builder, elem_ty, fgep,
         "b.rec.elem")
      main::codegen_builder_append_byte(cg, b_val, elem_val)

builder_typed_append_rec_lens: types::Cg, tast::TypedFields, Int, Int, types::Addrs,
   ast::VTypes, types::Addrs, Addr => (types::Addrs, ast::VTypes, types::Addrs, Addr)
builder_typed_append_rec_lens = cg, fields, i, n, vals, vts, lens, total_add =>
   i == n
      | (vals, vts, lens, total_add)
      |
         rf = fields(i) | _ | tast::TypedField(("",
            tast::mk_lit_unit(0, 0), 0, unify::prim_unit()))
         ev = main::codegen_typed_eval(cg, rf.val)
         is_str = types::is_str_vt(ev.1)
         one = llvm::LLVMConstInt(llvm::LLVMInt64Type!, 1, 0)
         flen = is_str | codegen_string_len(cg, ev.0, "b.str.len") | one
         next_vals = vals
         next_vals += ev.0
         next_vts = vts
         next_vts += ev.1
         next_lens = lens
         next_lens += flen
         next_add = llvm::LLVMBuildAdd(cg.builder, total_add, flen,
            "b.add.len")
         builder_typed_append_rec_lens(cg, fields, i + 1, n, next_vals,
            next_vts, next_lens, next_add)

codegen_typed_builder_append_record: types::Cg, Addr, tast::TypedFields => ()
codegen_typed_builder_append_record = cg, b_val, fields =>
   nf = ?fields
   nf == 0
      | 0
      |
         zero = llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0)
         res = builder_typed_append_rec_lens(cg, fields, 0, nf, types::Addrs(),
            ast::VTypes(), types::Addrs(), zero)
         vals = res.0
         vts = res.1
         lens = res.2
         total_add = res.3
         cur_len = main::builder_len(cg, b_val, "b.rec.cur.len")
         new_len = stmt::codegen_add_checked_u64(cg, cur_len, total_add,
            "b.rec.new.len")
         main::codegen_builder_ensure_cap(cg, b_val, new_len)
         bdata = main::builder_data(cg, b_val, "b.rec.data")
         main::builder_append_rec_emit(cg, vals, vts, lens, bdata, cur_len, 0, nf)
         zero_i8 = llvm::LLVMConstInt(llvm::LLVMInt8Type!, 0, 0)
         llvm::LLVMBuildStore(cg.builder, zero_i8,
            types::gep1(cg, llvm::LLVMInt8Type!, bdata, new_len, "b.rec.nul"))
         main::builder_set_len(cg, b_val, new_len)

codegen_typed_builder_append: types::Cg, Addr, tast::TypedExpr => ()
codegen_typed_builder_append = cg, b_val, val =>
   val.kind
      [Bin b]
         is_add = b.0 [Add]
         val_is_str = types::is_str_vt(types::vt_from_ti_cg(cg, val.ti))
         is_add && val_is_str
            |
               codegen_typed_builder_append(cg, b_val, b.1)
               codegen_typed_builder_append(cg, b_val, b.2)
            |
               ev_bin = main::codegen_typed_eval(cg, val)
               main::codegen_builder_append_byte(cg, b_val, ev_bin.0)
      [LitStr s]
         main::codegen_builder_append_str(cg, b_val, stmt::codegen_string_literal(cg, s))
      [LitInt n]
         main::codegen_builder_append_byte(cg, b_val,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, n, 0))
      [LitRune n]
         main::codegen_builder_append_rune(cg, b_val,
            llvm::LLVMConstInt(llvm::LLVMInt64Type!, n, 0))
      [Record r]
         codegen_typed_builder_append_record(cg, b_val, r)
      |
         ev = main::codegen_typed_eval(cg, val)
         is_s = ev.1 [Str]
         is_s
            | main::codegen_builder_append_str(cg, b_val, ev.0)
            |
               is_rec = ev.1 [Record]
               is_rec
                  |
                     val.kind
                        [Var v]
                           types::var_rt(cg, v.0)
                              | vrt => builder_append_rec_flds(cg, b_val,
                                 ev.0, vrt)
                              | 0
                        | 0
                  |
                     types::is_rune_vt(ev.1) || types::is_rune_vt(types::vt_from_ti_cg(cg, val.ti))
                        | main::codegen_builder_append_rune(cg, b_val, ev.0)
                        | main::codegen_builder_append_byte(cg, b_val, ev.0)

codegen_typed_eval_fn_call: types::Cg, String, tast::TypedExprs,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_fn_call = cg, fname, args, ti =>
   rname = types::resolve_fn_name(cg, fname)
   nargs = ?args
   ct_name0 = stmt::sig_ct0_name(types::g.pstmts, rname, 0)
   ct_names = split_comma_names(ct_name0)
   is_generic = ?ct_names > 0
   is_generic
      |
         cps = stmt::fn_signature_cparams(types::g.pstmts, rname)
         val_param_count = stmt::cparams_val_count(cps)
         ct_vals = types::CtVals()
         val_param_count @ v_i =>
            arg_v = args(v_i) | _ | tast::mk_lit_unit(0, 0)
            arg_ct_val = typed_expr_to_ct_val(cg, arg_v)
            ct_vals += arg_ct_val
         cargs' = types::Addrs()
         cavts' = ast::VTypes()
         catis' = ast::VInfos()
         param_tys' = types::Addrs()
         is_for' = stmt::is_foreign_fn(fname)
         (nargs - val_param_count) @ r_i =>
            j = r_i + val_param_count
            arg_e' = args(j) | _ | tast::mk_lit_unit(0, 0)
            aev' = main::codegen_typed_eval(cg, arg_e')
            is_str' = is_for' && types::is_str_vt(aev'.1)
            is_ptr' = is_for' && types::is_ptr_vt(aev'.1)
            a0' = is_str'
               | codegen_ensure_nul_terminated(cg, aev'.0, "arg.str.ptr")
               | (is_ptr' | clean_untagged_addr(cg, aev'.0) | aev'.0)
            a1' = a0' != Addr(0) | a0' | llvm::LLVMConstNull(
               types::llvm_type_of_vt(aev'.1))
            cargs' += a1'
            cavts' += aev'.1
            catis' += arg_e'.ti
            param_tys' += llvm::LLVMTypeOf(a1')
         tis = stmt::fn_signature_param_tis(types::g.pstmts, rname)
         b_vts = ast::VTypes()
         b_tis = ast::VInfos()
         b_dts = ast::Names()
         b_ct_vals = types::CtVals()
         bkey = {64}
         bkey += rname
         ?ct_names @ k =>
            ct = ct_names(k) | _ | ""
            cp = stmt::find_cparam(cps, ct)
            is_val_cp = (cp.name != "") &&
               (cp.val_type != ast::ValueType(Type))
            is_val_cp
               |
                  v_idx = stmt::cparam_val_index(cps, ct)
                  ct_val = ct_vals(v_idx) | _ | types::CtVal(None)
                  b_ct_vals += ct_val
                  b_vts += cp.val_type
                  b_tis += cp.type_info
                  b_dts += ""
                  bkey += '$'
                  ct_val
                     [Int n] bkey += str::from_int(n)
                     [Str s] bkey += sanitize_mono_str(s, 0, {16})
                     [Float f] bkey += str::from_float(f)
                     |
                        types::init_error(cg, "E3130", "Compile-time parameter '" +
                           ct + "' is not compile-time evaluable", 0, 0)
               |
                  extracted = extract_ct_from_tis(cg, tis, catis', ct)
                  fallback = infer_ct_param(cg, tis, ast::Exprs(), cavts',
                     ast::Names(), ct)
                  inf = extracted | _ | fallback
                  real_vt = inf.0
                  real_ti = inf.1
                  real_dt = inf.2
                  b_vts += real_vt
                  b_tis += real_ti
                  b_dts += real_dt
                  b_ct_vals += types::CtVal(None)
                  bkey += ('$', ti_to_type_key(cg, real_ti, real_vt, real_dt))
         key = +bkey
         kidx = types::fninfo_index(cg, key)
         kidx < 0
            | compile_mono_fn(cg, rname, key, ct_names, b_vts, b_tis, b_dts,
               b_ct_vals)
            | <+>
         kidx2 = types::fninfo_index(cg, key)
         kidx2 !< 0
            |
               kfi = cg.fninfos(kidx2)!!
               named_call_emit_pre(cg, key, kfi.llvm_fn, kfi.llvm_type,
                  kfi.ret_vt, cargs', cavts')
            | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         cargs' = types::Addrs()
         cavts' = ast::VTypes()
         catis' = ast::VInfos()
         param_tys' = types::Addrs()
         is_for' = stmt::is_foreign_fn(fname)
         nargs @ j =>
            arg_e' = args(j) | _ | tast::mk_lit_unit(0, 0)
            aev' = main::codegen_typed_eval(cg, arg_e')
            is_str' = is_for' && types::is_str_vt(aev'.1)
            is_ptr' = is_for' && types::is_ptr_vt(aev'.1)
            a0' = is_str'
               | codegen_ensure_nul_terminated(cg, aev'.0, "arg.str.ptr")
               | (is_ptr' | clean_untagged_addr(cg, aev'.0) | aev'.0)
            a1' = a0' != Addr(0) | a0' | llvm::LLVMConstNull(
               types::llvm_type_of_vt(aev'.1))
            cargs' += a1'
            cavts' += aev'.1
            catis' += arg_e'.ti
            param_tys' += llvm::LLVMTypeOf(a1')
         fidx0 = types::fninfo_index(cg, rname)
         fidx1 = fidx0 < 0 | types::fninfo_index(cg, fname) | fidx0
         fidx2 = fidx1 < 0
            |
               stmt::compile_typed_fn_lazy(cg, fname)
               stmt::compile_fn_lazy(cg, fname, ast::VTypes())
               f2 = types::fninfo_index(cg, rname)
               f2 < 0 | types::fninfo_index(cg, fname) | f2
            | fidx1
         fidx3 = fidx2 < 0
            |
               stmt::declare_external_fn(cg, rname)
               stmt::declare_external_fn(cg, fname)
               f3 = types::fninfo_index(cg, rname)
               f3 < 0 | types::fninfo_index(cg, fname) | f3
            | fidx2
         fn_target = fidx3 !< 0
            |
               fi = cg.fninfos(fidx3)!!
               (fi.llvm_fn, fi.llvm_type)
            |
               fn_target_opt = types::llvm_find_function(cg.module, rname)
                  | f => <+ (f, Addr(0)) ->
                  |
                     types::llvm_find_function(cg.module, fname)
                        | f => <+ (f, Addr(0)) ->
                        | <-->
               fn_target_val = fn_target_opt
                  | _
                  | (Addr(0), Addr(0))
               fn_target_val
         fn_val = fn_target.0
         fty0 = fn_target.1
         fn_val == Addr(0)
            |
               types::init_error(cg, "E3004", "Undefined function '" + fname +
                  "'", 0, 0)
               (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               known_ret = fidx3 !< 0 | cg.fninfos(fidx3)!!.ret_vt |
                  ast::ValueType(Unknown)
               ret_vt = known_ret != ast::ValueType(Unknown)
                  | known_ret
                  | types::vt_from_ti_cg(cg, ti)
               ret_ty = types::is_unboxed_ram_ti(cg, ti)
                  | match::unboxed_ram_struct_t(cg)
                  | types::llvm_type_of_vt(ret_vt)
               fty = fty0 == Addr(0)
                  | stmt::fn_type_n(cg, ret_ty, param_tys', nargs)
                  | fty0
               named_call_emit_pre(cg, fname, fn_val, fty, ret_vt,
                  cargs', cavts')

codegen_typed_eval_indirect_call: types::Cg, Addr, tast::TypedExprs,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_indirect_call = cg, clo_val, args, ti =>
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   clo_t = stmt::closure_struct_type(cg)
   clo_is_ptr = llvm::LLVMGetTypeKind(llvm::LLVMTypeOf(clo_val)) == 12
   clo = clo_is_ptr
      | llvm::LLVMBuildBitCast(cg.builder, clo_val,
         llvm::LLVMPointerType(clo_t, 0), "clo.cast")
      | llvm::LLVMBuildIntToPtr(cg.builder, clo_val,
         llvm::LLVMPointerType(clo_t, 0), "clo.inttoptr")
   fn_gep = llvm::LLVMBuildStructGEP2(cg.builder, clo_t, clo, 0, "clo.fn.gep")
   env_gep = llvm::LLVMBuildStructGEP2(cg.builder, clo_t, clo, 1,
      "clo.env.gep")
   fptr = llvm::LLVMBuildLoad2(cg.builder, i8p, fn_gep, "clo.fn.load")
   envp = llvm::LLVMBuildLoad2(cg.builder, i8p, env_gep, "clo.env.load")

   arg_vals = types::Addrs()
   ?args @ i =>
      av = args(i)!!
      arg_vals += (main::codegen_typed_eval(cg, av)).0

   n = ?arg_vals
   ret_vt = types::vt_from_ti(ti)
   is_void = ret_vt [Unit]
   ret_ll = is_void
      | llvm::LLVMVoidType!
      |
         types::is_unboxed_ram_ti(cg, ti)
            | match::unboxed_ram_struct_t(cg)
            | types::llvm_type_of_vt(ret_vt)
   plain_tys = types::Addrs()
   n @ i => plain_tys += llvm::LLVMTypeOf(arg_vals(i)!!)
   plain_ty = stmt::fn_type_n(cg, ret_ll, plain_tys, n)
   cap_tys = types::Addrs()
   cap_tys += i8p
   n @ i => cap_tys += plain_tys(i)!!
   cap_ty = stmt::fn_type_n(cg, ret_ll, cap_tys, n + 1)

   cap_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "clo.cap")
   plain_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "clo.plain")
   merge_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "clo.merge")
   is_cap = llvm::LLVMBuildICmp(cg.builder, 33, envp,
      llvm::LLVMConstNull(i8p), "clo.is_cap")
   llvm::LLVMBuildCondBr(cg.builder, is_cap, cap_bb, plain_bb)

   llvm::LLVMPositionBuilderAtEnd(cg.builder, cap_bb)
   cap_args = types::Addrs()
   cap_args += envp
   n @ i => cap_args += arg_vals(i)!!
   cap_buf = {8 * (n + 1)}
   csb = &cap_buf
   n + 1 @ i => @[csb + i * 8] = cap_args(i)!!
   cap_name = is_void | "" | "clo.cap.res"
   cap_res = llvm::LLVMBuildCall2(cg.builder, cap_ty, fptr, csb,
      n + 1, cap_name)
   llvm::LLVMBuildBr(cg.builder, merge_bb)

   llvm::LLVMPositionBuilderAtEnd(cg.builder, plain_bb)
   p_sz = n == 0 | 8 | 8 * n
   plain_buf = {p_sz}
   psb = &plain_buf
   n @ i => @[psb + i * 8] = arg_vals(i)!!
   plain_name = is_void | "" | "clo.plain.res"
   plain_res = llvm::LLVMBuildCall2(cg.builder, plain_ty, fptr, psb,
      n, plain_name)
   llvm::LLVMBuildBr(cg.builder, merge_bb)

   llvm::LLVMPositionBuilderAtEnd(cg.builder, merge_bb)
   res = is_void
      | llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0)
      |
         phi = llvm::LLVMBuildPhi(cg.builder, ret_ll, "clo.res")
         stmt::llvm_add_incoming1(cg, phi, cap_res, cap_bb)
         stmt::llvm_add_incoming1(cg, phi, plain_res, plain_bb)
         phi
   is_rec_ret = ret_vt [Record]
   is_rec_ret
      |
         rm = runtime::record_meta_from_ti(cg, ti)
         cg.last_rt = rm.0
         cg.last_fnames = rm.1
         cg.last_fvts = types::field_vts(cg, ti)
      | 0
   (res, ret_vt)

codegen_typed_eval_addr: types::Cg, tast::TypedExprs => (Addr, ast::ValueType)
codegen_typed_eval_addr = cg, args =>
   ?args == 0
      | (llvm::LLVMConstNull(
         llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)), ast::ValueType(RawPtr))
      |
         arg = args(0) | _ | tast::mk_lit_unit(0, 0)
         vname = arg.kind [Var v] v.0 | ""
         v_slot = vname != "" | types::var_slot(cg, vname) | <-->
         i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
         v_slot
            | slot => (slot, ast::ValueType(RawPtr))
            |
               ev = main::codegen_typed_eval(cg, arg)
               p_val = types::raw_addr_value(cg, ev.0, ev.1, i8p)
               (p_val, ast::ValueType(RawPtr))
codegen_typed_eval_exit: types::Cg, tast::TypedExpr => (Addr, ast::ValueType)
codegen_typed_eval_exit = cg, e =>
   ev = main::codegen_typed_eval(cg, e)
   types::is_int_vt(ev.1)
      |
         i32t = llvm::LLVMInt32Type!
         tr = llvm::LLVMBuildTrunc(cg.builder, ev.0, i32t, "exit.code")
         cg.opts.no_runtime
            |
               code_g = llvm::LLVMAddGlobal(cg.module, i32t, "dva_exit_code")
               llvm::LLVMSetInitializer(code_g, llvm::LLVMConstInt(i32t, 0, 0))
               llvm::LLVMBuildStore(cg.builder, tr, code_g)
               llvm::LLVMBuildUnreachable(cg.builder)
               cg.exited = <+>
               dead' = llvm::LLVMAppendBasicBlock(cg.current_fn, "exit.halt")
               llvm::LLVMPositionBuilderAtEnd(cg.builder, dead')
            |
               runtime::emit_arena_destroy(cg)
               eargs = {16}
               esb = &eargs
               @[esb] = tr
               llvm::LLVMBuildCall2(cg.builder, cg.exit_t, cg.exit_fn, esb, 1,
                  "")
               llvm::LLVMBuildUnreachable(cg.builder)
               cg.exited = <+>
               dead' = llvm::LLVMAppendBasicBlock(cg.current_fn, "exit.done")
               llvm::LLVMPositionBuilderAtEnd(cg.builder, dead')
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      |
         types::init_error(cg, "E3172", "'#exit' expects an integerish status code",
            0, 0)
         (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
codegen_typed_eval_error_construct: types::Cg, tast::TypedExprs => (Addr, ast::ValueType)
codegen_typed_eval_error_construct = cg, args =>
   i64t = llvm::LLVMInt64Type!
   est = main::error_struct_type(cg)
   ep = codegen_call_arena_alloc(cg,
      llvm::LLVMConstInt(i64t, 56, 0), "err.alloc")
   nargs = ?args
   a0 = nargs > 0 | (args(0) | _ | tast::mk_lit_unit(0, 0)) |
      tast::mk_lit_unit(0, 0)
   ev0 = main::codegen_typed_eval(cg, a0)
   c0 = nargs > 0 | ev0.0 | llvm::LLVMConstInt(i64t, 0, 0)
   a1 = nargs > 1 | (args(1) | _ | tast::mk_lit_unit(0, 0)) |
      tast::mk_lit_unit(0, 0)
   ev1 = main::codegen_typed_eval(cg, a1)
   m1 = nargs > 1 | ev1.0 | stmt::codegen_string_literal(cg, "")
   a2 = nargs > 2 | (args(2) | _ | tast::mk_lit_unit(0, 0)) |
      tast::mk_lit_unit(0, 0)
   ev2 = main::codegen_typed_eval(cg, a2)
   f2 = nargs > 2 | ev2.0 |
      stmt::codegen_string_literal(cg, main::source_basename(cg.source_file))
   a3 = nargs > 3 | (args(3) | _ | tast::mk_lit_unit(0, 0)) |
      tast::mk_lit_unit(0, 0)
   ev3 = main::codegen_typed_eval(cg, a3)
   l3 = nargs > 3 | ev3.0 | llvm::LLVMConstInt(i64t, 0, 0)
   a4 = nargs > 4 | (args(4) | _ | tast::mk_lit_unit(0, 0)) |
      tast::mk_lit_unit(0, 0)
   ev4 = main::codegen_typed_eval(cg, a4)
   c4 = nargs > 4 | ev4.0 | llvm::LLVMConstInt(i64t, 0, 0)
   llvm::LLVMBuildStore(cg.builder, c0,
      llvm::LLVMBuildStructGEP2(cg.builder, est, ep, 0, "err.code.gep"))
   llvm::LLVMBuildStore(cg.builder, m1,
      llvm::LLVMBuildStructGEP2(cg.builder, est, ep, 1, "err.msg.gep"))
   llvm::LLVMBuildStore(cg.builder, f2,
      llvm::LLVMBuildStructGEP2(cg.builder, est, ep, 2, "err.file.gep"))
   llvm::LLVMBuildStore(cg.builder, l3,
      llvm::LLVMBuildStructGEP2(cg.builder, est, ep, 3, "err.line.gep"))
   llvm::LLVMBuildStore(cg.builder, c4,
      llvm::LLVMBuildStructGEP2(cg.builder, est, ep, 4, "err.col.gep"))
   ctx_gep = llvm::LLVMBuildStructGEP2(cg.builder, est, ep, 5, "err.ctx.gep")
   ctx_t = types::struct_type2(i64t, i64t)
   a5 = nargs > 5 | (args(5) | _ | tast::mk_lit_unit(0, 0)) |
      tast::mk_lit_unit(0, 0)
   ctx_ev = nargs > 5 | main::codegen_typed_eval(cg, a5) |
      (Addr(0), ast::ValueType(Unknown))
   ctx0 = ctx_ev.0 != Addr(0)
      |
         g0 = llvm::LLVMBuildStructGEP2(cg.builder, ctx_t, ctx_ev.0, 0,
            "ctx.0.gep")
         llvm::LLVMBuildLoad2(cg.builder, i64t, g0, "ctx.0")
      | llvm::LLVMConstInt(i64t, 0, 0)
   ctx1 = ctx_ev.0 != Addr(0)
      |
         g1 = llvm::LLVMBuildStructGEP2(cg.builder, ctx_t, ctx_ev.0, 1,
            "ctx.1.gep")
         llvm::LLVMBuildLoad2(cg.builder, i64t, g1, "ctx.1")
      | llvm::LLVMConstInt(i64t, 0, 0)
   llvm::LLVMBuildStore(cg.builder, ctx0,
      llvm::LLVMBuildStructGEP2(cg.builder, ctx_t, ctx_gep, 0, "err.ctx0.gep"))
   llvm::LLVMBuildStore(cg.builder, ctx1,
      llvm::LLVMBuildStructGEP2(cg.builder, ctx_t, ctx_gep, 1, "err.ctx1.gep"))
   (ep, ast::ValueType(Error))

is_known_type_predicate: String => <>
is_known_type_predicate = name =>
   name ["is_record", "is_enum", "is_ram", "is_fn", "is_unit",
      "is_homogeneous", "is_array", "is_slice", "is_map", "is_indexable",
      "is_iterable", "is_scalar", "is_int", "is_float", "is_numeric",
      "is_pointer"]

codegen_typed_eval_type_pred: types::Cg, String, tast::TypedExprs => (Addr, ast::ValueType)
codegen_typed_eval_type_pred = cg, pred_name, args =>
   arg0 = args(0) | _ | tast::mk_lit_unit(0, 0)
   arg_ti_res = resolve_typed_type_value(cg, arg0)
   arg_ti = arg_ti_res.1 | arg_ti_res.0 | arg0.ti
   matched = types::eval_type_predicate(cg, pred_name, arg_ti)
   flag_val = matched | 1 | 0
   i1t = llvm::LLVMInt1Type!
   (llvm::LLVMConstInt(i1t, flag_val, 0), ast::ValueType(Flag))

codegen_typed_eval_call: types::Cg, String, <tast::TypedExpr|>, tast::TypedExprs,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_call = cg, fname, ftarget, args, ti =>
   has_tgt = <>(ftarget)
   has_tgt
      |
         tgt_e = ftarget | _ | tast::mk_lit_unit(0, 0)
         tgt_vt = types::vt_from_ti_cg(cg, tgt_e.ti)
         is_idx = tgt_vt [Array, Slice, Map, Str, Record]
         is_idx
            |
               arg0' = args(0) | _ | tast::mk_lit_unit(0, 0)
               codegen_typed_eval_index(cg, tgt_e, arg0', ti)
            |
               tv = main::codegen_typed_eval(cg, tgt_e)
               codegen_typed_eval_indirect_call(cg, tv.0, args, ti)
      |
         is_ut = types::is_user_type(cg, fname)
         is_ut
            |
               td_ti = types::typedef_ti(cg, fname)
               is_enum = td_ti [Enum slots]
               is_enum
                  |
                     td_ti
                        [Enum slots]
                           arg0' = args(0) | _ | tast::mk_lit_unit(0, 0)
                           arg0_name = arg0'.kind [Var v] v.0 | ""
                           bare_name = types::decl_bare_name(arg0_name, 0)
                           idx = types::enum_slot_index(slots, bare_name)
                           idx !< 0
                              |
                                 pay_opt = ?args > 1 | <+ args(1)!! -> | <-->
                                 u = match::codegen_typed_build_union(cg, idx,
                                    pay_opt, "enum.alloc")
                                 (u, ast::ValueType(Enum))
                              |
                                 main::codegen_typed_eval(cg, arg0')
                        | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
                  |
                     nargs' = ?args
                     nargs' > 0
                        |
                           arg0' = args(0) | _ | tast::mk_lit_unit(0, 0)
                           aev = main::codegen_typed_eval(cg, arg0')
                           rm = runtime::record_meta_from_ti(cg, td_ti)
                           is_rec_td = rm.0 != Addr(0)
                           is_rec_td
                              |
                                 cg.last_rt = rm.0
                                 cg.last_fnames = rm.1
                                 cg.last_fvts = types::field_vts(cg, td_ti)
                                 cg.last_type = fname
                                 (aev.0, ast::ValueType(Record))
                              |
                                 td_ti
                                    [Ram _]
                                       match::codegen_typed_coerce_ram(cg, aev,
                                          arg0'.ti, td_ti)
                                    | aev
                        |
                           td_ti
                              [Array _]
                                 (main::codegen_array_create(cg, "a.new"),
                                    ast::ValueType(Array))
                              [Map _]
                                 (runtime::codegen_map_create(cg, "m.new"),
                                    ast::ValueType(Map))
                              |
                                 (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0),
                                    ast::ValueType(Unknown))
            |
               tn = fname != "" | types::type_name_to_vt(fname) |
                  (ast::ValueType(Unknown), <->)
               is_cast = tn.1 && fname != "Error"
               is_cast
                  |
                     nargs' = ?args
                     nargs' > 0
                        |
                           arg0' = args(0) | _ | tast::mk_lit_unit(0, 0)
                           codegen_typed_eval_cast(cg, tn.0, arg0')
                        | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
                  |
                     pred_name = types::type_pred_name_from_str(fname)
                     is_known_pred = is_known_type_predicate(pred_name)
                     arg0_ti = ?args == 1
                        | resolve_typed_type_value(cg, args(0)!!)
                        | (ast::TypeInfo(Prim, ast::ValueType(Unknown)), <->)
                     is_intrinsic = is_intrinsic_name(fname)
                     is_type_pred = is_known_pred && ?args == 1 && arg0_ti.1
                     is_special = is_intrinsic || fname == "Error" ||
                        fname == "addr" || is_type_pred
                     is_special
                        |
                           is_intrinsic
                              | codegen_typed_eval_intrinsic(cg, fname,
                                 args, ti)
                              |
                                 fname == "Error"
                                    | codegen_typed_eval_error_construct(cg,
                                       args)
                                    |
                                       fname == "addr"
                                          | codegen_typed_eval_addr(cg, args)
                                          | codegen_typed_eval_type_pred(cg,
                                             pred_name, args)
                        |
                           is_local_fn = types::has_local_var(cg, fname) ||
                              (stmt::param_clo_ty(cg, fname) != Addr(0))
                           rf = is_local_fn | fname |
                              types::resolve_fn_name(cg, fname)
                           has_real_fn = types::is_fn_name(cg, rf) ||
                              types::has_fn_name(cg, rf) || (fn_alias(cg, fname) != "")
                           has_vslot = fname != "" && <>(types::var_slot(cg, fname))
                           is_ext_sig = !has_vslot &&
                              (stmt::fn_has_signature(types::g.pstmts, rf, 0) ||
                              stmt::fn_has_signature(types::g.pstmts, fname, 0))
                           is_fn = !is_local_fn && (has_real_fn || is_ext_sig)
                           is_fn
                              | codegen_typed_eval_fn_call(cg, rf, args, ti)
                              |
                                 v_slot = fname != "" | types::var_slot(cg, fname) |
                                    <-->
                                 has_slot = <>(v_slot)
                                 is_var_fn = has_slot &&
                                    main::is_fn_vt(types::var_type(cg, fname))
                                 is_var_fn
                                    |
                                       slot = v_slot | _ | Addr(0)
                                       i8p = llvm::LLVMPointerType(
                                          llvm::LLVMInt8Type!, 0)
                                       clo_val = llvm::LLVMBuildLoad2(
                                          cg.builder, i8p, slot, "clo.load")
                                       codegen_typed_eval_indirect_call(cg,
                                          clo_val, args, ti)
                                    |
                                       is_var_idx = has_slot
                                       is_var_idx
                                          |
                                             nargs' = ?args
                                             nargs' > 0
                                                |
                                                   arg0' = args(0) | _ |
                                                      tast::mk_lit_unit(0, 0)
                                                   v_ti = ast::TypeInfo(Prim,
                                                      types::var_type(cg, fname))
                                                   tgt_te = tast::mk_typed_var(
                                                      fname, 0, <->,
                                                      unify::prim_unit(), v_ti,
                                                      tast::layout_void(), 0, 0)
                                                   codegen_typed_eval_index(cg,
                                                      tgt_te, arg0', ti)
                                                | (llvm::LLVMConstInt(
                                                   llvm::LLVMInt64Type!, 0, 0),
                                                   ast::ValueType(Unknown))
                                          |
                                             codegen_typed_eval_fn_call(cg,
                                                fname, args, ti)

is_intrinsic_name: String => <>
is_intrinsic_name = name =>
   ?name > 1 && name(0) == '%'

get_or_add_intrinsic: types::Cg, String, Addr => Addr
get_or_add_intrinsic = cg, name, fty =>
   fn = llvm::LLVMGetNamedFunction(cg.module, name)
   fn != Addr(0) | fn | llvm::LLVMAddFunction(cg.module, name, fty)

intrin_fn_type2: Addr, Addr, Addr => Addr
intrin_fn_type2 = ret, p0, p1 =>
   parr = {16}
   sb = &parr
   @[sb] = p0
   @[sb + 8] = p1
   llvm::LLVMFunctionType(ret, sb, 2, 0)

call_fn1: types::Cg, Addr, Addr, Addr, String => Addr
call_fn1 = cg, fty, fn, a0, name =>
   buf = {16}
   p = &buf
   @[p] = a0
   llvm::LLVMBuildCall2(cg.builder, fty, fn, p, 1, name)

call_fn2: types::Cg, Addr, Addr, Addr, Addr, String => Addr
call_fn2 = cg, fty, fn, a0, a1, name =>
   buf = {16}
   p = &buf
   @[p] = a0
   @[p + 8] = a1
   llvm::LLVMBuildCall2(cg.builder, fty, fn, p, 2, name)

call_fn3: types::Cg, Addr, Addr, Addr, Addr, Addr, String => Addr
call_fn3 = cg, fty, fn, a0, a1, a2, name =>
   buf = {24}
   p = &buf
   @[p] = a0
   @[p + 8] = a1
   @[p + 16] = a2
   llvm::LLVMBuildCall2(cg.builder, fty, fn, p, 3, name)

rec_elem_vt: ast::VTypes => ast::ValueType
rec_elem_vt = fvts =>
   ?fvts == 0
      | ast::ValueType(Unknown)
      |
         vt = fvts(0) | _ | ast::ValueType(Unknown)
         vt

load_rec_vec: types::Cg, Addr, Addr, ast::ValueType, Int => Addr
load_rec_vec = cg, ptr, elem_llvm, elem_vt, count =>
   types::is_flag_vt(elem_vt)
      | load_flag_vector(cg, ptr, count)
      |
         vec_ty = codegen_vector_type(elem_llvm, count)
         arr_ptr_ty = llvm::LLVMPointerType(vec_ty, 0)
         align = elem_byte_size(elem_vt)
         bc = llvm::LLVMBuildPointerCast(cg.builder, ptr, arr_ptr_ty,
            "vec.bc")
         ld = llvm::LLVMBuildLoad2(cg.builder, vec_ty, bc, "vec.ld")
         llvm::LLVMSetAlignment(ld, align)
         ld

store_rec_vec: types::Cg, Addr, ast::TypeInfo, Addr, ast::ValueType,
   Int => (Addr, ast::ValueType)
store_rec_vec = cg, vec_val, ret_ti, elem_llvm, elem_vt, count =>
   types::is_flag_vt(elem_vt)
      |
         res_rt = make_flag_record_type(cg, count)
         alloc_sz = llvm::LLVMSizeOf(res_rt)
         result_ptr = codegen_call_arena_alloc(cg, alloc_sz, "rec.flag.alloc")
         store_flag_vector(cg, result_ptr, vec_val, count)
         cg.last_rt = res_rt
         cg.last_fnames = ast::Names()
         cg.last_fvts = make_flag_fvts(count)
         (result_ptr, ast::ValueType(Record))
      |
         vec_ty = codegen_vector_type(elem_llvm, count)
         arr_ptr_ty = llvm::LLVMPointerType(vec_ty, 0)
         align = elem_byte_size(elem_vt)
         total_bytes = elem_byte_size(elem_vt) * count
         i64t = llvm::LLVMInt64Type!
         result_ptr = codegen_call_arena_alloc(cg,
            llvm::LLVMConstInt(i64t, total_bytes, 0), "vec.alloc")
         bc_res = llvm::LLVMBuildPointerCast(cg.builder, result_ptr,
            arr_ptr_ty, "vec.res.bc")
         st = llvm::LLVMBuildStore(cg.builder, vec_val, bc_res)
         llvm::LLVMSetAlignment(st, align)
         rm = runtime::record_meta_from_ti(cg, ret_ti)
         cg.last_rt = rm.0
         cg.last_fnames = rm.1
         cg.last_fvts = types::field_vts(cg, ret_ti)
         (result_ptr, ast::ValueType(Record))

swizzle_char_to_idx: types::Cg, ast::TypeInfo, String, Int => Int
swizzle_char_to_idx = cg, ti, fname, mi =>
   ch = fname(mi)
   ch_str = fname(mi..mi + 1)
   fnames = runtime::record_meta_from_ti(cg, ti).1
   idx_fld = ?fnames > 0 | types::member_index(fnames, ch_str) | -1
   idx_fld !< 0
      | idx_fld
      |
         ch == 'x' || ch == 'r' | 0 |
         (ch == 'y' || ch == 'g' | 1 |
         (ch == 'z' || ch == 'b' | 2 |
         (ch == 'w' || ch == 'a' | 3 | 0)))

codegen_eval_swizzle: types::Cg, tast::TypedExpr, String,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_eval_swizzle = cg, target, fname, ti =>
   tv = main::codegen_typed_eval(cg, target)
   tv.0 == Addr(0)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         tgt_ti = types::typed_member_target_ti(cg, target)
         eff_tgt_ti = tgt_ti [Prim p] (p [Unknown] target.ti | tgt_ti) | tgt_ti
         in_fvts = types::field_vts(cg, eff_tgt_ti)
         in_fvts' = ?in_fvts > 0 | in_fvts | types::field_vts(cg, target.ti)
         in_count = ?in_fvts'
         elem_vt = rec_elem_vt(in_fvts')
         elem_llvm = types::llvm_type_of_vt(elem_vt)
         out_count = ?fname
         out_count == 1
            |
               c_idx = swizzle_char_to_idx(cg, eff_tgt_ti, fname, 0)
               rm = runtime::record_meta_from_ti(cg, eff_tgt_ti)
               st0 = rm.0 != Addr(0) | rm.0 | runtime::record_meta_from_ti(cg, target.ti).0
               st = st0 != Addr(0) | st0 | cg.last_rt
               st != Addr(0) && llvm::LLVMGetTypeKind(st) == 10
                  |
                     fgep = llvm::LLVMBuildStructGEP2(cg.builder, st, tv.0,
                        c_idx, "swizzle.gep")
                     val = llvm::LLVMBuildLoad2(cg.builder, elem_llvm, fgep,
                        "swizzle.load")
                     (val, elem_vt)
                  |
                     v0 = load_rec_vec(cg, tv.0, elem_llvm, elem_vt, in_count)
                     idx32 = llvm::LLVMConstInt(llvm::LLVMInt32Type!, c_idx, 0)
                     elem = llvm::LLVMBuildExtractElement(cg.builder, v0, idx32,
                        "swizzle.ext")
                     (elem, elem_vt)
            |
               v0 = load_rec_vec(cg, tv.0, elem_llvm, elem_vt, in_count)
               i32t = llvm::LLVMInt32Type!
               mask_buf = {out_count * 8}
               mask_p = &mask_buf
               out_count @ mi =>
                  c_idx = swizzle_char_to_idx(cg, eff_tgt_ti, fname, mi)
                  @[mask_p + mi * 8] = llvm::LLVMConstInt(i32t, c_idx, 0)
               mask_vec = llvm::LLVMConstVector(mask_p, out_count)
               res_vec = llvm::LLVMBuildShuffleVector(cg.builder, v0, v0,
                  mask_vec, "swizzle")
               store_rec_vec(cg, res_vec, ti, elem_llvm, elem_vt, out_count)

codegen_eval_scalar_math: types::Cg, String, (Addr, ast::ValueType),
   (Addr, ast::ValueType), (Addr, ast::ValueType) => (Addr, ast::ValueType)
codegen_eval_scalar_math = cg, fname, ev0, ev1, ev2 =>
   f64t = llvm::LLVMDoubleType!
   i64t = llvm::LLVMInt64Type!
   i1t = llvm::LLVMInt1Type!
   fname
      ["%sqrt"]
         fn = get_or_add_intrinsic(cg, "llvm.sqrt.f64", types::fn_type1(f64t, f64t))
         (call_fn1(cg, types::fn_type1(f64t, f64t), fn, ev0.0, "sqrt"),
            ast::ValueType(Float))
      ["%floor", "%ceil", "%trunc", "%round", "%sin", "%cos", "%exp2", "%log2"]
         op_s = fname(1..)
         fn = get_or_add_intrinsic(cg, "llvm." + op_s + ".f64",
            types::fn_type1(f64t, f64t))
         (call_fn1(cg, types::fn_type1(f64t, f64t), fn, ev0.0, op_s),
            ast::ValueType(Float))
      ["%pow"]
         fn = get_or_add_intrinsic(cg, "llvm.pow.f64",
            intrin_fn_type2(f64t, f64t, f64t))
         (call_fn2(cg, intrin_fn_type2(f64t, f64t, f64t), fn, ev0.0, ev1.0,
            "pow"), ast::ValueType(Float))
      ["%uadd_sat", "%usub_sat"]
         iname = fname == "%uadd_sat"
            | "llvm.uadd.sat.i64"
            | "llvm.usub.sat.i64"
         fn = get_or_add_intrinsic(cg, iname,
            intrin_fn_type2(i64t, i64t, i64t))
         (call_fn2(cg, intrin_fn_type2(i64t, i64t, i64t), fn, ev0.0, ev1.0,
            fname(1..)), ast::ValueType(Int))
      ["%fma", "%fmuladd"]
         op_s = fname(1..)
         fn = get_or_add_intrinsic(cg, "llvm." + op_s + ".f64",
            types::fn_type3(f64t, f64t, f64t, f64t))
         (call_fn3(cg, types::fn_type3(f64t, f64t, f64t, f64t), fn, ev0.0, ev1.0,
            ev2.0, op_s), ast::ValueType(Float))
      ["%copysign"]
         fn = get_or_add_intrinsic(cg, "llvm.copysign.f64",
            intrin_fn_type2(f64t, f64t, f64t))
         (call_fn2(cg, intrin_fn_type2(f64t, f64t, f64t), fn, ev0.0, ev1.0,
            "copysign"), ast::ValueType(Float))
      ["%abs"]
         types::is_float_vt(ev0.1)
            |
               fn = get_or_add_intrinsic(cg, "llvm.fabs.f64",
                  types::fn_type1(f64t, f64t))
               (call_fn1(cg, types::fn_type1(f64t, f64t), fn, ev0.0, "fabs"),
                  ast::ValueType(Float))
            |
               fn = get_or_add_intrinsic(cg, "llvm.abs.i64",
                  intrin_fn_type2(i64t, i64t, i1t))
               (call_fn2(cg, intrin_fn_type2(i64t, i64t, i1t), fn, ev0.0,
                  llvm::LLVMConstInt(i1t, 0, 0), "abs"), ast::ValueType(Int))
      ["%min"]
         types::is_float_vt(ev0.1) || types::is_float_vt(ev1.1)
            |
               fn = get_or_add_intrinsic(cg, "llvm.minnum.f64",
                  intrin_fn_type2(f64t, f64t, f64t))
               (call_fn2(cg, intrin_fn_type2(f64t, f64t, f64t), fn, ev0.0,
                  ev1.0, "min"), ast::ValueType(Float))
            |
               fn = get_or_add_intrinsic(cg, "llvm.smin.i64",
                  intrin_fn_type2(i64t, i64t, i64t))
               (call_fn2(cg, intrin_fn_type2(i64t, i64t, i64t), fn, ev0.0,
                  ev1.0, "smin"), ast::ValueType(Int))
      ["%max"]
         types::is_float_vt(ev0.1) || types::is_float_vt(ev1.1)
            |
               fn = get_or_add_intrinsic(cg, "llvm.maxnum.f64",
                  intrin_fn_type2(f64t, f64t, f64t))
               (call_fn2(cg, intrin_fn_type2(f64t, f64t, f64t), fn, ev0.0,
                  ev1.0, "max"), ast::ValueType(Float))
            |
               fn = get_or_add_intrinsic(cg, "llvm.smax.i64",
                  intrin_fn_type2(i64t, i64t, i64t))
               (call_fn2(cg, intrin_fn_type2(i64t, i64t, i64t), fn, ev0.0,
                  ev1.0, "smax"), ast::ValueType(Int))
      ["%clamp"]
         is_flt = types::is_float_vt(ev0.1) || types::is_float_vt(ev1.1) || types::is_float_vt(ev2.1)
         is_flt
            |
               max_fn = get_or_add_intrinsic(cg, "llvm.maxnum.f64",
                  intrin_fn_type2(f64t, f64t, f64t))
               min_fn = get_or_add_intrinsic(cg, "llvm.minnum.f64",
                  intrin_fn_type2(f64t, f64t, f64t))
               max_v = call_fn2(cg, intrin_fn_type2(f64t, f64t, f64t), max_fn,
                  ev0.0, ev1.0, "clamp.max")
               res_v = call_fn2(cg, intrin_fn_type2(f64t, f64t, f64t), min_fn,
                  max_v, ev2.0, "clamp.min")
               (res_v, ast::ValueType(Float))
            |
               max_fn = get_or_add_intrinsic(cg, "llvm.smax.i64",
                  intrin_fn_type2(i64t, i64t, i64t))
               min_fn = get_or_add_intrinsic(cg, "llvm.smin.i64",
                  intrin_fn_type2(i64t, i64t, i64t))
               max_v = call_fn2(cg, intrin_fn_type2(i64t, i64t, i64t), max_fn,
                  ev0.0, ev1.0, "clamp.max")
               res_v = call_fn2(cg, intrin_fn_type2(i64t, i64t, i64t), min_fn,
                  max_v, ev2.0, "clamp.min")
               (res_v, ast::ValueType(Int))
      ["%popcount"]
         fn = get_or_add_intrinsic(cg, "llvm.ctpop.i64", types::fn_type1(i64t, i64t))
         (call_fn1(cg, types::fn_type1(i64t, i64t), fn, ev0.0, "ctpop"),
            ast::ValueType(Int))
      ["%clz"]
         fn = get_or_add_intrinsic(cg, "llvm.ctlz.i64",
            intrin_fn_type2(i64t, i64t, i1t))
         (call_fn2(cg, intrin_fn_type2(i64t, i64t, i1t), fn, ev0.0,
            llvm::LLVMConstInt(i1t, 0, 0), "ctlz"), ast::ValueType(Int))
      ["%ctz"]
         fn = get_or_add_intrinsic(cg, "llvm.cttz.i64",
            intrin_fn_type2(i64t, i64t, i1t))
         (call_fn2(cg, intrin_fn_type2(i64t, i64t, i1t), fn, ev0.0,
            llvm::LLVMConstInt(i1t, 0, 0), "cttz"), ast::ValueType(Int))
      ["%bswap"]
         fn = get_or_add_intrinsic(cg, "llvm.bswap.i64", types::fn_type1(i64t, i64t))
         (call_fn1(cg, types::fn_type1(i64t, i64t), fn, ev0.0, "bswap"),
            ast::ValueType(Int))
      ["%bitreverse"]
         fn = get_or_add_intrinsic(cg, "llvm.bitreverse.i64",
            types::fn_type1(i64t, i64t))
         (call_fn1(cg, types::fn_type1(i64t, i64t), fn, ev0.0, "bitreverse"),
            ast::ValueType(Int))
      ["%rotl"]
         fn = get_or_add_intrinsic(cg, "llvm.fshl.i64",
            types::fn_type3(i64t, i64t, i64t, i64t))
         (call_fn3(cg, types::fn_type3(i64t, i64t, i64t, i64t), fn, ev0.0, ev0.0,
            ev1.0, "rotl"), ast::ValueType(Int))
      ["%rotr"]
         fn = get_or_add_intrinsic(cg, "llvm.fshr.i64",
            types::fn_type3(i64t, i64t, i64t, i64t))
         (call_fn3(cg, types::fn_type3(i64t, i64t, i64t, i64t), fn, ev0.0, ev0.0,
            ev1.0, "rotr"), ast::ValueType(Int))
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_eval_vec_math: types::Cg, String, tast::TypedExprs, ast::TypeInfo,
   (Addr, ast::ValueType), (Addr, ast::ValueType),
   (Addr, ast::ValueType) => (Addr, ast::ValueType)
codegen_eval_vec_math = cg, fname, args, ti, ev0, ev1, ev2 =>
   nargs = ?args
   is_rec0 = types::is_record_vt(ev0.1)
   is_rec1 = nargs > 1 && types::is_record_vt(ev1.1)
   is_rec2 = nargs > 2 && types::is_record_vt(ev2.1)
   fvts0 = is_rec0 | types::field_vts(cg, (args(0)!!).ti) | ast::VTypes()
   fvts1 = is_rec1 | types::field_vts(cg, (args(1)!!).ti) | ast::VTypes()
   fvts2 = is_rec2 | types::field_vts(cg, (args(2)!!).ti) | ast::VTypes()
   vec_count = is_rec0 | ?fvts0 | (is_rec1 | ?fvts1 | ?fvts2)
   elem_vt = is_rec0
      | rec_elem_vt(fvts0)
      |
         is_rec1
            | rec_elem_vt(fvts1)
            | rec_elem_vt(fvts2)
   is_flt = types::is_float_vt(elem_vt)
   elem_llvm = is_flt | llvm::LLVMDoubleType! | llvm::LLVMInt64Type!
   vec_ty = codegen_vector_type(elem_llvm, vec_count)
   vstr = "v" + str::from_int(vec_count) + (is_flt | "f64" | "i64")
   v0 = is_rec0
      | load_rec_vec(cg, ev0.0, elem_llvm, elem_vt, vec_count)
      | codegen_build_splat(cg, ev0.0, elem_llvm, vec_count)
   v1 = nargs > 1
      |
         is_rec1
            | load_rec_vec(cg, ev1.0, elem_llvm, elem_vt, vec_count)
            | codegen_build_splat(cg, ev1.0, elem_llvm, vec_count)
      | v0
   v2 = nargs > 2
      |
         is_rec2
            | load_rec_vec(cg, ev2.0, elem_llvm, elem_vt, vec_count)
            | codegen_build_splat(cg, ev2.0, elem_llvm, vec_count)
      | v0
   i1t = llvm::LLVMInt1Type!
   fname
      ["%sqrt"]
         fn = get_or_add_intrinsic(cg, "llvm.sqrt." + vstr,
            types::fn_type1(vec_ty, vec_ty))
         vec_res = call_fn1(cg, types::fn_type1(vec_ty, vec_ty), fn, v0, "vec.sqrt")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%floor", "%ceil", "%trunc", "%round", "%sin", "%cos", "%exp2", "%log2"]
         op_s = fname(1..)
         fn = get_or_add_intrinsic(cg, "llvm." + op_s + "." + vstr,
            types::fn_type1(vec_ty, vec_ty))
         vec_res = call_fn1(cg, types::fn_type1(vec_ty, vec_ty), fn, v0, "vec." + op_s)
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%pow"]
         fn = get_or_add_intrinsic(cg, "llvm.pow." + vstr,
            intrin_fn_type2(vec_ty, vec_ty, vec_ty))
         vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty), fn,
            v0, v1, "vec.pow")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%uadd_sat", "%usub_sat"]
         iname = fname == "%uadd_sat"
            | "llvm.uadd.sat." + vstr
            | "llvm.usub.sat." + vstr
         fn = get_or_add_intrinsic(cg, iname,
            intrin_fn_type2(vec_ty, vec_ty, vec_ty))
         vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty), fn,
            v0, v1, "vec.sat")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%fma", "%fmuladd"]
         op_s = fname(1..)
         fn = get_or_add_intrinsic(cg, "llvm." + op_s + "." + vstr,
            types::fn_type3(vec_ty, vec_ty, vec_ty, vec_ty))
         vec_res = call_fn3(cg, types::fn_type3(vec_ty, vec_ty, vec_ty, vec_ty), fn,
            v0, v1, v2, "vec." + op_s)
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%copysign"]
         fn = get_or_add_intrinsic(cg, "llvm.copysign." + vstr,
            intrin_fn_type2(vec_ty, vec_ty, vec_ty))
         vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty), fn,
            v0, v1, "vec.copysign")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%abs"]
         is_flt
            |
               fn = get_or_add_intrinsic(cg, "llvm.fabs." + vstr,
                  types::fn_type1(vec_ty, vec_ty))
               vec_res = call_fn1(cg, types::fn_type1(vec_ty, vec_ty), fn, v0,
                  "vec.fabs")
               store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
            |
               fn = get_or_add_intrinsic(cg, "llvm.abs." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, i1t))
               vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, i1t), fn,
                  v0, llvm::LLVMConstInt(i1t, 0, 0), "vec.abs")
               store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%min"]
         is_flt
            |
               fn = get_or_add_intrinsic(cg, "llvm.minnum." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  fn, v0, v1, "vec.min")
               store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
            |
               fn = get_or_add_intrinsic(cg, "llvm.smin." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  fn, v0, v1, "vec.smin")
               store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%max"]
         is_flt
            |
               fn = get_or_add_intrinsic(cg, "llvm.maxnum." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  fn, v0, v1, "vec.max")
               store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
            |
               fn = get_or_add_intrinsic(cg, "llvm.smax." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  fn, v0, v1, "vec.smax")
               store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%clamp"]
         is_flt
            |
               max_fn = get_or_add_intrinsic(cg, "llvm.maxnum." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               min_fn = get_or_add_intrinsic(cg, "llvm.minnum." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               max_v = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  max_fn, v0, v1, "vec.clamp.max")
               res_v = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  min_fn, max_v, v2, "vec.clamp.min")
               store_rec_vec(cg, res_v, ti, elem_llvm, elem_vt, vec_count)
            |
               max_fn = get_or_add_intrinsic(cg, "llvm.smax." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               min_fn = get_or_add_intrinsic(cg, "llvm.smin." + vstr,
                  intrin_fn_type2(vec_ty, vec_ty, vec_ty))
               max_v = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  max_fn, v0, v1, "vec.clamp.max")
               res_v = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, vec_ty),
                  min_fn, max_v, v2, "vec.clamp.min")
               store_rec_vec(cg, res_v, ti, elem_llvm, elem_vt, vec_count)
      ["%popcount"]
         fn = get_or_add_intrinsic(cg, "llvm.ctpop." + vstr,
            types::fn_type1(vec_ty, vec_ty))
         vec_res = call_fn1(cg, types::fn_type1(vec_ty, vec_ty), fn, v0, "vec.ctpop")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%clz"]
         fn = get_or_add_intrinsic(cg, "llvm.ctlz." + vstr,
            intrin_fn_type2(vec_ty, vec_ty, i1t))
         vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, i1t), fn,
            v0, llvm::LLVMConstInt(i1t, 0, 0), "vec.ctlz")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%ctz"]
         fn = get_or_add_intrinsic(cg, "llvm.cttz." + vstr,
            intrin_fn_type2(vec_ty, vec_ty, i1t))
         vec_res = call_fn2(cg, intrin_fn_type2(vec_ty, vec_ty, i1t), fn,
            v0, llvm::LLVMConstInt(i1t, 0, 0), "vec.cttz")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%bswap"]
         fn = get_or_add_intrinsic(cg, "llvm.bswap." + vstr,
            types::fn_type1(vec_ty, vec_ty))
         vec_res = call_fn1(cg, types::fn_type1(vec_ty, vec_ty), fn, v0, "vec.bswap")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%bitreverse"]
         fn = get_or_add_intrinsic(cg, "llvm.bitreverse." + vstr,
            types::fn_type1(vec_ty, vec_ty))
         vec_res = call_fn1(cg, types::fn_type1(vec_ty, vec_ty), fn, v0,
            "vec.bitrev")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%rotl"]
         fn = get_or_add_intrinsic(cg, "llvm.fshl." + vstr,
            types::fn_type3(vec_ty, vec_ty, vec_ty, vec_ty))
         vec_res = call_fn3(cg, types::fn_type3(vec_ty, vec_ty, vec_ty, vec_ty), fn,
            v0, v0, v1, "vec.rotl")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      ["%rotr"]
         fn = get_or_add_intrinsic(cg, "llvm.fshr." + vstr,
            types::fn_type3(vec_ty, vec_ty, vec_ty, vec_ty))
         vec_res = call_fn3(cg, types::fn_type3(vec_ty, vec_ty, vec_ty, vec_ty), fn,
            v0, v0, v1, "vec.rotr")
         store_rec_vec(cg, vec_res, ti, elem_llvm, elem_vt, vec_count)
      | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_eval_math_intrinsic: types::Cg, String, tast::TypedExprs, ast::TypeInfo,
   (Addr, ast::ValueType), (Addr, ast::ValueType),
   (Addr, ast::ValueType) => (Addr, ast::ValueType)
codegen_eval_math_intrinsic = cg, fname, args, ti, ev0, ev1, ev2 =>
   nargs = ?args
   is_rec0 = types::is_record_vt(ev0.1)
   is_rec1 = nargs > 1 && types::is_record_vt(ev1.1)
   is_rec2 = nargs > 2 && types::is_record_vt(ev2.1)
   is_vec = is_rec0 || is_rec1 || is_rec2
   is_vec
      | codegen_eval_vec_math(cg, fname, args, ti, ev0, ev1, ev2)
      | codegen_eval_scalar_math(cg, fname, ev0, ev1, ev2)

intrin_ptr_val: types::Cg, (Addr, ast::ValueType) => Addr
intrin_ptr_val = cg, ev =>
   ev.0 == Addr(0)
      | llvm::LLVMConstNull(llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0))
      |
         i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
         vty = llvm::LLVMTypeOf(ev.0)
         is_p = llvm::LLVMGetTypeKind(vty) == 12
         raw_p = is_p
            | ev.0
            | llvm::LLVMBuildIntToPtr(cg.builder, ev.0, i8p, "raw.ptr")
         validate_and_strip_addr_tag(cg, raw_p, i8p)

intrin_size_val: types::Cg, (Addr, ast::ValueType) => Addr
intrin_size_val = cg, ev =>
   ev.0 == Addr(0)
      | llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0)
      | stmt::coerce_int(cg, ev.0, llvm::LLVMInt64Type!)

intrin_val8: types::Cg, (Addr, ast::ValueType) => Addr
intrin_val8 = cg, ev =>
   ev.0 == Addr(0)
      | llvm::LLVMConstInt(llvm::LLVMInt8Type!, 0, 0)
      | stmt::coerce_int(cg, ev.0, llvm::LLVMInt8Type!)

codegen_typed_eval_intrinsic: types::Cg, String, tast::TypedExprs,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_intrinsic = cg, fname, args, ti =>
   nargs = ?args
   ev0 = nargs > 0 | main::codegen_typed_eval(cg, args(0)!!) |
      (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
   ev1 = nargs > 1 | main::codegen_typed_eval(cg, args(1)!!) |
      (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
   ev2 = nargs > 2 | main::codegen_typed_eval(cg, args(2)!!) |
      (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
   ti0 = nargs > 0 | (args(0)!!).ti |
      ast::TypeInfo(Prim, ast::ValueType(Unknown))
   ti1 = nargs > 1 | (args(1)!!).ti |
      ast::TypeInfo(Prim, ast::ValueType(Unknown))
   ti2 = nargs > 2 | (args(2)!!).ti |
      ast::TypeInfo(Prim, ast::ValueType(Unknown))
   fvts0 = types::field_vts(cg, ti0)
   fvts1 = types::field_vts(cg, ti1)
   fname
      ["%all", "%any"]
         count = ?fvts0
         i1t = llvm::LLVMInt1Type!
         vec_val = load_flag_vector(cg, ev0.0, count)
         vec_ty = codegen_vector_type(i1t, count)
         iname = fname == "%all"
            | "llvm.vector.reduce.and.v" + str::from_int(count) + "i1"
            | "llvm.vector.reduce.or.v" + str::from_int(count) + "i1"
         fty = types::fn_type1(i1t, vec_ty)
         fn = get_or_add_intrinsic(cg, iname, fty)
         res = call_fn1(cg, fty, fn, vec_val, "reduce.bit")
         (res, ast::ValueType(Flag))
      ["%sum", "%prod"]
         count = ?fvts0
         elem_vt = rec_elem_vt(fvts0)
         is_flt = types::is_float_vt(elem_vt)
         elem_llvm = is_flt | llvm::LLVMDoubleType! | llvm::LLVMInt64Type!
         vec_val = load_rec_vec(cg, ev0.0, elem_llvm, elem_vt, count)
         vec_ty = codegen_vector_type(elem_llvm, count)
         is_sum = fname == "%sum"
         is_flt
            |
               iname = is_sum
                  | "llvm.vector.reduce.fadd.v" + str::from_int(count) + "f64"
                  | "llvm.vector.reduce.fmul.v" + str::from_int(count) + "f64"
               fty = intrin_fn_type2(elem_llvm, elem_llvm, vec_ty)
               fn = get_or_add_intrinsic(cg, iname, fty)
               s_val = is_sum
                  | llvm::LLVMConstReal(elem_llvm, -0.0)
                  | llvm::LLVMConstReal(elem_llvm, 1.0)
               res = call_fn2(cg, fty, fn, s_val, vec_val, "reduce.flt")
               (res, elem_vt)
            |
               iname = is_sum
                  | "llvm.vector.reduce.add.v" + str::from_int(count) + "i64"
                  | "llvm.vector.reduce.mul.v" + str::from_int(count) + "i64"
               fty = types::fn_type1(elem_llvm, vec_ty)
               fn = get_or_add_intrinsic(cg, iname, fty)
               res = call_fn1(cg, fty, fn, vec_val, "reduce.int")
               (res, elem_vt)
      ["%dot"]
         count = ?fvts0
         elem_vt = rec_elem_vt(fvts0)
         is_flt = types::is_float_vt(elem_vt)
         elem_llvm = is_flt | llvm::LLVMDoubleType! | llvm::LLVMInt64Type!
         v0 = load_rec_vec(cg, ev0.0, elem_llvm, elem_vt, count)
         v1 = load_rec_vec(cg, ev1.0, elem_llvm, elem_vt, count)
         vec_ty = codegen_vector_type(elem_llvm, count)
         is_flt
            |
               vmul = llvm::LLVMBuildFMul(cg.builder, v0, v1, "dot.fmul")
               iname = "llvm.vector.reduce.fadd.v" + str::from_int(count) +
                  "f64"
               fty = intrin_fn_type2(elem_llvm, elem_llvm, vec_ty)
               fn = get_or_add_intrinsic(cg, iname, fty)
               s_val = llvm::LLVMConstReal(elem_llvm, -0.0)
               res = call_fn2(cg, fty, fn, s_val, vmul, "dot.red")
               (res, elem_vt)
            |
               vmul = llvm::LLVMBuildMul(cg.builder, v0, v1, "dot.mul")
               iname = "llvm.vector.reduce.add.v" + str::from_int(count) +
                  "i64"
               fty = types::fn_type1(elem_llvm, vec_ty)
               fn = get_or_add_intrinsic(cg, iname, fty)
               res = call_fn1(cg, fty, fn, vmul, "dot.red")
               (res, elem_vt)
      ["%shuffle"]
         mask_te = nargs == 3 | (args(2)!!) | (args(1)!!)
         mask_count = ?types::field_vts(cg, mask_te.ti)
         v0_count = ?fvts0
         elem_vt = rec_elem_vt(fvts0)
         elem_llvm = types::is_float_vt(elem_vt)
            | llvm::LLVMDoubleType!
            | llvm::LLVMInt64Type!
         v0 = load_rec_vec(cg, ev0.0, elem_llvm, elem_vt, v0_count)
         v1 = nargs == 3
            | load_rec_vec(cg, ev1.0, elem_llvm, elem_vt, ?fvts1)
            | v0
         i32t = llvm::LLVMInt32Type!
         mask_buf = {mask_count * 8}
         mask_p = &mask_buf
         mask_te.kind
            [Record m_fields]
               mask_count @ mi =>
                  mfld = m_fields(mi) | _ |
                     tast::TypedField(("",
                        tast::mk_lit_int(0, 0, 0), 0,
                        unify::prim_int()))
                  m_kind = mfld.val.kind
                  m_idx = m_kind [LitInt idx_val] idx_val | 0
                  c_idx = llvm::LLVMConstInt(i32t, m_idx, 0)
                  @[mask_p + mi * 8] = c_idx
            |
               mask_count @ mi =>
                  c_mi = llvm::LLVMConstInt(i32t, mi, 0)
                  @[mask_p + mi * 8] = c_mi
         mask_vec = llvm::LLVMConstVector(mask_p, mask_count)
         res_vec = llvm::LLVMBuildShuffleVector(cg.builder, v0, v1,
            mask_vec, "shuffle")
         store_rec_vec(cg, res_vec, ti, elem_llvm, elem_vt, mask_count)
      ["%memcpy"]
         dst_ptr = intrin_ptr_val(cg, ev0)
         src_ptr = intrin_ptr_val(cg, ev1)
         sz_val = intrin_size_val(cg, ev2)
         llvm::LLVMBuildMemCpy(cg.builder, dst_ptr, 1, src_ptr, 1, sz_val, 0)
         (dst_ptr, ast::ValueType(RawPtr))
      ["%memmove"]
         dst_ptr = intrin_ptr_val(cg, ev0)
         src_ptr = intrin_ptr_val(cg, ev1)
         sz_val = intrin_size_val(cg, ev2)
         llvm::LLVMBuildMemMove(cg.builder, dst_ptr, 1, src_ptr, 1, sz_val, 0)
         (dst_ptr, ast::ValueType(RawPtr))
      ["%memset"]
         dst_ptr = intrin_ptr_val(cg, ev0)
         v8 = intrin_val8(cg, ev1)
         sz_val = intrin_size_val(cg, ev2)
         llvm::LLVMBuildMemSet(cg.builder, dst_ptr, v8, sz_val, 1)
         (dst_ptr, ast::ValueType(RawPtr))
      |
         codegen_eval_math_intrinsic(cg, fname, args, ti, ev0, ev1, ev2)

codegen_eval_legacy_intrinsic: types::Cg, ast::CallExpr => (Addr, ast::ValueType)
codegen_eval_legacy_intrinsic = cg, t =>
   nargs = ?t.args
   ev0 = nargs > 0 | codegen_eval(cg, t.args(0)!!) |
      (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
   ev1 = nargs > 1 | codegen_eval(cg, t.args(1)!!) |
      (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
   ev2 = nargs > 2 | codegen_eval(cg, t.args(2)!!) |
      (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
   t.fn_name
      ["%memcpy"]
         dst_ptr = intrin_ptr_val(cg, ev0)
         src_ptr = intrin_ptr_val(cg, ev1)
         sz_val = intrin_size_val(cg, ev2)
         llvm::LLVMBuildMemCpy(cg.builder, dst_ptr, 1, src_ptr, 1, sz_val, 0)
         (dst_ptr, ast::ValueType(RawPtr))
      ["%memmove"]
         dst_ptr = intrin_ptr_val(cg, ev0)
         src_ptr = intrin_ptr_val(cg, ev1)
         sz_val = intrin_size_val(cg, ev2)
         llvm::LLVMBuildMemMove(cg.builder, dst_ptr, 1, src_ptr, 1, sz_val, 0)
         (dst_ptr, ast::ValueType(RawPtr))
      ["%memset"]
         dst_ptr = intrin_ptr_val(cg, ev0)
         v8 = intrin_val8(cg, ev1)
         sz_val = intrin_size_val(cg, ev2)
         llvm::LLVMBuildMemSet(cg.builder, dst_ptr, v8, sz_val, 1)
         (dst_ptr, ast::ValueType(RawPtr))
      | codegen_eval_scalar_math(cg, t.fn_name, ev0, ev1, ev2)

rec_elem_fnames: types::Cg, Addr => ast::Names
rec_elem_fnames = cg, rt =>
   td_nm = types::typedef_name_of_rt(cg, rt)
   td_nm != "" | types::td_record_meta_by_name(cg, td_nm).1 | ast::Names()

codegen_typed_eval_index: types::Cg, tast::TypedExpr, tast::TypedExpr,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_index = cg, target, index, ti =>
   tv = main::codegen_typed_eval(cg, target)
   ret_vt = types::vt_from_ti(ti)
   is_str = tv.1 [Str]
   is_sl = tv.1 [Slice]
   is_arr = tv.1 [Array]
   is_rec = tv.1 [Record]
   is_range = index.kind [Bin b] (b.0 [Seq]) | <->
   is_sl_ret = ret_vt [Slice]
   ret_is_sl = is_sl_ret && is_range
   ret_is_sl
      |
         i64t' = llvm::LLVMInt64Type!
         b1_val' = index.kind [Bin b] (main::codegen_typed_eval(cg, b.1)) |
            (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
         b2_val' = index.kind [Bin b] (main::codegen_typed_eval(cg, b.2)) |
            (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
         has_start' = b1_val'.0 != Addr(0) && !(b1_val'.1 [Unit])
         s_val = has_start'
            | main::codegen_widen_idx_to_i64(cg, b1_val'.0, b1_val'.1, "view.start")
            | llvm::LLVMConstInt(i64t', 0, 0)
         has_end' = b2_val'.0 != Addr(0) && !(b2_val'.1 [Unit])
         e_val_explicit = has_end'
            | main::codegen_widen_idx_to_i64(cg, b2_val'.0, b2_val'.1, "view.end")
            | Addr(0)
         is_sl
            |
               base_len' = main::slice_len(cg, tv.0, "slice.len")
               clamped' = main::codegen_clamp_slice_range(cg, s_val, e_val_explicit,
                  has_start', has_end', base_len')
               final_start' = clamped'.0
               view_len' = clamped'.1
               base_data' = main::slice_data(cg, tv.0, "slice.data")
               elem_vt' = ti [Rec r] r.3 | ast::ValueType(Int)
               elem_ll' = types::llvm_type_of_vt(elem_vt')
               typed_data' = llvm::LLVMBuildPointerCast(cg.builder, base_data',
                  llvm::LLVMPointerType(elem_ll', 0), "slice.data.typed")
               view_data_typed = types::gep1(cg, elem_ll', typed_data', final_start',
                  "slice.elem.gep")
               view_data' = llvm::LLVMBuildPointerCast(cg.builder,
                  view_data_typed,
                  llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0),
                  "slice.view.data")
               slice' = codegen_call_arena_alloc(cg,
                  llvm::LLVMConstInt(i64t', 16, 0), "slice.alloc")
               llvm::LLVMBuildStore(cg.builder, view_data',
                  llvm::LLVMBuildStructGEP2(cg.builder, cg.slice_t, slice', 0,
                     "slice.data.gep"))
               llvm::LLVMBuildStore(cg.builder, view_len',
                  llvm::LLVMBuildStructGEP2(cg.builder, cg.slice_t, slice', 1,
                     "slice.len.gep"))
               (slice', ast::ValueType(Slice))
            |
               is_arr
                  |
                     base_len' = main::builder_len(cg, tv.0, "a.view.len")
                     clamped' = main::codegen_clamp_slice_range(cg, s_val,
                        e_val_explicit, has_start', has_end', base_len')
                     final_start' = clamped'.0
                     view_len' = clamped'.1
                     base_data' = main::builder_data(cg, tv.0, "a.view.data")
                     elem_off = llvm::LLVMBuildMul(cg.builder, final_start',
                        llvm::LLVMConstInt(i64t', 8, 0), "a.view.off")
                     byte_off = stmt::codegen_add_checked_u64(cg, elem_off,
                        llvm::LLVMConstInt(i64t', 0, 0), "a.view.off")
                     view_data' = types::gep1(cg, llvm::LLVMInt8Type!, base_data',
                        byte_off, "a.view.data")
                     slice' = codegen_call_arena_alloc(cg,
                        llvm::LLVMConstInt(i64t', 16, 0), "a.view.slice")
                     llvm::LLVMBuildStore(cg.builder, view_data',
                        llvm::LLVMBuildStructGEP2(cg.builder, cg.slice_t,
                           slice', 0, "a.view.data.gep"))
                     llvm::LLVMBuildStore(cg.builder, view_len',
                        llvm::LLVMBuildStructGEP2(cg.builder, cg.slice_t,
                           slice', 1, "a.view.len.gep"))
                     (slice', ast::ValueType(Slice))
                  |
                     is_rec
                        |
                           target_name = target.kind [Var v] v.0 | ""
                           fvs = target_name != ""
                              | match::var_fvts(cg, target_name)
                              | ast::VTypes()
                           rec_nf = target.ti [Rec r] ?r.0 | 0
                           rec_count = ?fvs > 0 | ?fvs | rec_nf
                           base_len' = llvm::LLVMConstInt(i64t', rec_count, 0)
                           clamped' = main::codegen_clamp_slice_range(cg, s_val,
                              e_val_explicit, has_start', has_end', base_len')
                           final_start' = clamped'.0
                           view_len' = clamped'.1
                           fvs_elem = ?fvs > 0
                              | fvs(0) | _ | ast::ValueType(Int)
                              | ast::ValueType(Int)
                           elem_vt' = ti [Rec r] r.3 | fvs_elem
                           elem_ll' = types::llvm_type_of_vt(elem_vt')
                           typed_arr' = llvm::LLVMBuildPointerCast(cg.builder,
                              tv.0, llvm::LLVMPointerType(elem_ll', 0),
                              "rec.typed")
                           elem_gep' = types::gep1(cg, elem_ll', typed_arr',
                              final_start', "rec.elem.gep")
                           view_data' = llvm::LLVMBuildPointerCast(cg.builder,
                              elem_gep',
                              llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0),
                              "rec.view.data")
                           slice' = codegen_call_arena_alloc(cg,
                              llvm::LLVMConstInt(i64t', 16, 0),
                              "rec.view.slice")
                           llvm::LLVMBuildStore(cg.builder, view_data',
                              llvm::LLVMBuildStructGEP2(cg.builder, cg.slice_t,
                                 slice', 0, "rec.view.data.gep"))
                           llvm::LLVMBuildStore(cg.builder, view_len',
                              llvm::LLVMBuildStructGEP2(cg.builder, cg.slice_t,
                                 slice', 1, "rec.view.len.gep"))
                           (slice', ast::ValueType(Slice))
                        | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         is_str
            |
               i64t' = llvm::LLVMInt64Type!
               i8t = llvm::LLVMInt8Type!
               len_val = codegen_string_len(cg, tv.0, "s.read.len")
               data_ptr = codegen_string_data(cg, tv.0, "s.read.data")
               str_is_range = ret_vt [Str]
               str_is_range
                  |
                     i64_zero = llvm::LLVMConstInt(i64t', 0, 0)
                     b1_val' = index.kind [Bin b] (main::codegen_typed_eval(cg, b.1)) |
                        (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
                     b2_val' = index.kind [Bin b] (main::codegen_typed_eval(cg, b.2)) |
                        (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
                     has_start' = b1_val'.0 != Addr(0) && !(b1_val'.1 [Unit])
                     start_val = has_start'
                        | main::codegen_widen_idx_to_i64(cg, b1_val'.0, b1_val'.1,
                           "s.start")
                        | i64_zero
                     has_end' = b2_val'.0 != Addr(0) && !(b2_val'.1 [Unit])
                     end_val = has_end'
                        | main::codegen_widen_idx_to_i64(cg, b2_val'.0, b2_val'.1,
                           "s.end")
                        | i64_zero
                     clamped' = main::codegen_clamp_slice_range(cg, start_val,
                        end_val, has_start', has_end', len_val)
                     view_data' = types::gep1(cg, i8t, data_ptr, clamped'.0,
                        "view.data")
                     (codegen_string_build(cg, clamped'.1, view_data',
                        "str.view"), ast::ValueType(Str))
                  |
                     iv_str = main::codegen_typed_eval(cg, index)
                     idx_i64' = main::codegen_widen_idx_to_i64(cg, iv_str.0, iv_str.1,
                        "idx")
                     main::codegen_emit_runtime_bounds_check(cg, iv_str.0, iv_str.1,
                        len_val, "str_oob_msg")
                     byte_ptr = types::gep1(cg, i8t, data_ptr, idx_i64', "s.byte.gep")
                     byte_val = llvm::LLVMBuildLoad2(cg.builder, i8t, byte_ptr,
                        "s.byte")
                     (llvm::LLVMBuildZExt(cg.builder, byte_val, i64t',
                        "s.byte.val"), ast::ValueType(Int))
            |
               iv = main::codegen_typed_eval(cg, index)
               is_sl
                  |
                     data = main::slice_data(cg, tv.0, "slice.data")
                     elem_ll' = types::llvm_type_of_vt(ret_vt)
                     typed_data' = llvm::LLVMBuildPointerCast(cg.builder, data,
                        llvm::LLVMPointerType(elem_ll', 0), "slice.data.typed")
                     idx_i64' = main::codegen_widen_idx_to_i64(cg, iv.0, iv.1, "idx")
                     slot2 = types::gep1(cg, elem_ll', typed_data', idx_i64',
                        "slice.elem.gep")
                     ev' = llvm::LLVMBuildLoad2(cg.builder, elem_ll', slot2,
                        "slice.elem.val")
                     (ev', ret_vt)
                  |
                     is_arr
                        |
                           idx_i64' = main::codegen_widen_idx_to_i64(cg, iv.0, iv.1,
                              "idx")
                           elem_vt' = ti [Ram s] s.0.payload_type |
                              types::vt_from_ti(ti)
                           is_unboxed' = types::is_unboxed_ram_ti(cg, ti)
                           tgt_nm = target.kind [Var v] v.0 | ""
                           line' = target.line != 0 | target.line | index.line
                           col' = target.col != 0 | target.col | index.col
                           u' = is_unboxed'
                              | codegen_typed_array_index(cg, tv.0, idx_i64',
                                 elem_vt', tgt_nm, line', col')
                              | main::codegen_array_index(cg, tv.0, idx_i64', elem_vt',
                                 tgt_nm, line', col')
                           (u', ast::ValueType(Ram))
                        |
                           is_rec
                              |
                                 r_flds = target.ti [Rec r] r.0 |
                                    ast::FieldTypes()
                                 has_flds = ?r_flds > 0
                                 elem_ti = has_flds | r_flds(0)!!.rec_type |
                                    ast::TypeInfo(Prim, ret_vt)
                                 rm = runtime::record_meta_from_ti(cg, elem_ti)
                                 elem_ll' = rm.0 != Addr(0) | rm.0 |
                                    types::llvm_type_of_vt(ret_vt)
                                 idx_i64' = main::codegen_widen_idx_to_i64(cg, iv.0,
                                    iv.1, "idx")
                                 typed_arr' = llvm::LLVMBuildPointerCast(
                                    cg.builder, tv.0,
                                    llvm::LLVMPointerType(elem_ll', 0),
                                    "rec.typed")
                                 elem_gep' = types::gep1(cg, elem_ll', typed_arr',
                                    idx_i64', "rec.elem.gep")
                                 is_rec_elem = ret_vt [Record]
                                 is_rec_elem
                                    |
                                       cg.last_rt = elem_ll'
                                       efn = rec_elem_fnames(cg, elem_ll')
                                       cg.last_fnames = efn
                                       cg.last_fvts = types::field_vts(cg, elem_ti)
                                       (elem_gep', ret_vt)
                                    |
                                       ev' = llvm::LLVMBuildLoad2(cg.builder,
                                          elem_ll', elem_gep', "rec.elem.val")
                                       (ev', ret_vt)
                              |
                                 is_map = tv.1 [Map]
                                 is_map
                                    |
                                       val_vt = ti [Ram s] s.0.payload_type |
                                          ast::ValueType(Int)
                                       is_unboxed' = types::is_unboxed_ram_ti(cg, ti)
                                       line' = target.line != 0 | target.line |
                                          index.line
                                       col' = target.col != 0 | target.col |
                                          index.col
                                       u' = is_unboxed'
                                          | codegen_typed_map_lookup(cg, tv.0,
                                             iv.0, iv.1, val_vt, line', col')
                                          | runtime::codegen_map_lookup(cg, tv.0, iv.0,
                                             iv.1, val_vt, line', col')
                                       (u', ast::ValueType(Ram))
                                    |
                                       (llvm::LLVMConstInt(
                                          llvm::LLVMInt64Type!, 0, 0),
                                          ast::ValueType(Unknown))

codegen_typed_eval_index_write: types::Cg, tast::TypedExpr, tast::TypedExpr,
   tast::TypedExpr, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_index_write = cg, target, index, val, ti =>
   tv = main::codegen_typed_eval(cg, target)
   iv = main::codegen_typed_eval(cg, index)
   vv = main::codegen_typed_eval(cg, val)
   is_sl = tv.1 [Slice]
   is_sl
      |
         data' = main::slice_data(cg, tv.0, "slice.data")
         elem_ll' = types::llvm_type_of_vt(vv.1)
         typed_data = llvm::LLVMBuildPointerCast(cg.builder, data',
            llvm::LLVMPointerType(elem_ll', 0), "slice.data.typed")
         idx_i64' = main::codegen_widen_idx_to_i64(cg, iv.0, iv.1, "idx")
         slot2 = types::gep1(cg, elem_ll', typed_data, idx_i64', "slice.elem.gep")
         cval' = stmt::coerce_int_ext(cg, vv.0, elem_ll', types::is_unsigned_vt(vv.1))
         llvm::LLVMBuildStore(cg.builder, cval', slot2)
         (vv.0, vv.1)
      |
         is_arr = tv.1 [Array]
         is_arr
            |
               i64t' = llvm::LLVMInt64Type!
               data' = main::builder_data(cg, tv.0, "a.wr.data")
               idx_i64' = main::codegen_widen_idx_to_i64(cg, iv.0, iv.1, "idx")
               slot = types::gep1(cg, i64t', data', idx_i64', "a.elem.gep")
               val_st' = types::is_ptrish_vt(vv.1)
                  | llvm::LLVMBuildPtrToInt(cg.builder, vv.0, i64t', "a.wr.p2i")
                  | stmt::coerce_int(cg, vv.0, i64t')
               llvm::LLVMBuildStore(cg.builder, val_st', slot)
               is_ram = ti [Ram _]
               is_ram
                  |
                     is_unboxed = types::is_unboxed_ram_ti(cg, ti)
                     is_unboxed
                        | match::codegen_unboxed_ram_construct(cg, <+>, <-->, ti)
                        |
                           ram_res = match::codegen_typed_build_union(cg, 1, <-->,
                              "a.wr.succ")
                           (ram_res, ast::ValueType(Ram))
                  | (vv.0, vv.1)
            |
               is_rec = tv.1 [Record]
               is_rec
                  |
                     elem_ll' = types::llvm_type_of_vt(vv.1)
                     idx_i64' = main::codegen_widen_idx_to_i64(cg, iv.0, iv.1, "idx")
                     typed_arr = llvm::LLVMBuildPointerCast(cg.builder, tv.0,
                        llvm::LLVMPointerType(elem_ll', 0), "rec.typed")
                     elem_gep = types::gep1(cg, elem_ll', typed_arr, idx_i64',
                        "rec.elem.gep")
                     cval' = stmt::coerce_int_ext(cg, vv.0, elem_ll',
                        types::is_unsigned_vt(vv.1))
                     llvm::LLVMBuildStore(cg.builder, cval', elem_gep)
                     (vv.0, vv.1)
                  |
                     is_map = tv.1 [Map]
                     is_map
                        |
                           i64t' = llvm::LLVMInt64Type!
                           val_st' = types::is_ptrish_vt(vv.1)
                              | llvm::LLVMBuildPtrToInt(cg.builder, vv.0,
                                 i64t', "m.wr.p2i")
                              | stmt::coerce_int(cg, vv.0, i64t')
                           runtime::codegen_map_insert(cg, tv.0, iv.0, val_st', iv.1)
                           (vv.0, vv.1)
                        | (llvm::LLVMConstInt(llvm::LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_typed_eval_raw_write: types::Cg, tast::TypedExpr,
   tast::TypedExpr => (Addr, ast::ValueType)
codegen_typed_eval_raw_write = cg, addr_e, val_e =>
   av = main::codegen_typed_eval(cg, addr_e)
   vv = main::codegen_typed_eval(cg, val_e)
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   raw_addr = types::raw_addr_value(cg, av.0, av.1, i8p)
   elem_ty = runtime::raw_store_elem_type(vv.1, i8p)
   ptr_val = llvm::LLVMBuildPointerCast(cg.builder, raw_addr,
      llvm::LLVMPointerType(elem_ty, 0), "raw.wr.ptr")
   cval = stmt::coerce_int_ext(cg, vv.0, elem_ty, types::is_unsigned_vt(vv.1))
   llvm::LLVMBuildStore(cg.builder, cval, ptr_val)
   (vv.0, vv.1)

codegen_typed_array_index: types::Cg, Addr, Addr, ast::ValueType, String, Int,
   Int => Addr
codegen_typed_array_index = cg, a, idx, elem_vt, name, line, col =>
   i64t = llvm::LLVMInt64Type!
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   zero = llvm::LLVMConstInt(i64t, 0, 0)
   one = llvm::LLVMConstInt(i64t, 1, 0)
   nonnull = llvm::LLVMBuildICmp(cg.builder, 33, a,
      llvm::LLVMConstNull(i8p), "a.rd.nonnull")
   parent = llvm::LLVMGetBasicBlockParent(
      llvm::LLVMGetInsertBlock(cg.builder))
   check_bb = llvm::LLVMAppendBasicBlock(parent, "a.rd.check")
   ok_bb = llvm::LLVMAppendBasicBlock(parent, "a.rd.ok")
   null_bb = llvm::LLVMAppendBasicBlock(parent, "a.rd.err.null")
   oob_bb = llvm::LLVMAppendBasicBlock(parent, "a.rd.err.oob")
   done = llvm::LLVMAppendBasicBlock(parent, "a.rd.done")
   llvm::LLVMBuildCondBr(cg.builder, nonnull, check_bb, null_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, check_bb)
   len_v = main::builder_len(cg, a, "a.rd.len")
   ge0 = llvm::LLVMBuildICmp(cg.builder, 39, idx, zero, "a.rd.ge0")
   lt = llvm::LLVMBuildICmp(cg.builder, 40, idx, len_v, "a.rd.lt")
   in_bounds = llvm::LLVMBuildAnd(cg.builder, ge0, lt, "a.rd.bounds")
   llvm::LLVMBuildCondBr(cg.builder, in_bounds, ok_bb, oob_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, ok_bb)
   data = main::builder_data(cg, a, "a.rd.data")
   slot = types::gep1(cg, i64t, data, idx, "a.rd.elem.gep")
   ev = llvm::LLVMBuildLoad2(cg.builder, i64t, slot, "a.rd.elem")
   ok_end = llvm::LLVMGetInsertBlock(cg.builder)
   llvm::LLVMBuildBr(cg.builder, done)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, null_bb)
   err0 = main::codegen_build_error(cg, llvm::LLVMConstInt(i64t, 4011, 0),
      "array is not initialized", line, col, zero, zero)
   err0_i64 = llvm::LLVMBuildPtrToInt(cg.builder, err0, i64t, "err.p2i")
   null_end = llvm::LLVMGetInsertBlock(cg.builder)
   llvm::LLVMBuildBr(cg.builder, done)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, oob_bb)
   err1 = main::codegen_build_error(cg, llvm::LLVMConstInt(i64t, 4011, 0),
      "array index out of bounds", line, col, idx, len_v)
   err1_i64 = llvm::LLVMBuildPtrToInt(cg.builder, err1, i64t, "err.p2i")
   oob_end = llvm::LLVMGetInsertBlock(cg.builder)
   llvm::LLVMBuildBr(cg.builder, done)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, done)
   t1 = llvm::LLVMConstInt(llvm::LLVMInt1Type!, 1, 0)
   t0 = llvm::LLVMConstInt(llvm::LLVMInt1Type!, 0, 0)
   tag_phi = llvm::LLVMBuildPhi(cg.builder, llvm::LLVMInt1Type!, "a.rd.tag")
   stmt::llvm_add_incoming1(cg, tag_phi, t1, ok_end)
   stmt::llvm_add_incoming1(cg, tag_phi, t0, null_end)
   stmt::llvm_add_incoming1(cg, tag_phi, t0, oob_end)
   pay_phi = llvm::LLVMBuildPhi(cg.builder, i64t, "a.rd.pay")
   stmt::llvm_add_incoming1(cg, pay_phi, ev, ok_end)
   stmt::llvm_add_incoming1(cg, pay_phi, err0_i64, null_end)
   stmt::llvm_add_incoming1(cg, pay_phi, err1_i64, oob_end)
   st = match::unboxed_ram_struct_t(cg)
   u0 = llvm::LLVMConstNull(st)
   u1 = llvm::LLVMBuildInsertValue(cg.builder, u0, tag_phi, 0, "ram.tag")
   llvm::LLVMBuildInsertValue(cg.builder, u1, pay_phi, 1, "ram.pay")

codegen_typed_map_lookup: types::Cg, Addr, Addr, ast::ValueType, ast::ValueType,
   Int, Int => Addr
codegen_typed_map_lookup = cg, m, key_val, key_vt, val_vt, line, col =>
   i64t = llvm::LLVMInt64Type!
   i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
   mt = runtime::map_struct_type(cg)
   cap = llvm::LLVMBuildLoad2(cg.builder, i64t,
      llvm::LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.cap"), "m.cap")
   keys = llvm::LLVMBuildLoad2(cg.builder, i8p,
      llvm::LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.keys"), "m.keys")
   vals = llvm::LLVMBuildLoad2(cg.builder, i8p,
      llvm::LLVMBuildStructGEP2(cg.builder, mt, m, 3, "m.vals"), "m.vals")
   states = llvm::LLVMBuildLoad2(cg.builder, i8p,
      llvm::LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.states"), "m.states")
   hash = runtime::codegen_map_hash(cg, key_val, key_vt)
   one = llvm::LLVMConstInt(i64t, 1, 0)
   zero = llvm::LLVMConstInt(i64t, 0, 0)
   capm1 = llvm::LLVMBuildSub(cg.builder, cap, one, "m.capm1")
   idx0 = llvm::LLVMBuildAnd(cg.builder, hash, capm1, "m.idx0")
   cur = llvm::LLVMGetInsertBlock(cg.builder)
   loop = llvm::LLVMAppendBasicBlock(cg.current_fn, "m.rd.loop")
   probe = llvm::LLVMAppendBasicBlock(cg.current_fn, "m.rd.probe")
   found_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "m.rd.found")
   next = llvm::LLVMAppendBasicBlock(cg.current_fn, "m.rd.next")
   miss_bb = llvm::LLVMAppendBasicBlock(cg.current_fn, "m.rd.miss")
   done = llvm::LLVMAppendBasicBlock(cg.current_fn, "m.rd.done")
   llvm::LLVMBuildBr(cg.builder, loop)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, loop)
   idx_phi = llvm::LLVMBuildPhi(cg.builder, i64t, "m.rd.idx")
   stmt::llvm_add_incoming1(cg, idx_phi, idx0, cur)
   state = llvm::LLVMBuildLoad2(cg.builder, llvm::LLVMInt8Type!,
      types::gep1(cg, llvm::LLVMInt8Type!, states, idx_phi, "m.rd.state.gep"),
      "m.rd.state")
   is_empty = llvm::LLVMBuildICmp(cg.builder, 32, state,
      llvm::LLVMConstInt(llvm::LLVMInt8Type!, 0, 0), "m.rd.is.empty")
   is_tomb = llvm::LLVMBuildICmp(cg.builder, 32, state,
      llvm::LLVMConstInt(llvm::LLVMInt8Type!, 2, 0), "m.rd.is.tomb")
   llvm::LLVMBuildCondBr(cg.builder, is_empty, miss_bb, probe)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, probe)
   llvm::LLVMBuildCondBr(cg.builder, is_tomb, next, found_bb)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, found_bb)
   key_slot = types::gep1(cg, i8p, keys, idx_phi, "m.rd.key.slot")
   eq = runtime::codegen_map_key_equal(cg, key_slot, key_val, key_vt)
   hit = llvm::LLVMAppendBasicBlock(cg.current_fn, "m.rd.hit")
   llvm::LLVMBuildCondBr(cg.builder, eq, hit, next)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, next)
   idx_next = llvm::LLVMBuildAnd(cg.builder,
      llvm::LLVMBuildAdd(cg.builder, idx_phi, one, "m.rd.idx.add"), capm1,
      "m.rd.idx.next")
   stmt::llvm_add_incoming1(cg, idx_phi, idx_next, next)
   llvm::LLVMBuildBr(cg.builder, loop)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, hit)
   val_is_ptr = types::is_ptrish_vt(val_vt)
   val = val_is_ptr
      | llvm::LLVMBuildLoad2(cg.builder, i8p,
         types::gep1(cg, i8p, vals, idx_phi, "m.rd.val.slot"), "m.rd.val")
      | llvm::LLVMBuildLoad2(cg.builder, i64t,
         types::gep1(cg, i64t, vals, idx_phi, "m.rd.val.slot"), "m.rd.val")
   hit_pay = val_is_ptr
      | llvm::LLVMBuildPtrToInt(cg.builder, val, i64t, "m.rd.p2i")
      | val
   hit_end = llvm::LLVMGetInsertBlock(cg.builder)
   llvm::LLVMBuildBr(cg.builder, done)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, miss_bb)
   err = main::codegen_build_error(cg, llvm::LLVMConstInt(i64t, 4013, 0),
      "key not found", line, col, zero, zero)
   err_i64 = llvm::LLVMBuildPtrToInt(cg.builder, err, i64t, "err.p2i")
   miss_end = llvm::LLVMGetInsertBlock(cg.builder)
   llvm::LLVMBuildBr(cg.builder, done)
   llvm::LLVMPositionBuilderAtEnd(cg.builder, done)
   t1 = llvm::LLVMConstInt(llvm::LLVMInt1Type!, 1, 0)
   t0 = llvm::LLVMConstInt(llvm::LLVMInt1Type!, 0, 0)
   tag_phi = llvm::LLVMBuildPhi(cg.builder, llvm::LLVMInt1Type!, "m.rd.tag")
   stmt::llvm_add_incoming1(cg, tag_phi, t1, hit_end)
   stmt::llvm_add_incoming1(cg, tag_phi, t0, miss_end)
   pay_phi = llvm::LLVMBuildPhi(cg.builder, i64t, "m.rd.pay")
   stmt::llvm_add_incoming1(cg, pay_phi, hit_pay, hit_end)
   stmt::llvm_add_incoming1(cg, pay_phi, err_i64, miss_end)
   st = match::unboxed_ram_struct_t(cg)
   u0 = llvm::LLVMConstNull(st)
   u1 = llvm::LLVMBuildInsertValue(cg.builder, u0, tag_phi, 0, "ram.tag")
   llvm::LLVMBuildInsertValue(cg.builder, u1, pay_phi, 1, "ram.pay")

codegen_typed_eval_cast: types::Cg, ast::ValueType,
   tast::TypedExpr => (Addr, ast::ValueType)
codegen_typed_eval_cast = cg, target_vt, arg =>
   aev = main::codegen_typed_eval(cg, arg)
   is_flag_tgt = target_vt [Flag]
   is_flag_tgt
      |
         (types::codegen_cond_value_with_ti(cg, aev.0, aev.1, arg.ti),
            ast::ValueType(Flag))
      | codegen_typed_eval_cast_other(cg, target_vt, aev)

codegen_typed_eval_cast_other: types::Cg, ast::ValueType,
   (Addr, ast::ValueType) => (Addr, ast::ValueType)
codegen_typed_eval_cast_other = cg, target_vt, aev =>
   is_f32_tgt = target_vt [F32]
   is_f32_tgt
      |
         types::is_int_vt(aev.1)
            |
               (llvm::LLVMBuildSIToFP(cg.builder, aev.0, llvm::LLVMFloatType!,
                  "cast.sitofp"), ast::ValueType(F32))
            |
               is_f64 = aev.1 [Float]
               is_f64
                  |
                     (llvm::LLVMBuildFPTrunc(cg.builder, aev.0,
                        llvm::LLVMFloatType!, "cast.fptrunc"),
                        ast::ValueType(F32))
                  | (aev.0, ast::ValueType(F32))
      |
         is_flt_tgt = target_vt [Float]
         is_flt_tgt
            |
               types::is_int_vt(aev.1)
                  |
                     (llvm::LLVMBuildSIToFP(cg.builder, aev.0,
                        llvm::LLVMDoubleType!, "cast.sitofp"),
                        ast::ValueType(Float))
                  |
                     is_f32_src = aev.1 [F32]
                     is_f32_src
                        |
                           (llvm::LLVMBuildFPExt(cg.builder, aev.0,
                              llvm::LLVMDoubleType!, "cast.fpext"),
                              ast::ValueType(Float))
                        | (aev.0, ast::ValueType(Float))
            |
               is_int_tgt = target_vt [Int]
               is_int_tgt
                  |
                     types::is_float_vt(aev.1)
                        | (llvm::LLVMBuildFPToSI(cg.builder, aev.0,
                             llvm::LLVMInt64Type!, "cast.fptosi"),
                             ast::ValueType(Int))
                        | (stmt::coerce_int_ext(cg, aev.0, llvm::LLVMInt64Type!,
                             types::is_unsigned_vt(aev.1)),
                             ast::ValueType(Int))
                  |
                     is_ptr_tgt = target_vt [RawPtr]
                     is_ptr_tgt
                        |
                           i8p = llvm::LLVMPointerType(llvm::LLVMInt8Type!, 0)
                           is_int_arg = types::is_int_vt(aev.1) ||
                              (aev.0 != Addr(0) &&
                                 llvm::LLVMGetTypeKind(
                                    llvm::LLVMTypeOf(aev.0)) == 8)
                           is_int_arg
                              | (llvm::LLVMBuildIntToPtr(cg.builder, aev.0,
                                   i8p, "cast.int2ptr"),
                                   ast::ValueType(RawPtr))
                              | (aev.0, ast::ValueType(RawPtr))
                        |
                           is_intish = types::is_int_vt(target_vt)
                           is_intish
                              | (stmt::coerce_int_ext(cg, aev.0,
                                   types::llvm_type_of_vt(target_vt),
                                   types::is_unsigned_vt(aev.1)),
                                   target_vt)
                              | (aev.0, target_vt)

