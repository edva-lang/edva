// codegen/stmt.dva

#use(import) llvm
#use "../ast"
#use "str"
#use "../tast"
#use "../unify"
#use "mem"
#use "types"
#use "runtime"
#use "expr"
#use "match"
#use "main"

#public

#foreign "c"
   write: (fd: Int, buf: Addr, count: Int) => Int
   dva_arena_current: () => Addr
   rename: (oldpath: String, newpath: String) => Int
   unlink: (path: String) => Int

#type Cg types::Cg
#type CodegenOpts types::CodegenOpts
#type CgVar types::CgVar
#type CgVars types::CgVars
#type TypeDef types::TypeDef
#type TypeDefs types::TypeDefs
#type TypeIndex types::TypeIndex
#type FnInfo types::FnInfo
#type FnInfos types::FnInfos
#type FnDef types::FnDef
#type FnDefs types::FnDefs
#type FnNameIndex types::FnNameIndex
#type BindingMut types::BindingMut
#type BindingMuts types::BindingMuts
#type BindingState types::BindingState
#type ParamRec types::ParamRec
#type ParamRecs types::ParamRecs
#type FnRetRec types::FnRetRec
#type FnRetRecs types::FnRetRecs
#type Addrs types::Addrs
#type IntArr types::IntArr
#type FieldInitState types::FieldInitState
#type ChoiceInitFrame types::ChoiceInitFrame
#type ChoiceInitFrames types::ChoiceInitFrames
#type LambdaEnvInfo types::LambdaEnvInfo
#type LambdaEnvInfos types::LambdaEnvInfos
#type Flags types::Flags
#type FnValueMeta types::FnValueMeta

c_str: Addr => String
c_str = raw => types::c_str(raw)

dbg: String => Int
dbg = s => types::dbg(s)

empty_fndef: FnDef
empty_fndef = FnDef(("", ast::Names(), ast::Expr(Var, "")))

#private
   print: String => Int
   print = s =>
      b = {?s + 1}
      b += s
      b += 10
      write(1, &b, ?b)

#public

// --- Module Implementation -------------------------------------------------

closure_struct_type: types::Cg => Addr
closure_struct_type = cg =>
   cg.closure_t
      | _
      |
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         tarr = types::Addrs()
         tarr += i8p
         tarr += i8p
         st = types::struct_type_n(cg, tarr, 2)
         cg.closure_t = <+ st ->
         st

// Allocates a { fn_ptr, env_ptr } closure and returns its pointer.
codegen_build_closure: types::Cg, Addr, Addr, String => Addr
codegen_build_closure = cg, fn_ptr, env_ptr, name =>
   i64t = LLVMInt64Type!
   cp = expr::codegen_call_arena_alloc(cg,
      LLVMConstInt(i64t, 16, 0), name + ".alloc")
   LLVMBuildStore(cg.builder, fn_ptr,
      LLVMBuildStructGEP2(cg.builder, closure_struct_type(cg), cp, 0, "clo.fn.gep"))
   LLVMBuildStore(cg.builder, env_ptr,
      LLVMBuildStructGEP2(cg.builder, closure_struct_type(cg), cp, 1, "clo.env.gep"))
   cp

// The fn_ptr / env_ptr of a closure value.
closure_fn_ptr: types::Cg, Addr, String => Addr
closure_fn_ptr = cg, clo, name =>
   LLVMBuildLoad2(cg.builder, LLVMPointerType(LLVMInt8Type!, 0),
      LLVMBuildStructGEP2(cg.builder, closure_struct_type(cg), clo, 0, name + ".gep"), name)

closure_env_ptr: types::Cg, Addr, String => Addr
closure_env_ptr = cg, clo, name =>
   LLVMBuildLoad2(cg.builder, LLVMPointerType(LLVMInt8Type!, 0),
      LLVMBuildStructGEP2(cg.builder, closure_struct_type(cg), clo, 1, name + ".gep"), name)

// Whether the lambda's body references an enclosing local `name`.
refs_name: ast::Expr, String => <>
refs_name = e, name =>
   e
      [Var v] v == name
      [Fn f] !param_in(f.params, name) && refs_name(f.body, name)
      [Bin t] refs_name(t.1, name) || refs_name(t.2, name)
      [Unary t] refs_name(t.1, name)
      [Call t]
         t.fn_name == name || refs_name_exprs(t.args, name)
      [Member t] refs_name(t.target, name)
      [Record r] refs_name_fields(r.fields, name)
      [Choice c]
         refs_name(c.cond, name) || refs_name_branches(c.branches, name)
      [Cycle c] refs_name(c.iterable, name) || refs_name(c.body_fn, name)
      [Block b] refs_name_exprs(b.exprs, name)
      [Assign t] t.0 == name || refs_name(t.5, name) || refs_name(t.6, name)
      [Copy ce] refs_name(ce, name)
      [TypeCast tc] refs_name(tc.expr, name)
      [CycleEscape esc]
         refs_name(esc.cycle, name) || refs_name(esc.branch, name)
      [RawMemory rm] refs_name(rm.addr, name)
      [BuilderCreate bc] refs_name(bc, name)
      [Variant va] refs_name_exprs(va.args, name)
      [KeyAccess ka] refs_name(ka.target, name) || refs_name(ka.key, name)
      [Range r]
         (r.has_lhs && refs_name(r.lhs, name)) ||
            (r.has_rhs && refs_name(r.rhs, name))
      | <->

refs_name_exprs: ast::Exprs, String => <>
refs_name_exprs = es, name =>
   refs_name_exprs_at(es, name, 0, ?es)

refs_name_exprs_at: ast::Exprs, String, Int, Int => <>
refs_name_exprs_at = es, name, i, n =>
   i == n
      | <->
      |
         refs_name(es(i)!!, name)
            | <+>
            | refs_name_exprs_at(es, name, i + 1, n)

refs_name_fields: ast::Fields, String => <>
refs_name_fields = fs, name =>
   refs_name_fields_at(fs, name, 0, ?fs)

refs_name_fields_at: ast::Fields, String, Int, Int => <>
refs_name_fields_at = fs, name, i, n =>
   i == n
      | <->
      |
         rf = fs(i)!!
         refs_name(rf.val, name)
            | <+>
            | refs_name_fields_at(fs, name, i + 1, n)

refs_name_branches: ast::Branches, String => <>
refs_name_branches = bs, name =>
   refs_name_branches_at(bs, name, 0, ?bs)

refs_name_branches_at: ast::Branches, String, Int, Int => <>
refs_name_branches_at = bs, name, i, n =>
   i == n
      | <->
      |
         b = bs(i)!!
         refs_name_exprs(b.case_values, name) || refs_name(b.pred_fn, name) ||
            refs_name(b.block, name)
            | <+>
            | refs_name_branches_at(bs, name, i + 1, n)

lambda_captures_at: types::Cg, ast::FnExpr, Int, Int, ast::Names => ast::Names
lambda_captures_at = cg, f, i, n, acc =>
   i == n
      | acc
      |
         cv = cg.vars(i)!!
         (cv.is_local && !param_in(f.params, cv.name) && refs_name(f.body, cv.name))
            | acc += cv.name
         lambda_captures_at(cg, f, i + 1, n, acc)

// The enclosing-function locals a lambda captures: locals (non-global) in the
// active scope that are not the lambda's own params and are referenced in its
// body.
lambda_captures: types::Cg, ast::FnExpr => ast::Names
lambda_captures = cg, f =>
   lambda_captures_at(cg, f, cg.fn_var_start, ?cg.vars, ast::Names())

param_in: ast::Names, String => <>
param_in = ps, name => param_in_at(ps, name, 0, ?ps)

param_in_at: ast::Names, String, Int, Int => <>
param_in_at = ps, name, i, n =>
   i == n
      | <->
      |
         (ps(i) | _ | "") == name
            | <+>
            | param_in_at(ps, name, i + 1, n)

lambda_add_caps: types::Cg, ast::Names, ast::VTypes, Addr, Addr, Int, Int => ()
lambda_add_caps = cg, caps, cap_vts, est, ep, j, nc =>
   j != nc
      |
         cname = caps(j) | _ | ""
         cvt = cap_vts(j) | _ | ast::ValueType(Unknown)
         cgep = LLVMBuildStructGEP2(cg.builder, est, ep, j, "env.gep")
         runtime::binding_add(cg, cname, <+>)
         types::init_mark_whole(cg, cname)
         crt = types::var_rt(cg, cname)
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         cell_slot = ast::is_cell_var(cname)
            |
               raw_ptr = LLVMBuildLoad2(cg.builder, i8p, cgep, "cell.load.ptr")
               elem_ty = types::llvm_type_of_vt(cvt)
               LLVMBuildPointerCast(cg.builder, raw_ptr,
                  LLVMPointerType(elem_ty, 0), "cell.ptr")
            | cgep
         cg.vars += types::CgVar((cname, cvt, types::var_is_heap(cg, cname),
            types::var_dtype(cg, cname), crt, types::var_fnames(cg, cname),
            <+ cell_slot ->, <+>, <->, match::var_fvts(cg, cname), <-->))
         lambda_add_caps(cg, caps, cap_vts, est, ep, j + 1, nc)

lambda_add_params: types::Cg, Addr, ast::Names, ast::VTypes, <>, Int, Int => ()
lambda_add_params = cg, fn, params, ptypes, is_cap, i, np =>
   i != np
      |
         pname = (params(i) | _ | "")
         pname != "" && pname != "_"
            |
               types::is_any_fn_name(cg, pname) || runtime::binding_state(cg, pname).found
                  |
                     types::init_error(cg, "E3033",
                        "Cannot re-assign immutable binding '" + pname +
                        "'. Use a prime suffix ('" + pname +
                        "\'') for rebindable variables.", 0, 0)
               runtime::binding_add(cg, pname, <->)
         pv = LLVMGetParam(fn, (is_cap | i + 1 | i))
         pvt = (ptypes(i) | _ | ast::ValueType(Unknown))
         cg.vars += types::CgVar((pname, pvt, <->, "", <-->,
            ast::Names(), <-->, <+>, <->, ast::VTypes(), <+ pv ->))
         lambda_add_params(cg, fn, params, ptypes, is_cap, i + 1, np)

lambda_env_add: String, Addr, Int, ast::VTypes => ()
lambda_env_add = name, est, nc, vts =>
   types::g.lambda_env_infos += types::LambdaEnvInfo((name, est, nc, vts))

lambda_env_find: String => <types::LambdaEnvInfo|>
lambda_env_find = name =>
   lambda_env_find_at(name, 0, ?types::g.lambda_env_infos)

lambda_env_find_at: String, Int, Int => <types::LambdaEnvInfo|>
lambda_env_find_at = name, i, n =>
   i == n
      | <-->
      |
         lei = types::g.lambda_env_infos(i)!!
         lei.name == name
            | <+ lei ->
            | lambda_env_find_at(name, i + 1, n)

lambda_env_index: String => Int
lambda_env_index = name =>
   lambda_env_index_at(name, 0, ?types::g.lambda_env_infos)

lambda_env_index_at: String, Int, Int => Int
lambda_env_index_at = name, i, n =>
   i == n
      | -1
      |
         lei = types::g.lambda_env_infos(i)!!
         lei.name == name
            | i
            | lambda_env_index_at(name, i + 1, n)

lambda_caps_types_at: types::Cg, ast::Names, Int, Int, types::Addrs => types::Addrs
lambda_caps_types_at = cg, caps, j, n, acc =>
   j == n
      | acc
      |
         cname = caps(j) | _ | ""
         ast::is_cell_var(cname)
            | acc += LLVMPointerType(LLVMInt8Type!, 0)
            | acc += types::llvm_type_of_vt(types::var_type(cg, cname))
         lambda_caps_types_at(cg, caps, j + 1, n, acc)

lambda_param_ll_at: ast::Names, ast::VTypes, Int, Int, types::Addrs => types::Addrs
lambda_param_ll_at = params, ptypes, i, n, acc =>
   i == n
      | acc
      |
         acc += types::llvm_type_of_vt((ptypes(i) | _ | ast::ValueType(Unknown)))
         lambda_param_ll_at(params, ptypes, i + 1, n, acc)

lambda_load_caps_at: types::Cg, ast::Names, Int, Int, types::Addrs => types::Addrs
lambda_load_caps_at = cg, caps, j, n, acc =>
   j == n
      | acc
      |
         cname = caps(j) | _ | ""
         ast::is_cell_var(cname)
            |
               s_opt = types::var_slot(cg, cname)
               s_opt
                  | s =>
                     i8p = LLVMPointerType(LLVMInt8Type!, 0)
                     acc += LLVMBuildPointerCast(cg.builder, s, i8p, "cell.slot.ptr")
            |
               cv2 = types::codegen_load(cg, cname)
               cv2 | c => acc += c.0
         lambda_load_caps_at(cg, caps, j + 1, n, acc)

lambda_caps_vts_at: types::Cg, ast::Names, Int, Int, ast::VTypes => ast::VTypes
lambda_caps_vts_at = cg, caps, j, n, acc =>
   j == n
      | acc
      |
         acc += types::var_type(cg, (caps(j) | _ | ""))
         lambda_caps_vts_at(cg, caps, j + 1, n, acc)

lambda_store_caps_at: types::Cg, ast::Names, types::Addrs, Addr, Addr, Int, Int => ()
lambda_store_caps_at = cg, caps, cap_vals, est, ep2, j, n =>
   j != n
      |
         LLVMBuildStore(cg.builder, cap_vals(j)!!,
            LLVMBuildStructGEP2(cg.builder, est, ep2, j, "env.store.gep"))
         lambda_store_caps_at(cg, caps, cap_vals, est, ep2, j + 1, n)

// Compiles a lambda used as a VALUE into a fn (with an implicit first env
// param when it captures enclosing locals), packages its environment + the
// { fn_ptr, env_ptr } closure, and returns (closure_ptr, synthetic fn name).
compile_lambda: types::Cg, ast::FnExpr => (Addr, String)
compile_lambda = cg, f =>
   saved_nvars = ?cg.vars
   saved_var_start = cg.fn_var_start
   saved_nbindings = ?cg.bindings
   saved_binding_start = cg.fn_binding_start
   saved_nviews = ?types::g.view_var_names
   caps = lambda_captures(cg, f)
   nc = ?caps
   is_cap = nc > 0
   cap_names = ast::Names()
   cap_types = ast::VTypes()
   nc @ ci =>
      cname = (caps(ci) | _ | "")
      types::is_view_var(cname)
         | types::init_error(cg, "E3150", "View cannot escape function frame", 0, 0)
      cap_names += cname
      cap_types += types::var_type(cg, cname)
   fnname = "__anon_fn_" + str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   exp_ti = types::g.expected_fn_ti
   exp_ptypes = exp_ti [Fn f_info] f_info.0 | ast::VTypes()
   exp_ret_vt = exp_ti [Fn f_info] f_info.2 | ast::ValueType(Unknown)
   exp_ret_ti = exp_ti [Fn f_info] f_info.3 |
      ast::TypeInfo(Prim, ast::ValueType(Unknown))
   has_exp = ?exp_ptypes > 0
   ptypes = has_exp
      | exp_ptypes
      | infer_param_types_env(types::FnDef((fnname, f.params, f.body)), ast::VTypes(), cap_names, cap_types)
   all_params = ast::Names()
   ?f.params @ pi => all_params += (f.params(pi) | _ | "")
   all_ptypes = ast::VTypes()
   ?ptypes @ pti => all_ptypes += (ptypes(pti) | _ | ast::ValueType(Unknown))
   nc @ c2i =>
      all_params += (cap_names(c2i) | _ | "")
      all_ptypes += (cap_types(c2i) | _ | ast::ValueType(Unknown))
   ret_vt' = exp_ret_vt != ast::ValueType(Unknown)
      | exp_ret_vt
      | infer_ret(f.body, all_params, all_ptypes)
   ret_vt' = fn_ret_override(cg, f.body, ret_vt')
   ret_ll = ret_vt' [Fn] LLVMInt64Type! | types::llvm_type_of_vt(ret_vt')
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   cap_tys = lambda_caps_types_at(cg, caps, 0, nc, types::Addrs())
   est_opt = is_cap | <+ types::struct_type_n(cg, cap_tys, nc) -> | <-->
   param_ll_base = types::Addrs()
   is_cap | param_ll_base += i8p
   param_ll = lambda_param_ll_at(f.params, ptypes, 0, ?f.params, param_ll_base)
   np = ?f.params
   fty = fn_type_n(cg, ret_ll, param_ll, (is_cap | np + 1 | np))
   fn = LLVMAddFunction(cg.module, fnname, fty)
   LLVMSetLinkage(fn, 8)
   runtime::mark_nounwind(cg, fn)
   saved_fn = cg.current_fn
   saved_bb = LLVMGetInsertBlock(cg.builder)
   saved_in_fn = cg.in_fn
   // Read the captured values from the ENCLOSING scope while they are still
   // live (before the lambda body's shadowing removes them).
   cap_vals = is_cap | lambda_load_caps_at(cg, caps, 0, nc, types::Addrs()) | types::Addrs()
   cap_vts = is_cap
      | lambda_caps_vts_at(cg, caps, 0, nc, ast::VTypes())
      | ast::VTypes()
   cg.current_fn = fn
   cg.in_fn = <+>
   cg.fn_var_start = saved_nvars
   cg.fn_binding_start = saved_nbindings
   entry = LLVMAppendBasicBlock(fn, "entry")
   LLVMPositionBuilderAtEnd(cg.builder, entry)
   est_opt
      | est =>
         ep = LLVMBuildBitCast(cg.builder, LLVMGetParam(fn, 0),
            LLVMPointerType(est, 0), "cap.env")
         lambda_add_caps(cg, caps, cap_vts, est, ep, 0, nc)
   lambda_add_params(cg, fn, f.params, ptypes, is_cap, 0, np)
   saved_discard = cg.discard_result
   is_disc = ret_vt' [Unit]
   cg.discard_result = is_disc
   saved_exp = types::g.expected_fn_ti
   saved_ret_ll = types::g.fn_ret_ll
   types::g.expected_fn_ti = exp_ret_ti
   types::g.fn_ret_ll = <+ ret_ll ->
   bv = expr::codegen_eval(cg, f.body)
   types::g.expected_fn_ti = saved_exp
   types::g.fn_ret_ll = saved_ret_ll
   cg.discard_result = saved_discard
   types::is_view_expr(cg, f.body)
      | types::init_error(cg, "E3150", "View cannot escape function frame", 0, 0)
   is_void = ret_vt' [Unit]
   is_void
      | !block_is_terminated(cg) | LLVMBuildRetVoid(cg.builder)
      |
         !block_is_terminated(cg)
            |
               ret_v = (ret_vt' [Fn] LLVMBuildPtrToInt(cg.builder, bv.0,
                  LLVMInt64Type!, "ret.int") | coerce_int(cg, bv.0, ret_ll))
               LLVMBuildRet(cg.builder, ret_v)
   cg.fninfos += types::FnInfo((fnname, <+ fn ->, <+ fty ->, np, ptypes, ret_vt', <->, <->,
      <+>, !is_cap))
   is_fn_ret = main::is_fn_vt(bv.1) || main::is_fn_vt(ret_vt')
   is_fn_ret && (cg.last_closure_fn != "")
      | fn_ret_fn_add(fnname, cg.last_closure_fn)
   types::g.view_var_names = types::truncate_names(types::g.view_var_names, saved_nviews)
   cg.vars = truncate_vars(cg.vars, saved_nvars)
   cg.bindings = runtime::binding_truncate(cg.bindings, saved_nbindings)
   cg.fn_var_start = saved_var_start
   cg.fn_binding_start = saved_binding_start
   cg.in_fn = saved_in_fn
   cg.current_fn = saved_fn
   LLVMPositionBuilderAtEnd(cg.builder, saved_bb)
   envp' = LLVMConstNull(i8p)
   est_opt
      | est =>
         ep2 = expr::codegen_call_arena_alloc(cg,
            LLVMConstInt(LLVMInt64Type!, nc * 8, 0), "env.alloc")
         lambda_store_caps_at(cg, caps, cap_vals, est, ep2, 0, nc)
         envp' = ep2
         lambda_env_add(fnname, est, nc, cap_vts)
   fptr = LLVMBuildBitCast(cg.builder, fn, i8p, "fn.ptr")
   clo = is_cap
      | codegen_build_closure(cg, fptr, envp', "clo")
      | expr::noncap_closure(cg, fnname, fn)
   (clo, fnname)

// The field type at index `i` of the env struct (built from the capture types).
ety2: Addr, Int => Addr
ety2 = est, i =>
   LLVMStructGetTypeAtIndex(est, i)

remove_var_at: types::CgVars, String, Int, Int, types::CgVars => types::CgVars
remove_var_at = vars, name, i, n, acc =>
   i == n
      | acc
      |
         v = vars(i)!!
         v.name != name | acc += v
         remove_var_at(vars, name, i + 1, n, acc)

// Removes all CgVars named `name` (so a lambda's capture shadows the outer
// binding instead of the first-match var accessor resolving the stale one).
remove_var: types::CgVars, String => types::CgVars
remove_var = vars, name =>
   remove_var_at(vars, name, 0, ?vars, types::CgVars())

// The runtime String value for a literal: a pointer to a const {len, data}
// struct over a NUL-reserved byte array.
find_string_literal: types::Cg, String, Int => <Addr|>
find_string_literal = cg, s, i =>
   i == ?cg.strvals
      | <-->
      |
         cg.strvals(i)!! == s
            | <+ cg.strglobals(i)!! ->
            | find_string_literal(cg, s, i + 1)

codegen_string_literal: types::Cg, String => Addr
codegen_string_literal = cg, s =>
   find_string_literal(cg, s, 0)
      | _
      | codegen_string_literal_new(cg, s)

codegen_string_literal_new: types::Cg, String => Addr
codegen_string_literal_new = cg, s =>
   len = ?s
   arr_t = LLVMArrayType(LLVMInt8Type!, len + 1)
   gname = "str." + str::from_int(cg.strn)
   gv = LLVMAddGlobal(cg.module, arr_t, gname)
   LLVMSetInitializer(gv, LLVMConstString(s, len, 0))
   LLVMSetGlobalConstant(gv, 1)
   LLVMSetUnnamedAddr(gv, 1)
   LLVMSetLinkage(gv, 8)
   zero = LLVMConstInt(LLVMInt64Type!, 0, 0)
   idx = {16}
   sb = &idx
   @[sb] = zero
   @[sb + 8] = zero
   data_p = LLVMConstGEP2(arr_t, gv, sb, 2)
   sname = "str." + str::from_int(cg.strn) + ".struct"
   sg = LLVMAddGlobal(cg.module, cg.str_t, sname)
   elems = {16}
   esb = &elems
   @[esb] = LLVMConstInt(LLVMInt64Type!, len, 0)
   @[esb + 8] = data_p
   LLVMSetInitializer(sg, LLVMConstStruct(esb, 2, 0))
   LLVMSetGlobalConstant(sg, 1)
   LLVMSetUnnamedAddr(sg, 1)
   LLVMSetLinkage(sg, 8)
   cg.strn = cg.strn + 1
   cg.strvals += ++s
   cg.strglobals += sg
   sg

// Abort a checked String-size operation. The terminating call is followed by
// a branch in the caller so the IR verifier has a successor for the dead path.
emit_str_overflow_abort: types::Cg => ()
emit_str_overflow_abort = cg =>
   runtime::emit_abort_msg(cg, "E4002: string length overflow (concatenation exceeds 64-bit capacity)\n", "str_overflow_msg")

// Emits an unsigned checked add and leaves the builder in the non-overflow
// continuation block. The intrinsic guards the arena allocation that follows.
codegen_add_checked_u64: types::Cg, Addr, Addr, String => Addr
codegen_add_checked_u64 = cg, a, b, name =>
   i64t = LLVMInt64Type!
   ovf_t = types::struct_type2(i64t, LLVMInt1Type!)
   fty = types::fn_type2(cg, ovf_t, i64t, i64t)
   args = {16}
   sb = &args
   @[sb] = a
   @[sb + 8] = b
   fn_opt = types::llvm_find_function(cg.module, "llvm.uadd.with.overflow.i64")
   uadd_fn = fn_opt | _ | LLVMAddFunction(cg.module, "llvm.uadd.with.overflow.i64", fty)
   res = LLVMBuildCall2(cg.builder, fty, uadd_fn, sb, 2, name)
   sum = LLVMBuildExtractValue(cg.builder, res, 0, "sum")
   ovf = LLVMBuildExtractValue(cg.builder, res, 1, "ovf")
   parent = LLVMGetBasicBlockParent(LLVMGetInsertBlock(cg.builder))
   ok_bb = LLVMAppendBasicBlock(parent, name)
   abort_bb = LLVMAppendBasicBlock(parent, "str_overflow_abort")
   LLVMBuildCondBr(cg.builder, ovf, abort_bb, ok_bb)
   LLVMPositionBuilderAtEnd(cg.builder, abort_bb)
   emit_str_overflow_abort(cg)
   LLVMBuildBr(cg.builder, ok_bb)
   LLVMPositionBuilderAtEnd(cg.builder, ok_bb)
   sum

// "s + t" — a fresh arena buffer with both spans copied (NUL-reserved).
codegen_string_concat: types::Cg, Addr, Addr => Addr
codegen_string_concat = cg, l, r =>
   ll = expr::codegen_string_len_data(cg, l, "concat.lhs")
   rl = expr::codegen_string_len_data(cg, r, "concat.rhs")
   sum = codegen_add_checked_u64(cg, ll.0, rl.0, "concat.sum.len")
   tot = codegen_add_checked_u64(cg, sum,
      LLVMConstInt(LLVMInt64Type!, 1, 0), "concat.tot.len")
   i8t = LLVMInt8Type!
   buf = expr::codegen_call_arena_alloc(cg, tot, "concat.buf")
   cg.error
      | expr::codegen_string_build(cg, sum, buf, "concat.str")
      |
         LLVMBuildMemCpy(cg.builder, buf, 1, ll.1, 1, ll.0, 0)
         mid = types::gep1(cg, i8t, buf, ll.0, "concat.mid")
         LLVMBuildMemCpy(cg.builder, mid, 1, rl.1, 1, rl.0, 0)
         nul = types::gep1(cg, i8t, buf, sum, "concat.nul")
         LLVMBuildStore(cg.builder, LLVMConstInt(i8t, 0, 0), nul)
         expr::codegen_string_build(cg, sum, buf, "concat.str")

// Content equality: length short-circuit, then memcmp.
codegen_string_eq: types::Cg, Addr, Addr => Addr
codegen_string_eq = cg, l, r =>
   ll = expr::codegen_string_len(cg, l, "eq.lhs.len")
   rl = expr::codegen_string_len(cg, r, "eq.rhs.len")
   len_eq = LLVMBuildICmp(cg.builder, 32, ll, rl, "eq.len")
   eq_bb = LLVMAppendBasicBlock(cg.current_fn, "str.eq.then")
   neq_bb = LLVMAppendBasicBlock(cg.current_fn, "str.eq.else")
   merge_bb = LLVMAppendBasicBlock(cg.current_fn, "str.eq.merge")
   LLVMBuildCondBr(cg.builder, len_eq, eq_bb, neq_bb)
   LLVMPositionBuilderAtEnd(cg.builder, eq_bb)
   ldata = expr::codegen_string_data(cg, l, "eq.lhs.data")
   rdata = expr::codegen_string_data(cg, r, "eq.rhs.data")
   cmp_res = types::call3(cg, cg.memcmp_t!!, cg.memcmp_fn!!, ldata, rdata, ll, "eq.memcmp")
   cmp_zero = LLVMBuildICmp(cg.builder, 32, cmp_res,
      LLVMConstInt(LLVMInt32Type!, 0, 0), "eq.cmp.zero")
   branch_to(cg, merge_bb)
   LLVMPositionBuilderAtEnd(cg.builder, neq_bb)
   branch_to(cg, merge_bb)
   LLVMPositionBuilderAtEnd(cg.builder, merge_bb)
   phi = LLVMBuildPhi(cg.builder, LLVMInt1Type!, "str.eq.result")
   llvm_add_incoming1(cg, phi, cmp_zero, eq_bb)
   llvm_add_incoming1(cg, phi, LLVMConstInt(LLVMInt1Type!, 0, 0), neq_bb)
   phi

codegen_string_append_rune: types::Cg, Addr, Addr => Addr
codegen_string_append_rune = cg, str_val, rune_val =>
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   valid = !cg.error && <>(types::llvm_val_opt(str_val)) && <>(types::llvm_val_opt(rune_val))
   !valid
      | LLVMConstNull(i8p)
      |
         i64t = LLVMInt64Type!
         i8t = LLVMInt8Type!
         r64 = coerce_int(cg, rune_val, i64t)
         slen = expr::codegen_string_len(cg, str_val, "s.len")
         sdata = expr::codegen_string_data(cg, str_val, "s.data")

         c1 = LLVMBuildICmp(cg.builder, 40, r64,
            LLVMConstInt(i64t, 0x80, 0), "sr.cmp1")
         c2 = LLVMBuildICmp(cg.builder, 40, r64,
            LLVMConstInt(i64t, 0x800, 0), "sr.cmp2")
         c3 = LLVMBuildICmp(cg.builder, 40, r64,
            LLVMConstInt(i64t, 0x10000, 0), "sr.cmp3")
         w3 = LLVMBuildSelect(cg.builder, c3,
            LLVMConstInt(i64t, 3, 0),
            LLVMConstInt(i64t, 4, 0), "sr.w3")
         w2 = LLVMBuildSelect(cg.builder, c2,
            LLVMConstInt(i64t, 2, 0), w3, "sr.w2")
         width = LLVMBuildSelect(cg.builder, c1,
            LLVMConstInt(i64t, 1, 0), w2, "sr.width")

         tot_len = codegen_add_checked_u64(cg, slen, width, "sr.tot.len")
         buf_size = codegen_add_checked_u64(cg, tot_len,
            LLVMConstInt(i64t, 1, 0), "sr.buf.size")
         buf = expr::codegen_call_arena_alloc(cg, buf_size, "sr.buf")
         LLVMBuildMemCpy(cg.builder, buf, 1, sdata, 1, slen, 0)
         dst = types::gep1(cg, i8t, buf, slen, "sr.dst")

         sc = str::from_int(types::g.tmpc)
         types::g.tmpc = types::g.tmpc + 1
         cur_fn = cg.current_fn
         b1_bb = LLVMAppendBasicBlock(cur_fn, "sr.b1." + sc)
         check2_bb = LLVMAppendBasicBlock(cur_fn, "sr.c2." + sc)
         b2_bb = LLVMAppendBasicBlock(cur_fn, "sr.b2." + sc)
         check3_bb = LLVMAppendBasicBlock(cur_fn, "sr.c3." + sc)
         b3_bb = LLVMAppendBasicBlock(cur_fn, "sr.b3." + sc)
         b4_bb = LLVMAppendBasicBlock(cur_fn, "sr.b4." + sc)
         done_bb = LLVMAppendBasicBlock(cur_fn, "sr.done." + sc)

         LLVMBuildCondBr(cg.builder, c1, b1_bb, check2_bb)

         // 1 byte
         LLVMPositionBuilderAtEnd(cg.builder, b1_bb)
         b1_0 = LLVMBuildTrunc(cg.builder, r64, i8t, "sr.b1.0")
         LLVMBuildStore(cg.builder, b1_0, dst)
         branch_to(cg, done_bb)

         // check 2
         LLVMPositionBuilderAtEnd(cg.builder, check2_bb)
         LLVMBuildCondBr(cg.builder, c2, b2_bb, check3_bb)

         // 2 bytes
         LLVMPositionBuilderAtEnd(cg.builder, b2_bb)
         sh6 = LLVMBuildLShr(cg.builder, r64,
            LLVMConstInt(i64t, 6, 0), "sr.sh6")
         b2_0 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            sh6, LLVMConstInt(i64t, 0xC0, 0), "sr.b2.0"), i8t,
            "sr.b2.0t")
         m6 = LLVMBuildAnd(cg.builder, r64,
            LLVMConstInt(i64t, 0x3F, 0), "sr.m6")
         b2_1 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            m6, LLVMConstInt(i64t, 0x80, 0), "sr.b2.1"), i8t,
            "sr.b2.1t")
         LLVMBuildStore(cg.builder, b2_0, dst)
         dst1 = types::gep1(cg, i8t, dst, LLVMConstInt(i64t, 1, 0),
            "sr.dst1")
         LLVMBuildStore(cg.builder, b2_1, dst1)
         branch_to(cg, done_bb)

         // check 3
         LLVMPositionBuilderAtEnd(cg.builder, check3_bb)
         LLVMBuildCondBr(cg.builder, c3, b3_bb, b4_bb)

         // 3 bytes
         LLVMPositionBuilderAtEnd(cg.builder, b3_bb)
         sh12 = LLVMBuildLShr(cg.builder, r64,
            LLVMConstInt(i64t, 12, 0), "sr.sh12")
         b3_0 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            sh12, LLVMConstInt(i64t, 0xE0, 0), "sr.b3.0"), i8t,
            "sr.b3.0t")
         sh6_3 = LLVMBuildLShr(cg.builder, r64,
            LLVMConstInt(i64t, 6, 0), "sr.sh6.3")
         m6_3 = LLVMBuildAnd(cg.builder, sh6_3,
            LLVMConstInt(i64t, 0x3F, 0), "sr.m6.3")
         b3_1 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            m6_3, LLVMConstInt(i64t, 0x80, 0), "sr.b3.1"), i8t,
            "sr.b3.1t")
         m_end = LLVMBuildAnd(cg.builder, r64,
            LLVMConstInt(i64t, 0x3F, 0), "sr.mend")
         b3_2 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            m_end, LLVMConstInt(i64t, 0x80, 0), "sr.b3.2"), i8t,
            "sr.b3.2t")
         LLVMBuildStore(cg.builder, b3_0, dst)
         dst1_3 = types::gep1(cg, i8t, dst, LLVMConstInt(i64t, 1, 0),
            "sr.dst1.3")
         LLVMBuildStore(cg.builder, b3_1, dst1_3)
         dst2_3 = types::gep1(cg, i8t, dst, LLVMConstInt(i64t, 2, 0),
            "sr.dst2.3")
         LLVMBuildStore(cg.builder, b3_2, dst2_3)
         branch_to(cg, done_bb)

         // 4 bytes
         LLVMPositionBuilderAtEnd(cg.builder, b4_bb)
         sh18 = LLVMBuildLShr(cg.builder, r64,
            LLVMConstInt(i64t, 18, 0), "sr.sh18")
         b4_0 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            sh18, LLVMConstInt(i64t, 0xF0, 0), "sr.b4.0"), i8t,
            "sr.b4.0t")
         sh12_4 = LLVMBuildLShr(cg.builder, r64,
            LLVMConstInt(i64t, 12, 0), "sr.sh12.4")
         m12_4 = LLVMBuildAnd(cg.builder, sh12_4,
            LLVMConstInt(i64t, 0x3F, 0), "sr.m12.4")
         b4_1 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            m12_4, LLVMConstInt(i64t, 0x80, 0), "sr.b4.1"), i8t,
            "sr.b4.1t")
         sh6_4 = LLVMBuildLShr(cg.builder, r64,
            LLVMConstInt(i64t, 6, 0), "sr.sh6.4")
         m6_4 = LLVMBuildAnd(cg.builder, sh6_4,
            LLVMConstInt(i64t, 0x3F, 0), "sr.m6.4")
         b4_2 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            m6_4, LLVMConstInt(i64t, 0x80, 0), "sr.b4.2"), i8t,
            "sr.b4.2t")
         m_end4 = LLVMBuildAnd(cg.builder, r64,
            LLVMConstInt(i64t, 0x3F, 0), "sr.mend4")
         b4_3 = LLVMBuildTrunc(cg.builder, LLVMBuildOr(cg.builder,
            m_end4, LLVMConstInt(i64t, 0x80, 0), "sr.b4.3"), i8t,
            "sr.b4.3t")
         LLVMBuildStore(cg.builder, b4_0, dst)
         dst1_4 = types::gep1(cg, i8t, dst, LLVMConstInt(i64t, 1, 0),
            "sr.dst1.4")
         LLVMBuildStore(cg.builder, b4_1, dst1_4)
         dst2_4 = types::gep1(cg, i8t, dst, LLVMConstInt(i64t, 2, 0),
            "sr.dst2.4")
         LLVMBuildStore(cg.builder, b4_2, dst2_4)
         dst3_4 = types::gep1(cg, i8t, dst, LLVMConstInt(i64t, 3, 0),
            "sr.dst3.4")
         LLVMBuildStore(cg.builder, b4_3, dst3_4)
         branch_to(cg, done_bb)

         // done
         LLVMPositionBuilderAtEnd(cg.builder, done_bb)
         nul_dst = types::gep1(cg, i8t, buf, tot_len, "sr.nul")
         LLVMBuildStore(cg.builder,
            LLVMConstInt(i8t, 0, 0), nul_dst)
         expr::codegen_string_build(cg, tot_len, buf, "str.rune.res")

codegen_string_append_byte: types::Cg, Addr, Addr => Addr
codegen_string_append_byte = cg, str_val, byte_val =>
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   valid = !cg.error && <>(types::llvm_val_opt(str_val)) && <>(types::llvm_val_opt(byte_val))
   !valid
      | LLVMConstNull(i8p)
      |
         i64t = LLVMInt64Type!
         i8t = LLVMInt8Type!
         slen = expr::codegen_string_len(cg, str_val, "sb.len")
         sdata = expr::codegen_string_data(cg, str_val, "sb.data")
         tot_len = codegen_add_checked_u64(cg, slen,
            LLVMConstInt(i64t, 1, 0), "sb.tot.len")
         buf_size = codegen_add_checked_u64(cg, tot_len,
            LLVMConstInt(i64t, 1, 0), "sb.buf.size")
         buf = expr::codegen_call_arena_alloc(cg, buf_size, "sb.buf")
         LLVMBuildMemCpy(cg.builder, buf, 1, sdata, 1, slen, 0)
         dst = types::gep1(cg, i8t, buf, slen, "sb.dst")
         b_i8 = LLVMBuildTrunc(cg.builder, byte_val, i8t, "sb.i8")
         LLVMBuildStore(cg.builder, b_i8, dst)
         nul_dst = types::gep1(cg, i8t, buf, tot_len, "sb.nul")
         LLVMBuildStore(cg.builder,
            LLVMConstInt(i8t, 0, 0), nul_dst)
         expr::codegen_string_build(cg, tot_len, buf, "str.byte.res")

codegen_decode_rune_at: types::Cg, Addr, Addr => (Addr, Addr)
codegen_decode_rune_at = cg, sdata, curr_i =>
   i64t = LLVMInt64Type!
   i8t = LLVMInt8Type!
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   cur_fn = cg.current_fn
   b0_ptr = types::gep1(cg, i8t, sdata, curr_i, "dec.b0.ptr." + sc)
   b0_raw = LLVMBuildLoad2(cg.builder, i8t, b0_ptr,
      "dec.b0.raw." + sc)
   b0 = LLVMBuildZExt(cg.builder, b0_raw, i64t, "dec.b0." + sc)

   d1_bb = LLVMAppendBasicBlock(cur_fn, "d.1." + sc)
   chk2_bb = LLVMAppendBasicBlock(cur_fn, "d.c2." + sc)
   d2_bb = LLVMAppendBasicBlock(cur_fn, "d.2." + sc)
   chk3_bb = LLVMAppendBasicBlock(cur_fn, "d.c3." + sc)
   d3_bb = LLVMAppendBasicBlock(cur_fn, "d.3." + sc)
   d4_bb = LLVMAppendBasicBlock(cur_fn, "d.4." + sc)
   done_bb = LLVMAppendBasicBlock(cur_fn, "d.done." + sc)

   c1 = LLVMBuildICmp(cg.builder, 40, b0,
      LLVMConstInt(i64t, 0x80, 0), "d.cmp1." + sc)
   c2 = LLVMBuildICmp(cg.builder, 40, b0,
      LLVMConstInt(i64t, 0xE0, 0), "d.cmp2." + sc)
   c3 = LLVMBuildICmp(cg.builder, 40, b0,
      LLVMConstInt(i64t, 0xF0, 0), "d.cmp3." + sc)

   LLVMBuildCondBr(cg.builder, c1, d1_bb, chk2_bb)

   // 1 byte
   LLVMPositionBuilderAtEnd(cg.builder, d1_bb)
   branch_to(cg, done_bb)

   // check 2
   LLVMPositionBuilderAtEnd(cg.builder, chk2_bb)
   LLVMBuildCondBr(cg.builder, c2, d2_bb, chk3_bb)

   // 2 bytes: ((b0 & 0x1F) << 6) | (b1 & 0x3F)
   LLVMPositionBuilderAtEnd(cg.builder, d2_bb)
   b1_2_ptr = types::gep1(cg, i8t, b0_ptr, LLVMConstInt(i64t, 1, 0),
      "d.b1.2.ptr." + sc)
   b1_2_raw = LLVMBuildLoad2(cg.builder, i8t, b1_2_ptr,
      "d.b1.2.raw." + sc)
   b1_2 = LLVMBuildZExt(cg.builder, b1_2_raw, i64t, "d.b1.2." + sc)
   b0_2_masked = LLVMBuildAnd(cg.builder, b0,
      LLVMConstInt(i64t, 0x1F, 0), "d.b0.2.m." + sc)
   b0_2_sh = LLVMBuildShl(cg.builder, b0_2_masked,
      LLVMConstInt(i64t, 6, 0), "d.b0.2.sh." + sc)
   b1_2_m = LLVMBuildAnd(cg.builder, b1_2,
      LLVMConstInt(i64t, 0x3F, 0), "d.b1.2.m." + sc)
   r2 = LLVMBuildOr(cg.builder, b0_2_sh, b1_2_m, "d.r2." + sc)
   branch_to(cg, done_bb)

   // check 3
   LLVMPositionBuilderAtEnd(cg.builder, chk3_bb)
   LLVMBuildCondBr(cg.builder, c3, d3_bb, d4_bb)

   // 3 bytes: ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
   LLVMPositionBuilderAtEnd(cg.builder, d3_bb)
   b1_3_ptr = types::gep1(cg, i8t, b0_ptr, LLVMConstInt(i64t, 1, 0),
      "d.b1.3.ptr." + sc)
   b1_3_raw = LLVMBuildLoad2(cg.builder, i8t, b1_3_ptr,
      "d.b1.3.raw." + sc)
   b1_3 = LLVMBuildZExt(cg.builder, b1_3_raw, i64t, "d.b1.3." + sc)
   b2_3_ptr = types::gep1(cg, i8t, b0_ptr, LLVMConstInt(i64t, 2, 0),
      "d.b2.3.ptr." + sc)
   b2_3_raw = LLVMBuildLoad2(cg.builder, i8t, b2_3_ptr,
      "d.b2.3.raw." + sc)
   b2_3 = LLVMBuildZExt(cg.builder, b2_3_raw, i64t, "d.b2.3." + sc)
   b0_3_m = LLVMBuildAnd(cg.builder, b0,
      LLVMConstInt(i64t, 0x0F, 0), "d.b0.3.m." + sc)
   b0_3_sh = LLVMBuildShl(cg.builder, b0_3_m,
      LLVMConstInt(i64t, 12, 0), "d.b0.3.sh." + sc)
   b1_3_m = LLVMBuildAnd(cg.builder, b1_3,
      LLVMConstInt(i64t, 0x3F, 0), "d.b1.3.m." + sc)
   b1_3_sh = LLVMBuildShl(cg.builder, b1_3_m,
      LLVMConstInt(i64t, 6, 0), "d.b1.3.sh." + sc)
   b2_3_m = LLVMBuildAnd(cg.builder, b2_3,
      LLVMConstInt(i64t, 0x3F, 0), "d.b2.3.m." + sc)
   r3_tmp = LLVMBuildOr(cg.builder, b0_3_sh, b1_3_sh,
      "d.r3.tmp." + sc)
   r3 = LLVMBuildOr(cg.builder, r3_tmp, b2_3_m, "d.r3." + sc)
   branch_to(cg, done_bb)

   // 4 bytes: ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) |
   //          ((b2 & 0x3F) << 6) | (b3 & 0x3F)
   LLVMPositionBuilderAtEnd(cg.builder, d4_bb)
   b1_4_ptr = types::gep1(cg, i8t, b0_ptr, LLVMConstInt(i64t, 1, 0),
      "d.b1.4.ptr." + sc)
   b1_4_raw = LLVMBuildLoad2(cg.builder, i8t, b1_4_ptr,
      "d.b1.4.raw." + sc)
   b1_4 = LLVMBuildZExt(cg.builder, b1_4_raw, i64t, "d.b1.4." + sc)
   b2_4_ptr = types::gep1(cg, i8t, b0_ptr, LLVMConstInt(i64t, 2, 0),
      "d.b2.4.ptr." + sc)
   b2_4_raw = LLVMBuildLoad2(cg.builder, i8t, b2_4_ptr,
      "d.b2.4.raw." + sc)
   b2_4 = LLVMBuildZExt(cg.builder, b2_4_raw, i64t, "d.b2.4." + sc)
   b3_4_ptr = types::gep1(cg, i8t, b0_ptr, LLVMConstInt(i64t, 3, 0),
      "d.b3.4.ptr." + sc)
   b3_4_raw = LLVMBuildLoad2(cg.builder, i8t, b3_4_ptr,
      "d.b3.4.raw." + sc)
   b3_4 = LLVMBuildZExt(cg.builder, b3_4_raw, i64t, "d.b3.4." + sc)
   b0_4_m = LLVMBuildAnd(cg.builder, b0,
      LLVMConstInt(i64t, 0x07, 0), "d.b0.4.m." + sc)
   b0_4_sh = LLVMBuildShl(cg.builder, b0_4_m,
      LLVMConstInt(i64t, 18, 0), "d.b0.4.sh." + sc)
   b1_4_m = LLVMBuildAnd(cg.builder, b1_4,
      LLVMConstInt(i64t, 0x3F, 0), "d.b1.4.m." + sc)
   b1_4_sh = LLVMBuildShl(cg.builder, b1_4_m,
      LLVMConstInt(i64t, 12, 0), "d.b1.4.sh." + sc)
   b2_4_m = LLVMBuildAnd(cg.builder, b2_4,
      LLVMConstInt(i64t, 0x3F, 0), "d.b2.4.m." + sc)
   b2_4_sh = LLVMBuildShl(cg.builder, b2_4_m,
      LLVMConstInt(i64t, 6, 0), "d.b2.4.sh." + sc)
   b3_4_m = LLVMBuildAnd(cg.builder, b3_4,
      LLVMConstInt(i64t, 0x3F, 0), "d.b3.4.m." + sc)
   r4_a = LLVMBuildOr(cg.builder, b0_4_sh, b1_4_sh,
      "d.r4.a." + sc)
   r4_b = LLVMBuildOr(cg.builder, b2_4_sh, b3_4_m,
      "d.r4.b." + sc)
   r4 = LLVMBuildOr(cg.builder, r4_a, r4_b, "d.r4." + sc)
   branch_to(cg, done_bb)

   // done merge
   LLVMPositionBuilderAtEnd(cg.builder, done_bb)
   phi_r = LLVMBuildPhi(cg.builder, i64t, "d.phi.r." + sc)
   phi_w = LLVMBuildPhi(cg.builder, i64t, "d.phi.w." + sc)
   llvm_add_incoming1(cg, phi_r, b0, d1_bb)
   llvm_add_incoming1(cg, phi_w, LLVMConstInt(i64t, 1, 0), d1_bb)
   llvm_add_incoming1(cg, phi_r, r2, d2_bb)
   llvm_add_incoming1(cg, phi_w, LLVMConstInt(i64t, 2, 0), d2_bb)
   llvm_add_incoming1(cg, phi_r, r3, d3_bb)
   llvm_add_incoming1(cg, phi_w, LLVMConstInt(i64t, 3, 0), d3_bb)
   llvm_add_incoming1(cg, phi_r, r4, d4_bb)
   llvm_add_incoming1(cg, phi_w, LLVMConstInt(i64t, 4, 0), d4_bb)
   (phi_r, phi_w)

codegen_eval_string_rune_count: types::Cg, Addr => (Addr, ast::ValueType)
codegen_eval_string_rune_count = cg, str_val =>
   i64t = LLVMInt64Type!
   i8t = LLVMInt8Type!
   slen = expr::codegen_string_len(cg, str_val, "rc.len")
   sdata = expr::codegen_string_data(cg, str_val, "rc.data")
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   cur_fn = cg.current_fn
   entry_bb = LLVMGetInsertBlock(cg.builder)
   header_bb = LLVMAppendBasicBlock(cur_fn, "rc.hdr." + sc)
   body_bb = LLVMAppendBasicBlock(cur_fn, "rc.body." + sc)
   latch_bb = LLVMAppendBasicBlock(cur_fn, "rc.latch." + sc)
   done_bb = LLVMAppendBasicBlock(cur_fn, "rc.done." + sc)
   branch_to(cg, header_bb)
   LLVMPositionBuilderAtEnd(cg.builder, header_bb)
   phi_i = LLVMBuildPhi(cg.builder, i64t, "rc.i")
   phi_cnt = LLVMBuildPhi(cg.builder, i64t, "rc.cnt")
   cmp = LLVMBuildICmp(cg.builder, 40, phi_i, slen, "rc.cmp")
   LLVMBuildCondBr(cg.builder, cmp, body_bb, done_bb)
   LLVMPositionBuilderAtEnd(cg.builder, body_bb)
   bptr = types::gep1(cg, i8t, sdata, phi_i, "rc.bptr")
   bval = LLVMBuildLoad2(cg.builder, i8t, bptr, "rc.bval")
   bmasked = LLVMBuildAnd(cg.builder, bval,
      LLVMConstInt(i8t, 0xC0, 0), "rc.mask")
   is_lead = LLVMBuildICmp(cg.builder, 33, bmasked,
      LLVMConstInt(i8t, 0x80, 0), "rc.is_lead")
   inc = LLVMBuildZExt(cg.builder, is_lead, i64t, "rc.inc")
   next_cnt = LLVMBuildAdd(cg.builder, phi_cnt, inc, "rc.next_cnt")
   next_i = LLVMBuildAdd(cg.builder, phi_i,
      LLVMConstInt(i64t, 1, 0), "rc.next_i")
   branch_to(cg, latch_bb)
   LLVMPositionBuilderAtEnd(cg.builder, latch_bb)
   branch_to(cg, header_bb)
   zero_i64 = LLVMConstInt(i64t, 0, 0)
   llvm_add_incoming1(cg, phi_i, zero_i64, entry_bb)
   llvm_add_incoming1(cg, phi_i, next_i, latch_bb)
   llvm_add_incoming1(cg, phi_cnt, zero_i64, entry_bb)
   llvm_add_incoming1(cg, phi_cnt, next_cnt, latch_bb)
   LLVMPositionBuilderAtEnd(cg.builder, done_bb)
   (phi_cnt, ast::ValueType(Int))

// --- variable slots ----------------------------------------------------------

// A module-qualified name contains "::". The loader stores module globals,
// functions, and types under that spelling; source inside a module may still
// use the local bare spelling.
block_is_terminated: types::Cg => <>
block_is_terminated = cg =>
   types::llvm_val_opt(LLVMGetInsertBlock(cg.builder))
      | cur => <>(types::llvm_val_opt(LLVMGetBasicBlockTerminator(cur)))
      | <+>

// Br to dest unless the current block is already terminated.
branch_to: types::Cg, Addr => ()
branch_to = cg, dest =>
   !block_is_terminated(cg) | LLVMBuildBr(cg.builder, dest)


// Coerces a scalar/flag value to an i1 for a conditional branch. A bare i1
// flag is used directly; a heap ram (a { tag, payload } union pointer) tests
// tag == 1 || tag == 2; an Int tests nonzero.
codegen_cond_value: types::Cg, Addr, ast::ValueType => Addr
codegen_cond_value = cg, v, vt =>
   types::llvm_val_opt(v)
      | vv => codegen_cond_value_valid(cg, vv, vt)
      | LLVMConstInt(LLVMInt1Type!, 0, 0)

codegen_cond_value_valid: types::Cg, Addr, ast::ValueType => Addr
codegen_cond_value_valid = cg, v, vt =>
   i1t = LLVMInt1Type!
   is_i1 = LLVMTypeOf(v) == i1t
   is_i1
      | v
      |
         types::is_ram_vt(vt)
            |
               LLVMGetTypeKind(LLVMTypeOf(v)) == 10
                  | LLVMBuildExtractValue(cg.builder, v, 0, "ram.tag")
                  |
                     tgep = LLVMBuildStructGEP2(cg.builder, cg.union_t,
                        v, 0, "tag.gep")
                     tag = LLVMBuildLoad2(cg.builder,
                        LLVMInt64Type!, tgep, "tag.id")
                     eq1 = LLVMBuildICmp(cg.builder, 32, tag,
                        LLVMConstInt(LLVMInt64Type!, 1, 0),
                        "tag.eq.one")
                     eq2 = LLVMBuildICmp(cg.builder, 32, tag,
                        LLVMConstInt(LLVMInt64Type!, 2, 0),
                        "tag.eq.two")
                     LLVMBuildOr(cg.builder, eq1, eq2, "is.pos")
            |
               types::is_int_vt(vt)
                  | LLVMBuildICmp(cg.builder, 33, v,
                     LLVMConstInt(LLVMInt64Type!, 0, 0), "is.pos")
                  |
                     LLVMGetTypeKind(LLVMTypeOf(v)) == 12
                        |
                           v_int = LLVMBuildPtrToInt(cg.builder, v,
                              LLVMInt64Type!, "ptr.cond.int")
                           LLVMBuildICmp(cg.builder, 33, v_int,
                              LLVMConstInt(LLVMInt64Type!, 0, 0),
                              "ptr.is.nonnull")
                        |
                           LLVMBuildICmp(cg.builder, 33, v,
                              LLVMConstInt(LLVMTypeOf(v), 0, 0),
                              "cond.nonzero")

// LLVMAddIncoming with a single (value, block) pair. The LLVM C API takes
// pointer-to-array args, where Dva has no record-buffer-address primitive
// for yet; store the two words through a Builder's buffer and pass the buffer
// addresses (the C side reads one pointer-sized slot each).
llvm_add_incoming1: types::Cg, Addr, Addr, Addr => ()
llvm_add_incoming1 = cg, phi, val, bb =>
   vb = {16}
   bbuf = {16}
   @[&vb] = val
   @[&bbuf] = bb
   LLVMAddIncoming(phi, &vb, &bbuf, 1)

// Widen/narrow an integer value to a target integer type (same-type passes).
coerce_int_ext: types::Cg, Addr, Addr, <> => Addr
coerce_int_ext = cg, v, target, is_unsigned =>
   types::llvm_val_opt(v)
      | vv =>
         types::llvm_val_opt(target)
            | tt =>
               same = (LLVMTypeOf(vv) == tt)
               same
                  | vv
                  |
                     is_int_v = (LLVMGetTypeKind(LLVMTypeOf(vv)) == 8)
                     is_int_t = (LLVMGetTypeKind(tt) == 8)
                     is_int_v && is_int_t
                        |
                           vwidth = LLVMGetIntTypeWidth(LLVMTypeOf(vv))
                           twidth = LLVMGetIntTypeWidth(tt)
                           vwidth > twidth
                              |
                                 LLVMBuildTrunc(cg.builder, vv, tt,
                                    "coerce.trunc")
                              |
                                 vwidth == 1 || is_unsigned
                                    |
                                       LLVMBuildZExt(cg.builder, vv, tt,
                                          "coerce.zext")
                                    |
                                       LLVMBuildSExt(cg.builder, vv, tt,
                                          "coerce.sext")
                        |
                           !is_int_v && is_int_t
                              |
                                 LLVMBuildPtrToInt(cg.builder, vv, tt,
                                    "coerce.ptr2int")
                              | vv
            | vv
      | v

coerce_int: types::Cg, Addr, Addr => Addr
coerce_int = cg, v, target => coerce_int_ext(cg, v, target, <->)

// A choice-branch value coerced to the merge type: same as coerce_int, but an
// integer ZERO becomes null when the merge type is a pointer (the "0" default
// branch of a pointer-payload "| _ | 0" choice).
choice_coerce: types::Cg, Addr, Addr => Addr
choice_coerce = cg, v, target =>
   choice_coerce_c(cg, v, target)

choice_coerce_c: types::Cg, Addr, Addr => Addr
choice_coerce_c = cg, v, target =>
   types::llvm_val_opt(target)
      | tt =>
         types::llvm_val_opt(v)
            | vv =>
               vty = LLVMTypeOf(vv)
               vty == tt
                  | vv
                  |
                     vkind = LLVMGetTypeKind(vty)
                     tkind = LLVMGetTypeKind(tt)
                     tkind == 12 && vkind == 8
                        |
                           is_zero_c = LLVMIsConstant(vv) != 0 &&
                              LLVMConstIntGetZExtValue(vv) == 0
                           is_zero_c
                              | LLVMConstNull(tt)
                              |
                                 ! <>(types::llvm_val_opt(LLVMGetInsertBlock(cg.builder)))
                                    | LLVMConstNull(tt)
                                    |
                                       LLVMBuildIntToPtr(cg.builder, vv,
                                          tt, "phi.cast")
                        |
                           tkind == 8 && vkind == 12
                              |
                                 ! <>(types::llvm_val_opt(LLVMGetInsertBlock(cg.builder)))
                                    | LLVMConstInt(tt, 0, 0)
                                    |
                                       LLVMBuildPtrToInt(cg.builder, vv,
                                          tt, "phi.cast")
                              | coerce_int(cg, vv, tt)
            |
               tt == LLVMVoidType!
                  | LLVMConstNull(LLVMPointerType(LLVMInt8Type!, 0))
                  | LLVMConstNull(tt)
      | v

// --- expressions -------------------------------------------------------------

// A named function used as a value is a non-capturing closure.
cycle_has_field_index: ast::Expr, String => <>
cycle_has_field_index = e, idx_name =>
   e
      [Member m]
         m.field_name == ""
            |
               refs_name(m.index_expr, idx_name)
                  | <+>
                  | cycle_has_field_index(m.target, idx_name)
            | cycle_has_field_index(m.target, idx_name)
      [Assign t]
         cycle_has_field_index(t.5, idx_name)
            | <+>
            | cycle_has_field_index(t.6, idx_name)
      [Block b] cycle_has_field_index_exprs(b.exprs, idx_name, 0, ?b.exprs)
      [Bin t]
         cycle_has_field_index(t.1, idx_name)
            | <+>
            | cycle_has_field_index(t.2, idx_name)
      [Unary t] cycle_has_field_index(t.1, idx_name)
      [Call t] cycle_has_field_index_exprs(t.args, idx_name, 0, ?t.args)
      [Choice c]
         cycle_has_field_index(c.cond, idx_name)
            | <+>
            | cycle_has_field_index_branches(c.branches, idx_name, 0, ?c.branches)
      [Record r] cycle_has_field_index_fields(r.fields, idx_name, 0, ?r.fields)
      | <->

cycle_has_field_index_exprs: ast::Exprs, String, Int, Int => <>
cycle_has_field_index_exprs = es, idx_name, i, n =>
   i == n
      | <->
      |
         e = es(i)!!
         cycle_has_field_index(e, idx_name)
            | <+>
            | cycle_has_field_index_exprs(es, idx_name, i + 1, n)

cycle_has_field_index_branches: ast::Branches, String, Int, Int => <>
cycle_has_field_index_branches = brs, idx_name, i, n =>
   i == n
      | <->
      |
         br = brs(i)!!
         cycle_has_field_index(br.block, idx_name)
            | <+>
            | cycle_has_field_index_branches(brs, idx_name, i + 1, n)

cycle_has_field_index_fields: ast::Fields, String, Int, Int => <>
cycle_has_field_index_fields = flds, idx_name, i, n =>
   i == n
      | <->
      |
         f = flds(i)!!
         cycle_has_field_index(f.val, idx_name)
            | <+>
            | cycle_has_field_index_fields(flds, idx_name, i + 1, n)

// A compile-time unroll candidate: "0..N @ i => body" where N is a constant
// and body references "x.(i)" or "T.(i)". Returns (trip_count, <+>) or (0, <->).
codegen_cycle_unroll_range: types::Cg, ast::CycleExpr => (Int, <>)
codegen_cycle_unroll_range = cg, cyc =>
   cyc.iterable
      [Range rng]
         rng.has_lhs
            |
               rng.has_rhs
                  |
                     cyc.body_fn
                        [Fn f]
                           ?f.params > 0
                              |
                                 idx_name = (f.params(0) | _ | "")
                                 cycle_has_field_index(f.body, idx_name)
                                    |
                                       saved_discard = cg.discard_result
                                       cg.discard_result = <->
                                       rv = expr::codegen_eval(cg, rng.rhs)
                                       cg.discard_result = saved_discard
                                       types::llvm_val_opt(rv.0)
                                          | r_val =>
                                             LLVMIsConstant(r_val) != 0
                                                |
                                                   n = LLVMConstIntGetZExtValue(r_val)
                                                   (n, <+>)
                                                | (0, <->)
                                          | (0, <->)
                                    | (0, <->)
                              | (0, <->)
                        | (0, <->)
                  | (0, <->)
            | (0, <->)
      | (0, <->)

codegen_eval_cycle_unrolled: types::Cg, ast::CycleExpr, Int => (Addr, ast::ValueType)
codegen_eval_cycle_unrolled = cg, c, n =>
   bfn = c.body_fn
   bfn
      [Fn f]
         idx_name = ?f.params > 0 | (f.params(0) | _ | "") | ""
         codegen_eval_cycle_unrolled_step(cg, f.body, idx_name, 0, n,
            (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit)))
      | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))

codegen_eval_cycle_unrolled_step: types::Cg, ast::Expr, String, Int, Int,
   (Addr, ast::ValueType) => (Addr, ast::ValueType)
codegen_eval_cycle_unrolled_step = cg, body, idx_name, k, n, last_val =>
   k == n
      | last_val
      |
         saved_nvars = ?cg.vars
         saved_nbindings = ?cg.bindings
         i64t = LLVMInt64Type!
         k_val = LLVMConstInt(i64t, k, 0)
         cg.vars += types::CgVar((idx_name, ast::ValueType(Int), <->, "",
            <-->, ast::Names(), <-->, <+>, <->, ast::VTypes(), <+ k_val ->))
         saved_discard = cg.discard_result
         k < n - 1
            | cg.discard_result = <+>
            | cg.discard_result = saved_discard
         v = expr::codegen_eval(cg, body)
         cg.discard_result = saved_discard
         cg.vars = truncate_vars(cg.vars, saved_nvars)
         cg.bindings = runtime::binding_truncate(cg.bindings, saved_nbindings)
         cg.error
            | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            | codegen_eval_cycle_unrolled_step(cg, body, idx_name, k + 1, n, v)

// "N @ i => body" (and iterable cycles): a header/body/latch/exit loop. The
// counter is an i64 phi; the body's lambda param is bound to it. "-->" breaks
// to the loop exit (or the escape block when a cycle-escape is active), "--^"
// continues to the latch.
codegen_eval_cycle: types::Cg, ast::CycleExpr => (Addr, ast::ValueType)
codegen_eval_cycle = cg, c =>
   unroll = codegen_cycle_unroll_range(cg, c)
   unroll.1
      | codegen_eval_cycle_unrolled(cg, c, unroll.0)
      |
         cycle_iter_heterogeneous_record(cg, c.iterable)
            | codegen_cycle_record_iter_error(cg)
            | codegen_eval_cycle_valid(cg, c)

cycle_iter_heterogeneous_record: types::Cg, ast::Expr => <>
cycle_iter_heterogeneous_record = cg, e =>
   e
      [Var v] is_heterogeneous_record_var(cg, v)
      | <->

// A record's fields are statically laid out. Runtime integer indexing and
// cycle iteration only make sense when every position has one element type.
is_heterogeneous_record_var: types::Cg, String => <>
is_heterogeneous_record_var = cg, name =>
   is_rec = types::var_type(cg, name) [Record]
   fvs = match::var_fvts(cg, name)
   is_rec && (?fvs > 1)
      | !expr::record_type_is_homogeneous(types::var_rt(cg, name), fvs)
      | <->

codegen_dynamic_record_index_error: types::Cg => (Addr, ast::ValueType)
codegen_dynamic_record_index_error = cg =>
   types::init_error(cg, "E3051", "Dynamic indexing is only allowed on homogeneous " +
      "records.", 0, 0)
   (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_cycle_record_iter_error: types::Cg => (Addr, ast::ValueType)
codegen_cycle_record_iter_error = cg =>
   types::init_error(cg, "E3051", "Cycle iteration is only allowed on homogeneous " +
      "records.", 0, 0)
   (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

cycle_range_start: types::Cg, ast::RangeExpr => Addr
cycle_range_start = cg, rng =>
   i64t = LLVMInt64Type!
   rng.has_lhs
      | (expr::codegen_eval(cg, rng.lhs)).0
      | LLVMConstInt(i64t, 0, 0)

cycle_range_end: types::Cg, ast::RangeExpr => Addr
cycle_range_end = cg, rng =>
   i64t = LLVMInt64Type!
   rng.has_rhs
      | (expr::codegen_eval(cg, rng.rhs)).0
      | LLVMConstInt(i64t, 0, 0)

cycle_str_elem: types::Cg, Addr, Addr => Addr
cycle_str_elem = cg, s_val, idx =>
   i8t = LLVMInt8Type!
   i64t = LLVMInt64Type!
   data_ptr = expr::codegen_string_data(cg, s_val, "str.cycle.data")
   byte_ptr = types::gep1(cg, i8t, data_ptr, idx, "s.byte.gep")
   byte_val = LLVMBuildLoad2(cg.builder, i8t, byte_ptr, "s.byte")
   LLVMBuildZExt(cg.builder, byte_val, i64t, "str.byte.val")

cycle_record_info: types::Cg, ast::Expr => (Int, ast::ValueType, Addr)
cycle_record_info = cg, e =>
   e
      [Var v]
         vname = types::resolve_var_name(cg, v)
         fvs = match::var_fvts(cg, vname)
         n' = ?fvs
         elem_vt' = n' > 0 | (fvs(0) | _ | ast::ValueType(Unknown)) |
            ast::ValueType(Unknown)
         elem_ll' = types::var_rt(cg, vname)
            | rt => LLVMStructGetTypeAtIndex(rt, 0)
            | types::llvm_type_of_vt(elem_vt')
         (n', elem_vt', elem_ll')
      [Record r]
         n' = ?r.fields
         first_f = n' > 0 | r.fields(0)!! |
            ast::RecordField((<->, "", ast::Expr(Var, "?")))
         elem_vt' = n' > 0 | types::static_expr_vt(cg, first_f.val) |
            ast::ValueType(Unknown)
         elem_ll' = types::llvm_type_of_vt(elem_vt')
         (n', elem_vt', elem_ll')
      | (0, ast::ValueType(Unknown), LLVMInt64Type!)

slice_elem_dtype: types::Cg, String => String
slice_elem_dtype = cg, dt =>
   dt == ""
      | ""
      |
         ti = types::typedef_ti(cg, dt)
         ti
            [Rec rr]
               fields = rr.0
               ?fields > 0
                  |
                     f0 = fields(0)!!
                     f0.rec_type [TypeVar name] name | ""
                  | ""
            [Array ae]
               ae.1 [TypeVar name] name | ""
            | ""

cycle_array_elem_vt: types::Cg, String, String => ast::ValueType
cycle_array_elem_vt = cg, vname, dt =>
   eff_dt = dt != "" | dt | (vname != "" | types::var_dtype(cg, vname) | "")
   ti = types::typedef_ti(cg, eff_dt)
   ti
      [Array a]
         resolved_ti = a.1 [TypeVar n] types::typedef_ti(cg, n) | a.1
         resolved_vt = types::vt_from_ti(resolved_ti)
         resolved_vt != ast::ValueType(Unknown) | resolved_vt | a.0
      | ast::ValueType(Int)

cycle_array_elem_val: types::Cg, Addr, Addr, <>, ast::ValueType, Addr => Addr
cycle_array_elem_val = cg, arr, cur_i, is_ptr, vt, elem_ll =>
   i64t = LLVMInt64Type!
   arr_data = main::builder_data(cg, arr, "arr.cycle.data")
   arr_slot = types::gep1(cg, i64t, arr_data, cur_i, "arr.elem.gep")
   arr_raw = LLVMBuildLoad2(cg.builder, i64t, arr_slot, "arr.elem.raw")
   raw_ptr = LLVMBuildIntToPtr(cg.builder, arr_raw, elem_ll,
      "arr.elem.ptr")
   raw_flt = LLVMBuildBitCast(cg.builder, arr_raw,
      LLVMDoubleType!, "arr.elem.flt")
   flt_or_raw = types::is_float_vt(vt) | raw_flt | arr_raw
   is_ptr | raw_ptr | flt_or_raw

cycle_bind_params: types::Cg, ast::Expr, <>, Addr, ast::ValueType, String, Addr, Addr, <Addr|> => ()
cycle_bind_params = cg, bfn, has_e, eval, evt, elem_dt, cur_i, ca, ert_opt =>
   i64vt = ast::ValueType(Int)
   i64t = LLVMInt64Type!
   empty_names = ast::Names()
   vts = ast::VTypes()
   e_is_rec = evt [Record]
   is_heap = evt [Enum, Ram] || types::is_ptrish_vt(evt)
   elem_ll = is_heap || e_is_rec
      | LLVMPointerType(LLVMInt8Type!, 0)
      | types::llvm_type_of_vt(evt)
   rmeta = e_is_rec && elem_dt != ""
      | types::td_record_meta_by_name(cg, elem_dt)
      | <-->
   names = rmeta | m => m.1 | empty_names
   rmeta_rt_opt = rmeta | m => <+ m.0 -> | <-->
   e_rt_opt = e_is_rec | (<>(ert_opt) | ert_opt | rmeta_rt_opt) | <-->
   e_vts = e_is_rec
      | (e_rt_opt | rt => match::struct_sub_fvts(rt) | vts)
      | vts
   has_e
      |
         bfn
            [Fn f]
               np = ?f.params
               np == 1
                  |
                     ename' = (f.params(0) | _ | "_")
                     eslot' = types::hoisted_alloca(cg, elem_ll, "var." + ename')
                     LLVMBuildStore(cg.builder, eval, eslot')
                     cg.vars += types::CgVar((ename', evt, is_heap, elem_dt, e_rt_opt,
                        names, <+ eslot' ->, <+>, <->, e_vts, <+ eval ->))
                  |
                     ename' = (f.params(0) | _ | "_")
                     iname' = (f.params(1) | _ | "_")
                     eslot' = types::hoisted_alloca(cg, elem_ll, "var." + ename')
                     LLVMBuildStore(cg.builder, eval, eslot')
                     cg.vars += types::CgVar((ename', evt, is_heap, elem_dt, e_rt_opt,
                        names, <+ eslot' ->, <+>, <->, e_vts, <+ eval ->))
                     cg.vars += types::CgVar((iname', i64vt, <->, "", <-->,
                        empty_names, <+ ca ->, <+>, <->, vts, <+ cur_i ->))
            |
               cg.vars += types::CgVar(("_", evt, is_heap, elem_dt, e_rt_opt, names,
                  <-->, <+>, <->, e_vts, <+ eval ->))
               cg.vars += types::CgVar(("_i", i64vt, <->, "", <-->, empty_names,
                  <+ ca ->, <+>, <->, vts, <+ cur_i ->))
      |
         p_vt = evt [Rune] ast::ValueType(Rune) | i64vt
         bfn
            [Fn f]
               pname = (f.params(0) | _ | "_")
               cg.vars += types::CgVar((pname, p_vt, <->, "", <-->, empty_names,
                  <+ ca ->, <+>, <->, vts, <+ cur_i ->))
               ?f.params > 1
                  |
                     iname' = (f.params(1) | _ | "_i")
                     cg.vars += types::CgVar((iname', i64vt, <->, "", <-->,
                        empty_names, <-->, <+>, <->, vts, <+ eval ->))
            |
               cg.vars += types::CgVar(("_", p_vt, <->, "", <-->, empty_names,
                  <+ ca ->, <+>, <->, vts, <+ cur_i ->))
               cg.vars += types::CgVar(("_i", i64vt, <->, "", <-->, empty_names,
                  <-->, <+>, <->, vts, <+ eval ->))

cycle_bind_map_params: types::Cg, ast::Expr, Addr, ast::ValueType, String, Addr, ast::ValueType => ()
cycle_bind_map_params = cg, bfn, val_val, val_vt, val_dt, key_val, key_vt =>
   names = ast::Names()
   vts = ast::VTypes()
   val_ll = types::llvm_type_of_vt(val_vt)
   key_ll = types::llvm_type_of_vt(key_vt)
   val_is_heap = val_vt [Enum, Ram] || types::is_ptrish_vt(val_vt)
   key_is_heap = key_vt [Enum, Ram] || types::is_ptrish_vt(key_vt)
   bfn
      [Fn f]
         np = ?f.params
         vname = np > 0 | (f.params(0) | _ | "_") | "_"
         kname = np > 1 | (f.params(1) | _ | "_i") | "_i"
         vslot' = types::hoisted_alloca(cg, val_ll, "var." + vname)
         LLVMBuildStore(cg.builder, val_val, vslot')
         cg.vars += types::CgVar((vname, val_vt, val_is_heap, val_dt, <-->,
            names, <+ vslot' ->, <+>, <->, vts, <+ val_val ->))
         np > 1
            |
               kslot' = types::hoisted_alloca(cg, key_ll, "var." + kname)
               LLVMBuildStore(cg.builder, key_val, kslot')
               cg.vars += types::CgVar((kname, key_vt, key_is_heap, "", <-->,
                  names, <+ kslot' ->, <+>, <->, vts, <+ key_val ->))
      |
         vslot' = types::hoisted_alloca(cg, val_ll, "var._")
         LLVMBuildStore(cg.builder, val_val, vslot')
         cg.vars += types::CgVar(("_", val_vt, val_is_heap, val_dt, <-->,
            names, <+ vslot' ->, <+>, <->, vts, <+ val_val ->))
         kslot' = types::hoisted_alloca(cg, key_ll, "var._i")
         LLVMBuildStore(cg.builder, key_val, kslot')
         cg.vars += types::CgVar(("_i", key_vt, key_is_heap, "", <-->,
            names, <+ kslot' ->, <+>, <->, vts, <+ key_val ->))

codegen_eval_map_cycle: types::Cg, ast::CycleExpr, Addr => (Addr, ast::ValueType)
codegen_eval_map_cycle = cg, c, m =>
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   i64t = LLVMInt64Type!
   i8t = LLVMInt8Type!
   i8p = LLVMPointerType(i8t, 0)
   mt = runtime::map_struct_type(cg)
   vname = c.iterable [Var v] types::resolve_var_name(cg, v) | ""
   map_dt = vname != "" | types::var_dtype(cg, vname) | ""
   ti = types::typedef_ti(cg, map_dt)
   ti_kvt = ti [Map mp] mp.0 | ast::ValueType(Unknown)
   key_vt = ti_kvt != ast::ValueType(Unknown) | ti_kvt | ast::ValueType(Str)
   ti_vvt = ti [Map mp] mp.1 | ast::ValueType(Unknown)
   val_vt = ti_vvt != ast::ValueType(Unknown) | ti_vvt | ast::ValueType(Int)
   val_dt = ti [Map mp] (mp.2 [TypeVar tn] tn | "") | ""
   cap = LLVMBuildLoad2(cg.builder, i64t,
      LLVMBuildStructGEP2(cg.builder, mt, m, 1, "m.it.cap"), "m.it.cap")
   keys = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 2, "m.it.keys"), "m.it.keys")
   vals = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 3, "m.it.vals"), "m.it.vals")
   states = LLVMBuildLoad2(cg.builder, i8p,
      LLVMBuildStructGEP2(cg.builder, mt, m, 4, "m.it.states"),
      "m.it.states")
   counter_alloca = types::hoisted_alloca(cg, i64t, "loop.midx." + sc)
   LLVMBuildStore(cg.builder, LLVMConstInt(i64t, 0, 0),
      counter_alloca)
   header = LLVMAppendBasicBlock(cg.current_fn, "loop.mheader." + sc)
   body = LLVMAppendBasicBlock(cg.current_fn, "loop.mbody." + sc)
   live_bb = LLVMAppendBasicBlock(cg.current_fn, "loop.mlive." + sc)
   latch = LLVMAppendBasicBlock(cg.current_fn, "loop.mlatch." + sc)
   done = LLVMAppendBasicBlock(cg.current_fn, "loop.mexit." + sc)
   break_target = cg.escape_bb | _ | done
   cg.escape_bb = <-->
   cg.cycle_breaks += break_target
   cg.cycle_conts += latch
   branch_to(cg, header)
   LLVMPositionBuilderAtEnd(cg.builder, header)
   curr_i = LLVMBuildLoad2(cg.builder, i64t, counter_alloca, "m.it.load")
   cond = LLVMBuildICmp(cg.builder, 40, curr_i, cap, "m.it.cond")
   LLVMBuildCondBr(cg.builder, cond, body, done)
   LLVMPositionBuilderAtEnd(cg.builder, body)
   st_gep = types::gep1(cg, i8t, states, curr_i, "m.it.st.gep")
   st_val = LLVMBuildLoad2(cg.builder, i8t, st_gep, "m.it.st")
   is_live = LLVMBuildICmp(cg.builder, 32, st_val,
      LLVMConstInt(i8t, 1, 0), "m.it.live")
   LLVMBuildCondBr(cg.builder, is_live, live_bb, latch)
   LLVMPositionBuilderAtEnd(cg.builder, live_bb)
   val_is_ptr = types::is_ptrish_vt(val_vt)
   val_slot = types::gep1(cg, val_is_ptr | i8p | i64t, vals, curr_i, "m.it.v.slot")
   val_val = LLVMBuildLoad2(cg.builder, val_is_ptr | i8p | i64t,
      val_slot, "m.it.v")
   key_is_ptr = types::is_ptrish_vt(key_vt)
   key_slot = types::gep1(cg, key_is_ptr | i8p | i64t, keys, curr_i, "m.it.k.slot")
   key_val = LLVMBuildLoad2(cg.builder, key_is_ptr | i8p | i64t,
      key_slot, "m.it.k")
   cycle_bind_map_params(cg, c.body_fn, val_val, val_vt, val_dt, key_val,
      key_vt)
   saved_discard = cg.discard_result
   cg.discard_result = <+>
   bv = codegen_eval_cycle_body(cg, c.body_fn)
   cg.discard_result = saved_discard
   branch_to(cg, latch)
   LLVMPositionBuilderAtEnd(cg.builder, latch)
   loaded_i = LLVMBuildLoad2(cg.builder, i64t, counter_alloca, "m.it.c")
   next_i = LLVMBuildAdd(cg.builder, loaded_i,
      LLVMConstInt(i64t, 1, 0), "m.it.next")
   LLVMBuildStore(cg.builder, next_i, counter_alloca)
   branch_to(cg, header)
   nb = ?cg.cycle_breaks
   cg.cycle_breaks = cycle_trunc(cg.cycle_breaks, nb - 1)
   cg.cycle_conts = cycle_trunc(cg.cycle_conts, nb - 1)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))

codegen_eval_cycle_body_cond: types::Cg, ast::Expr => (Addr, ast::ValueType)
codegen_eval_cycle_body_cond = cg, bfn =>
   bfn
      [Fn f] expr::codegen_eval(cg, f.body)
      [Block _] expr::codegen_eval(cg, bfn)
      |
         callee = expr::apply_callee_name(bfn)
         callee != ""
            |
               call = ast::CallExpr((callee, ast::Expr(Var, ""),
                  ast::Exprs(), 0, 0))
               expr::codegen_eval_call(cg, call)
            | expr::codegen_eval(cg, bfn)

codegen_eval_cycle_body: types::Cg, ast::Expr => (Addr, ast::ValueType)
codegen_eval_cycle_body = cg, bfn =>
   bfn
      [Fn f] expr::codegen_eval(cg, f.body)
      [Block _] expr::codegen_eval(cg, bfn)
      |
         callee = expr::apply_callee_name(bfn)
         callee != ""
            |
               args = ast::Exprs()
               args += ast::Expr(Var, "_")
               call = ast::CallExpr((callee, ast::Expr(Var, ""), args,
                  0, 0))
               expr::codegen_eval_call(cg, call)
            | expr::codegen_eval(cg, bfn)

codegen_eval_condition_cycle: types::Cg, ast::CycleExpr => (Addr, ast::ValueType)
codegen_eval_condition_cycle = cg, c =>
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   header = LLVMAppendBasicBlock(cg.current_fn, "loop.header." + sc)
   body = LLVMAppendBasicBlock(cg.current_fn, "loop.body." + sc)
   latch = LLVMAppendBasicBlock(cg.current_fn, "loop.latch." + sc)
   done = LLVMAppendBasicBlock(cg.current_fn, "loop.exit." + sc)
   break_target = cg.escape_bb | _ | done
   cg.escape_bb = <-->
   cg.cycle_breaks += break_target
   cg.cycle_conts += latch
   branch_to(cg, header)
   LLVMPositionBuilderAtEnd(cg.builder, header)
   c_cond = expr::codegen_eval(cg, c.iterable)
   LLVMBuildCondBr(cg.builder, c_cond.0, body, done)
   LLVMPositionBuilderAtEnd(cg.builder, body)
   saved_discard = cg.discard_result
   cg.discard_result = <+>
   bv = codegen_eval_cycle_body_cond(cg, c.body_fn)
   cg.discard_result = saved_discard
   branch_to(cg, latch)
   LLVMPositionBuilderAtEnd(cg.builder, latch)
   branch_to(cg, header)
   nb = ?cg.cycle_breaks
   cg.cycle_breaks = cycle_trunc(cg.cycle_breaks, nb - 1)
   cg.cycle_conts = cycle_trunc(cg.cycle_conts, nb - 1)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   is_void = bv.1 [Unit, Unknown]
   is_void
      | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      | (LLVMConstNull(types::llvm_type_of_vt(bv.1)), bv.1)

codegen_eval_indexed_cycle: types::Cg, ast::CycleExpr, <>,
   <(Addr, ast::ValueType)|> => (Addr, ast::ValueType)
codegen_eval_indexed_cycle = cg, c, is_rng, iv_opt =>
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   i64t = LLVMInt64Type!
   dummy_rng = ast::RangeExpr((<->, <->, ast::Expr(Var, "?"),
      ast::Expr(Var, "?")))
   rng = c.iterable [Range r] r | dummy_rng
   start_val = is_rng
      | cycle_range_start(cg, rng)
      | LLVMConstInt(i64t, 0, 0)
   rng_lhs_opt = is_rng && rng.has_lhs
      | <+ expr::codegen_eval(cg, rng.lhs) ->
      | <-->
   rng_is_rune = is_rng && (rng_lhs_opt | lhs => types::is_rune_vt(lhs.1) | <->)
   raw_is_str = iv_opt | iv => iv.1 [Str] | <->
   is_str = !is_rng && raw_is_str
   raw_is_rec = iv_opt | iv => iv.1 [Record] | <->
   is_rec = !is_rng && raw_is_rec
   raw_is_sl = iv_opt | iv => iv.1 [Slice] | <->
   is_sl = !is_rng && raw_is_sl
   raw_is_arr = iv_opt | iv => iv.1 [Array] | <->
   is_arr = !is_rng && raw_is_arr
   iv_val = iv_opt | iv => iv.0 | LLVMConstInt(i64t, 0, 0)
   rec_info = is_rec
      | cycle_record_info(cg, c.iterable)
      | (0, ast::ValueType(Unknown), LLVMInt64Type!)
   vname = c.iterable [Var v] types::resolve_var_name(cg, v) | ""
   v_dt = vname != "" | types::var_dtype(cg, vname) | ""
   iter_dt = v_dt != "" | v_dt | cg.last_type
   sl_dt = is_sl | slice_elem_dtype(cg, iter_dt) | ""
   sl_ti = types::typedef_ti(cg, sl_dt)
   sl_vt0 = types::vt_from_ti(sl_ti)
   fvs = vname != "" | match::var_fvts(cg, vname) | ast::VTypes()
   sl_vt = sl_vt0 != ast::ValueType(Unknown) | sl_vt0 |
      (?fvs > 0 | (fvs(0) | _ | ast::ValueType(Int)) | ast::ValueType(Int))
   sl_is_ptr = types::is_ptrish_vt(sl_vt)
   sl_elem_ll = sl_is_ptr
      | LLVMPointerType(LLVMInt8Type!, 0)
      | types::llvm_type_of_vt(sl_vt)
   arr_dt = is_arr | iter_dt | ""
   arr_vt = is_arr
      | cycle_array_elem_vt(cg, vname, arr_dt)
      | ast::ValueType(Unknown)
   arr_elem_dt = is_arr | slice_elem_dtype(cg, arr_dt) | ""
   rec_m = is_arr && arr_elem_dt != ""
      | types::td_record_meta_by_name(cg, arr_elem_dt)
      | <-->
   arr_elem_rt_opt = rec_m | m => <+ m.0 -> | <-->
   arr_is_ptr = types::is_ptrish_vt(arr_vt)
   arr_elem_ll = arr_is_ptr
      | LLVMPointerType(LLVMInt8Type!, 0)
      | types::llvm_type_of_vt(arr_vt)
   arr_val_opt = is_arr
      | <+ (vname != "" | types::ptr_var_value(cg, vname, "arr.cycle.ptr") | iv_val) ->
      | <-->
   end_val = is_rng
      | cycle_range_end(cg, rng)
      |
         is_str
            | expr::codegen_string_len(cg, iv_val, "str.cycle.len")
            |
               is_rec
                  | LLVMConstInt(i64t, rec_info.0, 0)
                  |
                     is_sl
                        | main::slice_len(cg, iv_val, "slice.cycle.len")
                        |
                           is_arr
                              | main::builder_len(cg, arr_val_opt!!, "arr.cycle.len")
                              | iv_val
   counter_alloca = types::hoisted_alloca(cg, i64t, "loop.idx." + sc)
   LLVMBuildStore(cg.builder, start_val, counter_alloca)
   step_alloca = types::hoisted_alloca(cg, i64t, "loop.step." + sc)
   header = LLVMAppendBasicBlock(cg.current_fn, "loop.header." + sc)
   body = LLVMAppendBasicBlock(cg.current_fn, "loop.body." + sc)
   latch = LLVMAppendBasicBlock(cg.current_fn, "loop.latch." + sc)
   done = LLVMAppendBasicBlock(cg.current_fn, "loop.exit." + sc)
   break_target = cg.escape_bb | _ | done
   cg.escape_bb = <-->
   cg.cycle_breaks += break_target
   cg.cycle_conts += latch
   branch_to(cg, header)
   LLVMPositionBuilderAtEnd(cg.builder, header)
   curr_i = LLVMBuildLoad2(cg.builder, i64t, counter_alloca,
      "counter.load")
   is_unbounded = is_rng && !rng.has_rhs
   is_unbounded
      | branch_to(cg, body)
      |
         cond = LLVMBuildICmp(cg.builder, 40, curr_i, end_val,
            "loop.cond")
         LLVMBuildCondBr(cg.builder, cond, body, done)
   LLVMPositionBuilderAtEnd(cg.builder, body)
   str_rune = is_str && c.is_rune
   r_dec_opt = str_rune
      | <+ codegen_decode_rune_at(cg, expr::codegen_string_data(cg, iv_val,
         "s.cycle.data"), curr_i) ->
      | <-->
   step_val = r_dec_opt
      | rd => rd.1
      | LLVMConstInt(i64t, 1, 0)
   LLVMBuildStore(cg.builder, step_val, step_alloca)
   has_elem = is_str || is_rec || is_sl || is_arr
   elem_vt = is_arr
      | arr_vt
      |
         is_sl
            | sl_vt
            |
               str_rune
                  | ast::ValueType(Rune)
                  |
                     is_str
                        | ast::ValueType(Int)
                        | (rng_is_rune | ast::ValueType(Rune) | rec_info.1)
   elem_dt = is_arr | arr_elem_dt | (is_sl | sl_dt | "")
   elem_rt_opt = is_arr
      | arr_elem_rt_opt
      | (is_rec | <+ rec_info.2 -> | <-->)
   elem_val_rec_opt = is_arr
      | <+ cycle_array_elem_val(cg, arr_val_opt!!, curr_i, arr_is_ptr, arr_vt,
         arr_elem_ll) ->
      |
         is_sl
            |
               data_ptr = main::slice_data(cg, iv_val, "slice.data")
               typed_data = LLVMBuildPointerCast(cg.builder, data_ptr,
                  LLVMPointerType(sl_elem_ll, 0), "slice.data.typed")
               elem_gep2 = types::gep1(cg, sl_elem_ll, typed_data, curr_i,
                  "slice.elem.gep")
               <+ LLVMBuildLoad2(cg.builder, sl_elem_ll, elem_gep2, "slice.elem") ->
            |
               str_rune
                  | <+ r_dec_opt!! .0 ->
                  |
                     is_str
                        | <+ cycle_str_elem(cg, iv_val, curr_i) ->
                        |
                           is_rec
                              |
                                 typed_arr = LLVMBuildPointerCast(cg.builder, iv_val,
                                    LLVMPointerType(rec_info.2, 0), "rec.typed")
                                 elem_gep = types::gep1(cg, rec_info.2, typed_arr,
                                    curr_i, "rec.elem.gep")
                                 elem_is_rec = rec_info.1 [Record]
                                 rec_val = elem_is_rec
                                    | elem_gep
                                    | LLVMBuildLoad2(cg.builder, rec_info.2, elem_gep,
                                       "rec.elem")
                                 <+ rec_val ->
                              | <-->
   pos_i = is_rng
      | LLVMBuildSub(cg.builder, curr_i, start_val, "idx.pos")
      | curr_i
   elem_val = elem_val_rec_opt
      | ev => ev
      | pos_i
   cycle_bind_params(cg, c.body_fn, has_elem, elem_val, elem_vt, elem_dt,
      curr_i, counter_alloca, elem_rt_opt)
   saved_discard = cg.discard_result
   cg.discard_result = <+>
   bv = codegen_eval_cycle_body(cg, c.body_fn)
   cg.discard_result = saved_discard
   branch_to(cg, latch)
   LLVMPositionBuilderAtEnd(cg.builder, latch)
   loaded_i = LLVMBuildLoad2(cg.builder, i64t, counter_alloca,
      "c.load")
   loaded_step = LLVMBuildLoad2(cg.builder, i64t, step_alloca,
      "c.step")
   next_i = LLVMBuildAdd(cg.builder, loaded_i, loaded_step, "c.next")
   LLVMBuildStore(cg.builder, next_i, counter_alloca)
   branch_to(cg, header)
   nb = ?cg.cycle_breaks
   cg.cycle_breaks = cycle_trunc(cg.cycle_breaks, nb - 1)
   cg.cycle_conts = cycle_trunc(cg.cycle_conts, nb - 1)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   is_void = bv.1 [Unit, Unknown]
   is_void
      | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      | (LLVMConstNull(types::llvm_type_of_vt(bv.1)), bv.1)

codegen_eval_cycle_valid: types::Cg, ast::CycleExpr => (Addr, ast::ValueType)
codegen_eval_cycle_valid = cg, c =>
   is_rng = c.iterable [Range _]
   is_rng
      | codegen_eval_indexed_cycle(cg, c, <+>, <-->)
      |
         iv = expr::codegen_eval(cg, c.iterable)
         is_flag = iv.1 [Flag]
         is_ram = iv.1 [Ram]
         is_cond = is_flag || is_ram
         is_map = iv.1 [Map]
         is_cond
            | codegen_eval_condition_cycle(cg, c)
            |
               is_map
                  | codegen_eval_map_cycle(cg, c, iv.0)
                  | codegen_eval_indexed_cycle(cg, c, <->, <+ iv ->)

// Truncates a stack (the first n elements).
cycle_trunc: types::Addrs, Int => types::Addrs
cycle_trunc = st, n =>
   res = types::Addrs()
   n @ i =>
      res += st(i)!!
   res

// "-->" / "--^": break or continue the innermost enclosing cycle. A break
// under a cycle-escape routes to the escape block instead of the loop exit.
codegen_eval_cycle_jump: types::Cg, ast::CycleJumpExpr => (Addr, ast::ValueType)
codegen_eval_cycle_jump = cg, j =>
   nb = ?cg.cycle_breaks
   nb == 0
      | codegen_cycle_jump_outside(cg, j)
      | j.level > nb
         | codegen_cycle_jump_too_deep(cg, j, nb)
         | codegen_eval_cycle_jump_valid(cg, j, nb)

codegen_cycle_jump_outside: types::Cg, ast::CycleJumpExpr => (Addr, ast::ValueType)
codegen_cycle_jump_outside = cg, j =>
   op = j.is_break | "-->" | "--^"
   types::init_error(cg, "E3006", "'" + op +
      "' cannot be used outside of a cycle context (@).", 0, 0)
   (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_cycle_jump_too_deep: types::Cg, ast::CycleJumpExpr, Int => (Addr, ast::ValueType)
codegen_cycle_jump_too_deep = cg, j, depth =>
   op = j.is_break | "-->" | "--^"
   types::init_error(cg, "E3007", "'" + op + "' targets cycle-nesting level " +
      str::from_int(j.level) + ", but only " + str::from_int(depth) +
      " enclosing cycle(s) exist at this point.", 0, 0)
   (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))

codegen_eval_cycle_jump_valid: types::Cg, ast::CycleJumpExpr, Int => (Addr, ast::ValueType)
codegen_eval_cycle_jump_valid = cg, j, nb =>
   target = j.is_break
      | cg.cycle_breaks(nb - j.level)!!
      | cg.cycle_conts(nb - j.level)!!
   branch_to(cg, target)
   (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))

// "cycle >-- branch" — a cycle-escape expression: if the cycle's "-->" fires,
// the branch value becomes the positive payload of < T | >; otherwise <--> (Noth).
codegen_eval_cycle_escape: types::Cg, ast::CycleEscapeExpr => (Addr, ast::ValueType)
codegen_eval_cycle_escape = cg, e =>
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   res_lt = i8p
   branch_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.branch." + sc)
   merge_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.merge." + sc)
   res_alloca = types::hoisted_alloca(cg, res_lt, "escape.res." + sc)
   u_none = types::codegen_build_union(cg, 3, ast::Exprs(), "escape.none." + sc)
   LLVMBuildStore(cg.builder, u_none, res_alloca)
   cg.escape_bb = <+ branch_bb ->
   cv = expr::codegen_eval(cg, e.cycle)
   branch_to(cg, merge_bb)
   LLVMPositionBuilderAtEnd(cg.builder, branch_bb)
   ev = expr::codegen_eval(cg, e.branch)
   u_some = runtime::codegen_build_union_ev(cg, 1, ev.0, ev.1)
   LLVMBuildStore(cg.builder, u_some, res_alloca)
   branch_to(cg, merge_bb)
   LLVMPositionBuilderAtEnd(cg.builder, merge_bb)
   res_val = LLVMBuildLoad2(cg.builder, res_lt, res_alloca, "escape.res")
   (res_val, ast::ValueType(Ram))

// --- functions ---------------------------------------------------------------

// Is a param already inferred String?
param_str: String, ast::Names, ast::VTypes => <>
param_str = v, params, ptypes => param_str_at(v, params, ptypes, 0, ?params)

param_str_at: String, ast::Names, ast::VTypes, Int, Int => <>
param_str_at = v, params, ptypes, i, n =>
   i == n
      | <->
      |
         pn = params(i) | _ | ""
         pt = ptypes(i) | _ | ast::ValueType(Unknown)
         (pn == v) && (pt [Str])
            | <+>
            | param_str_at(v, params, ptypes, i + 1, n)

// Is an expression String-typed (a Str literal, or a String-inferred param)?
e_is_str: ast::Expr, ast::Names, ast::VTypes => <>
e_is_str = e, params, ptypes =>
   e
      [Str s] <+>
      [Var v] param_str(v, params, ptypes)
      | <->

// Does `e` reference the variable `name`?
refs: ast::Expr, String => <>
refs = e, name =>
   e
      [Var v] v == name
      [Bin t] refs(t.1, name) || refs(t.2, name)
      | <->

str_used_block: ast::BlockExpr, String, ast::Names, ast::VTypes => <>
str_used_block = b, name, env_p, env_t =>
   nb = ?b.exprs
   nb > 0 | str_used((b.exprs(nb - 1) | _ | ast::Expr(Var, "")), name,
      env_p, env_t) | <->

// Does `name` appear as the non-String operand of a String op anywhere in e?
str_used: ast::Expr, String, ast::Names, ast::VTypes => <>
str_used = e, name, env_p, env_t =>
   e
      [Bin t] str_used_bin(t, name, env_p, env_t)
      [Fn f] str_used(f.body, name, env_p, env_t)
      [Block b] str_used_block(b, name, env_p, env_t)
      | <->

str_used_bin: (ast::BinaryOp, ast::Expr, ast::Expr), String, ast::Names,
   ast::VTypes => <>
str_used_bin = t, name, env_p, env_t =>
   s1 = e_is_str(t.1, env_p, env_t)
   s2 = e_is_str(t.2, env_p, env_t)
   str_used(t.1, name, env_p, env_t) || str_used(t.2, name, env_p, env_t) ||
      (s1 && refs(t.2, name)) || (s2 && refs(t.1, name))

// A param's inferred type.
param_vt: String, ast::Names, ast::VTypes => ast::ValueType
param_vt = v, params, ptypes => param_vt_at(v, params, ptypes, 0, ?params)

param_vt_at: String, ast::Names, ast::VTypes, Int, Int => ast::ValueType
param_vt_at = v, params, ptypes, i, n =>
   i == n
      | ast::ValueType(Unknown)
      |
         pn = params(i)!!
         (pn == v)
            | (ptypes(i) | _ | ast::ValueType(Unknown))
            | param_vt_at(v, params, ptypes, i + 1, n)

// Is an expression Int-typed (an Int/Rune/SizeOf literal, or Int param)?
e_is_int: ast::Expr, ast::Names, ast::VTypes => <>
e_is_int = e, params, ptypes =>
   e
      [Int _] <+>
      [Rune _] <+>
      [SizeOf _] <+>
      [Var v] param_int(v, params, ptypes)
      [Unary u]
         u.0 [Length]
      [Bin t]
         is_arith = t.0 [Add, Sub, Mul, Div, Mod, BitAnd, BitOr, Shl, Shr]
         is_arith && (e_is_int(t.1, params, ptypes) ||
            e_is_int(t.2, params, ptypes))
      | <->

// Is a param already inferred Int?
param_int: String, ast::Names, ast::VTypes => <>
param_int = v, params, ptypes => param_int_at(v, params, ptypes, 0, ?params)

param_int_at: String, ast::Names, ast::VTypes, Int, Int => <>
param_int_at = v, params, ptypes, i, n =>
   i == n
      | <->
      |
         pn = params(i) | _ | ""
         pt = ptypes(i) | _ | ast::ValueType(Unknown)
         (pn == v) && (pt [Int, Rune, I8, I16, I32, U8, U16, U32, U64])
            | <+>
            | param_int_at(v, params, ptypes, i + 1, n)

infer_ret_choice_branches: ast::Branches, ast::Names, ast::VTypes, Int,
   Int, <> => ast::ValueType
infer_ret_choice_branches = brs, params, ptypes, i, n, has_unit =>
   i == n
      | (has_unit | ast::ValueType(Unit) | ast::ValueType(Unknown))
      |
         br = brs(i)!!
         vt = infer_ret(br.block, params, ptypes)
         is_unit = vt == ast::ValueType(Unit)
         (vt != ast::ValueType(Unknown)) && !is_unit
            | vt
            | infer_ret_choice_branches(brs, params, ptypes, i + 1, n,
               has_unit || is_unit)

// The inferred return type of a function body.
infer_ret: ast::Expr, ast::Names, ast::VTypes => ast::ValueType
infer_ret = e, params, ptypes =>
   e
      [Int n] ast::ValueType(Int)
      [SizeOf _] ast::ValueType(Int)
      [Rune n] ast::ValueType(Rune)
      [Float f] ast::ValueType(Float)
      [Str s] ast::ValueType(Str)
      [Fn f] ast::ValueType(Fn)
      [Record _] ast::ValueType(Record)
      [BuilderCreate _] ast::ValueType(Builder)
      [Var v] param_vt(v, params, ptypes)
      [Choice c]
         ct = types::ctfe_eval_type_choice_simple(c)
         ct.1
            |
               idx = ct.0
               idx !< 0 && idx < ?c.branches
                  | infer_ret(c.branches(idx)!!.block, params, ptypes)
                  | ast::ValueType(Unknown)
            | infer_ret_choice_branches(c.branches, params, ptypes, 0,
               ?c.branches, <->)
      [Bin t]
         t.0
            [Seq] infer_ret(t.2, params, ptypes)
            [Gt, Lt, Eq, NotGt, NotLt, NotEq] ast::ValueType(Flag)
            [And, Or] ast::ValueType(Flag)
            [Mod, BitAnd, BitOr, Shl, Shr] ast::ValueType(Int)
            |
               e_is_str(t.1, params, ptypes) || e_is_str(t.2, params, ptypes)
                  | ast::ValueType(Str)
                  |
                     e_is_flt(t.1, params, ptypes) ||
                        e_is_flt(t.2, params, ptypes)
                        | ast::ValueType(Float)
                        |
                           e_is_int(t.1, params, ptypes) ||
                              e_is_int(t.2, params, ptypes)
                              | ast::ValueType(Int)
                              | ast::ValueType(Unknown)
      [Unary u]
         u.0
            [Length] ast::ValueType(Int)
            [AddrOf] ast::ValueType(RawPtr)
            [Freeze] ast::ValueType(Str)
            [Not] ast::ValueType(Flag)
            [BitNot] ast::ValueType(Int)
            [RuneCount] ast::ValueType(Int)
            | infer_ret(u.1, params, ptypes)
      [Block b] infer_ret_block(b.exprs, params, ptypes)
      [Return r]
         r.has_val | infer_ret(r.val, params, ptypes) | ast::ValueType(Unit)
      | ast::ValueType(Unknown)

// The return type of a block body: the last statement's (0 statements = Unit).
infer_ret_block: ast::Exprs, ast::Names, ast::VTypes => ast::ValueType
infer_ret_block = es, params, ptypes =>
   n = ?es
   n == 0
      | ast::ValueType(Unit)
      | infer_ret(es(n - 1)!!, params, ptypes)


param_rec_effective: types::Cg, String => <(Addr, ast::Names, ast::VTypes)|>
param_rec_effective = cg, v =>
   pr = param_rec_of(cg, types::g.last_compiling_fn + "#" + v)
   pr
      | p => <+ p ->
      | param_rec_of(cg, v)

call_target_fn_name: ast::CallExpr => String
call_target_fn_name = c =>
   c.fn_name != ""
      | c.fn_name
      |
         c.fn_target
            [Var tv] tv
            | ""

fn_ret_record_field_rt: types::Cg, ast::TypeInfo, String => <Addr|>
fn_ret_record_field_rt = cg, ti, field_name =>
   rm = runtime::record_meta_from_ti(cg, ti)
   fnames = rm | m => m.1 | ast::Names()
   idx = types::member_index(fnames, field_name)
   idx !< 0
      |
         fti = types::record_field_ti(cg, ti, idx)
         frm = runtime::record_meta_from_ti(cg, fti)
         frm | m => <+ m.0 -> | <-->
      | <-->

fn_ret_member_rt: types::Cg, ast::MemberExpr => <Addr|>
fn_ret_member_rt = cg, m =>
   m.target
      [Var v]
         pr = param_rec_effective(cg, v)
         pr
            | p =>
               idx = types::member_index(p.1, m.field_name)
               idx !< 0
                  | <+ LLVMStructGetTypeAtIndex(p.0, idx) ->
                  |
                     vdt = types::var_dtype(cg, v)
                     vdt != ""
                        |
                           ti' = types::typedef_ti(cg, vdt)
                           fn_ret_record_field_rt(cg, ti', m.field_name)
                        |
                           ti2 = types::typedef_ti_of_rt(cg, p.0)
                           fn_ret_record_field_rt(cg, ti2, m.field_name)
            |
               vdt = types::var_dtype(cg, v)
               vdt != ""
                  |
                     ti' = types::typedef_ti(cg, vdt)
                     fn_ret_record_field_rt(cg, ti', m.field_name)
                  | <-->
      [Member inner_m]
         inner_rt = fn_ret_member_rt(cg, inner_m)
         inner_rt
            | rt =>
               tname = types::typedef_name_of_rt(cg, rt)
               ti' = types::typedef_ti(cg, tname)
               fn_ret_record_field_rt(cg, ti', m.field_name)
            | <-->
      | <-->

param_rec_field_vt: <(Addr, ast::Names, ast::VTypes)|>, String => ast::ValueType
param_rec_field_vt = pr_opt, field_name =>
   pr_opt
      | pr =>
         idx = types::member_index(pr.1, field_name)
         idx !< 0
            |
               fvts = pr.2
               fvts(idx) | _ | ast::ValueType(Unknown)
            | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)

param_rec_first_vt: <(Addr, ast::Names, ast::VTypes)|> => ast::ValueType
param_rec_first_vt = pr_opt =>
   pr_opt
      | pr =>
         fvts = pr.2
         ?fvts > 0
            | (fvts(0) | _ | ast::ValueType(Unknown))
            | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)

fn_ret_record_field_vt: types::Cg, ast::TypeInfo, String => ast::ValueType
fn_ret_record_field_vt = cg, ti, field_name =>
   rm = runtime::record_meta_from_ti(cg, ti)
   fvts = types::field_vts(cg, ti)
   fnames = rm | m => m.1 | ast::Names()
   idx = types::member_index(fnames, field_name)
   idx !< 0
      | (fvts(idx) | _ | ast::ValueType(Unknown))
      | ast::ValueType(Unknown)

fn_ret_member_vt: types::Cg, ast::MemberExpr => ast::ValueType
fn_ret_member_vt = cg, m =>
   m.target
      [Var v]
         pr = param_rec_effective(cg, v)
         pvt = param_rec_field_vt(pr, m.field_name)
         pvt != ast::ValueType(Unknown)
            | pvt
            |
               vdt = types::var_dtype(cg, v)
               vdt != ""
                  |
                     ti' = types::typedef_ti(cg, vdt)
                     fn_ret_record_field_vt(cg, ti', m.field_name)
                  |
                     pr
                        | p =>
                           ti2 = types::typedef_ti_of_rt(cg, p.0)
                           fn_ret_record_field_vt(cg, ti2, m.field_name)
                        | ast::ValueType(Unknown)
      [Member inner_m]
         inner_rt = fn_ret_member_rt(cg, inner_m)
         inner_rt
            | rt =>
               tname = types::typedef_name_of_rt(cg, rt)
               ti' = types::typedef_ti(cg, tname)
               fn_ret_record_field_vt(cg, ti', m.field_name)
            | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)

typedef_vt: types::Cg, String, ast::ValueType => ast::ValueType
typedef_vt = cg, name, fallback =>
   types::is_user_type(cg, name)
      |
         ti = types::typedef_ti(cg, name)
         ti
            [Ram _] ast::ValueType(Ram)
            [Enum _] ast::ValueType(Ram)
            [Rec _] ast::ValueType(Record)
            | fallback
      | fallback

fn_clo_ret: types::Cg, String => ast::ValueType
fn_clo_ret = cg, fname =>
   c1 = param_clo_ret(cg, fname)
   c1 != ast::ValueType(Unknown)
      | c1
      | param_clo_ret_at(cg, fname, 0, ?cg.param_clo_names)

fn_block_var_type: types::Cg, ast::Expr, String => ast::ValueType
fn_block_var_type = cg, body, name =>
   stmts = fn_block_stmts(body)
   fn_block_var_type_at(cg, stmts, name, ?stmts - 1)

fn_assign_member: types::Cg, ast::Exprs, ast::MemberExpr, String, Int => ast::ValueType
fn_assign_member = cg, stmts, m, name, i =>
   mv = fn_ret_member_vt(cg, m)
   mv != ast::ValueType(Unknown)
      | mv
      | fn_block_var_type_at(cg, stmts, name, i - 1)

fn_assign_type: types::Cg, ast::Exprs, ast::Expr, String, String,
   Int => ast::ValueType
fn_assign_type = cg, stmts, rhs, name, dt, i =>
   rhs
      [Fn _] ast::ValueType(Fn)
      |
         dt != "" && fn_has_signature(stmts, name, 0)
            | ast::ValueType(Fn)
            |
               svt = types::static_expr_vt(cg, rhs)
               svt != ast::ValueType(Unknown)
                  | svt
                  |
                     uvt = typedef_vt(cg, dt, ast::ValueType(Unknown))
                     uvt != ast::ValueType(Unknown)
                        | uvt
                        |
                           rhs
                              [Member m]
                                 fn_assign_member(cg, stmts, m, name, i)
                              [Var v2]
                                 fn_block_var_type_at(cg, stmts, v2, i - 1)
                              | fn_block_var_type_at(cg, stmts, name, i - 1)

fn_block_var_type_at: types::Cg, ast::Exprs, String, Int => ast::ValueType
fn_block_var_type_at = cg, stmts, name, i =>
   i < 0
      | ast::ValueType(Unknown)
      |
         e = stmts(i)!!
         e
            [Assign t]
               t.0 == name
                  | fn_assign_type(cg, stmts, t.5, name, t.7, i)
                  | fn_block_var_type_at(cg, stmts, name, i - 1)
            | fn_block_var_type_at(cg, stmts, name, i - 1)

// A function whose body is a user-type ctor call ("Opt(<+ 5 +>)" returns a
// ram, "P(3, 4)" a record) — infer_ret can't see user types, so override.
fn_ret_override: types::Cg, ast::Expr, ast::ValueType => ast::ValueType
fn_ret_override = cg, body, cur =>
   cur != ast::ValueType(Unknown) && cur != ast::ValueType(Unit)
      | cur
      |
         body
            [Return r]
               r.has_val | fn_ret_override(cg, r.val, cur) | cur
            [Call c]
               uvt = typedef_vt(cg, c.fn_name, ast::ValueType(Unknown))
               uvt != ast::ValueType(Unknown)
                  | uvt
                  | fn_ret_var_override(cg, body, cur)
            | fn_ret_var_override(cg, body, cur)

fn_ret_choice_override: types::Cg, ast::Expr, ast::ChoiceExpr,
   ast::ValueType => ast::ValueType
fn_ret_choice_override = cg, body, c, cur =>
   bvt = fn_ret_choice_branches_override(cg, body, c.branches, cur, 0,
      ?c.branches)
   bvt != ast::ValueType(Unknown) && bvt != cur
      | bvt
      | fn_ret_choice_cond_payload(cg, body, c.cond, cur)

fn_ret_choice_branches_override: types::Cg, ast::Expr, ast::Branches,
   ast::ValueType, Int, Int => ast::ValueType
fn_ret_choice_branches_override = cg, body, brs, cur, i, n =>
   i == n
      | ast::ValueType(Unknown)
      |
         br = brs(i)!!
         target = fn_last_expr(br.block)
         bvt = fn_ret_var_override_target(cg, body, target, cur)
         (bvt != ast::ValueType(Unknown)) && (bvt != cur)
            | bvt
            | fn_ret_choice_branches_override(cg, body, brs, cur, i + 1, n)

fn_ret_choice_cond_payload: types::Cg, ast::Expr, ast::Expr,
   ast::ValueType => ast::ValueType
fn_ret_choice_cond_payload = cg, body, cond, cur =>
   cond
      [Call call]
         name = call.fn_name
         is_arr = types::is_array_vt(types::var_type(cg, name)) ||
            typedef_is_array(cg, types::var_dtype(cg, name)) ||
            param_arr_of(cg, name) ||
            param_arr_of(cg, types::g.last_compiling_fn + "#" + name) ||
            fn_body_has_array_anno(cg, body, name)
         is_arr
            |
               elem_vt = main::array_elem_vt(cg, name)
               elem_vt != ast::ValueType(Unknown)
                  | elem_vt
                  |
                     elem_from_body = fn_body_array_elem_vt(body, name)
                     elem_from_body != ast::ValueType(Unknown)
                        | elem_from_body
                        |
                           local_dt = fn_body_array_dtype(body, name)
                           local_dt != ""
                              | fn_array_elem_vt_of_dtype(cg, local_dt)
                              | cur
            |
               is_sl = types::is_slice_vt(types::var_type(cg, name)) ||
                  param_sl_of(cg, name) ||
                  param_sl_of(cg, types::g.last_compiling_fn + "#" + name)
               is_sl
                  |
                     ti' = types::typedef_ti(cg, types::var_dtype(cg, name))
                     ti' [Rec r] (r.1 | r.3 | cur) | cur
                  |
                     ret_ti = fn_signature_return_ti(cg, types::g.pstmts, name, 0)
                     ret_ti [Ram s] s.0.payload_type | cur
      [KeyAccess ka]
         ka.target [Var v]
            ti' = types::typedef_ti(cg, types::var_dtype(cg, v))
            ti' [Map m] m.1 | cur
         | cur
      [Var v]
         ti' = types::typedef_ti(cg, types::var_dtype(cg, v))
         ti' [Ram s] s.0.payload_type | cur
      | cur

// A body whose last expression is a local variable holding a growable array
// ("mk = n => ys: Ints; ys += n; ys") returns the Array, not the Int default.
// The forward annotation inside the body is detected structurally (it is not
// registered in cg.vars until the body compiles, after return-type inference).
fn_var_is_arr: types::Cg, String => <>
fn_var_is_arr = cg, v =>
   param_arr_of(cg, v) || param_arr_of(cg, types::g.last_compiling_fn + "#" + v)

fn_var_is_sl: types::Cg, String => <>
fn_var_is_sl = cg, v =>
   param_sl_of(cg, v) || param_sl_of(cg, types::g.last_compiling_fn + "#" + v)

fn_var_is_fn: types::Cg, String => <>
fn_var_is_fn = cg, v =>
   rf = types::resolve_fn_name(cg, v)
   types::is_fn_name(cg, rf) || types::has_fn_name(cg, rf) || fn_has_signature(types::g.pstmts, rf, 0) ||
      fn_has_signature(types::g.pstmts, v, 0)
      | <+>
      |
         expr::fn_alias(cg, v) != ""
            | <+>
            |
               <>(param_clo_ty(cg, v))
                  | <+>
                  | types::var_type(cg, v) [Fn]

fn_ret_member_override: types::Cg, ast::MemberExpr, ast::ValueType => ast::ValueType
fn_ret_member_override = cg, m, cur =>
   m_vt = fn_ret_member_vt(cg, m)
   m_vt != ast::ValueType(Unknown) | m_vt | cur

fn_ret_var_type: types::Cg, ast::Expr, String, ast::ValueType => ast::ValueType
fn_ret_var_type = cg, body, v, cur =>
   fn_var_is_arr(cg, v)
      | ast::ValueType(Array)
      |
         fn_var_is_sl(cg, v)
            | ast::ValueType(Slice)
            |
               fn_var_is_fn(cg, v)
                  | ast::ValueType(Fn)
                  |
                     bvt = fn_block_var_type(cg, body, v)
                     bvt != ast::ValueType(Unknown) | bvt | cur

fn_body_is_builder: ast::Expr, String => <>
fn_body_is_builder = e, v =>
   stmts = fn_block_stmts(e)
   fn_body_is_builder_at(stmts, v, 0, ?stmts)

fn_body_is_builder_at: ast::Exprs, String, Int, Int => <>
fn_body_is_builder_at = stmts, v, i, n =>
   i == n
      | <->
      |
         fn_stmt_is_builder(stmts(i)!!, v)
            | <+>
            | fn_body_is_builder_at(stmts, v, i + 1, n)

fn_stmt_is_builder: ast::Expr, String => <>
fn_stmt_is_builder = e, v =>
   e
      [Assign t] (t.0 == v) && (t.5 [BuilderCreate _] || t.7 == "Builder")
      | <->

fn_local_fn_ret: types::Cg, ast::Expr, String => ast::ValueType
fn_local_fn_ret = cg, body, name =>
   stmts = fn_block_stmts(body)
   fn_local_fn_ret_at(cg, stmts, name, 0, ?stmts)

fn_local_fn_ret_at: types::Cg, ast::Exprs, String, Int, Int => ast::ValueType
fn_local_fn_ret_at = cg, stmts, name, i, n =>
   i == n
      | ast::ValueType(Unknown)
      |
         e = stmts(i)!!
         e
            [Assign t]
               t.0 == name
                  |
                     t.5
                        [Fn f]
                           empty_vts = ast::VTypes()
                           lret = infer_ret(f.body, f.params, empty_vts)
                           fn_ret_override(cg, f.body, lret)
                        | ast::ValueType(Unknown)
                  | fn_local_fn_ret_at(cg, stmts, name, i + 1, n)
            | fn_local_fn_ret_at(cg, stmts, name, i + 1, n)

fn_tap_arg_vt: types::Cg, ast::Expr, ast::Expr => ast::ValueType
fn_tap_arg_vt = cg, body, arg =>
   svt = types::static_expr_vt(cg, arg)
   svt != ast::ValueType(Unknown)
      | svt
      |
         arg
            [Var v]
               vt = types::var_type(cg, v)
               vt != ast::ValueType(Unknown)
                  | vt
                  |
                     bvt = fn_block_var_type(cg, body, v)
                     bvt != ast::ValueType(Unknown)
                        | bvt
                        |
                           hints = call_hint(cg, types::g.pstmts,
                              types::g.last_compiling_fn)
                           ?hints > 0
                              | (hints(0) | _ | ast::ValueType(Unknown))
                              | ast::ValueType(Unknown)
            | ast::ValueType(Unknown)

// FIXME: staircase
fn_ret_call_override: types::Cg, ast::Expr, ast::CallExpr,
   ast::ValueType => ast::ValueType
fn_ret_call_override = cg, body, c, cur =>
   fname = call_target_fn_name(c)
   fn_var_is_arr(cg, fname)
      | ast::ValueType(Ram)
      |
         fn_var_is_sl(cg, fname)
            |
               ?c.args > 0 && (c.args(0)!! [Range _])
                  | ast::ValueType(Slice)
                  | ast::ValueType(Int)
            |
               pvt = param_rec_first_vt(param_rec_effective(cg, fname))
               pvt != ast::ValueType(Unknown)
                  | pvt
                  |
                     (fname == "tap" || fname == "fp::tap") && ?c.args > 0
                        | fn_tap_arg_vt(cg, body, c.args(0)!!)
                        |
                           s_ret = fn_signature_return(cg, types::g.pstmts,
                              fname, 0)
                           s_ret != ast::ValueType(Unknown)
                              | s_ret
                              |
                                 l_ret = fn_local_fn_ret(cg, body, fname)
                                 l_ret != ast::ValueType(Unknown)
                                    | l_ret
                                    |
                                       uvt = typedef_vt(cg, fname,
                                          ast::ValueType(Unknown))
                                       uvt != ast::ValueType(Unknown)
                                          | uvt
                                          |
                                             clo_ret = fn_clo_ret(cg, fname)
                                             clo_ret != ast::ValueType(Unknown)
                                                | clo_ret
                                                | expr::fn_ret_vt_of(cg, fname)

fn_ret_bin_override: types::Cg, ast::Expr,
   (ast::BinaryOp, ast::Expr, ast::Expr), ast::ValueType => ast::ValueType
fn_ret_bin_override = cg, last, t, cur =>
   is_app = t.0 [Feed, Apply]
   is_app
      |
         callee = expr::apply_callee_name(last)
         callee != ""
            |
               uvt = typedef_vt(cg, callee, ast::ValueType(Unknown))
               uvt != ast::ValueType(Unknown)
                  | uvt
                  |
                     s_ret = fn_signature_return(cg, types::g.pstmts, callee, 0)
                     s_ret != ast::ValueType(Unknown)
                        | s_ret
                        |
                           clo_ret = fn_clo_ret(cg, callee)
                           clo_ret != ast::ValueType(Unknown)
                              | clo_ret
                              | expr::fn_ret_vt_of(cg, callee)
            | cur
      |
         t.0
            [Add, Sub, Mul, Div, Mod] ast::ValueType(Int)
            [BitAnd, BitOr, Shl, Shr] ast::ValueType(Int)
            [Gt, Lt, Eq, NotGt, NotLt, NotEq, And, Or]
               ast::ValueType(Flag)
            [Seq] fn_ret_var_override(cg, t.2, cur)
            | cur

fn_ret_unary_override: types::Cg, ast::Expr, ast::UnaryOp, ast::Expr,
   ast::ValueType => ast::ValueType
fn_ret_unary_override = cg, body, op, target, cur =>
   op
      [Freeze] ast::ValueType(Str)
      [AddrOf] ast::ValueType(RawPtr)
      [Not]
         target
            [Var v]
               fn_body_is_builder(body, v)
                  | ast::ValueType(Str)
                  | ast::ValueType(Flag)
            [BuilderCreate _] ast::ValueType(Str)
            | ast::ValueType(Flag)
      [Unwrap]
         target
            [Call c]
               fn_var_is_arr(cg, c.fn_name)
                  | main::array_elem_vt(cg, c.fn_name)
                  | cur
            | cur
      [Propagate]
         target
            [Call c]
               fn_var_is_arr(cg, c.fn_name)
                  | main::array_elem_vt(cg, c.fn_name)
                  | cur
            | cur
      | cur

fn_ret_var_override_target: types::Cg, ast::Expr, ast::Expr,
   ast::ValueType => ast::ValueType
fn_ret_var_override_target = cg, body, target, cur =>
   target
      [Block _]
         fn_ret_var_override_target(cg, body, fn_last_expr(target), cur)
      [Record _] ast::ValueType(Record)
      [BuilderCreate _] ast::ValueType(Builder)
      [Choice c]
         ?c.branches > 0
            | fn_ret_choice_override(cg, body, c, cur)
            | cur
      [Member m] fn_ret_member_override(cg, m, cur)
      [Var v] fn_ret_var_type(cg, body, v, cur)
      [Call c] fn_ret_call_override(cg, body, c, cur)
      [Bin t] fn_ret_bin_override(cg, target, t, cur)
      [Unary u] fn_ret_unary_override(cg, body, u.0, u.1, cur)
      | cur

fn_ret_var_override: types::Cg, ast::Expr, ast::ValueType => ast::ValueType
fn_ret_var_override = cg, body, cur =>
   last = fn_last_expr(body)
   fn_ret_var_override_target(cg, body, last, cur)

// Whether a body's statements forward-annotate `v` with an Array typedef
// ("v: Ints" where Ints is a growable array type).
fn_body_has_array_anno: types::Cg, ast::Expr, String => <>
fn_body_has_array_anno = cg, e, v =>
   stmts = fn_block_stmts(e)
   fn_body_has_array_anno_at(cg, stmts, v, 0, ?stmts)

fn_body_has_array_anno_at: types::Cg, ast::Exprs, String, Int, Int => <>
fn_body_has_array_anno_at = cg, stmts, v, i, n =>
   i == n
      | <->
      |
         fn_stmt_array_anno(cg, stmts(i)!!, v)
            | <+>
            | fn_body_has_array_anno_at(cg, stmts, v, i + 1, n)

fn_block_stmts: ast::Expr => ast::Exprs
fn_block_stmts = e =>
   e
      [Block b] b.exprs
      | ast::Exprs()

fn_stmt_array_anno: types::Cg, ast::Expr, String => <>
fn_stmt_array_anno = cg, e, v =>
   e
      [Assign t]
         (t.0 == v) && (is_fwd_anno(t)) && (typedef_is_array(cg, t.7) || (t.8 [Array _]))
      | <->

fn_body_array_dtype: ast::Expr, String => String
fn_body_array_dtype = e, v =>
   stmts = fn_block_stmts(e)
   fn_body_array_dtype_at(stmts, v, 0, ?stmts)

fn_body_array_elem_vt_at: ast::Exprs, String, Int, Int => ast::ValueType
fn_body_array_elem_vt_at = stmts, v, i, n =>
   i == n
      | ast::ValueType(Unknown)
      |
         e = stmts(i)!!
         e [Assign t]
            ((t.0 == v) && is_fwd_anno(t))
               |
                  t.8
                     [Array a] a.0
                     | fn_body_array_elem_vt_at(stmts, v, i + 1, n)
               | fn_body_array_elem_vt_at(stmts, v, i + 1, n)
         | fn_body_array_elem_vt_at(stmts, v, i + 1, n)

fn_body_array_elem_vt: ast::Expr, String => ast::ValueType
fn_body_array_elem_vt = e, v =>
   stmts = fn_block_stmts(e)
   fn_body_array_elem_vt_at(stmts, v, 0, ?stmts)

fn_body_array_dtype_at: ast::Exprs, String, Int, Int => String
fn_body_array_dtype_at = stmts, v, i, n =>
   i == n
      | ""
      |
         e = stmts(i)!!
         e [Assign t]
            ((t.0 == v) && is_fwd_anno(t))
               | t.7
               | fn_body_array_dtype_at(stmts, v, i + 1, n)
         | fn_body_array_dtype_at(stmts, v, i + 1, n)

fn_array_elem_vt_of_dtype: types::Cg, String => ast::ValueType
fn_array_elem_vt_of_dtype = cg, dt =>
   ti = types::typedef_ti(cg, dt)
   ti
      [Array a]
         resolved_ti = a.1 [TypeVar n] types::typedef_ti(cg, n) | a.1
         resolved_vt = types::vt_from_ti(resolved_ti)
         resolved_vt != ast::ValueType(Unknown) | resolved_vt | a.0
      | ast::ValueType(Int)

is_fwd_anno: (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => <>
is_fwd_anno = t => t.5 [Var vv] (vv == "<fwd>") | <->

// Whether a '#type' name is a growable-array typedef.
typedef_is_array: types::Cg, String => <>
typedef_is_array = cg, name =>
   types::typedef_ti(cg, name) [Array _]
   
// The last expression of a body (unwraps a trailing Block).
fn_last_expr: ast::Expr => ast::Expr
fn_last_expr = e =>
   e
      [Block b]
         n = ?b.exprs
         n == 0 | ast::Expr(Var, "?") | fn_last_expr(b.exprs(n - 1)!!)
      | e

expr_is_heap_val: types::Cg, ast::Expr => <>
expr_is_heap_val = cg, e =>
   e
      [Call c]
         types::is_user_type(cg, c.fn_name) ||
            param_sl_of(cg, c.fn_name) ||
            param_sl_of(cg, types::g.last_compiling_fn + "#" + c.fn_name) ||
            param_arr_of(cg, c.fn_name) ||
            param_arr_of(cg, types::g.last_compiling_fn + "#" + c.fn_name)
      [Variant v]
         types::ram_tag_is_heap_unit(v.tag_name) || (?v.args > 0)
      [Choice ch]
         nb = ?ch.branches
         (nb > 0) && (expr_is_heap_val(cg, ch.branches(0)!!.block) ||
            expr_is_heap_val(cg, ch.branches(nb - 1)!!.block))
      [Block bl]
         ne = ?bl.exprs
         (ne > 0) && expr_is_heap_val(cg, bl.exprs(ne - 1)!!)
      | <->

fn_ret_heap: types::Cg, String, ast::Expr, ast::ValueType => <>
fn_ret_heap = cg, fname, body, ret_vt =>
   is_ram = ret_vt [Ram, Enum]
   !is_ram
      | <->
      |
         sig_ti = fn_signature_return_ti(cg, types::g.pstmts, fname, 0)
         sig_heap = match::ram_ti_is_heap(cg, sig_ti)
         sig_heap || expr_is_heap_val(cg, body)

// Is an expression Float-typed (a Float literal, or a Float-inferred param)?
e_is_flt: ast::Expr, ast::Names, ast::VTypes => <>
e_is_flt = e, params, ptypes =>
   e
      [Float f] <+>
      [Var v] param_flt(v, params, ptypes)
      | <->

// Is a param already inferred Float?
param_flt: String, ast::Names, ast::VTypes => <>
param_flt = v, params, ptypes => param_flt_at(v, params, ptypes, 0, ?params)

param_flt_at: String, ast::Names, ast::VTypes, Int, Int => <>
param_flt_at = v, params, ptypes, i, n =>
   i == n
      | <->
      |
         pn = params(i) | _ | ""
         pt = ptypes(i) | _ | ast::ValueType(Unknown)
         (pn == v) && (pt [Float])
            | <+>
            | param_flt_at(v, params, ptypes, i + 1, n)

flt_used_block: ast::BlockExpr, String, ast::Names, ast::VTypes => <>
flt_used_block = b, name, env_p, env_t =>
   nb = ?b.exprs
   nb > 0 | flt_used((b.exprs(nb - 1) | _ | ast::Expr(Var, "")), name, env_p, env_t) | <->

flt_used_bin: (ast::BinaryOp, ast::Expr, ast::Expr), String, ast::Names, ast::VTypes => <>
flt_used_bin = t, name, env_p, env_t =>
   f1 = e_is_flt(t.1, env_p, env_t)
   f2 = e_is_flt(t.2, env_p, env_t)
   flt_used(t.1, name, env_p, env_t) || flt_used(t.2, name, env_p, env_t) ||
      (f1 && refs(t.2, name)) || (f2 && refs(t.1, name))

flt_used: ast::Expr, String, ast::Names, ast::VTypes => <>
flt_used = e, name, env_p, env_t =>
   e
      [Bin t] flt_used_bin(t, name, env_p, env_t)
      [Fn f] flt_used(f.body, name, env_p, env_t)
      [Block b] flt_used_block(b, name, env_p, env_t)
      | <->

int_used_block: ast::BlockExpr, String, ast::Names, ast::VTypes => <>
int_used_block = b, name, env_p, env_t =>
   nb = ?b.exprs
   nb > 0 | int_used((b.exprs(nb - 1) | _ | ast::Expr(Var, "")), name,
      env_p, env_t) | <->

int_used_bin: (ast::BinaryOp, ast::Expr, ast::Expr), String, ast::Names,
   ast::VTypes => <>
int_used_bin = t, name, env_p, env_t =>
   int1 = e_is_int(t.1, env_p, env_t)
   int2 = e_is_int(t.2, env_p, env_t)
   op = t.0
   is_int_op = op [Mod, BitAnd, BitOr, Shl, Shr]
   int_used(t.1, name, env_p, env_t) || int_used(t.2, name, env_p, env_t) ||
      (int1 && refs(t.2, name)) || (int2 && refs(t.1, name)) ||
      (is_int_op && (refs(t.1, name) || refs(t.2, name)))

int_used: ast::Expr, String, ast::Names, ast::VTypes => <>
int_used = e, name, env_p, env_t =>
   e
      [Bin t] int_used_bin(t, name, env_p, env_t)
      [Unary u]
         is_int_u = u.0 [BitNot]
         is_int_u && refs(u.1, name) | <+> | int_used(u.1, name, env_p, env_t)
      [Cycle c]
         refs(c.iterable, name) | <+> | int_used(c.body_fn, name, env_p, env_t)
      [Fn f] int_used(f.body, name, env_p, env_t)
      [Block b] int_used_block(b, name, env_p, env_t)
      | <->

// Infer parameter types from hints or usage. Never defaults to Int.
infer_param_types_at: types::FnDef, ast::VTypes, Int, Int, ast::VTypes, ast::Names,
   ast::VTypes => ast::VTypes
infer_param_types_at = fd, hints, i, n, acc, env_p, env_t =>
   i == n
      | acc
      |
         pn = fd.params(i) | _ | ""
         hint_i = i < ?hints
            | (hints(i) | _ | ast::ValueType(Unknown))
            | ast::ValueType(Unknown)
         hint_known = hint_i != ast::ValueType(Unknown)
         hint_known
            |
               acc += hint_i
               infer_param_types_at(fd, hints, i + 1, n, acc, env_p, env_t)
            |
               str_used(fd.body, pn, env_p, env_t)
                  |
                     acc += ast::ValueType(Str)
                     infer_param_types_at(fd, hints, i + 1, n, acc, env_p,
                        env_t)
                  |
                     flt_used(fd.body, pn, env_p, env_t)
                        |
                           acc += ast::ValueType(Float)
                           infer_param_types_at(fd, hints, i + 1, n, acc,
                              env_p, env_t)
                        |
                           int_used(fd.body, pn, env_p, env_t)
                              |
                                 acc += ast::ValueType(Int)
                                 infer_param_types_at(fd, hints, i + 1, n,
                                    acc, env_p, env_t)
                              |
                                 acc += ast::ValueType(Unknown)
                                 infer_param_types_at(fd, hints, i + 1, n,
                                    acc, env_p, env_t)

infer_param_types_env: types::FnDef, ast::VTypes, ast::Names, ast::VTypes => ast::VTypes
infer_param_types_env = fd, hints, env_p, env_t =>
   infer_param_types_at(fd, hints, 0, ?fd.params, ast::VTypes(), env_p, env_t)

infer_param_types: types::FnDef, ast::VTypes => ast::VTypes
infer_param_types = fd, hints =>
   infer_param_types_env(fd, hints, ast::Names(), ast::VTypes())

// An LLVM function type from a return type + a param type list.
fn_type_n: types::Cg, Addr, types::Addrs, Int => Addr
fn_type_n = cg, ret, params, n =>
   buf = {n * 8}
   sb = &buf
   n @ i =>
      @[sb + i * 8] = params(i)!!
   LLVMFunctionType(ret, sb, n, 0)

fn_type_n_vararg: types::Cg, Addr, types::Addrs, Int, <> => Addr
fn_type_n_vararg = cg, ret, params, n, is_vararg =>
   buf = {n * 8}
   sb = &buf
   n @ i =>
      @[sb + i * 8] = params(i)!!
   LLVMFunctionType(ret, sb, n, (is_vararg | 1 | 0))

param_is_heap_ram: types::Cg, String => <>
param_is_heap_ram = cg, dtype =>
   dtype != ""
      |
         ti = types::typedef_ti(cg, dtype)
         ti
            [Enum _] <+>
            [Ram s] s.0.has_payload || s.1.has_payload
            | <->
      | <->

param_ll_type: types::Cg, Addr, String, ast::ValueType, <>, <>, <>, <> => Addr
param_ll_type = cg, i8p, pdtype, pvt, has_rec, is_arr, is_sl, is_clo =>
   is_clo || has_rec || is_arr || is_sl ||
      param_is_heap_ram(cg, pdtype)
      | i8p
      | types::llvm_type_of_vt(pvt)

ti_is_array: ast::TypeInfo => <>
ti_is_array = ti => ti [Array _]

ti_is_slice: ast::TypeInfo => <>
ti_is_slice = ti =>
   ti
      [Rec r] r.1
      | <->

ti_is_unknown: ast::TypeInfo => <>
ti_is_unknown = ti =>
   ti
      [Prim v]
         is_unk = v [Unknown]
         is_unk
      | <->

codegen_fn_param_rec: types::Cg, String, String,
   ast::TypeInfo => <(Addr, ast::Names, ast::VTypes)|>
codegen_fn_param_rec = cg, pname, pdtype, pti =>
   ti_is_slice(pti)
      | <-->
      |
         rm0 = runtime::record_meta_from_ti(cg, pti)
         rm0
            | m => <+ (m.0, m.1, types::field_vts(cg, pti)) ->
            |
               pdtype != ""
                  |
                     ti = types::typedef_ti(cg, pdtype)
                     rm = runtime::record_meta_from_ti(cg, ti)
                     rm
                        | m2 => <+ (m2.0, m2.1, types::field_vts(cg, ti)) ->
                        | <-->
                  |
                     ti_is_unknown(pti)
                        |
                           prec0 = param_rec_of(cg,
                              types::g.last_compiling_fn + "#" + pname)
                           prec0
                              | p => <+ p ->
                              | (types::g.last_compiling_fn == ""
                                 | param_rec_of(cg, pname)
                                 | <-->)
                        | <-->

param_is_array: types::Cg, String, String, ast::TypeInfo => <>
param_is_array = cg, name, pdtype, pti =>
   ti_is_array(pti)
      | <+>
      |
         pdtype != ""
            | ti_is_array(types::typedef_ti(cg, pdtype))
            |
               ti_is_unknown(pti)
                  |
                     param_arr_of(cg, types::g.last_compiling_fn + "#" + name) ||
                        (types::g.last_compiling_fn == "" && param_arr_of(cg, name))
                  | <->

param_is_slice: types::Cg, String, String, ast::TypeInfo => <>
param_is_slice = cg, name, pdtype, pti =>
   ti_is_slice(pti)
      | <+>
      |
         pdtype != ""
            | ti_is_slice(types::typedef_ti(cg, pdtype))
            |
               ti_is_unknown(pti)
                  |
                     param_sl_of(cg, types::g.last_compiling_fn + "#" + name) ||
                        (types::g.last_compiling_fn == "" && param_sl_of(cg, name))
                  | <->

// A parameter closure's LLVM fn type and return type from its TypeInfo.
fn_type_from_ti: types::Cg, ast::TypeInfo => <(Addr, ast::ValueType)|>
fn_type_from_ti = cg, ti =>
   ti
      [Fn f]
         ret_vt = f.2
         ret_ll = types::llvm_type_of_vt(ret_vt)
         param_ll = types::Addrs()
         n = ?f.0
         n @ i =>
            pv = f.0(i) | _ | ast::ValueType(Unknown)
            param_ll += types::llvm_type_of_vt(pv)
         <+ (fn_type_n(cg, ret_ll, param_ll, n), ret_vt) ->
      | <-->

param_clo_add: types::Cg, String, Addr, ast::ValueType => ()
param_clo_add = cg, name, fty, ret =>
   cg.param_clo_names += name
   cg.param_clo_tys += fty
   cg.param_clo_rets += ret

// The recorded closure fn type of a parameter.
param_clo_ty: types::Cg, String => <Addr|>
param_clo_ty = cg, name =>
   scoped = types::g.last_compiling_fn != ""
      | param_clo_ty_at(cg, types::g.last_compiling_fn + "#" + name, 0, ?cg.param_clo_names)
      | <-->
   <>(scoped)
      | scoped
      |
         types::g.last_compiling_fn != ""
            | <-->
            | param_clo_ty_at(cg, name, 0, ?cg.param_clo_names)

param_clo_ty_at: types::Cg, String, Int, Int => <Addr|>
param_clo_ty_at = cg, name, i, n =>
   i == n
      | <-->
      |
         cg.param_clo_names(i)!! == name
            | (cg.param_clo_tys(i) | ty => <+ ty -> | <-->)
            | param_clo_ty_at(cg, name, i + 1, n)

param_clo_ret: types::Cg, String => ast::ValueType
param_clo_ret = cg, name =>
   scoped = types::g.last_compiling_fn != ""
      | param_clo_ret_at(cg, types::g.last_compiling_fn + "#" + name, 0, ?cg.param_clo_names)
      | ast::ValueType(Unknown)
   scoped != ast::ValueType(Unknown)
      | scoped
      |
         types::g.last_compiling_fn != ""
            | ast::ValueType(Unknown)
            | param_clo_ret_at(cg, name, 0, ?cg.param_clo_names)

param_clo_ret_at: types::Cg, String, Int, Int => ast::ValueType
param_clo_ret_at = cg, name, i, n =>
   i == n
      | ast::ValueType(Unknown)
      |
         cg.param_clo_names(i)!! == name
            | (cg.param_clo_rets(i) | _ | ast::ValueType(Unknown))
            | param_clo_ret_at(cg, name, i + 1, n)

codegen_fn_param_ll: types::Cg, Addr, ast::Names, ast::Names, ast::VInfos, ast::VTypes, Int, Int, types::Addrs => types::Addrs
codegen_fn_param_ll = cg, i8p, params, dtypes, ptis, ptypes, i, n, acc =>
   i == n
      | acc
      |
         pname = (params(i) | _ | "")
         target_pname = types::g.last_compiling_fn == ""
            | pname
            | types::g.last_compiling_fn + "#" + pname
         pdtype0 = (dtypes(i) | _ | "")
         pti0 = (ptis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown)))
         fti0 = fn_type_from_ti(cg, pti0)
         is_clo = <>(param_clo_ty(cg, pname))
         !is_clo
            | fti0 | ft => param_clo_add(cg, target_pname, ft.0, ft.1)
         prec0 = codegen_fn_param_rec(cg, pname, pdtype0, pti0)
         is_arr0 = param_is_array(cg, pname, pdtype0, pti0)
         is_sl0 = param_is_slice(cg, pname, pdtype0, pti0)
         pvt0 = (ptypes(i) | _ | ast::ValueType(Unknown))
         use_unboxed = types::g.is_typed_pipeline && types::is_unboxed_ram_ti(cg, pti0)
         param_ty = use_unboxed
            | match::unboxed_ram_struct_t(cg)
            | param_ll_type(cg, i8p, pdtype0, pvt0, <>(prec0), is_arr0,
               is_sl0, is_clo)
         acc += param_ty
         codegen_fn_param_ll(cg, i8p, params, dtypes, ptis, ptypes, i + 1, n,
            acc)

pti_slice_elem_vt: ast::TypeInfo => ast::ValueType
pti_slice_elem_vt = ti =>
   ti
      [Rec r]
         r.1 && ?r.0 > 0
            |
               f0 = (r.0(0) | _ | ast::RecordFieldType(("",
                   ast::ValueType(Unknown),
                   ast::TypeInfo(Prim, ast::ValueType(Unknown)),
                   <->, ast::Expr(Int, 0))))
               f0.val_type
            | ast::ValueType(Unknown)
      | ast::ValueType(Unknown)

codegen_fn_add_params: types::Cg, Addr, ast::Names, ast::Names, ast::VInfos, ast::VTypes, Int, Int => ()
codegen_fn_add_params = cg, fn, params, dtypes, ptis, ptypes, i, n =>
   i != n
      |
         pname = (params(i) | _ | "")
         pname != "" && pname != "_"
            |
               types::has_str_at(params, pname, 0, i)
                  |
                     types::init_error(cg, "E3033",
                        "Cannot re-assign immutable binding '" + pname +
                        "'. Use a prime suffix ('" + pname +
                        "\'') for rebindable variables.", 0, 0)
                  |
                     types::is_any_fn_name(cg, pname)
                        |
                           types::init_error(cg, "E3033",
                              "Cannot re-assign immutable binding '" + pname +
                              "'. Use a prime suffix ('" + pname +
                              "\'') for rebindable variables.", 0, 0)
               runtime::binding_add(cg, pname, <->)
         target_pname = types::g.last_compiling_fn == ""
            | pname
            | types::g.last_compiling_fn + "#" + pname
         pv = LLVMGetParam(fn, i)
         pdtype' = (dtypes(i) | _ | "")
         pti = (ptis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown)))
         fti = fn_type_from_ti(cg, pti)
         is_clo = <>(param_clo_ty(cg, pname))
         !is_clo
            | fti | ft => param_clo_add(cg, target_pname, ft.0, ft.1)
         prec = codegen_fn_param_rec(cg, pname, pdtype', pti)
         is_sl = param_is_slice(cg, pname, pdtype', pti)
         is_rec = !is_sl && <>(prec)
         is_arr = param_is_array(cg, pname, pdtype', pti)
         pvt_base = ptypes(i) | _ | ast::ValueType(Unknown)
         pvt = is_clo
            | ast::ValueType(Fn)
            |
               is_sl
                  | ast::ValueType(Slice)
                  |
                     is_rec
                        | ast::ValueType(Record)
                        |
                           pdtype' != ""
                              | pvt_base
                              |
                                 is_arr
                                    | ast::ValueType(Array)
                                    | pvt_base
         runtime::binding_add(cg, pname, <->)
         empty_fvts = ast::VTypes()
         sl_elem_vt = pti_slice_elem_vt(pti)
         sl_fvts = ast::VTypes()
         sl_elem_vt != ast::ValueType(Unknown) | sl_fvts += sl_elem_vt
         pr2 = is_sl | sl_fvts | (prec | p => p.2 | empty_fvts)
         is_rec_ti = pti [Rec _]
         is_anon_param = pdtype' == "" && is_rec && is_rec_ti
         is_anon_param
            |
               param_tname' = "#param_" + types::g.last_compiling_fn + "_" + pname
               !types::has_type_name(cg, param_tname')
                  |
                     prec_rt = prec | p => <+ p.0 -> | <-->
                     prec_fnames = prec | p => p.1 | ast::Names()
                     runtime::add_type_rec(cg, param_tname', pti, prec_rt, prec_fnames)
               pdtype' = param_tname'
         is_ram_ti = pti [Ram _]
         is_unboxed = types::g.is_typed_pipeline && types::is_unboxed_ram_ti(cg, pti)
         niche = types::g.is_typed_pipeline | types::is_niche_ram_ti(cg, pti) |
            (<->, <->, ast::ValueType(Unknown))
         is_heap_ram = !is_unboxed && !niche.0 &&
            (pti [Ram s] s.0.has_payload || s.1.has_payload | <->)
         is_anon_ram = pdtype' == "" && is_ram_ti
         is_anon_ram
            |
               param_tname' = "#param_" + types::g.last_compiling_fn + "_" + pname
               !types::has_type_name(cg, param_tname')
                  | runtime::add_type(cg, param_tname', pti)
               pdtype' = param_tname'
         is_arr_ti = pti [Array _]
         is_anon_arr = pdtype' == "" && is_arr_ti
         is_anon_arr
            |
               param_tname' = "#param_" + types::g.last_compiling_fn + "_" + pname
               !types::has_type_name(cg, param_tname')
                  | runtime::add_type(cg, param_tname', pti)
               pdtype' = param_tname'
         prec_rt_opt = !is_sl | (prec | p => <+ p.0 -> | <-->) | <-->
         prec_fnames = prec | p => p.1 | ast::Names()
         cg.vars += types::CgVar((pname, pvt, is_heap_ram, pdtype',
            prec_rt_opt, prec_fnames, <--> , <+>, <->, pr2, <+ pv ->))
         codegen_fn_add_params(cg, fn, params, dtypes, ptis, ptypes, i + 1, n)

// Compiles one user function: params are direct SSA values (no allocas), the
vtypes_has_unknown: ast::VTypes => <>
vtypes_has_unknown = vts =>
   found' = <->
   ?vts @ i =>
      vt = vts(i) | _ | ast::ValueType(Unknown)
      vt == ast::ValueType(Unknown)
         |
            found' = <+>
            -->
   found'

find_char_at: String, Int, Int => Int
find_char_at = s, i, ch =>
   i < ?s
      | (s(i) == ch | i | find_char_at(s, i + 1, ch))
      | -1

find_export_symbol_at: ast::Names, String, String, Int, Int => <String|>
find_export_symbol_at = exp, fn_name, bare, i, n =>
   i == n
      | <-->
      |
         item = (exp(i) | _ | "")
         eq_pos = find_char_at(item, 0, 61)
         dva_name = eq_pos > 0 | item(0..eq_pos) | item
         c_name = eq_pos > 0 | item(eq_pos + 1..?item) | types::decl_bare_name(item, 0)
         (dva_name == fn_name) || (dva_name == bare)
            | <+ c_name ->
            | find_export_symbol_at(exp, fn_name, bare, i + 1, n)

find_export_symbol: ast::Names, String => <String|>
find_export_symbol = exp, fn_name =>
   bare = types::decl_bare_name(fn_name, 0)
   clean_bare = (?bare > 0 && bare(0) == '#') | bare(1..) | bare
   find_export_symbol_at(exp, fn_name, clean_bare, 0, ?exp)

codegen_c_str: types::Cg, String => Addr
codegen_c_str = cg, s =>
   slit = codegen_string_literal(cg, s)
   nt = expr::codegen_ensure_nul_terminated(cg, slit, "cstr")
   expr::clean_untagged_addr(cg, nt)

is_module_dynamic: types::Cg, String => <>
is_module_dynamic = cg, name =>
   dmods = cg.opts.dynamic_modules
   n = ?dmods
   n == 0
      | <->
      |
         col = find_char_at(name, 0, 58)
         col < 0
            | <->
            |
               mod = name(..col)
               found' = <->
               n @ i =>
                  m = (dmods(i) | _ | "")
                  m == mod
                     |
                        found' = <+>
                        -->
               found'

get_or_create_dyn_fn_ptr: types::Cg, String, <Addr|> => Addr
get_or_create_dyn_fn_ptr = cg, name, fn_opt =>
   gname = "dva_dynptr." + name
   existing_opt = types::llvm_find_global(cg.module, gname)
   existing_opt
      | existing =>
         fn_opt | fn => LLVMSetInitializer(existing, fn)
         existing
      |
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         gv = LLVMAddGlobal(cg.module, i8p, gname)
         fn_opt
            | fn => LLVMSetInitializer(gv, fn)
            | LLVMSetInitializer(gv, LLVMConstNull(i8p))
         LLVMSetLinkage(gv, 0)
         gv

find_dynamic_mod_path: types::Cg, String => String
find_dynamic_mod_path = cg, mod_name =>
   dmods = cg.opts.dynamic_modules
   dpaths = cg.opts.dynamic_paths
   n = ?dmods
   res' = ++""
   n @ i =>
      m = (dmods(i) | _ | "")
      m == mod_name
         |
            res' = ++(dpaths(i) | _ | "")
            -->
   res'

is_dyn_reload_so_fn: types::Cg, String => <>
is_dyn_reload_so_fn = cg, name =>
   suffix = "::reload_so"
   slen = ?suffix
   ?name > slen && name(?name - slen..) == suffix
      | is_module_dynamic(cg, name)
      | <->

is_dyn_reload_fn: types::Cg, String => <>
is_dyn_reload_fn = cg, name =>
   suffix = "::reload"
   slen = ?suffix
   ?name > slen && name(?name - slen..) == suffix
      | is_module_dynamic(cg, name)
      | <->

codegen_emit_reload_so_body: types::Cg, String, Addr => ()
codegen_emit_reload_so_body = cg, name, fn =>
   col = find_char_at(name, 0, 58)
   mod_name = col < 0 | "" | name(..col)
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   i32t = LLVMInt32Type!
   i1t = LLVMInt1Type!
   dlopen_fty = types::fn_type2(cg, i8p, i8p, i32t)
   dlopen_fn = types::llvm_find_function(cg.module, "dlopen")
      | f => f
      | LLVMAddFunction(cg.module, "dlopen", dlopen_fty)
   dlsym_fty = types::fn_type2(cg, i8p, i8p, i8p)
   dlsym_fn = types::llvm_find_function(cg.module, "dlsym")
      | f => f
      | LLVMAddFunction(cg.module, "dlsym", dlsym_fty)
   path_arg = LLVMGetParam(fn, 0)
   clean_path = expr::clean_untagged_addr(cg,
      expr::codegen_ensure_nul_terminated(cg, path_arg, "so_path"))
   rtld_now = LLVMConstInt(i32t, 2, 0)
   dbuf = {16}
   sdbuf = &dbuf
   @[sdbuf] = clean_path
   @[sdbuf + 8] = rtld_now
   handle = LLVMBuildCall2(cg.builder, dlopen_fty, dlopen_fn,
      sdbuf, 2, "so_handle")
   is_null = LLVMBuildICmp(cg.builder, 32, handle,
      LLVMConstNull(i8p), "handle.is_null")
   null_bb = LLVMAppendBasicBlock(fn, "reload.fail")
   ok_bb = LLVMAppendBasicBlock(fn, "reload.ok")
   LLVMBuildCondBr(cg.builder, is_null, null_bb, ok_bb)
   LLVMPositionBuilderAtEnd(cg.builder, null_bb)
   LLVMBuildRet(cg.builder, LLVMConstInt(i1t, 0, 0))
   LLVMPositionBuilderAtEnd(cg.builder, ok_bb)
   pfx = mod_name + "::"
   pfx_len = ?pfx
   ?cg.fns @ i =>
      fd = cg.fns(i)!!
      fname = fd.name
      is_mod_fn = ?fname > pfx_len && fname(..pfx_len) == pfx &&
         fname != (pfx + "reload_so") && fname != (pfx + "reload")
      is_mod_fn
         |
            gptr = get_or_create_dyn_fn_ptr(cg, fname, <-->)
            clean_sname = codegen_c_str(cg, fname)
            sbuf = {16}
            ssbuf = &sbuf
            @[ssbuf] = handle
            @[ssbuf + 8] = clean_sname
            sym = LLVMBuildCall2(cg.builder, dlsym_fty, dlsym_fn,
               ssbuf, 2, "sym")
            bare_name = fname(pfx_len..)
            clean_bname = codegen_c_str(cg, bare_name)
            @[ssbuf + 8] = clean_bname
            sym_bare = LLVMBuildCall2(cg.builder, dlsym_fty, dlsym_fn,
               ssbuf, 2, "sym_bare")
            sym_is_null = LLVMBuildICmp(cg.builder, 32, sym,
               LLVMConstNull(i8p), "sym.is_null")
            chosen_sym = LLVMBuildSelect(cg.builder, sym_is_null,
               sym_bare, sym, "chosen_sym")
            chosen_not_null = LLVMBuildICmp(cg.builder, 33, chosen_sym,
               LLVMConstNull(i8p), "chosen.not_null")
            set_bb = LLVMAppendBasicBlock(fn, "set.ptr")
            next_bb = LLVMAppendBasicBlock(fn, "next.fn")
            LLVMBuildCondBr(cg.builder, chosen_not_null, set_bb, next_bb)
            LLVMPositionBuilderAtEnd(cg.builder, set_bb)
            LLVMBuildStore(cg.builder, chosen_sym, gptr)
            LLVMBuildBr(cg.builder, next_bb)
            LLVMPositionBuilderAtEnd(cg.builder, next_bb)
   LLVMBuildRet(cg.builder, LLVMConstInt(i1t, 1, 0))

codegen_emit_reload_body: types::Cg, String, Addr => ()
codegen_emit_reload_body = cg, name, fn =>
   col = find_char_at(name, 0, 58)
   mod_name = col < 0 | "" | name(..col)
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   i32t = LLVMInt32Type!
   i1t = LLVMInt1Type!
   system_fty = types::fn_type1(i32t, i8p)
   system_fn = types::llvm_find_function(cg.module, "system")
      | _
      | LLVMAddFunction(cg.module, "system", system_fty)
   mod_path = find_dynamic_mod_path(cg, mod_name)
   so_path = "/tmp/" + mod_name + "_hot.so"
   edva_bin = cg.opts.compiler_exe != "" | cg.opts.compiler_exe | "./edva"
   cmd = edva_bin + " -shared \"" + mod_path + "\" -o \"" +
      so_path + "\" > /dev/null 2>&1"
   clean_cmd = codegen_c_str(cg, cmd)
   cbuf = {8}
   scbuf = &cbuf
   @[scbuf] = clean_cmd
   res = LLVMBuildCall2(cg.builder, system_fty, system_fn,
      scbuf, 1, "sys.res")
   is_ok = LLVMBuildICmp(cg.builder, 32, res,
      LLVMConstInt(i32t, 0, 0), "cmd.ok")
   fail_bb = LLVMAppendBasicBlock(fn, "reload.cmd_fail")
   call_bb = LLVMAppendBasicBlock(fn, "reload.do_rso")
   LLVMBuildCondBr(cg.builder, is_ok, call_bb, fail_bb)
   LLVMPositionBuilderAtEnd(cg.builder, fail_bb)
   LLVMBuildRet(cg.builder, LLVMConstInt(i1t, 0, 0))
   LLVMPositionBuilderAtEnd(cg.builder, call_bb)
   rso_fname = mod_name + "::reload_so"
   fi_res = types::fninfo_find(cg, rso_fname)
   rso_fn_opt = fi_res
      | fi => fi.llvm_fn
      | types::llvm_find_function(cg.module, rso_fname)
   rso_bare = types::decl_bare_name(rso_fname, 0)
   fi_bare = types::fninfo_find(cg, rso_bare)
   rso_fn_opt2 = fi_bare
      | fi => fi.llvm_fn
      | types::llvm_find_function(cg.module, rso_bare)
   rso_fn_opt
      | rso_fn =>
         rso_fty = types::fn_type1(i1t, i8p)
         so_dva = codegen_string_literal(cg, so_path)
         @[scbuf] = so_dva
         rso_res = LLVMBuildCall2(cg.builder, rso_fty, rso_fn,
            scbuf, 1, "rso.res")
         LLVMBuildRet(cg.builder, rso_res)
      |
         rso_fn_opt2
            | rso_fn2 =>
               rso_fty = types::fn_type1(i1t, i8p)
               so_dva = codegen_string_literal(cg, so_path)
               @[scbuf] = so_dva
               rso_res = LLVMBuildCall2(cg.builder, rso_fty, rso_fn2,
                  scbuf, 1, "rso.res")
               LLVMBuildRet(cg.builder, rso_res)
            | LLVMBuildRet(cg.builder, LLVMConstInt(i1t, 0, 0))

// Emits an LLVM function definition from an AST FnDef. The function's
// body is evaluated with the builder inside it, and the fn gets internal
// linkage + nounwind unless #export'd.
codegen_compile_fn: types::Cg, types::FnDef, ast::VTypes, ast::Names, ast::VInfos,
   ast::ValueType, ast::TypeInfo, <>, <>, <>, ast::Names => ()
codegen_compile_fn = cg, fd, h, dts, pts, d_ret, d_ret_ti, decl, gen, vs, exp =>
   dtypes = dts
   ptis = pts
   hints = h
   declared = decl
   generic = gen
   value_safe = vs
   exports = exp
   saved_module = cg.current_module
   saved_fn = cg.current_fn
   saved_bb = LLVMGetInsertBlock(cg.builder)
   saved_in_fn = cg.in_fn
   saved_nvars = ?cg.vars
   saved_var_start = cg.fn_var_start
   saved_nbindings = ?cg.bindings
   saved_binding_start = cg.fn_binding_start
   saved_bindings = cg.bindings
   saved_nclo = ?cg.param_clo_names
   saved_nalloc_rec = ?types::g.alloc_rec_names
   saved_nviews = ?types::g.view_var_names
   cg.current_module = types::decl_module(fd.name, 0)
   cg.fn_var_start = saved_nvars
   cg.bindings = types::BindingMuts()
   cg.fn_binding_start = 0
   saved_last_fn = types::g.last_compiling_fn
   types::g.last_compiling_fn = fd.name
   ptypes = infer_param_types(fd, hints)
   ret_vt' = infer_ret(fd.body, fd.params, ptypes)
   ret_vt' = fn_ret_override(cg, fd.body, ret_vt')
   ret_vt' = codegen_validate_declared_return(cg, fd.name, d_ret, ret_vt')
   !decl && !gen && vtypes_has_unknown(ptypes)
      |
         types::init_error(cg, "E3128", "Function '" + fd.name + "' has " +
            "unresolvable parameter types — no declared signature and no " +
            "call site to infer from. Declare a signature: '" + fd.name +
            ": T1, T2 => R'.", 0, 0)
   !decl && !gen && (ret_vt' == ast::ValueType(Unknown))
      |
         types::init_error(cg, "E3103", "Return type of function '" + fd.name +
            "' could not be statically determined. Declare a signature: '" +
            fd.name + ": T1, T2 => R'.", 0, 0)

   is_unk = d_ret_ti [Prim p] p == ast::ValueType(Unknown) | <->
   ret_ti = is_unk
      | fn_signature_return_ti(cg, types::g.pstmts, fd.name, 0)
      | d_ret_ti
   niche = types::is_niche_ram_ti(cg, ret_ti)
   use_niche_ret = types::g.is_typed_pipeline && niche.0
   use_unboxed_ret = types::g.is_typed_pipeline && types::is_unboxed_ram_ti(cg, ret_ti)
   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   param_ll = codegen_fn_param_ll(cg, i8p, fd.params, dtypes, ptis, ptypes,
      0, ?fd.params, types::Addrs())
   ret_ll = use_unboxed_ret
      | match::unboxed_ram_struct_t(cg)
      |
         fn_ret_heap(cg, fd.name, fd.body, ret_vt') | i8p |
            (ret_vt' [Fn] LLVMInt64Type! | types::llvm_type_of_vt(ret_vt'))
   fty = fn_type_n(cg, ret_ll, param_ll, ?fd.params)
   exp_sym = find_export_symbol(exp, fd.name)
   fn_ll_name = exp_sym | _ | fd.name
   is_exp = <>(exp_sym)
   fn = LLVMAddFunction(cg.module, fn_ll_name, fty)
   is_dyn_m = is_module_dynamic(cg, fd.name) || cg.opts.is_shared
   is_pub_mod = cg.opts.is_module && !types::name_is_private(fd.name) &&
      types::name_is_in_current_module(cg, fd.name)
   LLVMSetLinkage(fn, (is_exp || is_dyn_m || is_pub_mod) | 0 | 8)
   is_module_dynamic(cg, fd.name)
      |
         _ = get_or_create_dyn_fn_ptr(cg, fd.name, <+ fn ->)
   runtime::mark_nounwind(cg, fn)
   cg.current_fn = fn
   cg.in_fn = <+>
   entry = LLVMAppendBasicBlock(fn, "entry")
   LLVMPositionBuilderAtEnd(cg.builder, entry)
   cur_fn_idx = ?cg.fninfos
   codegen_fn_add_params(cg, fn, fd.params, dtypes, ptis, ptypes, 0, ?fd.params)
   cg.fninfos += types::FnInfo((fd.name, <+ fn ->, <+ fty ->, ?fd.params, ptypes, ret_vt',
      decl, gen, vs, <+>))
   saved_discard = cg.discard_result
   is_disc = ret_vt' [Unit]
   cg.discard_result = is_disc
   cg.exited = <->
   saved_expected_ti = types::g.expected_fn_ti
   saved_fn_ret_ll = types::g.fn_ret_ll
   types::g.expected_fn_ti = ret_ti
   types::g.fn_ret_ll = <+ ret_ll ->
   bv = expr::codegen_eval(cg, fd.body)
   types::g.expected_fn_ti = saved_expected_ti
   types::g.fn_ret_ll = saved_fn_ret_ll
   cg.discard_result = saved_discard
   types::is_view_expr(cg, fd.body)
      | types::init_error(cg, "E3150", "View cannot escape function frame", 0, 0)
   is_void_ret = ret_vt' [Unit]
   actual_ret = is_void_ret | ast::ValueType(Unit) | bv.1
   is_rec_ret = types::is_record_vt(actual_ret) || (declared && types::is_record_vt(ret_vt'))
   is_rec_ret
      |
         rt_opt' = cg.last_rt
         fnms' = cg.last_fnames
         fvts' = cg.last_fvts
         dt' = cg.last_type
         has_rt = <>(rt_opt')
         !has_rt && declared
            |
               sig_ti = fn_signature_return_ti(cg, types::g.pstmts, fd.name, 0)
               sig_rm = runtime::record_meta_from_ti(cg, sig_ti)
               sig_rm
                  | m =>
                     rt_opt' = <+ m.0 ->
                     fnms' = m.1
                     fvts' = types::field_vts(cg, sig_ti)
                     dt' = sig_ti [TypeVar tn] tn | dt'
         fn_ret_rec_add(cg, fd.name, rt_opt', fnms', fvts', dt')
      |
         cg.last_type != ""
            | fn_ret_rec_add(cg, fd.name, <--> , ast::Names(), ast::VTypes(),
               cg.last_type)
   is_fn_ret = main::is_fn_vt(actual_ret) || main::is_fn_vt(ret_vt')
   is_fn_ret && (cg.last_closure_fn != "")
      | fn_ret_fn_add(fd.name, cg.last_closure_fn)
   bv_opt = types::llvm_val_opt(bv.0)
   is_ptr_ret = bv_opt
      | bvv => LLVMGetTypeKind(LLVMTypeOf(bvv)) == 12
      | <->
   is_ptr_ret_int = ret_ll == LLVMInt64Type! && is_ptr_ret
   is_void_ret
      |
         !cg.error && !block_is_terminated(cg) | LLVMBuildRetVoid(cg.builder)
      |
         ret_v = bv_opt
            | bvv =>
               use_unboxed_ret && is_ptr_ret
                  | match::convert_heap_ram_to_unboxed(cg, bvv, ret_ti)
                  |
                     use_niche_ret && is_ptr_ret
                        |
                           tgep = LLVMBuildStructGEP2(cg.builder,
                              cg.union_t, bvv, 0, "tag.gep")
                           tag = LLVMBuildLoad2(cg.builder,
                              LLVMInt64Type!, tgep, "tag")
                           is_pos = LLVMBuildICmp(cg.builder, 33,
                              tag, LLVMConstInt(
                                 LLVMInt64Type!, 0, 0), "is_pos")
                           pgep = LLVMBuildStructGEP2(cg.builder,
                              cg.union_t, bvv, 1, "pay.gep")
                           pay_ptr = LLVMBuildLoad2(cg.builder,
                              i8p, pgep, "pay.ptr")
                           cond_pos = niche.1 | is_pos |
                              LLVMBuildNot(cg.builder, is_pos, "is_neg")
                           LLVMBuildSelect(cg.builder, cond_pos,
                              pay_ptr, LLVMConstNull(i8p), "ret.niche")
                        |
                           is_ptr_ret_int
                              | LLVMBuildPtrToInt(cg.builder, bvv,
                                 LLVMInt64Type!, "ret.int")
                              | coerce_int(cg, bvv, ret_ll)
            | LLVMConstNull(ret_ll)
         !cg.error && !block_is_terminated(cg) | LLVMBuildRet(cg.builder, ret_v)
   ret_ti_res = resolve_ti(cg, ret_ti)
   ret_ti_res [Ram _]
      |
         body_ram_ti = expr::codegen_ram_type_of_expr(cg, fd.body)
         body_ram_ti [Ram _]
            |
               !expr::ram_shape_compatible(cg, ret_ti_res, body_ram_ti)
                  |
                     types::init_error(cg, "E3149", "Function '" + fd.name +
                        "' declares return type " +
                        expr::ram_shape_str(cg, ret_ti_res) +
                        ", but the body produces a ramification with shape " +
                        expr::ram_shape_str(cg, body_ram_ti) + ".", 0, 0)
   declared && (actual_ret != ast::ValueType(Unknown)) &&
      (actual_ret != ret_vt')
      | codegen_declared_return_error(cg, fd.name, ret_vt', actual_ret)
   !declared && (actual_ret != ret_vt')
      |
         cg.fninfos(cur_fn_idx) = types::FnInfo((fd.name, <+ fn ->, <+ fty ->, ?fd.params,
            ptypes, actual_ret, declared, generic, value_safe, <+>)) !| _
   cg.in_fn = saved_in_fn
   // Drop the function's params + body locals from the var table (they live
   // inside the fn's own allocas) so a same-named top-level var does not
   // resolve to a stale function-local slot.
   cg.vars = truncate_vars(cg.vars, saved_nvars)
   cg.bindings = saved_bindings
   cg.fn_var_start = saved_var_start
   cg.fn_binding_start = saved_binding_start
   cg.param_clo_names = types::truncate_names(cg.param_clo_names, saved_nclo)
   cg.param_clo_tys = cycle_trunc(cg.param_clo_tys, saved_nclo)
   cg.param_clo_rets = truncate_vtypes(cg.param_clo_rets, saved_nclo)
   cg.current_fn = saved_fn
   LLVMPositionBuilderAtEnd(cg.builder, saved_bb)
   cg.current_module = saved_module
   types::g.last_compiling_fn = saved_last_fn
   types::g.alloc_rec_names = types::truncate_names(types::g.alloc_rec_names, saved_nalloc_rec)
   types::g.view_var_names = types::truncate_names(types::g.view_var_names, saved_nviews)

truncate_vtypes: ast::VTypes, Int => ast::VTypes
truncate_vtypes = vts, n =>
   res = ast::VTypes()
   n @ i =>
      res += (vts(i) | _ | ast::ValueType(Unknown))
   res

truncate_vars: types::CgVars, Int => types::CgVars
truncate_vars = vars, n =>
   res = types::CgVars()
   n @ i =>
      res += vars(i)!!
   res

is_foreign_fn_step: String, Int => <>
is_foreign_fn_step = fname, i =>
   i < ?types::g.foreign_fn_names
      |
         (types::g.foreign_fn_names(i) | _ | "") == fname
            | <+>
            | is_foreign_fn_step(fname, i + 1)
      | <->

is_foreign_fn: String => <>
is_foreign_fn = fname => is_foreign_fn_step(fname, 0)

is_foreign_i32_param_step: String, Int => <>
is_foreign_i32_param_step = key, j =>
   j < ?types::g.foreign_i32_params
      |
         (types::g.foreign_i32_params(j) | _ | "") == key
            | <+>
            | is_foreign_i32_param_step(key, j + 1)
      | <->

is_foreign_i32_param: String, Int => <>
is_foreign_i32_param = fname, i =>
   key = fname + "#" + str::from_int(i)
   is_foreign_i32_param_step(key, 0)

llvm_foreign_param_type: ast::ForeignFnParam => Addr
llvm_foreign_param_type = p =>
   p.param_type
      [Int]
         p.name == "fd" || p.name == "flags" || p.name == "code"
            | LLVMInt32Type!
            | LLVMInt64Type!
      | types::llvm_type_of_vt(p.param_type)

llvm_foreign_ret_type: String, ast::ValueType => Addr
llvm_foreign_ret_type = c_name, vt =>
   vt
      [Unit] LLVMVoidType!
      [Int]
         c_name == "open" || c_name == "close" || c_name == "ioctl"
            | LLVMInt32Type!
            | LLVMInt64Type!
      | types::llvm_type_of_vt(vt)

collect_foreign_params: types::Cg, ast::ForeignFnDecl, Int, types::Addrs,
   ast::VTypes => (types::Addrs, ast::VTypes)
collect_foreign_params = cg, f, i, param_ll, param_vts =>
   i !< ?f.params
      | (param_ll, param_vts)
      |
         p = f.params(i)!!
         param_vts += p.param_type
         p_is_i32 = p.param_type [Int] && (p.name == "fd" ||
            p.name == "flags" || p.name == "code")
         p_is_i32
            |
               idx_str = str::from_int(i)
               types::g.foreign_i32_params += f.dva_name + "#" + idx_str
               param_ll += LLVMInt32Type!
            | param_ll += types::llvm_type_of_vt(p.param_type)
         collect_foreign_params(cg, f, i + 1, param_ll, param_vts)

codegen_emit_foreign_var: types::Cg, ast::ForeignFnDecl => ()
codegen_emit_foreign_var = cg, f =>
   f.is_variable && !types::has_var_name(cg, f.dva_name)
      |
         glob = types::llvm_find_global(cg.module, f.c_name)
            | g => g
            | LLVMAddGlobal(cg.module, types::llvm_type_of_vt(f.return_type),
                 f.c_name)
         cg.vars += types::CgVar((f.dva_name, f.return_type, <->, "", <-->,
            ast::Names(), <+ glob ->, <->, <->, ast::VTypes(), <-->))

collect_if_foreign_fn: types::Cg, ast::ForeignFnDecl => ()
collect_if_foreign_fn = cg, f =>
   f.is_variable
      | codegen_emit_foreign_var(cg, f)
      |
         types::g.foreign_fn_names += f.dva_name
         params_res = collect_foreign_params(cg, f, 0, types::Addrs(), ast::VTypes())
         param_ll = params_res.0
         param_vts = params_res.1
         ret_ll = llvm_foreign_ret_type(f.c_name, f.return_type)
         is_vararg = f.c_name == "ioctl"
         fn_type = fn_type_n_vararg(cg, ret_ll, param_ll, ?f.params,
            is_vararg)
         llvm_fn = types::llvm_find_function(cg.module, f.c_name)
            | fn => fn
            | LLVMAddFunction(cg.module, f.c_name, fn_type)
         cg.fninfos += types::FnInfo((f.dva_name, <+ llvm_fn ->, <+ fn_type ->, ?f.params,
            param_vts, f.return_type, <+>, <->, <+>, <+>))

// Collects top-level function definitions ("f = x => body") and foreign fns.
codegen_collect_fns: types::Cg, ast::Exprs => ()
codegen_collect_fns = cg, stmts =>
   codegen_collect_fns_step(cg, stmts, 0)

codegen_collect_fns_step: types::Cg, ast::Exprs, Int => ()
codegen_collect_fns_step = cg, stmts, i =>
   i < ?stmts
      |
         e = stmts(i)!!
         e
            [Assign t] collect_if_fn(cg, t)
            [Block b] codegen_collect_fns(cg, b.exprs)
            [Foreign f] collect_if_foreign_fn(cg, f)
         codegen_collect_fns_step(cg, stmts, i + 1)

collect_if_fn: types::Cg, (String, <>, <>, <>, <>, ast::Expr, ast::Expr, String, ast::TypeInfo) => ()
collect_if_fn = cg, t =>
   plain_lhs = !runtime::lhs_is_member(t) && !runtime::lhs_is_keyaccess(t) &&
      !runtime::lhs_is_rawmemory(t) && !runtime::lhs_is_call(t)
   is_fn_def = t.0 != "" && !t.1 && !t.2 && !t.3 && !t.4 && plain_lhs
   is_fn_def
      |
         t.5
            [Fn f]
               types::has_fn_name(cg, t.0) || types::has_str(types::g.foreign_fn_names, t.0)
                  |
                     types::init_error(cg, "E3033",
                        "Cannot re-assign immutable binding '" + t.0 +
                        "'. Use a prime suffix ('" + t.0 +
                        "\'') for rebindable variables.", 0, 0)
                  |
                     types::add_fn_def(cg, types::FnDef((t.0, f.params, f.body)))

// Compile one user fn at its FIRST USE — the reference's lazy model: a call
// site compiles the callee with the evaluated arg types (a value read or a
// spawn falls back to the static alias/HOF hint scan), fns absent from the
// .ll until referenced, and literal/global numbering interleaves at first
compile_fn_lazy_force: types::Cg, String, ast::VTypes => <>
compile_fn_lazy_force = cg, name, call_types =>
   rname = types::resolve_fn_name(cg, name)
   fd = fndef_of(cg.fns, rname, 0)
   skip = (cg.opts.is_module && types::is_external_module_name(cg, rname)) ||
      (fd.name == "" || sig_ct0_name(types::g.pstmts, rname, 0) != "")
   skip
      | <->
      |
         saved_module = cg.current_module
         cg.current_module = types::decl_module(fd.name, 0)
         declared = fn_has_signature(types::g.pstmts, fd.name, 0)
         ptypes = declared
            | fn_signature_param_types(cg, types::g.pstmts, fd.name, 0)
            |
               ?call_types > 0
                  | call_types
                  | call_hint(cg, types::g.pstmts, fd.name)
         dtypes = fn_signature_param_dtypes(types::g.pstmts, fd.name)
         ptis = fn_signature_param_tis(types::g.pstmts, fd.name)
         ret = fn_signature_return(cg, types::g.pstmts, fd.name, 0)
         ret_ti = fn_signature_return_ti(cg, types::g.pstmts, fd.name, 0)
         ret_rm = runtime::record_meta_from_ti(cg, ret_ti)
         rm_rt_opt = ret_rm | m => <+ m.0 -> | <-->
         ret_rm_1 = ret_rm | m => m.1 | ast::Names()
         ret_fvts = types::field_vts(cg, ret_ti)
         ret_dtype0 = ret_ti [TypeVar tname] tname | ""
         is_rec_ret = ret_ti [Rec _]
         is_anon_rec = ret_dtype0 == "" && is_rec_ret
         ret_dtype = is_anon_rec
            |
               ret_tname = "#ret_" + fd.name
               !types::has_type_name(cg, ret_tname) |
                  runtime::add_type_rec(cg, ret_tname, ret_ti, rm_rt_opt, ret_rm_1)
               ret_tname
            | ret_dtype0
         has_ret_meta = <>(ret_rm) || ret_dtype != ""
         has_ret_meta
            | fn_ret_rec_add(cg, fd.name, rm_rt_opt, ret_rm_1,
               ret_fvts, ret_dtype)
         codegen_check_declared_record_return(cg, types::g.pstmts, fd)
         generic = sig_ct0_name(types::g.pstmts, fd.name, 0) != ""
         !cg.error | codegen_compile_fn(cg, fd, ptypes, dtypes, ptis,
            ret, ret_ti, declared, generic, declared || (?ptypes !< ?fd.params),
            types::g.pexports)
         cg.current_module = saved_module
         <+>

compile_fn_lazy: types::Cg, String, ast::VTypes => <>
compile_fn_lazy = cg, name, call_types =>
   rname = types::resolve_fn_name(cg, name)
   types::is_fn_name(cg, rname)
      | <+>
      | compile_fn_lazy_force(cg, name, call_types)

fn_has_signature: ast::Exprs, String, Int => <>
fn_has_signature = stmts, name, at =>
   fn_has_signature_rev(stmts, name, ?stmts - 1)

fn_has_signature_rev: ast::Exprs, String, Int => <>
fn_has_signature_rev = stmts, name, at =>
   at < 0
      | <->
      |
         e = stmts(at)!!
         e
            [Assign t]
               is_sig = (t.8 [Fn _]) || (marker_ct0_name(t.7) != "")
               types::sig_name_matches(t.0, name) && is_sig
                  | <+>
                  | fn_has_signature_rev(stmts, name, at - 1)
            | fn_has_signature_rev(stmts, name, at - 1)

// The erased ValueType of both a declared record return and a record parameter
// is Record. Preserve the schema comparison statically for a body that returns
// its parameter directly, before the function's LLVM type is emitted.
codegen_check_declared_record_return: types::Cg, ast::Exprs, types::FnDef => ()
codegen_check_declared_record_return = cg, stmts, fd =>
   codegen_check_record_return_sig(cg, stmts, fd, 0)

codegen_check_record_return_sig: types::Cg, ast::Exprs, types::FnDef, Int => ()
codegen_check_record_return_sig = cg, stmts, fd, at =>
   at < ?stmts
      |
         e = stmts(at)!!
         e
            [Assign t]
               types::sig_name_matches(t.0, fd.name)
                  | codegen_check_record_return_fn(cg, fd, t.8)
                  | codegen_check_record_return_sig(cg, stmts, fd, at + 1)
            | codegen_check_record_return_sig(cg, stmts, fd, at + 1)

resolve_ti: types::Cg, ast::TypeInfo => ast::TypeInfo
resolve_ti = cg, ti =>
   ti
      [TypeVar name] types::typedef_ti(cg, name)
      [Prim vt]
         vt [Flag]
            empty_s = ast::RamSlotInfo((<->, ast::ValueType(Unknown),
               ast::TypeInfo(Prim, ast::ValueType(Unknown))))
            ast::TypeInfo(Ram, (empty_s, empty_s))
         | ti
      | ti

codegen_check_record_return_fn: types::Cg, types::FnDef, ast::TypeInfo => ()
codegen_check_record_return_fn = cg, fd, ti =>
   ti
      [Fn sig]
         dec_ti = resolve_ti(cg, sig.3)
         dec_ti
            [Rec declared]
               last = fn_last_expr(fd.body)
               last
                  [Var v]
                     p0 = (fd.params(0) | _ | "")
                     v == p0
                        |
                           actual_raw = sig.1(0) | _ | ast::TypeInfo(Prim,
                              ast::ValueType(Unknown))
                           actual = resolve_ti(cg, actual_raw)
                           actual
                              [Rec got]
                                 !record_fields_same(declared.0, got.0, 0)
                                    | types::init_error(cg, "E3149", "Function '" +
                                       fd.name + "' declares return type " +
                                       "Record, but the body produces a Record " +
                                       "with a different layout.", 0, 0)

record_fields_same: ast::FieldTypes, ast::FieldTypes, Int => <>
record_fields_same = left, right, at =>
   nl = ?left
   nr = ?right
   nl != nr
      | <->
      | at == nl
         | <+>
         |
            lf = (left(at) | _ | ast::RecordFieldType(("",
               ast::ValueType(Unknown), ast::TypeInfo(Prim,
               ast::ValueType(Unknown)), <->, ast::Expr(Int, 0))))
            rf = (right(at) | _ | ast::RecordFieldType(("",
               ast::ValueType(Unknown), ast::TypeInfo(Prim,
               ast::ValueType(Unknown)), <->, ast::Expr(Int, 0))))
            (lf.name == rf.name) && (lf.val_type == rf.val_type) &&
               record_fields_same(left, right, at + 1)

// Signatures carry static parameter layouts. Keep their enum/ram type names
rec_slice_vt: <> => ast::ValueType
rec_slice_vt = is_slice =>
   is_slice | ast::ValueType(Slice) | ast::ValueType(Record)

resolve_sig_vt: types::Cg, ast::ValueType, ast::TypeInfo => ast::ValueType
resolve_sig_vt = cg, vt, ti =>
   ti
      [TypeVar name]
         resolved = types::resolve_type_name(cg, name)
         td = types::typedef_ti(cg, resolved)
         resolved_vt = types::vt_from_ti(td)
         resolved_vt != ast::ValueType(Unknown) | resolved_vt | vt
      | vt

resolve_sig_param_types_at: types::Cg, ast::VTypes, ast::VInfos, Int, Int, ast::VTypes => ast::VTypes
resolve_sig_param_types_at = cg, vts, tis, i, n, acc =>
   i == n
      | acc
      |
         vt = (vts(i) | _ | ast::ValueType(Unknown))
         ti = (tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown)))
         acc += resolve_sig_vt(cg, vt, ti)
         resolve_sig_param_types_at(cg, vts, tis, i + 1, n, acc)

resolve_sig_param_types: types::Cg, ast::VTypes, ast::VInfos => ast::VTypes
resolve_sig_param_types = cg, vts, tis =>
   resolve_sig_param_types_at(cg, vts, tis, 0, ?vts, ast::VTypes())

make_repeated_vinfos_at: Int, ast::TypeInfo, Int, ast::VInfos => ast::VInfos
make_repeated_vinfos_at = n, ti, i, acc =>
   i == n
      | acc
      |
         acc += ti
         make_repeated_vinfos_at(n, ti, i + 1, acc)

make_repeated_vinfos: Int, ast::TypeInfo => ast::VInfos
make_repeated_vinfos = n, ti =>
   make_repeated_vinfos_at(n, ti, 0, ast::VInfos())

make_repeated_vtypes_at: Int, ast::ValueType, Int, ast::VTypes => ast::VTypes
make_repeated_vtypes_at = n, vt, i, acc =>
   i == n
      | acc
      |
         acc += vt
         make_repeated_vtypes_at(n, vt, i + 1, acc)

make_repeated_vtypes: Int, ast::ValueType => ast::VTypes
make_repeated_vtypes = n, vt =>
   make_repeated_vtypes_at(n, vt, 0, ast::VTypes())

fn_inline_param_tis: ast::Expr => ast::VInfos
fn_inline_param_tis = e =>
   e
      [Fn f]
         ?f.ct_params > 0
            |
               ct_name = f.ct_params(0) | _ | ""
               tv = ast::TypeInfo(TypeVar, ct_name)
               make_repeated_vinfos(?f.params, tv)
            | ast::VInfos()
      | ast::VInfos()

fn_inline_param_vtypes: ast::Expr => ast::VTypes
fn_inline_param_vtypes = e =>
   e
      [Fn f]
         ?f.ct_params > 0
            | make_repeated_vtypes(?f.params, ast::ValueType(Type))
            | ast::VTypes()
      | ast::VTypes()

// alongside the erased ValueTypes so body choices can consult TypeInfo.
fn_signature_param_types: types::Cg, ast::Exprs, String, Int => ast::VTypes
fn_signature_param_types = cg, stmts, name, at =>
   fn_signature_param_types_rev(cg, stmts, name, ?stmts - 1)

fn_signature_param_types_rev: types::Cg, ast::Exprs, String, Int => ast::VTypes
fn_signature_param_types_rev = cg, stmts, name, at =>
   at < 0
      | ast::VTypes()
      |
         e = stmts(at)!!
         e
            [Assign t]
               types::sig_name_matches(t.0, name)
                  |
                     t.8
                        [Fn f] resolve_sig_param_types(cg, f.0, f.1)
                        |
                           in_vts = fn_inline_param_vtypes(t.5)
                           ?in_vts > 0
                              | in_vts
                              | fn_signature_param_types_rev(cg, stmts, name, at - 1)
                  | fn_signature_param_types_rev(cg, stmts, name, at - 1)
            | fn_signature_param_types_rev(cg, stmts, name, at - 1)

ti_to_dtype: ast::TypeInfo => String
ti_to_dtype = ti =>
   ti
      [TypeVar name] name
      | ""

resolve_sig_param_dtypes_at: ast::VInfos, Int, Int, ast::Names => ast::Names
resolve_sig_param_dtypes_at = tis, i, n, acc =>
   i == n
      | acc
      |
         ti = (tis(i) | _ | ast::TypeInfo(Prim, ast::ValueType(Unknown)))
         acc += ti_to_dtype(ti)
         resolve_sig_param_dtypes_at(tis, i + 1, n, acc)

resolve_sig_param_dtypes: ast::VInfos => ast::Names
resolve_sig_param_dtypes = tis =>
   resolve_sig_param_dtypes_at(tis, 0, ?tis, ast::Names())

fn_signature_param_dtypes: ast::Exprs, String => ast::Names
fn_signature_param_dtypes = stmts, name =>
   fn_signature_param_dtypes_rev(stmts, name, ?stmts - 1)

fn_signature_param_dtypes_at: ast::Exprs, String, Int => ast::Names
fn_signature_param_dtypes_at = stmts, name, at =>
   fn_signature_param_dtypes_rev(stmts, name, ?stmts - 1)

fn_signature_param_dtypes_rev: ast::Exprs, String, Int => ast::Names
fn_signature_param_dtypes_rev = stmts, name, at =>
   at < 0
      | ast::Names()
      |
         e = stmts(at)!!
         e
            [Assign t]
               types::sig_name_matches(t.0, name)
                  |
                     t.8
                        [Fn f] resolve_sig_param_dtypes(f.1)
                        |
                           in_tis = fn_inline_param_tis(t.5)
                           ?in_tis > 0
                              | resolve_sig_param_dtypes(in_tis)
                              | fn_signature_param_dtypes_rev(stmts, name, at - 1)
                  | fn_signature_param_dtypes_rev(stmts, name, at - 1)
            | fn_signature_param_dtypes_rev(stmts, name, at - 1)

fn_signature_param_tis: ast::Exprs, String => ast::VInfos
fn_signature_param_tis = stmts, name =>
   fn_signature_param_tis_rev(stmts, name, ?stmts - 1)

fn_signature_param_tis_at: ast::Exprs, String, Int => ast::VInfos
fn_signature_param_tis_at = stmts, name, at =>
   fn_signature_param_tis_rev(stmts, name, ?stmts - 1)

fn_signature_param_tis_rev: ast::Exprs, String, Int => ast::VInfos
fn_signature_param_tis_rev = stmts, name, at =>
   at < 0
      | ast::VInfos()
      |
         e = stmts(at)!!
         e
            [Assign t]
               types::sig_name_matches(t.0, name)
                  |
                     t.8
                        [Fn f] f.1
                        |
                           in_tis = fn_inline_param_tis(t.5)
                           ?in_tis > 0
                              | in_tis
                              | fn_signature_param_tis_rev(stmts, name, at - 1)
                  | fn_signature_param_tis_rev(stmts, name, at - 1)
            | fn_signature_param_tis_rev(stmts, name, at - 1)

fn_signature_cparams: ast::Exprs, String => ast::CParams
fn_signature_cparams = stmts, name =>
   fn_signature_cparams_rev(stmts, name, ?stmts - 1)

fn_signature_cparams_rev: ast::Exprs, String, Int => ast::CParams
fn_signature_cparams_rev = stmts, name, at =>
   at < 0
      | ast::CParams()
      |
         e = stmts(at)!!
         e
            [Assign a]
               a.8
                  [Fn f]
                     types::sig_name_matches(a.0, name)
                        | f.4
                        | fn_signature_cparams_rev(stmts, name, at - 1)
                  | fn_signature_cparams_rev(stmts, name, at - 1)
            | fn_signature_cparams_rev(stmts, name, at - 1)

cparams_val_count_at: ast::CParams, Int, Int, Int => Int
cparams_val_count_at = cps, i, acc, n =>
   i == n
      | acc
      |
         cp = cps(i) | _ | ast::CompileTimeParam(("", ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown))))
         is_val = cp.val_type != ast::ValueType(Type)
         next_acc = is_val | acc + 1 | acc
         cparams_val_count_at(cps, i + 1, next_acc, n)

cparams_val_count: ast::CParams => Int
cparams_val_count = cps =>
   cparams_val_count_at(cps, 0, 0, ?cps)

find_cparam_at: ast::CParams, String, Int, Int => ast::CompileTimeParam
find_cparam_at = cps, name, i, n =>
   i == n
      | ast::CompileTimeParam(("", ast::ValueType(Unknown),
         ast::TypeInfo(Prim, ast::ValueType(Unknown))))
      |
         cp = cps(i) | _ | ast::CompileTimeParam(("", ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown))))
         cp.name == name
            | cp
            | find_cparam_at(cps, name, i + 1, n)

find_cparam: ast::CParams, String => ast::CompileTimeParam
find_cparam = cps, name =>
   find_cparam_at(cps, name, 0, ?cps)

cparam_val_index_at: ast::CParams, String, Int, Int, Int => Int
cparam_val_index_at = cps, name, i, n, acc =>
   i == n
      | -1
      |
         cp = cps(i) | _ | ast::CompileTimeParam(("", ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown))))
         cp.name == name
            | acc
            |
               is_val = cp.val_type != ast::ValueType(Type)
               next_acc = is_val | acc + 1 | acc
               cparam_val_index_at(cps, name, i + 1, n, next_acc)

cparam_val_index: ast::CParams, String => Int
cparam_val_index = cps, name =>
   cparam_val_index_at(cps, name, 0, ?cps, 0)

fn_signature_return: types::Cg, ast::Exprs, String, Int => ast::ValueType
fn_signature_return = cg, stmts, name, at =>
   fn_signature_return_rev(cg, stmts, name, ?stmts - 1)

fn_signature_return_rev: types::Cg, ast::Exprs, String, Int => ast::ValueType
fn_signature_return_rev = cg, stmts, name, at =>
   at < 0
      | ast::ValueType(Unknown)
      |
         e = stmts(at)!!
         e
            [Assign a]
               a.8
                  [Fn f]
                     types::sig_name_matches(a.0, name)
                        | resolve_sig_vt(cg, f.2, f.3)
                        | fn_signature_return_rev(cg, stmts, name, at - 1)
                  | fn_signature_return_rev(cg, stmts, name, at - 1)
            | fn_signature_return_rev(cg, stmts, name, at - 1)

fn_signature_return_ti: types::Cg, ast::Exprs, String, Int => ast::TypeInfo
fn_signature_return_ti = cg, stmts, name, at =>
   fn_signature_return_ti_rev(cg, stmts, name, ?stmts - 1)

fn_signature_return_ti_rev: types::Cg, ast::Exprs, String, Int => ast::TypeInfo
fn_signature_return_ti_rev = cg, stmts, name, at =>
   at < 0
      | ast::TypeInfo(Prim, ast::ValueType(Unknown))
      |
         e = stmts(at)!!
         e
            [Assign a]
               a.8
                  [Fn f]
                     types::sig_name_matches(a.0, name)
                        | f.3
                        | fn_signature_return_ti_rev(cg, stmts, name, at - 1)
                  | fn_signature_return_ti_rev(cg, stmts, name, at - 1)
            | fn_signature_return_ti_rev(cg, stmts, name, at - 1)

codegen_validate_declared_return: types::Cg, String, ast::ValueType, ast::ValueType => ast::ValueType
codegen_validate_declared_return = cg, name, declared, actual =>
   declared != ast::ValueType(Unknown)
      | declared
      | actual

return_type_is_scalar: ast::ValueType => <>
return_type_is_scalar = vt => vt [Int, Float, Str]

codegen_declared_return_error: types::Cg, String, ast::ValueType, ast::ValueType => ast::ValueType
codegen_declared_return_error = cg, name, declared, actual =>
   types::init_error(cg, "E3093", "Function '" + name + "' declares return type " +
      types::value_type_name(declared) + ", but the body produces " +
      types::value_type_name(actual) + ".", 0, 0)
   actual

// Pre-pass: a top-level call with a LAMBDA literal or a NAMED-function
// argument means the callee's matching param is a function value — record the
// fn type under that param name, so the callee body's "param(x)" call
// compiles as a closure call (load the param's closure, call with the known
// type). A closure-VARIABLE arg (from "x = make_adder(5)") is not handled
// here: its synthetic lambda name is only known after the producer compiles.
codegen_scan_closure_args: types::Cg, ast::Exprs => ()
codegen_scan_closure_args = cg, stmts =>
   ?stmts @ i =>
      e = stmts(i)!!
      e
         [Assign a]
            a.5
               [Call c]
                  !fn_has_signature(stmts, c.fn_name, 0)
                     |
                        ?c.args @ j =>
                           av = c.args(j)!!
                           av
                              [Fn f]
                                 pn' = expr::fi_param_name(cg, c.fn_name, j)
                                 fi = lambda_infer_fty(cg, f)
                                 pn' != "" |
                                    param_clo_add(cg, c.fn_name + "#" + pn',
                                       fi.0, fi.1)
                              [Var v]
                                 vfi = fninfo_of(cg, v)
                                 vfi
                                    | fi =>
                                       pn' = expr::fi_param_name(cg, c.fn_name, j)
                                       pn' != "" |
                                          param_clo_add(cg,
                                             c.fn_name + "#" + pn',
                                             fi.1, fi.2)

// Whether any top-level statement (recursively) uses #spawn/#join, so the
// pthread machinery is declared before function bodies (their panic sites) and
// statements compile. Mirrors the reference's expr_has_threads pre-pass.
expr_has_threads: types::Cg, ast::Exprs => <>
expr_has_threads = cg, stmts => expr_has_threads_at(cg, stmts, 0, ?stmts)

expr_has_threads_at: types::Cg, ast::Exprs, Int, Int => <>
expr_has_threads_at = cg, stmts, i, n =>
   i == n
      | <->
      |
         expr_has_threads_expr(cg, stmts(i)!!)
            | <+>
            | expr_has_threads_at(cg, stmts, i + 1, n)

expr_has_threads_expr: types::Cg, ast::Expr => <>
expr_has_threads_expr = cg, e =>
   e
      [Spawn s] <+>
      [Join j] <+>
      [Assign t]
         expr_has_threads_expr(cg, t.5) || expr_has_threads_expr(cg, t.6)
      [Bin t] expr_has_threads_expr(cg, t.1) || expr_has_threads_expr(cg, t.2)
      | <->

// Pre-pass: a top-level call with a RECORD argument (a ctor call "T((..))", a
// record literal "(..)", or a var holding a record) means the callee's matching
// param is a record value — record its schema (LLVM struct type + field names +
// field ValueTypes) under that param name, so a member read on the param
// ("id = r => r.a") compiles. Runs before codegen_compile_fns, mirroring
// codegen_scan_closure_args.
codegen_scan_record_args: types::Cg, ast::Exprs => ()
codegen_scan_record_args = cg, stmts =>
   codegen_scan_record_stmt(cg, stmts, 0)

codegen_scan_record_stmt: types::Cg, ast::Exprs, Int => ()
codegen_scan_record_stmt = cg, stmts, i =>
   n = ?stmts
   i != n
      |
         e = stmts(i)!!
         codegen_scan_record_expr(cg, stmts, e)
         codegen_scan_record_stmt(cg, stmts, i + 1)

codegen_scan_record_call: types::Cg, ast::Exprs, String, ast::Exprs, Int, Int => ()
codegen_scan_record_call = cg, stmts, fn_name, args, line, col =>
   call = ast::CallExpr((fn_name, ast::Expr(Var, ""), args, line, col))
   codegen_scan_record_args_of(cg, stmts, call, 0)

codegen_scan_record_expr: types::Cg, ast::Exprs, ast::Expr => ()
codegen_scan_record_expr = cg, stmts, e =>
   e
      [Call c]
         codegen_scan_record_args_of(cg, stmts, c, 0)
         ?c.args @ i =>
            codegen_scan_record_expr(cg, stmts, c.args(i)!!)
      [Spawn s]
         scall = s.call
         codegen_scan_record_args_of(cg, stmts, scall, 0)
         ?scall.args @ i =>
            codegen_scan_record_expr(cg, stmts, scall.args(i)!!)
      [Bin b]
         is_feed = b.0 [Feed]
         is_apply = b.0 [Apply]
         is_app = is_feed || is_apply
         is_app
            |
               vside = is_feed | b.1 | b.2
               fside = is_feed | b.2 | b.1
               fside
                  [Call c]
                     args' = ast::Exprs()
                     is_feed | args' += vside
                     ?c.args @ i => args' += c.args(i)!!
                     !is_feed | args' += vside
                     codegen_scan_record_call(cg, stmts, c.fn_name, args',
                        c.line, c.col)
                  |
                     callee = expr::apply_callee_name(fside)
                     callee != ""
                        |
                           args' = ast::Exprs()
                           args' += vside
                           codegen_scan_record_call(cg, stmts, callee,
                              args', 0, 0)
         codegen_scan_record_expr(cg, stmts, b.1)
         codegen_scan_record_expr(cg, stmts, b.2)
      [Assign t]
         codegen_scan_record_expr(cg, stmts, t.5)
         codegen_scan_record_expr(cg, stmts, t.6)
      [Choice c]
         codegen_scan_record_expr(cg, stmts, c.cond)
         ?c.branches @ i =>
            br = c.branches(i)!!
            codegen_scan_record_expr(cg, stmts, br.block)
      [Block b]
         ?b.exprs @ i =>
            codegen_scan_record_expr(cg, stmts, b.exprs(i)!!)
      [Cycle c]
         codegen_scan_record_expr(cg, stmts, c.iterable)
         codegen_scan_record_expr(cg, stmts, c.body_fn)
      [CycleEscape c]
         codegen_scan_record_expr(cg, stmts, c.cycle)
         codegen_scan_record_expr(cg, stmts, c.branch)
      [Unary u]
         codegen_scan_record_expr(cg, stmts, u.1)
      [Copy e1]
         codegen_scan_record_expr(cg, stmts, e1)
      [Record r]
         ?r.fields @ i =>
            rf = r.fields(i)!!
            codegen_scan_record_expr(cg, stmts, rf.val)
      [Member m]
         codegen_scan_record_expr(cg, stmts, m.target)
         codegen_scan_record_expr(cg, stmts, m.index_expr)

is_rec_candidate: ast::Expr => Int
is_rec_candidate = e =>
   e
      [Call _] 1
      [Record _] 1
      [Var _] 1
      | 0

codegen_scan_record_args_of: types::Cg, ast::Exprs, ast::CallExpr, Int => ()
codegen_scan_record_args_of = cg, stmts, c, j =>
   n = ?c.args
   j != n
      |
         av = c.args(j)!!
         check_sig_record_arg(cg, stmts, c, av, j)
         is_rec_candidate(av) > 0
            |
               pn = expr::fi_param_name(cg, c.fn_name, j)
               pn != ""
                  |
                     record_arg_schema(cg, stmts, c.fn_name + "#" + pn, av)
                     record_arg_schema(cg, stmts, pn, av)
         codegen_scan_record_args_of(cg, stmts, c, j + 1)

// Validate compile-time enum variant indexing before function bodies lower.
// A generic signature's `@ct0:` marker names the erased Type parameter; a
// call supplies its concrete declared enum type through the runtime argument.
codegen_scan_enum_variant_indices: types::Cg, ast::Exprs => ()
codegen_scan_enum_variant_indices = cg, stmts =>
   codegen_scan_enum_variant_stmts(cg, stmts, stmts, 0)

codegen_scan_enum_variant_stmts: types::Cg, ast::Exprs, ast::Exprs, Int => ()
codegen_scan_enum_variant_stmts = cg, all, stmts, i =>
   i < ?stmts
      |
         codegen_scan_enum_variant_expr(cg, all, stmts(i)!!)
         codegen_scan_enum_variant_stmts(cg, all, stmts, i + 1)

codegen_scan_enum_variant_exprs: types::Cg, ast::Exprs, ast::Exprs, Int => ()
codegen_scan_enum_variant_exprs = cg, all, es, i =>
   i < ?es
      |
         codegen_scan_enum_variant_expr(cg, all, es(i)!!)
         codegen_scan_enum_variant_exprs(cg, all, es, i + 1)

codegen_scan_enum_variant_expr: types::Cg, ast::Exprs, ast::Expr => ()
codegen_scan_enum_variant_expr = cg, all, e =>
   e
      [Assign t] codegen_scan_enum_variant_expr(cg, all, t.5)
      [Bin t]
         codegen_scan_enum_variant_expr(cg, all, t.1)
         codegen_scan_enum_variant_expr(cg, all, t.2)
      [Call c]
         codegen_check_enum_variant_call(cg, all, c)
         codegen_scan_enum_variant_exprs(cg, all, c.args, 0)
      [Fn f] codegen_scan_enum_variant_expr(cg, all, f.body)
      [Block b] codegen_scan_enum_variant_exprs(cg, all, b.exprs, 0)
      [Member m]
         codegen_scan_enum_variant_expr(cg, all, m.target)
         codegen_scan_enum_variant_expr(cg, all, m.index_expr)

codegen_check_enum_variant_call: types::Cg, ast::Exprs, ast::CallExpr => ()
codegen_check_enum_variant_call = cg, stmts, call =>
   enum_name = enum_call_arg_type(cg, call.args)
   enum_name != ""
      |
         ct_name = sig_ct0_name(stmts, call.fn_name, 0)
         ct_name != ""
            |
               body = scan_fn_body_of(cg.fns, call.fn_name, 0)
               index = ct_member_index(body, ct_name)
               index !< 0
                  |
                     check_enum_variant_range(cg, enum_name, index,
                        call.line, call.col)

names_to_comma_str: ast::Names, Int, String => String
names_to_comma_str = names, i, acc =>
   i == ?names
      | acc
      |
         n = names(i) | _ | ""
         next = i == 0 | n | acc + ", " + n
         names_to_comma_str(names, i + 1, next)

fn_ct_params_str: ast::Expr => String
fn_ct_params_str = e =>
   e
      [Fn f]
         ?f.ct_params == 0
            | ""
            | names_to_comma_str(f.ct_params, 0, "")
      | ""

sig_ct0_name: ast::Exprs, String, Int => String
sig_ct0_name = stmts, name, at =>
   sig_ct0_name_rev(stmts, name, ?stmts - 1)

sig_ct0_name_rev: ast::Exprs, String, Int => String
sig_ct0_name_rev = stmts, name, at =>
   res' = ++""
   (at + 1) @ k =>
      idx = at - k
      e = stmts(idx)!!
      e
         [Assign t]
            types::sig_name_matches(t.0, name)
               |
                  ct = marker_ct0_name(t.7)
                  ct != ""
                     |
                        res' = ct
                        -->
                     |
                        fn_ct = fn_ct_params_str(t.5)
                        fn_ct != ""
                           |
                              res' = fn_ct
                              -->
                           |
                              t.8 [Fn _] -->
   res'

marker_ct0_name: String => String
marker_ct0_name = marker =>
   marker(..5) == "@ct0:"
      | marker(5..)
      | ""

enum_call_arg_type: types::Cg, ast::Exprs => String
enum_call_arg_type = cg, args =>
   ?args == 0
      | ""
      |
         arg = (args(0) | _ | ast::Expr(Var, ""))
         arg [Var v] types::var_dtype(cg, v) | ""

scan_fn_body_of: types::FnDefs, String, Int => ast::Expr
scan_fn_body_of = fns, name, i =>
   i == ?fns
      | ast::Expr(Var, "")
      |
         fd = fns(i)!!
         fd.name == name | fd.body | scan_fn_body_of(fns, name, i + 1)

ct_member_index: ast::Expr, String => Int
ct_member_index = e, ct_name =>
   e
      [Member m]
         m.target
            [Var v]
               v == ct_name
                  |
                     m.index_expr
                        [Int n] n
                        | -1
                  | -1
            | -1
      [Block b] ct_member_index_stmts(b.exprs, ct_name, 0)
      | -1

ct_member_index_stmts: ast::Exprs, String, Int => Int
ct_member_index_stmts = es, ct_name, i =>
   i == ?es
      | -1
      |
         n = ct_member_index(es(i)!!, ct_name)
         n !< 0 | n | ct_member_index_stmts(es, ct_name, i + 1)

check_enum_variant_range: types::Cg, String, Int, Int, Int => ()
check_enum_variant_range = cg, enum_name, index, line, col =>
   types::typedef_ti(cg, enum_name)
      [Enum slots]
         index !< ?slots
            | types::init_error(cg, "E3171", "Enum variant index " +
               str::from_int(index) + " out of range (0.." +
               str::from_int(?slots - 1) + ").", line, col)

// Signatures preserve their first source parameter type in an inert `@sig0:`
// marker. The selfhost codegen cannot inspect the Fn TypeInfo stored in an
// Assign tuple directly, so this provides static layout checking without RTTI.
check_sig_record_arg: types::Cg, ast::Exprs, ast::CallExpr, ast::Expr, Int => ()
check_sig_record_arg = cg, stmts, call, arg, i =>
   i == 0
      |
         actual = record_ctor_name(cg, arg)
         actual != ""
            |
               expected = sig_param0_name(stmts, call.fn_name, 0)
               expected != ""
                  |
                     want = runtime::record_meta_from_ti(cg, types::typedef_ti(cg, expected))
                     got = runtime::record_meta_from_ti(cg, types::typedef_ti(cg, actual))
                     mismatch = want
                        | w =>
                           got
                              | g => w.0 != g.0
                              | <->
                        | <->
                     mismatch
                        |
                           types::init_error(cg, "E3148", "Argument " +
                              str::from_int(i + 1) + " to '" + call.fn_name +
                              "' must be a Record with the declared field " +
                              "layout, got a Record with a different layout.",
                              call.line, call.col)

sig_param0_name: ast::Exprs, String, Int => String
sig_param0_name = stmts, name, at =>
   at == ?stmts
      | ""
      |
         e = stmts(at)!!
         e
            [Assign t]
               t.0 == name
                  |
                     marker_param0_name(t.7)
                  | sig_param0_name(stmts, name, at + 1)
            | sig_param0_name(stmts, name, at + 1)

marker_param0_name: String => String
marker_param0_name = marker =>
   marker(..6) == "@sig0:"
      | marker(6..)
      | ""

record_ctor_name: types::Cg, ast::Expr => String
record_ctor_name = cg, arg =>
   arg
      [Call c]
         types::is_user_type(cg, c.fn_name)
            | c.fn_name
            | ""
      | ""

// Resolves a call arg's record schema and records it under the param name
// (no-op when the arg is not a record value). A VAR arg resolves through the
// top-level assignment that built it ("t = T((..))"), since the var's schema is
// only registered when that statement emits (after fns compile).
record_arg_schema: types::Cg, ast::Exprs, String, ast::Expr => ()
record_arg_schema = cg, stmts, pn, av =>
   av
      [Call c2]
         types::is_user_type(cg, c2.fn_name)
            |
               ti = types::typedef_ti(cg, c2.fn_name)
               rm = runtime::record_meta_from_ti(cg, ti)
               rm | m => param_rec_add(cg, pn, m.0, m.1, types::field_vts(cg, ti))
      [Record r]
         nf = ?r.fields
         ftypes = types::Addrs()
         fvts = ast::VTypes()
         fnames = ast::Names()
         record_schema_fields(cg, r, 0, nf, ftypes, fvts, fnames)
         param_rec_add(cg, pn, types::struct_type_n(cg, ftypes, nf), fnames, fvts)
      [Var v]
         types::var_rt(cg, v)
            | vrt =>
               param_rec_add(cg, pn, vrt, types::var_fnames(cg, v), match::var_fvts(cg, v))
            | record_var_schema(cg, stmts, pn, v)

// Resolves a record var's schema from its top-level assignment ("t = T((..))"
// or "t = (a, b)"), recording it under the param name. No-op if the var is
// never assigned a record value.
record_var_schema: types::Cg, ast::Exprs, String, String => ()
record_var_schema = cg, stmts, pn, v =>
   record_var_schema_at(cg, stmts, pn, v, 0)

record_var_schema_at: types::Cg, ast::Exprs, String, String, Int => ()
record_var_schema_at = cg, stmts, pn, v, i =>
   n = ?stmts
   i != n
      |
         e = stmts(i)!!
         e
            [Assign t]
               t.0 == v
                  |
                     t.7 != "" && types::is_user_type(cg, t.7)
                        |
                           ti = types::typedef_ti(cg, t.7)
                           rm = runtime::record_meta_from_ti(cg, ti)
                           rm | m => param_rec_add(cg, pn, m.0, m.1, types::field_vts(cg, ti))
                        | record_arg_schema(cg, stmts, pn, t.5)
                  | record_var_schema_at(cg, stmts, pn, v, i + 1)
            | record_var_schema_at(cg, stmts, pn, v, i + 1)

// The inferred ValueType of a record literal's field value.
record_field_vt: types::Cg, ast::RecordField => ast::ValueType
record_field_vt = cg, f =>
   f.val
      [Int n] ast::ValueType(Int)
      [Float fl] ast::ValueType(Float)
      [Str s] ast::ValueType(Str)
      [Record r] ast::ValueType(Record)
      [Call c]
         types::is_user_type(cg, c.fn_name)
            | ast::ValueType(Record)
            | ast::ValueType(Int)
      [Var v]
         types::var_rt(cg, v)
            | _ => ast::ValueType(Record)
            | types::var_type(cg, v)
      | ast::ValueType(Int)

record_schema_fields: types::Cg, ast::RecordExpr, Int, Int, types::Addrs, ast::VTypes, ast::Names => ()
record_schema_fields = cg, r, i, nf, ftypes, fvts, fnames =>
   i != nf
      |
         f = r.fields(i)!!
         fv = record_field_vt(cg, f)
         is_rec = fv [Record]
         f_ll = is_rec
            |
               f.val
                  [Record inner_r]
                     record_expr_struct_type(cg, inner_r)
                  [Call c]
                     types::is_user_type(cg, c.fn_name)
                        |
                           ti = types::typedef_ti(cg, c.fn_name)
                           rm = runtime::record_meta_from_ti(cg, ti)
                           rm | m => m.0 | types::llvm_type_of_vt(fv)
                        | types::llvm_type_of_vt(fv)
                  [Var vf]
                     types::var_rt(cg, vf) | _ | types::llvm_type_of_vt(fv)
                  | types::llvm_type_of_vt(fv)
            | types::llvm_type_of_vt(fv)
         ftypes += f_ll
         fvts += fv
         f.has_name | fnames += f.name
         record_schema_fields(cg, r, i + 1, nf, ftypes, fvts, fnames)

record_expr_struct_type: types::Cg, ast::RecordExpr => Addr
record_expr_struct_type = cg, r =>
   nf = ?r.fields
   ftypes = types::Addrs()
   fvts = ast::VTypes()
   fnames = ast::Names()
   record_schema_fields(cg, r, 0, nf, ftypes, fvts, fnames)
   types::struct_type_n(cg, ftypes, nf)

// Records a record param's schema under the param name.
param_rec_add: types::Cg, String, Addr, ast::Names, ast::VTypes => ()
param_rec_add = cg, name, rt, fnames, fvts =>
   cg.param_recs += types::ParamRec((name, rt, fnames, fvts))

fn_ret_rec_add: types::Cg, String, <Addr|>, ast::Names, ast::VTypes, String => ()
fn_ret_rec_add = cg, name, rt, fnames, fvts, dtype =>
   types::g.fn_ret_recs += types::FnRetRec((name, rt, fnames, fvts, dtype))

fn_ret_rec_of: types::Cg, String => <types::FnRetRec|>
fn_ret_rec_of = cg, name => fn_ret_rec_of_rev(cg, name, ?types::g.fn_ret_recs - 1)

fn_ret_rec_of_rev: types::Cg, String, Int => <types::FnRetRec|>
fn_ret_rec_of_rev = cg, name, i =>
   i < 0
      | <-->
      |
         pr = types::g.fn_ret_recs(i)!!
         types::sig_name_matches(pr.name, name)
            | <+ pr ->
            | fn_ret_rec_of_rev(cg, name, i - 1)

fn_ret_fn_add: String, String => ()
fn_ret_fn_add = name, tgt =>
   types::g.fn_ret_fn_names += name
   types::g.fn_ret_fn_tgts += tgt

fn_ret_fn_of: String => String
fn_ret_fn_of = name => fn_ret_fn_of_rev(name, ?types::g.fn_ret_fn_names - 1)

fn_ret_fn_of_rev: String, Int => String
fn_ret_fn_of_rev = name, i =>
   i < 0
      | ""
      |
         pr = (types::g.fn_ret_fn_names(i) | _ | "")
         types::sig_name_matches(pr, name)
            | (types::g.fn_ret_fn_tgts(i) | _ | "")
            | fn_ret_fn_of_rev(name, i - 1)

fn_ret_is_scalar: types::Cg, String => <>
fn_ret_is_scalar = cg, fname =>
   is_foreign_fn(fname)
      | <+>
      |
         types::fninfo_index(cg, fname)
            | idx =>
               fi = cg.fninfos(idx)!!
               types::is_scalar_vt(fi.ret_vt)
            | <->

apply_call_ret_meta: types::Cg, String => ()
apply_call_ret_meta = cg, fname =>
   !is_foreign_fn(fname)
      |
         rfn = fn_ret_fn_of(fname)
         rfn != "" | cg.last_closure_fn = rfn
         fn_ret_rec_of(cg, fname)
            | rrec =>
               cg.last_rt = rrec.rt
               cg.last_fnames = rrec.fnames
               cg.last_fvts = rrec.fvts
               cg.last_type = rrec.dtype
            |
               !fn_ret_is_scalar(cg, fname)
                  |
                     sig_ti = fn_signature_return_ti(cg, types::g.pstmts, fname, 0)
                     sig_ti
                        [TypeVar tname]
                           types::td_record_meta_by_name(cg, tname)
                              | m =>
                                 cg.last_rt = <+ m.0 ->
                                 cg.last_fnames = m.1
                                 cg.last_fvts = types::field_vts(cg, types::typedef_ti(cg, tname))
                           cg.last_type = tname
                        [Ram slots]
                           !types::ram_slots_are_flag(slots)
                              |
                                 ret_tname' = "#ret_" + fname
                                 !types::has_type_name(cg, ret_tname')
                                    | runtime::add_type(cg, ret_tname', sig_ti)
                                 cg.last_type = ret_tname'
                        [Rec rr]
                           ret_tname' = "#ret_" + fname
                           runtime::record_meta_from_ti(cg, sig_ti)
                              | m =>
                                 !types::has_type_name(cg, ret_tname')
                                    | runtime::add_type_rec(cg, ret_tname', sig_ti, <+ m.0 ->, m.1)
                                 cg.last_rt = <+ m.0 ->
                                 cg.last_fnames = m.1
                                 cg.last_fvts = types::field_vts(cg, sig_ti)
                           cg.last_type = ret_tname'

// Pre-pass: a top-level call with a GROWABLE-ARRAY argument means the callee's
// matching param is an array value — record the param name so the callee body
// types it as Array (a param read/return then carries the pointer). Mirrors
// codegen_scan_record_args.
codegen_scan_array_args: types::Cg, ast::Exprs => ()
codegen_scan_array_args = cg, stmts =>
   codegen_scan_array_stmt(cg, stmts, 0)

codegen_scan_array_stmt: types::Cg, ast::Exprs, Int => ()
codegen_scan_array_stmt = cg, stmts, i =>
   n = ?stmts
   i != n
      |
         e = stmts(i)!!
         codegen_scan_array_expr(cg, stmts, e)
         codegen_scan_array_stmt(cg, stmts, i + 1)

codegen_scan_array_expr: types::Cg, ast::Exprs, ast::Expr => ()
codegen_scan_array_expr = cg, stmts, e =>
   e
      [Assign t]
         t.5
            [Call c]
               codegen_scan_array_args_of(cg, stmts, c, 0)
            [Spawn s]
               codegen_scan_array_args_of(cg, stmts, s.call, 0)
      [Call c]
         codegen_scan_array_args_of(cg, stmts, c, 0)
      [Spawn s]
         codegen_scan_array_args_of(cg, stmts, s.call, 0)

codegen_scan_array_args_of: types::Cg, ast::Exprs, ast::CallExpr, Int => ()
codegen_scan_array_args_of = cg, stmts, c, j =>
   n = ?c.args
   j != n
      |
         av = c.args(j)!!
         is_arr = av [Var v] types::is_array_vt(types::var_type(cg, v)) | <->
         is_sl = expr_is_slice(cg, stmts, av)
         is_arr
            |
               pn = expr::fi_param_name(cg, c.fn_name, j)
               pn != "" |
                  param_arr_add(cg, c.fn_name + "#" + pn)
            | is_sl
               |
                  pn2 = expr::fi_param_name(cg, c.fn_name, j)
                  pn2 != "" |
                     param_sl_add(cg, c.fn_name + "#" + pn2)
         codegen_scan_array_args_of(cg, stmts, c, j + 1)

// Whether an expression is a Slice value: a var whose registered type is Slice,
// or a var assigned a slice-producing call ("sl = xs(a..b)") — the var's type
// is not registered until its statement emits (after the scan).
expr_is_slice: types::Cg, ast::Exprs, ast::Expr => <>
expr_is_slice = cg, stmts, av =>
   av
      [Var v]
         is_sl_reg = types::is_slice_vt(types::var_type(cg, v))
         is_sl_reg
            | <+>
            | var_assigned_slice(cg, stmts, v)
      [Call c2]
         rng = main::range_arg_of(c2)
         rng.has_lhs
            | <+>
            | rng.has_rhs
      | <->

var_assigned_slice: types::Cg, ast::Exprs, String => <>
var_assigned_slice = cg, stmts, v =>
   var_assigned_slice_at(cg, stmts, v, 0)

var_assigned_slice_at: types::Cg, ast::Exprs, String, Int => <>
var_assigned_slice_at = cg, stmts, v, i =>
   n = ?stmts
   i == n
      | <->
      |
         e = stmts(i)!!
         hit = e [Assign t] ((t.0 == v) && stmt_is_slice_call(t.5)) | <->
         hit
            | <+>
            | var_assigned_slice_at(cg, stmts, v, i + 1)

stmt_is_slice_call: ast::Expr => <>
stmt_is_slice_call = e =>
   e
      [Call c2]
         rng = main::range_arg_of(c2)
         rng.has_lhs
            | <+>
            | rng.has_rhs
      | <->

// Records a param as an array-typed parameter.
param_arr_add: types::Cg, String => ()
param_arr_add = cg, name =>
   cg.param_arr_names += name

// Whether a param was inferred to be a growable array from its call site.
param_arr_of: types::Cg, String => <>
param_arr_of = cg, name => param_arr_of_at(cg, name, 0, ?cg.param_arr_names)

param_arr_of_at: types::Cg, String, Int, Int => <>
param_arr_of_at = cg, name, i, n =>
   i == n
      | <->
      |
         (cg.param_arr_names(i) | _ | "") == name
            | <+>
            | param_arr_of_at(cg, name, i + 1, n)

// Records a param as a slice-typed parameter.
param_sl_add: types::Cg, String => ()
param_sl_add = cg, name =>
   cg.param_sl_names += name

// Whether a param was inferred to be a Slice from its call site.
param_sl_of: types::Cg, String => <>
param_sl_of = cg, name => param_sl_of_at(cg, name, 0, ?cg.param_sl_names)

param_sl_of_at: types::Cg, String, Int, Int => <>
param_sl_of_at = cg, name, i, n =>
   i == n
      | <->
      |
         (cg.param_sl_names(i) | _ | "") == name
            | <+>
            | param_sl_of_at(cg, name, i + 1, n)


// The recorded schema of a param.
param_rec_of: types::Cg, String => <(Addr, ast::Names, ast::VTypes)|>
param_rec_of = cg, name => param_rec_of_at(cg, name, 0, ?cg.param_recs)

param_rec_of_at: types::Cg, String, Int, Int => <(Addr, ast::Names, ast::VTypes)|>
param_rec_of_at = cg, name, i, n =>
   i == n
      | <-->
      |
         pr = cg.param_recs(i)!!
         pr.name == name
            | <+ (pr.rt, pr.fnames, pr.fvts) ->
            | param_rec_of_at(cg, name, i + 1, n)

// The (fn, llvm_type, ret_vt) of a named function, or <--> if none.
// Falls back to inferring the type from its FnDef (the scan runs before the
// fns compile, so fninfos may be empty).
fninfo_of: types::Cg, String => <(<Addr|>, Addr, ast::ValueType)|>
fninfo_of = cg, name =>
   fi = fninfo_of_at(cg, name, 0, ?cg.fninfos)
   fi
      | f => <+ f ->
      | fninfo_from_fns_at(cg, name, 0, ?cg.fns)

fninfo_of_at: types::Cg, String, Int, Int => <(<Addr|>, Addr, ast::ValueType)|>
fninfo_of_at = cg, name, i, n =>
   i == n
      | <-->
      |
         fi = cg.fninfos(i)!!
         (fi.name == name) || types::sig_name_matches(fi.name, name)
            | <+ (fi.llvm_fn, fi.llvm_type!!, fi.ret_vt) ->
            | fninfo_of_at(cg, name, i + 1, n)

fninfo_from_fns_at: types::Cg, String, Int, Int => <(<Addr|>, Addr, ast::ValueType)|>
fninfo_from_fns_at = cg, name, i, n =>
   i == n
      | <-->
      |
         fd = cg.fns(i)!!
         fd.name == name
            |
               ptypes = infer_param_types(fd, ast::VTypes())
               ret_vt' = infer_ret(fd.body, fd.params, ptypes)
               ret_vt' = fn_ret_override(cg, fd.body, ret_vt')
               param_ll = fninfo_param_ll(cg, fd.params, ptypes, 0,
                  ?fd.params, types::Addrs())
               fty = fn_type_n(cg, types::llvm_type_of_vt(ret_vt'), param_ll,
                  ?fd.params)
               <+ (<-->, fty, ret_vt') ->
            | fninfo_from_fns_at(cg, name, i + 1, n)

fninfo_param_ll: types::Cg, ast::Names, ast::VTypes, Int, Int, types::Addrs => types::Addrs
fninfo_param_ll = cg, params, ptypes, k, np, acc =>
   k == np
      | acc
      |
         acc += types::llvm_type_of_vt((ptypes(k) | _ | ast::ValueType(Unknown)))
         fninfo_param_ll(cg, params, ptypes, k + 1, np, acc)

// Infers the fn type of a lambda from its body (param types via
// infer_param_types, ret via infer_ret) — the type the compiled lambda will
// have, used to type the closure call in the callee.
lambda_infer_fty: types::Cg, ast::FnExpr => (Addr, ast::ValueType)
lambda_infer_fty = cg, f =>
   caps = lambda_captures(cg, f)
   cap_names = ast::Names()
   cap_types = ast::VTypes()
   ?caps @ ci =>
      cname = (caps(ci) | _ | "")
      cap_names += cname
      cap_types += types::var_type(cg, cname)
   ptypes = infer_param_types_env(types::FnDef(("l", f.params, f.body)), ast::VTypes(), cap_names, cap_types)
   all_params = ast::Names()
   ?f.params @ pi => all_params += (f.params(pi) | _ | "")
   all_ptypes = ast::VTypes()
   ?ptypes @ pti => all_ptypes += (ptypes(pti) | _ | ast::ValueType(Unknown))
   ?cap_names @ c2i =>
      all_params += (cap_names(c2i) | _ | "")
      all_ptypes += (cap_types(c2i) | _ | ast::ValueType(Unknown))
   ret_vt' = infer_ret(f.body, all_params, all_ptypes)
   ret_vt' = fn_ret_override(cg, f.body, ret_vt')
   ret_ll = types::llvm_type_of_vt(ret_vt')
   param_ll = types::Addrs()
   ?f.params @ i => param_ll += types::llvm_type_of_vt(ptypes(i)!!)
   (fn_type_n(cg, ret_ll, param_ll, ?f.params), ret_vt')


// The param type hints for `name`, mirroring the reference's Stage-4
// unification sources: a direct call, a call through a pass-through alias
// ("g = f" then "g(4)"), or a HOF argument whose closure param is called in
// the callee's body ("apply(f, 4)" with "apply = f2, x => f2(x)").
call_hint: types::Cg, ast::Exprs, String => ast::VTypes
call_hint = cg, stmts, name =>
   hints = call_hint_direct(cg, stmts, pass_names(cg, stmts, name))
   ?hints > 0
      | hints
      | call_hint_hof(cg, stmts, name)

call_hint_direct: types::Cg, ast::Exprs, ast::Names => ast::VTypes
call_hint_direct = cg, stmts, names =>
   hints = ast::VTypes()
   call_hint_direct_at(cg, stmts, names, hints, 0, ?stmts)
   hints

call_hint_direct_at: types::Cg, ast::Exprs, ast::Names, ast::VTypes, Int, Int => <>
call_hint_direct_at = cg, stmts, names, hints, i, n =>
   i == n
      | <->
      |
         scan_call(cg, stmts(i)!!, names, hints)
            | <+>
            | call_hint_direct_at(cg, stmts, names, hints, i + 1, n)

// The pass-through closure of `name`: itself plus every top-level binding
// whose RHS is a Var already in the set ("h = inc", "g = h").
pass_names: types::Cg, ast::Exprs, String => ast::Names
pass_names = cg, stmts, name =>
   names = ast::Names()
   names += name
   ?stmts @ _ =>
      growing' = <->
      ?stmts @ i =>
         pass_grow(cg, stmts(i)!!, names) | growing' = <+>
      !growing' | -->
   names

call_passes_arg: types::Cg, ast::CallExpr, ast::Names => <>
call_passes_arg = cg, c, names =>
   fd = fndef_of(cg.fns, c.fn_name, 0)
   fd.name != ""
      |
         fd.body
            [Var v]
               idx = param_index(fd.params, v, 0)
               idx !< 0 && idx < ?c.args
                  |
                     arg = c.args(idx)!!
                     arg
                        [Var av] name_is_in(names, av)
                        | <->
                  | <->
            | <->
      | <->

expr_var_name: ast::Expr => String
expr_var_name = e =>
   e
      [Var v] v
      [Block b]
         n = ?b.exprs
         n > 0 | expr_var_name(b.exprs(n - 1)!!) | ""
      | ""

fn_ret_of_name: types::Cg, String => ast::ValueType
fn_ret_of_name = cg, name =>
   name == ""
      | ast::ValueType(Unknown)
      |
         fn_has_signature(types::g.pstmts, name, 0)
            | fn_signature_return(cg, types::g.pstmts, name, 0)
            |
               fd = fndef_of(cg.fns, name, 0)
               fd.name != ""
                  | infer_ret(fd.body, fd.params, ast::VTypes())
                  | ast::ValueType(Unknown)

choice_first_fn_ret: types::Cg, ast::Branches, Int => ast::ValueType
choice_first_fn_ret = cg, brs, at =>
   at == ?brs
      | ast::ValueType(Unknown)
      |
         vn = expr_var_name(brs(at)!!.block)
         ret = fn_ret_of_name(cg, vn)
         ret != ast::ValueType(Unknown)
            | ret
            | choice_first_fn_ret(cg, brs, at + 1)

choice_branches_has_any: types::Cg, ast::Branches, ast::Names, ast::ValueType,
   Int => <>
choice_branches_has_any = cg, brs, names, first_ret, at =>
   at == ?brs
      | <->
      |
         br = brs(at)!!
         vn = expr_var_name(br.block)
         br_ret = fn_ret_of_name(cg, vn)
         compat = first_ret == ast::ValueType(Unknown) ||
            br_ret == ast::ValueType(Unknown) || br_ret == first_ret
         (compat && vn != "" && name_is_in(names, vn))
            | <+>
            | choice_branches_has_any(cg, brs, names, first_ret, at + 1)

choice_branches_add_names: types::Cg, ast::Branches, ast::Names, ast::ValueType,
   Int => <>
choice_branches_add_names = cg, brs, names, first_ret, at =>
   at == ?brs
      | <->
      |
         br = brs(at)!!
         vn = expr_var_name(br.block)
         br_ret = fn_ret_of_name(cg, vn)
         compat = first_ret == ast::ValueType(Unknown) ||
            br_ret == ast::ValueType(Unknown) || br_ret == first_ret
         added = compat && vn != "" && !name_is_in(names, vn)
         added | names += vn
         rec = choice_branches_add_names(cg, brs, names, first_ret, at + 1)
         added || rec

choice_branches_add_compat: types::Cg, ast::Branches, ast::Names => <>
choice_branches_add_compat = cg, brs, names =>
   choice_branches_add_names(cg, brs, names,
      choice_first_fn_ret(cg, brs, 0), 0)

choice_branches_has_compat: types::Cg, ast::Branches, ast::Names => <>
choice_branches_has_compat = cg, brs, names =>
   choice_branches_has_any(cg, brs, names,
      choice_first_fn_ret(cg, brs, 0), 0)

pass_grow: types::Cg, ast::Expr, ast::Names => <>
pass_grow = cg, e, names =>
   e
      [Assign t]
         t.0 != ""
            |
               name_is_in(names, t.0)
                  |
                     t.5
                        [Choice c]
                           choice_branches_add_compat(cg, c.branches, names)
                        | <->
                  |
                     t.5
                        [Var v]
                           name_is_in(names, v)
                              |
                                 names += t.0
                                 <+>
                              | <->
                        [Call c]
                           call_passes_arg(cg, c, names)
                              |
                                 names += t.0
                                 <+>
                              | <->
                        [Choice c]
                           choice_branches_has_compat(cg, c.branches, names)
                              |
                                 names += t.0
                                 choice_branches_add_compat(cg, c.branches,
                                    names)
                                 <+>
                              | <->
                        | <->
            | <->
      | <->

name_is_in: ast::Names, String => <>
name_is_in = names, n => types::has_str(names, n)

// Scans one top-level statement (recursively) for a call to any of `names`,
// recording its arguments' inferred types from the first call found.
scan_call: types::Cg, ast::Expr, ast::Names, ast::VTypes => <>
scan_call = cg, e, names, hints =>
   e
      [Assign t]
         scan_call(cg, t.5, names, hints)
      [Call c]
         name_is_in(names, c.fn_name)
            |
               ?c.args @ i =>
                  av = c.args(i)!!
                  hints += infer_expr_type(cg, av)
               <+>
            | <->
      [Bin t]
         scan_call(cg, t.1, names, hints) || scan_call(cg, t.2, names, hints)
      [Exit t]
         scan_call(cg, t.code, names, hints)
      [Spawn s]
         scan_call(cg, ast::Expr(Call, s.call), names, hints)
      | <->

// HOF-argument hints: "h(.., f, ..)" where h's param at that position is
// called in h's body — the inner call's arg types, mapped through h's own
// params back to h's call site, are f's param hints.
call_hint_hof: types::Cg, ast::Exprs, String => ast::VTypes
call_hint_hof = cg, stmts, name =>
   hints = ast::VTypes()
   call_hint_hof_at(cg, stmts, name, hints, 0, ?stmts)
   hints

call_hint_hof_at: types::Cg, ast::Exprs, String, ast::VTypes, Int, Int => <>
call_hint_hof_at = cg, stmts, name, hints, i, n =>
   i == n
      | <->
      |
         hof_scan(cg, stmts, stmts(i)!!, name, hints, "")
            | <+>
            | call_hint_hof_at(cg, stmts, name, hints, i + 1, n)

hof_scan: types::Cg, ast::Exprs, ast::Expr, String, ast::VTypes, String => <>
hof_scan = cg, stmts, e, name, hints, bound_var =>
   e
      [Assign t] hof_scan(cg, stmts, t.5, name, hints, t.0)
      [Call c] hof_args(cg, stmts, c, name, hints, bound_var)
      [Bin t]
         hof_scan(cg, stmts, t.1, name, hints, bound_var) ||
            hof_scan(cg, stmts, t.2, name, hints, bound_var)
      [Exit t] hof_scan(cg, stmts, t.code, name, hints, bound_var)
      [Spawn s]
         hof_scan(cg, stmts, ast::Expr(Call, s.call), name, hints, bound_var)
      | <->

hof_args: types::Cg, ast::Exprs, ast::CallExpr, String, ast::VTypes, String => <>
hof_args = cg, stmts, c, name, hints, bound_var =>
   hof_args_at(cg, stmts, c, name, hints, bound_var, 0, ?c.args)

hof_args_at: types::Cg, ast::Exprs, ast::CallExpr, String, ast::VTypes, String,
   Int, Int => <>
hof_args_at = cg, stmts, c, name, hints, bound_var, j, n =>
   j == n
      | <->
      |
         av = c.args(j)!!
         av
            [Var v]
               v == name
                  | hof_flow(cg, stmts, c, j, hints, bound_var)
                  | hof_args_at(cg, stmts, c, name, hints, bound_var, j + 1, n)
            | hof_args_at(cg, stmts, c, name, hints, bound_var, j + 1, n)

hof_flow: types::Cg, ast::Exprs, ast::CallExpr, Int, ast::VTypes, String => <>
hof_flow = cg, stmts, c, j, hints, bound_var =>
   fd = fndef_of(cg.fns, c.fn_name, 0)
   fd.name != "" && j < ?fd.params
      |
         p = fd.params(j)!!
         hof_body_scan(cg, stmts, fd.body, fd, p, c, hints, bound_var)
      | <->

hof_call_args_scan: types::Cg, ast::Exprs, ast::Exprs, types::FnDef, String,
   ast::CallExpr, ast::VTypes, String, Int => <>
hof_call_args_scan = cg, stmts, args, fd, p, outer, hints, bound_var, i =>
   i == ?args
      | <->
      |
         hof_body_scan(cg, stmts, args(i)!!, fd, p, outer,
            hints, bound_var)
            | <+>
            | hof_call_args_scan(cg, stmts, args, fd, p, outer, hints,
               bound_var, i + 1)

hof_body_scan: types::Cg, ast::Exprs, ast::Expr, types::FnDef, String, ast::CallExpr,
   ast::VTypes, String => <>
hof_body_scan = cg, stmts, e, fd, p, outer, hints, bound_var =>
   e
      [Assign t] hof_body_scan(cg, stmts, t.5, fd, p, outer, hints, bound_var)
      [Fn lam]
         lam_hints = ast::VTypes()
         bound_var != ""
            |
               bnames = pass_names(cg, stmts, bound_var)
               call_hint_direct_at(cg, stmts, bnames, lam_hints, 0, ?stmts)
         hof_lam_body_scan(cg, lam.body, fd, lam, p, outer, hints, lam_hints)
      [Call c]
         c.fn_name == p
            |
               ?c.args @ k =>
                  hints += hof_arg_type(cg, c.args(k)!!, fd, outer)
               <+>
            |
               hof_call_args_scan(cg, stmts, c.args, fd, p, outer, hints,
                  bound_var, 0)
      [Bin t]
         l = hof_body_scan(cg, stmts, t.1, fd, p, outer, hints, bound_var)
         l || hof_body_scan(cg, stmts, t.2, fd, p, outer, hints, bound_var)
      | <->

hof_lam_args_scan: types::Cg, ast::Exprs, types::FnDef, ast::FnExpr, String,
   ast::CallExpr, ast::VTypes, ast::VTypes, Int => <>
hof_lam_args_scan = cg, args, fd, lam, p, outer, hints, lam_hints, i =>
   i == ?args
      | <->
      |
         hof_lam_body_scan(cg, args(i)!!, fd, lam, p, outer,
            hints, lam_hints)
            | <+>
            | hof_lam_args_scan(cg, args, fd, lam, p, outer, hints,
               lam_hints, i + 1)

hof_lam_body_scan: types::Cg, ast::Expr, types::FnDef, ast::FnExpr, String,
   ast::CallExpr, ast::VTypes, ast::VTypes => <>
hof_lam_body_scan = cg, e, fd, lam, p, outer, hints, lam_hints =>
   e
      [Assign t]
         hof_lam_body_scan(cg, t.5, fd, lam, p, outer, hints, lam_hints)
      [Call c]
         c.fn_name == p
            |
               ?c.args @ k =>
                  hints += hof_lam_arg_type(cg, c.args(k)!!,
                     fd, lam, outer, lam_hints)
               <+>
            |
               hof_lam_args_scan(cg, c.args, fd, lam, p, outer, hints,
                  lam_hints, 0)
      [Bin t]
         l = hof_lam_body_scan(cg, t.1, fd, lam, p, outer, hints, lam_hints)
         l || hof_lam_body_scan(cg, t.2, fd, lam, p, outer, hints, lam_hints)
      | <->

hof_lam_arg_type: types::Cg, ast::Expr, types::FnDef, ast::FnExpr, ast::CallExpr,
   ast::VTypes => ast::ValueType
hof_lam_arg_type = cg, e, fd, lam, outer, lam_hints =>
   e
      [Var w]
         m = param_index(lam.params, w, 0)
         m !< 0 && m < ?lam_hints
            | lam_hints(m) | _ | ast::ValueType(Int)
            | hof_arg_type(cg, e, fd, outer)
      | infer_expr_type(cg, e)

// An inner-call arg's type: a Var naming one of the callee's params maps to
// the OUTER call's arg at that index; anything else infers directly.
hof_arg_type: types::Cg, ast::Expr, types::FnDef, ast::CallExpr => ast::ValueType
hof_arg_type = cg, e, fd, outer =>
   e
      [Var w]
         m = param_index(fd.params, w, 0)
         (m !< 0 && m < ?outer.args)
            | infer_expr_type(cg, outer.args(m)!!)
            | infer_expr_type(cg, e)
      | infer_expr_type(cg, e)

param_index: ast::Names, String, Int => Int
param_index = params, w, at =>
   at == ?params
      | -1
      |
         (params(at)!! == w)
            | at
            | param_index(params, w, at + 1)

fndef_of: types::FnDefs, String, Int => types::FnDef
fndef_of = fns, name, i =>
   fndef_of_rev(fns, name, ?fns - 1)

fndef_of_rev: types::FnDefs, String, Int => types::FnDef
fndef_of_rev = fns, name, i =>
   i < 0
      | empty_fndef
      |
         fd = fns(i)!!
         fd.name == name
            | fd
            | fndef_of_rev(fns, name, i - 1)


infer_call_expr_type: types::Cg, ast::CallExpr => (ast::ValueType, ast::TypeInfo)
infer_call_expr_type = cg, c =>
   c.fn_name == "" && !expr::call_has_target(c)
      |
         (ast::ValueType(Unknown),
            ast::TypeInfo(Prim, ast::ValueType(Unknown)))
      |
         rf = types::resolve_fn_name(cg, c.fn_name)
         sig_ret = fn_signature_return(cg, types::g.pstmts, rf, 0)
         sig_ret != ast::ValueType(Unknown)
            | (sig_ret, fn_signature_return_ti(cg, types::g.pstmts, rf, 0))
            |
               types::fninfo_index(cg, rf)
                  | fidx =>
                     fi = cg.fninfos(fidx)!!
                     (fi.ret_vt, ast::TypeInfo(Prim, fi.ret_vt))
                  |
                     is_ut = types::is_user_type(cg, c.fn_name)
                     is_ut
                        |
                           ti = types::typedef_ti(cg, c.fn_name)
                           (types::vt_from_ti(ti), ti)
                        |
                           tn = types::type_name_to_vt(c.fn_name)
                           tn.1
                              | (tn.0, ast::TypeInfo(Prim, tn.0))
                              |
                                 vname = c.fn_name != "" | c.fn_name |
                                    (c.fn_target [Var tv] tv | "")
                                 vt = vname != "" | types::var_type(cg, vname) |
                                    ast::ValueType(Unknown)
                                 vt
                                    [Str]
                                       is_range = ?c.args > 0 &&
                                          (c.args(0) [Range _])
                                       is_range
                                          | (ast::ValueType(Str),
                                             ast::TypeInfo(Prim,
                                                ast::ValueType(Str)))
                                          | (ast::ValueType(Rune),
                                             ast::TypeInfo(Prim,
                                                ast::ValueType(Rune)))
                                    [Array]
                                       elem_vt' = main::array_elem_vt(cg, vname)
                                       (elem_vt',
                                          ast::TypeInfo(Prim, elem_vt'))
                                    [Slice]
                                       elem_vt' = runtime::slice_elem_vt(cg, vname)
                                       (elem_vt',
                                          ast::TypeInfo(Prim, elem_vt'))
                                    |
                                       (ast::ValueType(Unknown),
                                          ast::TypeInfo(Prim,
                                             ast::ValueType(Unknown)))

infer_member_type: types::Cg, ast::MemberExpr => (ast::ValueType, ast::TypeInfo)
infer_member_type = cg, m =>
   m.is_module_access
      |
         tname = match::module_member_name(m.target)
         name = tname + "::" + m.field_name
         sig_ret = fn_signature_return(cg, types::g.pstmts, name, 0)
         sig_ret != ast::ValueType(Unknown)
            | (sig_ret, fn_signature_return_ti(cg, types::g.pstmts, name, 0))
            |
               vt = types::var_type(cg, name)
               (vt, ast::TypeInfo(Prim, vt))
      |
         vname = m.target [Var v] v | ""
         vname != ""
            |
               fnames0 = types::var_fnames(cg, vname)
               fvts0 = match::var_fvts(cg, vname)
               dt = types::var_dtype(cg, vname)
               ti = dt != "" && types::is_user_type(cg, dt) | types::typedef_ti(cg, dt) |
                  ast::TypeInfo(Prim, ast::ValueType(Unknown))
               fnames = ?fnames0 > 0 | fnames0 |
                  (types::td_record_meta_by_name(cg, dt) | rm => rm.1 | ast::Names())
               fvts = ?fvts0 > 0 | fvts0 | types::field_vts(cg, ti)
               types::member_static_index(cg, m, fnames)
                  | idx =>
                     idx < ?fvts
                        |
                           fvt = (fvts(idx) | _ | ast::ValueType(Unknown))
                           (fvt, ast::TypeInfo(Prim, fvt))
                        | (ast::ValueType(Unknown),
                           ast::TypeInfo(Prim, ast::ValueType(Unknown)))
                  | (ast::ValueType(Unknown),
                     ast::TypeInfo(Prim, ast::ValueType(Unknown)))
            | (ast::ValueType(Unknown),
               ast::TypeInfo(Prim, ast::ValueType(Unknown)))

// A type-only inference over an expression (for the signature pre-pass).
infer_expr_type: types::Cg, ast::Expr => ast::ValueType
infer_expr_type = cg, e =>
   e
      [Int n] ast::ValueType(Int)
      [Float f] ast::ValueType(Float)
      [Str s] ast::ValueType(Str)
      [Var v] types::var_type(cg, v)
      [Call c] infer_call_expr_type(cg, c).0
      [Member m] infer_member_type(cg, m).0
      [Bin t]
         t.0
            [Add, Sub, Mul, Div, Mod]
               (expr::e_str_lit(t.1) || expr::e_str_lit(t.2))
                  | ast::ValueType(Str)
                  | ((expr::e_flt_lit(t.1) || expr::e_flt_lit(t.2)) | ast::ValueType(Float) | ast::ValueType(Int))
            | ast::ValueType(Int)
      | ast::ValueType(Unknown)

codegen_typed_eval_block_step: types::Cg, tast::TypedExprs, Int, Int => (Addr, ast::ValueType)
codegen_typed_eval_block_step = cg, exprs, i, n =>
   i == n
      | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))
      |
         te = exprs(i) | _ | tast::mk_lit_unit(0, 0)
         v = main::codegen_typed_eval(cg, te)
         i == n - 1
            | v
            | codegen_typed_eval_block_step(cg, exprs, i + 1, n)

tast_bin_has_arena_alloc: types::Cg, ast::BinaryOp, tast::TypedExpr,
   tast::TypedExpr, Int => <>
tast_bin_has_arena_alloc = cg, op, lhs, rhs, depth =>
   is_add = op [Add]
   lvt = types::vt_from_ti(lhs.ti)
   rvt = types::vt_from_ti(rhs.ti)
   is_cat = is_add &&
      (types::is_str_vt(lvt) || types::is_str_vt(rvt) || types::is_builder_vt(lvt))
   is_cat || tast_expr_has_arena_alloc_d(cg, lhs, depth) ||
      tast_expr_has_arena_alloc_d(cg, rhs, depth)

tast_expr_has_arena_alloc_d: types::Cg, tast::TypedExpr, Int => <>
tast_expr_has_arena_alloc_d = cg, te, depth =>
   te.kind
      [Record, MapLiteral, BuilderNew, Copy, Lambda, Spawn] <+>
      [Bin b]
         tast_bin_has_arena_alloc(cg, b.0, b.1, b.2, depth)
      [Call c]
         types::is_user_type(cg, c.0) ||
            (depth < 3 && expr::fn_has_arena_alloc(cg, c.0, depth + 1)) ||
            tast_exprs_has_arena_alloc_d(cg, c.2, 0, depth)
      [Choice c]
         tast_expr_has_arena_alloc_d(cg, c.0, depth) ||
            tast_branches_has_arena_alloc_d(cg, c.1, 0, depth)
      [Block exprs]
         tast_exprs_has_arena_alloc_d(cg, exprs, 0, depth)
      [Cycle c]
         tast_expr_has_arena_alloc_d(cg, c.0, depth) ||
            tast_expr_has_arena_alloc_d(cg, c.1, depth)
      [Assign a]
         tast_expr_has_arena_alloc_d(cg, a.5, depth)
      [Unary u]
         tast_expr_has_arena_alloc_d(cg, u.1, depth)
      [Member m]
         tast_expr_has_arena_alloc_d(cg, m.0, depth)
      | <->

tast_exprs_has_arena_alloc_d: types::Cg, tast::TypedExprs, Int, Int => <>
tast_exprs_has_arena_alloc_d = cg, es, at, depth =>
   at == ?es
      | <->
      |
         te = es(at) | _ | tast::mk_lit_unit(0, 0)
         tast_expr_has_arena_alloc_d(cg, te, depth) ||
            tast_exprs_has_arena_alloc_d(cg, es, at + 1, depth)

tast_branches_has_arena_alloc_d: types::Cg, tast::TypedBranches, Int,
   Int => <>
tast_branches_has_arena_alloc_d = cg, bs, at, depth =>
   at == ?bs
      | <->
      |
         br = bs(at)!!
         tast_expr_has_arena_alloc_d(cg, br.body, depth) ||
            tast_branches_has_arena_alloc_d(cg, bs, at + 1, depth)

typed_block_is_binding: tast::TypedExprs => <>
typed_block_is_binding = exprs =>
   nb = ?exprs
   nb > 1
      |
         last = exprs(nb - 1) | _ | tast::mk_lit_unit(0, 0)
         last.kind
            [Record r]
               ?r == 2
                  |
                     dflt = tast::TypedField(("", tast::mk_lit_unit(0, 0),
                        0, unify::UType(None)))
                     f0 = r(0) | _ | dflt
                     f1 = r(1) | _ | dflt
                     f0.name == "get" && f1.name == "set"
                  | <->
            | <->
      | <->

codegen_typed_eval_block: types::Cg, tast::TypedExprs => (Addr, ast::ValueType)
codegen_typed_eval_block = cg, exprs =>
   has_alloc = tast_exprs_has_arena_alloc_d(cg, exprs, 0, 0) && !cg.in_fn &&
      !typed_block_is_binding(exprs)
   mark = expr::codegen_block_arena_mark(cg, has_alloc)
   expr::codegen_restore_scope_enter(cg, has_alloc)
   last = codegen_typed_eval_block_step(cg, exprs, 0, ?exprs)
   expr::codegen_restore_scope_leave(cg, mark)
   has_alloc && types::is_ptr_vt(last.1)
      |
         types::init_error(cg, "E3133", "Cannot return Addr from an arena-restore " +
            "scope. Copy data explicitly with '++' before boundary.", 0, 0)
         (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      | last

codegen_typed_eval_fwd: types::Cg, String, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_fwd = cg, name, ti =>
   bf_opt = types::ti_get_bitfield(cg, ti)
   vt0 = types::vt_from_ti_cg(cg, ti)
   vt_bf = bf_opt | b => b.backing_type | vt0
   vt = <>(bf_opt) | vt_bf | vt0
   rec_m = runtime::record_meta_from_ti(cg, ti)
   lt = types::is_unboxed_ram_ti(cg, ti)
      | match::unboxed_ram_struct_t(cg)
      |
         <>(bf_opt)
            | types::llvm_type_of_vt(vt)
            |
               (types::is_record_vt(vt) || types::is_ptrish_vt(vt))
                  | LLVMPointerType(LLVMInt8Type!, 0)
                  | types::llvm_type_of_vt(vt)
   is_glob_fwd = types::has_str(types::g.marked_globals, name)
   is_loc_fwd = !is_glob_fwd && cg.in_fn
   has_slot_fwd = <>(types::var_slot(cg, name))
   fresh_fwd = !has_slot_fwd
   slot = fresh_fwd
      | types::create_slot(cg, name, lt, is_loc_fwd)
      |
         types::var_slot(cg, name)
            | s => s
            | types::create_slot(cg, name, lt, is_loc_fwd)
   is_arr = vt [Array]
   is_arr
      |
         i8p = LLVMPointerType(LLVMInt8Type!, 0)
         LLVMBuildStore(cg.builder, LLVMConstNull(i8p), slot)
   bf_opt
      | bfi =>
         LLVMBuildStore(cg.builder, LLVMConstInt(lt, 0, 0), slot)
         types::init_mark_whole(cg, name)
   dt0 = ti [TypeVar tv] tv | ""
   dt' = dt0
   ti [Array _]
      |
         anon_dt = "#arr_" + name
         !types::has_type_name(cg, anon_dt) |
            runtime::add_type(cg, anon_dt, ti)
         dt' = anon_dt
   rec_m0_opt = rec_m | m => <+ m.0 -> | <-->
   rec_m1 = rec_m | m => m.1 | ast::Names()
   cg.vars += types::CgVar((name, vt, types::is_ptrish_vt(vt), dt', rec_m0_opt,
      rec_m1, <+ slot ->, is_loc_fwd, <+>, types::field_vts(cg, ti), <-->))
   (LLVMConstInt(LLVMInt64Type!, 0, 0), vt)

tast_is_addr_arg_scoped: types::Cg, tast::TypedExpr, Int => <>
tast_is_addr_arg_scoped = cg, arg, threshold =>
   arg.kind
      [LitInt _] <->
      [LitRune _] <->
      | tast_is_block_scoped_addr(cg, arg, threshold)

tast_is_block_scoped_addr: types::Cg, tast::TypedExpr, Int => <>
tast_is_block_scoped_addr = cg, expr, threshold =>
   expr.kind
      [Var v]
         idx = expr::var_index(cg, v.0)
         idx !< threshold
      [Unary u]
         u.0
            [AddrOf] <+>
            | tast_is_block_scoped_addr(cg, u.1, threshold)
      [Bin b]
         tast_is_block_scoped_addr(cg, b.1, threshold) ||
            tast_is_block_scoped_addr(cg, b.2, threshold)
      [Block _] <+>
      [RawMemory _] <+>
      [Call c]
         c.0 == "Addr"
            | ?c.2 > 0
               | tast_is_addr_arg_scoped(cg, c.2(0)!!, threshold)
               | <->
            | <+>
      | <->

codegen_typed_check_addr_escape: types::Cg, String, tast::TypedExpr,
   ast::TypeInfo => ()
codegen_typed_check_addr_escape = cg, name, val, ti =>
   cg.in_restore_scope > 0 && ?types::g.restore_scope_var_starts > 0
      |
         threshold = types::g.restore_scope_var_starts(?types::g.restore_scope_var_starts - 1)!!
         tgt_idx = expr::var_index(cg, name)
         is_outer = (tgt_idx !< 0 && tgt_idx < threshold) ||
            types::has_str(types::g.marked_globals, name)
         is_outer
            |
               target_vt = types::var_type(cg, name)
               is_addr = types::is_ptr_vt(target_vt) ||
                  (val.ti [Prim vt] types::is_ptr_vt(vt) | <->)
               is_addr && tast_is_block_scoped_addr(cg, val, threshold)
                  | types::init_error(cg, "E3134", "Assignment of block-scoped Addr " +
                     "to outer-scope binding escapes arena lifecycle.", 0, 0)

codegen_typed_eval_assign: types::Cg, String, <>, <>, <>, <>, tast::TypedExpr,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_assign = cg, name, mut, cmp, glob, len, val, ti =>
   is_fwd = val.kind [Var v] (v.0 == "<fwd>") | <->
   is_fwd
      | codegen_typed_eval_fwd(cg, name, ti)
      |
         is_glob = glob || types::has_str(types::g.marked_globals, name)
         has_slot = <>(types::var_slot(cg, name))
         has_existing = is_glob | has_slot |
            (cg.in_fn | types::has_local_var(cg, name) | has_slot)
         is_fresh = !cmp && !has_existing
         !is_fresh | codegen_typed_check_addr_escape(cg, name, val, ti)
         target_vt = is_fresh | ast::ValueType(Unknown) | types::var_type(cg, name)
         target_is_arr = target_vt [Array]
         target_is_bld = target_vt [Builder]
         is_coll_append = target_is_arr || target_is_bld
         is_lam_def = !is_coll_append && (val.kind [Lambda _])
         is_lam_def
            |
               rname = types::resolve_fn_name(cg, name)
               fidx0 = types::fninfo_index(cg, rname)
               fidx = <>(fidx0) | fidx0 | types::fninfo_index(cg, name)
               lr = fidx
                  | idx =>
                     fi = cg.fninfos(idx)!!
                     (expr::noncap_closure(cg, name, fi.llvm_fn!!), name)
                  |
                     lam = val.kind [Lambda l] l |
                        (ast::Names(), tast::mk_lit_unit(0, 0),
                           tast::TypedCaptures())
                     fn_ti = ti [Fn _] ti | val.ti
                     codegen_typed_compile_fn(cg, name, lam.0, lam.1, fn_ti)
               cg.last_closure_fn = lr.1
               slot' = is_fresh
                  | types::create_slot(cg, name,
                     types::llvm_type_of_vt(ast::ValueType(Fn)), cg.in_fn)
                  |
                     types::var_slot(cg, name)
                        | s => s
                        | types::create_slot(cg, name,
                           types::llvm_type_of_vt(ast::ValueType(Fn)), cg.in_fn)
               LLVMBuildStore(cg.builder, lr.0, slot')
               cg.vars += types::CgVar((name, ast::ValueType(Fn), <->, "", <-->,
                  ast::Names(), <+ slot' ->, cg.in_fn, <->, ast::VTypes(), <-->))
               cg.closure_vars += name
               cg.closure_tgts += lr.1
               (lr.0, ast::ValueType(Fn))
            |
               cg.last_type = ""
               cg.last_rt = <-->
               cg.last_fnames = ast::Names()
               cg.last_fvts = ast::VTypes()
               ev = main::codegen_typed_eval(cg, val)
               len
                  |
                     b_val' = types::ptr_var_value(cg, name, "b.load")
                     main::builder_set_len_checked(cg, b_val', ev.0, name)
                     (b_val', ast::ValueType(Builder))
                  |
                     decl_vt = types::vt_from_ti_cg(cg, ti)
                     vt = decl_vt [Unit, Unknown] ev.1 | decl_vt
                     eff_ti = ti
                        [Prim p]
                           p [Unknown, Unit] val.ti | ti
                        | ti
                     is_sp = val.kind [Spawn _]
                     i8p = LLVMPointerType(LLVMInt8Type!, 0)
                     llvm_ty = is_sp
                        | i8p
                        |
                           types::is_unboxed_ram_ti(cg, eff_ti)
                              | match::unboxed_ram_struct_t(cg)
                              | types::llvm_type_of_vt(vt)
                     is_loc = !is_glob && cg.in_fn
                     slot' = is_fresh
                        | types::create_slot(cg, name, llvm_ty, is_loc)
                        |
                           types::var_slot(cg, name)
                              | s => s
                              | types::create_slot(cg, name, llvm_ty, is_loc)
                     is_b_tgt = types::var_type(cg, name) [Builder]
                     val_is_b = ev.1 [Builder]
                     is_b_append = !is_fresh && is_b_tgt && (cmp || !val_is_b)
                     is_a_tgt = types::var_type(cg, name) [Array]
                     val_is_a = ev.1 [Array]
                     is_a_append = !is_fresh && is_a_tgt && (cmp || !val_is_a)
                     is_b_append
                        |
                           b_val' = types::ptr_var_value(cg, name, "b.load")
                           expr::codegen_typed_builder_append(cg, b_val', val)
                           (b_val', ast::ValueType(Builder))
                        |
                           is_a_append
                              |
                                 a_val = main::codegen_array_var_value(cg, name,
                                    "a.load")
                                 main::codegen_array_append(cg, a_val, ev.0)
                              |
                                 store_val = types::llvm_val_opt(ev.0)
                                    | evv => evv
                                    | LLVMConstNull(llvm_ty)
                                 LLVMBuildStore(cg.builder, store_val,
                                    slot')
                                 rec_fvs = ast::VTypes()
                                 ti_r = val.ti [Rec r] r.0 |
                                    (ti [Rec r2] r2.0 | ast::FieldTypes())
                                 ?ti_r @ fi =>
                                    rec_fvs += types::vt_from_ti(ti_r(fi)!!.rec_type)
                                 is_sp_var = val.kind [Spawn _]
                                 i1_ty = LLVMInt1Type!
                                 is_h_ram = types::is_ram_vt(ev.1) &&
                                    LLVMTypeOf(ev.0) != i1_ty
                                 is_heap_var = is_sp_var || is_h_ram
                                 is_rec = types::is_record_vt(vt) ||
                                    types::is_record_vt(ev.1)
                                 keep_dt = is_heap_var || is_rec ||
                                    types::is_array_vt(vt) || types::is_map_vt(vt) ||
                                    types::is_slice_vt(vt) || (vt [Fn])
                                 ti_dt0 = val.ti [TypeVar tv] tv | ""
                                 ti_dt1 = ti [TypeVar tv2] tv2 | ""
                                 ti_dt = ti_dt0 != "" | ti_dt0 | ti_dt1
                                 final_dt = ti_dt != ""
                                    | ti_dt
                                    | (keep_dt | cg.last_type | "")
                                 rm_eff0 = runtime::record_meta_from_ti(cg, eff_ti)
                                 rm_eff1 = <>(rm_eff0) | rm_eff0 |
                                    runtime::record_meta_from_ti(cg, val.ti)
                                 rm_td = final_dt != ""
                                    | types::td_record_meta_by_name(cg, final_dt)
                                    | <-->
                                 rm_eff = <>(rm_eff1)
                                    | rm_eff1
                                    | rm_td
                                 rt_cand = rm_eff | m => <+ m.0 -> | cg.last_rt
                                 final_rt_opt = is_rec | rt_cand | <-->
                                 rm_eff_fn = rm_eff | m => m.1 | ast::Names()
                                 fn_cand = ?rm_eff_fn > 0
                                    | rm_eff_fn
                                    | cg.last_fnames
                                 final_fnames = is_rec
                                    | fn_cand
                                    | ast::Names()
                                 fvt_fb = is_rec
                                    | cg.last_fvts
                                    | ast::VTypes()
                                 final_fvts = ?rec_fvs > 0
                                    | rec_fvs
                                    | fvt_fb
                                 is_fresh
                                    |
                                       cg.vars += types::CgVar((name, vt, is_heap_var,
                                          final_dt, final_rt_opt, final_fnames,
                                          <+ slot' ->, cg.in_fn && !is_glob, <->,
                                          final_fvts, <-->))
                                 is_fn_res = (vt [Fn]) || (ev.1 [Fn])
                                 is_fn_res && (cg.last_closure_fn != "")
                                    |
                                       cg.closure_vars += name
                                       cg.closure_tgts += cg.last_closure_fn
                     (ev.0, vt)

try_compile_typed_assign: types::Cg, String, tast::TypedExpr, ast::TypeInfo, String,
   String => <>
try_compile_typed_assign = cg, tname, val_e, ti, rname, fname =>
   cg.opts.is_module && types::is_external_module_name(cg, tname)
      | <->
      |
         is_match = tname != "" && (tname == rname || tname == fname ||
            types::resolve_fn_name(cg, tname) == rname ||
            types::decl_bare_name(tname, 0) == fname)
         is_lam = val_e.kind [Lambda _]
         is_match && is_lam
            |
               lam = val_e.kind [Lambda l] l |
                  (ast::Names(), tast::mk_lit_unit(0, 0), tast::TypedCaptures())
               fn_ti = ti [Fn _] ti | val_e.ti
               codegen_typed_compile_fn(cg, tname, lam.0, lam.1, fn_ti)
               <+>
            | <->

find_and_compile_typed_fn: types::Cg, String, String, Int, Int => <>
find_and_compile_typed_fn = cg, rname, fname, i, n =>
   i == n
      | <->
      |
         st = types::g.typed_program_stmts(i) | _ | tast::TypedStmt(Expr,
            tast::mk_lit_unit(0, 0))
         res = st
            [Expr te]
               te.kind
                  [Assign a]
                     try_compile_typed_assign(cg, a.0, a.5, te.ti,
                        rname, fname)
                  | <->
            [Binding b]
               try_compile_typed_assign(cg, b.0, b.2, b.1, rname, fname)
            [GlobalBinding gb]
               try_compile_typed_assign(cg, gb.0, gb.2, gb.1, rname, fname)
            | <->
         res
            | <+>
            | find_and_compile_typed_fn(cg, rname, fname, i + 1, n)

declare_external_fn: types::Cg, String => <>
declare_external_fn = cg, name =>
   types::fninfo_index(cg, name)
      | _ => <+>
      |
         declared = fn_has_signature(types::g.pstmts, name, 0)
         !declared
            | <->
            |
               sig_param_types0 = fn_signature_param_types(cg, types::g.pstmts, name, 0)
               sig_param_tis = fn_signature_param_tis(types::g.pstmts, name)
               sig_param_types = resolve_sig_param_types(cg, sig_param_types0, sig_param_tis)
               sig_ret_vt0 = fn_signature_return(cg, types::g.pstmts, name, 0)
               sig_ret_ti = fn_signature_return_ti(cg, types::g.pstmts, name, 0)
               sig_ret_vt = resolve_sig_vt(cg, sig_ret_vt0, sig_ret_ti)
               nparams = ?sig_param_types
               param_ll = types::Addrs()
               nparams @ i =>
                  pvt_i = sig_param_types(i) | _ | ast::ValueType(Int)
                  pti_i = sig_param_tis(i) | _ | ast::TypeInfo(Prim, pvt_i)
                  param_ll += types::is_unboxed_ram_ti(cg, pti_i) | match::unboxed_ram_struct_t(cg) |
                     types::llvm_type_of_vt(pvt_i)
               ret_ll = types::is_unboxed_ram_ti(cg, sig_ret_ti)
                  | match::unboxed_ram_struct_t(cg)
                  |
                     sig_ret_vt [Unit] LLVMVoidType!
                     | types::llvm_type_of_vt(sig_ret_vt)
               fty = fn_type_n(cg, ret_ll, param_ll, nparams)
               ext_fn = types::llvm_find_function(cg.module, name)
                  | f => f
                  |
                     fn_new = LLVMAddFunction(cg.module, name, fty)
                     LLVMSetLinkage(fn_new, 0)
                     runtime::mark_nounwind(cg, fn_new)
                     fn_new
               cg.fninfos += types::FnInfo((name, <+ ext_fn ->, <+ fty ->, nparams,
                  sig_param_types, sig_ret_vt, <+>, <->, <+>, <+>))
               <+>

compile_typed_fn_lazy: types::Cg, String => <>
compile_typed_fn_lazy = cg, name =>
   rname = types::resolve_fn_name(cg, name)
   cg.opts.is_module && types::is_external_module_name(cg, rname)
      | <->
      |
         has_fn = <>(types::fninfo_index(cg, rname)) || <>(types::fninfo_index(cg, name))
         has_fn
            | <+>
            | find_and_compile_typed_fn(cg, rname, name, 0, ?types::g.typed_program_stmts)

codegen_typed_cycle_escape_construct: types::Cg, <>, <tast::TypedExpr|>, ast::TypeInfo => Addr
codegen_typed_cycle_escape_construct = cg, is_pos, pay_opt, ti =>
   niche = types::is_niche_ram_ti(cg, ti)
   niche.0
      | (match::codegen_niche_ram_construct(cg, is_pos, niche.1, pay_opt)).0
      |
         tid = is_pos | 1 | 3
         alloc_nm = is_pos | "cycle.some.alloc" | "cycle.none.alloc"
         match::codegen_typed_build_union(cg, tid, pay_opt, alloc_nm)

codegen_typed_eval_condition_cycle: types::Cg, tast::TypedExpr, tast::TypedExpr,
   <tast::TypedExpr|>, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_condition_cycle = cg, iterable, body_fn, esc_opt, ti =>
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   header = LLVMAppendBasicBlock(cg.current_fn, "loop.header." + sc)
   body = LLVMAppendBasicBlock(cg.current_fn, "loop.body." + sc)
   latch = LLVMAppendBasicBlock(cg.current_fn, "loop.latch." + sc)
   done = LLVMAppendBasicBlock(cg.current_fn, "loop.exit." + sc)
   has_esc = <>(esc_opt)
   b_vt = has_esc | types::vt_from_ti(ti) | ast::ValueType(Unit)
   res_lt = types::llvm_type_of_vt(b_vt)
   esc_blocks = esc_opt
      | _ =>
         b_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.branch." + sc)
         m_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.merge." + sc)
         r_al = types::hoisted_alloca(cg, res_lt, "escape.res." + sc)
         u_none = codegen_typed_cycle_escape_construct(cg, <->, <-->, ti)
         LLVMBuildStore(cg.builder, u_none, r_al)
         <+ (b_bb, m_bb, r_al) ->
      | <-->
   break_target = esc_blocks | eb => eb.0 | done
   cg.cycle_breaks += break_target
   cg.cycle_conts += latch
   branch_to(cg, header)
   LLVMPositionBuilderAtEnd(cg.builder, header)
   cv = main::codegen_typed_eval(cg, iterable)
   cval = types::codegen_cond_value_with_ti(cg, cv.0, cv.1, iterable.ti)
   LLVMBuildCondBr(cg.builder, cval, body, done)
   LLVMPositionBuilderAtEnd(cg.builder, body)
   main::codegen_typed_eval(cg, body_fn)
   branch_to(cg, latch)
   LLVMPositionBuilderAtEnd(cg.builder, latch)
   branch_to(cg, header)
   nb = ?cg.cycle_breaks
   cg.cycle_breaks = cycle_trunc(cg.cycle_breaks, nb - 1)
   nc = ?cg.cycle_conts
   cg.cycle_conts = cycle_trunc(cg.cycle_conts, nc - 1)
   esc_blocks
      | eb =>
         branch_to(cg, eb.1)
         LLVMPositionBuilderAtEnd(cg.builder, eb.0)
         esc_e = esc_opt!!
         saved_esc_vars = ?cg.vars
         u_some = codegen_typed_cycle_escape_construct(cg, <+>,
            <+ esc_e ->, ti)
         cg.vars = truncate_vars(cg.vars, saved_esc_vars)
         LLVMBuildStore(cg.builder, u_some, eb.2)
         branch_to(cg, eb.1)
         LLVMPositionBuilderAtEnd(cg.builder, eb.1)
         res_val = LLVMBuildLoad2(cg.builder, res_lt, eb.2,
            "escape.res")
         (res_val, b_vt)
      |
         LLVMPositionBuilderAtEnd(cg.builder, done)
         (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))

codegen_typed_eval_cycle: types::Cg, tast::TypedExpr, tast::TypedExpr,
   <tast::TypedExpr|>, <>, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_cycle = cg, iterable, body_fn, esc_opt, is_rune, ti =>
   is_flag = iterable.ti [Prim p] (p [Flag]) | <->
   is_ram = iterable.ti [Ram _]
   is_cond = is_flag || is_ram
   is_cond
      | codegen_typed_eval_condition_cycle(cg, iterable, body_fn, esc_opt, ti)
      |
         is_map = iterable.ti [Map _]
         is_map
            | codegen_typed_eval_map_cycle(cg, iterable, body_fn, esc_opt, ti)
            |
               codegen_typed_eval_indexed_cycle(cg, iterable, body_fn,
                  esc_opt, is_rune, ti)

codegen_typed_eval_indexed_cycle: types::Cg, tast::TypedExpr, tast::TypedExpr,
   <tast::TypedExpr|>, <>, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_indexed_cycle = cg, iterable, bfn, esc_opt, is_rune, ti =>
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   i64t = LLVMInt64Type!
   iter_info = iterable.kind
      [Bin b]
         is_seq = b.0 [Seq]
         is_seq
            |
               sv = main::codegen_typed_eval(cg, b.1)
               sv64 = coerce_int(cg, sv.0, i64t)
               is_unb = b.2.kind [LitUnit]
               ev_opt = is_unb
                  | <-->
                  |
                     ev' = main::codegen_typed_eval(cg, b.2)
                     <+ coerce_int(cg, ev'.0, i64t) ->
               is_r = types::is_rune_vt(sv.1) ||
                  types::is_rune_vt(types::vt_from_ti_cg(cg, iterable.ti))
               rng_vt = is_r | ast::ValueType(Rune) | ast::ValueType(Int)
               (sv64, ev_opt, <--> , 0, rng_vt)
            |
               iv' = expr::codegen_typed_eval_bin(cg, b.0, b.1, b.2, iterable.ut,
                  iterable.ti)
               (LLVMConstInt(i64t, 0, 0), <+ iv'.0 ->, <--> , 0,
                  ast::ValueType(Int))
      |
         iv' = main::codegen_typed_eval(cg, iterable)
         is_str = iv'.1 [Str]
         is_arr = iv'.1 [Array]
         is_sl = iv'.1 [Slice]
         is_rec = iv'.1 [Record]
         is_str
            |
               slen = expr::codegen_string_len(cg, iv'.0, "str.len")
               sdata = expr::codegen_string_data(cg, iv'.0, "s.read.data")
               iter_m = is_rune | 5 | 1
               str_vt = is_rune | ast::ValueType(Rune) | ast::ValueType(Int)
               (LLVMConstInt(i64t, 0, 0), <+ slen ->, <+ sdata ->, iter_m, str_vt)
            |
               is_arr
                  |
                     alen = main::builder_len(cg, iv'.0, "arr.cycle.len")
                     adata = main::builder_data(cg, iv'.0, "arr.cycle.data")
                     a_elem_vt = iterable.ti [Array a] a.0 |
                        ast::ValueType(Int)
                     (LLVMConstInt(i64t, 0, 0), <+ alen ->, <+ adata ->, 2,
                        a_elem_vt)
                  |
                     is_sl
                        |
                           sl_len = main::slice_len(cg, iv'.0, "sl.len")
                           sl_data = main::slice_data(cg, iv'.0, "sl.data")
                           sl_elem_vt = iterable.ti [Rec r] r.3 |
                              ast::ValueType(Int)
                           (LLVMConstInt(i64t, 0, 0), <+ sl_len ->, <+ sl_data ->, 3,
                              sl_elem_vt)
                        |
                           is_rec
                              |
                                 v_name = iterable.kind [Var v] v.0 | ""
                                 r_flds0 = iterable.ti [Rec r] r.0 |
                                    ast::FieldTypes()
                                 fvs = v_name != "" | match::var_fvts(cg, v_name) |
                                    ast::VTypes()
                                 n_flds = ?r_flds0 > 0 | ?r_flds0 | ?fvs
                                 rc = LLVMConstInt(i64t, n_flds, 0)
                                 def_vt = ast::ValueType(Int)
                                 fvs0 = ?fvs > 0 | fvs(0)!! | def_vt
                                 r_elem_vt = ?r_flds0 > 0
                                    | types::vt_from_ti(r_flds0(0)!!.rec_type)
                                    | fvs0
                                 (LLVMConstInt(i64t, 0, 0), <+ rc ->, <+ iv'.0 ->, 4,
                                    r_elem_vt)
                              |
                                 (LLVMConstInt(i64t, 0, 0), <+ iv'.0 ->,
                                    <-->, 0, ast::ValueType(Int))
   start_val = iter_info.0
   end_val_opt = iter_info.1
   s_data_opt = iter_info.2
   iter_mode = iter_info.3
   elem_vt = iter_info.4
   elem_ty = types::llvm_type_of_vt(elem_vt)
   counter_alloca = types::hoisted_alloca(cg, i64t, "loop.idx." + sc)
   LLVMBuildStore(cg.builder, start_val, counter_alloca)
   step_alloca = types::hoisted_alloca(cg, i64t, "loop.step." + sc)
   p0 = bfn.kind
      [Lambda lam]
         ?lam.0 > 0 | (lam.0(0) | _ | "") | ""
      | ""
   p1 = bfn.kind
      [Lambda lam]
         ?lam.0 > 1 | (lam.0(1) | _ | "") | ""
      | ""
   p0 != "" && p0 != "_"
      |
         has_s0 = <>(types::var_slot(cg, p0))
         !has_s0
            |
               s0 = types::create_slot(cg, p0, elem_ty, cg.in_fn)
               r_flds0 = iterable.ti [Rec r] r.0 | ast::FieldTypes()
               elem_ti0 = ?r_flds0 > 0 | r_flds0(0)!!.rec_type |
                  ast::TypeInfo(Prim, elem_vt)
               elem_is_rec0 = elem_vt [Record]
               elem_rm0 = elem_is_rec0
                  | runtime::record_meta_from_ti(cg, elem_ti0)
                  | <-->
               elem_rm0_opt = elem_rm0 | m => <+ m.0 -> | <-->
               elem_rm0_fn = elem_rm0 | m => m.1 | ast::Names()
               cg.vars += types::CgVar((p0, elem_vt, types::is_ptrish_vt(elem_vt), "",
                  elem_rm0_opt, elem_rm0_fn, <+ s0 ->, cg.in_fn, <->,
                  ast::VTypes(), <-->))
   p1 != "" && p1 != "_"
      |
         has_s1 = <>(types::var_slot(cg, p1))
         !has_s1
            |
               s1 = types::create_slot(cg, p1, i64t, cg.in_fn)
               LLVMBuildStore(cg.builder, start_val, s1)
               cg.vars += types::CgVar((p1, ast::ValueType(Int), <->, "",
                  <-->, ast::Names(), <+ s1 ->, cg.in_fn, <->,
                  ast::VTypes(), <-->))
   header = LLVMAppendBasicBlock(cg.current_fn, "loop.header." + sc)
   body = LLVMAppendBasicBlock(cg.current_fn, "loop.body." + sc)
   exit_nat = LLVMAppendBasicBlock(cg.current_fn, "loop.exit.nat." + sc)
   latch = LLVMAppendBasicBlock(cg.current_fn, "loop.latch." + sc)
   done = LLVMAppendBasicBlock(cg.current_fn, "loop.exit." + sc)
   has_esc = <>(esc_opt)
   b_vt = has_esc | types::vt_from_ti(ti) | ast::ValueType(Unit)
   res_lt = types::llvm_type_of_vt(b_vt)
   esc_blocks = esc_opt
      | _ =>
         b_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.branch." + sc)
         m_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.merge." + sc)
         r_al = types::hoisted_alloca(cg, res_lt, "escape.res." + sc)
         u_none = codegen_typed_cycle_escape_construct(cg, <->, <-->, ti)
         LLVMBuildStore(cg.builder, u_none, r_al)
         <+ (b_bb, m_bb, r_al) ->
      | <-->
   break_target = esc_blocks | eb => eb.0 | done
   cg.cycle_breaks += break_target
   cg.cycle_conts += latch
   branch_to(cg, header)
   LLVMPositionBuilderAtEnd(cg.builder, header)
   curr_i = LLVMBuildLoad2(cg.builder, i64t, counter_alloca,
      "counter.load")
   end_val_opt
      | end_val =>
         cond = LLVMBuildICmp(cg.builder, 40, curr_i, end_val,
            "loop.cond")
         LLVMBuildCondBr(cg.builder, cond, body, exit_nat)
      | branch_to(cg, body)
   LLVMPositionBuilderAtEnd(cg.builder, exit_nat)
   p1 != "" && p1 != "_"
      |
         types::var_slot(cg, p1)
            | s =>
               rel_end = LLVMBuildSub(cg.builder, curr_i, start_val,
                  "loop.rel.end")
               LLVMBuildStore(cg.builder, rel_end, s)
   branch_to(cg, done)
   LLVMPositionBuilderAtEnd(cg.builder, body)
   rel_i = LLVMBuildSub(cg.builder, curr_i, start_val, "loop.rel.i")
   r_dec_opt = iter_mode == 5
      | <+ codegen_decode_rune_at(cg, s_data_opt!!, curr_i) ->
      | <-->
   init_step_val = r_dec_opt
      | rd => rd.1
      | LLVMConstInt(i64t, 1, 0)
   LLVMBuildStore(cg.builder, init_step_val, step_alloca)
   elem_val = r_dec_opt
      | rd => rd.0
      |
         iter_mode == 1
            |
               byte_ptr = types::gep1(cg, LLVMInt8Type!, s_data_opt!!, curr_i,
                  "s.byte.gep")
               byte_val = LLVMBuildLoad2(cg.builder,
                  LLVMInt8Type!, byte_ptr, "s.byte")
               LLVMBuildZExt(cg.builder, byte_val, i64t, "s.byte.val")
            |
               iter_mode == 2
                  |
                     arr_slot = types::gep1(cg, i64t, s_data_opt!!, curr_i, "arr.elem.gep")
                     arr_raw = LLVMBuildLoad2(cg.builder, i64t,
                        arr_slot, "arr.elem.raw")
                     types::is_ptrish_vt(elem_vt)
                        | LLVMBuildIntToPtr(cg.builder, arr_raw, elem_ty,
                           "arr.elem.ptr")
                        |
                           types::is_float_vt(elem_vt)
                              | LLVMBuildBitCast(cg.builder, arr_raw,
                                 elem_ty, "arr.elem.flt")
                              | arr_raw
                  |
                     iter_mode == 3
                        |
                           typed_data = LLVMBuildPointerCast(cg.builder,
                              s_data_opt!!, LLVMPointerType(elem_ty, 0),
                              "sl.data.typed")
                           elem_slot = types::gep1(cg, elem_ty, typed_data, curr_i,
                              "sl.elem.gep")
                           LLVMBuildLoad2(cg.builder, elem_ty, elem_slot,
                              "sl.elem.val")
                        |
                           iter_mode == 4
                              |
                                 r_flds' = iterable.ti [Rec r] r.0 |
                                    ast::FieldTypes()
                                 elem_ti = ?r_flds' > 0
                                    | r_flds'(0)!!.rec_type
                                    | ast::TypeInfo(Prim, elem_vt)
                                 rm = runtime::record_meta_from_ti(cg, elem_ti)
                                 rec_elem_ll = rm | m => m.0 | elem_ty
                                 typed_rec = LLVMBuildPointerCast(
                                    cg.builder, s_data_opt!!,
                                    LLVMPointerType(rec_elem_ll, 0),
                                    "rec.typed")
                                 rec_slot = types::gep1(cg, rec_elem_ll, typed_rec,
                                    curr_i, "rec.elem.gep")
                                 is_rec_elem = elem_vt [Record]
                                 is_rec_elem
                                    | rec_slot
                                    |
                                       LLVMBuildLoad2(cg.builder,
                                          rec_elem_ll, rec_slot, "rec.elem.val")
                              | curr_i
   saved_body_vars = ?cg.vars
   eff_slot_i = types::var_slot(cg, "_i")
      | s => s
      |
         s_i = types::create_slot(cg, "_i", i64t, cg.in_fn)
         cg.vars += types::CgVar(("_i", ast::ValueType(Int), <->, "", <-->,
            ast::Names(), <+ s_i ->, cg.in_fn, <->, ast::VTypes(), <-->))
         s_i
   LLVMBuildStore(cg.builder, rel_i, eff_slot_i)
   eff_slot_u = types::var_slot(cg, "_")
      | s => s
      |
         s_u = types::create_slot(cg, "_", elem_ty, cg.in_fn)
         cg.vars += types::CgVar(("_", elem_vt, types::is_ptrish_vt(elem_vt), "", <-->,
            ast::Names(), <+ s_u ->, cg.in_fn, <->, ast::VTypes(), <+ elem_val ->))
         s_u
   c_elem_val = types::is_int_vt(elem_vt)
      | coerce_int(cg, elem_val, elem_ty)
      | elem_val
   LLVMBuildStore(cg.builder, c_elem_val, eff_slot_u)
   p0 != "" && p0 != "_"
      |
         types::var_slot(cg, p0)
            | s => LLVMBuildStore(cg.builder, c_elem_val, s)
   p1 != "" && p1 != "_"
      |
         types::var_slot(cg, p1)
            | s => LLVMBuildStore(cg.builder, rel_i, s)
   bfn.kind
      [Lambda lam]
         main::codegen_typed_eval(cg, lam.1)
      |
         main::codegen_typed_eval(cg, bfn)
   cg.vars = truncate_vars(cg.vars, saved_body_vars)
   branch_to(cg, latch)
   LLVMPositionBuilderAtEnd(cg.builder, latch)
   step_val = LLVMBuildLoad2(cg.builder, i64t, step_alloca, "step.val")
   next_i = LLVMBuildAdd(cg.builder, curr_i, step_val, "loop.next")
   LLVMBuildStore(cg.builder, next_i, counter_alloca)
   branch_to(cg, header)
   nb = ?cg.cycle_breaks
   cg.cycle_breaks = cycle_trunc(cg.cycle_breaks, nb - 1)
   cg.cycle_conts = cycle_trunc(cg.cycle_conts, nb - 1)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   esc_blocks
      | eb =>
         branch_to(cg, eb.1)
         LLVMPositionBuilderAtEnd(cg.builder, eb.0)
         esc_te = esc_opt!!
         saved_esc_vars = ?cg.vars
         u_some = codegen_typed_cycle_escape_construct(cg, <+>,
            <+ esc_te ->, ti)
         cg.vars = truncate_vars(cg.vars, saved_esc_vars)
         LLVMBuildStore(cg.builder, u_some, eb.2)
         branch_to(cg, eb.1)
         LLVMPositionBuilderAtEnd(cg.builder, eb.1)
         res_val = LLVMBuildLoad2(cg.builder, res_lt, eb.2,
            "escape.res")
         (res_val, b_vt)
      | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))

codegen_typed_eval_map_cycle: types::Cg, tast::TypedExpr, tast::TypedExpr,
   <tast::TypedExpr|>, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_map_cycle = cg, iterable, body_fn, esc_opt, ti =>
   sc = str::from_int(types::g.tmpc)
   types::g.tmpc = types::g.tmpc + 1
   i64t = LLVMInt64Type!
   i8t = LLVMInt8Type!
   i8p = LLVMPointerType(i8t, 0)
   iv = main::codegen_typed_eval(cg, iterable)
   m = iv.0
   m_info = iterable.ti [Map mp] mp | (ast::ValueType(Str),
      ast::ValueType(Int), ast::TypeInfo(Prim, ast::ValueType(Int)))
   key_vt = m_info.0
   val_vt = m_info.1
   val_ti = m_info.2
   val_ll = types::llvm_type_of_vt(val_vt)
   key_ll = types::llvm_type_of_vt(key_vt)

   mf = runtime::map_fields(cg, m)
   cap = mf.0
   keys = mf.1
   vals = mf.2
   states = mf.3

   counter_alloca = types::hoisted_alloca(cg, i64t, "loop.midx." + sc)
   LLVMBuildStore(cg.builder, LLVMConstInt(i64t, 0, 0),
      counter_alloca)
   p0 = body_fn.kind
      [Lambda lam]
         ?lam.0 > 0 | (lam.0(0) | _ | "") | ""
      | ""
   p1 = body_fn.kind
      [Lambda lam]
         ?lam.0 > 1 | (lam.0(1) | _ | "") | ""
      | ""
   p0 != "" && p0 != "_"
      |
         has_s0 = <>(types::var_slot(cg, p0))
         !has_s0
            |
               s0 = types::create_slot(cg, p0, val_ll, cg.in_fn)
               elem_is_rec0 = val_vt [Record]
               elem_rm0 = elem_is_rec0
                  | runtime::record_meta_from_ti(cg, val_ti)
                  | <-->
               elem_rm0_opt = elem_rm0 | m => <+ m.0 -> | <-->
               elem_rm0_fn = elem_rm0 | m => m.1 | ast::Names()
               cg.vars += types::CgVar((p0, val_vt, types::is_ptrish_vt(val_vt), "",
                  elem_rm0_opt, elem_rm0_fn, <+ s0 ->, cg.in_fn, <->,
                  ast::VTypes(), <-->))
   p1 != "" && p1 != "_"
      |
         has_s1 = <>(types::var_slot(cg, p1))
         !has_s1
            |
               s1 = types::create_slot(cg, p1, key_ll, cg.in_fn)
               cg.vars += types::CgVar((p1, key_vt, types::is_ptrish_vt(key_vt), "",
                  <-->, ast::Names(), <+ s1 ->, cg.in_fn, <->,
                  ast::VTypes(), <-->))
   header = LLVMAppendBasicBlock(cg.current_fn, "loop.mheader." + sc)
   body = LLVMAppendBasicBlock(cg.current_fn, "loop.mbody." + sc)
   live_bb = LLVMAppendBasicBlock(cg.current_fn, "loop.mlive." + sc)
   latch = LLVMAppendBasicBlock(cg.current_fn, "loop.mlatch." + sc)
   done = LLVMAppendBasicBlock(cg.current_fn, "loop.mexit." + sc)

   has_esc = <>(esc_opt)
   b_vt = has_esc | types::vt_from_ti(ti) | ast::ValueType(Unit)
   res_lt = types::llvm_type_of_vt(b_vt)
   esc_blocks = esc_opt
      | _ =>
         b_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.branch." + sc)
         m_bb = LLVMAppendBasicBlock(cg.current_fn, "escape.merge." + sc)
         r_al = types::hoisted_alloca(cg, res_lt, "escape.res." + sc)
         u_none = codegen_typed_cycle_escape_construct(cg, <->, <-->, ti)
         LLVMBuildStore(cg.builder, u_none, r_al)
         <+ (b_bb, m_bb, r_al) ->
      | <-->
   break_target = esc_blocks | eb => eb.0 | done
   cg.cycle_breaks += break_target
   cg.cycle_conts += latch

   branch_to(cg, header)
   LLVMPositionBuilderAtEnd(cg.builder, header)
   curr_i = LLVMBuildLoad2(cg.builder, i64t, counter_alloca, "m.it.load")
   cond = LLVMBuildICmp(cg.builder, 40, curr_i, cap, "m.it.cond")
   LLVMBuildCondBr(cg.builder, cond, body, done)

   LLVMPositionBuilderAtEnd(cg.builder, body)
   st_gep = types::gep1(cg, i8t, states, curr_i, "m.it.st.gep")
   st_val = LLVMBuildLoad2(cg.builder, i8t, st_gep, "m.it.st")
   is_live = LLVMBuildICmp(cg.builder, 32, st_val,
      LLVMConstInt(i8t, 1, 0), "m.it.live")
   LLVMBuildCondBr(cg.builder, is_live, live_bb, latch)

   LLVMPositionBuilderAtEnd(cg.builder, live_bb)
   val_is_ptr = types::is_ptrish_vt(val_vt)
   val_slot = types::gep1(cg, val_is_ptr | i8p | i64t, vals, curr_i, "m.it.v.slot")
   val_raw = LLVMBuildLoad2(cg.builder, val_is_ptr | i8p | i64t,
      val_slot, "m.it.v")
   val_val = val_is_ptr
      | val_raw
      |
         types::is_float_vt(val_vt)
            | LLVMBuildBitCast(cg.builder, val_raw, val_ll, "m.it.v.flt")
            | coerce_int_ext(cg, val_raw, val_ll, types::is_unsigned_vt(val_vt))

   key_is_ptr = types::is_ptrish_vt(key_vt)
   key_slot = types::gep1(cg, key_is_ptr | i8p | i64t, keys, curr_i, "m.it.k.slot")
   key_raw = LLVMBuildLoad2(cg.builder, key_is_ptr | i8p | i64t,
      key_slot, "m.it.k")
   key_val = key_is_ptr
      | key_raw
      |
         types::is_float_vt(key_vt)
            | LLVMBuildBitCast(cg.builder, key_raw, key_ll, "m.it.k.flt")
            | coerce_int_ext(cg, key_raw, key_ll, types::is_unsigned_vt(key_vt))

   saved_body_vars = ?cg.vars
   eff_slot_v = types::var_slot(cg, "_")
      | s => s
      |
         s_v = types::create_slot(cg, "_", val_ll, cg.in_fn)
         cg.vars += types::CgVar(("_", val_vt, types::is_ptrish_vt(val_vt), "", <-->,
            ast::Names(), <+ s_v ->, cg.in_fn, <->, ast::VTypes(), <+ val_val ->))
         s_v
   LLVMBuildStore(cg.builder, val_val, eff_slot_v)

   eff_slot_k = types::var_slot(cg, "_i")
      | s => s
      |
         s_k = types::create_slot(cg, "_i", key_ll, cg.in_fn)
         cg.vars += types::CgVar(("_i", key_vt, types::is_ptrish_vt(key_vt), "", <-->,
            ast::Names(), <+ s_k ->, cg.in_fn, <->, ast::VTypes(), <+ key_val ->))
         s_k
   LLVMBuildStore(cg.builder, key_val, eff_slot_k)

   p0 != "" && p0 != "_"
      |
         types::var_slot(cg, p0)
            | s => LLVMBuildStore(cg.builder, val_val, s)
   p1 != "" && p1 != "_"
      |
         types::var_slot(cg, p1)
            | s => LLVMBuildStore(cg.builder, key_val, s)
   body_fn.kind
      [Lambda lam]
         main::codegen_typed_eval(cg, lam.1)
      |
         main::codegen_typed_eval(cg, body_fn)
   cg.vars = truncate_vars(cg.vars, saved_body_vars)
   branch_to(cg, latch)
   LLVMPositionBuilderAtEnd(cg.builder, latch)
   loaded_i = LLVMBuildLoad2(cg.builder, i64t, counter_alloca, "m.it.c")
   next_i = LLVMBuildAdd(cg.builder, loaded_i,
      LLVMConstInt(i64t, 1, 0), "m.it.next")
   LLVMBuildStore(cg.builder, next_i, counter_alloca)
   branch_to(cg, header)
   nb = ?cg.cycle_breaks
   cg.cycle_breaks = cycle_trunc(cg.cycle_breaks, nb - 1)
   cg.cycle_conts = cycle_trunc(cg.cycle_conts, nb - 1)
   LLVMPositionBuilderAtEnd(cg.builder, done)
   esc_blocks
      | eb =>
         branch_to(cg, eb.1)
         LLVMPositionBuilderAtEnd(cg.builder, eb.0)
         esc_te = esc_opt!!
         saved_esc_vars = ?cg.vars
         u_some = codegen_typed_cycle_escape_construct(cg, <+>,
            <+ esc_te ->, ti)
         cg.vars = truncate_vars(cg.vars, saved_esc_vars)
         LLVMBuildStore(cg.builder, u_some, eb.2)
         branch_to(cg, eb.1)
         LLVMPositionBuilderAtEnd(cg.builder, eb.1)
         res_val = LLVMBuildLoad2(cg.builder, res_lt, eb.2,
            "escape.res")
         (res_val, b_vt)
      | (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))

codegen_typed_eval_cycle_jump: types::Cg, <>, Int => (Addr, ast::ValueType)
codegen_typed_eval_cycle_jump = cg, is_break, level =>
   nb = ?cg.cycle_breaks
   nb == 0
      |
         types::init_error(cg, "E3006",
            "cycle jump cannot be used outside of a cycle context (@).", 0, 0)
         (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
      |
         level > nb
            |
               op = is_break | "-->" | "--^"
               msg = "'" + op + "' targets cycle-nesting level " +
                  str::from_int(level) + ", but only " + str::from_int(nb) +
                  " enclosing cycle(s) exist at this point."
               types::init_error(cg, "E3007", msg, 0, 0)
               (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unknown))
            |
               target = is_break
                  | cg.cycle_breaks(nb - level)!!
                  | cg.cycle_conts(nb - level)!!
               branch_to(cg, target)
               (LLVMConstInt(LLVMInt64Type!, 0, 0), ast::ValueType(Unit))


typed_refs_name_opt: <tast::TypedExpr|>, String => <>
typed_refs_name_opt = opt, name =>
   opt
      | e => typed_refs_name(e, name)
      | <->

typed_refs_name_exprs: tast::TypedExprs, String, Int, Int => <>
typed_refs_name_exprs = es, name, i, n =>
   i == n
      | <->
      |
         typed_refs_name(es(i)!!, name)
            | <+>
            | typed_refs_name_exprs(es, name, i + 1, n)

typed_refs_name_fields: tast::TypedFields, String, Int, Int => <>
typed_refs_name_fields = fs, name, i, n =>
   i == n
      | <->
      |
         tf = fs(i)!!
         typed_refs_name(tf.val, name)
            | <+>
            | typed_refs_name_fields(fs, name, i + 1, n)

typed_refs_name_branches: tast::TypedBranches, String, Int, Int => <>
typed_refs_name_branches = bs, name, i, n =>
   i == n
      | <->
      |
         b = bs(i)!!
         typed_refs_name_exprs(b.case_values, name, 0, ?b.case_values) ||
            typed_refs_name_opt(b.pred_fn, name) ||
            (!param_in(b.bind_vars, name) && typed_refs_name(b.body, name))
            | <+>
            | typed_refs_name_branches(bs, name, i + 1, n)

typed_refs_name_map: tast::TypedMapPairs, String, Int, Int => <>
typed_refs_name_map = mp, name, i, n =>
   i == n
      | <->
      |
         p = mp(i)!!
         typed_refs_name(p.key, name) || typed_refs_name(p.val, name)
            | <+>
            | typed_refs_name_map(mp, name, i + 1, n)

typed_refs_name: tast::TypedExpr, String => <>
typed_refs_name = te, name =>
   te.kind
      [Var v] v.0 == name
      [Bin b] typed_refs_name(b.1, name) || typed_refs_name(b.2, name)
      [Unary u] typed_refs_name(u.1, name)
      [Call c]
         c.0 == name ||
            typed_refs_name_opt(c.1, name) ||
            typed_refs_name_exprs(c.2, name, 0, ?c.2)
      [Record r] typed_refs_name_fields(r, name, 0, ?r)
      [Member m] typed_refs_name(m.0, name)
      [MemberWrite mw]
         typed_refs_name(mw.0, name) || typed_refs_name(mw.3, name)
      [Index ix] typed_refs_name(ix.0, name) || typed_refs_name(ix.1, name)
      [KeyAccess ka]
         typed_refs_name(ka.0, name) || typed_refs_name(ka.1, name)
      [IndexWrite iw]
         typed_refs_name(iw.0, name) || typed_refs_name(iw.1, name) ||
            typed_refs_name(iw.2, name)
      [Choice ch]
         typed_refs_name(ch.0, name) ||
            typed_refs_name_branches(ch.1, name, 0, ?ch.1)
      [Lambda lam] !param_in(lam.0, name) && typed_refs_name(lam.1, name)
      [Block blk] typed_refs_name_exprs(blk, name, 0, ?blk)
      [Assign as] as.0 == name || typed_refs_name(as.5, name)
      [Cycle cy]
         typed_refs_name(cy.0, name) || typed_refs_name(cy.1, name) ||
            typed_refs_name_opt(cy.2, name)
      [RamConstruct rc] typed_refs_name_opt(rc.2, name)
      [EnumConstruct ec] typed_refs_name_opt(ec.1, name)
      [BuilderNew bn] typed_refs_name(bn, name)
      [Copy cp] typed_refs_name(cp, name)
      [RawMemory rm] typed_refs_name(rm.0, name)
      [RawMemoryWrite rmw]
         typed_refs_name(rmw.0, name) || typed_refs_name(rmw.1, name)
      [MapLiteral ml] typed_refs_name_map(ml, name, 0, ?ml)
      [Exit e] typed_refs_name(e, name)
      | <->

typed_lambda_captures_at: types::Cg, ast::Names, tast::TypedExpr, Int, Int, ast::Names => ast::Names
typed_lambda_captures_at = cg, params, body, i, n, acc =>
   i == n
      | acc
      |
         cv = cg.vars(i)!!
         (cv.is_local && !param_in(params, cv.name) &&
            typed_refs_name(body, cv.name))
            | acc += cv.name
         typed_lambda_captures_at(cg, params, body, i + 1, n, acc)

typed_lambda_captures: types::Cg, ast::Names, tast::TypedExpr => ast::Names
typed_lambda_captures = cg, params, body =>
   typed_lambda_captures_at(cg, params, body, cg.fn_var_start, ?cg.vars,
      ast::Names())

typed_member_root_name: tast::TypedExpr => String
typed_member_root_name = te =>
   te.kind
      [Var v] v.0
      [Member m] typed_member_root_name(m.0)
      | ""

codegen_typed_compile_fn: types::Cg, String, ast::Names, tast::TypedExpr,
   ast::TypeInfo => (Addr, String)
codegen_typed_compile_fn = cg, name, params, body, ti =>
   is_anon = ?name > 0 && name(0) == '$'
   is_top = !is_anon && (types::has_fn_name(cg, name) ||
      types::has_fn_name(cg, types::resolve_fn_name(cg, name)))
   can_capture = !is_top
   caps = can_capture | typed_lambda_captures(cg, params, body) | ast::Names()
   nc = ?caps
   is_cap = can_capture && nc > 0

   saved_module = cg.current_module
   saved_fn = cg.current_fn
   saved_bb = LLVMGetInsertBlock(cg.builder)
   saved_in_fn = cg.in_fn
   saved_nvars = ?cg.vars
   saved_var_start = cg.fn_var_start
   saved_nbindings = ?cg.bindings
   saved_binding_start = cg.fn_binding_start
   saved_bindings = cg.bindings
   saved_nalloc_rec = ?types::g.alloc_rec_names
   saved_last_fn = types::g.last_compiling_fn
   types::g.last_compiling_fn = name
   saved_expected_ti = types::g.expected_fn_ti
   saved_fn_ret_ll = types::g.fn_ret_ll

   cap_vals = is_cap | lambda_load_caps_at(cg, caps, 0, nc, types::Addrs()) | types::Addrs()
   cap_vts = is_cap | lambda_caps_vts_at(cg, caps, 0, nc, ast::VTypes()) |
      ast::VTypes()

   mod_name = types::decl_module(name, 0)
   mod_name != "" | cg.current_module = mod_name
   cg.fn_var_start = saved_nvars
   cg.bindings = types::BindingMuts()
   cg.fn_binding_start = 0

   param_types0 = ti [Fn f] f.0 | ast::VTypes()
   param_tis = ti [Fn f] f.1 | ast::VInfos()
   param_types = resolve_sig_param_types(cg, param_types0, param_tis)
   ret_vt0 = ti [Fn f] f.2 | ast::ValueType(Unit)
   ret_ti = ti [Fn f] f.3 | ast::TypeInfo(Prim, ast::ValueType(Unit))
   ret_vt = resolve_sig_vt(cg, ret_vt0, ret_ti)
   types::g.expected_fn_ti = ret_ti

   i8p = LLVMPointerType(LLVMInt8Type!, 0)
   cap_tys = is_cap | lambda_caps_types_at(cg, caps, 0, nc, types::Addrs()) | types::Addrs()
   est_opt = is_cap | <+ types::struct_type_n(cg, cap_tys, nc) -> | <-->

   nparams = ?params
   param_ll = types::Addrs()
   is_cap | param_ll += i8p
   nparams @ i =>
      pvt_i = param_types(i) | _ | ast::ValueType(Int)
      pti_i = param_tis(i) | _ | ast::TypeInfo(Prim, pvt_i)
      param_ll += types::is_unboxed_ram_ti(cg, pti_i) | match::unboxed_ram_struct_t(cg) |
         types::llvm_type_of_vt(pvt_i)

   ret_ll = types::is_unboxed_ram_ti(cg, ret_ti)
      | match::unboxed_ram_struct_t(cg)
      |
         ret_vt [Unit] LLVMVoidType!
         | types::llvm_type_of_vt(ret_vt)
   types::g.fn_ret_ll = <+ ret_ll ->
   fty = fn_type_n(cg, ret_ll, param_ll, (is_cap | nparams + 1 | nparams))
   exp_sym = find_export_symbol(types::g.pexports, name)
   fn_ll_name = exp_sym | _ | name
   is_exp = <>(exp_sym)
   fn = LLVMAddFunction(cg.module, fn_ll_name, fty)
   is_dyn_m = is_module_dynamic(cg, name) || cg.opts.is_shared
   is_pub_mod = cg.opts.is_module && !is_anon && !types::name_is_private(name) &&
      types::name_is_in_current_module(cg, name)
   LLVMSetLinkage(fn, (is_exp || is_dyn_m || is_pub_mod) | 0 | 8)
   is_module_dynamic(cg, name)
      |
         _ = get_or_create_dyn_fn_ptr(cg, name, <+ fn ->)
   runtime::mark_nounwind(cg, fn)
   cg.current_fn = fn
   cg.in_fn = <+>
   entry = LLVMAppendBasicBlock(fn, "entry")
   LLVMPositionBuilderAtEnd(cg.builder, entry)
   cg.fninfos += types::FnInfo((name, <+ fn ->, <+ fty ->, nparams, param_types, ret_vt,
      <+>, <->, <+>, !is_cap))

   est_opt
      | est =>
         ep = LLVMBuildBitCast(cg.builder, LLVMGetParam(fn, 0),
            LLVMPointerType(est, 0), "cap.env")
         lambda_add_caps(cg, caps, cap_vts, est, ep, 0, nc)

   nparams @ j =>
      pname = params(j) | _ | ""
      pvt_j = param_types(j) | _ | ast::ValueType(Int)
      pti = param_tis(j) | _ | ast::TypeInfo(Prim, pvt_j)
      pty = types::is_unboxed_ram_ti(cg, pti) | match::unboxed_ram_struct_t(cg) |
         types::llvm_type_of_vt(pvt_j)
      pslot = types::create_slot(cg, pname, pty, <+>)
      pv = LLVMGetParam(fn, (is_cap | j + 1 | j))
      LLVMBuildStore(cg.builder, pv, pslot)
      prec = codegen_fn_param_rec(cg, pname, "", pti)
      rm_pti = runtime::record_meta_from_ti(cg, pti)
      prm_0_opt = prec | p => <+ p.0 -> | (rm_pti | m => <+ m.0 -> | <-->)
      prm_1 = prec | p => p.1 | (rm_pti | m => m.1 | ast::Names())
      pfvts = prec | p => p.2 | types::field_vts(cg, pti)
      pdt = pti [TypeVar tv] tv | ""
      cg.vars += types::CgVar((pname, pvt_j, types::is_ptrish_vt(pvt_j), pdt,
         prm_0_opt, prm_1, <+ pslot ->, <+>, <->, pfvts, <-->))

   is_rso = is_dyn_reload_so_fn(cg, name)
   is_r = is_dyn_reload_fn(cg, name)
   is_rso
      | codegen_emit_reload_so_body(cg, name, fn)
      |
         is_r
            | codegen_emit_reload_body(cg, name, fn)
            |
               bv = main::codegen_typed_eval(cg, body)
               is_void = ret_vt [Unit]
               is_void
                  | !block_is_terminated(cg) | LLVMBuildRetVoid(cg.builder)
                  |
                     bv_val = types::llvm_val_opt(bv.0)
                        | bvv => bvv
                        | LLVMConstNull(ret_ll)
                     real_ret_ti = ret_ti
                        [TypeVar tv] types::typedef_ti(cg, tv)
                        | ret_ti
                     is_ram_ret = real_ret_ti [Ram _]
                     ret_coerced = is_ram_ret
                        |
                           ret_k = LLVMGetTypeKind(ret_ll)
                           bv_k = LLVMGetTypeKind(
                              LLVMTypeOf(bv_val))
                           ret_k == 12 && bv_k == 10
                              | match::convert_unboxed_ram_to_heap(cg, bv_val,
                                 real_ret_ti)
                              |
                                 ret_k == 10 && bv_k == 12
                                    | match::convert_heap_ram_to_unboxed(cg,
                                       bv_val, real_ret_ti)
                                    | bv_val
                        | bv_val
                     !block_is_terminated(cg)
                        |
                           LLVMBuildRet(cg.builder,
                              expr::coerce_ret_ptr_int(cg, ret_coerced, ret_ll, bv.1))
               is_fn_ret = main::is_fn_vt(bv.1) || main::is_fn_vt(ret_vt)
               is_fn_ret && (cg.last_closure_fn != "")
                  | fn_ret_fn_add(name, cg.last_closure_fn)

   cg.in_fn = saved_in_fn
   cg.vars = truncate_vars(cg.vars, saved_nvars)
   cg.bindings = saved_bindings
   cg.fn_var_start = saved_var_start
   cg.fn_binding_start = saved_binding_start
   cg.current_fn = saved_fn
   LLVMPositionBuilderAtEnd(cg.builder, saved_bb)
   cg.current_module = saved_module
   types::g.last_compiling_fn = saved_last_fn
   types::g.alloc_rec_names = types::truncate_names(types::g.alloc_rec_names, saved_nalloc_rec)
   types::g.expected_fn_ti = saved_expected_ti
   types::g.fn_ret_ll = saved_fn_ret_ll

   envp' = LLVMConstNull(i8p)
   est_opt
      | est =>
         ep2 = expr::codegen_call_arena_alloc(cg,
            LLVMConstInt(LLVMInt64Type!, nc * 8, 0), "env.alloc")
         lambda_store_caps_at(cg, caps, cap_vals, est, ep2, 0, nc)
         envp' = ep2
         lambda_env_add(name, est, nc, cap_vts)

   fptr = LLVMBuildBitCast(cg.builder, fn, i8p, "fn.ptr")
   clo = is_cap
      | codegen_build_closure(cg, fptr, envp', "clo")
      | expr::noncap_closure(cg, name, fn)
   (clo, name)

codegen_typed_eval_map_literal: types::Cg, tast::TypedMapPairs,
   ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_map_literal = cg, pairs, ti =>
   m = runtime::codegen_map_create(cg, "map.literal")
   np = ?pairs
   np == 0
      | (m, ast::ValueType(Map))
      |
         i64t = LLVMInt64Type!
         np @ i =>
            p = pairs(i)!!
            kv = main::codegen_typed_eval(cg, p.key)
            vv = main::codegen_typed_eval(cg, p.val)
            val_st = types::is_ptrish_vt(vv.1)
               | LLVMBuildPtrToInt(cg.builder, vv.0, i64t, "m.wr.p2i")
               | coerce_int(cg, vv.0, i64t)
            runtime::codegen_map_insert(cg, m, kv.0, val_st, kv.1)
         (m, ast::ValueType(Map))

codegen_typed_eval_key_access: types::Cg, tast::TypedExpr, tast::TypedExpr,
   <>, <>, ast::TypeInfo => (Addr, ast::ValueType)
codegen_typed_eval_key_access = cg, target, key, is_mem, is_del, ti =>
   tv = main::codegen_typed_eval(cg, target)
   kv = main::codegen_typed_eval(cg, key)
   is_del
      |
         res' = runtime::codegen_map_delete(cg, tv.0, kv.0, kv.1)
         (res', ast::ValueType(Flag))
      |
         is_mem
            |
               res' = runtime::codegen_map_membership(cg, tv.0, kv.0, kv.1)
               (res', ast::ValueType(Flag))
            |
               val_vt = ti [Ram s] s.0.payload_type | ast::ValueType(Int)
               is_unboxed = types::is_unboxed_ram_ti(cg, ti)
               u = is_unboxed
                  | expr::codegen_typed_map_lookup(cg, tv.0, kv.0, kv.1, val_vt,
                     0, 0)
                  | runtime::codegen_map_lookup(cg, tv.0, kv.0, kv.1, val_vt, 0, 0)
               (u, ast::ValueType(Ram))

declare_external_var: types::Cg, String, ast::TypeInfo => <>
declare_external_var = cg, name, ti =>
   has_slot = <>(types::var_slot(cg, name))
   has_slot
      | <+>
      |
         vt = types::vt_from_ti_cg(cg, ti)
         llvm_ty = types::llvm_type_of_vt(vt)
         slot = types::codegen_get_global(cg, name, llvm_ty)
         cg.vars += types::CgVar((name, vt, <->, "", <-->, ast::Names(),
            <+ slot ->, <->, <->, ast::VTypes(), <-->))
         <+>

codegen_typed_emit_stmt: types::Cg, tast::TypedStmt => ()
codegen_typed_emit_stmt = cg, stmt =>
   stmt
      [Expr e]
         main::codegen_typed_eval(cg, e)
      [Binding b]
         cg.opts.is_module && !types::name_is_in_current_module(cg, b.0)
            |
               is_lam = b.2.kind [Lambda _]
               !is_lam && types::is_external_module_name(cg, b.0)
                  | declare_external_var(cg, b.0, b.1)
            | codegen_typed_eval_assign(cg, b.0, b.3, <->, <->, <->, b.2, b.1)
      [GlobalBinding b]
         cg.opts.is_module && !types::name_is_in_current_module(cg, b.0)
            |
               is_lam = b.2.kind [Lambda _]
               !is_lam && types::is_external_module_name(cg, b.0)
                  | declare_external_var(cg, b.0, b.1)
            | codegen_typed_eval_assign(cg, b.0, <->, <->, <+>, <->, b.2, b.1)
      [TypeDecl t]
         runtime::add_type(cg, t.0, t.1)

