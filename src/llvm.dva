// LLVM C API bindings.
//
// LLVM 18 C API bindings needed to emit IR.
// Type mapping: LLVM*Ref/rawptr/^T -> Addr, cstring ->
// String, c.int/c.uint/c.ulonglong/c.char -> Int, c.double -> Float.
// binary's libLLVM-18 link.

#public

#foreign "LLVM-18"
   LLVMModuleCreateWithName: (ModuleID: String) => Addr
   LLVMDisposeModule: (M: Addr) => ()
