// Standard Color Module (std/color.dva)
//
// Color representations, color space transformations, alpha compositing,
// and perceptually uniform transitions for UI styling and graphics.
//
// All color spaces use normalized 4-float records (Float, Float, Float, Float)
// with alpha in the 4th component, benefiting from element-wise vector
// operations (+, -, *).

#use ascii
#use const
#use math

#public
   #type Color      (r: Float, g: Float, b: Float, a: Float)
   #type Rgba       (r: Float, g: Float, b: Float, a: Float)
   #type LinearRgba (Float, Float, Float, Float)
   #type Oklab      (Float, Float, Float, Float)
   #type Oklch      (Float, Float, Float, Float)
   #type Hsv        (Float, Float, Float, Float)

   // Constructors
   rgba: Float, Float, Float, Float => Rgba
   rgba = r, g, b, a => Rgba(r, g, b, a)

   rgb: Float, Float, Float => Rgba
   rgb = r, g, b => Rgba(r, g, b, 1.0)

   // Alias constructor
   color: Float, Float, Float => Color
   color = r, g, b => Color(r, g, b, 1.0)

   color_rgba: Float, Float, Float, Float => Color
   color_rgba = r, g, b, a => Color(r, g, b, a)

   // Standard Modern Vibrant Base Colors (4-float RGBA)
   white     = Color(1.00, 1.00, 1.00, 1.0)
   black     = Color(0.00, 0.00, 0.00, 1.0)
   red       = Color(0.95, 0.25, 0.25, 1.0)
   orange    = Color(0.95, 0.50, 0.15, 1.0)
   yellow    = Color(0.95, 0.85, 0.20, 1.0)
   green     = Color(0.25, 0.85, 0.35, 1.0)
   cyan      = Color(0.15, 0.85, 0.95, 1.0)
   blue      = Color(0.25, 0.45, 0.95, 1.0)
   violet    = Color(0.75, 0.25, 0.95, 1.0)
   magenta   = Color(0.95, 0.25, 0.80, 1.0)
   amber     = Color(1.00, 0.75, 0.15, 1.0)
   emerald   = Color(0.20, 0.95, 0.45, 1.0)
   ruby      = Color(0.95, 0.20, 0.35, 1.0)
   sapphire  = Color(0.20, 0.40, 0.95, 1.0)
   turquoise = Color(0.15, 0.85, 0.80, 1.0)
   slate     = Color(0.20, 0.25, 0.32, 1.0)

   // General Procedural Color Providers
   with_alpha: Color, Float => Color
   with_alpha = c, a => Color(c.r, c.g, c.b, a)

   glass: (Int => Color), Float => (Int => Color)
   glass = fn, a => (i => with_alpha(fn(i), a))

   // Continuous Color Gradient Providers (t in [0.0, 1.0] => Color)
   gradient: Color, Color => (Float => Color)
   gradient = c1, c2 =>
      t =>
         tc = t < 0.0 | 0.0 | (t > 1.0 | 1.0 | t)
         lerp(c1, c2, tc)

   gradient_oklab: Color, Color => (Float => Color)
   gradient_oklab = c1, c2 =>
      t =>
         tc = t < 0.0 | 0.0 | (t > 1.0 | 1.0 | t)
         res = lerp_oklab(Rgba(c1.r, c1.g, c1.b, c1.a), Rgba(c2.r, c2.g, c2.b, c2.a), tc)
         Color(res.r, res.g, res.b, res.a)

   uniform: Color => (Int => Color)
   uniform = c => (i => c)

   stripes: Color, Color => (Int => Color)
   stripes = c1, c2 => (i => i % 2 == 0 | c1 | c2)

   // 7-stripe Rainbow (КОЖЗГСФ: Red, Orange, Yellow, Green, Cyan/Голубой, Blue/Синий, Violet/Фиолетовый)
   rainbow: Int => Color
   rainbow = idx =>
      idx % 7
         [0] red
         [1] orange
         [2] yellow
         [3] green
         [4] cyan
         [5] blue
         |   violet

   warm: Int => Color
   warm = idx =>
      idx % 5
         [0] Color(0.95, 0.25, 0.25, 1.0)
         [1] Color(0.95, 0.50, 0.20, 1.0)
         [2] Color(0.95, 0.75, 0.20, 1.0)
         [3] Color(0.95, 0.35, 0.45, 1.0)
         |   Color(0.85, 0.20, 0.30, 1.0)

   cool: Int => Color
   cool = idx =>
      idx % 5
         [0] Color(0.15, 0.85, 0.95, 1.0)
         [1] Color(0.20, 0.65, 0.95, 1.0)
         [2] Color(0.25, 0.40, 0.95, 1.0)
         [3] Color(0.20, 0.85, 0.65, 1.0)
         |   Color(0.60, 0.35, 0.95, 1.0)

   oklab: Float, Float, Float, Float => Oklab
   oklab = l, a, b, alpha => (l, a, b, alpha)

   oklch: Float, Float, Float, Float => Oklch
   oklch = l, c, h, alpha => (l, c, h, alpha)

   hsv: Float, Float, Float, Float => Hsv
   hsv = h, s, v, alpha => (h, s, v, alpha)

   // Hex Packing & Unpacking
   from_hex: Int => Rgba
   from_hex = hex =>
      r = Float((hex .>. 24) .&. 0xFF) / 255.0
      g = Float((hex .>. 16) .&. 0xFF) / 255.0
      b = Float((hex .>. 8) .&. 0xFF) / 255.0
      a = Float(hex .&. 0xFF) / 255.0
      (r, g, b, a)

   from_hex_rgb: Int => Rgba
   from_hex_rgb = hex =>
      r = Float((hex .>. 16) .&. 0xFF) / 255.0
      g = Float((hex .>. 8) .&. 0xFF) / 255.0
      b = Float(hex .&. 0xFF) / 255.0
      (r, g, b, 1.0)

   to_hex: Rgba => Int
   to_hex = c =>
      r = Int(%round(%clamp(c(0), 0.0, 1.0) * 255.0))
      g = Int(%round(%clamp(c(1), 0.0, 1.0) * 255.0))
      b = Int(%round(%clamp(c(2), 0.0, 1.0) * 255.0))
      a = Int(%round(%clamp(c(3), 0.0, 1.0) * 255.0))
      (r .<. 24) .|. (g .<. 16) .|. (b .<. 8) .|. a

   to_hex_rgb: Rgba => Int
   to_hex_rgb = c =>
      r = Int(%round(%clamp(c(0), 0.0, 1.0) * 255.0))
      g = Int(%round(%clamp(c(1), 0.0, 1.0) * 255.0))
      b = Int(%round(%clamp(c(2), 0.0, 1.0) * 255.0))
      (r .<. 16) .|. (g .<. 8) .|. b

   // sRGB <-> Linear sRGB Transfer Functions
   srgb_to_linear_channel: Float => Float
   srgb_to_linear_channel = c =>
      c !> 0.04045
         | c / 12.92
         | %pow((c + 0.055) / 1.055, 2.4)

   linear_to_srgb_channel: Float => Float
   linear_to_srgb_channel = c =>
      c !> 0.0031308
         | c * 12.92
         | 1.055 * %pow(c, 1.0 / 2.4) - 0.055

   srgb_to_linear: Rgba => LinearRgba
   srgb_to_linear = c =>
      (srgb_to_linear_channel(c(0)),
         srgb_to_linear_channel(c(1)),
         srgb_to_linear_channel(c(2)),
         c(3))

   linear_to_srgb: LinearRgba => Rgba
   linear_to_srgb = c =>
      r = %clamp(linear_to_srgb_channel(c(0)), 0.0, 1.0)
      g = %clamp(linear_to_srgb_channel(c(1)), 0.0, 1.0)
      b = %clamp(linear_to_srgb_channel(c(2)), 0.0, 1.0)
      (r, g, b, c(3))

   // Linear sRGB <-> Oklab
   linear_to_oklab: LinearRgba => Oklab
   linear_to_oklab = c =>
      r = c(0)
      g = c(1)
      b = c(2)
      l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
      m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
      s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
      l_ = math::cbrt(l)
      m_ = math::cbrt(m)
      s_ = math::cbrt(s)
      L = 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_
      lab_a = 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_
      lab_b = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
      (L, lab_a, lab_b, c(3))

   oklab_to_linear: Oklab => LinearRgba
   oklab_to_linear = c =>
      L = c(0)
      lab_a = c(1)
      lab_b = c(2)
      l_ = L + 0.3963377774 * lab_a + 0.2158037573 * lab_b
      m_ = L - 0.1055613458 * lab_a - 0.0638541728 * lab_b
      s_ = L - 0.0894841775 * lab_a - 1.2914855480 * lab_b
      l = l_ * l_ * l_
      m = m_ * m_ * m_
      s = s_ * s_ * s_
      r = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
      g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
      b = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
      (r, g, b, c(3))

   // sRGB <-> Oklab
   rgba_to_oklab: Rgba => Oklab
   rgba_to_oklab = c =>
      linear_to_oklab(srgb_to_linear(c))

   srgb_to_oklab: Rgba => Oklab
   srgb_to_oklab = c =>
      rgba_to_oklab(c)

   oklab_to_rgba: Oklab => Rgba
   oklab_to_rgba = c =>
      linear_to_srgb(oklab_to_linear(c))

   oklab_to_srgb: Oklab => Rgba
   oklab_to_srgb = c =>
      oklab_to_rgba(c)

   // Oklab <-> Oklch
   oklab_to_oklch: Oklab => Oklch
   oklab_to_oklch = c =>
      L = c(0)
      lab_a = c(1)
      lab_b = c(2)
      C = %sqrt(lab_a * lab_a + lab_b * lab_b)
      rad = math::atan2(lab_b, lab_a)
      deg = math::deg(rad)
      deg_pos = deg < 0.0 | deg + 360.0 | deg
      h = C < 1e-6 | 0.0 | deg_pos
      (L, C, h, c(3))

   oklch_to_oklab: Oklch => Oklab
   oklch_to_oklab = c =>
      L = c(0)
      C = c(1)
      h = c(2)
      rad = math::rad(h)
      lab_a = C * %cos(rad)
      lab_b = C * %sin(rad)
      (L, lab_a, lab_b, c(3))

   // Direct sRGB <-> Oklch
   rgba_to_oklch: Rgba => Oklch
   rgba_to_oklch = c =>
      oklab_to_oklch(rgba_to_oklab(c))

   srgb_to_oklch: Rgba => Oklch
   srgb_to_oklch = c =>
      rgba_to_oklch(c)

   oklch_to_rgba: Oklch => Rgba
   oklch_to_rgba = c =>
      oklab_to_rgba(oklch_to_oklab(c))

   oklch_to_srgb: Oklch => Rgba
   oklch_to_srgb = c =>
      oklch_to_rgba(c)

   // sRGB <-> HSV
   rgba_to_hsv: Rgba => Hsv
   rgba_to_hsv = c =>
      r = c(0)
      g = c(1)
      b = c(2)
      c_max = %max(r, %max(g, b))
      c_min = %min(r, %min(g, b))
      delta = c_max - c_min
      v = c_max
      s = c_max == 0.0 | 0.0 | delta / c_max
      h_raw = delta < 1e-6
         | 0.0
         |
            c_max == r
               | (g - b) / delta
               |
                  c_max == g
                     | (b - r) / delta + 2.0
                     | (r - g) / delta + 4.0
      h_deg = h_raw * 60.0
      h = h_deg < 0.0 | h_deg + 360.0 | h_deg
      (h, s, v, c(3))

   srgb_to_hsv: Rgba => Hsv
   srgb_to_hsv = c =>
      rgba_to_hsv(c)

   hsv_to_rgba: Hsv => Rgba
   hsv_to_rgba = c =>
      h = c(0)
      s = c(1)
      v = c(2)
      c_val = v * s
      h_mod = h / 60.0
      h_int = Int(%floor(h_mod)) % 6
      x_val = c_val * (1.0 - %abs((h_mod - 2.0 * %floor(h_mod / 2.0)) - 1.0))
      m = v - c_val
      rgb_base = h_int
         [0] (c_val, x_val, 0.0)
         [1] (x_val, c_val, 0.0)
         [2] (0.0, c_val, x_val)
         [3] (0.0, x_val, c_val)
         [4] (x_val, 0.0, c_val)
         | (c_val, 0.0, x_val)
      r = %clamp(rgb_base(0) + m, 0.0, 1.0)
      g = %clamp(rgb_base(1) + m, 0.0, 1.0)
      b = %clamp(rgb_base(2) + m, 0.0, 1.0)
      (r, g, b, c(3))

   hsv_to_srgb: Hsv => Rgba
   hsv_to_srgb = c =>
      hsv_to_rgba(c)

   // Alpha Blending
   alpha_blend: Rgba, Rgba => Rgba
   alpha_blend = src, dst =>
      src_a = src(3)
      dst_a = dst(3)
      inv_src_a = 1.0 - src_a
      out_a = src_a + dst_a * inv_src_a
      out_a < 1e-6
         | (0.0, 0.0, 0.0, 0.0)
         |
            r = (src(0) * src_a + dst(0) * dst_a * inv_src_a) / out_a
            g = (src(1) * src_a + dst(1) * dst_a * inv_src_a) / out_a
            b = (src(2) * src_a + dst(2) * dst_a * inv_src_a) / out_a
            (r, g, b, out_a)

   alpha_blend_linear: Rgba, Rgba => Rgba
   alpha_blend_linear = src, dst =>
      src_lin = srgb_to_linear(src)
      dst_lin = srgb_to_linear(dst)
      src_a = src_lin(3)
      dst_a = dst_lin(3)
      inv_src_a = 1.0 - src_a
      out_a = src_a + dst_a * inv_src_a
      out_a < 1e-6
         | (0.0, 0.0, 0.0, 0.0)
         |
            r = (src_lin(0) * src_a + dst_lin(0) * dst_a * inv_src_a) / out_a
            g = (src_lin(1) * src_a + dst_lin(1) * dst_a * inv_src_a) / out_a
            b = (src_lin(2) * src_a + dst_lin(2) * dst_a * inv_src_a) / out_a
            linear_to_srgb((r, g, b, out_a))

   // Perceptual Operations
   lerp: Color, Color, Float => Color
   lerp = c1, c2, t =>
      c1 + (c2 - c1) * t

   lerp_oklab: Rgba, Rgba, Float => Rgba
   lerp_oklab = c1, c2, t =>
      lab1 = rgba_to_oklab(c1)
      lab2 = rgba_to_oklab(c2)
      lab_res = lab1 + (lab2 - lab1) * t
      oklab_to_rgba(lab_res)

   adjust_lightness: Rgba, Float => Rgba
   adjust_lightness = c, delta =>
      lab = rgba_to_oklab(c)
      new_l = %clamp(lab(0) + delta, 0.0, 1.0)
      oklab_to_rgba((new_l, lab(1), lab(2), lab(3)))

   // --- Packed 24-bit TrueColor Integer Operations (0xRRGGBB) ---
   pack_rgb: Int, Int, Int => Int
   pack_rgb = r, g, b =>
      ((r .&. 0xFF) .<. 16) .|. ((g .&. 0xFF) .<. 8) .|. (b .&. 0xFF)

   rgb24: Int, Int, Int => Int
   rgb24 = r, g, b => pack_rgb(r, g, b)

   red24: Int => Int
   red24 = c => (c .>. 16) .&. 255

   green24: Int => Int
   green24 = c => (c .>. 8) .&. 255

   blue24: Int => Int
   blue24 = c => c .&. 255

   // Blend c1 and c2: t is 0..100 (percentage of c2)
   blend: Int, Int, Int => Int
   blend = c1, c2, t =>
      p = t < 0 | 0 | (t > 100 | 100 | t)
      inv = 100 - p
      r = (red24(c1) * inv + red24(c2) * p) / 100
      g = (green24(c1) * inv + green24(c2) * p) / 100
      b = (blue24(c1) * inv + blue24(c2) * p) / 100
      pack_rgb(r, g, b)

   // Lighten color by percent (0..100) towards white
   lighten: Int, Int => Int
   lighten = c, percent =>
      blend(c, 0xFFFFFF, percent)

   // Darken color by percent (0..100) towards black
   darken: Int, Int => Int
   darken = c, percent =>
      blend(c, 0x000000, percent)

   // Convert color to grayscale using standard ITU-R BT.601 perceptual weights
   grayscale: Int => Int
   grayscale = c =>
      y = (red24(c) * 299 + green24(c) * 587 + blue24(c) * 114) / 1000
      pack_rgb(y, y, y)

   // Relative luminance (0..1000)
   luminance: Int => Int
   luminance = c =>
      (red24(c) * 299 + green24(c) * 587 + blue24(c) * 114) / 1000

   // Parse hex string (e.g. "#RRGGBB", "RRGGBB", "#RGB", "RGB")
   from_hex_str: String => Int
   from_hex_str = s =>
      len = ?s
      len == 0 | --| 0
      start = s(0) == '#' | 1 | 0
      n = len - start
      n != 6 && n != 3 | --| 0
      val' = 0
      ok' = <+>
      start..len @ i =>
         ascii::hex_value(s(i))
            | d => val' = (val' .<. 4) .|. d
            |
               ok' = <->
               -->
      !ok' | --| 0
      n == 6
         | val'
         |
            r = (val' .>. 8) .&. 0xF
            g = (val' .>. 4) .&. 0xF
            b = val' .&. 0xF
            pack_rgb((r .<. 4) .|. r, (g .<. 4) .|. g, (b .<. 4) .|. b)

   // Format color as hex string ("#rrggbb")
   to_hex_str: Int => String
   to_hex_str = c =>
      buf = {7}
      buf += '#'
      (red24, green24, blue24) @ fn =>
         ch = fn(c)
         buf += ascii::hex_char_lower(ch .>. 4)
         buf += ascii::hex_char_lower(ch .&. 15)
      +buf

   // Constants
   BLACK = 0x000000
   WHITE = 0xffffff
