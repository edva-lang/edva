// Standard System Module (std/sys.dva)
// Exposes compiler and runtime parameters (argv, exit, STDIN/STDOUT/STDERR)

#use libc
#use mem

#public
   #foreign
      argc = sys_argc_global: Int
      argv_ptr = sys_argv_global: Addr

   STDIN  = 0
   STDOUT = 1
   STDERR = 2

   addr_is_null: ptr => <>
   addr_is_null = a => Int(a) == 0

   raw_argv: Int => < Addr | >
   raw_argv = n =>
      n [0..argc] | addr_opt(@[argv_ptr + n * #size Addr ptr])

   argv_matches: Int, String => <>
   argv_matches = n, s =>
      raw_argv(n)
         | raw => libc::strcmp(raw, s) == 0
         | <->

   c_str: Addr => String
   c_str = raw =>
      len = libc::strlen(raw)
      b = {len}
      mem::write_tail(b, len, (dst, n =>
         %memcpy(dst, raw, n)
         n
      ))
      +b

   argv_string: Int => String
   argv_string = n =>
      raw_argv(n) | raw => c_str(raw) | ""

   addr_opt: ptr => <Addr | >
   addr_opt = a => Int(a) != 0 | <+ Addr(a) +>

   argv: Int => <String | >
   argv = n =>
      raw_argv(n)
         | raw => <+ c_str(raw) +>
         | <-->

   exit: Int => ()
   exit = code => libc::exit $ code

   #type(packed) PollFd (
      fd: i32,
      events: i16,
      revents: i16
   )

   // Checks if descriptor has input ready within timeout_ms (-1 = infinite, 0 = non-blocking).
   poll_in: Int, Int => <>
   poll_in = fd, timeout_ms =>
      pfd' = PollFd(i32(fd), 1i16, 0i16)
      res = libc::poll(&pfd', 1, timeout_ms)
      res > 0 && (Int(pfd'.revents) .&. 1) != 0

   // Checks if descriptor is ready for writing within timeout_ms (-1 = infinite, 0 = non-blocking).
   poll_out: Int, Int => <>
   poll_out = fd, timeout_ms =>
      pfd' = PollFd(i32(fd), 4i16, 0i16)
      res = libc::poll(&pfd', 1, timeout_ms)
      res > 0 && (Int(pfd'.revents) .&. 4) != 0
