// Standard C Library (libc) Module for Dva
// Exposes POSIX libc system calls via foreign "c" bindings

#public #foreign "c"
    open      : (path: String, flags: Int) => Int
    open_mode = open: (path: String, flags: Int, mode: Int) => Int
    creat     : (path: String, mode: Int) => Int
    close     : (fd: Int) => Int
    posix_spawn : (pid: Addr, path: String, acts: Addr, attr: Addr, argv: Addr, envp: Addr) => Int
    posix_spawnp : (pid: Addr, file: String, acts: Addr, attr: Addr, argv: Addr, envp: Addr) => Int
    waitpid     : (pid: Int, status_ptr: Addr, options: Int) => Int
    read      : (fd: Int, buf: Addr, count: Int) => Int
    lseek     : (fd: Int, offset: Int, whence: Int) => Int
    write     : (fd: Int, buf: String, count: Int) => Int
    write_ptr = write: (fd: Int, buf: Addr, count: Int) => Int
    writev    : (fd: Int, iov: Addr, iovcnt: Int) => Int
    ioctl     : (fd: Int, request: Int, arg: Int) => Int
    malloc    : (size: Int) => Addr
    free      : (Addr: Addr) => ()
    exit      : (code: Int) => ()
    htons     : (hostshort: Int) => Int
    htonl     : (hostlong: Int) => Int
    ntohs     : (netshort: Int) => Int
    ntohl     : (netlong: Int) => Int
    inet_addr : (cp: String) => Int
    socket    : (domain: Int, type: Int, protocol: Int) => Int
    connect   : (sockfd: Int, addr: Addr, addrlen: Int) => Int
    bind      : (sockfd: Int, addr: Addr, addrlen: Int) => Int
    listen    : (sockfd: Int, backlog: Int) => Int
    accept    : (sockfd: Int, addr: Addr, addrlen_ptr: Addr) => Int
    send      : (sockfd: Int, buf: String, len: Int, flags: Int) => Int
    recv      : (sockfd: Int, buf: Addr, len: Int, flags: Int) => Int
    sendto    : (sockfd: Int, buf: String, len: Int, flags: Int, addr: Addr, addrlen: Int) => Int
    recvfrom  : (sockfd: Int, buf: Addr, len: Int, flags: Int, addr: Addr, addrlen: Addr) => Int
    setsockopt : (sockfd: Int, level: Int, optname: Int, optval: Addr, optlen: Int) => Int
    getsockopt : (sockfd: Int, level: Int, optname: Int, optval: Addr, optlen: Addr) => Int
    getpeername : (sockfd: Int, addr: Addr, addrlen_ptr: Addr) => Int
    getsockname : (sockfd: Int, addr: Addr, addrlen_ptr: Addr) => Int
    shutdown   : (sockfd: Int, how: Int) => Int
    c_fcntl = fcntl: (fd: Int, cmd: Int, arg: Int) => Int
    getaddrinfo : (node: String, service: String, hints: Addr, res: Addr) => Int
    freeaddrinfo : (res: Addr) => ()
    getifaddrs  : (ifap: Addr) => Int
    freeifaddrs : (ifa: Addr) => ()
    memset    : (Addr: Addr, val: Int, size: Int) => Addr
    atoi      : (s: String) => Int
    opendir   : (name: String) => Addr
    readdir   : (dirp: Addr) => Addr
    closedir  : (dirp: Addr) => Int
    strlen    : (s: Addr) => Int
    strcmp    : (s1: Addr, s2: String) => Int
    memcpy    : (dest: Addr, src: Addr, n: Int) => Addr
    memmove   : (dest: Addr, src: Addr, n: Int) => Addr
    stat      : (path: String, buf: Addr) => Int
    fstat     : (fd: Int, buf: Addr) => Int
    creat     : (path: String, mode: Int) => Int
    rename    : (oldpath: String, newpath: String) => Int
    unlink    : (path: String) => Int
    pipe      : (pipefd: Addr) => Int
    __errno_location : () => Addr
    mmap      : (a: Addr, l: Int, p: Int, f: Int, fd: Int, off: Int) => Addr
    munmap    : (a: Addr, l: Int) => Int
    syscall   : (Int, Addr, Addr, Addr, Addr, Addr, Addr) => Int
    dlopen    : (path: String, flags: Int) => Addr
    dlsym     : (handle: Addr, symbol: String) => Addr
    dlclose   : (handle: Addr) => Int
    dlerror   : () => Addr
    system    : (command: String) => Int
    realpath  : (path: String, resolved: Addr) => Addr
    isatty    : (fd: Int) => Int
    tcgetattr : (fd: Int, termios_p: Addr) => Int
    tcsetattr : (fd: Int, optional_actions: Int, termios_p: Addr) => Int
    cfmakeraw : (termios_p: Addr) => ()
    poll      : (fds: Addr, nfds: Int, timeout: Int) => Int
    epoll_create1 : (flags: Int) => Int
    epoll_ctl     : (epfd: Int, op: Int, fd: Int, event: Addr) => Int
    epoll_wait    : (epfd: Int, events: Addr, maxevents: Int, timeout: Int) => Int
    time      : (tloc: Addr) => Int
    signal    : (sig: Int, handler: Addr) => Addr
    raise     : (sig: Int) => Int
    getrlimit : (resource: Int, rlim: Addr) => Int
    setrlimit : (resource: Int, rlim: Addr) => Int
    uname     : (buf: Addr) => Int

#private
    ::os_darwin_cache = 0

#public
    is_darwin: () => <>
    is_darwin = !=>
       os_darwin_cache == 0
          |
             buf = {2048}
             uname(&buf)
             os_darwin_cache ::= (@[&buf i8] == 68i8 | 1 | 2)
       os_darwin_cache == 1

    fcntl: Int, Int, Int => Int
    fcntl = fd, cmd, arg =>
       eff_arg = is_darwin! && cmd == 4 && (arg .&. 2048) != 0 | ((arg .&. .!. 2048) .|. 4) | arg
       c_fcntl(fd, cmd, eff_arg)
