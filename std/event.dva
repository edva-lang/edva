// Standard Event Multiplexing Module (std/event.dva)
// Portable multi-descriptor event notification loop backed by POSIX poll(2).
//
// Relation to `std/poll` and `sys::poll_*`:
// - `std/poll` (`poll::poll_in`, `poll::stdin_ready`) and `sys::poll_in`/`sys::poll_out`
//   check readiness of a single file descriptor (`nfds = 1`) using a stack-allocated
//   `#packed` `PollFd` struct (`libc::poll(&pfd', 1, timeout_ms)`).
// - `std/event` multiplexes many descriptors simultaneously with associated user-data
//   tokens (`Poller`: `add`, `mod`, `del`, `wait`).
// - `Poller` stores its descriptor table in a typed growable array (`Event{}`),
//   needing no `@[]` raw memory access for bookkeeping. Only the flat C `struct pollfd[nfds]`
//   buffer passed to `libc::poll` in `wait` uses `@[]`, because `T{}` of records in Edva
//   is an array of record pointers whereas `poll(2)` requires contiguous 8-byte structs.

#use libc
#use sys

#public
   // Event type bitmasks
   READ     = 1      // Ready for reading (EPOLLIN / POLLIN)
   WRITE    = 2      // Ready for writing (EPOLLOUT / POLLOUT)
   PRI      = 4      // Exceptional condition (EPOLLPRI / POLLPRI)
   ERR      = 8      // Error condition (EPOLLERR / POLLERR)
   HUP      = 16     // Hang up (EPOLLHUP / POLLHUP)
   RDHUP    = 0x2000 // Peer closed write half of stream (EPOLLRDHUP)

   // epoll_ctl operation codes
   CTL_ADD  = 1
   CTL_DEL  = 2
   CTL_MOD  = 3

   // Event record returned from wait() and stored in Poller
   #type Event (
      fd: Int,
      events: Int,
      data: Int
   )

   // Internal C epoll_event layout (retained for compatibility)
   EpollEvent: #packed (
      events: u32,
      data:   u64
   )

   // Poller context
   #type Poller (
      epfd: Int,
      is_closed: <>,
      max_events: Int,
      entries: Event{}
   )

   // Create a new event poller with default capacity (64 concurrent events)
   new: () => <Poller | String>
   new = !=> new_with_cap(64)

   // Create a new event poller with specified maximum concurrent event capacity
   new_with_cap: Int => <Poller | String>
   new_with_cap = max_ev =>
      cap = max_ev > 0 | max_ev | 64
      <+ Poller(0, <->, cap, Event{}()) ->

   // Register descriptor with interest mask and user data token
   add: Poller, Int, Int, Int => <>
   add = p, fd, mask, user_data =>
      p.is_closed || fd < 0 | --| <->
      dup' = <->
      free_slot' = -1
      ?p.entries @ i =>
         e = p.entries(i)!!
         e.fd == fd | dup' = <+>
         e.fd < 0 && free_slot' < 0 | free_slot' = i
      dup' |->
      free_slot' !< 0
         |
            p.entries(free_slot') = Event(fd, mask, user_data)
            <+>
         | ?p.entries < p.max_events
            |
               p.entries += Event(fd, mask, user_data)
               <+>
            | <->

   // Convenience: register descriptor with mask, using fd itself as the data token
   add_fd: Poller, Int, Int => <>
   add_fd = p, fd, mask => add(p, fd, mask, fd)

   // Modify existing descriptor interest mask and user data token
   mod: Poller, Int, Int, Int => <>
   mod = p, fd, mask, user_data =>
      p.is_closed || fd < 0 | --| <->
      found' = <->
      ?p.entries @ i =>
         e = p.entries(i)!!
         e.fd == fd
            |
               p.entries(i) = Event(fd, mask, user_data)
               found' = <+>
               -->
      found'

   // Convenience: modify descriptor mask, using fd as data token
   mod_fd: Poller, Int, Int => <>
   mod_fd = p, fd, mask => mod(p, fd, mask, fd)

   // Deregister descriptor from the poller
   del: Poller, Int => <>
   del = p, fd =>
      p.is_closed || fd < 0 | --| <->
      found' = <->
      ?p.entries @ i =>
         e = p.entries(i)!!
         e.fd == fd
            |
               p.entries(i) = Event(-1, 0, 0)
               found' = <+>
               -->
      found'

   // Wait for readiness events up to timeout_ms (-1 = infinite, 0 = non-blocking poll)
   wait: Poller, Int => Event{}
   wait = p, timeout_ms =>
      res' = Event{}
      p.is_closed | --| res'
      pfds = {p.max_events * 8}
      idxs = Int{}
      nfds' = 0
      ?p.entries @ i =>
         e = p.entries(i)!!
         e.fd !< 0
            |
               emask = e.events
               pmask = ((emask .&. READ) != 0 | 1 | 0) .|.
                  ((emask .&. WRITE) != 0 | 4 | 0) .|.
                  ((emask .&. PRI) != 0 | 2 | 0)
               k = nfds'
               @[&pfds + k * 8] = i32(e.fd)
               @[&pfds + k * 8 + 4] = i16(pmask)
               @[&pfds + k * 8 + 6] = 0i16
               idxs += i
               nfds' = nfds' + 1
      n = libc::poll(&pfds, nfds', timeout_ms)
      n !> 0 | --| res'
      0..nfds' @ k =>
         rev = Int(@[&pfds + k * 8 + 6 i16]) .&. 0xFFFF
         rev != 0
            |
               slot = idxs(k)!!
               ev = p.entries(slot)!!
               ev_mask = ((rev .&. 1) != 0 | READ | 0) .|.
                  ((rev .&. 4) != 0 | WRITE | 0) .|.
                  ((rev .&. 2) != 0 | PRI | 0) .|.
                  ((rev .&. 8) != 0 | ERR | 0) .|.
                  ((rev .&. 16) != 0 | HUP | 0)
               res' += Event(ev.fd, ev_mask, ev.data)
      res'

   // Close and release poller resources
   close: Poller => ()
   close = p =>
      !p.is_closed |
         p.is_closed = <+>

   // Event inspection predicates
   is_read: Event => <>
   is_read = ev => (ev.events .&. READ) != 0

   is_write: Event => <>
   is_write = ev => (ev.events .&. WRITE) != 0

   is_err: Event => <>
   is_err = ev => (ev.events .&. ERR) != 0

   is_hup: Event => <>
   is_hup = ev => (ev.events .&. (HUP .|. RDHUP)) != 0

   // Single-descriptor poll helpers delegating to sys
   poll_in: Int, Int => <>
   poll_in = fd, timeout_ms => sys::poll_in(fd, timeout_ms)

   poll_out: Int, Int => <>
   poll_out = fd, timeout_ms => sys::poll_out(fd, timeout_ms)
