// std/math/complex.dva - Complex numbers & FFT library for Dva (#48)
//
// Fast arithmetic and Cooley-Tukey Radix-2 Fast Fourier Transform using
// hardware compiler intrinsics (%fma, %sqrt, %bitreverse, %clz, %popcount).

#use math

#public
   #type Complex (re: Float, im: Float)
   #type ComplexArray (Complex){}
   #type Floats (Float){}

   // --- Constructors & Constants ---

   make: Float, Float => Complex
   make = r, i => Complex((re = r, im = i))

   from_real: Float => Complex
   from_real = r => Complex((re = r, im = 0.0))

   zero: () => Complex
   zero = !=> Complex((re = 0.0, im = 0.0))

   one: () => Complex
   one = !=> Complex((re = 1.0, im = 0.0))

   i: () => Complex
   i = !=> Complex((re = 0.0, im = 1.0))

   // --- Field Accessors ---

   real: Complex => Float
   real = z => z.re

   imag: Complex => Float
   imag = z => z.im

   // --- Arithmetic Operations ---

   add: Complex, Complex => Complex
   add = a, b => Complex((re = a.re + b.re, im = a.im + b.im))

   sub: Complex, Complex => Complex
   sub = a, b => Complex((re = a.re - b.re, im = a.im - b.im))

   // Complex multiplication: (ac - bd) + (ad + bc)i
   // Uses %fma for fused multiply-add/sub precision and performance.
   mul: Complex, Complex => Complex
   mul = a, b =>
      r = %fma(0.0 - a.im, b.im, a.re * b.re)
      m = %fma(a.re, b.im, a.im * b.re)
      Complex((re = r, im = m))

   scale: Complex, Float => Complex
   scale = z, s => Complex((re = z.re * s, im = z.im * s))

   conj: Complex => Complex
   conj = z => Complex((re = z.re, im = 0.0 - z.im))

   // Squared norm: |z|^2 = re^2 + im^2
   norm_sq: Complex => Float
   norm_sq = z => %fma(z.re, z.re, z.im * z.im)

   // Absolute value / modulus: |z| = sqrt(re^2 + im^2)
   abs: Complex => Float
   abs = z => %sqrt(norm_sq(z))

   // Reciprocal: 1 / z
   inv: Complex => Complex
   inv = z =>
      d = norm_sq(z)
      Complex((re = z.re / d, im = (0.0 - z.im) / d))

   // Division: a / b
   div: Complex, Complex => Complex
   div = a, b =>
      d = norm_sq(b)
      r = %fma(a.im, b.im, a.re * b.re) / d
      m = %fma(0.0 - a.re, b.im, a.im * b.re) / d
      Complex((re = r, im = m))

   // Polar to Cartesian: r * (cos(theta) + i*sin(theta))
   polar: Float, Float => Complex
   polar = r, theta =>
      Complex((re = r * math::cos(theta), im = r * math::sin(theta)))

   // Complex phase angle (argument) in radians [-pi, pi]
   arg: Complex => Float
   arg = z => math::atan2(z.im, z.re)

   // Complex exponential: e^z = e^re * (cos(im) + i*sin(im))
   exp: Complex => Complex
   exp = z =>
      r = math::exp(z.re)
      Complex((re = r * math::cos(z.im), im = r * math::sin(z.im)))

   // --- Array Conversion Helpers ---

   from_real_array: Floats => ComplexArray
   from_real_array = reals =>
      out = ComplexArray()
      reals @ x => out += Complex((re = x, im = 0.0))
      out

   real_parts: ComplexArray => Floats
   real_parts = arr =>
      out = Floats()
      arr @ z => out += z.re
      out

   imag_parts: ComplexArray => Floats
   imag_parts = arr =>
      out = Floats()
      arr @ z => out += z.im
      out

   magnitudes: ComplexArray => Floats
   magnitudes = arr =>
      out = Floats()
      arr @ z => out += abs(z)
      out

   power_spectrum: ComplexArray => Floats
   power_spectrum = arr =>
      out = Floats()
      arr @ z => out += norm_sq(z)
      out

   // --- Fast Fourier Transform (Cooley-Tukey Radix-2) ---

   // In-place Radix-2 FFT kernel.
   // Uses %popcount, %clz, and %bitreverse for O(1) bit operations.
   fft_kernel: ComplexArray, <> => ComplexArray
   fft_kernel = input, invert =>
      n = ?input
      is_pow2 = n > 0 && (%popcount(n) == 1)
      !is_pow2
         | input
         |
            out = ComplexArray()
            n @ i => out += (input(i)!!)
            k = 63 - %clz(n)
            n @ j =>
               rev = (%bitreverse(j) .>. (64 - k)) .&. (n - 1)
               j < rev
                  |
                     tmp = out(j)!!
                     out(j) = out(rev)!!
                     out(rev) = tmp
                  | 0
            len' = 2
            k @ _ =>
               half = len' / 2
               sign = invert | 2.0 | (0.0 - 2.0)
               theta = (sign * math::pi) / Float(len')
               w_step = polar(1.0, theta)
               n_chunks = n / len'
               n_chunks @ c_i =>
                  start = c_i * len'
                  w' = one!
                  half @ j =>
                     u = out(start + j)!!
                     v = mul(out(start + j + half)!!, w')
                     out(start + j) = add(u, v)
                     out(start + j + half) = sub(u, v)
                     w' = mul(w', w_step)
               len' = len' * 2
            invert
               |
                  inv_n = 1.0 / Float(n)
                  n @ i =>
                     out(i) = scale(out(i)!!, inv_n)
               | 0
            out

   // Forward Fast Fourier Transform (time domain -> frequency domain)
   fft: ComplexArray => ComplexArray
   fft = input => fft_kernel(input, <->)

   // Inverse Fast Fourier Transform (frequency domain -> time domain)
   ifft: ComplexArray => ComplexArray
   ifft = input => fft_kernel(input, <+>)
