// Standard Filesystem Module (std/fs.dva)
// High-level safe abstractions for paths, file I/O, directory traversal, and filesystem stats.

#use libc
#use str
#use sys

#foreign "c"
   lstat: (path: String, buf: Addr) => Int
   readlink: (path: String, buf: Addr, bufsiz: Int) => Int
   mkdir: (path: String, mode: Int) => Int
   rmdir: (path: String) => Int
   statvfs: (path: String, buf: Addr) => Int
   getcwd: (buf: Addr, size: Int) => Addr
   getenv: (name: String) => Addr
   localtime_r: (timep: Addr, result: Addr) => Addr
   strftime: (s: Addr, max: Int, format: String, tm: Addr) => Int

#public

// Linux x86_64 struct stat layout (144 bytes)
#type StatRawLinux #packed (
   st_dev:     u64,
   st_ino:     u64,
   st_nlink:   u64,
   st_mode:    u32,
   st_uid:     u32,
   st_gid:     u32,
   pad0:       u32,
   st_rdev:    u64,
   st_size:    i64,
   st_blksize: i64,
   st_blocks:  i64,
   atime_sec:  i64,
   atime_nsec: i64,
   mtime_sec:  i64,
   mtime_nsec: i64,
   ctime_sec:  i64,
   ctime_nsec: i64,
   resv1:      i64,
   resv2:      i64,
   resv3:      i64
)

// Darwin (macOS arm64 / 64-bit inode) struct stat layout (144 bytes)
#type StatRawDarwin #packed (
   st_dev:         i32,
   st_mode:        u16,
   st_nlink:       u16,
   st_ino:         u64,
   st_uid:         u32,
   st_gid:         u32,
   st_rdev:        i32,
   pad0:           i32,
   atime_sec:      i64,
   atime_nsec:     i64,
   mtime_sec:      i64,
   mtime_nsec:     i64,
   ctime_sec:      i64,
   ctime_nsec:     i64,
   birthtime_sec:  i64,
   birthtime_nsec: i64,
   st_size:        i64,
   st_blocks:      i64,
   st_blksize:     i32,
   st_flags:       u32,
   st_gen:         u32,
   st_lspare:      i32,
   st_qspare0:     i64,
   st_qspare1:     i64
)

#type StatRaw #! (os ["darwin"] StatRawDarwin | StatRawLinux)

empty_stat: () => StatRaw
empty_stat = !=> StatRaw(..default)

// Linux x86_64 struct dirent prefix (19 bytes up to d_name)
#type DirentPrefixLinux #packed (
   d_ino:    u64,
   d_off:    u64,
   d_reclen: u16,
   d_type:   u8
)

// Darwin (macOS 64-bit inode) struct dirent prefix (21 bytes up to d_name)
#type DirentPrefixDarwin #packed (
   d_ino:     u64,
   d_seekoff: u64,
   d_reclen:  u16,
   d_namlen:  u16,
   d_type:    u8
)

#type DirentPrefix #! (os ["darwin"] DirentPrefixDarwin | DirentPrefixLinux)

// Linux x86_64 struct statvfs layout (112 bytes)
#type StatvfsLinux #packed (
   f_bsize:   u64,
   f_frsize:  u64,
   f_blocks:  u64,
   f_bfree:   u64,
   f_bavail:  u64,
   f_files:   u64,
   f_ffree:   u64,
   f_favail:  u64,
   f_fsid:    u64,
   f_flag:    u64,
   f_namemax: u64,
   f_spare0:  i32,
   f_spare1:  i32,
   f_spare2:  i32,
   f_spare3:  i32,
   f_spare4:  i32,
   f_spare5:  i32
)

// Darwin struct statvfs layout (64 bytes)
#type StatvfsDarwin #packed (
   f_bsize:   u64,
   f_frsize:  u64,
   f_blocks:  u32,
   f_bfree:   u32,
   f_bavail:  u32,
   f_files:   u32,
   f_ffree:   u32,
   f_favail:  u32,
   f_fsid:    u64,
   f_flag:    u64,
   f_namemax: u64
)

#type Statvfs #! (os ["darwin"] StatvfsDarwin | StatvfsLinux)

empty_statvfs: () => Statvfs
empty_statvfs = !=> Statvfs(..default)

// POSIX file mode bitfield layout (16 bits)
#type FileMode #packed u16 (
   other:   3,
   group:   3,
   user:    3,
   special: 3,
   fmt:     4
)

#type PermsBits #packed u16 (
   other_x: 1,
   other_w: 1,
   other_r: 1,
   group_x: 1,
   group_w: 1,
   group_r: 1,
   user_x:  1,
   user_w:  1,
   user_r:  1,
   sticky:  1,
   setgid:  1,
   setuid:  1,
   fmt:     4
)

#type Metadata (
   size: Int,
   mode: Int,
   mtime: Int,
   mtime_nsec: Int,
   atime: Int,
   is_dir: <>,
   is_file: <>,
   is_symlink: <>,
   is_exec: <>
)

#type DirEntry (
   name: String,
   is_dir: <>,
   is_file: <>,
   is_symlink: <>
)


#type FsSpace (
   total_bytes: Int,
   free_bytes: Int,
   available_bytes: Int
)

// --- Path Primitives ---

is_abs: String => <>
is_abs = p => ?p > 0 && p(0) == '/'

join: String, String => String
join = a, b =>
   ?b == 0 | --| a
   ?a == 0 || is_abs(b) | --| b
   a(?a - 1) == '/' | a + b | a + "/" + b

parent: String => String
parent = p =>
   len = ?p
   len == 0 | --| "."
   p == "/" | --| "/"
   end' = len
   p(end' - 1) == '/' && end' > 1 | end' = end' - 1
   last_slash' = -1
   end' @ i =>
      idx = end' - 1 - i
      p(idx) == '/' && last_slash' < 0 | last_slash' = idx
   last_slash' < 0 | "." |
      last_slash' == 0 | "/" |
         b = {last_slash'}
         last_slash' @ k => b += p(k)
         +b

basename: String => String
basename = p =>
   len = ?p
   len == 0 | --| ""
   p == "/" | --| "/"
   end' = len
   p(end' - 1) == '/' && end' > 1 | end' = end' - 1
   last_slash' = -1
   end' @ i =>
      idx = end' - 1 - i
      p(idx) == '/' && last_slash' < 0 | last_slash' = idx
   start' = last_slash' < 0 | 0 | last_slash' + 1
   n = end' - start'
   n !> 0 | --| ""
   b = {n}
   n @ k => b += p(start' + k)
   +b

ext: String => String
ext = name =>
   len = ?name
   dot' = -1
   len @ i =>
      idx = len - 1 - i
      name(idx) == '.' && dot' < 0 && idx > 0 | dot' = idx
   dot' < 0 | "" |
      n = len - dot'
      b = {n}
      n @ k => b += name(dot' + k)
      +b

cwd: () => String
cwd = !=>
   buf = {1024}
   res = getcwd(&buf, 1024)
   res == sys::addr_null | "." | sys::c_str(res)

home: () => String
home = !=>
   h = getenv("HOME")
   h == sys::addr_null | "/" | sys::c_str(h)

resolve: String => String
resolve = p =>
   len = ?p
   len == 0 | --| cwd!
   p == "~" | --| home!
   p(..2) == "~/" | --| join(home!, p(2..))
   full = is_abs(p) | p | join(cwd!, p)
   real = libc::realpath(full, sys::addr_null)
   real == sys::addr_null | full |
      s = sys::c_str(real)
      libc::free(real)
      s

// Compatibility Path Aliases
join_path: String, String => String
join_path = a, b => join(a, b)

parent_path: String => String
parent_path = p => parent(p)

resolve_path: String => String
resolve_path = p => resolve(p)

get_home: () => String
get_home = !=> home!

get_ext: String => String
get_ext = name =>
   len = ?name
   last_dot' = -1
   len @ i =>
      idx = len - 1 - i
      name(idx) == '.' && last_dot' < 0 | last_dot' = idx
   last_dot' > 0 && last_dot' < (len - 1)
      |
         n = len - (last_dot' + 1)
         b = {n}
         n @ k => b += name(last_dot' + 1 + k)
         +b
      | ""

// --- Metadata & Queries ---

stat_mode: StatRaw => Int
stat_mode = s => Int(s.st_mode)

stat_size: StatRaw => Int
stat_size = s => Int(s.st_size)

stat_mtime_sec: StatRaw => Int
stat_mtime_sec = s => Int(s.mtime_sec)

stat_mtime_nsec: StatRaw => Int
stat_mtime_nsec = s => Int(s.mtime_nsec)

stat_atime_sec: StatRaw => Int
stat_atime_sec = s => Int(s.atime_sec)

make_metadata: StatRaw, <> => Metadata
make_metadata = s, is_link =>
   m = stat_mode(s)
   fm = FileMode(m)
   fmt = fm.fmt
   is_d = fmt == 4
   is_reg = fmt == 8
   is_l = is_link || fmt == 10
   pb = PermsBits(m)
   is_x = (pb.user_x != 0 || pb.group_x != 0 || pb.other_x != 0) && !is_d
   Metadata((
      stat_size(s),
      m,
      stat_mtime_sec(s),
      stat_mtime_nsec(s),
      stat_atime_sec(s),
      is_d,
      is_reg,
      is_l,
      is_x
   ))

stat: String => <Metadata | >
stat = path =>
   s' = empty_stat!
   rc = libc::stat(path, &s')
   rc != 0 |-->
   <+ make_metadata(s', <->) +>

lstat_meta: String => <Metadata | >
lstat_meta = path =>
   s' = empty_stat!
   rc = lstat(path, &s')
   rc != 0 |-->
   m = stat_mode(s')
   fm = FileMode(m)
   is_link = fm.fmt == 10
   <+ make_metadata(s', is_link) +>

exists: String => <>
exists = path =>
   s' = empty_stat!
   libc::stat(path, &s') == 0

is_file: String => <>
is_file = path =>
   m = stat(path)
   m | info => info.is_file | <->

is_dir: String => <>
is_dir = path =>
   m = stat(path)
   m | info => info.is_dir | <->

is_symlink: String => <>
is_symlink = path =>
   m = lstat_meta(path)
   m | info => info.is_symlink | <->

mtime: String => Int
mtime = path =>
   m = stat(path)
   m | info => info.mtime | 0

mtime_ns: String => Int
mtime_ns = path =>
   s' = empty_stat!
   libc::stat(path, &s') == 0
      | stat_mtime_sec(s') * 1000000000 + stat_mtime_nsec(s')
      | -1

size: String => Int
size = path =>
   m = stat(path)
   m | info => info.size | 0

readlink_path: String => <String | >
readlink_path = path =>
   buf = {1024}
   n = readlink(path, &buf, 1024)
   n !> 0 |-->
   ?buf = n
   <+ +buf +>

path_exists: String => <>
path_exists = p => exists(p)

path_mtime: String => Int
path_mtime = p => mtime(p)

read_symlink: String => String
read_symlink = p =>
   readlink_path(p) | s => s | ""

// --- Directory Traversal ---

read_dir: String => (DirEntry){}
read_dir = dir_path =>
   res = (DirEntry){}
   dp = libc::opendir(dir_path)
   dp == sys::addr_null | --| res
   0.. @
      ent = libc::readdir(dp)
      ent == sys::addr_null | -->
      name = sys::c_str(ent + #size(DirentPrefix))
      name == "." || name == ".." | --^
      dp_ent = DirentPrefix(ent)
      dt = Int(dp_ent.d_type)
      is_d = dt == 4
      is_f = dt == 8
      is_l = dt == 10
      // If filesystem returns DT_UNKNOWN (0), fall back to lstat
      dt == 0 |
         sub_p = join(dir_path, name)
         meta = lstat_meta(sub_p)
         meta | mi =>
            is_d = mi.is_dir
            is_f = mi.is_file
            is_l = mi.is_symlink
      res += DirEntry((name, is_d, is_f, is_l))
   libc::closedir(dp)
   res

// --- File CRUD & Operations ---

open_wronly_creat_trunc: () => Int
open_wronly_creat_trunc = !=> #! (os ["darwin"] 1537 | 577)

read_to_string: String => <String | >
read_to_string = path =>
   fd = libc::open(path, 0)
   fd < 0 |-->
   s' = empty_stat!
   rc = libc::fstat(fd, &s')
   sz = rc == 0 | %max(stat_size(s'), 0) | 0
   sz > 0
      |
         buf = {sz}
         n = libc::read(fd, &buf, sz)
         libc::close(fd)
         n
            [< 0]
               <-->
            [0]
               <+ "" +>
            |
               ?buf = n
               <+ +buf +>
      |
         b' = ++""
         chunk = {4096}
         read_err' = <->
         0.. @
            n = libc::read(fd, &chunk, 4096)
            n < 0
               |
                  read_err' = <+>
                  -->
            n == 0 | -->
            ?chunk = n
            b' = b' + (+chunk)
         libc::close(fd)
         read_err'
            | <-->
            | <+ b' +>

write_file: String, String => <>
write_file = path, content =>
   fd = libc::open_mode(path, open_wronly_creat_trunc!, 0o644) // O_WRONLY | O_CREAT | O_TRUNC
   fd < 0 |->
   len = ?content
   off' = 0
   ok' = <+>
   0.. @
      off' !< len | -->
      v = content(off'..len)
      w = libc::write(fd, v, ?v)
      w !> 0
         |
            ok' = <->
            -->
         | off' = off' + w
   rc = libc::close(fd)
   ok' && rc == 0

copy_file: String, String => <>
copy_file = src_path, dst_path =>
   s_fd = libc::open(src_path, 0)
   s_fd < 0 |->
   d_fd = libc::open_mode(dst_path, open_wronly_creat_trunc!, 0o644)
   d_fd < 0 |
      libc::close(s_fd)
      --| <->
   buf = {16384}
   ok' = <+>
   0.. @
      n = libc::read(s_fd, &buf, 16384)
      n !> 0 | -->
      w = libc::write_ptr(d_fd, &buf, n)
      w != n |
         ok' = <->
         -->
   libc::close(s_fd)
   libc::close(d_fd)
   ok'

rename_path: String, String => <>
rename_path = old_p, new_p => libc::rename(old_p, new_p) == 0

create_file: String => <>
create_file = p => write_file(p, "")

create_dir: String => <>
create_dir = path => mkdir(path, 0o755) == 0

create_dir_all: String => <>
create_dir_all = path =>
   is_dir(path) | <+> |
      p = parent(path)
      p != "" && p != path && !is_dir(p) |
         ok = create_dir_all(p)
         !ok | --| <->
      create_dir(path)

remove: String => <>
remove = path =>
   is_dir(path) && !is_symlink(path)
      | rmdir(path) == 0
      | libc::unlink(path) == 0

delete_entry: String, <> => <>
delete_entry = p, is_d => remove(p)

write_text_file: String, String => <>
write_text_file = path, content => write_file(path, content)

remove_all: String => <>
remove_all = path =>
   !exists(path) && !is_symlink(path) | <+> |
      is_dir(path) && !is_symlink(path)
         |
            ents = read_dir(path)
            all_ok' = <+>
            ents @ e =>
               sub = join(path, e.name)
               sub_ok = remove_all(sub)
               !sub_ok | all_ok' = <->
            !all_ok' | --| <->
            rmdir(path) == 0
         |
            libc::unlink(path) == 0

// --- Filesystem Space & Statvfs ---

space: String => <FsSpace | >
space = path =>
   st' = empty_statvfs!
   rc = statvfs(path, &st')
   rc != 0 |-->
   frsize = Int(st'.f_frsize)
   eff_frsize' = frsize == 0 | Int(st'.f_bsize) | frsize
   eff_frsize' = eff_frsize' == 0 | 4096 | eff_frsize'
   blocks = Int(st'.f_blocks)
   bfree = Int(st'.f_bfree)
   bavail = Int(st'.f_bavail)
   total = blocks * eff_frsize'
   free = bfree * eff_frsize'
   avail = bavail * eff_frsize'
   <+ FsSpace((total, free, avail)) +>

get_fs_stats: String => (Int, Int, Int, Int)
get_fs_stats = p =>
   sp = space(p)
   sp
      | s =>
         gb_div = 0x40000000
         total_bytes = s.total_bytes
         free_bytes = s.available_bytes
         used_bytes = total_bytes > free_bytes | total_bytes - free_bytes | 0
         total_gb = total_bytes / gb_div
         free_gb = free_bytes / gb_div
         used_gb = used_bytes / gb_div
         pct = total_bytes > 0 | (used_bytes * 100) / total_bytes | 0
         (used_gb, total_gb, pct, free_gb)
      | (0, 0, 0, 0)

// --- Formatting & High-Level Helpers ---

format_size: Int, <> => String
format_size = sz, is_d =>
   is_d | --| "DIR"
   sz
      [< 0x400] "${sz} B"
      [< 0x100000] "${sz / 0x400} KB"
      [< 0x40000000] "${sz / 0x100000} MB"
      | "${sz / 0x40000000} GB"

format_perms: Int, <> => String
format_perms = mode, is_d =>
   pb = PermsBits(mode)
   b = {16}
   b += is_d | 'd' | '-'
   b += pb.user_r != 0 | 'r' | '-'
   b += pb.user_w != 0 | 'w' | '-'
   b += pb.user_x != 0 | 'x' | '-'
   b += pb.group_r != 0 | 'r' | '-'
   b += pb.group_w != 0 | 'w' | '-'
   b += pb.group_x != 0 | 'x' | '-'
   b += pb.other_r != 0 | 'r' | '-'
   b += pb.other_w != 0 | 'w' | '-'
   b += pb.other_x != 0 | 'x' | '-'
   +b

format_time: Int => String
format_time = ts =>
   ts == 0 | --| "-"
   t_val = i64(ts)
   tm_buf = {64}
   res = localtime_r(&t_val, &tm_buf)
   res == sys::addr_null | --| "-"
   out_buf = {64}
   len = strftime(&out_buf, 64, "%Y-%m-%d %H:%M", &tm_buf)
   len !> 0 | --| "-"
   ?out_buf = len
   +out_buf

format_number: Int => String
format_number = n =>
   s_full = %to_str(n)
   is_neg = ?s_full > 0 && s_full(0) == '-'
   s = is_neg | s_full(1..) | s_full
   len = ?s
   len < 4 | --| s_full
   b = {32}
   is_neg | b += '-'
   rem' = len % 3
   rem' == 0 | rem' = 3
   len @ i =>
      i > 0 && (i - rem') % 3 == 0 | b += ','
      b += s(i)
   +b

octal_perms: Int => String
octal_perms = mode =>
   fm = FileMode(mode)
   s = fm.special
   u = fm.user
   g = fm.group
   o = fm.other
   s > 0 | "${s}${u}${g}${o}" | "0${u}${g}${o}"

auto_rename_path: String => String
auto_rename_path = full_p =>
   dir_raw = parent(full_p)
   dir_part = dir_raw == "." | "" | dir_raw
   name_part = basename(full_p)

   dot_idx' = -1
   n_len = ?name_part
   n_len @ j =>
      j_idx = n_len - 1 - j
      name_part(j_idx) == '.' && dot_idx' < 0 && j_idx > 0 | dot_idx' = j_idx

   base_name = dot_idx' !< 0 | name_part(..dot_idx') | name_part
   ext_part = dot_idx' !< 0 | name_part(dot_idx'..) | ""

   cand_path' = full_p
   1..1000 @ num =>
      cand = dir_part != ""
         | "${dir_part}/${base_name} (${num})${ext_part}"
         | "${base_name} (${num})${ext_part}"
      !exists(cand) |
         cand_path' = cand
         -->
   cand_path'

#type Entry (
   name: String,
   is_dir: <>,
   is_exec: <>,
   size: Int,
   fmt_size: String,
   perms: String,
   mtime: Int,
   mode: Int
)

cmp_entries: Entry, Entry, Int, <> => Int
cmp_entries = e1, e2, mode, rev =>
   res' = 0
   mode
      [0] // Name
         res' = str::cmp(e1.name, e2.name)
      [1] // Size
         res' = e1.size < e2.size | -1 | (e1.size > e2.size | 1 | str::cmp(e1.name, e2.name))
      [2] // Mtime
         res' = e1.mtime < e2.mtime | -1 | (e1.mtime > e2.mtime | 1 | str::cmp(e1.name, e2.name))
      [3] // Extension
         ext1 = ext(e1.name)
         ext2 = ext(e2.name)
         cmp_ext = str::cmp(ext1, ext2)
         res' = cmp_ext != 0 | cmp_ext | str::cmp(e1.name, e2.name)
      |
         res' = str::cmp(e1.name, e2.name)
   rev | -res' | res'

list_dir_simple: String => (Entry){}
list_dir_simple = dir_path =>
   list_dir(dir_path, <->, 0, <->)

list_dir: String, <>, Int, <> => (Entry){}
list_dir = dir_path, show_hidden, sort_mode, sort_rev =>
   res = (Entry){}
   entries = read_dir(dir_path)

   dirs = (Entry){}
   file_list = (Entry){}

   entries @ e =>
      name = e.name
      !show_hidden && ?name > 0 && name(0) == '.' | --^

      full_path = join(dir_path, name)
      meta = stat(full_path)
      is_d' = e.is_dir
      is_x' = <->
      size' = 0
      mtime' = 0
      mode' = 0

      meta | m =>
         size' = m.size
         mtime' = m.mtime
         mode' = m.mode
         is_d' = m.is_dir
         is_x' = m.is_exec

      fmt_sz = format_size(size', is_d')
      perms = format_perms(mode', is_d')
      entry = Entry((name, is_d', is_x', size', fmt_sz, perms, mtime', mode'))

      is_d' | dirs += entry | file_list += entry

   // Insertion sort dirs
   nd = ?dirs
   nd @ i =>
      (nd - 1) @ j =>
         d1 = dirs(j)!!
         d2 = dirs(j + 1)!!
         cmp_entries(d1, d2, sort_mode, sort_rev) > 0 |
            dirs(j) = d2
            dirs(j + 1) = d1

   // Insertion sort file_list
   nf = ?file_list
   nf @ i =>
      (nf - 1) @ j =>
         f1 = file_list(j)!!
         f2 = file_list(j + 1)!!
         cmp_entries(f1, f2, sort_mode, sort_rev) > 0 |
            file_list(j) = f2
            file_list(j + 1) = f1

   // Merge dirs + file_list into res
   dirs @ dir_item => res += dir_item
   file_list @ file_item => res += file_item
   res
