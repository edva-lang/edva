// std/json.dva — JSON parser and value model.
//
// Error convention: every entry point returns `<Value | Error>` where the
// negative branch is the structural `Error` record (code, message, file,
// line, col, context) — *fatal* by design: unwrapping it (binding it in a
// choice) aborts the program and prints the diagnostic. Contrast with the
// recoverable `<T | String>` message regime in std/net (see M8 in
// process/codebase_review.md).
//
// A JSON document parses into a recursive `Value` enum: String(String),
// Number(Float), Boolean(<>), Null, Array(Value[]) and
// Object(pairs[]) where pairs are (key, value) records. Array/Object
// hold slice views over the parse arenas (the module-level `vals`/
// `pairs` growable arrays), which the parser fills element-by-element.
// The parser is a stateful recursive descent over the module-level
// `src`/`pos`; '::=' mutates those globals (a function's '=' would
// shadow them with a fresh local). Errors are the core Error ram:
// `parse` returns <Value | Error>, and unwrapping the Error branch
// aborts with the diagnostic.

#use const
#use ascii
#use str
#use utf

#public
   #type Value <
       String(String)
       Number(Float)
       Boolean(<>)
       Null
       Array(Value[])
       Object((key: String, value: Value)[])
   >

   #type Values Value{}
   #type Pairs (key: String, value: Value){}
   #type Result <Value | Error>

src: String
pos: Int

// --- scanning ------------------------------------------------

// True when src[p] exists and is JSON whitespace.
is_ws_at: Int => i1
is_ws_at = p => p < ?src && str::is_ws(src(p))

// The first index at or after p that is not whitespace.
skip_ws: Int => Int
skip_ws = p =>
   is_ws_at(p) | skip_ws(p + 1) | p

// The value of a hex digit, or -1 when not a hex digit.
hexval: Int => Int
hexval = h =>
   ascii::hex_value(h) | _ | -1

// True when src[p] exists and is a hex digit.
is_hex_at: Int => <>
is_hex_at = p => p < ?src && ascii::is_hex(src(p))

// The String spelling of a Flag boolean.
bool_str: i1 => String
bool_str = b => b | "true" | "false"

// --- string scanning ------------------------------------------------

// Validate and append a raw UTF-8 sequence starting at index k with lead byte c0.
scan_utf8_char: Builder, Int, Int => <Int | Error>
scan_utf8_char = b, k, _c0 =>
   dec = utf::decode_str_at(src, k)
   dec.0 < 0
      | <- Error(400, "json: invalid UTF-8 in string", "std/json.dva", 0, 0, (k, 0)) +>
      |
         b += src(k..k + dec.1)
         scan_string(b, k + dec.1)

// Scan the body of a string literal starting at index k (after the
// opening quote), appending decoded bytes to b. Returns <Int | Error>:
// the positive slot is the index of the closing quote.
scan_string: Builder, Int => <Int | Error>
scan_string = b, k =>
   k !< ?src | <- Error(400, "json: unterminated string", "std/json.dva", 0, 0, (k, 0)) +>
   c = src(k)
   c
   ['"] <+ k ->
   ['\\] parse_escape(b, k)
   [< 0x20] <- Error(400, "json: control character in string",
   "std/json.dva", 0, 0, (k, 0)) +>
   [< 0x80]
      b += c
      scan_string(b, k + 1)
   |
      scan_utf8_char(b, k, c)

// Handle a backslash escape at index k (k is the '\').
parse_escape: Builder, Int => <Int | Error>
parse_escape = b, k =>
   e = k + 1 [< ?src] src(k + 1) | -1
   e == 'u | --| parse_unicode(b, k)
   b += (e
      ['", '\\, '/] e
      ['b] '\b
      ['f] '\f
      ['n] '\n
      ['r] '\r
      ['t] '\t
      | --| <- Error(400, "json: bad escape", "std/json.dva", 0, 0, (k, 0)) +>)
   scan_string(b, k + 2)

// A \uXXXX escape at index k (k is the '\', k+1 is 'u'). Supports BMP
// and supplementary characters via UTF-16 surrogate pairs.
parse_unicode: Builder, Int => <Int | Error>
parse_unicode = b, k =>
   h2 = is_hex_at(k + 2)
   h3 = is_hex_at(k + 3)
   h4 = is_hex_at(k + 4)
   h5 = is_hex_at(k + 5)
   ok = h2 && h3 && h4 && h5
   ok |
      d2 = hexval(src(k + 2))
      d3 = hexval(src(k + 3))
      d4 = hexval(src(k + 4))
      d5 = hexval(src(k + 5))
      cp = d2 * 0x1000 + d3 * 0x100 + d4 * 0x10 + d5
      parse_unicode_cp(b, k, cp)
   | <- Error(400, "json: bad \\u escape",
   "std/json.dva", 0, 0, (k, 0)) +>

parse_unicode_cp: Builder, Int, Int => <Int | Error>
parse_unicode_cp = b, k, cp =>
   cp
      [0xD800...0xDBFF] parse_surrogate_pair(b, k, cp)
      [0xDC00...0xDFFF] <- Error(400, "json: unpaired low surrogate", "std/json.dva", 0, 0, (k, 0)) +>
      |
         utf::append_rune(b, Rune(cp))
         scan_string(b, k + 6)

parse_surrogate_pair: Builder, Int, Int => <Int | Error>
parse_surrogate_pair = b, k, cp =>
   has_second = k + 11 < ?src && src(k + 6) == '\\ && src(k + 7) == 'u && is_hex_at(k + 8) && is_hex_at(k + 9) && is_hex_at(k + 10) && is_hex_at(k + 11)
   has_second |
      l2 = hexval(src(k + 8))
      l3 = hexval(src(k + 9))
      l4 = hexval(src(k + 10))
      l5 = hexval(src(k + 11))
      locp = l2 * 0x1000 + l3 * 0x100 + l4 * 0x10 + l5
      locp [0xDC00...0xDFFF]
         full_cp = 0x10000 + (cp - 0xD800) * 0x400 + (locp - 0xDC00)
         utf::append_rune(b, Rune(full_cp))
         scan_string(b, k + 12)
      | <- Error(400, "json: bad low surrogate", "std/json.dva", 0, 0, (k, 0)) +>
   | <- Error(400, "json: missing low surrogate", "std/json.dva", 0, 0, (k, 0)) +>

// --- number scanning ------------------------------------------------

// True when src[p] exists and is a digit.
is_digit_at: Int => i1
is_digit_at = p => p < ?src && str::is_digit(src(p))

// --- value parsing ------------------------------------------------

parse_string: () => <Value | Error>
parse_string = !=>
   pos ::= pos + 1
   b = {64}
   r = scan_string(b, pos)
   r | end =>
         pos ::= end + 1
         <+ Value(String, +b) ->
   | err =>
         <- err +>

parse_array: () => <Value | Error>
parse_array = !=>
   pos ::= pos + 1
   p = skip_ws(pos)
   pos ::= p
   c = p [< ?src] src(p) | -1
   c [']]
      pos ::= pos + 1
      elems = Values()
      <+ Value(Array, elems(0..0)) ->
   |
      elems = Values()
      parse_array_loop(elems)

parse_array_loop: Values => <Value | Error>
parse_array_loop = elems =>
   v = parse_value!
   parse_array_after_value(elems, v)

parse_array_after_value: Values, <Value | Error> => <Value | Error>
parse_array_after_value = elems, v =>
   v | val =>
         elems += val
         p = skip_ws(pos)
         pos ::= p
         c = p [< ?src] src(p) | -1
         c [']]
            pos ::= pos + 1
            n = ?elems
            <+ Value(Array, elems(0..n)) ->
         [',]
            pos ::= pos + 1
            p2 = skip_ws(pos)
            c2 = p2 [< ?src] src(p2) | -1
            c2 [']]
               <- Error(400, "json: trailing comma in array", "std/json.dva", 0, 0, (p2, 0)) +>
            |
               parse_array_loop(elems)
         |
            <- Error(400, "json: expected ',' or ']' in array", "std/json.dva", 0, 0, (p, 0)) +>
   | e => <- e +>

parse_object: () => <Value | Error>
parse_object = !=>
   pos ::= pos + 1
   p = skip_ws(pos)
   pos ::= p
   c = p [< ?src] src(p) | -1
   c ['}]
      pos ::= pos + 1
      entries = Pairs()
      <+ Value(Object, entries(0..0)) ->
   |
      entries = Pairs()
      parse_object_loop(entries)

parse_object_loop: Pairs => <Value | Error>
parse_object_loop = entries =>
   p = skip_ws(pos)
   pos ::= p
   c = p [< ?src] src(p) | -1
   c ['"]
      k = parse_string!
      parse_object_after_key(entries, k)
   |
      <- Error(400, "json: expected string key in object", "std/json.dva", 0, 0, (p, 0)) +>

parse_object_after_key: Pairs, <Value | Error> => <Value | Error>
parse_object_after_key = entries, k =>
   k | key =>
         key [String s]
            p = skip_ws(pos)
            pos ::= p
            ok_col = p < ?src && src(p) == ':
            ok_col |
               pos ::= pos + 1
               v = parse_value!
               parse_object_after_val(entries, s, v)
            | <- Error(400, "json: expected ':' after object key", "std/json.dva", 0, 0, (p, 0)) +>
         | <- Error(400, "json: object key is not a string", "std/json.dva", 0, 0, (0, 0)) +>
   | e => <- e +>

parse_object_after_val: Pairs, String, <Value | Error> => <Value | Error>
parse_object_after_val = entries, s, v =>
   v | val =>
         entries += (s, val)
         p = skip_ws(pos)
         pos ::= p
         c = p [< ?src] src(p) | -1
         c ['}]
            pos ::= pos + 1
            m = ?entries
            <+ Value(Object, entries(0..m)) ->
         [',]
            pos ::= pos + 1
            p2 = skip_ws(pos)
            c2 = p2 [< ?src] src(p2) | -1
            c2 ['}]
               <- Error(400, "json: trailing comma in object", "std/json.dva", 0, 0, (p2, 0)) +>
            |
               parse_object_loop(entries)
         |
            <- Error(400, "json: expected ',' or '}' in object", "std/json.dva", 0, 0, (p, 0)) +>
   | e2 => <- e2 +>

parse_lit: <>, Int => <Value | Error>
parse_lit = tag, len =>
   p = skip_ws(pos)
   pos ::= p
   word = tag | "true" | "false"
   ok = p + len !> ?src && src(p..p + len) == word
   ok |
      pos ::= p + len
      <+ Value(Boolean, tag) ->
   | <- Error(400, "json: bad literal", "std/json.dva", 0, 0, (p, 0)) +>

parse_null: () => <Value | Error>
parse_null = !=>
   p = skip_ws(pos)
   pos ::= p
   ok = p + 4 !> ?src && src(p..p + 4) == "null"
   ok |
      pos ::= p + 4
      <+ Value(Null) ->
   | <- Error(400, "json: bad null literal",
   "std/json.dva", 0, 0, (p, 0)) +>

parse_number: () => <Value | Error>
parse_number = !=>
   p' = skip_ws(pos)
   pos ::= p'
   c0 = p' [< ?src] src(p') | -1
   is_num_start = c0 !< '0 && c0 !> '9 || c0 == '-
   is_num_start |
      neg' = <->
      c0 ['-]
         neg' = <+>
         p' = p' + 1
      has_leading_zero = p' < ?src && src(p') == '0 && p' + 1 < ?src && is_digit_at(p' + 1)
      has_leading_zero |
         <- Error(400, "json: leading zero not allowed", "std/json.dva", 0, 0, (p', 0)) +>
      |
         p2' = p'
         had_int' = <->
         sig_digits' = 0
         fv' = 0.0
         exp10' = 0
         0.. @
            p2' !< ?src | -->
            c = src(p2')
            c !< '0 && c !> '9
               |
                  had_int' = <+>
                  d = c - '0
                  sig_digits' > 0 || d != 0
                     |
                        sig_digits' < 17
                           |
                              fv' = fv' * 10.0 + Float(d)
                              sig_digits' = sig_digits' + 1
                           |
                              exp10' = exp10' + 1
                  p2' = p2' + 1
               | -->
         has_dot = (p2' < ?src && src(p2') == '.)
         had_frac' = <->
         has_dot |
            p2' = p2' + 1
            0.. @
               p2' !< ?src | -->
               c = src(p2')
               c !< '0 && c !> '9
                  |
                     had_frac' = <+>
                     d = c - '0
                     (sig_digits' == 0 && d == 0)
                        |
                           exp10' = exp10' - 1
                        |
                           sig_digits' < 17 |
                              fv' = fv' * 10.0 + Float(d)
                              sig_digits' = sig_digits' + 1
                              exp10' = exp10' - 1
                     p2' = p2' + 1
                  | -->
         has_exp = (p2' < ?src && (src(p2') == 'e || src(p2') == 'E))
         had_exp' = <->
         has_exp |
            p3' = p2' + 1
            eneg' = <->
            e0 = p3' [< ?src] src(p3') | -1
            e0 ['-]
               eneg' = <+>
               p3' = p3' + 1
            plus = (e0 == '+)
            plus |
               p3' = p3' + 1
            ev' = 0
            over_exp' = <->
            had_exp_digits' = <->
            0.. @
               p3' !< ?src | -->
               ec = src(p3')
               ec ['0...'9]
                  |
                     had_exp_digits' = <+>
                     ed = ec - '0
                     ev' > 0xF4240
                        | (over_exp' = <+>)
                        | (ev' = ev' * 10 + ed)
                     p3' = p3' + 1
                  | -->
            had_exp' = had_exp_digits'
            p2' = p3'
            exp_val = over_exp' | 0xF4240 | ev'
            exp10' = eneg' | exp10' - exp_val | exp10' + exp_val
         fv' != 0.0 |
            eclamp = exp10' < -400 | -400 | (exp10' > 400 | 400 | exp10')
            abs_e = eclamp < 0 | 0 - eclamp | eclamp
            abs_e @
               fv' = eclamp < 0 | fv' / 10.0 | fv' * 10.0
         // JSON number grammar: -?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)? — digits
         // are required after '-', after '.', and after the exponent marker
         // (a bare '-', "1.", or "1e" must be rejected, not parsed as 0 / 1.0).
         valid = (had_int' && (!has_dot || had_frac') && (!has_exp || had_exp'))
         valid
            |
               f = (neg' | 0 - fv' | fv')
               pos ::= p2'
               <+ Value(Number, f) ->
            |
               <- Error(400, "json: malformed number",
               "std/json.dva", 0, 0, (p', 0)) +>
   | <- Error(400, "json: expected a number",
   "std/json.dva", 0, 0, (p', 0)) +>

// --- entry point ------------------------------------------------

// Parse a JSON document into a Value. Errors (malformed input) land
// in the Error branch of the returned <Value | Error> ram.
#public
   parse: String => <Value | Error>
   parse = s =>
      src ::= s
      pos ::= 0
      r = parse_value!
      parse_finish(r)

parse_finish: <Value | Error> => <Value | Error>
parse_finish = r =>
   r | val =>
         p = skip_ws(pos)
         p == ?src |
            <+ val ->
         |
            <- Error(400, "json: trailing characters after value", "std/json.dva", 0, 0, (p, 0)) +>
   | err =>
         <- err +>

parse_value: () => <Value | Error>
parse_value = !=>
   p = skip_ws(pos)
   pos ::= p
   c = p [< ?src] src(p) | -1
   c
   ['"] parse_string!
   ['{] parse_object!
   ['[] parse_array!
   ['t] parse_lit(<+>, 4)
   ['f] parse_lit(<->, 5)
   ['n] parse_null!
   | parse_number!

// --- Value query and serialization helpers ----------------------------------

json_type_err: String => Error
json_type_err = msg =>
   Error(422, "json: " + msg, "std/json.dva", 0, 0, (0, 0))

hex_digit: Int => Int
hex_digit = n =>
   d = n .&. 0x0F
   d < 10 | '0 + d | 'a + (d - 10)

#public
   escape_string_into: Builder, String => ()
   escape_string_into = b, s =>
      b += '"
      ?s @ i =>
         c = s(i) .&. 0xFF
         c
            ['"] b += "\\\""
            ['\\] b += "\\\\"
            ['\b] b += "\\b"
            ['\f] b += "\\f"
            ['\n] b += "\\n"
            ['\r] b += "\\r"
            ['\t] b += "\\t"
            [< 0x20]
               b += "\\u00"
               b += hex_digit(c .>. 4)
               b += hex_digit(c)
            | b += c
      b += '"

   escape_string: String => String
   escape_string = s =>
      b = {?s + 8}
      escape_string_into(b, s)
      +b

   format_number: Float => String
   format_number = f =>
      f != f | --| "null"
      f > const::max_f64 || f < -const::max_f64 | --| "null"
      iv = Int(f)
      Float(iv) == f && iv [-const::max_safe_int...const::max_safe_int]
         | str::from_int(iv)
         |
            s = str::from_float(f)
            s ["nan", "inf", "-inf"] "null" | s

stringify_into: Builder, Value => ()
stringify_into = b, val =>
   val
      [String s] escape_string_into(b, s)
      [Number n] b += format_number(n)
      [Boolean flag] b += (flag | "true" | "false")
      [Null] b += "null"
      [Array items]
         b += '[
         items @ item, i =>
            i > 0 | b += ',
            stringify_into(b, item)
         b += ']
      [Object pairs]
         b += '{
         pairs @ p, i =>
            i > 0 | b += ',
            escape_string_into(b, p.key)
            b += ':
            stringify_into(b, p.value)
         b += '}

append_indent: Builder, Int => ()
append_indent = b, spaces =>
   spaces @
      b += '\s

stringify_pretty_into: Builder, Value, Int, Int => ()
stringify_pretty_into = b, val, indent, depth =>
   val
      [String s] escape_string_into(b, s)
      [Number n] b += format_number(n)
      [Boolean flag] b += (flag | "true" | "false")
      [Null] b += "null"
      [Array items]
         ?items == 0
            | b += "[]"
            |
               b += "[\n"
               items @ item, i =>
                  i > 0 | b += ",\n"
                  append_indent(b, (depth + 1) * indent)
                  stringify_pretty_into(b, item, indent, depth + 1)
               b += '\n
               append_indent(b, depth * indent)
               b += ']
      [Object pairs]
         ?pairs == 0
            | b += "{}"
            |
               b += "{\n"
               pairs @ p, i =>
                  i > 0 | b += ",\n"
                  append_indent(b, (depth + 1) * indent)
                  escape_string_into(b, p.key)
                  b += ": "
                  stringify_pretty_into(b, p.value, indent, depth + 1)
               b += '\n
               append_indent(b, depth * indent)
               b += '}

#public
   stringify: Value => String
   stringify = val =>
      b = {128}
      stringify_into(b, val)
      +b

   stringify_pretty: Value, Int => String
   stringify_pretty = val, indent =>
      b = {256}
      stringify_pretty_into(b, val, indent, 0)
      +b

   get: Value, String => < Value | >
   get = val, key =>
      val
         [Object pairs]
            pairs @ p =>
               p.key == key | --| <+ p.value +>
            <-->
         | <-->

   has: Value, String => <>
   has = val, key =>
      <>(get(val, key))

   get_str: Value, String => < String | >
   get_str = val, key =>
      get(val, key)
         | fval =>
            fval [String s] <+ s +> | <-->
         | <-->

   get_int: Value, String => < Int | >
   get_int = val, key =>
      get(val, key)
         | fval =>
            fval
               [Number n]
                  iv = Int(n)
                  Float(iv) == n | <+ iv +> | <-->
               | <-->
         | <-->

   get_float: Value, String => < Float | >
   get_float = val, key =>
      get(val, key)
         | fval =>
            fval [Number n] <+ n +> | <-->
         | <-->

   get_bool: Value, String => < <> | >
   get_bool = val, key =>
      get(val, key)
         | fval =>
            fval [Boolean flag] <+ flag +> | <-->
         | <-->

   is_array: Value => <>
   is_array = val =>
      val [Array]

   array_len: Value => Int
   array_len = val =>
      val [Array items] ?items | 0

   array_at: Value, Int => Value
   array_at = val, idx =>
      val [Array items] items(idx) | Value(Null)

   is_object: Value => <>
   is_object = val =>
      val [Object]

   object_len: Value => Int
   object_len = val =>
      val [Object pairs] ?pairs | 0

   object_key_at: Value, Int => String
   object_key_at = val, idx =>
      val
         [Object pairs]
            p = pairs(idx)
            p.key
         | ""

   object_val_at: Value, Int => Value
   object_val_at = val, idx =>
      val
         [Object pairs]
            p = pairs(idx)
            p.value
         | Value(Null)

// --- Compile-time structural JSON codec (#!) --------------------------------

#public
   json_key_to_str: #! K: Type, K => String
   json_key_to_str = k =>
      K
         [String] k
         [Int, i8, i16, i32, i64, u8, u16, u32, u64] str::from_int(Int(k))
         [<>] (k | "true" | "false")
         [Rune] utf::encode_rune(k)
         | K.name

   to_value: #! T: Type, T => Value
   to_value = val =>
      T
         [Value] val
         [String] Value(String, val)
         [Int, i8, i16, i32, i64, u8, u16, u32, u64]
            Value(Number, Float(val))
         [Float, f32, f64]
            Value(Number, Float(val))
         [<>]
            Value(Boolean, val)
         [Rune]
            Value(String, utf::encode_rune(val))
         [()]
            Value(Null)
         [<P|>]
            (val | inner => to_value(P, inner) | Value(Null))
         [E{}]
            elems = Values()
            val @ item =>
               elems += to_value(E, item)
            n = ?elems
            Value(Array, elems(0..n))
         [E[]]
            elems = Values()
            val @ item =>
               elems += to_value(E, item)
            n = ?elems
            Value(Array, elems(0..n))
         [K ^ V]
            entries = Pairs()
            val @ v, k =>
               entries += (json_key_to_str(K, k), to_value(V, v))
            m = ?entries
            Value(Object, entries(0..m))
         [(..)]
            is_tuple' = <->
            T @ f =>
               f.idx == 0 && f.name == "" | is_tuple' = <+>
            is_tuple'
               |
                  elems = Values()
                  T @ f =>
                     f.type
                        [<P|>]
                           vf = val.(f)
                           ev = vf | inner => to_value(P, inner) | Value(Null)
                           elems += ev
                        |
                           elems += to_value(f.type, val.(f))
                  n = ?elems
                  Value(Array, elems(0..n))
               |
                  entries = Pairs()
                  T @ f =>
                     f.type
                        [<P|>]
                           vf = val.(f)
                           ev = vf | inner => to_value(P, inner) | Value(Null)
                           entries += (f.name, ev)
                        |
                           entries += (f.name, to_value(f.type, val.(f)))
                  m = ?entries
                  Value(Object, entries(0..m))
         [<..>]
            T @ v =>
               val.(v)
                  | pay =>
                     v.type
                        [()] --| Value(String, v.name)
                        |
                           entries = Pairs()
                           entries += (v.name, to_value(v.type, pay))
                           --| Value(Object, entries(0..1))
            Value(Null)
         | Value(Null)

   encode: #! T: Type, T => String
   encode = val =>
      stringify(to_value(T, val))

   encode_pretty: #! T: Type, T, Int => String
   encode_pretty = val, indent =>
      stringify_pretty(to_value(T, val), indent)

   is_valid_int_value: Value => <>
   is_valid_int_value = val =>
      val
         [Number n]
            iv = Int(n)
            Float(iv) == n
         | <->

   unwrap_int_or_zero: Value => Int
   unwrap_int_or_zero = val =>
      val
         [Number n] Int(n)
         | 0

   is_valid_float_value: Value => <>
   is_valid_float_value = val =>
      val [Number]

   unwrap_float_or_zero: Value => Float
   unwrap_float_or_zero = val =>
      val
         [Number n] n
         | 0.0

   decode_int_value: Value => < Int | Error >
   decode_int_value = val =>
      val
         [Number n]
            iv = Int(n)
            Float(iv) == n
               | <+ iv ->
               | <- json_type_err("expected integer") +>
         | <- json_type_err("expected integer") +>

   decode_float_value: Value => < Float | Error >
   decode_float_value = val =>
      val
         [Number n] <+ n ->
         | <- json_type_err("expected number") +>

   from_value: #! T: Type, Value => < T | Error >
   from_value = val =>
      T
         [Value]
            <+ val ->
         [String]
            val
               [String s] <+ s ->
               | <- json_type_err("expected string") +>
         [Int]
            decode_int_value(val)
         [Float]
            decode_float_value(val)
         [<>]
            val
               [Boolean flag] <+ flag ->
               | <- json_type_err("expected boolean") +>
         [<P|>]
            val
               [Null] <+ <--> ->
               |
                  P
                     [Int]
                        is_valid_int_value(val)
                           | <+ <+ unwrap_int_or_zero(val) +> ->
                           | <- json_type_err("expected integer") +>
                     [Float]
                        is_valid_float_value(val)
                           | <+ <+ unwrap_float_or_zero(val) +> ->
                           | <- json_type_err("expected number") +>
                     |
                        <+ <+ from_value(P, val)--! +> ->
         [E{}]
            !is_array(val)
               | <- json_type_err("expected array") +>
               |
                  arr' = T.zero
                  n_items = array_len(val)
                  0..n_items @ i =>
                     elem_val = array_at(val, i)
                     E
                        [Int]
                           is_valid_int_value(elem_val)
                              | arr' += unwrap_int_or_zero(elem_val)
                              | --| <- json_type_err("expected integer") +>
                        [Float]
                           is_valid_float_value(elem_val)
                              | arr' += unwrap_float_or_zero(elem_val)
                              | --| <- json_type_err("expected number") +>
                        |
                           arr' += from_value(E, elem_val)--!
                  <+ arr' ->
         [K ^ V]
            !is_object(val)
               | <- json_type_err("expected object") +>
               |
                  mp' = T.zero
                  n_pairs = object_len(val)
                  0..n_pairs @ i =>
                     pk = object_key_at(val, i)
                     pv = object_val_at(val, i)
                     k = from_value(K, Value(String, pk))--!
                     V
                        [Int]
                           is_valid_int_value(pv)
                              | mp' ^ k = unwrap_int_or_zero(pv)
                              | --| <- json_type_err("expected integer") +>
                        [Float]
                           is_valid_float_value(pv)
                              | mp' ^ k = unwrap_float_or_zero(pv)
                              | --| <- json_type_err("expected number") +>
                        |
                           mp' ^ k = from_value(V, pv)--!
                  <+ mp' ->
         [(..)]
            rec' = T.zero
            T @ f =>
               f.name == ""
                  |
                     !is_array(val) | --| <- json_type_err("expected array for tuple") +>
                     f.idx !< array_len(val) | --| <- json_type_err("tuple length mismatch") +>
                     pos_item = array_at(val, f.idx)
                     f.type
                        [Int]
                           is_valid_int_value(pos_item)
                              | rec'.(f) = unwrap_int_or_zero(pos_item)
                              | --| <- json_type_err("expected integer") +>
                        [Float]
                           is_valid_float_value(pos_item)
                              | rec'.(f) = unwrap_float_or_zero(pos_item)
                              | --| <- json_type_err("expected number") +>
                        |
                           rec'.(f) = from_value(f.type, pos_item)--!
                  |
                     !is_object(val) | --| <- json_type_err("expected object for " + T.name) +>
                     get(val, f.name)
                        | fval =>
                           f.type
                              [Int]
                                 is_valid_int_value(fval)
                                    | rec'.(f) = unwrap_int_or_zero(fval)
                                    | --| <- json_type_err("expected integer") +>
                              [Float]
                                 is_valid_float_value(fval)
                                    | rec'.(f) = unwrap_float_or_zero(fval)
                                    | --| <- json_type_err("expected number") +>
                              |
                                 rec'.(f) = from_value(f.type, fval)--!
                        |
                           f.default
                              | def => rec'.(f) = def
                              |
                                 f.type
                                    [<P|>] rec'.(f) = <-->
                                    [E{}] rec'.(f) = f.type.zero
                                    [K ^ V] rec'.(f) = f.type.zero
                                    | --| <- json_type_err("missing required key '" + f.name + "'") +>
            <+ rec' ->
         [<..>]
            val
               [String s]
                  T @ v =>
                     v.name == s |
                        v.type
                           [()] --| <+ T(v) ->
                           | --| <- json_type_err("variant '" + s + "' of " + T.name + " requires a payload") +>
                  <- json_type_err("unknown variant '" + s + "' for " + T.name) +>
               |
                  !is_object(val)
                     | <- json_type_err("expected string or single-key object for " + T.name) +>
                     |
                        object_len(val) != 1
                           | <- json_type_err("expected single-key object for " + T.name) +>
                           |
                              p0_key = object_key_at(val, 0)
                              p0_val = object_val_at(val, 0)
                              T @ v =>
                                 v.name == p0_key |
                                    v.type
                                       [()] --| <+ T(v) ->
                                       | --| <+ T(v, from_value(v.type, p0_val)--!) ->
                              <- json_type_err("unknown variant '" + p0_key + "' for " + T.name) +>
         | <- json_type_err("unsupported target type " + T.name + " in json::decode") +>

   decode: #! T: Type, String => < T | Error >
   decode = s =>
      parse(s)
         | val => from_value(T, val)
         | err => <- err +>

