// Functional Programming & Generic Combinators (std/fp.dva)
//
// Higher-order combinators and collection utilities adapted to Dva.
// Use `#use(import) fp` to import all symbols into unqualified scope,
// or `#use fp` for namespaced `fp::` access.

#public
   // --- function application ------------------------------------------------

   // apply f to x — the function-value form of "f $ x".
   apply: #! T: Type, #! U: Type, (T => U), T => U
   apply = f, x => f $ x

   // apply2/apply3: apply a multi-argument function.
   apply2: #! T: Type, #! U: Type, #! V: Type, (T, U => V), T, U => V
   apply2 = f, a, b => f(a, b)

   apply3: #! T: Type, #! U: Type, #! V: Type, #! W: Type, (T, U, V => W), T, U, V => W
   apply3 = f, a, b, c => f(a, b, c)

   // twice/thrice: apply f 2/3 times to x ("f $ f $ x" is right-assoc, so it is
   // f(f(x))).
   twice: #! T: Type, (T => T), T => T
   twice = f, x => f $ f $ x

   thrice: #! T: Type, (T => T), T => T
   thrice = f, x => f $ f $ f $ x

   // flip: call f with the last two arguments swapped.
   flip: #! T: Type, #! U: Type, #! V: Type, (T, U => V), U, T => V
   flip = f, a, b => f(b, a)

   // on: apply g to both a and b, then f to the results — the "f `on` g"
   // combinator from Haskell (e.g. sortBy (compare `on` length)).
   on: #! T: Type, #! V: Type, (T, T => V), (T => T), T, T => V
   on = f, g, a, b => f(g(a), g(b))

   // compose: f after g — "f $ g $ x" is f(g(x)). Curried: compose(f, g) is a
   // function; the type params A/B/C are inferred from the two function args.
   compose: #! A: Type, #! B: Type, #! C: Type, (B => C), (A => B) => (A => C)
   compose = f, g => x => f $ g $ x

   // pipe: g after f — left-to-right function composition ("g(f(x))"). Curried:
   // pipe(f, g) is a function.
   pipe: #! A: Type, #! B: Type, #! C: Type, (A => B), (B => C) => (A => C)
   pipe = f, g => x => g $ f $ x

   // const: return its first argument, ignoring the second. Curried — the second
   // type param B is deferred to the returned lambda's own call site (deferred
   // generic inference): "const(42)" binds A=Int, and applying the result to any
   // value resolves B.
   const: #! A: Type, #! B: Type, A => (B => A)
   const = x => _ => x

   // map / filter: apply a function / predicate to each element of a homogeneous
   // record, building a NEW record of the same type. The container type T and
   // element type E are inferred; "out = T" materializes the empty container
   // (CTTR), and the existing '?xs @ i' cycle iterates.
   map: #! E: Type, #! T: Type, (E => E), T => T
   map = f, xs =>
      out = T
      ?xs @ i =>
         out += f(xs(i) | v => v | E)
      out

   filter: #! E: Type, #! T: Type, (E => <>), T => T
   filter = pred, xs =>
      out = T
      ?xs @ i =>
         v = xs(i) | _ | E
         pred(v)
            | out += v
      out

   // reject: inverse of filter — remove elements satisfying pred.
   reject: #! E: Type, #! T: Type, (E => <>), T => T
   reject = pred, xs =>
      out = T
      xs @ x =>
         !pred(x)
            | out += x
      out

   // reduce / fold: fold collection from left with an initial accumulator value.
   // Safe on empty collections (returns init).
   reduce: #! E: Type, #! Acc: Type, #! T: Type, (Acc, E => Acc), Acc, T => Acc
   reduce = f, init, xs =>
      acc' = init
      xs @ x =>
         acc' = f(acc', x)
      acc'

   fold: #! E: Type, #! Acc: Type, #! T: Type, (Acc, E => Acc), Acc, T => Acc
   fold = f, init, xs =>
      acc' = init
      xs @ x =>
         acc' = f(acc', x)
      acc'

   // scan: running accumulation from left, emitting initial and each
   // intermediate accumulator state into a growable array.
   scan: #! E: Type, #! Acc: Type, #! T: Type, (Acc, E => Acc), Acc, T => (Acc){}
   scan = f, init, xs =>
      out = Acc{}
      acc' = init
      out += acc'
      xs @ x =>
         acc' = f(acc', x)
         out += acc'
      out

   // reverse: return a new container with elements in reversed order.
   reverse: #! E: Type, #! T: Type, T => T
   reverse = xs =>
      out = T
      n = ?xs
      0..n @ i =>
         idx = n - 1 - i
         out += (xs(idx) | _ | E)
      out

   // flatten: concatenate an array of arrays into a single-level array.
   flatten: #! E: Type, ((E){}){} => (E){}
   flatten = xss =>
      out = E{}
      xss @ sub =>
         sub @ x =>
            out += x
      out

   // find: search for the first element satisfying pred, returning < E | >.
   find: #! E: Type, #! T: Type, (E => <>), T => < E | >
   find = pred, xs =>
      res' = <-->
      ?xs @ i =>
         v = xs(i) | _ | E
         pred(v)
            |
               res' = <+ v ->
               -->
      res'

   // any: check if any element in xs satisfies pred, returning <>.
   any: #! E: Type, #! T: Type, (E => <>), T => <>
   any = pred, xs =>
      res' = <->
      ?xs @ i =>
         v = xs(i) | _ | E
         pred(v)
            |
               res' = <+>
               -->
      res'

   // --- predicate combinators ------------------------------------------------

   // complement: return the logical NOT of a predicate function.
   complement: #! T: Type, (T => <>) => (T => <>)
   complement = pred => x => !pred(x)

   // both: return a predicate that is true only if both p1 and p2 hold.
   both: #! T: Type, (T => <>), (T => <>) => (T => <>)
   both = p1, p2 => x => p1(x) && p2(x)

   // either_pred: return a predicate that is true if either p1 or p2 holds.
   either_pred: #! T: Type, (T => <>), (T => <>) => (T => <>)
   either_pred = p1, p2 => x => p1(x) || p2(x)

   // --- boolean mask reductions (issue #38) ----------------------------------

   // all_bit: returns <+> if every component of boolean mask is <+>, else <->.
   all_bit: #! T: Type, T => <>
   all_bit = mask =>
      T
         [i1] mask
         |
            acc' = <+>
            0..?T @ i =>
               acc' = acc' && mask.(i)
            acc'

   // any_bit: returns <+> if at least one component of mask is <+>, else <->.
   any_bit: #! T: Type, T => <>
   any_bit = mask =>
      T
         [i1] mask
         |
            acc' = <->
            0..?T @ i =>
               acc' = acc' || mask.(i)
            acc'

   // --- identity / tap -------------------------------------------------------

   // ident: the identity function.
   ident: #! T: Type, T => T
   ident = x => x

   // tap: run a side-effect function on v, then return v unchanged. The side
   // effect must be a first-class function (io::out & co., not a builtin).
   tap: #! T: Type, T, (T => ()) => T
   tap = v, f =>
      f $ v
      v

   // --- sorting --------------------------------------------------------------

   // sort: in-place insertion sort of a slice view (a(0..) / a(i..j)); writes go
   // through to the backing array/record. `lt` is a "less than" predicate; the
   // element type T is inferred from the slice argument. A String order is
   // str::lt (bytewise, via str::cmp).
   sort: #! T: Type, (T[]), (T, T => <>) => ()
   sort = xs, lt =>
      n = ?xs
      1..n @ i =>
         j' = i
         0.. @
            j' == 0 | -->
            lt(xs(j'), xs(j' - 1))
               |
                  t = xs(j')
                  xs(j') = xs(j' - 1)
                  xs(j' - 1) = t
                  j' = j' - 1
               |
                  -->

   // --- slicing & sequence views ----------------------------------------------

   // take: return a zero-copy slice view of the first n elements (clamped to
   // 0..?xs). Callers copy explicitly with "++take(...)" when owned data is needed.
   take: #! T: Type, Int, (T[]) => (T[])
   take = n, xs =>
      len = ?xs
      k = n < 0 | 0 | (n > len | len | n)
      xs(0..k)

   // drop: return a zero-copy slice view omitting the first n elements (clamped
   // to 0..?xs).
   drop: #! T: Type, Int, (T[]) => (T[])
   drop = n, xs =>
      len = ?xs
      k = n < 0 | 0 | (n > len | len | n)
      xs(k..len)

   // take_while: return a zero-copy slice view of leading elements where pred
   // holds true.
   take_while: #! T: Type, (T => <>), (T[]) => (T[])
   take_while = pred, xs =>
      len = ?xs
      count' = len
      0..len @ i =>
         !pred(xs(i))
            |
               count' = i
               -->
      xs(0..count')

   // drop_while: return a zero-copy slice view starting from the first element
   // where pred is false.
   drop_while: #! T: Type, (T => <>), (T[]) => (T[])
   drop_while = pred, xs =>
      len = ?xs
      start' = len
      0..len @ i =>
         !pred(xs(i))
            |
               start' = i
               -->
      xs(start'..len)

   // partition: split a collection into two growable arrays (passed, rejected)
   // according to predicate.
   partition: #! T: Type, (T => <>), (T[]) => (passed: (T){}, rejected: (T){})
   partition = pred, xs =>
      p = T{}
      r = T{}
      xs @ x =>
         pred(x)
            | p += x
            | r += x
      (passed = p, rejected = r)

   // --- pairing & multi-collection -----------------------------------------

   // zip: pair elements of two slices into an array of 2-tuples until the
   // shorter collection ends.
   zip: #! A: Type, #! B: Type, (A[]), (B[]) => ((A, B)){}
   zip = xs, ys =>
      na = ?xs
      nb = ?ys
      limit = na < nb | na | nb
      out = (A, B){}
      0..limit @ i =>
         out += (xs(i), ys(i))
      out

   // zip_with: combine elements of two slices pairwise using a combining
   // function f until the shorter collection ends.
   zip_with: #! A: Type, #! B: Type, #! C: Type, (A, B => C), (A[]), (B[]) => (C){}
   zip_with = f, xs, ys =>
      na = ?xs
      nb = ?ys
      limit = na < nb | na | nb
      out = C{}
      0..limit @ i =>
         out += f(xs(i), ys(i))
      out
