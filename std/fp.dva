// Functional Programming & Generic Combinators (std/fp.dva)
//
// Higher-order combinators and collection utilities adapted to Dva.
// Use `#use(import) fp` to import all symbols into unqualified scope,
// or `#use fp` for namespaced `fp::` access.

#public
   // --- function application ------------------------------------------------

   // apply f to x — the function-value form of "f $ x".
   apply: #param T: Type, #param U: Type, (T => U), T => U
   apply = f, x => f $ x

   // apply2/apply3: apply a multi-argument function.
   apply2: #param T: Type, #param U: Type, #param V: Type, (T, U => V), T, U => V
   apply2 = f, a, b => f(a, b)

   apply3: #param T: Type, #param U: Type, #param V: Type, #param W: Type,
      (T, U, V => W), T, U, V => W
   apply3 = f, a, b, c => f(a, b, c)

   // twice/thrice: apply f 2/3 times to x via function composition `.>`.
   twice: #param T: Type, (T => T), T => T
   twice = f, x => x $> (f .> f)

   thrice: #param T: Type, (T => T), T => T
   thrice = f, x => x $> (f .> f .> f)

   // flip: call f with the last two arguments swapped.
   flip: #param T: Type, #param U: Type, #param V: Type, (T, U => V), U, T => V
   flip = f, a, b => f(b, a)

   // on: apply g to both a and b, then f to the results — the "f `on` g"
   // combinator from Haskell (e.g. sortBy (compare `on` length)).
   on: #param T: Type, #param V: Type, (T, T => V), (T => T), T, T => V
   on = f, g, a, b => f(g(a), g(b))

   // compose: f after g — right-to-left composition ("f(g(x))", i.e. `g .> f`).
   // Curried: compose(f, g) is a function; type params A/B/C are inferred from the two function args.
   compose: #param A: Type, #param B: Type, #param C: Type, (B => C), (A => B) => (A => C)
   compose = f, g => x => x $> (g .> f)

   // pipe: g after f — left-to-right function composition (`f .> g`, i.e. "g(f(x))").
   // Curried: pipe(f, g) is a function.
   pipe: #param A: Type, #param B: Type, #param C: Type, (A => B), (B => C) => (A => C)
   pipe = f, g => x => x $> (f .> g)

   // const: return its first argument, ignoring the second. Curried — the second
   // type param B is deferred to the returned lambda's own call site (deferred
   // generic inference): "const(42)" binds A=Int, and applying the result to any
   // value resolves B.
   const: #param A: Type, #param B: Type, A => (B => A)
   const = x => ignored => x

   // map: apply a transformation function f to each element of a collection
   // (growable array, slice view, or record), building a new growable array of
   // element type B. Supports arbitrary element type transitions (A => B).
   map: #param A: Type, #param B: Type, #param T: Type, (A => B), T => B{}
   map = f, xs => xs @> f

   filter: #param E: Type, #param T: Type, (E => <>), T => T
   filter = pred, xs =>
      out = T
      xs @ x =>
         pred(x)
            | out += x
      out

   // reject: inverse of filter — remove elements satisfying pred.
   reject: #param E: Type, #param T: Type, (E => <>), T => T
   reject = pred, xs =>
      out = T
      xs @ x =>
         !pred(x)
            | out += x
      out

   // reduce / fold: fold collection from left with an initial accumulator value.
   // Safe on empty collections (returns init).
   reduce: #param E: Type, #param Acc: Type, #param T: Type, (Acc, E => Acc), Acc, T => Acc
   reduce = f, init, xs => (init, xs) @> f

   fold: #param E: Type, #param Acc: Type, #param T: Type, (Acc, E => Acc), Acc, T => Acc
   fold = f, init, xs => (init, xs) @> f

   // scan: running accumulation from left, emitting initial and each
   // intermediate accumulator state into a growable array.
   scan: #param E: Type, #param Acc: Type, #param T: Type, (Acc, E => Acc), Acc, T => Acc{}
   scan = f, init, xs =>
      out = Acc{}
      acc' = init
      out += acc'
      xs @ x =>
         acc' = f(acc', x)
         out += acc'
      out

   // reverse: return a new container with elements in reversed order.
   reverse: #param T: Type, T => T
   reverse = xs =>
      out = T
      n = ?xs
      0..n @ i =>
         idx = n - 1 - i
         out += xs(idx)!!
      out

   // flatten: concatenate an array of arrays into a single-level array.
   flatten: #param E: Type, E{}{} => E{}
   flatten = xss =>
      out = E{}
      xss @ sub =>
         sub @ x =>
            out += x
      out

   // find: search for the first element satisfying pred, returning < E | >.
   find: #param E: Type, #param T: Type, (E => <>), T => < E | >
   find = pred, xs =>
      xs @ x =>
         pred(x) | --| <+ x +>
      <-->

   // any: check if any element in xs satisfies pred, returning <>.
   any: #param E: Type, #param T: Type, (E => <>), T => <>
   any = pred, xs =>
      xs @ x =>
         pred(x) |+>
      <->

   // --- predicate combinators ------------------------------------------------

   // complement: return the logical NOT of a predicate function.
   complement: #param T: Type, (T => <>) => (T => <>)
   complement = pred => x => !pred(x)

   // both: return a predicate that is true only if both p1 and p2 hold.
   both: #param T: Type, (T => <>), (T => <>) => (T => <>)
   both = p1, p2 => x => p1(x) && p2(x)

   // either_pred: return a predicate that is true if either p1 or p2 holds.
   either_pred: #param T: Type, (T => <>), (T => <>) => (T => <>)
   either_pred = p1, p2 => x => p1(x) || p2(x)

   // --- boolean mask reductions (issue #38) ----------------------------------

   // all_bit: returns <+> if every component of boolean mask is <+>, else <->.
   all_bit: #param T: Type, T => <>
   all_bit = mask =>
      T
         [i1] mask
         | (<+>, 0..(#arity T)) @> acc, i => acc && (#member mask, i)

   // any_bit: returns <+> if at least one component of mask is <+>, else <->.
   any_bit: #param T: Type, T => <>
   any_bit = mask =>
      T
         [i1] mask
         | (<->, 0..(#arity T)) @> acc, i => acc || (#member mask, i)

   // --- identity / tap -------------------------------------------------------

   // ident: the identity function.
   ident: #param T: Type, T => T
   ident = x => x

   // tap: run a side-effect function on v, then return v unchanged. The side
   // effect must be a first-class function (io::out & co., not a builtin).
   tap: #param T: Type, T, (T => ()) => T
   tap = v, f =>
      f $ v
      v

   // --- sorting --------------------------------------------------------------

   // sort: in-place insertion sort of a slice view (a(0..) / a(i..j)); writes go
   // through to the backing array/record. `lt` is a "less than" predicate; the
   // element type T is inferred from the slice argument. A String order is
   // str::lt (bytewise, via str::cmp).
   sort: #param T: Type, T[], (T, T => <>) => ()
   sort = xs, lt =>
      n = ?xs
      1..n @ i =>
         j' = i
         0.. @
            j' == 0 | -->
            lt(xs(j'), xs(j' - 1))
               |
                  t = xs(j')
                  xs(j') = xs(j' - 1)
                  xs(j' - 1) = t
                  j' = j' - 1
               |
                  -->

   // --- slicing & sequence views ----------------------------------------------

   // take: return a zero-copy slice view of the first n elements (clamped to
   // 0..?xs). Callers copy explicitly with "++take(...)" when owned data is needed.
   take: #param T: Type, Int, T[] => T[]
   take = n, xs =>
      len = ?xs
      k = %clamp(n, 0, len)
      xs(0..k)

   // drop: return a zero-copy slice view omitting the first n elements (clamped
   // to 0..?xs).
   drop: #param T: Type, Int, T[] => T[]
   drop = n, xs =>
      len = ?xs
      k = %clamp(n, 0, len)
      xs(k..len)

   // take_while: return a zero-copy slice view of leading elements where pred
   // holds true.
   take_while: #param T: Type, (T => <>), T[] => T[]
   take_while = pred, xs =>
      xs @ x, i =>
         !pred(x) | --| xs(0..i)
      xs

   // drop_while: return a zero-copy slice view starting from the first element
   // where pred is false.
   drop_while: #param T: Type, (T => <>), T[] => T[]
   drop_while = pred, xs =>
      len = ?xs
      xs @ x, i =>
         !pred(x) | --| xs(i..len)
      xs(len..len)

   // partition: split a collection into two growable arrays (passed, rejected)
   // according to predicate.
   partition: #param T: Type, (T => <>), T[] => (passed: T{}, rejected: T{})
   partition = pred, xs =>
      p = T{}
      r = T{}
      xs @ x =>
         pred(x)
            | p += x
            | r += x
      (passed = p, rejected = r)

   // --- pairing & multi-collection -----------------------------------------

   // zip: pair elements of two slices into an array of 2-tuples until the
   // shorter collection ends.
   zip: #param A: Type, #param B: Type, A[], B[] => (A, B){}
   zip = xs, ys =>
      0..%min(?xs, ?ys) @> i => (xs(i), ys(i))

   // zip_with: combine elements of two slices pairwise using a combining
   // function f until the shorter collection ends.
   zip_with: #param A: Type, #param B: Type, #param C: Type, (A, B => C), A[], B[] => C{}
   zip_with = f, xs, ys =>
      0..%min(?xs, ?ys) @> i => f(xs(i), ys(i))
