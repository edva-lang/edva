// Standard Cryptographic & Digest Primitives Module (std/crypto.dva)
// Pure Edva implementations of:
// - Constant-time byte comparison (`ct_eq`)
// - Cryptographic digests: SHA-1 (`sha1`, `sha1_bytes`), SHA-256 (`sha256`, `sha256_bytes`),
//   SHA-512 (`sha512`, `sha512_bytes`)
// - Message Authentication Codes: HMAC-SHA256 (`hmac_sha256`, `hmac_sha256_bytes`),
//   HMAC-SHA512 (`hmac_sha512`, `hmac_sha512_bytes`), Poly1305 (`poly1305_mac`, `poly1305_hex`)
// - Key Derivation Functions: HKDF-SHA256 (`hkdf_extract`, `hkdf_expand`, `hkdf_sha256`),
//   PBKDF2-HMAC-SHA256 (`pbkdf2_sha256`, `pbkdf2_sha256_bytes`)
// - Stream Cipher & AEAD: ChaCha20 (`chacha20_block`, `chacha20_xor`) and
//   ChaCha20-Poly1305 AEAD (`aead_seal`, `aead_open`, RFC 8439)
// - WebSocket RFC 6455 handshake helper (`websocket_accept_key`)
// - OS CSPRNG (`/dev/urandom`): `random_bytes`, `random_hex`, `random_u64`

#use base64
#use binary
#use hex
#use libc
#use sys

#private

#foreign "c"
   getrandom       : (buf: Addr, buflen: Int, flags: Int) => Int
   arc4random_buf  : (buf: Addr, nbytes: Int) => ()
   BCryptGenRandom : (hAlgorithm: Addr, pbBuffer: Addr, cbBuffer: Int, dwFlags: Int) => Int

#type OsDarwin  (darwin: Int, tag: Int)
#type OsWindows (windows: Int, tag: Int)
#type OsWasm    (wasm: Int, tag: Int)
#type OsLinux   (linux: Int, tag: Int)
#type OsTarget  #! (os ["darwin", "freebsd", "openbsd", "netbsd"] OsDarwin ["windows"] OsWindows ["wasm", "wasi"] OsWasm | OsLinux)

fill_urandom: Addr, Int => <>
fill_urandom = ptr, n =>
   fd = Int(i32(libc::open("/dev/urandom", 0)))
   fd < 0 |->
   got' = 0
   0.. @
      got' !< n | -->
      r = libc::read(fd, ptr + got', n - got')
      r < 1 | -->
      got' = got' + r
   libc::close(fd)
   got' == n

fill_linux_random: Addr, Int => <>
fill_linux_random = ptr, n =>
   got' = 0
   0.. @
      got' !< n | -->
      r = getrandom(ptr + got', n - got', 0)
      r < 1
         | --| (got' == 0 | fill_urandom(ptr, n) | <->)
         | got' = got' + r
   got' == n

fill_os_random: #! OS: Type, Addr, Int => <>
fill_os_random = #! OS, ptr, n =>
   OS
      [OsDarwin]
         arc4random_buf(ptr, n)
         <+>
      [OsWindows]
         Int(i32(BCryptGenRandom(sys::addr_null, ptr, n, 2))) == 0
      [OsWasm]
         getrandom(ptr, n, 0) == n
      |
         fill_linux_random(ptr, n)

crypto_err: String => Error
crypto_err = msg =>
   Error(400, "crypto: " + msg, "std/crypto.dva", 1, 1, (0, 0))

mask32: Int => Int
mask32 = x => x .&. 0xFFFFFFFF

rotl32: Int, Int => Int
rotl32 = x, n =>
   v = x .&. 0xFFFFFFFF
   ((v .<. n) .|. (v .>. (32 - n))) .&. 0xFFFFFFFF

rotr32: Int, Int => Int
rotr32 = x, n =>
   v = x .&. 0xFFFFFFFF
   ((v .>. n) .|. (v .<. (32 - n))) .&. 0xFFFFFFFF

rotr64: u64, u64 => u64
rotr64 = x, n =>
   (x .>. n) .|. (x .<. (64u64 - n))

read_u32_be_raw: String, Int => Int
read_u32_be_raw = s, off =>
   b0 = (s(off) .&. 0xFF) .<. 24
   b1 = (s(off + 1) .&. 0xFF) .<. 16
   b2 = (s(off + 2) .&. 0xFF) .<. 8
   b3 = s(off + 3) .&. 0xFF
   b0 .|. b1 .|. b2 .|. b3

read_u32_le_raw: String, Int => Int
read_u32_le_raw = s, off =>
   b0 = s(off) .&. 0xFF
   b1 = (s(off + 1) .&. 0xFF) .<. 8
   b2 = (s(off + 2) .&. 0xFF) .<. 16
   b3 = (s(off + 3) .&. 0xFF) .<. 24
   b0 .|. b1 .|. b2 .|. b3

read_u64_be_raw: String, Int => u64
read_u64_be_raw = s, off =>
   hi = u64(read_u32_be_raw(s, off))
   lo = u64(read_u32_be_raw(s, off + 4))
   (hi .<. 32u64) .|. lo

// Pads a message according to FIPS 180-4 (64-byte block, 64-bit big-endian bit length)
pad_md64: String => String
pad_md64 = msg =>
   mlen = ?msg
   bit_len = mlen * 8
   rem = (mlen + 9) % 64
   zeros = rem == 0 | 0 | 64 - rem
   b = {mlen + 9 + zeros}
   b += msg
   b += 0x80
   zeros @
      b += 0
   binary::write_u64_be(b, bit_len)
   +b

// Pads a message according to FIPS 180-4 SHA-512 (128-byte block, 128-bit big-endian bit length)
pad_md128: String => String
pad_md128 = msg =>
   mlen = ?msg
   bit_len = mlen * 8
   rem = (mlen + 17) % 128
   zeros = rem == 0 | 0 | 128 - rem
   b = {mlen + 17 + zeros}
   b += msg
   b += 0x80
   zeros @
      b += 0
   binary::write_u64_be(b, 0)
   binary::write_u64_be(b, bit_len)
   +b

// SHA-256 round constants K[0..63]
SHA256_K = (
   0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
   0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
   0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
   0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
   0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
   0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
   0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
   0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
)

// SHA-512 round constants K[0..79]
SHA512_K = (
   0x428a2f98d728ae22u64, 0x7137449123ef65cdu64, 0xb5c0fbcfec4d3b2fu64, 0xe9b5dba58189dbbcu64,
   0x3956c25bf348b538u64, 0x59f111f1b605d019u64, 0x923f82a4af194f9bu64, 0xab1c5ed5da6d8118u64,
   0xd807aa98a3030242u64, 0x12835b0145706fbeu64, 0x243185be4ee4b28cu64, 0x550c7dc3d5ffb4e2u64,
   0x72be5d74f27b896fu64, 0x80deb1fe3b1696b1u64, 0x9bdc06a725c71235u64, 0xc19bf174cf692694u64,
   0xe49b69c19ef14ad2u64, 0xefbe4786384f25e3u64, 0x0fc19dc68b8cd5b5u64, 0x240ca1cc77ac9c65u64,
   0x2de92c6f592b0275u64, 0x4a7484aa6ea6e483u64, 0x5cb0a9dcbd41fbd4u64, 0x76f988da831153b5u64,
   0x983e5152ee66dfabu64, 0xa831c66d2db43210u64, 0xb00327c898fb213fu64, 0xbf597fc7beef0ee4u64,
   0xc6e00bf33da88fc2u64, 0xd5a79147930aa725u64, 0x06ca6351e003826fu64, 0x142929670a0e6e70u64,
   0x27b70a8546d22ffcu64, 0x2e1b21385c26c926u64, 0x4d2c6dfc5ac42aedu64, 0x53380d139d95b3dfu64,
   0x650a73548baf63deu64, 0x766a0abb3c77b2a8u64, 0x81c2c92e47edaee6u64, 0x92722c851482353bu64,
   0xa2bfe8a14cf10364u64, 0xa81a664bbc423001u64, 0xc24b8b70d0f89791u64, 0xc76c51a30654be30u64,
   0xd192e819d6ef5218u64, 0xd69906245565a910u64, 0xf40e35855771202au64, 0x106aa07032bbd1b8u64,
   0x19a4c116b8d2d0c8u64, 0x1e376c085141ab53u64, 0x2748774cdf8eeb99u64, 0x34b0bcb5e19b48a8u64,
   0x391c0cb3c5c95a63u64, 0x4ed8aa4ae3418acbu64, 0x5b9cca4f7763e373u64, 0x682e6ff3d6b2b8a3u64,
   0x748f82ee5defb2fcu64, 0x78a5636f43172f60u64, 0x84c87814a1f0ab72u64, 0x8cc702081a6439ecu64,
   0x90befffa23631e28u64, 0xa4506cebde82bde9u64, 0xbef9a3f7b2c67915u64, 0xc67178f2e372532bu64,
   0xca273eceea26619cu64, 0xd186b8c721c0c207u64, 0xeada7dd6cde0eb1eu64, 0xf57d4f7fee6ed178u64,
   0x06f067aa72176fbau64, 0x0a637dc5a2c898a6u64, 0x113f9804bef90daeu64, 0x1b710b35131c471bu64,
   0x28db77f523047d84u64, 0x32caab7b40c72493u64, 0x3c9ebe0a15c9bebcu64, 0x431d67c49c100d4cu64,
   0x4cc5d4becb3e42b6u64, 0x597f299cfc657e2au64, 0x5fcb6fab3ad6faecu64, 0x6c44198c4a475817u64
)

#public

// Constant-time byte-string equality check. Prevents timing side-channel leaks
// when verifying MAC tags, HMAC digests, or bearer tokens.
ct_eq: String, String => <>
ct_eq = a, b =>
   la = ?a
   lb = ?b
   la != lb | <-> |
      diff = (0, la) @> acc, i => acc .|. ((a(i) .^. b(i)) .&. 0xFF)
      diff == 0

// Computes the raw 20-byte SHA-1 digest of `msg` (RFC 3174).
sha1_bytes: String => String
sha1_bytes = msg =>
   padded = pad_md64(msg)
   nblocks = ?padded / 64
   h0' = 0x67452301
   h1' = 0xefcdab89
   h2' = 0x98badcfe
   h3' = 0x10325476
   h4' = 0xc3d2e1f0
   w = Int{}
   80 @
      w += 0
   nblocks @ blk =>
      base = blk * 64
      16 @ j =>
         w(j) = read_u32_be_raw(padded, base + j * 4) !| _
      16..80 @ j =>
         x = w(j - 3)!! .^. w(j - 8)!! .^. w(j - 14)!! .^. w(j - 16)!!
         w(j) = rotl32(x, 1) !| _
      a' = h0'
      b' = h1'
      c' = h2'
      d' = h3'
      e' = h4'
      80 @ j =>
         fk = j [< 20]
            (((b' .&. c') .|. ((.!. b' .&. 0xFFFFFFFF) .&. d')), 0x5a827999)
         [< 40]
            ((b' .^. c' .^. d'), 0x6ed9eba1)
         [< 60]
            (((b' .&. c') .|. (b' .&. d') .|. (c' .&. d')), 0x8f1bbcdc)
         |
            ((b' .^. c' .^. d'), 0xca62c1d6)
         temp = mask32(rotl32(a', 5) + fk.0 + e' + fk.1 + w(j)!!)
         e' = d'
         d' = c'
         c' = rotl32(b', 30)
         b' = a'
         a' = temp
      h0' = mask32(h0' + a')
      h1' = mask32(h1' + b')
      h2' = mask32(h2' + c')
      h3' = mask32(h3' + d')
      h4' = mask32(h4' + e')
   out = {20}
   binary::write_u32_be(out, h0')
   binary::write_u32_be(out, h1')
   binary::write_u32_be(out, h2')
   binary::write_u32_be(out, h3')
   binary::write_u32_be(out, h4')
   +out

// Computes the 40-character lowercase hex SHA-1 digest of `msg`.
sha1: String => String
sha1 = msg =>
   hex::encode(sha1_bytes(msg))

// Computes the RFC 6455 `Sec-WebSocket-Accept` response header value for a client `Sec-WebSocket-Key`.
websocket_accept_key: String => String
websocket_accept_key = client_key =>
   base64::encode(sha1_bytes(client_key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"), base64::Flavor(Std))

// Computes the raw 32-byte SHA-256 digest of `msg` (FIPS 180-4 / RFC 6234).
sha256_bytes: String => String
sha256_bytes = msg =>
   padded = pad_md64(msg)
   nblocks = ?padded / 64
   h0' = 0x6a09e667
   h1' = 0xbb67ae85
   h2' = 0x3c6ef372
   h3' = 0xa54ff53a
   h4' = 0x510e527f
   h5' = 0x9b05688c
   h6' = 0x1f83d9ab
   h7' = 0x5be0cd19
   w = Int{}
   64 @
      w += 0
   nblocks @ blk =>
      base = blk * 64
      16 @ j =>
         w(j) = read_u32_be_raw(padded, base + j * 4) !| _
      16..64 @ j =>
         w15 = w(j - 15)!!
         w2  = w(j - 2)!!
         s0 = rotr32(w15, 7) .^. rotr32(w15, 18) .^. (w15 .>. 3)
         s1 = rotr32(w2, 17) .^. rotr32(w2, 19) .^. (w2 .>. 10)
         w(j) = mask32(w(j - 16)!! + s0 + w(j - 7)!! + s1) !| _
      a' = h0'
      b' = h1'
      c' = h2'
      d' = h3'
      e' = h4'
      f' = h5'
      g' = h6'
      h' = h7'
      64 @ j =>
         S1 = rotr32(e', 6) .^. rotr32(e', 11) .^. rotr32(e', 25)
         ch = (e' .&. f') .^. ((.!. e' .&. 0xFFFFFFFF) .&. g')
         temp1 = mask32(h' + S1 + ch + SHA256_K(j) + w(j)!!)
         S0 = rotr32(a', 2) .^. rotr32(a', 13) .^. rotr32(a', 22)
         maj = (a' .&. b') .^. (a' .&. c') .^. (b' .&. c')
         temp2 = mask32(S0 + maj)
         h' = g'
         g' = f'
         f' = e'
         e' = mask32(d' + temp1)
         d' = c'
         c' = b'
         b' = a'
         a' = mask32(temp1 + temp2)
      h0' = mask32(h0' + a')
      h1' = mask32(h1' + b')
      h2' = mask32(h2' + c')
      h3' = mask32(h3' + d')
      h4' = mask32(h4' + e')
      h5' = mask32(h5' + f')
      h6' = mask32(h6' + g')
      h7' = mask32(h7' + h')
   out = {32}
   binary::write_u32_be(out, h0')
   binary::write_u32_be(out, h1')
   binary::write_u32_be(out, h2')
   binary::write_u32_be(out, h3')
   binary::write_u32_be(out, h4')
   binary::write_u32_be(out, h5')
   binary::write_u32_be(out, h6')
   binary::write_u32_be(out, h7')
   +out

// Computes the 64-character lowercase hex SHA-256 digest of `msg`.
sha256: String => String
sha256 = msg =>
   hex::encode(sha256_bytes(msg))

// Computes the raw 64-byte SHA-512 digest of `msg` (FIPS 180-4 / RFC 6234).
sha512_bytes: String => String
sha512_bytes = msg =>
   padded = pad_md128(msg)
   nblocks = ?padded / 128
   h0' = 0x6a09e667f3bcc908u64
   h1' = 0xbb67ae8584caa73bu64
   h2' = 0x3c6ef372fe94f82bu64
   h3' = 0xa54ff53a5f1d36f1u64
   h4' = 0x510e527fade682d1u64
   h5' = 0x9b05688c2b3e6c1fu64
   h6' = 0x1f83d9abfb41bd6bu64
   h7' = 0x5be0cd19137e2179u64
   w = u64{}
   80 @
      w += 0u64
   nblocks @ blk =>
      base = blk * 128
      16 @ j =>
         w(j) = read_u64_be_raw(padded, base + j * 8) !| _
      16..80 @ j =>
         w15 = w(j - 15)!!
         w2  = w(j - 2)!!
         s0 = rotr64(w15, 1u64) .^. rotr64(w15, 8u64) .^. (w15 .>. 7u64)
         s1 = rotr64(w2, 19u64) .^. rotr64(w2, 61u64) .^. (w2 .>. 6u64)
         w(j) = (w(j - 16)!! + s0 + w(j - 7)!! + s1) !| _
      a' = h0'
      b' = h1'
      c' = h2'
      d' = h3'
      e' = h4'
      f' = h5'
      g' = h6'
      h' = h7'
      80 @ j =>
         S1 = rotr64(e', 14u64) .^. rotr64(e', 18u64) .^. rotr64(e', 41u64)
         ch = (e' .&. f') .^. ((.!. e') .&. g')
         temp1 = h' + S1 + ch + SHA512_K(j) + w(j)!!
         S0 = rotr64(a', 28u64) .^. rotr64(a', 34u64) .^. rotr64(a', 39u64)
         maj = (a' .&. b') .^. (a' .&. c') .^. (b' .&. c')
         temp2 = S0 + maj
         h' = g'
         g' = f'
         f' = e'
         e' = d' + temp1
         d' = c'
         c' = b'
         b' = a'
         a' = temp1 + temp2
      h0' = h0' + a'
      h1' = h1' + b'
      h2' = h2' + c'
      h3' = h3' + d'
      h4' = h4' + e'
      h5' = h5' + f'
      h6' = h6' + g'
      h7' = h7' + h'
   out = {64}
   binary::write_u64_be(out, Int(h0'))
   binary::write_u64_be(out, Int(h1'))
   binary::write_u64_be(out, Int(h2'))
   binary::write_u64_be(out, Int(h3'))
   binary::write_u64_be(out, Int(h4'))
   binary::write_u64_be(out, Int(h5'))
   binary::write_u64_be(out, Int(h6'))
   binary::write_u64_be(out, Int(h7'))
   +out

// Computes the 128-character lowercase hex SHA-512 digest of `msg`.
sha512: String => String
sha512 = msg =>
   hex::encode(sha512_bytes(msg))

// Computes the raw 32-byte HMAC-SHA256 digest of `msg` under `key` (RFC 2104 / RFC 4231).
hmac_sha256_bytes: String, String => String
hmac_sha256_bytes = key, msg =>
   k = ?key > 64 | sha256_bytes(key) | key
   ipad = {64 + ?msg}
   opad = {64 + 32}
   64 @ i =>
      kb = i < ?k | (k(i) .&. 0xFF) | 0
      ipad += kb .^. 0x36
      opad += kb .^. 0x5c
   ipad += msg
   inner = sha256_bytes(+ipad)
   opad += inner
   sha256_bytes(+opad)

// Computes the 64-character lowercase hex HMAC-SHA256 digest of `msg` under `key`.
hmac_sha256: String, String => String
hmac_sha256 = key, msg =>
   hex::encode(hmac_sha256_bytes(key, msg))

// Computes the raw 64-byte HMAC-SHA512 digest of `msg` under `key` (RFC 2104 / RFC 4231).
hmac_sha512_bytes: String, String => String
hmac_sha512_bytes = key, msg =>
   k = ?key > 128 | sha512_bytes(key) | key
   ipad = {128 + ?msg}
   opad = {128 + 64}
   128 @ i =>
      kb = i < ?k | (k(i) .&. 0xFF) | 0
      ipad += kb .^. 0x36
      opad += kb .^. 0x5c
   ipad += msg
   inner = sha512_bytes(+ipad)
   opad += inner
   sha512_bytes(+opad)

// Computes the 128-character lowercase hex HMAC-SHA512 digest of `msg` under `key`.
hmac_sha512: String, String => String
hmac_sha512 = key, msg =>
   hex::encode(hmac_sha512_bytes(key, msg))

// HKDF-Extract (RFC 5869 Section 2.2) using HMAC-SHA256. Returns a 32-byte pseudorandom key (PRK).
hkdf_extract: String, String => String
hkdf_extract = salt, ikm =>
   s = ?salt > 0 | salt |
      z = {32}
      32 @
         z += 0
      +z
   hmac_sha256_bytes(s, ikm)

// HKDF-Expand (RFC 5869 Section 2.3) using HMAC-SHA256. Expands `prk` with `info` into `length` bytes (max 8160).
hkdf_expand: String, String, Int => < String | Error >
hkdf_expand = prk, info, length =>
   length < 0 || length > 255 * 32 | --| <- crypto_err("HKDF output length out of range") +>
   n = (length + 31) / 32
   okm = {n * 32}
   t_prev' = ++""
   1..(n + 1) @ i =>
      inp = {?t_prev' + ?info + 1}
      inp += t_prev'
      inp += info
      inp += i .&. 0xFF
      t_prev' = hmac_sha256_bytes(prk, +inp)
      okm += t_prev'
   full = +okm
   <+ full(0..length) ->

// Full HKDF-SHA256 (RFC 5869): extracts from `salt` and `ikm` and expands with `info` to `length` raw bytes.
hkdf_sha256: String, String, String, Int => < String | Error >
hkdf_sha256 = salt, ikm, info, length =>
   prk = hkdf_extract(salt, ikm)
   hkdf_expand(prk, info, length)

// PBKDF2-HMAC-SHA256 (RFC 2898 / RFC 6070). Derives `dk_len` raw bytes from `password` and `salt`.
pbkdf2_sha256_bytes: String, String, Int, Int => < String | Error >
pbkdf2_sha256_bytes = password, salt, iterations, dk_len =>
   iterations < 1 | --| <- crypto_err("PBKDF2 iterations must be >= 1") +>
   dk_len < 1 | --| <- crypto_err("PBKDF2 dk_len must be >= 1") +>
   nblocks = (dk_len + 31) / 32
   out = {nblocks * 32}
   1..(nblocks + 1) @ blk =>
      sb = {?salt + 4}
      sb += salt
      binary::write_u32_be(sb, blk)
      u' = hmac_sha256_bytes(password, +sb)
      acc = Int{}
      32 @ i =>
         acc += u'(i) .&. 0xFF
      (iterations - 1) @
         u' = hmac_sha256_bytes(password, u')
         32 @ i =>
            acc(i) = (acc(i)!! .^. (u'(i) .&. 0xFF)) !| _
      32 @ i =>
         out += acc(i)!!
   full = +out
   <+ full(0..dk_len) ->

// PBKDF2-HMAC-SHA256 returning a lowercase hex string of `dk_len * 2` characters.
pbkdf2_sha256: String, String, Int, Int => < String | Error >
pbkdf2_sha256 = password, salt, iterations, dk_len =>
   pbkdf2_sha256_bytes(password, salt, iterations, dk_len) $+> hex::encode

#private

chacha_qr: Int{}, Int, Int, Int, Int => ()
chacha_qr = s, a, b, c, d =>
   va' = s(a)!!
   vb' = s(b)!!
   vc' = s(c)!!
   vd' = s(d)!!
   va' = mask32(va' + vb')
   vd' = rotl32(vd' .^. va', 16)
   vc' = mask32(vc' + vd')
   vb' = rotl32(vb' .^. vc', 12)
   va' = mask32(va' + vb')
   vd' = rotl32(vd' .^. va', 8)
   vc' = mask32(vc' + vd')
   vb' = rotl32(vb' .^. vc', 7)
   s(a) = va' !| _
   s(b) = vb' !| _
   s(c) = vc' !| _
   s(d) = vd' !| _

#public

// Generates a single 64-byte ChaCha20 keystream block (RFC 8439 Section 2.3)
// from a 32-byte `key`, 32-bit `counter`, and 12-byte `nonce`.
chacha20_block: String, Int, String => < String | Error >
chacha20_block = key, counter, nonce =>
   ?key != 32 | --| <- crypto_err("ChaCha20 key must be 32 bytes") +>
   ?nonce != 12 | --| <- crypto_err("ChaCha20 nonce must be 12 bytes") +>
   init = Int{}
   init += 0x61707865
   init += 0x3320646e
   init += 0x79622d32
   init += 0x6b206574
   8 @ i =>
      init += read_u32_le_raw(key, i * 4)
   init += counter .&. 0xFFFFFFFF
   3 @ i =>
      init += read_u32_le_raw(nonce, i * 4)
   work = Int{}
   16 @ i =>
      work += init(i)!!
   10 @
      chacha_qr(work, 0, 4,  8, 12)
      chacha_qr(work, 1, 5,  9, 13)
      chacha_qr(work, 2, 6, 10, 14)
      chacha_qr(work, 3, 7, 11, 15)
      chacha_qr(work, 0, 5, 10, 15)
      chacha_qr(work, 1, 6, 11, 12)
      chacha_qr(work, 2, 7,  8, 13)
      chacha_qr(work, 3, 4,  9, 14)
   out = {64}
   16 @ i =>
      binary::write_u32_le(out, mask32(work(i)!! + init(i)!!))
   <+ +out ->

// Encrypts or decrypts `data` using the RFC 8439 ChaCha20 stream cipher
// with a 32-byte `key`, 12-byte `nonce`, and initial 32-bit block `counter`.
chacha20_xor: String, String, Int, String => < String | Error >
chacha20_xor = key, nonce, counter, data =>
   ?key != 32 | --| <- crypto_err("ChaCha20 key must be 32 bytes") +>
   ?nonce != 12 | --| <- crypto_err("ChaCha20 nonce must be 12 bytes") +>
   total = ?data
   out = {total}
   nblocks = (total + 63) / 64
   nblocks @ b =>
      ks_res = chacha20_block(key, mask32(counter + b), nonce)
      ks = ks_res | k => k | ""
      base = b * 64
      rem = total - base
      chunk = rem < 64 | rem | 64
      chunk @ i =>
         out += (data(base + i) .^. ks(i)) .&. 0xFF
   <+ +out ->

// Computes the 16-byte Poly1305 one-time authenticator tag (RFC 8439 Section 2.5)
// over `msg` using a 32-byte one-time `key`.
poly1305_mac: String, String => < String | Error >
poly1305_mac = key, msg =>
   ?key != 32 | --| <- crypto_err("Poly1305 key must be 32 bytes") +>
   r0 = read_u32_le_raw(key, 0) .&. 0x3FFFFFF
   r1 = (read_u32_le_raw(key, 3) .>. 2) .&. 0x3FFFF03
   r2 = (read_u32_le_raw(key, 6) .>. 4) .&. 0x3FFC0FF
   r3 = (read_u32_le_raw(key, 9) .>. 6) .&. 0x3F03FFF
   r4 = (read_u32_le_raw(key, 12) .>. 8) .&. 0x00FFFFF
   s1 = r1 * 5
   s2 = r2 * 5
   s3 = r3 * 5
   s4 = r4 * 5
   h0' = 0
   h1' = 0
   h2' = 0
   h3' = 0
   h4' = 0
   total = ?msg
   off' = 0
   0.. @
      off' !< total | -->
      rem = total - off'
      clen = rem < 16 | rem | 16
      blk = {17}
      clen @ i =>
         blk += msg(off' + i) .&. 0xFF
      blk += 1
      (16 - clen) @
         blk += 0
      bstr = +blk
      off' = off' + clen
      t0 = read_u32_le_raw(bstr, 0)
      t1 = read_u32_le_raw(bstr, 3) .>. 2
      t2 = read_u32_le_raw(bstr, 6) .>. 4
      t3 = read_u32_le_raw(bstr, 9) .>. 6
      t4 = (read_u32_le_raw(bstr, 12) .>. 8) .|. ((bstr(16) .&. 0xFF) .<. 24)
      h0' = h0' + (t0 .&. 0x3FFFFFF)
      h1' = h1' + (t1 .&. 0x3FFFFFF)
      h2' = h2' + (t2 .&. 0x3FFFFFF)
      h3' = h3' + (t3 .&. 0x3FFFFFF)
      h4' = h4' + t4
      d0 = h0' * r0 + h1' * s4 + h2' * s3 + h3' * s2 + h4' * s1
      d1 = h0' * r1 + h1' * r0 + h2' * s4 + h3' * s3 + h4' * s2
      d2 = h0' * r2 + h1' * r1 + h2' * r0 + h3' * s4 + h4' * s3
      d3 = h0' * r3 + h1' * r2 + h2' * r1 + h3' * r0 + h4' * s4
      d4 = h0' * r4 + h1' * r3 + h2' * r2 + h3' * r1 + h4' * r0
      c0 = d0 .>. 26
      h0' = d0 .&. 0x3FFFFFF
      d1c = d1 + c0
      c1 = d1c .>. 26
      h1' = d1c .&. 0x3FFFFFF
      d2c = d2 + c1
      c2 = d2c .>. 26
      h2' = d2c .&. 0x3FFFFFF
      d3c = d3 + c2
      c3 = d3c .>. 26
      h3' = d3c .&. 0x3FFFFFF
      d4c = d4 + c3
      c4 = d4c .>. 26
      h4' = d4c .&. 0x3FFFFFF
      h0' = h0' + c4 * 5
      c5 = h0' .>. 26
      h0' = h0' .&. 0x3FFFFFF
      h1' = h1' + c5
   // Final modular reduction mod 2^130 - 5
   fc1 = h1' .>. 26
   h1' = h1' .&. 0x3FFFFFF
   h2' = h2' + fc1
   fc2 = h2' .>. 26
   h2' = h2' .&. 0x3FFFFFF
   h3' = h3' + fc2
   fc3 = h3' .>. 26
   h3' = h3' .&. 0x3FFFFFF
   h4' = h4' + fc3
   fc4 = h4' .>. 26
   h4' = h4' .&. 0x3FFFFFF
   h0' = h0' + fc4 * 5
   fc0 = h0' .>. 26
   h0' = h0' .&. 0x3FFFFFF
   h1' = h1' + fc0
   g0 = h0' + 5
   gc0 = g0 .>. 26
   g0m = g0 .&. 0x3FFFFFF
   g1 = h1' + gc0
   gc1 = g1 .>. 26
   g1m = g1 .&. 0x3FFFFFF
   g2 = h2' + gc1
   gc2 = g2 .>. 26
   g2m = g2 .&. 0x3FFFFFF
   g3 = h3' + gc2
   gc3 = g3 .>. 26
   g3m = g3 .&. 0x3FFFFFF
   g4 = h4' + gc3 - 0x4000000
   g4 !< 0
      |
         h0' = g0m
         h1' = g1m
         h2' = g2m
         h3' = g3m
         h4' = g4
   w0 = (h0' .|. (h1' .<. 26)) .&. 0xFFFFFFFF
   w1 = ((h1' .>. 6) .|. (h2' .<. 20)) .&. 0xFFFFFFFF
   w2 = ((h2' .>. 12) .|. (h3' .<. 14)) .&. 0xFFFFFFFF
   w3 = ((h3' .>. 18) .|. (h4' .<. 8)) .&. 0xFFFFFFFF
   acc0 = w0 + read_u32_le_raw(key, 16)
   tw0 = acc0 .&. 0xFFFFFFFF
   acc1 = (acc0 .>. 32) + w1 + read_u32_le_raw(key, 20)
   tw1 = acc1 .&. 0xFFFFFFFF
   acc2 = (acc1 .>. 32) + w2 + read_u32_le_raw(key, 24)
   tw2 = acc2 .&. 0xFFFFFFFF
   acc3 = (acc2 .>. 32) + w3 + read_u32_le_raw(key, 28)
   tw3 = acc3 .&. 0xFFFFFFFF
   out = {16}
   binary::write_u32_le(out, tw0)
   binary::write_u32_le(out, tw1)
   binary::write_u32_le(out, tw2)
   binary::write_u32_le(out, tw3)
   <+ +out ->

// Computes the 32-character lowercase hex Poly1305 tag over `msg` using a 32-byte `key`.
poly1305_hex: String, String => < String | Error >
poly1305_hex = key, msg =>
   poly1305_mac(key, msg) $+> hex::encode

#private

aead_poly1305_tag: String, String, String, String => < String | Error >
aead_poly1305_tag = key, nonce, aad, ciphertext =>
   chacha20_block(key, 0, nonce)
      | blk0 =>
         otk = blk0(0..32)
         alen = ?aad
         clen = ?ciphertext
         apad = (16 - (alen % 16)) % 16
         cpad = (16 - (clen % 16)) % 16
         mac_in = {alen + apad + clen + cpad + 16}
         mac_in += aad
         apad @
            mac_in += 0
         mac_in += ciphertext
         cpad @
            mac_in += 0
         binary::write_u64_le(mac_in, alen)
         binary::write_u64_le(mac_in, clen)
         poly1305_mac(otk, +mac_in)
      | err => <- err +>

#public

// Encrypts and authenticates `plaintext` with associated data `aad` using RFC 8439
// ChaCha20-Poly1305 AEAD (`key` = 32 bytes, `nonce` = 12 bytes).
// Returns `ciphertext || 16-byte tag` (`?plaintext + 16` bytes).
aead_seal: String, String, String, String => < String | Error >
aead_seal = key, nonce, aad, plaintext =>
   chacha20_xor(key, nonce, 1, plaintext)
      | ct => aead_poly1305_tag(key, nonce, aad, ct) $+> tag => ct + tag
      | err => <- err +>

// Verifies and decrypts `sealed` (`ciphertext || 16-byte tag`) with associated data `aad`
// using RFC 8439 ChaCha20-Poly1305 AEAD (`key` = 32 bytes, `nonce` = 12 bytes).
// Verifies the 16-byte tag in constant time (`ct_eq`) before decrypting.
aead_open: String, String, String, String => < String | Error >
aead_open = key, nonce, aad, sealed =>
   slen = ?sealed
   slen < 16 | --| <- crypto_err("ChaCha20-Poly1305 ciphertext shorter than 16-byte tag") +>
   ct = sealed(0..slen - 16)
   got_tag = sealed(slen - 16..slen)
   aead_poly1305_tag(key, nonce, aad, ct)
      | exp_tag =>
         !ct_eq(got_tag, exp_tag)
            | <- crypto_err("ChaCha20-Poly1305 authentication tag mismatch") +>
            | chacha20_xor(key, nonce, 1, ct)
      | err => <- err +>

// Reads `n` cryptographically secure random bytes from the OS CSPRNG:
// - macOS / Apple Silicon / BSD (`darwin`, `*bsd`): `arc4random_buf` (FD-free, sandbox-safe)
// - Linux (`linux`): `getrandom` syscall wrapper with `/dev/urandom` fallback
// - Windows (`windows`): `BCryptGenRandom` (`BCRYPT_USE_SYSTEM_PREFERRED_RNG`)
random_bytes: Int => < String | Error >
random_bytes = n =>
   n < 0 | --| <- crypto_err("random_bytes count must be >= 0") +>
   n == 0 | --| <+ "" ->
   buf = {n}
   !fill_os_random(OsTarget, &buf, n)
      | <- crypto_err("OS CSPRNG read failed") +>
      |
         ?buf = n
         <+ +buf ->

// Returns `n` cryptographically secure random bytes encoded as `2 * n` lowercase hex characters.
random_hex: Int => < String | Error >
random_hex = n =>
   random_bytes(n) $+> hex::encode

// Reads a cryptographically secure 64-bit integer from `/dev/urandom`.
random_u64: () => < Int | Error >
random_u64 = !=>
   random_bytes(8)
      $+> raw => read_u32_le_raw(raw, 0) .|. (read_u32_le_raw(raw, 4) .<. 32)
