#type Flag <>

// RP2040 UART0 base is 0x40034000.
uart_write: Int => ()
uart_write = c =>
   @[Address(0x40034000)] = c
   ()

print_str: String => ()
print_str = s =>
   len := ?s
   0..len @ i =>
      uart_write(Int(s(i)))
   ()

// Read SIO GPIO_IN (takes dummy parameter)
read_gpios: Int => Int
read_gpios = _ =>
   Int(@[Address(0xd0000004)])

// Check if pin 24 is pressed (LOW due to pull-up)
is_pressed: Int => Flag
is_pressed = _ => ((read_gpios(0) .>. 24) .&. 1) == 0

toggle_led: Int => ()
toggle_led = _ =>
   @[Address(0xd000001f)] = 2 // Toggle GP25 (bit 25 is bit 1 of byte 3 of SIO GPIO_OUT_XOR)
   ()

// Delay function
delay: Int => ()
delay = n =>
   0..n @ _ => 0
   ()

main_loop: Int => ()
main_loop = _ =>
   0.. @
      toggle_led(0)
      is_pressed(0)
         | delay(1000000); 0   // Fast blink when button pressed
         | delay(5000000); 0  // Slow blink when not pressed
      0

print_str("Booted! Blinking LED. Press the onboard USB button to speed up...\n")
main_loop(0)
